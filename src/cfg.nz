// ── Option Helper ────────────────────────────────────────────────────────
struct OptionLayout:
    public var has_val as u8
    public var val_ptr as ptr[u8]

fn option_has_value(opt as ptr[u8]) as bool:
    if opt == None to ptr[u8]:
        return False
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).has_val == 1 to u8

fn option_value(opt as ptr[u8]) as ptr[u8]:
    if opt == None to ptr[u8]:
        return None to ptr[u8]
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).val_ptr

// ── Liveness List Utilities ───────────────────────────────────────────────
fn list_has_string(list as ptr[List[String]], s as String) as bool:
    if s.data == None to ptr[u8] or s.len == 0 to usize:
        return False
    let cnt as i64 = (deref list).length()
    var i as i64 = 0 to i64
    var item as String = String.make("" to cstr)
    while i < cnt:
        item = (deref list)[i]
        if item.data != None to ptr[u8]:
            if strcmp(item.data to cstr, s.data to cstr) == 0:
                return True
        i = i + 1 to i64
    return False

fn list_add_string_unique(list as ptr[List[String]], s as String):
    if not list_has_string(list, s):
        (deref list).append(s)

fn list_remove_string(list as ptr[List[String]], s as String):
    if s.data == None to ptr[u8] or s.len == 0 to usize:
        return
    let cnt as i64 = (deref list).length()
    var new_list as List[String] = List[String]()
    var i as i64 = 0 to i64
    var found as bool = False
    var item as String = String.make("" to cstr)
    while i < cnt:
        item = (deref list)[i]
        if not found and item.data != None to ptr[u8] and strcmp(item.data to cstr, s.data to cstr) == 0:
            found = True
        else:
            new_list.append(item)
        i = i + 1 to i64
    (deref list) = new_list

fn collect_expr_uses(expr as ptr[Node], out_uses as ptr[List[String]]):
    if expr == None to ptr[Node]:
        return
    let nt as NodeType = node_kind(expr)
    if nt == NodeType.Identifier:
        let nm as String = node_name(expr)
        if nm.len > 0 to usize and nm.data != None:
            let nm_c as cstr = nm.data to cstr
            if strcmp(nm_c, "True" to cstr) != 0 and strcmp(nm_c, "False" to cstr) != 0 and strcmp(nm_c, "None" to cstr) != 0 and strcmp(nm_c, "break" to cstr) != 0 and strcmp(nm_c, "continue" to cstr) != 0:
                list_add_string_unique(out_uses, nm)
    elif nt == NodeType.BinaryExpr:
        collect_expr_uses(node_left(expr), out_uses)
        collect_expr_uses(node_right(expr), out_uses)
    elif nt == NodeType.UnaryExpr:
        collect_expr_uses(node_left(expr), out_uses)
    elif nt == NodeType.CallExpr:
        collect_expr_uses(node_left(expr), out_uses)
        let params_raw as List[ptr[Node]] = node_params(expr)
        let params as ptr[List[ptr[Node]]] = ref params_raw
        var i as i64 = 0 to i64
        while i < (deref params).length():
            collect_expr_uses((deref params)[i], out_uses)
            i = i + 1 to i64
    elif nt == NodeType.MemberExpr or nt == NodeType.CastExpr:
        collect_expr_uses(node_left(expr), out_uses)
    elif nt == NodeType.IndexExpr:
        collect_expr_uses(node_left(expr), out_uses)
        collect_expr_uses(node_right(expr), out_uses)
    elif nt == NodeType.ListLiteral:
        let decls_raw as List[ptr[Node]] = node_declarations(expr)
        let decls as ptr[List[ptr[Node]]] = ref decls_raw
        var i as i64 = 0 to i64
        while i < (deref decls).length():
            collect_expr_uses((deref decls)[i], out_uses)
            i = i + 1 to i64

// ── Terminator Constants ──────────────────────────────────────────────────
fn tk_none() as i64:
    return 0 to i64

fn tk_return() as i64:
    return 1 to i64

fn tk_branch() as i64:
    return 2 to i64

fn tk_branch_if() as i64:
    return 3 to i64

fn tk_throw() as i64:
    return 4 to i64

fn tk_unreachable() as i64:
    return 5 to i64

// ── Basic Block Representation ───────────────────────────────────────────
struct BasicBlock:
    public var id as i64
    public var name as String
    public var statements as List[ptr[Node]]
    public var terminator_kind as i64
    public var terminator_target_bb as i64
    public var terminator_then_bb as i64
    public var terminator_else_bb as i64
    public var terminator_expr as ptr[Node]
    public var terminator_span as Span
    public var predecessors as List[i64]
    public var successors as List[i64]
    public var auto_drops as List[String]
    public var is_sealed as bool

fn make_basic_block(id as i64, name as String) as ptr[BasicBlock]:
    let bb as ptr[BasicBlock] = make[BasicBlock](1 to usize) to ptr[BasicBlock]
    (deref bb).id = id
    (deref bb).name = name
    (deref bb).statements = List[ptr[Node]]()
    (deref bb).terminator_kind = tk_unreachable()
    (deref bb).terminator_target_bb = -1 to i64
    (deref bb).terminator_then_bb = -1 to i64
    (deref bb).terminator_else_bb = -1 to i64
    (deref bb).terminator_expr = None to ptr[Node]
    (deref bb).terminator_span = Span(start_byte = 0 to u32, end_byte = 0 to u32, start_row = 0 to u32, start_col = 0 to u32, end_row = 0 to u32, end_col = 0 to u32)
    (deref bb).predecessors = List[i64]()
    (deref bb).successors = List[i64]()
    (deref bb).auto_drops = List[String]()
    (deref bb).is_sealed = False
    return bb

// ── Control Flow Graph Representation ────────────────────────────────────
struct ControlFlowGraph:
    public var func_name as String
    public var blocks as List[ptr[BasicBlock]]
    public var entry_id as i64
    public var exit_ids as List[i64]
    public var ret_type_name as String
    public var is_extern as bool
    public var span as Span
    public var live_in as List[List[String]]
    public var live_out as List[List[String]]
    public var def_vars as List[List[String]]
    public var use_vars as List[List[String]]

fn make_cfg(func_name as String, ret_type as String, is_extern as bool, span as Span) as ptr[ControlFlowGraph]:
    let g as ptr[ControlFlowGraph] = make[ControlFlowGraph](1 to usize) to ptr[ControlFlowGraph]
    (deref g).func_name = func_name
    (deref g).blocks = List[ptr[BasicBlock]]()
    (deref g).entry_id = 0 to i64
    (deref g).exit_ids = List[i64]()
    (deref g).ret_type_name = ret_type
    (deref g).is_extern = is_extern
    (deref g).span = span
    (deref g).live_in = List[List[String]]()
    (deref g).live_out = List[List[String]]()
    (deref g).def_vars = List[List[String]]()
    (deref g).use_vars = List[List[String]]()
    return g

// ── Polonius Origin & Loan Data Structures ───────────────────────────────
struct LoanRecord:
    public var loan_id as i64
    public var source_var as String
    public var is_mut as bool
    public var span as Span
    public var issued_bb as i64
    public var issued_stmt as i64

struct Point:
    public var bb_id as i64
    public var stmt_idx as i64

// ── Relational Origin & Subset Facts (Polonius Model) ──────────────────
struct OriginFact:
    public var origin_id as i64
    public var loan_id as i64
    public var point as Point

struct SubsetFact:
    public var sub_origin as i64
    public var sup_origin as i64
    public var point as Point

struct RelationalFactEngine:
    public var borrows as List[OriginFact]
    public var subsets as List[SubsetFact]
    public var invalidations as Dict[String, List[i64]]
    public var live_origins as Dict[String, List[i64]]
    public var origin_loans as Dict[String, List[i64]]
    public var loan_liveness as Dict[String, bool]

    public fn init_engine(self as ptr[RelationalFactEngine]):
        (deref self).borrows = List[OriginFact]()
        (deref self).subsets = List[SubsetFact]()
        (deref self).invalidations = Dict[String, List[i64]]()
        (deref self).live_origins = Dict[String, List[i64]]()
        (deref self).origin_loans = Dict[String, List[i64]]()
        (deref self).loan_liveness = Dict[String, bool]()

    public fn point_str(self as ptr[RelationalFactEngine], pt as Point) as String:
        let buf as ptr[u8] = make[u8](32 to usize) to ptr[u8]
        let _sp0 as i32 = sprintf(buf, "%lld:%lld" to cstr, pt.bb_id, pt.stmt_idx)
        let s as String = String.make(buf to cstr)
        free(buf to ptr)
        return s

    public fn add_borrow_issued(self as ptr[RelationalFactEngine], origin_id as i64, loan_id as i64, pt as Point):
        let f as OriginFact = OriginFact(origin_id = origin_id, loan_id = loan_id, point = pt)
        (deref self).borrows.append(f)

    public fn add_subset(self as ptr[RelationalFactEngine], sub_origin as i64, sup_origin as i64, pt as Point):
        let sf as SubsetFact = SubsetFact(sub_origin = sub_origin, sup_origin = sup_origin, point = pt)
        (deref self).subsets.append(sf)

    public fn add_invalidation(self as ptr[RelationalFactEngine], pt as Point, loan_id as i64):
        let ps as String = self.point_str(pt)
        if not (deref self).invalidations.has(ps):
            (deref self).invalidations[ps] = List[i64]()
        var l as List[i64] = (deref self).invalidations[ps]
        l.append(loan_id)

    public fn add_origin_live_at(self as ptr[RelationalFactEngine], origin_id as i64, pt as Point):
        let ps as String = self.point_str(pt)
        if not (deref self).live_origins.has(ps):
            (deref self).live_origins[ps] = List[i64]()
        var l as List[i64] = (deref self).live_origins[ps]
        var exists as bool = False
        var i as i64 = 0 to i64
        while i < l.length():
            if l[i] == origin_id:
                exists = True
            i = i + 1 to i64
        if not exists:
            l.append(origin_id)

    public fn solve_facts(self as ptr[RelationalFactEngine], cfg as ptr[ControlFlowGraph]):
        var _sp as i32 = 0 to i32
        var bi as i64 = 0 to i64
        while bi < (deref self).borrows.length():
            let bf as OriginFact = (deref self).borrows[bi]
            let ps as String = self.point_str(bf.point)
            let k_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
            _sp = sprintf(k_buf, "%lld@%s" to cstr, bf.origin_id, ps.data to cstr)
            let op_key as String = String.make(k_buf to cstr)
            free(k_buf to ptr)
            if not (deref self).origin_loans.has(op_key):
                (deref self).origin_loans[op_key] = List[i64]()
            var ol as List[i64] = (deref self).origin_loans[op_key]
            ol.append(bf.loan_id)
            bi = bi + 1 to i64

        var changed as bool = True
        var iterations as i64 = 0 to i64
        while changed and iterations < 50 to i64:
            changed = False
            iterations = iterations + 1 to i64

            var si as i64 = 0 to i64
            while si < (deref self).subsets.length():
                let sf as SubsetFact = (deref self).subsets[si]
                let ps as String = self.point_str(sf.point)
                let k1 as ptr[u8] = make[u8](64 to usize) to ptr[u8]
                _sp = sprintf(k1, "%lld@%s" to cstr, sf.sub_origin, ps.data to cstr)
                let op1_key as String = String.make(k1 to cstr)
                free(k1 to ptr)

                let k2 as ptr[u8] = make[u8](64 to usize) to ptr[u8]
                _sp = sprintf(k2, "%lld@%s" to cstr, sf.sup_origin, ps.data to cstr)
                let op2_key as String = String.make(k2 to cstr)
                free(k2 to ptr)

                if (deref self).origin_loans.has(op1_key):
                    let l1 as List[i64] = (deref self).origin_loans[op1_key]
                    if not (deref self).origin_loans.has(op2_key):
                        (deref self).origin_loans[op2_key] = List[i64]()
                    var l2 as List[i64] = (deref self).origin_loans[op2_key]
                    var li as i64 = 0 to i64
                    while li < l1.length():
                        let lid as i64 = l1[li]
                        var has_lid as bool = False
                        var check_i as i64 = 0 to i64
                        while check_i < l2.length():
                            if l2[check_i] == lid:
                                has_lid = True
                            check_i = check_i + 1 to i64
                        if not has_lid:
                            l2.append(lid)
                            changed = True
                        li = li + 1 to i64
                si = si + 1 to i64

        let live_keys as List[String] = (deref self).live_origins.keys()
        var ki as i64 = 0 to i64
        while ki < live_keys.length():
            let ps as String = live_keys[ki]
            let o_list as List[i64] = (deref self).live_origins[ps]
            var oi as i64 = 0 to i64
            while oi < o_list.length():
                let o_id as i64 = o_list[oi]
                let k_op as ptr[u8] = make[u8](64 to usize) to ptr[u8]
                _sp = sprintf(k_op, "%lld@%s" to cstr, o_id, ps.data to cstr)
                let op_key as String = String.make(k_op to cstr)
                free(k_op to ptr)
                if (deref self).origin_loans.has(op_key):
                    let loans_in_o as List[i64] = (deref self).origin_loans[op_key]
                    var l_idx as i64 = 0 to i64
                    while l_idx < loans_in_o.length():
                        let lid as i64 = loans_in_o[l_idx]
                        let k_lp as ptr[u8] = make[u8](64 to usize) to ptr[u8]
                        _sp = sprintf(k_lp, "%lld@%s" to cstr, lid, ps.data to cstr)
                        let lp_key as String = String.make(k_lp to cstr)
                        free(k_lp to ptr)
                        (deref self).loan_liveness[lp_key] = True
                        l_idx = l_idx + 1 to i64
                oi = oi + 1 to i64
            ki = ki + 1 to i64

    public fn is_loan_live_at(self as ptr[RelationalFactEngine], loan_id as i64, pt as Point) as bool:
        let ps as String = self.point_str(pt)
        let k_lp as ptr[u8] = make[u8](64 to usize) to ptr[u8]
        let _sp_live as i32 = sprintf(k_lp, "%lld@%s" to cstr, loan_id, ps.data to cstr)
        let lp_key as String = String.make(k_lp to cstr)
        free(k_lp to ptr)
        if (deref self).loan_liveness.has(lp_key):
            return (deref self).loan_liveness[lp_key]
        return False

// ── CFG Builder & Analyzer ───────────────────────────────────────────────
struct CFGAnalyzer:
    public var cfgs as Dict[String, ptr[ControlFlowGraph]]
    public var engine as ptr[DiagnosticEngine]
    public var current_file as String
    public var divergent_vars as List[String]
    public var next_bb_id as i64
    public var loans as List[LoanRecord]
    public var var_moves as Dict[String, List[Point]]
    public var var_borrows as Dict[String, List[i64]]
    public var node_cfgs as Dict[usize, ptr[ControlFlowGraph]]
    public var node_points as Dict[usize, Point]
    public var current_loop_break_bb as i64
    public var current_loop_continue_bb as i64
    public var fact_engine as ptr[RelationalFactEngine]
    public var borrower_origins as Dict[String, i64]

    public fn init_cfg(self as ptr[CFGAnalyzer], engine as ptr[DiagnosticEngine], current_file as String):
        (deref self).cfgs = Dict[String, ptr[ControlFlowGraph]]()
        (deref self).engine = engine
        (deref self).current_file = current_file
        (deref self).divergent_vars = List[String]()
        (deref self).next_bb_id = 0 to i64
        (deref self).loans = List[LoanRecord]()
        (deref self).var_moves = Dict[String, List[Point]]()
        (deref self).var_borrows = Dict[String, List[i64]]()
        (deref self).node_cfgs = Dict[usize, ptr[ControlFlowGraph]]()
        (deref self).node_points = Dict[usize, Point]()
        (deref self).current_loop_break_bb = -1 to i64
        (deref self).current_loop_continue_bb = -1 to i64
        (deref self).fact_engine = make[RelationalFactEngine](1 to usize) to ptr[RelationalFactEngine]
        (deref (deref self).fact_engine).init_engine()
        (deref self).borrower_origins = Dict[String, i64]()

    public fn record_var_move(self as ptr[CFGAnalyzer], moved_nm as String, pt as Point):
        if not (deref self).var_moves.has(moved_nm):
            (deref self).var_moves[moved_nm] = List[Point]()
        var mv_list as List[Point] = (deref self).var_moves[moved_nm]
        mv_list.append(pt)

    public fn check_call_moves(self as ptr[CFGAnalyzer], call_node as ptr[Node], pt as Point):
        let callee as ptr[Node] = node_left(call_node)
        var fn_nm as cstr = None to cstr
        if callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier:
            let np as ptr[String] = node_name_ptr(callee)
            if (np to ptr[u8]) != (None to ptr[u8]) and (deref np).data != None:
                fn_nm = (deref np).data to cstr
        if fn_nm != None to cstr:
            if strcmp(fn_nm, "print" to cstr) == 0 or strcmp(fn_nm, "printf" to cstr) == 0 or strcmp(fn_nm, "sprintf" to cstr) == 0 or strcmp(fn_nm, "snprintf" to cstr) == 0:
                return
        let c_args as List[ptr[Node]] = node_params(call_node)
        var a_i as i64 = 0 to i64
        while a_i < c_args.length():
            let arg as ptr[Node] = c_args[a_i]
            if arg != None to ptr[Node] and node_kind(arg) == NodeType.Identifier:
                self.record_var_move(node_name(arg), pt)
            a_i = a_i + 1 to i64

    public fn is_loan_live(self as ptr[CFGAnalyzer], loan_id as i64, pt as Point) as bool:
        if (deref self).fact_engine != None to ptr[RelationalFactEngine]:
            return (deref (deref self).fact_engine).is_loan_live_at(loan_id, pt)
        return False

    public fn is_borrower_loan_live(self as ptr[CFGAnalyzer], borrower_name as String, pt as Point) as bool:
        if (deref self).borrower_origins.has(borrower_name):
            let lid as i64 = (deref self).borrower_origins[borrower_name]
            return self.is_loan_live(lid, pt)
        return False

    public fn new_block(self as ptr[CFGAnalyzer], cfg as ptr[ControlFlowGraph], prefix as cstr) as ptr[BasicBlock]:
        let bid as i64 = (deref cfg).blocks.length()
        let name_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
        let _s as i32 = sprintf(name_buf, "%s_%lld" to cstr, prefix, bid)
        let bb as ptr[BasicBlock] = make_basic_block(bid, String.make(name_buf to cstr))
        free(name_buf to ptr)
        (deref cfg).blocks.append(bb)
        return bb

    public fn set_terminator_return(self as ptr[CFGAnalyzer], bb as ptr[BasicBlock], expr as ptr[Node], span as Span):
        (deref bb).terminator_kind = tk_return()
        (deref bb).terminator_expr = expr
        (deref bb).terminator_span = span
        (deref bb).is_sealed = True

    public fn set_terminator_branch(self as ptr[CFGAnalyzer], bb as ptr[BasicBlock], target_id as i64, span as Span):
        (deref bb).terminator_kind = tk_branch()
        (deref bb).terminator_target_bb = target_id
        (deref bb).terminator_span = span
        (deref bb).is_sealed = True

    public fn set_terminator_branch_if(self as ptr[CFGAnalyzer], bb as ptr[BasicBlock], then_id as i64, else_id as i64, expr as ptr[Node], span as Span):
        (deref bb).terminator_kind = tk_branch_if()
        (deref bb).terminator_then_bb = then_id
        (deref bb).terminator_else_bb = else_id
        (deref bb).terminator_expr = expr
        (deref bb).terminator_span = span
        (deref bb).is_sealed = True

    public fn set_terminator_throw(self as ptr[CFGAnalyzer], bb as ptr[BasicBlock], span as Span):
        (deref bb).terminator_kind = tk_throw()
        (deref bb).terminator_span = span
        (deref bb).is_sealed = True

    public fn add_edge(self as ptr[CFGAnalyzer], from_bb as ptr[BasicBlock], to_bb as ptr[BasicBlock]):
        if from_bb == None to ptr[BasicBlock] or to_bb == None to ptr[BasicBlock]:
            return
        (deref from_bb).successors.append((deref to_bb).id)
        (deref to_bb).predecessors.append((deref from_bb).id)

    public fn record_node_point(self as ptr[CFGAnalyzer], cfg as ptr[ControlFlowGraph], node as ptr[Node], pt as Point):
        if node == None to ptr[Node]:
            return
        (deref self).node_cfgs[node to usize] = cfg
        (deref self).node_points[node to usize] = pt
        let nt as NodeType = node_kind(node)
        if nt == NodeType.VarDecl:
            let left as ptr[Node] = node_left(node)
            if left != None to ptr[Node]:
                self.record_node_point(cfg, left, pt)
        elif nt == NodeType.BinaryExpr:
            self.record_node_point(cfg, node_left(node), pt)
            self.record_node_point(cfg, node_right(node), pt)
        elif nt == NodeType.UnaryExpr or nt == NodeType.CastExpr:
            self.record_node_point(cfg, node_left(node), pt)
        elif nt == NodeType.CallExpr:
            self.record_node_point(cfg, node_left(node), pt)
            let params_raw as List[ptr[Node]] = node_params(node)
            let params as ptr[List[ptr[Node]]] = ref params_raw
            var p_i as i64 = 0 to i64
            while p_i < (deref params).length():
                self.record_node_point(cfg, (deref params)[p_i], pt)
                p_i = p_i + 1 to i64

    public fn build_function_cfg(self as ptr[CFGAnalyzer], fn_node as ptr[Node]) as ptr[ControlFlowGraph]:
        let fn_name as String = node_name(fn_node)
        let is_ext as bool = node_is_extern(fn_node)
        var ret_type_name as String = String.make("" to cstr)
        let ret_annot as ptr[TypeAnnotation] = node_return_type_annot(fn_node)
        if ret_annot != None to ptr[TypeAnnotation]:
            ret_type_name = (deref ret_annot).name

        let cfg as ptr[ControlFlowGraph] = make_cfg(fn_name, ret_type_name, is_ext, node_span(fn_node))
        (deref self).cfgs[fn_name] = cfg

        if is_ext:
            return cfg

        let entry_bb as ptr[BasicBlock] = self.new_block(cfg, "entry" to cstr)
        (deref cfg).entry_id = (deref entry_bb).id

        let body as ptr[Node] = node_body(fn_node)
        if body == None to ptr[Node]:
            return cfg

        var current_bb as ptr[BasicBlock] = entry_bb
        current_bb = self.build_statements(cfg, current_bb, body)

        // Seal remaining open block
        if current_bb != None to ptr[BasicBlock] and (deref current_bb).is_sealed == False:
            self.set_terminator_return(current_bb, None to ptr[Node], (deref cfg).span)
            (deref cfg).exit_ids.append((deref current_bb).id)

        self.compute_cfg_liveness(cfg)
        return cfg

    public fn build_statements(self as ptr[CFGAnalyzer], cfg as ptr[ControlFlowGraph], current_bb as ptr[BasicBlock], block_node as ptr[Node]) as ptr[BasicBlock]:
        if block_node == None to ptr[Node] or current_bb == None to ptr[BasicBlock]:
            return current_bb

        let decls_raw as List[ptr[Node]] = node_declarations(block_node)
        let decls as ptr[List[ptr[Node]]] = ref decls_raw
        let count as i64 = (deref decls).length()

        var bb as ptr[BasicBlock] = current_bb
        var already_returned as bool = False

        var i as i64 = 0 to i64
        while i < count:
            let stmt as ptr[Node] = (deref decls)[i]
            if stmt != None to ptr[Node]:
                let k as NodeType = node_kind(stmt)

                if already_returned:
                    // Report unreachable code detected after return/throw
                    if (deref self).engine != None to ptr[DiagnosticEngine]:
                        let s as Span = node_span(stmt)
                        let _d as ptr[Diagnostic] = (deref (deref self).engine).report_error(
                            err_unreachable_code(),
                            String.make("unreachable code detected after guaranteed return" to cstr),
                            (deref self).current_file,
                            s
                        )
                elif k == NodeType.ReturnStmt:
                    (deref bb).statements.append(stmt)
                    let pt as Point = Point(bb_id = (deref bb).id, stmt_idx = (deref bb).statements.length() - 1)
                    self.record_node_point(cfg, stmt, pt)
                    self.set_terminator_return(bb, node_left(stmt), node_span(stmt))
                    (deref cfg).exit_ids.append((deref bb).id)
                    already_returned = True
                elif k == NodeType.ThrowStmt:
                    (deref bb).statements.append(stmt)
                    let pt as Point = Point(bb_id = (deref bb).id, stmt_idx = (deref bb).statements.length() - 1)
                    self.record_node_point(cfg, stmt, pt)
                    self.set_terminator_throw(bb, node_span(stmt))
                    (deref cfg).exit_ids.append((deref bb).id)
                    already_returned = True
                elif k == NodeType.IfStmt:
                    bb = self.build_if(cfg, bb, stmt)
                elif k == NodeType.WhileStmt:
                    bb = self.build_while(cfg, bb, stmt)
                elif k == NodeType.ForStmt:
                    bb = self.build_for(cfg, bb, stmt)
                elif k == NodeType.MatchStmt:
                    bb = self.build_match(cfg, bb, stmt)
                elif k == NodeType.BlockStmt or k == NodeType.ParamBlockStmt:
                    bb = self.build_statements(cfg, bb, stmt)
                elif k == NodeType.Identifier:
                    let id_nm as String = node_name(stmt)
                    if id_nm.data != None and strcmp(id_nm.data to cstr, "break" to cstr) == 0:
                        if (deref self).current_loop_break_bb >= 0 to i64:
                            let target_id as i64 = (deref self).current_loop_break_bb
                            self.set_terminator_branch(bb, target_id, node_span(stmt))
                            if target_id >= 0 to i64 and target_id < (deref cfg).blocks.length():
                                self.add_edge(bb, (deref cfg).blocks[target_id])
                            bb = self.new_block(cfg, "dead" to cstr)
                    elif id_nm.data != None and strcmp(id_nm.data to cstr, "continue" to cstr) == 0:
                        if (deref self).current_loop_continue_bb >= 0 to i64:
                            let target_id as i64 = (deref self).current_loop_continue_bb
                            self.set_terminator_branch(bb, target_id, node_span(stmt))
                            if target_id >= 0 to i64 and target_id < (deref cfg).blocks.length():
                                self.add_edge(bb, (deref cfg).blocks[target_id])
                            bb = self.new_block(cfg, "dead" to cstr)
                    else:
                        (deref bb).statements.append(stmt)
                        let pt as Point = Point(bb_id = (deref bb).id, stmt_idx = (deref bb).statements.length() - 1)
                        self.record_node_point(cfg, stmt, pt)
                else:
                    (deref bb).statements.append(stmt)
                    let pt as Point = Point(bb_id = (deref bb).id, stmt_idx = (deref bb).statements.length() - 1)
                    self.record_node_point(cfg, stmt, pt)
            i = i + 1 to i64

        return bb

    public fn build_if(self as ptr[CFGAnalyzer], cfg as ptr[ControlFlowGraph], current_bb as ptr[BasicBlock], if_node as ptr[Node]) as ptr[BasicBlock]:
        let cond_node as ptr[Node] = node_cond(if_node)
        let then_node as ptr[Node] = node_then_branch(if_node)
        var else_node as ptr[Node] = None to ptr[Node]
        let opt_eb as Option[ptr[Node]] = node_else_branch(if_node)
        let opt_ref as ptr[u8] = (ref opt_eb) to ptr[u8]
        if option_has_value(opt_ref):
            else_node = option_value(opt_ref) to ptr[Node]

        let then_bb as ptr[BasicBlock] = self.new_block(cfg, "then" to cstr)
        let else_bb as ptr[BasicBlock] = self.new_block(cfg, "else" to cstr)
        let join_bb as ptr[BasicBlock] = self.new_block(cfg, "join" to cstr)

        // Seal current block with BranchIf
        self.set_terminator_branch_if(current_bb, (deref then_bb).id, (deref else_bb).id, cond_node, node_span(if_node))
        self.add_edge(current_bb, then_bb)
        self.add_edge(current_bb, else_bb)

        // Build Then branch
        var then_exit as ptr[BasicBlock] = then_bb
        if then_node != None to ptr[Node]:
            if node_kind(then_node) == NodeType.BlockStmt or node_kind(then_node) == NodeType.ParamBlockStmt:
                then_exit = self.build_statements(cfg, then_bb, then_node)
            else:
                (deref then_bb).statements.append(then_node)

        if then_exit != None to ptr[BasicBlock] and (deref then_exit).is_sealed == False:
            self.set_terminator_branch(then_exit, (deref join_bb).id, node_span(if_node))
            self.add_edge(then_exit, join_bb)

        // Build Else branch
        var else_exit as ptr[BasicBlock] = else_bb
        if else_node != None to ptr[Node]:
            if node_kind(else_node) == NodeType.BlockStmt or node_kind(else_node) == NodeType.ParamBlockStmt:
                else_exit = self.build_statements(cfg, else_bb, else_node)
            else:
                (deref else_bb).statements.append(else_node)

        if else_exit != None to ptr[BasicBlock] and (deref else_exit).is_sealed == False:
            self.set_terminator_branch(else_exit, (deref join_bb).id, node_span(if_node))
            self.add_edge(else_exit, join_bb)

        // If both branches terminate with Return/Throw, join_bb is unreachable
        if (deref join_bb).predecessors.length() == 0 to i64:
            return None to ptr[BasicBlock]

        return join_bb

    public fn build_while(self as ptr[CFGAnalyzer], cfg as ptr[ControlFlowGraph], current_bb as ptr[BasicBlock], while_node as ptr[Node]) as ptr[BasicBlock]:
        let cond_node as ptr[Node] = node_cond(while_node)
        let body_node as ptr[Node] = node_body(while_node)

        let cond_bb as ptr[BasicBlock] = self.new_block(cfg, "while_cond" to cstr)
        let body_bb as ptr[BasicBlock] = self.new_block(cfg, "while_body" to cstr)
        let exit_bb as ptr[BasicBlock] = self.new_block(cfg, "while_exit" to cstr)

        // Branch from current_bb to cond_bb
        self.set_terminator_branch(current_bb, (deref cond_bb).id, node_span(while_node))
        self.add_edge(current_bb, cond_bb)

        // Condition block branches to body_bb or exit_bb
        self.set_terminator_branch_if(cond_bb, (deref body_bb).id, (deref exit_bb).id, cond_node, node_span(while_node))
        self.add_edge(cond_bb, body_bb)
        self.add_edge(cond_bb, exit_bb)

        // Loop break and continue tracking
        let prev_break as i64 = (deref self).current_loop_break_bb
        let prev_cont as i64 = (deref self).current_loop_continue_bb
        (deref self).current_loop_break_bb = (deref exit_bb).id
        (deref self).current_loop_continue_bb = (deref cond_bb).id

        // Build while body
        var body_exit as ptr[BasicBlock] = body_bb
        if body_node != None to ptr[Node]:
            if node_kind(body_node) == NodeType.BlockStmt or node_kind(body_node) == NodeType.ParamBlockStmt:
                body_exit = self.build_statements(cfg, body_bb, body_node)
            else:
                (deref body_bb).statements.append(body_node)
                let pt as Point = Point(bb_id = (deref body_bb).id, stmt_idx = (deref body_bb).statements.length() - 1)
                self.record_node_point(cfg, body_node, pt)

        (deref self).current_loop_break_bb = prev_break
        (deref self).current_loop_continue_bb = prev_cont

        // Loop back to condition block
        if body_exit != None to ptr[BasicBlock] and (deref body_exit).is_sealed == False:
            self.set_terminator_branch(body_exit, (deref cond_bb).id, node_span(while_node))
            self.add_edge(body_exit, cond_bb)

        return exit_bb

    public fn build_for(self as ptr[CFGAnalyzer], cfg as ptr[ControlFlowGraph], current_bb as ptr[BasicBlock], for_node as ptr[Node]) as ptr[BasicBlock]:
        let body_node as ptr[Node] = node_body(for_node)

        let cond_bb as ptr[BasicBlock] = self.new_block(cfg, "for_cond" to cstr)
        let body_bb as ptr[BasicBlock] = self.new_block(cfg, "for_body" to cstr)
        let exit_bb as ptr[BasicBlock] = self.new_block(cfg, "for_exit" to cstr)

        self.set_terminator_branch(current_bb, (deref cond_bb).id, node_span(for_node))
        self.add_edge(current_bb, cond_bb)

        self.set_terminator_branch_if(cond_bb, (deref body_bb).id, (deref exit_bb).id, None to ptr[Node], node_span(for_node))
        self.add_edge(cond_bb, body_bb)
        self.add_edge(cond_bb, exit_bb)

        let prev_break_for as i64 = (deref self).current_loop_break_bb
        let prev_cont_for as i64 = (deref self).current_loop_continue_bb
        (deref self).current_loop_break_bb = (deref exit_bb).id
        (deref self).current_loop_continue_bb = (deref cond_bb).id

        var body_exit as ptr[BasicBlock] = body_bb
        if body_node != None to ptr[Node]:
            if node_kind(body_node) == NodeType.BlockStmt or node_kind(body_node) == NodeType.ParamBlockStmt:
                body_exit = self.build_statements(cfg, body_bb, body_node)
            else:
                (deref body_bb).statements.append(body_node)
                let pt as Point = Point(bb_id = (deref body_bb).id, stmt_idx = (deref body_bb).statements.length() - 1)
                self.record_node_point(cfg, body_node, pt)

        (deref self).current_loop_break_bb = prev_break_for
        (deref self).current_loop_continue_bb = prev_cont_for

        if body_exit != None to ptr[BasicBlock] and (deref body_exit).is_sealed == False:
            self.set_terminator_branch(body_exit, (deref cond_bb).id, node_span(for_node))
            self.add_edge(body_exit, cond_bb)

        return exit_bb

    public fn build_match(self as ptr[CFGAnalyzer], cfg as ptr[ControlFlowGraph], current_bb as ptr[BasicBlock], match_node as ptr[Node]) as ptr[BasicBlock]:
        let cases_raw as List[ptr[Node]] = node_declarations(match_node)
        let cases as ptr[List[ptr[Node]]] = ref cases_raw
        let case_count as i64 = (deref cases).length()
        let join_bb as ptr[BasicBlock] = self.new_block(cfg, "match_join" to cstr)

        var ci as i64 = 0 to i64
        while ci < case_count:
            let case_node as ptr[Node] = (deref cases)[ci]
            let arm_bb as ptr[BasicBlock] = self.new_block(cfg, "case_arm" to cstr)
            self.add_edge(current_bb, arm_bb)

            var arm_exit as ptr[BasicBlock] = arm_bb
            if case_node != None to ptr[Node]:
                let arm_body as ptr[Node] = node_body(case_node)
                if arm_body != None to ptr[Node]:
                    if node_kind(arm_body) == NodeType.BlockStmt or node_kind(arm_body) == NodeType.ParamBlockStmt:
                        arm_exit = self.build_statements(cfg, arm_bb, arm_body)
                    else:
                        (deref arm_bb).statements.append(arm_body)
                        let pt as Point = Point(bb_id = (deref arm_bb).id, stmt_idx = (deref arm_bb).statements.length() - 1)
                        self.record_node_point(cfg, arm_body, pt)

            if arm_exit != None to ptr[BasicBlock] and (deref arm_exit).is_sealed == False:
                self.set_terminator_branch(arm_exit, (deref join_bb).id, node_span(match_node))
                self.add_edge(arm_exit, join_bb)
            ci = ci + 1 to i64

        if (deref current_bb).is_sealed == False:
            (deref current_bb).is_sealed = True

        if (deref join_bb).predecessors.length() == 0 to i64:
            return None to ptr[BasicBlock]

        return join_bb

    // ── Return-Path Completeness Validation ───────────────────────────────
    public fn validate_return_paths(self as ptr[CFGAnalyzer], cfg as ptr[ControlFlowGraph]) as bool:
        if (deref cfg).is_extern:
            return True

        let rt as String = (deref cfg).ret_type_name
        if rt.len == 0 to usize:
            return True
        let rtc as cstr = rt.data to cstr
        if strcmp(rtc, "void" to cstr) == 0 or strcmp(rtc, "Empty" to cstr) == 0:
            return True

        // Verify that all REACHABLE exit blocks terminate in Return or Throw
        let block_cnt as i64 = (deref cfg).blocks.length()
        var reachable as List[bool] = List[bool]()
        var b as i64 = 0 to i64
        while b < block_cnt:
            reachable.append(False)
            b = b + 1 to i64

        var worklist as List[i64] = List[i64]()
        if block_cnt > 0 to i64:
            worklist.append((deref cfg).entry_id)
            if (deref cfg).entry_id >= 0 to i64 and (deref cfg).entry_id < block_cnt:
                reachable[(deref cfg).entry_id] = True

        var q_head as i64 = 0 to i64
        while q_head < worklist.length():
            let curr_id as i64 = worklist[q_head]
            q_head = q_head + 1 to i64
            let curr_bb as ptr[BasicBlock] = (deref cfg).blocks[curr_id]
            let succ_cnt as i64 = (deref curr_bb).successors.length()
            var s_idx as i64 = 0 to i64
            while s_idx < succ_cnt:
                let s_id as i64 = (deref curr_bb).successors[s_idx]
                if s_id >= 0 to i64 and s_id < block_cnt:
                    if reachable[s_id] == False:
                        reachable[s_id] = True
                        worklist.append(s_id)
                s_idx = s_idx + 1 to i64

        var i as i64 = 0 to i64
        while i < block_cnt:
            if reachable[i]:
                let bb as ptr[BasicBlock] = (deref cfg).blocks[i]
                if (deref bb).successors.length() == 0 to i64:
                    if (deref bb).terminator_kind != tk_return() and (deref bb).terminator_kind != tk_throw():
                        if (deref self).engine != None to ptr[DiagnosticEngine]:
                            let s as Span = (deref cfg).span
                            var msg as StringBuilder = StringBuilder.make()
                            msg.append("missing return statement in function '" to cstr)
                            msg.append_slice((deref cfg).func_name.data, (deref cfg).func_name.len)
                            msg.append("' on one or more execution paths" to cstr)
                            let _d as ptr[Diagnostic] = (deref (deref self).engine).report_error(
                                err_missing_return(),
                                msg.to_string(),
                                (deref self).current_file,
                                s
                            )
                            msg.deinit()
                            return False
            i = i + 1 to i64

        return True

    // ── Backward Variable Liveness Analysis ───────────────────────────────────
    public fn compute_cfg_liveness(self as ptr[CFGAnalyzer], cfg as ptr[ControlFlowGraph]):
        let block_cnt as i64 = (deref cfg).blocks.length()
        if block_cnt == 0 to i64:
            return

        var live_in as List[List[String]] = List[List[String]]()
        var live_out as List[List[String]] = List[List[String]]()
        var def_vars as List[List[String]] = List[List[String]]()
        var use_vars as List[List[String]] = List[List[String]]()

        var b as i64 = 0 to i64
        while b < block_cnt:
            live_in.append(List[String]())
            live_out.append(List[String]())
            def_vars.append(List[String]())
            use_vars.append(List[String]())
            b = b + 1 to i64

        // 1. Compute Defs and Uses for each block
        b = 0 to i64
        while b < block_cnt:
            let bb as ptr[BasicBlock] = (deref cfg).blocks[b]
            let stmt_cnt as i64 = (deref bb).statements.length()
            var s_idx as i64 = 0 to i64
            while s_idx < stmt_cnt:
                let stmt as ptr[Node] = (deref bb).statements[s_idx]
                if stmt != None to ptr[Node]:
                    let k as NodeType = node_kind(stmt)
                    if k == NodeType.VarDecl:
                        let v_name as String = node_name(stmt)
                        let init_expr as ptr[Node] = node_left(stmt)
                        var stmt_uses as List[String] = List[String]()
                        collect_expr_uses(init_expr, ref stmt_uses)
                        var u_i as i64 = 0 to i64
                        while u_i < stmt_uses.length():
                            let u_var as String = stmt_uses[u_i]
                            if not list_has_string(ref (def_vars[b]), u_var):
                                list_add_string_unique(ref (use_vars[b]), u_var)
                            u_i = u_i + 1 to i64
                        list_add_string_unique(ref (def_vars[b]), v_name)
                    elif k == NodeType.BinaryExpr:
                        let op as String = node_op(stmt)
                        let is_assign as bool = op.data != None and strcmp(op.data to cstr, "=" to cstr) == 0
                        if is_assign:
                            let lhs as ptr[Node] = node_left(stmt)
                            let rhs as ptr[Node] = node_right(stmt)
                            var rhs_uses as List[String] = List[String]()
                            collect_expr_uses(rhs, ref rhs_uses)
                            var u_i as i64 = 0 to i64
                            while u_i < rhs_uses.length():
                                let u_var as String = rhs_uses[u_i]
                                if not list_has_string(ref (def_vars[b]), u_var):
                                    list_add_string_unique(ref (use_vars[b]), u_var)
                                u_i = u_i + 1 to i64
                            if lhs != None to ptr[Node] and node_kind(lhs) == NodeType.Identifier:
                                list_add_string_unique(ref (def_vars[b]), node_name(lhs))
                            else:
                                collect_expr_uses(lhs, ref rhs_uses)
                        else:
                            var stmt_uses as List[String] = List[String]()
                            collect_expr_uses(stmt, ref stmt_uses)
                            var u_i as i64 = 0 to i64
                            while u_i < stmt_uses.length():
                                let u_var as String = stmt_uses[u_i]
                                if not list_has_string(ref (def_vars[b]), u_var):
                                    list_add_string_unique(ref (use_vars[b]), u_var)
                                u_i = u_i + 1 to i64
                    else:
                        var stmt_uses as List[String] = List[String]()
                        collect_expr_uses(stmt, ref stmt_uses)
                        var u_i as i64 = 0 to i64
                        while u_i < stmt_uses.length():
                            let u_var as String = stmt_uses[u_i]
                            if not list_has_string(ref (def_vars[b]), u_var):
                                list_add_string_unique(ref (use_vars[b]), u_var)
                            u_i = u_i + 1 to i64
                s_idx = s_idx + 1 to i64

            if (deref bb).terminator_expr != None to ptr[Node]:
                var term_uses as List[String] = List[String]()
                collect_expr_uses((deref bb).terminator_expr, ref term_uses)
                var u_i as i64 = 0 to i64
                while u_i < term_uses.length():
                    let u_var as String = term_uses[u_i]
                    if not list_has_string(ref (def_vars[b]), u_var):
                        list_add_string_unique(ref (use_vars[b]), u_var)
                    u_i = u_i + 1 to i64
            b = b + 1 to i64

        // 2. Fixed-point backward dataflow iteration
        var changed as bool = True
        var iterations as i32 = 0 to i32
        while changed and iterations < 100 to i32:
            changed = False
            iterations = iterations + 1 to i32
            var b_idx as i64 = block_cnt - 1
            while b_idx >= 0 to i64:
                let bb as ptr[BasicBlock] = (deref cfg).blocks[b_idx]
                var new_live_out as List[String] = List[String]()
                var s_i as i64 = 0 to i64
                let succ_cnt as i64 = (deref bb).successors.length()
                while s_i < succ_cnt:
                    let s_id as i64 = (deref bb).successors[s_i]
                    if s_id >= 0 to i64 and s_id < block_cnt:
                        let s_live_in as List[String] = live_in[s_id]
                        var v_i as i64 = 0 to i64
                        while v_i < s_live_in.length():
                            list_add_string_unique(ref new_live_out, s_live_in[v_i])
                            v_i = v_i + 1 to i64
                    s_i = s_i + 1 to i64

                var new_live_in as List[String] = List[String]()
                let b_uses as List[String] = use_vars[b_idx]
                var u_i as i64 = 0 to i64
                while u_i < b_uses.length():
                    list_add_string_unique(ref new_live_in, b_uses[u_i])
                    u_i = u_i + 1 to i64

                let b_defs as List[String] = def_vars[b_idx]
                var o_i as i64 = 0 to i64
                while o_i < new_live_out.length():
                    let out_v as String = new_live_out[o_i]
                    if not list_has_string(ref b_defs, out_v):
                        list_add_string_unique(ref new_live_in, out_v)
                    o_i = o_i + 1 to i64

                if new_live_in.length() != live_in[b_idx].length() or new_live_out.length() != live_out[b_idx].length():
                    changed = True
                    live_in[b_idx] = new_live_in
                    live_out[b_idx] = new_live_out
                b_idx = b_idx - 1 to i64

        (deref cfg).live_in = live_in
        (deref cfg).live_out = live_out
        (deref cfg).def_vars = def_vars
        (deref cfg).use_vars = use_vars

    public fn var_live_at(self as ptr[CFGAnalyzer], cfg as ptr[ControlFlowGraph], var_name as String, pt as Point) as bool:
        if cfg == None to ptr[ControlFlowGraph] or var_name.len == 0 to usize:
            return False
        let block_cnt as i64 = (deref cfg).blocks.length()
        if pt.bb_id < 0 to i64 or pt.bb_id >= block_cnt:
            return False
        if (deref cfg).live_out.length() <= pt.bb_id:
            return False

        let bb as ptr[BasicBlock] = (deref cfg).blocks[pt.bb_id]
        let stmt_cnt as i64 = (deref bb).statements.length()

        var curr_live as List[String] = List[String]()
        let lo as List[String] = (deref cfg).live_out[pt.bb_id]
        var li as i64 = 0 to i64
        while li < lo.length():
            curr_live.append(lo[li])
            li = li + 1 to i64

        if pt.stmt_idx >= stmt_cnt:
            return list_has_string(ref curr_live, var_name)

        var j as i64 = stmt_cnt - 1
        while j >= pt.stmt_idx:
            if j == pt.stmt_idx:
                return list_has_string(ref curr_live, var_name)

            let stmt as ptr[Node] = (deref bb).statements[j]
            if stmt != None to ptr[Node]:
                let k as NodeType = node_kind(stmt)
                if k == NodeType.VarDecl:
                    let def_nm as String = node_name(stmt)
                    list_remove_string(ref curr_live, def_nm)
                    var u_list as List[String] = List[String]()
                    collect_expr_uses(node_left(stmt), ref u_list)
                    var u_i as i64 = 0 to i64
                    while u_i < u_list.length():
                        list_add_string_unique(ref curr_live, u_list[u_i])
                        u_i = u_i + 1 to i64
                elif k == NodeType.BinaryExpr:
                    let op as String = node_op(stmt)
                    if op.data != None and strcmp(op.data to cstr, "=" to cstr) == 0:
                        let lhs as ptr[Node] = node_left(stmt)
                        if lhs != None and node_kind(lhs) == NodeType.Identifier:
                            list_remove_string(ref curr_live, node_name(lhs))
                        var u_list as List[String] = List[String]()
                        collect_expr_uses(node_right(stmt), ref u_list)
                        var u_i as i64 = 0 to i64
                        while u_i < u_list.length():
                            list_add_string_unique(ref curr_live, u_list[u_i])
                            u_i = u_i + 1 to i64
                    else:
                        var u_list as List[String] = List[String]()
                        collect_expr_uses(stmt, ref u_list)
                        var u_i as i64 = 0 to i64
                        while u_i < u_list.length():
                            list_add_string_unique(ref curr_live, u_list[u_i])
                            u_i = u_i + 1 to i64
                else:
                    var u_list as List[String] = List[String]()
                    collect_expr_uses(stmt, ref u_list)
                    var u_i as i64 = 0 to i64
                    while u_i < u_list.length():
                        list_add_string_unique(ref curr_live, u_list[u_i])
                        u_i = u_i + 1 to i64
            j = j - 1 to i64

        return list_has_string(ref curr_live, var_name)

    public fn is_borrower_live(self as ptr[CFGAnalyzer], borrower_name as String, node as ptr[Node]) as bool:
        if node == None to ptr[Node] or borrower_name.len == 0 to usize:
            return False
        let k as usize = node to usize
        if not (deref self).node_points.has(k) or not (deref self).node_cfgs.has(k):
            return True
        let pt as Point = (deref self).node_points[k]
        let cfg as ptr[ControlFlowGraph] = (deref self).node_cfgs[k]
        return self.var_live_at(cfg, borrower_name, pt)

    // ── Polonius Origin & Loan Safety Check ───────────────────────────────
    public fn analyze_polonius_borrows(self as ptr[CFGAnalyzer], cfg as ptr[ControlFlowGraph]):
        // Scans basic blocks for borrow creation (&var / ref var) and invalidating moves
        let block_cnt as i64 = (deref cfg).blocks.length()
        var b_idx as i64 = 0 to i64
        while b_idx < block_cnt:
            let bb as ptr[BasicBlock] = (deref cfg).blocks[b_idx]
            let stmt_cnt as i64 = (deref bb).statements.length()
            var s_idx as i64 = 0 to i64
            while s_idx < stmt_cnt:
                let stmt as ptr[Node] = (deref bb).statements[s_idx]
                if stmt != None to ptr[Node]:
                    let pt as Point = Point(bb_id = (deref bb).id, stmt_idx = s_idx)
                    let k as NodeType = node_kind(stmt)
                    if k == NodeType.VarDecl:
                        let v_name as String = node_name(stmt)
                        let init_expr as ptr[Node] = node_left(stmt)
                        if init_expr != None to ptr[Node]:
                            let ik as NodeType = node_kind(init_expr)
                            if ik == NodeType.UnaryExpr:
                                let u_op as String = node_op(init_expr)
                                if u_op.data != None and strcmp(u_op.data to cstr, "ref" to cstr) == 0:
                                    let borrowed_var as ptr[Node] = node_left(init_expr)
                                    if borrowed_var != None to ptr[Node] and node_kind(borrowed_var) == NodeType.Identifier:
                                        let src_nm as String = node_name(borrowed_var)
                                        let lid as i64 = (deref self).loans.length()
                                        let lr as LoanRecord = LoanRecord(
                                            loan_id = lid,
                                            source_var = src_nm,
                                            is_mut = False,
                                            span = node_span(stmt),
                                            issued_bb = (deref bb).id,
                                            issued_stmt = s_idx
                                        )
                                        (deref self).loans.append(lr)
                                        if (deref self).fact_engine != None to ptr[RelationalFactEngine]:
                                            (deref (deref self).fact_engine).add_borrow_issued(lid, lid, pt)
                                        (deref self).borrower_origins[v_name] = lid
                            elif ik == NodeType.Identifier:
                                let rhs_id_nm as String = node_name(init_expr)
                                if (deref self).borrower_origins.has(rhs_id_nm):
                                    let orig_src as i64 = (deref self).borrower_origins[rhs_id_nm]
                                    let orig_dst as i64 = (deref self).loans.length() + (deref self).borrower_origins.length() + 1 to i64
                                    (deref self).borrower_origins[v_name] = orig_dst
                                    if (deref self).fact_engine != None to ptr[RelationalFactEngine]:
                                        (deref (deref self).fact_engine).add_subset(orig_src, orig_dst, pt)
                                else:
                                    self.record_var_move(rhs_id_nm, pt)
                            elif ik == NodeType.CallExpr:
                                self.check_call_moves(init_expr, pt)
                    elif k == NodeType.CallExpr:
                        self.check_call_moves(stmt, pt)
                    elif k == NodeType.BinaryExpr:
                        let op as String = node_op(stmt)
                        if op.data != None and strcmp(op.data to cstr, "=" to cstr) == 0:
                            let rhs as ptr[Node] = node_right(stmt)
                            let lhs as ptr[Node] = node_left(stmt)
                            if rhs != None to ptr[Node]:
                                let rk as NodeType = node_kind(rhs)
                                if rk == NodeType.Identifier:
                                    let r_id as String = node_name(rhs)
                                    if lhs != None to ptr[Node] and node_kind(lhs) == NodeType.Identifier and (deref self).borrower_origins.has(r_id):
                                        let l_id as String = node_name(lhs)
                                        let orig_src as i64 = (deref self).borrower_origins[r_id]
                                        let orig_dst as i64 = (deref self).loans.length() + (deref self).borrower_origins.length() + 1 to i64
                                        (deref self).borrower_origins[l_id] = orig_dst
                                        if (deref self).fact_engine != None to ptr[RelationalFactEngine]:
                                            (deref (deref self).fact_engine).add_subset(orig_src, orig_dst, pt)
                                    else:
                                        self.record_var_move(r_id, pt)
                                elif rk == NodeType.CallExpr:
                                    self.check_call_moves(rhs, pt)
                    elif k == NodeType.ReturnStmt:
                        let ret_expr as ptr[Node] = node_left(stmt)
                        if ret_expr != None to ptr[Node] and node_kind(ret_expr) == NodeType.Identifier:
                            self.record_var_move(node_name(ret_expr), pt)

                    var u_list as List[String] = List[String]()
                    collect_expr_uses(stmt, ref u_list)
                    var u_i as i64 = 0 to i64
                    while u_i < u_list.length():
                        let u_var as String = u_list[u_i]
                        if (deref self).borrower_origins.has(u_var):
                            let o_id as i64 = (deref self).borrower_origins[u_var]
                            if (deref self).fact_engine != None to ptr[RelationalFactEngine]:
                                (deref (deref self).fact_engine).add_origin_live_at(o_id, pt)
                        u_i = u_i + 1 to i64

                s_idx = s_idx + 1 to i64
            b_idx = b_idx + 1 to i64

        if (deref self).fact_engine != None to ptr[RelationalFactEngine]:
            (deref (deref self).fact_engine).solve_facts(cfg)

    // ── Path-Sensitive Drop Elaboration ───────────────────────────────────
    public fn elaborate_branch_divergent_drops(self as ptr[CFGAnalyzer], cfg as ptr[ControlFlowGraph]):
        // Detect variables moved along some paths to exit, but not all paths
        let block_cnt as i64 = (deref cfg).blocks.length()
        if block_cnt < 2 to i64:
            return

        // Inspect var moves across branch blocks
        var k_idx as i64 = 0 to i64
        let move_keys as List[String] = (deref self).var_moves.keys()
        while k_idx < move_keys.length():
            let v_nm as String = move_keys[k_idx]
            let mvs as List[Point] = (deref self).var_moves[v_nm]
            if mvs.length() > 0 to i64:
                // Check if moved in some block with multiple successors / siblings
                var has_unmoved_path as bool = False
                var m_i as i64 = 0 to i64
                while m_i < mvs.length():
                    let pt as Point = mvs[m_i]
                    // If the move occurred in a block with a sibling block that has no moves
                    var b_i as i64 = 0 to i64
                    while b_i < block_cnt:
                        let other_bb as ptr[BasicBlock] = (deref cfg).blocks[b_i]
                        let o_id as i64 = (deref other_bb).id
                        if o_id != pt.bb_id and ((deref other_bb).successors.length() > 0 to i64 or (deref other_bb).terminator_kind == tk_return()):
                            var other_has_move as bool = False
                            var chk_i as i64 = 0 to i64
                            while chk_i < mvs.length():
                                if mvs[chk_i].bb_id == o_id:
                                    other_has_move = True
                                chk_i = chk_i + 1 to i64
                            if not other_has_move:
                                has_unmoved_path = True
                        b_i = b_i + 1 to i64
                    m_i = m_i + 1 to i64

                if has_unmoved_path:
                    // Variable requires a dynamic stack drop flag
                    var already_added as bool = False
                    var d_i as i64 = 0 to i64
                    while d_i < (deref self).divergent_vars.length():
                        if strcmp((deref self).divergent_vars[d_i].data to cstr, v_nm.data to cstr) == 0:
                            already_added = True
                        d_i = d_i + 1 to i64
                    if not already_added:
                        (deref self).divergent_vars.append(v_nm)
            k_idx = k_idx + 1 to i64

    // ── Program-Level Entry Point ─────────────────────────────────────────
    public fn analyze_program(self as ptr[CFGAnalyzer], root as ptr[Node]) as bool:
        if root == None to ptr[Node]:
            return True

        let decls_raw as List[ptr[Node]] = node_declarations(root)
        let decls as ptr[List[ptr[Node]]] = ref decls_raw
        let count as i64 = (deref decls).length()

        var all_ok as bool = True
        var i as i64 = 0 to i64
        while i < count:
            let decl as ptr[Node] = (deref decls)[i]
            if decl != None to ptr[Node]:
                let k as NodeType = node_kind(decl)
                if k == NodeType.FunDecl:
                    let cfg as ptr[ControlFlowGraph] = self.build_function_cfg(decl)
                    let ret_ok as bool = self.validate_return_paths(cfg)
                    if not ret_ok:
                        all_ok = False
                    self.analyze_polonius_borrows(cfg)
                    self.elaborate_branch_divergent_drops(cfg)
                elif k == NodeType.ClassDecl or k == NodeType.StructDecl:
                    let b as ptr[Node] = node_body(decl)
                    if b != None to ptr[Node]:
                        let m_decls_raw as List[ptr[Node]] = node_declarations(b)
                        let m_decls as ptr[List[ptr[Node]]] = ref m_decls_raw
                        var m_idx as i64 = 0 to i64
                        while m_idx < (deref m_decls).length():
                            let m_decl as ptr[Node] = (deref m_decls)[m_idx]
                            if m_decl != None to ptr[Node] and node_kind(m_decl) == NodeType.FunDecl:
                                let m_cfg as ptr[ControlFlowGraph] = self.build_function_cfg(m_decl)
                                let m_ret_ok as bool = self.validate_return_paths(m_cfg)
                                if not m_ret_ok:
                                    all_ok = False
                                self.analyze_polonius_borrows(m_cfg)
                                self.elaborate_branch_divergent_drops(m_cfg)
                            m_idx = m_idx + 1 to i64
            i = i + 1 to i64

        return all_ok
