    if b == 115 to u8:
        return __fmt_kw_eq(data, off, len, "static" to cstr)
    if b == 101 to u8:
        return __fmt_kw_eq(data, off, len, "extern" to cstr)
    if b == 97 to u8:
        return __fmt_kw_eq(data, off, len, "abstract" to cstr) or __fmt_kw_eq(data, off, len, "async" to cstr) or __fmt_kw_eq(data, off, len, "atomic" to cstr)
