            break
    if pe2 > ls2:
        starts.append(ls2)
        lens.append(pe2 - ls2)
    let ncnt as i64 = starts.length() to i64
    if ncnt < 2 to i64:
        return False
    // emit: header through '(' stays with the already-emitted indent,
    // then one param per line at indent+4 with a trailing comma, then
    // ')' + return-type tail back at the base indent
    __fmt_out_range(out, data, 0 to i64, p1 + 1 to i64)
    (deref out).append_char(10 to u8)
    var pi as i64 = 0 to i64
    while pi < ncnt:
        __fmt_out_spaces(out, ind_w + 4 to i64)
        __fmt_out_range(out, data, starts[pi], lens[pi])
        (deref out).append_char(44 to u8)
        (deref out).append_char(10 to u8)
        pi = pi + 1 to i64
    __fmt_out_spaces(out, ind_w)
    __fmt_out_range(out, data, p2, slen - p2)
    return True

// ── method-chain wrapping (spec §7.2) ──────────────────────────────────
// Long fluent-call chains (> 100 columns) break before each top-level
// method dot at indent+4 (the spec's break-before-dot shape). The
// decision runs on the space-normalized scratch text, so it composes
// with the §3.3 spacing pass. A split dot must sit at depth zero
// (paren AND bracket), follow a plausible receiver (ident char, ')',
// ']' or a string literal) and open a `name [G]? (...)` call link.
// Fixed-point because wrapped pieces each start with '.', so the head
// is empty on re-entry, and single-link lines never qualify.

fn __fmt_wrap_chain(data as ptr[u8], slen as i64, ind_w as i64, out as ptr[StringBuilder]) as bool:
    // collect top-level method-call split dots (string-safe)
    var starts as List[i64] = List[i64]()
    var pd as i64 = 0 to i64
    var bd as i64 = 0 to i64
    var in_str as bool = False
    var p as i64 = 0 to i64
    while p < slen:
        let b as u8 = deref ((data to usize + p) to ptr[u8])
        if in_str:
            if b == 92 to u8:
                p = p + 2 to i64
                continue
            if b == 34 to u8:
                in_str = False
            p = p + 1 to i64
            continue
        if b == 34 to u8:
            in_str = True
        elif b == 47 to u8 and p + 1 to i64 < slen and deref ((data to usize + (p + 1 to i64)) to ptr[u8]) == 47 to u8 and pd == 0 to i64 and bd == 0 to i64:
            // `//` comment at line level: leave the line alone
            return False
        elif b == 40 to u8:
            pd = pd + 1 to i64
        elif b == 41 to u8:
            if pd > 0 to i64:
                pd = pd - 1 to i64
        elif b == 91 to u8:
            bd = bd + 1 to i64
        elif b == 93 to u8:
            if bd > 0 to i64:
                bd = bd - 1 to i64
        elif b == 46 to u8 and pd == 0 to i64 and bd == 0 to i64:
            // candidate split dot: must follow a receiver end and open a
            // `name [G]? (...)` call link
            if p + 1 to i64 >= slen:
                p = p + 1 to i64
                continue
            let nb as u8 = deref ((data to usize + (p + 1 to i64)) to ptr[u8])
            let nb_ok as bool = (nb >= 97 to u8 and nb <= 122 to u8) or (nb >= 65 to u8 and nb <= 90 to u8) or nb == 95 to u8
            if not nb_ok:
                p = p + 1 to i64
                continue
            // receiver check: previous non-space byte
            var q as i64 = p
            var prev as u8 = 0 to u8
            while q > 0 to i64:
                q = q - 1 to i64
                let rb as u8 = deref ((data to usize + q) to ptr[u8])
                if rb == 32 to u8 or rb == 9 to u8:
                    continue
                prev = rb
                break
            let recv_ok as bool = (prev >= 97 to u8 and prev <= 122 to u8) or (prev >= 65 to u8 and prev <= 90 to u8) or (prev >= 48 to u8 and prev <= 57 to u8) or prev == 95 to u8 or prev == 41 to u8 or prev == 93 to u8 or prev == 34 to u8
            if not recv_ok:
                p = p + 1 to i64
                continue
            // walk the link: ident chars, optional balanced [..] groups
            // (spaces between the tokens are tolerated — §3.3 keyword
            // spacing emits `name (`), then '('
            var w as i64 = p + 1 to i64
            while w < slen:
                let wb as u8 = deref ((data to usize + w) to ptr[u8])
                if (wb >= 97 to u8 and wb <= 122 to u8) or (wb >= 65 to u8 and wb <= 90 to u8) or (wb >= 48 to u8 and wb <= 57 to u8) or wb == 95 to u8:
                    w = w + 1 to i64
                else:
                    break
            var g as i64 = w
            while g < slen:
                let sgb as u8 = deref ((data to usize + g) to ptr[u8])
                if sgb == 32 to u8 or sgb == 9 to u8:
                    g = g + 1 to i64
                else:
                    break
            var gd as i64 = 0 to i64
            while g < slen:
                let gb as u8 = deref ((data to usize + g) to ptr[u8])
                if gb == 91 to u8:
                    gd = gd + 1 to i64
                elif gb == 93 to u8:
                    gd = gd - 1 to i64
                elif gd == 0 to i64:
                    break
                g = g + 1 to i64
            while g < slen:
                let sgb2 as u8 = deref ((data to usize + g) to ptr[u8])
                if sgb2 == 32 to u8 or sgb2 == 9 to u8:
                    g = g + 1 to i64
                else:
                    break
            if g < slen and deref ((data to usize + g) to ptr[u8]) == 40 to u8:
                starts.append(p)
        p = p + 1 to i64
    let ncnt as i64 = starts.length() to i64
    if ncnt < 2 to i64:
        return False
    let h0 as i64 = starts[0]
    // head must be non-empty (a line starting with '.' is already a
    // broken continuation: fixed point)
    if h0 == 0 to i64:
        return False
    var he as i64 = h0
    while he > 0 to i64:
        let hb as u8 = deref ((data to usize + (he - 1 to i64)) to ptr[u8])
        if hb == 32 to u8 or hb == 9 to u8:
            he = he - 1 to i64
        else:
            break
    if he == 0 to i64:
        return False
    // emit: head stays with the already-emitted indent, then one
    // `.method(...)` link per line at indent+4 (no trailing comma —
    // the grammar's leading-dot member continuation)
    __fmt_out_range(out, data, 0 to i64, he)
    var si as i64 = 0 to i64
    while si < ncnt:
        var pe as i64 = 0 to i64
        if si + 1 to i64 < ncnt:
            pe = starts[si + 1 to i64]
        else:
            pe = slen
        while pe > starts[si]:
            let eb as u8 = deref ((data to usize + (pe - 1 to i64)) to ptr[u8])
            if eb == 32 to u8 or eb == 9 to u8:
                pe = pe - 1 to i64
            else:
                break
        (deref out).append_char(10 to u8)
        __fmt_out_spaces(out, ind_w + 4 to i64)
        __fmt_out_range(out, data, starts[si], pe - starts[si])
        si = si + 1 to i64
    return True

// the transform

fn fmt_transform(src as String) as String:
    extern fn memcpy(dst as ptr, src_p as ptr, n as i64) as ptr
    let data as ptr[u8] = (deref src).data
    if data == None to ptr[u8]:
        return src
    let n as usize = (deref src).len

    var line_starts as List[i64] = List[i64]()
    var line_ends as List[i64] = List[i64]()
    var line_vis as List[i64] = List[i64]()
    var line_banner as List[i64] = List[i64]()
    var line_lws as List[i64] = List[i64]()
    __fmt_scan_lines(data, n, ref line_starts, ref line_ends, ref line_vis, ref line_banner, ref line_lws)

    var out as StringBuilder = StringBuilder.make()

    var run_first as i64 = -1 to i64
    var run_koff as List[i64] = List[i64]()
    var run_klen as List[i64] = List[i64]()

    let line_count as i64 = line_starts.length() to i64
    var li as i64 = 0 to i64
    while li < line_count:
        let s as i64 = line_starts[li]
        let e as i64 = line_ends[li]
        let lw as i64 = line_lws[li]
        let is_vis as bool = line_vis[li] == 1 to i64
        let is_blank as bool = lw >= e

        var ikind as i64 = 0 to i64
        var mod_off as i64 = 0 to i64
        var mod_len as i64 = 0 to i64
        var list_off as i64 = 0 to i64
        if not is_vis:
            ikind = __fmt_import_kind(data, lw, e, ref mod_off, ref mod_len, ref list_off)

        if run_first >= 0 to i64 and ikind == 0 to i64:
            __fmt_run_flush(data, ref run_koff, ref run_klen, line_starts, line_ends, line_lws, ref out, run_first)
            run_first = -1 to i64
            run_koff = List[i64]()
            run_klen = List[i64]()

        if ikind != 0 to i64:
            if run_first < 0 to i64:
                run_first = li
            run_koff.append(mod_off)
            run_klen.append(mod_len)
            li = li + 1 to i64
            continue

        if not is_vis and not is_blank and line_banner[li] == 1 to i64:
            var name_len as i64 = 0 to i64
            if __fmt_banner_match(data, lw, e, ref name_len):
                // emit the original indent ([s, lw)) — tabs expand to 4sp
                var hp as i64 = 0 to i64
                while s + hp < lw:
                    let hb as u8 = deref ((data to usize + (s + hp)) to ptr[u8])
                    if hb == 9 to u8:
                        __fmt_out_spaces(ref out, 4 to i64)
                    else:
                        (deref out).append_char(32 to u8)
                    hp = hp + 1 to i64
                (deref out).append_slice("// ── " to ptr[u8], 10 to usize)
                __fmt_out_range(ref out, data, lw + 10 to i64, name_len)
                var col as i64 = 6 to i64
                col = col + __fmt_cp_len(data, lw + 10 to i64, name_len)
                (deref out).append_char(32 to u8)
                col = col + 1 to i64
                while col < 80 to i64:
                    (deref out).append_slice("─" to ptr[u8], 3 to usize)
                    col = col + 1 to i64
                (deref out).append_char(10 to u8)
                li = li + 1 to i64
                continue

        if is_blank:
            if is_vis:
                (deref out).append_char(10 to u8)
                li = li + 1 to i64
                continue
            var re as i64 = li + 1 to i64
            while re < line_count and line_vis[re] == 0 to i64 and line_lws[re] >= line_ends[re]:
                re = re + 1 to i64
            let run_len as i64 = re - li
            let cap as i64 = __fmt_blank_cap(data, line_starts, line_ends, line_lws, line_vis, line_banner, li, line_count, run_len)
            var bk as i64 = 0 to i64
            while bk < cap:
                (deref out).append_char(10 to u8)
                bk = bk + 1 to i64
            li = re
            continue

        if is_vis:
            __fmt_out_range(ref out, data, s, e - s)
            (deref out).append_char(10 to u8)
            li = li + 1 to i64
            continue

        var hp2 as i64 = s
        while hp2 < lw:
            let hb2 as u8 = deref ((data to usize + hp2) to ptr[u8])
            if hb2 == 9 to u8:
                __fmt_out_spaces(ref out, 4 to i64)
            else:
                (deref out).append_char(32 to u8)
            hp2 = hp2 + 1 to i64
        var ce as i64 = e
        if ce > lw:
            let rb as u8 = deref ((data to usize + (ce - 1 to i64)) to ptr[u8])
            if rb == 13 to u8:
                ce = ce - 1 to i64
        while ce > lw:
            let tb as u8 = deref ((data to usize + (ce - 1 to i64)) to ptr[u8])
            if tb == 32 to u8 or tb == 9 to u8:
                ce = ce - 1 to i64
            else:
                break
        if ce > lw:
            var scratch as StringBuilder = StringBuilder.make()
            __fmt_space_emit(data, lw, ce, ref scratch)
            let slen as i64 = (deref scratch).len to i64
            var ind_w as i64 = 0 to i64
            var hq2 as i64 = s
            while hq2 < lw:
                let hqb2 as u8 = deref ((data to usize + hq2) to ptr[u8])
                if hqb2 == 9 to u8:
                    ind_w = ind_w + 4 to i64
                else:
                    ind_w = ind_w + 1 to i64
                hq2 = hq2 + 1 to i64
            var wrapped as bool = False
            if ind_w + slen > 100 to i64:
                wrapped = __fmt_wrap_fn_sig((deref scratch).buffer, slen, ind_w, ref out)
                if not wrapped:
                    wrapped = __fmt_wrap_chain((deref scratch).buffer, slen, ind_w, ref out)
            if not wrapped:
                __fmt_out_range(ref out, (deref scratch).buffer, 0 to i64, slen)
            (deref out).append_char(10 to u8)
            (deref scratch).deinit()
        else:
            (deref out).append_char(10 to u8)
        li = li + 1 to i64

    if run_first >= 0 to i64:
        __fmt_run_flush(data, ref run_koff, ref run_klen, line_starts, line_ends, line_lws, ref out, run_first)
        run_koff = List[i64]()
        run_klen = List[i64]()

    let res as String = (deref out).to_string()
    (deref out).deinit()

    // exactly one trailing newline
    let rlen as i64 = res.len to i64
    if rlen > 1 to i64:
        var trim_to as i64 = rlen
        while trim_to > 0 to i64:
            let cb as u8 = deref ((res.data to usize + (trim_to - 1 to i64)) to ptr[u8])
            if cb == 10 to u8:
                trim_to = trim_to - 1 to i64
            else:
                break
        if rlen - trim_to > 1 to i64:
            let rdata as ptr[u8] = res.data
            let newlen as i64 = trim_to + 1 to i64
            let buf as ptr[u8] = make[u8](newlen + 1 to usize) to ptr[u8]
            memcpy(buf to ptr, rdata to ptr, trim_to)
            deref ((buf to usize + trim_to) to ptr[u8]) = 10 to u8
            deref ((buf to usize + newlen) to ptr[u8]) = 0 to u8
            let res2 as String = String.make(buf to cstr)
            res.deinit()
            return res2
    return res

