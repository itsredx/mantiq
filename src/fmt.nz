// cap for the blank run starting at `li` (length run_len). Exact caps:
// 1 after a banner; 1 between import/link lines; 2 before a col-0 line;
// 0 at dedents and right after a block introducer (prev ends ':');
// else min(run, 1). File-start/end runs keep the old <= 2 behavior.
fn __fmt_blank_cap(data as ptr[u8], line_starts as List[i64], line_ends as List[i64], line_lws as List[i64], line_vis as List[i64], line_banner as List[i64], li as i64, line_count as i64, run_len as i64) as i64:
    var lim as i64 = run_len
    if lim > 2 to i64:
        lim = 2 to i64
    var pi as i64 = li - 1 to i64
    var found_p as bool = False
    while pi >= 0 to i64:
        if line_vis[pi] == 1 to i64:
            break
        if line_lws[pi] < line_ends[pi]:
            found_p = True
            break
        pi = pi - 1 to i64
    var ni as i64 = li + run_len
    var found_n as bool = False
    while ni < line_count:
        if line_vis[ni] == 1 to i64:
            break
        if line_lws[ni] < line_ends[ni]:
            found_n = True
            break
        ni = ni + 1 to i64
    if not found_p or not found_n:
        return lim
    if line_banner[pi] == 1 to i64:
        return 1 to i64
