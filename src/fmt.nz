    var d2 as i64 = 0 to i64
    var d3 as i64 = 0 to i64
    var imp_p as bool = __fmt_import_kind(data, line_lws[pi], line_ends[pi], ref d1, ref d2, ref d3) != 0 to i64 or __fmt_line_linkish(data, line_lws[pi], line_ends[pi])
    var imp_n as bool = __fmt_import_kind(data, line_lws[ni], line_ends[ni], ref d1, ref d2, ref d3) != 0 to i64 or __fmt_line_linkish(data, line_lws[ni], line_ends[ni])
    if imp_p and imp_n:
        return 1 to i64
    let ip as i64 = line_lws[pi] - line_starts[pi]
    let inz as i64 = line_lws[ni] - line_starts[ni]
    if inz == 0 to i64:
        return 2 to i64
    if inz < ip:
