            ret_type = make_type(TypeKind.Boolean)

        elif nt == NodeType.ClassDecl:
            let class_name as String = node_name(node)
            ret_type = make_class_type(class_name)
            if node_body(node) != None to ptr[Node]:
                let sema_cd as ptr[Sema] = (deref self).sema
                let saved_scope_cd as ptr[Scope] = (deref sema_cd).current_scope
                var class_scope_cd as ptr[Scope] = None to ptr[Scope]
                if (deref sema_cd).fn_scopes.has(node to usize):
