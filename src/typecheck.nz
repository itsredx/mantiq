                (deref self).current_struct_type = ret_type
                let dummy_cd as ptr[Type] = self.typecheck_node(node_body(node))
                (deref self).current_struct_type = saved_struct_t
                (deref sema_cd).current_scope = saved_scope_cd

        elif nt == NodeType.InterfaceDecl:
            let iface_name as String = node_name(node)
            ret_type = make_interface_type(iface_name)
