// ── Imports ─────────────────────────────────────────────────────────────
import std.collections
from std.string import String, StringBuilder
from std.collections import List, Dict
from std.option import Option, Empty, Some
from std.mem import make
import symbols
from symbols import Node, Span, Symbol, Scope, SymbolKind, TypeAnnotation, LanguageMode, NodeType, node_kind, node_span, node_name, node_left, node_right, node_body, node_declarations, node_params, node_op, node_cond, node_then_branch, node_else_branch, node_val, node_str_val, node_is_async, node_is_extern, node_is_variadic, node_return_type_annot, node_is_mut, node_type_annots, node_auto_drops, node_inferred_type, node_module_name, set_node_inferred_type, set_node_name, set_node_module_name, set_node_val, set_node_op, set_node_is_mut, set_node_is_async, set_node_is_extern, set_node_is_variadic, set_node_return_type_annot, set_node_type_annots, set_node_left, set_node_right, set_node_body, set_node_cond, set_node_then_branch, set_node_str_val, set_node_declarations, set_node_params, make_node
import types
from types import Type, TypeKind, make_type, make_ptr_type, make_struct_type, make_enum_type, make_union_type
import sema
from sema import Sema, make_scope, make_symbol

extern fn strcmp(s1 as cstr, s2 as cstr) as i32

struct OptionLayout:
    public var has_val as u8
    public var val_ptr as ptr[u8]

fn option_has_value(opt as ptr[u8]) as bool:
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).has_val == 1 to u8

fn option_value(opt as ptr[u8]) as ptr[u8]:
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).val_ptr

struct ListWrapper:
    public var list as List[Option[ptr[TypeAnnotation]]]

// ── TypeChecker ─────────────────────────────────────────────────────────
struct TypeChecker:
    public var sema as ptr[Sema]
    public var current_function_return as Option[ptr[Type]]
    public var inferred_return_type as ptr[Type]

    public fn __init__(self as ptr[TypeChecker], sema as ptr[Sema]):
        (deref self).sema = sema
        (deref self).current_function_return = Empty
        (deref self).inferred_return_type = None to ptr[Type]

    public fn resolve_type_annotation(self as ptr[TypeChecker], annot as ptr[TypeAnnotation]) as ptr[Type]:
        extern fn strcmp(s1 as cstr, s2 as cstr) as i32
        let name_data as ptr[u8] = (deref annot).name.data
        let name_len as usize = (deref annot).name.len
        if name_data == None to ptr[u8] or name_len == 0 to usize:
            return make_type(TypeKind.Void)
        let name as cstr = name_data to cstr
        if strcmp(name, "i8" to cstr) == 0:
            return make_type(TypeKind.I8)
        elif strcmp(name, "i16" to cstr) == 0:
            return make_type(TypeKind.I16)
        elif strcmp(name, "i32" to cstr) == 0:
            return make_type(TypeKind.I32)
        elif strcmp(name, "i64" to cstr) == 0:
            return make_type(TypeKind.I64)
        elif strcmp(name, "i128" to cstr) == 0:
            return make_type(TypeKind.I128)
        elif strcmp(name, "isize" to cstr) == 0:
            return make_type(TypeKind.ISize)
        elif strcmp(name, "u8" to cstr) == 0 or strcmp(name, "byte" to cstr) == 0:
            return make_type(TypeKind.U8)
        elif strcmp(name, "u16" to cstr) == 0:
            return make_type(TypeKind.U16)
        elif strcmp(name, "u32" to cstr) == 0:
            return make_type(TypeKind.U32)
        elif strcmp(name, "u64" to cstr) == 0:
            return make_type(TypeKind.U64)
        elif strcmp(name, "u128" to cstr) == 0:
            return make_type(TypeKind.U128)
        elif strcmp(name, "usize" to cstr) == 0:
            return make_type(TypeKind.USize)
        elif strcmp(name, "f16" to cstr) == 0:
            return make_type(TypeKind.F16)
        elif strcmp(name, "bf16" to cstr) == 0 or strcmp(name, "BFloat16" to cstr) == 0:
            return make_type(TypeKind.BFloat16)
        elif strcmp(name, "f32" to cstr) == 0:
            return make_type(TypeKind.F32)
        elif strcmp(name, "f64" to cstr) == 0:
            return make_type(TypeKind.F64)
        elif strcmp(name, "f128" to cstr) == 0:
            return make_type(TypeKind.F128)
        elif strcmp(name, "bool" to cstr) == 0 or strcmp(name, "Boolean" to cstr) == 0:
            return make_type(TypeKind.Boolean)
        elif strcmp(name, "char" to cstr) == 0 or strcmp(name, "Char" to cstr) == 0:
            return make_type(TypeKind.Char)
        elif strcmp(name, "String" to cstr) == 0:
            return make_type(TypeKind.String)
        elif strcmp(name, "cstr" to cstr) == 0:
            return make_type(TypeKind.CStr)
        elif strcmp(name, "str" to cstr) == 0 or strcmp(name, "Utf8Str" to cstr) == 0:
            return make_type(TypeKind.Utf8Str)
        elif strcmp(name, "void" to cstr) == 0:
            return make_type(TypeKind.Void)
        elif strcmp(name, "Any" to cstr) == 0:
            return make_type(TypeKind.Any)
        elif strcmp(name, "List" to cstr) == 0:
            let opt_gen as ptr[u8] = (ref (deref annot).generics) to ptr[u8]
            if option_has_value(opt_gen):
                let val_p as ptr[u8] = option_value(opt_gen)
                let gen_list as ptr[List[TypeAnnotation]] = val_p to ptr[List[TypeAnnotation]]
                if (deref gen_list).length() > 0 to i64:
                    let lay_gen as ptr[ptr[u8]] = gen_list to ptr[ptr[u8]]
                    let elem_annot as ptr[TypeAnnotation] = (deref lay_gen) to ptr[TypeAnnotation]
                    let elem_type as ptr[Type] = self.resolve_type_annotation(elem_annot)
                    let t as ptr[Type] = make_type(TypeKind.List)
                    (deref t).payload = elem_type
                    return t
            let t as ptr[Type] = make_type(TypeKind.List)
            (deref t).payload = make_type(TypeKind.Any)
            return t
        elif strcmp(name, "Dict" to cstr) == 0:
            return make_type(TypeKind.Dict)
        elif strcmp(name, "Option" to cstr) == 0:
            let opt_gen as ptr[u8] = (ref (deref annot).generics) to ptr[u8]
            if option_has_value(opt_gen):
                let val_p as ptr[u8] = option_value(opt_gen)
                let gen_list as ptr[List[TypeAnnotation]] = val_p to ptr[List[TypeAnnotation]]
                if (deref gen_list).length() > 0 to i64:
                    let lay_gen as ptr[ptr[u8]] = gen_list to ptr[ptr[u8]]
                    let elem_annot as ptr[TypeAnnotation] = (deref lay_gen) to ptr[TypeAnnotation]
                    let elem_type as ptr[Type] = self.resolve_type_annotation(elem_annot)
                    let t as ptr[Type] = make_type(TypeKind.Option)
                    (deref t).payload = elem_type
                    return t
            let t as ptr[Type] = make_type(TypeKind.Option)
            (deref t).payload = make_type(TypeKind.Any)
            return t
        elif strcmp(name, "Result" to cstr) == 0:
            return make_type(TypeKind.Result)

        // Handle ptr[T]
        if strcmp(name, "ptr" to cstr) == 0:
            let opt_gen as ptr[u8] = (ref (deref annot).generics) to ptr[u8]
            if option_has_value(opt_gen):
                let val_p as ptr[u8] = option_value(opt_gen)
                let gen_list as ptr[List[TypeAnnotation]] = val_p to ptr[List[TypeAnnotation]]
                if (deref gen_list).length() > 0 to i64:
                    let lay_gen as ptr[ptr[u8]] = gen_list to ptr[ptr[u8]]
                    let elem_annot as ptr[TypeAnnotation] = (deref lay_gen) to ptr[TypeAnnotation]
                    let elem_type as ptr[Type] = self.resolve_type_annotation(elem_annot)
                    return make_ptr_type(elem_type)
            return make_ptr_type(make_type(TypeKind.Void))

        // Check if user-defined struct/class/enum in scope
        let sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(String.make(name))
        if sym != None to ptr[Symbol]:
            if (deref sym).kind == SymbolKind.Struct:
                return make_struct_type(String.make(name))
            elif (deref sym).kind == SymbolKind.Enum:
                return make_enum_type(String.make(name))
            elif (deref sym).kind == SymbolKind.Union:
                return make_union_type(String.make(name))

        return make_type(TypeKind.Unknown)

    public fn check_nizam_import(self as ptr[TypeChecker], name as cstr, span as Span):
        if (deref (deref self).sema).mode to i32 == LanguageMode.Nizam to i32:
            var skip as bool = False
            if strcmp(name, "i8" to cstr) == 0 or strcmp(name, "i16" to cstr) == 0 or strcmp(name, "i32" to cstr) == 0 or strcmp(name, "i64" to cstr) == 0 or strcmp(name, "i128" to cstr) == 0 or strcmp(name, "isize" to cstr) == 0:
                skip = True
            elif strcmp(name, "u8" to cstr) == 0 or strcmp(name, "byte" to cstr) == 0 or strcmp(name, "u16" to cstr) == 0 or strcmp(name, "u32" to cstr) == 0 or strcmp(name, "u64" to cstr) == 0 or strcmp(name, "u128" to cstr) == 0 or strcmp(name, "usize" to cstr) == 0:
                skip = True
            elif strcmp(name, "f16" to cstr) == 0 or strcmp(name, "f32" to cstr) == 0 or strcmp(name, "f64" to cstr) == 0 or strcmp(name, "f128" to cstr) == 0:
                skip = True
            elif strcmp(name, "bool" to cstr) == 0 or strcmp(name, "char" to cstr) == 0 or strcmp(name, "void" to cstr) == 0 or strcmp(name, "ptr" to cstr) == 0 or strcmp(name, "cstr" to cstr) == 0 or strcmp(name, "String" to cstr) == 0 or strcmp(name, "List" to cstr) == 0 or strcmp(name, "Dict" to cstr) == 0:
                skip = True
                
            let name_ptr as ptr[u8] = name to ptr[u8]
            if not skip and (deref name_ptr) >= 65 to u8 and (deref name_ptr) <= 90 to u8:
                let next_char as u8 = deref ((name_ptr to usize + 1 to usize) to ptr[u8])
                if next_char == 0 to u8:
                    skip = True
                    
            if not skip:
                // Check if name is imported in semantic analyzer
                let sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(String.make(name))
                var report as bool = False
                if sym == None to ptr[Symbol]:
                    report = True
                else:
                    if (deref sym).decl_node == None to ptr[Node]:
                        report = True
                
                if report:
                    let sb as StringBuilder = StringBuilder.make()
                    sb.append(name)
                    sb.append(" requires explicit import in Nizam strict mode" to cstr)
                    let msg as String = sb.to_string()
                    (deref (deref self).sema).report_error(msg, span)

    public fn is_implicitly_convertible(self as ptr[TypeChecker], from_t as ptr[Type], to_t as ptr[Type]) as bool:
        if from_t == None to ptr[Type] or to_t == None to ptr[Type]:
            return False
            
        let fk as TypeKind = (deref from_t).kind
        let tk as TypeKind = (deref to_t).kind
        
        if fk == tk:
            if fk == TypeKind.RawPointer:
                return self.is_implicitly_convertible((deref from_t).payload, (deref to_t).payload)
            return True
            
        if fk == TypeKind.Unknown or tk == TypeKind.Unknown or fk == TypeKind.Error or tk == TypeKind.Error:
            return True
            
        // Any conversions
        if fk == TypeKind.Any or tk == TypeKind.Any:
            return True

        // String conversions
        let is_from_str as bool = (fk == TypeKind.String or fk == TypeKind.Utf8Str or fk == TypeKind.AsciiStr or fk == TypeKind.CStr)
        let is_to_str as bool = (tk == TypeKind.String or tk == TypeKind.Utf8Str or tk == TypeKind.AsciiStr or tk == TypeKind.CStr)
        if is_from_str and is_to_str:
            return True

        // Numeric conversions (integers / floats)
        let is_from_num as bool = (fk == TypeKind.I8 or fk == TypeKind.I16 or fk == TypeKind.I32 or fk == TypeKind.I64 or fk == TypeKind.I128 or fk == TypeKind.ISize or fk == TypeKind.U8 or fk == TypeKind.U16 or fk == TypeKind.U32 or fk == TypeKind.U64 or fk == TypeKind.U128 or fk == TypeKind.USize or fk == TypeKind.F16 or fk == TypeKind.BFloat16 or fk == TypeKind.F32 or fk == TypeKind.F64 or fk == TypeKind.F128)
        let is_to_num as bool = (tk == TypeKind.I8 or tk == TypeKind.I16 or tk == TypeKind.I32 or tk == TypeKind.I64 or tk == TypeKind.I128 or tk == TypeKind.ISize or tk == TypeKind.U8 or tk == TypeKind.U16 or tk == TypeKind.U32 or tk == TypeKind.U64 or tk == TypeKind.U128 or tk == TypeKind.USize or tk == TypeKind.F16 or tk == TypeKind.BFloat16 or tk == TypeKind.F32 or tk == TypeKind.F64 or tk == TypeKind.F128)
        if is_from_num and is_to_num:
            return True

        return False

    public fn clone_and_substitute(self as ptr[TypeChecker], node as ptr[Node], param_name as cstr, concrete_type as ptr[Type]) as ptr[Node]:
        extern fn memset(s as ptr, c as i32, n as usize) as ptr
        if node == None to ptr[Node]:
            return None to ptr[Node]
            
        let nt as NodeType = node_kind(node)
        let res as ptr[Node] = make_node(nt, node_span(node))
        set_node_module_name(res, node_module_name(node))
        set_node_val(res, node_val(node))
        set_node_op(res, node_op(node))
        set_node_is_mut(res, node_is_mut(node))
        set_node_is_async(res, node_is_async(node))
        set_node_name(res, node_name(node))
        
        if node_type_annots(node) == None to ptr[List[Option[ptr[TypeAnnotation]]]]:
            set_node_type_annots(res, None to ptr[List[Option[ptr[TypeAnnotation]]]])
        else:
            let type_annots as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(node)
            let wrapper as ptr[ListWrapper] = make[ListWrapper](1 to usize)
            let dummy_memset3 as ptr = memset(wrapper to ptr, 0 to i32, 24 to usize)
            (deref wrapper).list = List[Option[ptr[TypeAnnotation]]]()
            let cloned_annots_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = ref (deref wrapper).list
            
            let count_annots as i64 = (deref type_annots).length()
            var a_idx as i64 = 0 to i64
            while a_idx < count_annots:
                let lay as ptr[ptr[u8]] = type_annots to ptr[ptr[u8]]
                let addr as usize = (deref lay) to usize
                let opt_annot as ptr[u8] = (addr + (a_idx * 16 to usize)) to ptr[u8]
                if option_has_value(opt_annot):
                    let val_p as ptr[u8] = option_value(opt_annot)
                    let orig_annot as ptr[TypeAnnotation] = val_p to ptr[TypeAnnotation]
                    
                    let annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize)
                    deref annot = deref orig_annot
                    
                    if strcmp((deref annot).name.data to cstr, param_name) == 0:
                        (deref annot).name = (deref concrete_type).name
                    (deref cloned_annots_ptr).append(Some(annot))
                else:
                    (deref cloned_annots_ptr).append(Empty)
                a_idx = a_idx + 1 to i64
            set_node_type_annots(res, cloned_annots_ptr)

        let _sep3 as i32 = 0
        set_node_left(res, self.clone_and_substitute(node_left(node), param_name, concrete_type))
        set_node_right(res, self.clone_and_substitute(node_right(node), param_name, concrete_type))
        set_node_body(res, self.clone_and_substitute(node_body(node), param_name, concrete_type))
        set_node_cond(res, self.clone_and_substitute(node_cond(node), param_name, concrete_type))
        set_node_then_branch(res, self.clone_and_substitute(node_then_branch(node), param_name, concrete_type))
        set_node_str_val(res, node_str_val(node))
        
        let node_decls as List[ptr[Node]] = node_declarations(node)
        let count as i64 = node_decls.length()
        let decls as List[ptr[Node]] = List[ptr[Node]]()
        var i as i64 = 0 to i64
        while i < count:
            decls.append(self.clone_and_substitute(node_decls[i], param_name, concrete_type))
            i = i + 1 to i64
        set_node_declarations(res, decls)
        
        let node_prms as List[ptr[Node]] = node_params(node)
        let p_count as i64 = node_prms.length()
        let params as List[ptr[Node]] = List[ptr[Node]]()
        var p_idx as i64 = 0 to i64
        while p_idx < p_count:
            params.append(self.clone_and_substitute(node_prms[p_idx], param_name, concrete_type))
            p_idx = p_idx + 1 to i64
        set_node_params(res, params)

        return res

    public fn monomorphize(self as ptr[TypeChecker], template_node as ptr[Node], param_name as cstr, concrete_type as ptr[Type]) as ptr[Node]:
        // Clone and substitute the template
        let monomorphized as ptr[Node] = self.clone_and_substitute(template_node, param_name, concrete_type)
        
        // Generate mangled name
        let sb as StringBuilder = StringBuilder.make()
        sb.append(node_name(template_node).data to cstr)
        sb.append("_" to cstr)
        sb.append((deref concrete_type).name.data to cstr)
        let mangled_name as String = sb.to_string()
        
        set_node_name(monomorphized, mangled_name)
        mangled_name.data = None to ptr[u8]
        
        // Run declare_pass on the monomorphized subtree to register the new symbol
        (deref (deref self).sema).declare_pass(monomorphized)
        // Run resolve_pass on it
        (deref (deref self).sema).resolve_pass(monomorphized)
        // Run type checker on it
        let dummy1 as ptr[Type] = self.typecheck_node(monomorphized)
        
        return monomorphized

    public fn typecheck_node(self as ptr[TypeChecker], node as ptr[Node]) as ptr[Type]:
        extern fn memset(s as ptr, c: i32, n: usize) as ptr
        if node == None to ptr[Node]:
            return make_type(TypeKind.Void)
            
        let nt as NodeType = node_kind(node)
        var ret_type as ptr[Type] = make_type(TypeKind.Void)
        
        if nt == NodeType.Program:
            let decls as List[ptr[Node]] = node_declarations(node)
            let count as i64 = decls.length()
            var i as i64 = 0 to i64
            while i < count:
                let dummy2 as ptr[Type] = self.typecheck_node(decls[i])
                i = i + 1 to i64
            ret_type = make_type(TypeKind.Void)
            
        elif nt == NodeType.BlockStmt:
            let decls as List[ptr[Node]] = node_declarations(node)
            let count as i64 = decls.length()
            var i as i64 = 0 to i64
            while i < count:
                ret_type = self.typecheck_node(decls[i])
                i = i + 1 to i64
                
        elif nt == NodeType.VarDecl:
            let name as cstr = node_name(node).data to cstr
            var annotated_type as ptr[Type] = None to ptr[Type]
            
            if node_type_annots(node) != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                let type_annots as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(node)
                if (deref type_annots).length() > 0 to i64:
                    let lay as ptr[ptr[u8]] = type_annots to ptr[ptr[u8]]
                    let opt_annot as ptr[u8] = deref lay
                    if option_has_value(opt_annot):
                        let val_p as ptr[u8] = option_value(opt_annot)
                        let annot_val as ptr[TypeAnnotation] = val_p to ptr[TypeAnnotation]
                        annotated_type = self.resolve_type_annotation(annot_val)
                        self.check_nizam_import((deref annot_val).name.data to cstr, node_span(node))
            
            if node_left(node) != None to ptr[Node]:
                let init_node as ptr[Node] = node_left(node)
                
                if annotated_type != None to ptr[Type]:
                    if node_kind(init_node) == NodeType.NumberLiteral:
                        set_node_inferred_type(init_node, annotated_type)
                    
                    let init_type as ptr[Type] = self.typecheck_node(init_node)
                    if not self.is_implicitly_convertible(init_type, annotated_type):
                        (deref (deref self).sema).report_error(String.make("type mismatch in variable initialization" to cstr), node_span(node))
                else:
                    let init_type as ptr[Type] = self.typecheck_node(init_node)
                    annotated_type = init_type
            
            let sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(String.make(name))
            if sym != None to ptr[Symbol] and annotated_type != None to ptr[Type]:
                (deref sym).resolved_type = annotated_type
            if annotated_type != None to ptr[Type]:
                set_node_inferred_type(node, annotated_type)
                ret_type = annotated_type
            else:
                ret_type = make_type(TypeKind.Void)
            
        elif nt == NodeType.FunDecl:
            let sema_ptr as ptr[Sema] = (deref self).sema
            let parent_scope as ptr[Scope] = (deref sema_ptr).current_scope
            var child_scope as ptr[Scope] = None to ptr[Scope]
            
            let fn_key as usize = node_span(node).start_row to usize * 1000 to usize + node_span(node).start_col to usize
            if (deref sema_ptr).fn_scopes.has(fn_key):
                child_scope = (deref sema_ptr).fn_scopes[fn_key]
            else:
                child_scope = make_scope(parent_scope, node)
                (deref sema_ptr).fn_scopes[fn_key] = child_scope
            
            let saved_scope as ptr[Scope] = (deref sema_ptr).current_scope
            (deref sema_ptr).current_scope = child_scope
            
            let f_type as ptr[Type] = make_type(TypeKind.Function)
            
            // Use return type annotation if available
            let ret_annot as ptr[TypeAnnotation] = node_return_type_annot(node)
            if ret_annot != None to ptr[TypeAnnotation] and (deref ret_annot).name.len > 0 to usize:
                (deref f_type).return_type = self.resolve_type_annotation(ret_annot)
            else:
                (deref f_type).return_type = make_type(TypeKind.Void)
            let f_params as ptr[List[Type]] = ref (deref f_type).param_types
            
            let params as List[ptr[Node]] = node_params(node)
            let param_count as i64 = params.length()
            var p_idx as i64 = 0 to i64
            while p_idx < param_count:
                let p_node as ptr[Node] = params[p_idx]
                let p_name as cstr = node_name(p_node).data to cstr
                
                var p_sym as ptr[Symbol] = None to ptr[Symbol]
                if (deref child_scope).symbols.has(String.make(p_name)):
                    p_sym = (deref child_scope).symbols[String.make(p_name)]
                else:
                    p_sym = make_symbol(String.make(p_name), SymbolKind.Variable, p_node)
                    (deref child_scope).symbols[String.make(p_name)] = p_sym
                
                var p_type as ptr[Type] = None to ptr[Type]
                if node_type_annots(p_node) != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                    let p_annots as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(p_node)
                    if (deref p_annots).length() > 0 to i64:
                        let lay as ptr[ptr[u8]] = p_annots to ptr[ptr[u8]]
                        let opt_annot as ptr[u8] = deref lay
                        if option_has_value(opt_annot):
                            let val_p as ptr[u8] = option_value(opt_annot)
                            let annot_val as ptr[TypeAnnotation] = val_p to ptr[TypeAnnotation]
                            p_type = self.resolve_type_annotation(annot_val)
                            self.check_nizam_import((deref annot_val).name.data to cstr, node_span(p_node))
                
                if p_type == None to ptr[Type]:
                    p_type = make_type(TypeKind.Any)
                    
                let p_sym_resolved_ptr as ptr[ptr[Type]] = ref (deref p_sym).resolved_type
                deref p_sym_resolved_ptr = p_type
                set_node_inferred_type(p_node, p_type)
                (deref f_params).append(deref p_type)
                p_idx = p_idx + 1 to i64
            
            let saved_ret as Option[ptr[Type]] = (deref self).current_function_return
            let self_ptr as ptr[TypeChecker] = self
            let self_ref_ret as ptr[Option[ptr[Type]]] = ref (deref self_ptr).current_function_return
            deref self_ref_ret = Some((deref f_type).return_type)
            // Reset inferred return type tracker
            (deref self_ptr).inferred_return_type = None to ptr[Type]
            
            if node_body(node) != None to ptr[Node]:
                let dummy3 as ptr[Type] = self.typecheck_node(node_body(node))
                
            // Validate return type if declared return type is not Void/Any/Unknown (skip for extern)
            if not node_is_extern(node):
                let declared_ret as ptr[Type] = (deref f_type).return_type
                let declared_kind as TypeKind = (deref declared_ret).kind
                if declared_kind != TypeKind.Void and declared_kind != TypeKind.Any and declared_kind != TypeKind.Unknown:
                    let inferred_ret as ptr[Type] = (deref self_ptr).inferred_return_type
                    if inferred_ret != None to ptr[Type]:
                        let inferred_kind as TypeKind = (deref inferred_ret).kind
                        if inferred_kind != TypeKind.Void and inferred_kind != TypeKind.Any and inferred_kind != TypeKind.Unknown:
                            if not self.is_implicitly_convertible(inferred_ret, declared_ret):
                                (deref (deref self).sema).report_error(String.make("return type mismatch: declared return type does not match actual return type" to cstr), node_span(node))
                    else:
                        (deref (deref self).sema).report_error(String.make("function with non-void return type must return a value" to cstr), node_span(node))
            
            let self_ref_ret_back as ptr[Option[ptr[Type]]] = ref (deref self_ptr).current_function_return
            deref self_ref_ret_back = saved_ret
            
            (deref sema_ptr).current_scope = parent_scope
            
            let f_name as cstr = node_name(node).data to cstr
            if (deref parent_scope).symbols.has(String.make(f_name)):
                let f_sym as ptr[Symbol] = (deref parent_scope).symbols[String.make(f_name)]
                (deref f_sym).resolved_type = f_type
                
            ret_type = (deref f_type).return_type
            
        elif nt == NodeType.Identifier:
            let name as cstr = node_name(node).data to cstr
            if strcmp(name, "UNSUPPORTED" to cstr) == 0:
                ret_type = make_type(TypeKind.Void)
            else:
                let sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(String.make(name))
                if sym != None to ptr[Symbol]:
                    if (deref sym).resolved_type != None to ptr[Type]:
                        ret_type = (deref sym).resolved_type
                    else:
                        ret_type = make_type(TypeKind.Any)
                else:
                    ret_type = make_type(TypeKind.Unknown)
                
        elif nt == NodeType.NumberLiteral:
            if node_inferred_type(node) != None to ptr[Type]:
                ret_type = node_inferred_type(node)
            else:
                ret_type = make_type(TypeKind.I32)
                
        elif nt == NodeType.StringLiteral:
            ret_type = make_type(TypeKind.String)
                
        elif nt == NodeType.BinaryExpr:
            let left as ptr[Node] = node_left(node)
            let right as ptr[Node] = node_right(node)
            
            if strcmp(node_op(node).data to cstr, "." to cstr) == 0:
                ret_type = make_type(TypeKind.Any)
            elif strcmp(node_op(node).data to cstr, "=" to cstr) == 0:
                let left_t as ptr[Type] = self.typecheck_node(left)
                if left_t != None to ptr[Type]:
                    if node_kind(right) == NodeType.NumberLiteral:
                        set_node_inferred_type(right, left_t)
                let right_t as ptr[Type] = self.typecheck_node(right)
                if not self.is_implicitly_convertible(right_t, left_t):
                    (deref (deref self).sema).report_error(String.make("type mismatch in assignment" to cstr), node_span(node))
                ret_type = left_t
            else:
                let left_t as ptr[Type] = self.typecheck_node(left)
                let right_t as ptr[Type] = self.typecheck_node(right)
                
                if not self.is_implicitly_convertible(left_t, right_t):
                    (deref (deref self).sema).report_error(String.make("type mismatch in binary expression" to cstr), node_span(node))
                
                let lk as TypeKind = (deref left_t).kind
                let rk as TypeKind = (deref right_t).kind
                let left_is_default_lit as bool = node_kind(left) == NodeType.NumberLiteral and lk == TypeKind.I32
                let right_is_default_lit as bool = node_kind(right) == NodeType.NumberLiteral and rk == TypeKind.I32
                
                if left_is_default_lit and not right_is_default_lit:
                    set_node_inferred_type(left, right_t)
                    ret_type = right_t
                elif right_is_default_lit and not left_is_default_lit:
                    set_node_inferred_type(right, left_t)
                    ret_type = left_t
                else:
                    ret_type = left_t
                    
        elif nt == NodeType.CallExpr:
            let callee as ptr[Node] = node_left(node)
            let callee_t as ptr[Type] = self.typecheck_node(callee)
            
            let args as List[ptr[Node]] = node_params(node)
            let arg_count as i64 = args.length()
            var a_idx as i64 = 0 to i64
            
            if callee_t != None to ptr[Type] and (deref callee_t).kind == TypeKind.Function:
                let params as ptr[List[Type]] = ref (deref callee_t).param_types
                let expected_count as i64 = (deref params).length()
                while a_idx < arg_count:
                    let arg_node as ptr[Node] = args[a_idx]
                    if a_idx < expected_count:
                        let expected_t as ptr[Type] = ref (deref params)[a_idx]
                        if node_kind(arg_node) == NodeType.NumberLiteral:
                            set_node_inferred_type(arg_node, expected_t)
                    let dummy_a as ptr[Type] = self.typecheck_node(arg_node)
                    a_idx = a_idx + 1 to i64
            else:
                while a_idx < arg_count:
                    let dummy_a as ptr[Type] = self.typecheck_node(args[a_idx])
                    a_idx = a_idx + 1 to i64
            
            if callee_t != None to ptr[Type] and (deref callee_t).kind == TypeKind.Function and (deref callee_t).return_type != None to ptr[Type]:
                ret_type = (deref callee_t).return_type
            else:
                ret_type = make_type(TypeKind.Any)
                
        elif nt == NodeType.ReturnStmt:
            let return_val as ptr[Node] = node_body(node)
            if return_val != None to ptr[Node]:
                let opt_ret as ptr[u8] = (ref (deref self).current_function_return) to ptr[u8]
                if option_has_value(opt_ret):
                    let val_p as ptr[u8] = option_value(opt_ret)
                    let expected_ret_t as ptr[Type] = val_p to ptr[Type]
                    let ek as TypeKind = (deref expected_ret_t).kind
                    if ek != TypeKind.Void and ek != TypeKind.Any and ek != TypeKind.Unknown:
                        if node_kind(return_val) == NodeType.NumberLiteral:
                            set_node_inferred_type(return_val, expected_ret_t)
                ret_type = self.typecheck_node(return_val)
                // Track inferred return type for validation
                let self_ptr_r as ptr[TypeChecker] = self
                (deref self_ptr_r).inferred_return_type = ret_type
            else:
                ret_type = make_type(TypeKind.Void)
                
        elif nt == NodeType.WhileStmt:
            let dummy_c as ptr[Type] = self.typecheck_node(node_cond(node))
            let dummy_b as ptr[Type] = self.typecheck_node(node_body(node))
            ret_type = make_type(TypeKind.Void)
            
        elif nt == NodeType.ForStmt:
            let dummy_iter as ptr[Type] = self.typecheck_node(node_left(node))
            let dummy_body as ptr[Type] = self.typecheck_node(node_body(node))
            ret_type = make_type(TypeKind.Void)
            
        elif nt == NodeType.MemberExpr:
            let obj_t as ptr[Type] = self.typecheck_node(node_left(node))
            let obj_kind as TypeKind = (deref obj_t).kind
            if obj_kind == TypeKind.Module:
                let left_name as String = node_name(node_left(node))
                if (deref (deref self).sema).loaded_modules.has(left_name):
                    let mod_scope as ptr[Scope] = (deref (deref self).sema).loaded_modules[left_name]
                    let prop_name as String = node_name(node)
                    if (deref mod_scope).symbols.has(prop_name):
                        let member_sym as ptr[Symbol] = (deref mod_scope).symbols[prop_name]
                        if (deref member_sym).resolved_type != None to ptr[Type]:
                            ret_type = (deref member_sym).resolved_type
                        else:
                            ret_type = make_type(TypeKind.Any)
                    else:
                        (deref (deref self).sema).report_error(String.make("module has no member with that name" to cstr), node_span(node))
                        ret_type = make_type(TypeKind.Any)
                else:
                    ret_type = make_type(TypeKind.Any)
            else:
                if obj_kind == TypeKind.Struct and (deref obj_t).name.len > 0 to usize:
                    let struct_name as String = (deref obj_t).name
                    let struct_sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(struct_name)
                    if struct_sym != None to ptr[Symbol] and (deref struct_sym).decl_node != None to ptr[Node]:
                        let decl as ptr[Node] = (deref struct_sym).decl_node
                        if node_body(decl) != None to ptr[Node]:
                            let body as ptr[Node] = node_body(decl)
                            let prop_name as String = node_name(node)
                            if node_kind(body) == NodeType.BlockStmt:
                                let body_decls as List[ptr[Node]] = node_declarations(body)
                                let d_count as i64 = body_decls.length()
                                var d_i as i64 = 0 to i64
                                while d_i < d_count:
                                    let field_decl as ptr[Node] = body_decls[d_i]
                                    if node_kind(field_decl) == NodeType.VarDecl and strcmp(node_name(field_decl).data to cstr, prop_name.data to cstr) == 0:
                                        if node_inferred_type(field_decl) != None to ptr[Type]:
                                            ret_type = node_inferred_type(field_decl)
                                        break
                                    d_i = d_i + 1 to i64
                    if ret_type == None to ptr[Type] or (deref ret_type).kind == TypeKind.Void:
                        ret_type = make_type(TypeKind.Any)
                else:
                    ret_type = make_type(TypeKind.Any)
        elif nt == NodeType.WithStmt:
            let expr_t as ptr[Type] = self.typecheck_node(node_left(node))
            let body_t as ptr[Type] = self.typecheck_node(node_body(node))
            ret_type = body_t

        elif nt == NodeType.IfStmt:
            let dummy_c as ptr[Type] = self.typecheck_node(node_cond(node))
            let then_t as ptr[Type] = self.typecheck_node(node_then_branch(node))
            let else_opt_raw as Option[ptr[Node]] = node_else_branch(node)
            let else_opt as ptr[u8] = (ref else_opt_raw) to ptr[u8]
            if option_has_value(else_opt):
                let else_node as ptr[Node] = option_value(else_opt) to ptr[Node]
                let else_t as ptr[Type] = self.typecheck_node(else_node)
                // Merge branch types
                if (deref then_t).kind == (deref else_t).kind:
                    ret_type = then_t
                elif (deref then_t).kind == TypeKind.Void or (deref else_t).kind == TypeKind.Void:
                    ret_type = make_type(TypeKind.Void)
                elif (deref then_t).kind == TypeKind.Any or (deref else_t).kind == TypeKind.Any:
                    ret_type = make_type(TypeKind.Any)
                elif (deref then_t).kind == TypeKind.Unknown or (deref else_t).kind == TypeKind.Unknown:
                    ret_type = make_type(TypeKind.Unknown)
                else:
                    ret_type = make_type(TypeKind.Void)
            else:
                ret_type = make_type(TypeKind.Void)

        elif nt == NodeType.UnaryExpr:
            let operand_t as ptr[Type] = self.typecheck_node(node_left(node))
            let op as String = node_op(node)
            if strcmp(op.data to cstr, "not" to cstr) == 0:
                ret_type = make_type(TypeKind.Boolean)
            elif strcmp(op.data to cstr, "-" to cstr) == 0 or strcmp(op.data to cstr, "+" to cstr) == 0:
                ret_type = operand_t
            elif strcmp(op.data to cstr, "ref" to cstr) == 0 or strcmp(op.data to cstr, "ref mut" to cstr) == 0:
                let payload_t as ptr[Type] = make[Type](1 to usize) to ptr[Type]
                (deref payload_t) = deref operand_t
                ret_type = make_ptr_type(payload_t)
            elif strcmp(op.data to cstr, "deref" to cstr) == 0:
                if (deref operand_t).kind == TypeKind.RawPointer and (deref operand_t).payload != None to ptr[Type]:
                    ret_type = (deref operand_t).payload
                else:
                    ret_type = make_type(TypeKind.Any)
            elif strcmp(op.data to cstr, "~" to cstr) == 0:
                ret_type = operand_t
            else:
                ret_type = operand_t

        elif nt == NodeType.CastExpr:
            let _dummy_op as ptr[Type] = self.typecheck_node(node_left(node))
            let target_name as String = node_op(node)
            if target_name.len > 0 to usize:
                let tmp_annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
                (deref tmp_annot).name = target_name
                (deref tmp_annot).lifetime = Empty
                (deref tmp_annot).generics = Empty
                (deref tmp_annot).params = Empty
                (deref tmp_annot).return_type = None to ptr[TypeAnnotation]
                ret_type = self.resolve_type_annotation(tmp_annot)
            else:
                ret_type = make_type(TypeKind.Any)

        elif nt == NodeType.MatchStmt:
            let subject_t as ptr[Type] = self.typecheck_node(node_left(node))
            let cases as List[ptr[Node]] = node_declarations(node)
            let case_count as i64 = cases.length()
            var c_idx as i64 = 0 to i64
            while c_idx < case_count:
                let case_node as ptr[Node] = cases[c_idx]
                if node_kind(case_node) == NodeType.BinaryExpr:
                    let pattern as ptr[Node] = node_left(case_node)
                    let case_body as ptr[Node] = node_right(case_node)
                    if node_kind(pattern) == NodeType.Identifier:
                        let pat_name as String = node_name(pattern)
                        if strcmp(pat_name.data to cstr, "_" to cstr) != 0:
                            let sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(pat_name)
                            if sym != None to ptr[Symbol]:
                                (deref sym).resolved_type = subject_t
                            set_node_inferred_type(pattern, subject_t)
                    else:
                        let _dummy_p as ptr[Type] = self.typecheck_node(pattern)
                    let _dummy_b as ptr[Type] = self.typecheck_node(case_body)
                c_idx = c_idx + 1 to i64
            ret_type = make_type(TypeKind.Any)

        elif nt == NodeType.TryStmt:
            let body_t as ptr[Type] = self.typecheck_node(node_left(node))
            // Unwrap Result/Option type
            if (deref body_t).kind == TypeKind.Result or (deref body_t).kind == TypeKind.Option:
                if (deref body_t).payload != None to ptr[Type]:
                    ret_type = (deref body_t).payload
                else:
                    ret_type = make_type(TypeKind.Any)
            else:
                ret_type = body_t

        elif nt == NodeType.ThrowStmt:
            let _dummy_exc as ptr[Type] = self.typecheck_node(node_left(node))
            ret_type = make_type(TypeKind.Void)

        elif nt == NodeType.ListLiteral:
            ret_type = make_type(TypeKind.List)
            let items as List[ptr[Node]] = node_declarations(node)
            let item_count as i64 = items.length()
            if item_count > 0 to i64:
                let elem_t as ptr[Type] = self.typecheck_node(items[0])
                (deref ret_type).payload = elem_t

        elif nt == NodeType.DictLiteral:
            ret_type = make_type(TypeKind.Dict)

        elif nt == NodeType.IndexExpr:
            let _dummy_coll as ptr[Type] = self.typecheck_node(node_left(node))
            let _dummy_idx as ptr[Type] = self.typecheck_node(node_right(node))
            ret_type = make_type(TypeKind.Any)

        elif nt == NodeType.SpreadExpr:
            let _dummy_spread as ptr[Type] = self.typecheck_node(node_left(node))
            ret_type = make_type(TypeKind.Any)

        elif nt == NodeType.BooleanLiteral:
            ret_type = make_type(TypeKind.Boolean)

        elif nt == NodeType.StructDecl:
            let struct_name as String = node_name(node)
            ret_type = make_struct_type(struct_name)
            if node_body(node) != None to ptr[Node]:
                let dummy_sd as ptr[Type] = self.typecheck_node(node_body(node))

        elif nt == NodeType.EnumDecl:
            let enum_name as String = node_name(node)
            ret_type = make_enum_type(enum_name)

        elif nt == NodeType.UnionDecl:
            let union_name as String = node_name(node)
            ret_type = make_union_type(union_name)
            if node_body(node) != None to ptr[Node]:
                let dummy_ud as ptr[Type] = self.typecheck_node(node_body(node))

        let _sep2 as i32 = 0
        set_node_inferred_type(node, ret_type)
        return ret_type
