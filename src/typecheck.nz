            ret_type = make_enum_type(enum_name)
            if (deref (deref self).sema).fn_scopes.has(node to usize):
                let sema_ed as ptr[Sema] = (deref self).sema
                let saved_scope_ed as ptr[Scope] = (deref sema_ed).current_scope
                (deref sema_ed).current_scope = (deref sema_ed).fn_scopes[node to usize]
                let saved_struct_t as ptr[Type] = (deref self).current_struct_type
                (deref self).current_struct_type = ret_type
