            let _dummy_exc as ptr[Type] = self.typecheck_node(node_left(node))
            ret_type = make_type(TypeKind.Void)

        elif nt == NodeType.ListLiteral:
            ret_type = make_type(TypeKind.List)
            let items as List[ptr[Node]] = node_declarations(node)
            let item_count as i64 = items.length()
            var elem_t as ptr[Type] = None to ptr[Type]
            var item_idx as i64 = 0 to i64
            while item_idx < item_count:
