                (deref self).current_struct_type = ret_type
                let dummy_sd as ptr[Type] = self.typecheck_node(node_body(node))
                (deref self).current_struct_type = saved_struct_t
                (deref sema_sd).current_scope = saved_scope_sd

        elif nt == NodeType.EnumDecl:
