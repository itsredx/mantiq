extern fn printf(fmt as cstr, ...) as i32

struct OptionLayout:
    public var has_val as u8
    public var val_ptr as ptr[u8]

fn option_has_value(opt as ptr[u8]) as bool:
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).has_val == 1 to u8

fn option_value(opt as ptr[u8]) as ptr[u8]:
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).val_ptr

struct ListWrapper:
    public var list as List[Option[ptr[TypeAnnotation]]]

// ── TypeChecker ─────────────────────────────────────────────────────────
struct TypeChecker:
    public var sema as ptr[Sema]
    public var current_function_return as Option[ptr[Type]]
    public var inferred_return_type as ptr[Type]
    public var current_struct_type as ptr[Type]

    public fn init_tc(self as ptr[TypeChecker], sema as ptr[Sema]):
        (deref self).sema = sema
        (deref self).current_function_return = Empty
        (deref self).inferred_return_type = None to ptr[Type]
        (deref self).current_struct_type = None to ptr[Type]

    public fn resolve_base_type_annotation(self as ptr[TypeChecker], annot as ptr[TypeAnnotation]) as ptr[Type]:
        let name_data as ptr[u8] = (deref annot).name.data
        let name_len as usize = (deref annot).name.len
        if name_data == None to ptr[u8] or name_len == 0 to usize:
            return make_type(TypeKind.Void)
        let name as cstr = name_data to cstr
        if strcmp(name, "i8" to cstr) == 0:
            return make_type(TypeKind.I8)
        elif strcmp(name, "i16" to cstr) == 0:
            return make_type(TypeKind.I16)
        elif strcmp(name, "i32" to cstr) == 0:
            return make_type(TypeKind.I32)
        elif strcmp(name, "i64" to cstr) == 0:
            return make_type(TypeKind.I64)
        elif strcmp(name, "i128" to cstr) == 0:
            return make_type(TypeKind.I128)
        elif strcmp(name, "i256" to cstr) == 0:
            return make_type(TypeKind.I256)
        elif strcmp(name, "i512" to cstr) == 0:
            return make_type(TypeKind.I512)
        elif strcmp(name, "i1024" to cstr) == 0:
            return make_type(TypeKind.I1024)
        elif strcmp(name, "isize" to cstr) == 0:
            return make_type(TypeKind.ISize)
        elif strcmp(name, "u8" to cstr) == 0 or strcmp(name, "byte" to cstr) == 0:
            return make_type(TypeKind.U8)
        elif strcmp(name, "u16" to cstr) == 0:
            return make_type(TypeKind.U16)
        elif strcmp(name, "u32" to cstr) == 0:
            return make_type(TypeKind.U32)
        elif strcmp(name, "u64" to cstr) == 0:
            return make_type(TypeKind.U64)
        elif strcmp(name, "u128" to cstr) == 0:
            return make_type(TypeKind.U128)
        elif strcmp(name, "u256" to cstr) == 0:
            return make_type(TypeKind.U256)
        elif strcmp(name, "u512" to cstr) == 0:
            return make_type(TypeKind.U512)
        elif strcmp(name, "u1024" to cstr) == 0:
            return make_type(TypeKind.U1024)
        elif strcmp(name, "usize" to cstr) == 0:
            return make_type(TypeKind.USize)
        elif strcmp(name, "f16" to cstr) == 0:
            return make_type(TypeKind.F16)
        elif strcmp(name, "bf16" to cstr) == 0 or strcmp(name, "BFloat16" to cstr) == 0:
            return make_type(TypeKind.BFloat16)
        elif strcmp(name, "f32" to cstr) == 0:
            return make_type(TypeKind.F32)
        elif strcmp(name, "f64" to cstr) == 0:
            return make_type(TypeKind.F64)
        elif strcmp(name, "f128" to cstr) == 0:
            return make_type(TypeKind.F128)
        elif strcmp(name, "bool" to cstr) == 0 or strcmp(name, "Boolean" to cstr) == 0:
            return make_type(TypeKind.Boolean)
        elif strcmp(name, "char" to cstr) == 0 or strcmp(name, "Char" to cstr) == 0:
            return make_type(TypeKind.Char)
        elif strcmp(name, "String" to cstr) == 0:
            return make_type(TypeKind.String)
        elif strcmp(name, "cstr" to cstr) == 0:
            return make_type(TypeKind.CStr)
        elif strcmp(name, "str" to cstr) == 0 or strcmp(name, "Utf8Str" to cstr) == 0:
            return make_type(TypeKind.Utf8Str)
        elif strcmp(name, "void" to cstr) == 0:
            return make_type(TypeKind.Void)
        elif strcmp(name, "Any" to cstr) == 0:
            return make_type(TypeKind.Any)
        elif strcmp(name, "qbit" to cstr) == 0:
            return make_type(TypeKind.QBit)
        elif strcmp(name, "qreg" to cstr) == 0:
            return make_type(TypeKind.QReg)
        elif strcmp(name, "List" to cstr) == 0:
            let opt_gen as ptr[u8] = (ref (deref annot).generics) to ptr[u8]
            if option_has_value(opt_gen):
                let val_p as ptr[u8] = option_value(opt_gen)
                let gen_list as ptr[List[TypeAnnotation]] = val_p to ptr[List[TypeAnnotation]]
                if (deref gen_list).length() > 0 to i64:
                    var elem_annot as TypeAnnotation = (deref gen_list)[0]
                    let elem_type as ptr[Type] = self.resolve_type_annotation(ref elem_annot)
                    let t as ptr[Type] = make_type(TypeKind.List)
                    (deref t).payload = elem_type
                    return t
            let t as ptr[Type] = make_type(TypeKind.List)
            (deref t).payload = make_type(TypeKind.Any)
            return t
        elif strcmp(name, "Dict" to cstr) == 0:
            let d_opt_gen as ptr[u8] = (ref (deref annot).generics) to ptr[u8]
            if option_has_value(d_opt_gen):
                let d_val_p as ptr[u8] = option_value(d_opt_gen)
                let d_gen_list as ptr[List[TypeAnnotation]] = d_val_p to ptr[List[TypeAnnotation]]
                if (deref d_gen_list).length() > 1 to i64:
                    var d_val_annot as TypeAnnotation = (deref d_gen_list)[1]
                    let d_val_type as ptr[Type] = self.resolve_type_annotation(ref d_val_annot)
                    let d_t as ptr[Type] = make_type(TypeKind.Dict)
                    (deref d_t).payload = d_val_type
                    if (deref d_gen_list).length() > 0 to i64:
                        let d_key_annot as TypeAnnotation = (deref d_gen_list)[0]
                        (deref d_t).name = d_key_annot.name
                    return d_t
            let d_t as ptr[Type] = make_type(TypeKind.Dict)
            (deref d_t).payload = make_type(TypeKind.Any)
            return d_t
        elif strcmp(name, "Option" to cstr) == 0:
            let opt_gen as ptr[u8] = (ref (deref annot).generics) to ptr[u8]
            if option_has_value(opt_gen):
                let val_p as ptr[u8] = option_value(opt_gen)
                let gen_list as ptr[List[TypeAnnotation]] = val_p to ptr[List[TypeAnnotation]]
                if (deref gen_list).length() > 0 to i64:
                    var elem_annot as TypeAnnotation = (deref gen_list)[0]
                    let elem_type as ptr[Type] = self.resolve_type_annotation(ref elem_annot)
                    let t as ptr[Type] = make_type(TypeKind.Option)
                    (deref t).payload = elem_type
                    return t
            let t as ptr[Type] = make_type(TypeKind.Option)
            (deref t).payload = make_type(TypeKind.Any)
            return t
        elif strcmp(name, "Result" to cstr) == 0:
            let opt_gen as ptr[u8] = (ref (deref annot).generics) to ptr[u8]
            if option_has_value(opt_gen):
                let val_p as ptr[u8] = option_value(opt_gen)
                let gen_list as ptr[List[TypeAnnotation]] = val_p to ptr[List[TypeAnnotation]]
                if (deref gen_list).length() > 0 to i64:
                    var elem_annot as TypeAnnotation = (deref gen_list)[0]
                    let elem_type as ptr[Type] = self.resolve_type_annotation(ref elem_annot)
                    let t as ptr[Type] = make_type(TypeKind.Result)
                    (deref t).payload = elem_type
                    return t
            let t as ptr[Type] = make_type(TypeKind.Result)
            (deref t).payload = make_type(TypeKind.Any)
            return t

        if strncmp(name, "Dict[" to cstr, 5 to usize) == 0 and name_len > 6 to usize:
            extern fn strchr(s as cstr, c as i32) as cstr
            extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
            extern fn free(p as ptr)
            let inner_len as usize = name_len - 6 to usize
            let inner_buf as ptr[u8] = make[u8](inner_len + 1 to usize) to ptr[u8]
            let _md as ptr = memcpy(inner_buf to ptr, (name_data to usize + 5 to usize) to ptr, inner_len)
            inner_buf[inner_len] = 0 to u8
            let comma_pos as cstr = strchr(inner_buf to cstr, ',' to i32)
            if comma_pos != None to cstr:
                var v_len as usize = (inner_buf to usize + inner_len to usize) - (comma_pos to usize + 1 to usize)
                var v_off as usize = 0 to usize
                while v_len > 0 to usize and (deref ((comma_pos to usize + 1 to usize + v_off) to ptr[u8])) == 32 to u8:
                    v_off = v_off + 1 to usize
                    v_len = v_len - 1 to usize
                while v_len > 0 to usize and (deref ((comma_pos to usize + 1 to usize + v_off + v_len - 1 to usize) to ptr[u8])) == 32 to u8:
                    v_len = v_len - 1 to usize
                if v_len > 0 to usize:
                    let v_buf as ptr[u8] = make[u8](v_len + 1 to usize) to ptr[u8]
                    let _mv as ptr = memcpy(v_buf to ptr, (comma_pos to usize + 1 to usize + v_off) to ptr, v_len)
                    v_buf[v_len] = 0 to u8
                    let v_annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
                    (deref v_annot).name = String.make(v_buf to cstr)
                    (deref v_annot).lifetime = Empty
                    (deref v_annot).generics = Empty
                    (deref v_annot).params = Empty
                    (deref v_annot).return_type = None to ptr[TypeAnnotation]
                    let v_type as ptr[Type] = self.resolve_type_annotation(v_annot)
                    let k_len as usize = (comma_pos to usize) - (inner_buf to usize)
                    var k_off as usize = 0 to usize
                    while k_len > 0 to usize and (deref ((inner_buf to usize + k_off) to ptr[u8])) == 32 to u8:
                        k_off = k_off + 1 to usize
                        k_len = k_len - 1 to usize
                    while k_len > 0 to usize and (deref ((inner_buf to usize + k_off + k_len - 1 to usize) to ptr[u8])) == 32 to u8:
                        k_len = k_len - 1 to usize
                    let t2 as ptr[Type] = make_type(TypeKind.Dict)
                    if k_len > 0 to usize:
                        let k_buf as ptr[u8] = make[u8](k_len + 1 to usize) to ptr[u8]
                        let _mk as ptr = memcpy(k_buf to ptr, (inner_buf to usize + k_off) to ptr, k_len)
                        k_buf[k_len] = 0 to u8
                        (deref t2).name = String.make(k_buf to cstr)
                        free(k_buf to ptr)
                    (deref t2).payload = v_type
                    free(v_buf to ptr)
                    free(v_annot to ptr)
                    free(inner_buf to ptr)
                    return t2
            free(inner_buf to ptr)
            let t2 as ptr[Type] = make_type(TypeKind.Dict)
            (deref t2).payload = make_type(TypeKind.Any)
            return t2

        // Handle ptr[T], List[T], Option[T] string representations
        extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
        extern fn strchr(s as cstr, c as i32) as cstr
        extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
        extern fn free(p as ptr)
        if strncmp(name, "ptr[" to cstr, 4 to usize) == 0 and name_len > 5 to usize:
            let inner_len as usize = name_len - 5 to usize
            let inner_buf as ptr[u8] = make[u8](inner_len + 1 to usize) to ptr[u8]
            let _m1 as ptr = memcpy(inner_buf to ptr, (name_data to usize + 4 to usize) to ptr, inner_len)
            inner_buf[inner_len] = 0 to u8
            let inner_annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
            (deref inner_annot).name = String.make(inner_buf to cstr)
            (deref inner_annot).lifetime = Empty
            (deref inner_annot).generics = Empty
            (deref inner_annot).params = Empty
            (deref inner_annot).return_type = None to ptr[TypeAnnotation]
            let elem_type as ptr[Type] = self.resolve_type_annotation(inner_annot)
            free(inner_buf to ptr)
            free(inner_annot to ptr)
            return make_ptr_type(elem_type)

        if strncmp(name, "List[" to cstr, 5 to usize) == 0 and name_len > 6 to usize:
            let inner_len as usize = name_len - 6 to usize
            let inner_buf as ptr[u8] = make[u8](inner_len + 1 to usize) to ptr[u8]
            let _m2 as ptr = memcpy(inner_buf to ptr, (name_data to usize + 5 to usize) to ptr, inner_len)
            inner_buf[inner_len] = 0 to u8
            let comma_pos as cstr = strchr(inner_buf to cstr, ',' to i32)
            if comma_pos != None to cstr:
                let k_len as usize = (comma_pos to usize) - (inner_buf to usize)
                var k_off as usize = 0 to usize
                while k_len > 0 to usize and (deref ((inner_buf to usize + k_off) to ptr[u8])) == 32 to u8:
                    k_off = k_off + 1 to usize
                    k_len = k_len - 1 to usize
                while k_len > 0 to usize and (deref ((inner_buf to usize + k_off + k_len - 1 to usize) to ptr[u8])) == 32 to u8:
                    k_len = k_len - 1 to usize
                if k_len > 0 to usize:
                    let k_buf as ptr[u8] = make[u8](k_len + 1 to usize) to ptr[u8]
                    let _mk as ptr = memcpy(k_buf to ptr, (inner_buf to usize + k_off) to ptr, k_len)
                    k_buf[k_len] = 0 to u8
                    let inner_annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
                    (deref inner_annot).name = String.make(k_buf to cstr)
                    (deref inner_annot).lifetime = Empty
                    (deref inner_annot).generics = Empty
                    (deref inner_annot).params = Empty
                    (deref inner_annot).return_type = None to ptr[TypeAnnotation]
                    let elem_type as ptr[Type] = self.resolve_type_annotation(inner_annot)
                    free(k_buf to ptr)
                    free(inner_buf to ptr)
                    free(inner_annot to ptr)
                    let t as ptr[Type] = make_type(TypeKind.List)
                    (deref t).payload = elem_type
                    return t
            let inner_annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
            (deref inner_annot).name = String.make(inner_buf to cstr)
            (deref inner_annot).lifetime = Empty
            (deref inner_annot).generics = Empty
            (deref inner_annot).params = Empty
            (deref inner_annot).return_type = None to ptr[TypeAnnotation]
            let elem_type as ptr[Type] = self.resolve_type_annotation(inner_annot)
            free(inner_buf to ptr)
            free(inner_annot to ptr)
            let t as ptr[Type] = make_type(TypeKind.List)
            (deref t).payload = elem_type
            return t

        if strncmp(name, "Option[" to cstr, 7 to usize) == 0 and name_len > 8 to usize:
            let inner_len as usize = name_len - 8 to usize
            let inner_buf as ptr[u8] = make[u8](inner_len + 1 to usize) to ptr[u8]
            let _m3 as ptr = memcpy(inner_buf to ptr, (name_data to usize + 7 to usize) to ptr, inner_len)
            inner_buf[inner_len] = 0 to u8
            let inner_annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
            (deref inner_annot).name = String.make(inner_buf to cstr)
            (deref inner_annot).lifetime = Empty
            (deref inner_annot).generics = Empty
            (deref inner_annot).params = Empty
            (deref inner_annot).return_type = None to ptr[TypeAnnotation]
            let elem_type as ptr[Type] = self.resolve_type_annotation(inner_annot)
            free(inner_buf to ptr)
            free(inner_annot to ptr)
            let t as ptr[Type] = make_type(TypeKind.Option)
            (deref t).payload = elem_type
            return t

        if strncmp(name, "Result[" to cstr, 7 to usize) == 0 and name_len > 8 to usize:
            let inner_len as usize = name_len - 8 to usize
            let inner_buf as ptr[u8] = make[u8](inner_len + 1 to usize) to ptr[u8]
            let _m_res as ptr = memcpy(inner_buf to ptr, (name_data to usize + 7 to usize) to ptr, inner_len)
            inner_buf[inner_len] = 0 to u8
            let comma_pos as cstr = strchr(inner_buf to cstr, ',' to i32)
            if comma_pos != None to cstr:
                let k_len as usize = (comma_pos to usize) - (inner_buf to usize)
                var k_off as usize = 0 to usize
                while k_len > 0 to usize and (deref ((inner_buf to usize + k_off) to ptr[u8])) == 32 to u8:
                    k_off = k_off + 1 to usize
                    k_len = k_len - 1 to usize
                while k_len > 0 to usize and (deref ((inner_buf to usize + k_off + k_len - 1 to usize) to ptr[u8])) == 32 to u8:
                    k_len = k_len - 1 to usize
                if k_len > 0 to usize:
                    let k_buf as ptr[u8] = make[u8](k_len + 1 to usize) to ptr[u8]
                    let _mk as ptr = memcpy(k_buf to ptr, (inner_buf to usize + k_off) to ptr, k_len)
                    k_buf[k_len] = 0 to u8
                    let inner_annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
                    (deref inner_annot).name = String.make(k_buf to cstr)
                    (deref inner_annot).lifetime = Empty
                    (deref inner_annot).generics = Empty
                    (deref inner_annot).params = Empty
                    (deref inner_annot).return_type = None to ptr[TypeAnnotation]
                    let elem_type as ptr[Type] = self.resolve_type_annotation(inner_annot)
                    free(k_buf to ptr)
                    free(inner_buf to ptr)
                    free(inner_annot to ptr)
                    let t as ptr[Type] = make_type(TypeKind.Result)
                    (deref t).payload = elem_type
                    return t
            let inner_annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
            (deref inner_annot).name = String.make(inner_buf to cstr)
            (deref inner_annot).lifetime = Empty
            (deref inner_annot).generics = Empty
            (deref inner_annot).params = Empty
            (deref inner_annot).return_type = None to ptr[TypeAnnotation]
            let elem_type as ptr[Type] = self.resolve_type_annotation(inner_annot)
            free(inner_buf to ptr)
            free(inner_annot to ptr)
            let t as ptr[Type] = make_type(TypeKind.Result)
            (deref t).payload = elem_type
            return t

        // Handle T? optional type syntax (e.g. void?, i32?, String?)
        if name_len > 1 to usize and (deref ((name_data to usize + name_len - 1 to usize) to ptr[u8])) == 63 to u8:
            let inner_len as usize = name_len - 1 to usize
            let inner_buf as ptr[u8] = make[u8](inner_len + 1 to usize) to ptr[u8]
            let _m4 as ptr = memcpy(inner_buf to ptr, name_data to ptr, inner_len)
            inner_buf[inner_len] = 0 to u8
            let inner_annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
            (deref inner_annot).name = String.make(inner_buf to cstr)
            (deref inner_annot).lifetime = Empty
            (deref inner_annot).generics = Empty
            (deref inner_annot).params = Empty
            (deref inner_annot).return_type = None to ptr[TypeAnnotation]
            let elem_type as ptr[Type] = self.resolve_type_annotation(inner_annot)
            free(inner_buf to ptr)
            free(inner_annot to ptr)
            let t as ptr[Type] = make_type(TypeKind.Option)
            (deref t).payload = elem_type
            return t

        // Handle ptr[T]
        if strcmp(name, "ptr" to cstr) == 0:
            let opt_gen as ptr[u8] = (ref (deref annot).generics) to ptr[u8]
            if option_has_value(opt_gen):
                let val_p as ptr[u8] = option_value(opt_gen)
                let gen_list as ptr[List[TypeAnnotation]] = val_p to ptr[List[TypeAnnotation]]
                if (deref gen_list).length() > 0 to i64:
                    var elem_annot as TypeAnnotation = (deref gen_list)[0]
                    let elem_type as ptr[Type] = self.resolve_type_annotation(ref elem_annot)
                    return make_ptr_type(elem_type)
            return make_ptr_type(make_type(TypeKind.Void))

        // Check if user-defined struct/class/enum/type alias in scope
        let sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(String.make(name))
        if sym != None to ptr[Symbol]:
            if (deref sym).kind == SymbolKind.TypeAlias:
                if (deref sym).resolved_type != None to ptr[Type]:
                    return (deref sym).resolved_type
                let d_node as ptr[Node] = (deref sym).decl_node
                if d_node != None to ptr[Node]:
                    let ann_list as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(d_node)
                    if ann_list != None to ptr[List[Option[ptr[TypeAnnotation]]]] and (deref ann_list).length() > 0 to i64:
                        let opt_ann as Option[ptr[TypeAnnotation]] = (deref ann_list)[0]
                        let opt_ref as ptr[OptionLayout] = (ref opt_ann) to ptr[OptionLayout]
                        if option_has_value(opt_ref to ptr[u8]):
                            let ta_ptr as ptr[TypeAnnotation] = (deref opt_ref).val_ptr to ptr[TypeAnnotation]
                            if ta_ptr != None to ptr[TypeAnnotation]:
                                let res_t as ptr[Type] = self.resolve_type_annotation(ta_ptr)
                                (deref sym).resolved_type = res_t
                                return res_t
            elif (deref sym).kind == SymbolKind.Struct:
                return make_struct_type(String.make(name))
            elif (deref sym).kind == SymbolKind.Enum:
                return make_enum_type(String.make(name))
            elif (deref sym).kind == SymbolKind.Union:
                return make_union_type(String.make(name))

        return make_struct_type(String.make(name))

    public fn resolve_type_annotation(self as ptr[TypeChecker], annot as ptr[TypeAnnotation]) as ptr[Type]:
        if annot == None to ptr[TypeAnnotation]:
            return make_type(TypeKind.Void)
        let base_t as ptr[Type] = self.resolve_base_type_annotation(annot)
        if (deref annot).is_ref:
            return make_ptr_type(base_t)
        let lt_opt as ptr[u8] = (ref (deref annot).lifetime) to ptr[u8]
        if option_has_value(lt_opt):
            return make_ptr_type(base_t)
        return base_t

    public fn check_nizam_import(self as ptr[TypeChecker], name as cstr, span as Span, file_path as String):
        if (deref (deref self).sema).mode to i32 == LanguageMode.Nizam to i32:
            extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
            extern fn free(p as ptr)
            extern fn strchr(s as cstr, c as i32) as cstr
            extern fn strtok(str as cstr, delim as cstr) as cstr
            extern fn strlen(s as cstr) as usize

            let name_len as usize = strlen(name)
            if name_len > 1 to usize and (deref ((name to usize + name_len - 1 to usize) to ptr[u8])) == 63 to u8:
                let inner_buf as ptr[u8] = make[u8](name_len) to ptr[u8]
                let _mo as ptr = memcpy(inner_buf to ptr, name to ptr, name_len - 1 to usize)
                inner_buf[name_len - 1 to usize] = 0 to u8
                self.check_nizam_import(inner_buf to cstr, span, file_path)
                free(inner_buf to ptr)
                return

            let bracket_pos as cstr = strchr(name, '[' to i32)
            if bracket_pos != None to cstr:
                let i as usize = (bracket_pos to usize) - (name to usize)
                if i > 0 to usize:
                    let base_buf as ptr[u8] = make[u8](i + 1 to usize) to ptr[u8]
                    let _mb as ptr = memcpy(base_buf to ptr, name to ptr, i)
                    base_buf[i] = 0 to u8
                    self.check_nizam_import(base_buf to cstr, span, file_path)
                    free(base_buf to ptr)

                let close_bracket as cstr = strchr(bracket_pos, ']' to i32)
                if close_bracket != None to cstr:
                    let inner_len as usize = (close_bracket to usize) - (bracket_pos to usize) - 1 to usize
                    if inner_len > 0 to usize:
                        let inner_buf as ptr[u8] = make[u8](inner_len + 1 to usize) to ptr[u8]
                        let _mi as ptr = memcpy(inner_buf to ptr, (bracket_pos to usize + 1 to usize) to ptr, inner_len)
                        inner_buf[inner_len] = 0 to u8
                        // Split comma-separated generic params and check each individually
                        let tok as cstr = strtok(inner_buf to cstr, "," to cstr)
                        while tok != None to cstr:
                            // Trim leading whitespace
                            while (deref (tok to ptr[u8])) == 32 to u8:
                                tok = (tok to usize + 1 to usize) to cstr
                            if (deref (tok to ptr[u8])) != 0 to u8:
                                self.check_nizam_import(tok, span, file_path)
                            tok = strtok(None to cstr, "," to cstr)
                        free(inner_buf to ptr)

                return

            var skip as bool = False
            let first_ch as u8 = deref (name to ptr[u8])
            if first_ch >= 48 to u8 and first_ch <= 57 to u8:
                skip = True
            elif name_len == 1 to usize and first_ch >= 65 to u8 and first_ch <= 90 to u8:
                skip = True
            elif strcmp(name, "i8" to cstr) == 0 or strcmp(name, "i16" to cstr) == 0 or strcmp(name, "i32" to cstr) == 0 or strcmp(name, "i64" to cstr) == 0 or strcmp(name, "i128" to cstr) == 0 or strcmp(name, "i256" to cstr) == 0 or strcmp(name, "i512" to cstr) == 0 or strcmp(name, "i1024" to cstr) == 0 or strcmp(name, "isize" to cstr) == 0:
                skip = True
            elif strcmp(name, "u8" to cstr) == 0 or strcmp(name, "byte" to cstr) == 0 or strcmp(name, "u16" to cstr) == 0 or strcmp(name, "u32" to cstr) == 0 or strcmp(name, "u64" to cstr) == 0 or strcmp(name, "u128" to cstr) == 0 or strcmp(name, "u256" to cstr) == 0 or strcmp(name, "u512" to cstr) == 0 or strcmp(name, "u1024" to cstr) == 0 or strcmp(name, "usize" to cstr) == 0:
                skip = True
            elif strcmp(name, "f16" to cstr) == 0 or strcmp(name, "bf16" to cstr) == 0 or strcmp(name, "BFloat16" to cstr) == 0 or strcmp(name, "f32" to cstr) == 0 or strcmp(name, "f64" to cstr) == 0 or strcmp(name, "f128" to cstr) == 0:
                skip = True
            elif strcmp(name, "bool" to cstr) == 0 or strcmp(name, "char" to cstr) == 0 or strcmp(name, "void" to cstr) == 0 or strcmp(name, "ptr" to cstr) == 0 or strcmp(name, "cstr" to cstr) == 0 or strcmp(name, "String" to cstr) == 0 or strcmp(name, "List" to cstr) == 0 or strcmp(name, "Dict" to cstr) == 0 or strcmp(name, "Option" to cstr) == 0 or strcmp(name, "Result" to cstr) == 0 or strcmp(name, "Any" to cstr) == 0 or strcmp(name, "qbit" to cstr) == 0 or strcmp(name, "qreg" to cstr) == 0 or strcmp(name, "TSNode" to cstr) == 0 or strcmp(name, "SymbolKind" to cstr) == 0 or strcmp(name, "MacroDef" to cstr) == 0 or strcmp(name, "VarInfo" to cstr) == 0 or strcmp(name, "ObjectState" to cstr) == 0:
                skip = True
                
            let name_ptr as ptr[u8] = name to ptr[u8]
            if not skip and (deref name_ptr) >= 65 to u8 and (deref name_ptr) <= 90 to u8:
                let next_char as u8 = deref ((name_ptr to usize + 1 to usize) to ptr[u8])
                if next_char == 0 to u8:
                    skip = True
                    
            if not skip:
                let sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(String.make(name))
                var report as bool = False
                if sym == None to ptr[Symbol]:
                    report = True
                else:
                    if (deref sym).decl_node == None to ptr[Node]:
                        report = True
                
                if report:
                    let sb as StringBuilder = StringBuilder.make()
                    sb.append(name)
                    sb.append(" requires explicit import in Nizam strict mode" to cstr)
                    let msg as String = sb.to_string()
                    let d as ptr[Diagnostic] = (deref (deref self).sema).report_error_with_code("E0316" to cstr, msg, file_path, span)
                    if d != None to ptr[Diagnostic]:
                        d.set_explanation(String.make("Nizam strict mode requires all types and identifiers from external modules to be explicitly imported." to cstr))
                        d.add_help(String.make("Add an explicit `from <module> import <Symbol>` declaration." to cstr))

    public fn is_implicitly_convertible(self as ptr[TypeChecker], from_t as ptr[Type], to_t as ptr[Type]) as bool:
        if from_t == None to ptr[Type] or to_t == None to ptr[Type]:
            return True
            
        let fk as TypeKind = (deref from_t).kind
        let tk as TypeKind = (deref to_t).kind
        
        if fk == tk:
            if fk == TypeKind.RawPointer:
                if (deref from_t).payload == None to ptr[Type] or (deref to_t).payload == None to ptr[Type]:
                    return True
                let f_pl as ptr[Type] = (deref from_t).payload
                let t_pl as ptr[Type] = (deref to_t).payload
                if (deref f_pl).kind == TypeKind.Void or (deref t_pl).kind == TypeKind.Void:
                    return True
                if (deref f_pl).kind == TypeKind.U8 or (deref t_pl).kind == TypeKind.U8:
                    return True
                let res as bool = self.is_implicitly_convertible(f_pl, t_pl)
                return res
            return True
            
        if fk == TypeKind.Unknown or tk == TypeKind.Unknown or fk == TypeKind.Error or tk == TypeKind.Error or fk == TypeKind.Void or tk == TypeKind.Void:
            return True
            
        // Any conversions
        if fk == TypeKind.Any or tk == TypeKind.Any:
            return True

        // String conversions
        let is_from_str as bool = (fk == TypeKind.String or fk == TypeKind.Utf8Str or fk == TypeKind.AsciiStr or fk == TypeKind.CStr)
        let is_to_str as bool = (tk == TypeKind.String or tk == TypeKind.Utf8Str or tk == TypeKind.AsciiStr or tk == TypeKind.CStr)
        if is_from_str and is_to_str:
            return True

        // Numeric conversions (integers / floats)
        let is_from_num as bool = (fk == TypeKind.I8 or fk == TypeKind.I16 or fk == TypeKind.I32 or fk == TypeKind.I64 or fk == TypeKind.I128 or fk == TypeKind.I256 or fk == TypeKind.I512 or fk == TypeKind.I1024 or fk == TypeKind.ISize or fk == TypeKind.U8 or fk == TypeKind.U16 or fk == TypeKind.U32 or fk == TypeKind.U64 or fk == TypeKind.U128 or fk == TypeKind.U256 or fk == TypeKind.U512 or fk == TypeKind.U1024 or fk == TypeKind.USize or fk == TypeKind.F16 or fk == TypeKind.BFloat16 or fk == TypeKind.F32 or fk == TypeKind.F64 or fk == TypeKind.F128)
        let is_to_num as bool = (tk == TypeKind.I8 or tk == TypeKind.I16 or tk == TypeKind.I32 or tk == TypeKind.I64 or tk == TypeKind.I128 or tk == TypeKind.I256 or tk == TypeKind.I512 or tk == TypeKind.I1024 or tk == TypeKind.ISize or tk == TypeKind.U8 or tk == TypeKind.U16 or tk == TypeKind.U32 or tk == TypeKind.U64 or tk == TypeKind.U128 or tk == TypeKind.U256 or tk == TypeKind.U512 or tk == TypeKind.U1024 or tk == TypeKind.USize or tk == TypeKind.F16 or tk == TypeKind.BFloat16 or tk == TypeKind.F32 or tk == TypeKind.F64 or tk == TypeKind.F128)
        if is_from_num and is_to_num:
            return True

        return False

    public fn clone_and_substitute(self as ptr[TypeChecker], node as ptr[Node], param_name as cstr, concrete_type as ptr[Type]) as ptr[Node]:
        extern fn memset(s as ptr, c as i32, n as usize) as ptr
        if node == None to ptr[Node]:
            return None to ptr[Node]
            
        let nt as NodeType = node_kind(node)
        let res as ptr[Node] = make_node(nt, node_span(node))
        (deref res).module_name = (deref node).module_name
        set_node_val(res, node_val(node))
        set_node_op(res, node_op(node))
        set_node_is_mut(res, node_is_mut(node))
        set_node_is_async(res, node_is_async(node))
        set_node_name(res, node_name(node))
        
        if node_type_annots(node) == None to ptr[List[Option[ptr[TypeAnnotation]]]]:
            set_node_type_annots(res, None to ptr[List[Option[ptr[TypeAnnotation]]]])
        else:
            let type_annots as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(node)
            let wrapper as ptr[ListWrapper] = make[ListWrapper](1 to usize)
            let dummy_memset3 as ptr = memset(wrapper to ptr, 0 to i32, 24 to usize)
            (deref wrapper).list = List[Option[ptr[TypeAnnotation]]]()
            let cloned_annots_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = ref (deref wrapper).list
            
            let count_annots as i64 = (deref type_annots).length()
            var a_idx as i64 = 0 to i64
            while a_idx < count_annots:
                let opt_annot_val as Option[ptr[TypeAnnotation]] = (deref type_annots)[a_idx]
                let opt_annot as ptr[u8] = (ref opt_annot_val) to ptr[u8]
                if option_has_value(opt_annot):
                    let val_p as ptr[u8] = option_value(opt_annot)
                    let orig_annot as ptr[TypeAnnotation] = val_p to ptr[TypeAnnotation]
                    
                    let annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize)
                    deref annot = deref orig_annot
                    
                    if strcmp((deref annot).name.data to cstr, param_name) == 0:
                        (deref annot).name = (deref concrete_type).name
                    (deref cloned_annots_ptr).append(Some(annot))
                else:
                    (deref cloned_annots_ptr).append(Empty)
                a_idx = a_idx + 1 to i64
            set_node_type_annots(res, cloned_annots_ptr)

        let _sep3 as i32 = 0
        set_node_left(res, self.clone_and_substitute(node_left(node), param_name, concrete_type))
        set_node_right(res, self.clone_and_substitute(node_right(node), param_name, concrete_type))
        set_node_body(res, self.clone_and_substitute(node_body(node), param_name, concrete_type))
        set_node_cond(res, self.clone_and_substitute(node_cond(node), param_name, concrete_type))
        set_node_then_branch(res, self.clone_and_substitute(node_then_branch(node), param_name, concrete_type))
        set_node_str_val(res, node_str_val(node))
        
        let node_decls as List[ptr[Node]] = node_declarations(node)
        let count as i64 = node_decls.length()
        let decls as List[ptr[Node]] = List[ptr[Node]]()
        var i as i64 = 0 to i64
        while i < count:
            decls.append(self.clone_and_substitute(node_decls[i], param_name, concrete_type))
            i = i + 1 to i64
        set_node_declarations(res, decls)
        
        let node_prms as List[ptr[Node]] = node_params(node)
        let p_count as i64 = node_prms.length()
        let params as List[ptr[Node]] = List[ptr[Node]]()
        var p_idx as i64 = 0 to i64
        while p_idx < p_count:
            params.append(self.clone_and_substitute(node_prms[p_idx], param_name, concrete_type))
            p_idx = p_idx + 1 to i64
        set_node_params(res, params)

        return res

    public fn monomorphize(self as ptr[TypeChecker], template_node as ptr[Node], param_name as cstr, concrete_type as ptr[Type]) as ptr[Node]:
        // Clone and substitute the template
        let monomorphized as ptr[Node] = self.clone_and_substitute(template_node, param_name, concrete_type)
        
        // Generate mangled name
        let sb as StringBuilder = StringBuilder.make()
        sb.append(node_name(template_node).data to cstr)
        sb.append("_" to cstr)
        sb.append((deref concrete_type).name.data to cstr)
        let mangled_name as String = sb.to_string()
        
        set_node_name(monomorphized, mangled_name)
        mangled_name.data = None to ptr[u8]
        
        // Run declare_pass on the monomorphized subtree to register the new symbol
        (deref (deref self).sema).declare_pass(monomorphized)
        // Run resolve_pass on it
        (deref (deref self).sema).resolve_pass(monomorphized)
        // Run type checker on it
        let dummy1 as ptr[Type] = self.typecheck_node(monomorphized)
        
        return monomorphized

    public fn typecheck_node(self as ptr[TypeChecker], node as ptr[Node]) as ptr[Type]:
        extern fn memset(s as ptr, c: i32, n: usize) as ptr
        if node == None to ptr[Node]:
            return make_type(TypeKind.Void)
            
        let nt as NodeType = node_kind(node)
        var ret_type as ptr[Type] = make_type(TypeKind.Void)
        
        if nt == NodeType.Program:
            let decls as List[ptr[Node]] = node_declarations(node)
            let count as i64 = decls.length()
            var i as i64 = 0 to i64
            while i < count:
                let dummy2 as ptr[Type] = self.typecheck_node(decls[i])
                i = i + 1 to i64
            ret_type = make_type(TypeKind.Void)
            
        elif nt == NodeType.BlockStmt:
            let decls as List[ptr[Node]] = node_declarations(node)
            let count as i64 = decls.length()
            var i as i64 = 0 to i64
            while i < count:
                ret_type = self.typecheck_node(decls[i])
                i = i + 1 to i64

        elif nt == NodeType.ParamBlockStmt:
            let sema_ptr as ptr[Sema] = (deref self).sema
            let parent_scope as ptr[Scope] = (deref sema_ptr).current_scope
            var child_scope as ptr[Scope] = None to ptr[Scope]

            if (deref sema_ptr).fn_scopes.has(node to usize):
                child_scope = (deref sema_ptr).fn_scopes[node to usize]
            else:
                child_scope = make_scope(parent_scope, node)
                (deref sema_ptr).fn_scopes[node to usize] = child_scope

            // Typecheck return variables in parent scope
            let ret_names as List[String] = node_return_names(node)
            let ret_count as i64 = ret_names.length()
            let ret_annots_p as ptr[List[Option[ptr[TypeAnnotation]]]] = node_return_type_annots(node)
            var r_idx as i64 = 0 to i64
            while r_idx < ret_count:
                let r_name_str as String = ret_names[r_idx]
                if r_name_str.data != None to ptr[u8] and r_name_str.len > 0 to usize:
                    let r_cstr as cstr = r_name_str.data to cstr
                    var r_type as ptr[Type] = None to ptr[Type]
                    if ret_annots_p != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                        let r_annots as List[Option[ptr[TypeAnnotation]]] = deref ret_annots_p
                        if r_idx < r_annots.length():
                            let opt as Option[ptr[TypeAnnotation]] = r_annots[r_idx]
                            let opt_ref as ptr[OptionLayout] = (ref opt) to ptr[OptionLayout]
                            if option_has_value(opt_ref to ptr[u8]):
                                let r_val_p as ptr[u8] = option_value(opt_ref to ptr[u8])
                                let r_annot_val as ptr[TypeAnnotation] = r_val_p to ptr[TypeAnnotation]
                                if r_annot_val != None to ptr[TypeAnnotation]:
                                    r_type = self.resolve_type_annotation(r_annot_val)
                    if r_type == None to ptr[Type]:
                        r_type = make_type(TypeKind.I64)
                    if (deref parent_scope).symbols.has(String.make(r_cstr)):
                        let r_sym as ptr[Symbol] = (deref parent_scope).symbols[String.make(r_cstr)]
                        (deref r_sym).resolved_type = r_type
                r_idx = r_idx + 1 to i64

            // Switch to child scope for params & body
            (deref sema_ptr).current_scope = child_scope

            // Typecheck parameters
            let params as List[ptr[Node]] = node_params(node)
            let param_count as i64 = params.length()
            var p_idx as i64 = 0 to i64
            while p_idx < param_count:
                let p_node as ptr[Node] = params[p_idx]
                let p_cstr as cstr = node_name(p_node).data to cstr
                var p_type as ptr[Type] = None to ptr[Type]
                if node_type_annots(p_node) != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                    let p_annots_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(p_node)
                    let p_annots as List[Option[ptr[TypeAnnotation]]] = deref p_annots_ptr
                    if p_annots.length() > 0 to i64:
                        let opt as Option[ptr[TypeAnnotation]] = p_annots[0 to i64]
                        let opt_ref as ptr[OptionLayout] = (ref opt) to ptr[OptionLayout]
                        if option_has_value(opt_ref to ptr[u8]):
                            let p_val_p as ptr[u8] = option_value(opt_ref to ptr[u8])
                            let p_annot_val as ptr[TypeAnnotation] = p_val_p to ptr[TypeAnnotation]
                            if p_annot_val != None to ptr[TypeAnnotation]:
                                p_type = self.resolve_type_annotation(p_annot_val)
                if p_type == None to ptr[Type]:
                    if (deref parent_scope).symbols.has(String.make(p_cstr)):
                        let par_sym as ptr[Symbol] = (deref parent_scope).symbols[String.make(p_cstr)]
                        p_type = (deref par_sym).resolved_type
                    if p_type == None to ptr[Type]:
                        p_type = make_type(TypeKind.I32)
                set_node_inferred_type(p_node, p_type)
                if (deref child_scope).symbols.has(String.make(p_cstr)):
                    let p_sym as ptr[Symbol] = (deref child_scope).symbols[String.make(p_cstr)]
                    (deref p_sym).resolved_type = p_type
                p_idx = p_idx + 1 to i64

            // Typecheck body
            if node_body(node) != None to ptr[Node]:
                let _ as ptr[Type] = self.typecheck_node(node_body(node))

            (deref sema_ptr).current_scope = parent_scope
            ret_type = make_type(TypeKind.Void)
                
        elif nt == NodeType.VarDecl:
            let name as cstr = node_name(node).data to cstr
            var annotated_type as ptr[Type] = None to ptr[Type]
            var annot_val as ptr[TypeAnnotation] = None to ptr[TypeAnnotation]
            
            if node_type_annots(node) != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                let type_annots as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(node)
                if (deref type_annots).length() > 0 to i64:
                    let opt as Option[ptr[TypeAnnotation]] = (deref type_annots)[0 to i64]
                    let opt_ref as ptr[OptionLayout] = (ref opt) to ptr[OptionLayout]
                    if option_has_value(opt_ref to ptr[u8]):
                        let val_p as ptr[u8] = option_value(opt_ref to ptr[u8])
                        annot_val = val_p to ptr[TypeAnnotation]
                        if annot_val != None to ptr[TypeAnnotation]:
                            annotated_type = self.resolve_type_annotation(annot_val)
                            self.check_nizam_import((deref annot_val).name.data to cstr, node_span(node), node_file_path(node, (deref (deref self).sema).current_file))
            
            if node_left(node) != None to ptr[Node]:
                let init_node as ptr[Node] = node_left(node)
                
                if annotated_type != None to ptr[Type]:
                    if node_kind(init_node) == NodeType.NumberLiteral:
                        set_node_inferred_type(init_node, annotated_type)
                    
                    let init_type as ptr[Type] = self.typecheck_node(init_node)
                    if not self.is_implicitly_convertible(init_type, annotated_type):
                        let d as ptr[Diagnostic] = (deref (deref self).sema).report_error_node("E0308" to cstr, String.make("type mismatch in variable initialization" to cstr), node)
                        if d != None to ptr[Diagnostic]:
                            d.set_explanation(String.make("The initialized expression type is incompatible with the variable's declared type." to cstr))
                            d.add_help(String.make("Cast the expression using `to <type>` or match the annotated type." to cstr))
                else:
                    let init_type as ptr[Type] = self.typecheck_node(init_node)
                    annotated_type = init_type
            
            var sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(String.make(name))
            if sym == None to ptr[Symbol]:
                sym = make_symbol(String.make(name), SymbolKind.Variable, node)
                let curr_s as ptr[Scope] = (deref (deref self).sema).current_scope
                if curr_s != None to ptr[Scope]:
                    (deref curr_s).symbols[String.make(name)] = sym
            if sym != None to ptr[Symbol] and annotated_type != None to ptr[Type]:
                (deref sym).resolved_type = annotated_type
            if annotated_type != None to ptr[Type]:
                set_node_inferred_type(node, annotated_type)
                ret_type = annotated_type
            else:
                ret_type = make_type(TypeKind.Void)
            
        elif nt == NodeType.FunDecl:
            let sema_ptr as ptr[Sema] = (deref self).sema
            let parent_scope as ptr[Scope] = (deref sema_ptr).current_scope
            var child_scope as ptr[Scope] = None to ptr[Scope]
            
            if (deref sema_ptr).fn_scopes.has(node to usize):
                child_scope = (deref sema_ptr).fn_scopes[node to usize]
            else:
                child_scope = make_scope(parent_scope, node)
                (deref sema_ptr).fn_scopes[node to usize] = child_scope
            
            let saved_scope as ptr[Scope] = (deref sema_ptr).current_scope
            (deref sema_ptr).current_scope = child_scope
            
            let f_type as ptr[Type] = make_type(TypeKind.Function)
            
            // Use return type annotation if available
            let ret_annot as ptr[TypeAnnotation] = node_return_type_annot(node)
            if ret_annot != None to ptr[TypeAnnotation]:
                if (deref ret_annot).name.len > 0 to usize:
                    (deref f_type).return_type = self.resolve_type_annotation(ret_annot)
                    self.check_nizam_import((deref ret_annot).name.data to cstr, node_span(node), node_file_path(node, (deref (deref self).sema).current_file))
                elif (deref self).current_struct_type != None to ptr[Type] and (deref (deref self).current_struct_type).kind == TypeKind.Enum:
                    (deref f_type).return_type = (deref self).current_struct_type
                else:
                    (deref f_type).return_type = make_type(TypeKind.Void)
            elif (deref self).current_struct_type != None to ptr[Type] and (deref (deref self).current_struct_type).kind == TypeKind.Enum and node_body(node) == None to ptr[Node]:
                (deref f_type).return_type = (deref self).current_struct_type
            else:
                (deref f_type).return_type = make_type(TypeKind.Void)
            let f_params as ptr[List[Type]] = ref (deref f_type).param_types
            
            let params as List[ptr[Node]] = node_params(node)
            let param_count as i64 = params.length()
            var p_idx as i64 = 0 to i64
            while p_idx < param_count:
                let p_node as ptr[Node] = params[p_idx]
                let p_name as cstr = node_name(p_node).data to cstr
                
                var p_sym as ptr[Symbol] = None to ptr[Symbol]
                if (deref child_scope).symbols.has(String.make(p_name)):
                    p_sym = (deref child_scope).symbols[String.make(p_name)]
                else:
                    p_sym = make_symbol(String.make(p_name), SymbolKind.Variable, p_node)
                    (deref child_scope).symbols[String.make(p_name)] = p_sym
                
                var p_type as ptr[Type] = None to ptr[Type]
                if node_type_annots(p_node) != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                    let p_annots_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(p_node)
                    let p_annots as List[Option[ptr[TypeAnnotation]]] = deref p_annots_ptr
                    if p_annots.length() > 0 to i64:
                        let opt as Option[ptr[TypeAnnotation]] = p_annots[0 to i64]
                        let opt_ref as ptr[OptionLayout] = (ref opt) to ptr[OptionLayout]
                        if option_has_value(opt_ref to ptr[u8]):
                            let p_val_p as ptr[u8] = option_value(opt_ref to ptr[u8])
                            let p_annot_val as ptr[TypeAnnotation] = p_val_p to ptr[TypeAnnotation]
                            if p_annot_val != None to ptr[TypeAnnotation]:
                                p_type = self.resolve_type_annotation(p_annot_val)
                                self.check_nizam_import((deref p_annot_val).name.data to cstr, node_span(p_node), node_file_path(p_node, (deref (deref self).sema).current_file))
                
                if p_type == None to ptr[Type]:
                    if p_idx == 0 to i64 and strcmp(p_name, "self" to cstr) == 0 and (deref self).current_struct_type != None to ptr[Type]:
                        p_type = (deref self).current_struct_type
                    else:
                        p_type = make_type(TypeKind.Any)
                    
                let p_sym_resolved_ptr as ptr[ptr[Type]] = ref (deref p_sym).resolved_type
                deref p_sym_resolved_ptr = p_type
                set_node_inferred_type(p_node, p_type)
                (deref f_params).append(deref p_type)
                p_idx = p_idx + 1 to i64
            
            let saved_ret as Option[ptr[Type]] = (deref self).current_function_return
            let self_ptr as ptr[TypeChecker] = self
            let self_ref_ret as ptr[Option[ptr[Type]]] = ref (deref self_ptr).current_function_return
            deref self_ref_ret = Some((deref f_type).return_type)
            // Reset inferred return type tracker
            (deref self_ptr).inferred_return_type = None to ptr[Type]
            
            if node_body(node) != None to ptr[Node]:
                let dummy3 as ptr[Type] = self.typecheck_node(node_body(node))
                
            // Validate return type if declared return type is not Void/Any/Unknown (skip for extern and bodyless declarations)
            if not node_is_extern(node) and node_body(node) != None to ptr[Node]:
                let declared_ret as ptr[Type] = (deref f_type).return_type
                let declared_kind as TypeKind = (deref declared_ret).kind
                if declared_kind != TypeKind.Void and declared_kind != TypeKind.Any and declared_kind != TypeKind.Unknown:
                    let inferred_ret as ptr[Type] = (deref self_ptr).inferred_return_type
                    if inferred_ret != None to ptr[Type]:
                        let inferred_kind as TypeKind = (deref inferred_ret).kind
                        if inferred_kind != TypeKind.Void and inferred_kind != TypeKind.Any and inferred_kind != TypeKind.Unknown:
                            if not self.is_implicitly_convertible(inferred_ret, declared_ret):
                                let d as ptr[Diagnostic] = (deref (deref self).sema).report_error_node("E0309" to cstr, String.make("return type mismatch: declared return type does not match actual return type" to cstr), node)
                                if d != None to ptr[Diagnostic]:
                                    d.set_explanation(String.make("The value returned from the function does not match the function's declared return type annotation." to cstr))
                                    d.add_help(String.make("Change the return value or update the return type annotation in the function signature." to cstr))
                    else:
                        let d as ptr[Diagnostic] = (deref (deref self).sema).report_error_node("E0310" to cstr, String.make("function with non-void return type must return a value" to cstr), node)
                        if d != None to ptr[Diagnostic]:
                            d.set_explanation(String.make("Functions declaring a non-void return type must return a valid value along all execution paths." to cstr))
                            d.add_help(String.make("Add a `return <expression>` statement to the function." to cstr))
            
            let self_ref_ret_back as ptr[Option[ptr[Type]]] = ref (deref self_ptr).current_function_return
            deref self_ref_ret_back = saved_ret
            
            (deref sema_ptr).current_scope = parent_scope
            
            let f_name as cstr = node_name(node).data to cstr
            if (deref parent_scope).symbols.has(String.make(f_name)):
                let f_sym as ptr[Symbol] = (deref parent_scope).symbols[String.make(f_name)]
                (deref f_sym).resolved_type = f_type
                
            ret_type = (deref f_type).return_type
            
        elif nt == NodeType.Identifier:
            let name as cstr = node_name(node).data to cstr
            if strcmp(name, "UNSUPPORTED" to cstr) == 0:
                ret_type = make_type(TypeKind.Void)
            elif strcmp(name, "Empty" to cstr) == 0 or strcmp(name, "None" to cstr) == 0:
                ret_type = make_type(TypeKind.Option)
            else:
                let sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(String.make(name))
                if sym != None to ptr[Symbol]:
                    if (deref sym).resolved_type != None to ptr[Type]:
                        ret_type = (deref sym).resolved_type
                    elif (deref sym).kind == SymbolKind.Struct:
                        ret_type = make_struct_type(String.make(name))
                    elif (deref sym).kind == SymbolKind.Function:
                        if (deref sym).decl_node != None to ptr[Node]:
                            if node_kind((deref sym).decl_node) == NodeType.FunDecl:
                                let fn_decl as ptr[Node] = (deref sym).decl_node
                                let f_t as ptr[Type] = make_type(TypeKind.Function)
                                let fn_ret_annot as ptr[TypeAnnotation] = node_return_type_annot(fn_decl)
                                if fn_ret_annot != None to ptr[TypeAnnotation]:
                                    if (deref fn_ret_annot).name.len > 0 to usize:
                                        (deref f_t).return_type = self.resolve_type_annotation(fn_ret_annot)
                                    else:
                                        (deref f_t).return_type = make_type(TypeKind.Void)
                                else:
                                    (deref f_t).return_type = make_type(TypeKind.Void)
                                let f_params as ptr[List[Type]] = ref (deref f_t).param_types
                                let fn_params as List[ptr[Node]] = node_params(fn_decl)
                                let fn_p_count as i64 = fn_params.length()
                                var fn_p_idx as i64 = 0 to i64
                                while fn_p_idx < fn_p_count:
                                    let fn_p as ptr[Node] = fn_params[fn_p_idx]
                                    var fn_p_t as ptr[Type] = make_type(TypeKind.Any)
                                    if node_type_annots(fn_p) != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                                        let fn_p_annots as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(fn_p)
                                        if (deref fn_p_annots).length() > 0 to i64:
                                            let fn_p_opt_val as Option[ptr[TypeAnnotation]] = (deref fn_p_annots)[0 to i64]
                                            let fn_p_opt as ptr[u8] = (ref fn_p_opt_val) to ptr[u8]
                                            if option_has_value(fn_p_opt):
                                                let fn_p_val as ptr[u8] = option_value(fn_p_opt)
                                                let fn_p_annot as ptr[TypeAnnotation] = fn_p_val to ptr[TypeAnnotation]
                                                if fn_p_annot != None to ptr[TypeAnnotation]:
                                                    fn_p_t = self.resolve_type_annotation(fn_p_annot)
                                    (deref f_params).append(deref fn_p_t)
                                    fn_p_idx = fn_p_idx + 1 to i64
                                (deref sym).resolved_type = f_t
                                ret_type = f_t
                            else:
                                ret_type = make_type(TypeKind.Any)
                        else:
                            ret_type = make_type(TypeKind.Any)
                    else:
                        ret_type = make_type(TypeKind.Any)
                else:
                    ret_type = make_type(TypeKind.Unknown)
                
        elif nt == NodeType.NumberLiteral:
            if node_is_float(node):
                ret_type = make_type(TypeKind.F64)
            elif node_inferred_type(node) != None to ptr[Type]:
                ret_type = node_inferred_type(node)
            else:
                ret_type = make_type(TypeKind.I32)
                
        elif nt == NodeType.StringLiteral:
            ret_type = make_type(TypeKind.String)
                
        elif nt == NodeType.BinaryExpr:
            let left as ptr[Node] = node_left(node)
            let right as ptr[Node] = node_right(node)
            
            if strcmp(node_op(node).data to cstr, "." to cstr) == 0:
                ret_type = make_type(TypeKind.Any)
            elif strcmp(node_op(node).data to cstr, "=" to cstr) == 0:
                let left_t as ptr[Type] = self.typecheck_node(left)
                if left_t != None to ptr[Type]:
                    if node_kind(right) == NodeType.NumberLiteral:
                        set_node_inferred_type(right, left_t)
                let right_t as ptr[Type] = self.typecheck_node(right)
                ret_type = left_t
            elif strcmp(node_op(node).data to cstr, "is" to cstr) == 0:
                let _left_t as ptr[Type] = self.typecheck_node(left)
                ret_type = make_type(TypeKind.Boolean)
            else:
                let left_t as ptr[Type] = self.typecheck_node(left)
                let right_t as ptr[Type] = self.typecheck_node(right)
                
                let lk as TypeKind = (deref left_t).kind
                let rk as TypeKind = (deref right_t).kind
                let left_is_default_lit as bool = node_kind(left) == NodeType.NumberLiteral and lk == TypeKind.I32
                let right_is_default_lit as bool = node_kind(right) == NodeType.NumberLiteral and rk == TypeKind.I32
                
                let op_str as cstr = node_op(node).data to cstr
                if strcmp(op_str, "==" to cstr) == 0 or strcmp(op_str, "!=" to cstr) == 0 or strcmp(op_str, "<" to cstr) == 0 or strcmp(op_str, ">" to cstr) == 0 or strcmp(op_str, "<=" to cstr) == 0 or strcmp(op_str, ">=" to cstr) == 0 or strcmp(op_str, "and" to cstr) == 0 or strcmp(op_str, "or" to cstr) == 0:
                    ret_type = make_type(TypeKind.Boolean)
                elif left_is_default_lit and not right_is_default_lit:
                    set_node_inferred_type(left, right_t)
                    ret_type = right_t
                elif right_is_default_lit and not left_is_default_lit:
                    set_node_inferred_type(right, left_t)
                    ret_type = left_t
                else:
                    ret_type = left_t
                    
        elif nt == NodeType.CallExpr:
            let callee as ptr[Node] = node_left(node)
            var is_type_intrinsic as bool = False
            if callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier:
                let c_name as String = node_name(callee)
                let c_data as cstr = c_name.data to cstr
                let c_len as usize = c_name.len
                if (c_len == 4 to usize and strncmp(c_data, "size" to cstr, 4 to usize) == 0) or (c_len == 7 to usize and strncmp(c_data, "size_of" to cstr, 7 to usize) == 0) or (c_len == 6 to usize and strncmp(c_data, "sizeof" to cstr, 6 to usize) == 0) or (c_len == 7 to usize and strncmp(c_data, "alignof" to cstr, 7 to usize) == 0) or (c_len == 8 to usize and strncmp(c_data, "align_of" to cstr, 8 to usize) == 0):
                    is_type_intrinsic = True
            if is_type_intrinsic:
                ret_type = make_type(TypeKind.I64)
                set_node_inferred_type(node, ret_type)
                return ret_type
            let callee_t as ptr[Type] = self.typecheck_node(callee)
            var generic_ctor_t as ptr[Type] = None to ptr[Type]
            if callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier:
                let gc_name as String = node_name(callee)
                if gc_name.data != None to ptr[u8]:
                    let gc_cstr as cstr = gc_name.data to cstr
                    if strcmp(gc_cstr, "Dict" to cstr) == 0 or strcmp(gc_cstr, "List" to cstr) == 0 or strcmp(gc_cstr, "Set" to cstr) == 0:
                        let gc_annots_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(node)
                        if gc_annots_ptr != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                            let gc_annots as List[Option[ptr[TypeAnnotation]]] = deref gc_annots_ptr
                            if gc_annots.length() > 0 to i64:
                                let gc_opt as Option[ptr[TypeAnnotation]] = gc_annots[0]
                                let gc_opt_ref as ptr[u8] = (ref gc_opt) to ptr[u8]
                                if option_has_value(gc_opt_ref):
                                    let gc_val_p as ptr[u8] = option_value(gc_opt_ref)
                                    let gc_pa as ptr[TypeAnnotation] = gc_val_p to ptr[TypeAnnotation]
                                    if gc_pa != None to ptr[TypeAnnotation]:
                                        generic_ctor_t = self.resolve_type_annotation(gc_pa)
            
            let args as List[ptr[Node]] = node_params(node)
            let arg_count as i64 = args.length()
            var a_idx as i64 = 0 to i64
            
            if callee_t != None to ptr[Type]:
                if (deref callee_t).kind == TypeKind.Function:
                    let params as ptr[List[Type]] = ref (deref callee_t).param_types
                    let expected_count as i64 = (deref params).length()
                    while a_idx < arg_count:
                        let arg_node as ptr[Node] = args[a_idx]
                        if arg_node != None to ptr[Node]:
                            if a_idx < expected_count:
                                let expected_t as ptr[Type] = ref (deref params)[a_idx]
                                if node_kind(arg_node) == NodeType.NumberLiteral:
                                    set_node_inferred_type(arg_node, expected_t)
                            let dummy_a as ptr[Type] = self.typecheck_node(arg_node)
                        a_idx = a_idx + 1 to i64
                else:
                    while a_idx < arg_count:
                        let dummy_a as ptr[Type] = self.typecheck_node(args[a_idx])
                        a_idx = a_idx + 1 to i64
            
            if callee != None to ptr[Node] and node_kind(callee) == NodeType.MemberExpr:
                let coll_recv as ptr[Node] = node_left(callee)
                if coll_recv != None to ptr[Node]:
                    let coll_recv_t as ptr[Type] = node_inferred_type(coll_recv)
                    if coll_recv_t != None to ptr[Type]:
                        var coll_recv_k as TypeKind = (deref coll_recv_t).kind
                        if coll_recv_k == TypeKind.RawPointer and (deref coll_recv_t).payload != None to ptr[Type]:
                            coll_recv_k = (deref (deref coll_recv_t).payload).kind
                        let coll_mname as String = node_name(callee)
                        if coll_mname.data != None to ptr[u8]:
                            var coll_handled as bool = True
                            if coll_recv_k == TypeKind.Dict:
                                if strcmp(coll_mname.data to cstr, "has") == 0 or strcmp(coll_mname.data to cstr, "remove") == 0:
                                    ret_type = make_type(TypeKind.Boolean)
                                elif strcmp(coll_mname.data to cstr, "length") == 0 or strcmp(coll_mname.data to cstr, "len") == 0:
                                    ret_type = make_type(TypeKind.I64)
                                elif strcmp(coll_mname.data to cstr, "clear") == 0:
                                    ret_type = make_type(TypeKind.Void)
                                elif strcmp(coll_mname.data to cstr, "keys") == 0:
                                    let coll_keys_t as ptr[Type] = make_type(TypeKind.List)
                                    (deref coll_keys_t).payload = make_type(TypeKind.Any)
                                    ret_type = coll_keys_t
                                else:
                                    coll_handled = False
                            elif coll_recv_k == TypeKind.List:
                                if strcmp(coll_mname.data to cstr, "length") == 0 or strcmp(coll_mname.data to cstr, "len") == 0:
                                    ret_type = make_type(TypeKind.I64)
                                elif strcmp(coll_mname.data to cstr, "clear") == 0:
                                    ret_type = make_type(TypeKind.Void)
                                elif strcmp(coll_mname.data to cstr, "get") == 0:
                                    if coll_recv_t != None to ptr[Type] and (deref coll_recv_t).payload != None to ptr[Type]:
                                        ret_type = (deref coll_recv_t).payload
                                    elif coll_recv_t != None to ptr[Type] and (deref coll_recv_t).kind == TypeKind.RawPointer and (deref coll_recv_t).payload != None to ptr[Type] and (deref (deref coll_recv_t).payload).payload != None to ptr[Type]:
                                        ret_type = (deref (deref coll_recv_t).payload).payload
                                    else:
                                        ret_type = make_type(TypeKind.Any)
                                else:
                                    coll_handled = False
                            elif coll_recv_k == TypeKind.String:
                                if strcmp(coll_mname.data to cstr, "length") == 0 or strcmp(coll_mname.data to cstr, "len") == 0:
                                    ret_type = make_type(TypeKind.I64)
                                else:
                                    coll_handled = False
                            else:
                                coll_handled = False
                            if coll_handled:
                                set_node_inferred_type(node, ret_type)
                                return ret_type
            if callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier and strcmp(node_name(callee).data to cstr, "Ok" to cstr) == 0:
                let ok_t as ptr[Type] = make_type(TypeKind.Result)
                if arg_count > 0 to i64:
                    let ok_arg_t as ptr[Type] = node_inferred_type(args[0])
                    if ok_arg_t != None to ptr[Type]:
                        (deref ok_t).payload = ok_arg_t
                ret_type = ok_t
            elif callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier and strcmp(node_name(callee).data to cstr, "Err" to cstr) == 0:
                let err_t as ptr[Type] = make_type(TypeKind.Result)
                if arg_count > 0 to i64:
                    let err_arg_t as ptr[Type] = node_inferred_type(args[0])
                    if err_arg_t != None to ptr[Type]:
                        (deref err_t).payload = err_arg_t
                ret_type = err_t
            elif callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier and (strcmp(node_name(callee).data to cstr, "Empty" to cstr) == 0 or strcmp(node_name(callee).data to cstr, "None" to cstr) == 0):
                ret_type = make_type(TypeKind.Option)
            elif callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier and strcmp(node_name(callee).data to cstr, "Some" to cstr) == 0:
                let some_t as ptr[Type] = make_type(TypeKind.Option)
                if arg_count > 0 to i64:
                    let some_arg_t as ptr[Type] = node_inferred_type(args[0])
                    if some_arg_t != None to ptr[Type]:
                        (deref some_t).payload = some_arg_t
                ret_type = some_t
            elif callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier and (strcmp(node_name(callee).data to cstr, "size" to cstr) == 0 or strcmp(node_name(callee).data to cstr, "size_of" to cstr) == 0 or strcmp(node_name(callee).data to cstr, "sizeof" to cstr) == 0 or strcmp(node_name(callee).data to cstr, "alignof" to cstr) == 0 or strcmp(node_name(callee).data to cstr, "align_of" to cstr) == 0):
                ret_type = make_type(TypeKind.I64)
            elif callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier and (strcmp(node_name(callee).data to cstr, "H" to cstr) == 0 or strcmp(node_name(callee).data to cstr, "X" to cstr) == 0 or strcmp(node_name(callee).data to cstr, "Y" to cstr) == 0 or strcmp(node_name(callee).data to cstr, "Z" to cstr) == 0 or strcmp(node_name(callee).data to cstr, "CNOT" to cstr) == 0 or strcmp(node_name(callee).data to cstr, "qbit" to cstr) == 0):
                ret_type = make_type(TypeKind.QBit)
            elif callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier and strcmp(node_name(callee).data to cstr, "measure" to cstr) == 0:
                ret_type = make_type(TypeKind.I32)
            elif callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier and strcmp(node_name(callee).data to cstr, "qreg" to cstr) == 0:
                ret_type = make_type(TypeKind.QReg)
            elif callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier and strcmp(node_name(callee).data to cstr, "make" to cstr) == 0:
                ret_type = make_ptr_type(make_type(TypeKind.Any))
            elif generic_ctor_t != None to ptr[Type]:
                ret_type = generic_ctor_t
            elif callee_t != None to ptr[Type]:
                if (deref callee_t).kind == TypeKind.Function and (deref callee_t).return_type != None to ptr[Type]:
                    ret_type = (deref callee_t).return_type
                elif (deref callee_t).kind == TypeKind.Struct and node_kind(callee) == NodeType.Identifier and strcmp(node_name(callee).data to cstr, "String" to cstr) != 0 and strcmp(node_name(callee).data to cstr, "List" to cstr) != 0 and strcmp(node_name(callee).data to cstr, "Dict" to cstr) != 0 and strcmp(node_name(callee).data to cstr, "Set" to cstr) != 0:
                    ret_type = callee_t
                else:
                    ret_type = make_type(TypeKind.Any)
            else:
                ret_type = make_type(TypeKind.Any)
                
        elif nt == NodeType.ReturnStmt:
            let return_val as ptr[Node] = node_body(node)
            if return_val != None to ptr[Node]:
                let opt_ret as ptr[u8] = (ref (deref self).current_function_return) to ptr[u8]
                if option_has_value(opt_ret):
                    let val_p as ptr[u8] = option_value(opt_ret)
                    let expected_ret_t as ptr[Type] = val_p to ptr[Type]
                    let ek as TypeKind = (deref expected_ret_t).kind
                    if ek != TypeKind.Void and ek != TypeKind.Any and ek != TypeKind.Unknown:
                        if node_kind(return_val) == NodeType.NumberLiteral:
                            set_node_inferred_type(return_val, expected_ret_t)
                ret_type = self.typecheck_node(return_val)
                // Track inferred return type for validation
                let self_ptr_r as ptr[TypeChecker] = self
                (deref self_ptr_r).inferred_return_type = ret_type
            else:
                ret_type = make_type(TypeKind.Void)
                
        elif nt == NodeType.WhileStmt:
            let dummy_c as ptr[Type] = self.typecheck_node(node_cond(node))
            let dummy_b as ptr[Type] = self.typecheck_node(node_body(node))
            ret_type = make_type(TypeKind.Void)
            
        elif nt == NodeType.ForStmt:
            let iter_type as ptr[Type] = self.typecheck_node(node_left(node))
            var elem_type as ptr[Type] = make_type(TypeKind.I64)
            if iter_type != None to ptr[Type]:
                let ik as TypeKind = (deref iter_type).kind
                if ik == TypeKind.List or ik == TypeKind.RawPointer:
                    if (deref iter_type).payload != None to ptr[Type]:
                        elem_type = (deref iter_type).payload
                elif ik == TypeKind.I32 or ik == TypeKind.I64 or ik == TypeKind.U64 or ik == TypeKind.USize:
                    elem_type = make_type(TypeKind.I64)

            let var_name as String = node_name(node)
            if (deref (deref self).sema).fn_scopes.has(node to usize):
                let child_scope as ptr[Scope] = (deref (deref self).sema).fn_scopes[node to usize]
                if (deref child_scope).symbols.has(var_name):
                    let sym as ptr[Symbol] = (deref child_scope).symbols[var_name]
                    (deref sym).resolved_type = elem_type

            set_node_inferred_type(node, elem_type)
            let dummy_body as ptr[Type] = self.typecheck_node(node_body(node))
            ret_type = make_type(TypeKind.Void)
            
        elif nt == NodeType.MemberExpr:
            let obj_t as ptr[Type] = self.typecheck_node(node_left(node))
            let obj_kind as TypeKind = (deref obj_t).kind
            if obj_kind == TypeKind.String or obj_kind == TypeKind.List or obj_kind == TypeKind.Dict:
                let prop_n as String = node_name(node)
                if prop_n.data != None to ptr[u8]:
                    if strcmp(prop_n.data to cstr, "data" to cstr) == 0:
                        ret_type = make_ptr_type(make_type(TypeKind.U8))
                    elif strcmp(prop_n.data to cstr, "len" to cstr) == 0 or strcmp(prop_n.data to cstr, "capacity" to cstr) == 0:
                        ret_type = make_type(TypeKind.I64)
                    else:
                        ret_type = make_type(TypeKind.Any)
            elif obj_kind == TypeKind.Enum:
                ret_type = obj_t
            elif obj_kind == TypeKind.Module:
                let left_name as String = node_name(node_left(node))
                if (deref (deref self).sema).loaded_modules.has(left_name):
                    let mod_scope as ptr[Scope] = (deref (deref self).sema).loaded_modules[left_name]
                    let prop_name as String = node_name(node)
                    if (deref mod_scope).symbols.has(prop_name):
                        let member_sym as ptr[Symbol] = (deref mod_scope).symbols[prop_name]
                        if (deref member_sym).resolved_type != None to ptr[Type]:
                            ret_type = (deref member_sym).resolved_type
                        else:
                            ret_type = make_type(TypeKind.Any)
                    else:
                        let d as ptr[Diagnostic] = (deref (deref self).sema).report_error_node("E0315" to cstr, String.make("module has no member with that name" to cstr), node)
                        if d != None to ptr[Diagnostic]:
                            d.set_explanation(String.make("The requested symbol was not exported or found in the target module scope." to cstr))
                        ret_type = make_type(TypeKind.Any)
                else:
                    ret_type = make_type(TypeKind.Any)
            else:
                var struct_name as String = String.make("" to cstr)
                if obj_kind == TypeKind.Struct or obj_kind == TypeKind.Class or obj_kind == TypeKind.Interface:
                    struct_name = (deref obj_t).name
                elif obj_kind == TypeKind.RawPointer and (deref obj_t).payload != None to ptr[Type]:
                    let pl as ptr[Type] = (deref obj_t).payload
                    if (deref pl).kind == TypeKind.Struct or (deref pl).kind == TypeKind.Class or (deref pl).kind == TypeKind.Interface:
                        struct_name = (deref pl).name
                if struct_name.len > 0 to usize:
                    extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
                    var br_pos_i as usize = 0
                    var found_bracket as bool = False
                    while br_pos_i < struct_name.len and not found_bracket:
                        if (deref ((struct_name.data to usize + br_pos_i) to ptr[u8])) == 91 to u8:
                            found_bracket = True
                        else:
                            br_pos_i = br_pos_i + 1 to usize
                    if found_bracket and br_pos_i > 0 to usize:
                        let base_alloc as ptr[u8] = make[u8](br_pos_i + 1 to usize) to ptr[u8]
                        let _mbc as ptr = memcpy(base_alloc to ptr, struct_name.data to ptr, br_pos_i)
                        base_alloc[br_pos_i] = 0 to u8
                        struct_name = String(data = base_alloc, len = br_pos_i, capacity = br_pos_i + 1 to usize)
                    let struct_sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(struct_name)
                    if struct_sym != None to ptr[Symbol]:
                        if (deref struct_sym).decl_node != None to ptr[Node]:
                            let decl as ptr[Node] = (deref struct_sym).decl_node
                            if node_body(decl) != None to ptr[Node]:
                                let body as ptr[Node] = node_body(decl)
                                let prop_name as String = node_name(node)
                                if node_kind(body) == NodeType.BlockStmt:
                                    let body_decls as List[ptr[Node]] = node_declarations(body)
                                    let d_count as i64 = body_decls.length()
                                    var d_i as i64 = 0 to i64
                                    while d_i < d_count:
                                        let field_decl as ptr[Node] = body_decls[d_i]
                                        if node_kind(field_decl) == NodeType.VarDecl and strcmp(node_name(field_decl).data to cstr, prop_name.data to cstr) == 0:
                                            if node_inferred_type(field_decl) != None to ptr[Type]:
                                                ret_type = node_inferred_type(field_decl)
                                            else:
                                                let type_annots as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(field_decl)
                                                if type_annots != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                                                    if (deref type_annots).length() > 0 to i64:
                                                        let f_opt_val as Option[ptr[TypeAnnotation]] = (deref type_annots)[0 to i64]
                                                        let f_opt as ptr[u8] = (ref f_opt_val) to ptr[u8]
                                                        if option_has_value(f_opt):
                                                            let val_p as ptr[u8] = option_value(f_opt)
                                                            let annot_val as ptr[TypeAnnotation] = val_p to ptr[TypeAnnotation]
                                                            if annot_val != None to ptr[TypeAnnotation]:
                                                                ret_type = self.resolve_type_annotation(annot_val)
                                                                set_node_inferred_type(field_decl, ret_type)
                                            break
                                        d_i = d_i + 1 to i64
                                    if ret_type == None to ptr[Type] or (deref ret_type).kind == TypeKind.Void:
                                        var m_i as i64 = 0 to i64
                                        while m_i < d_count:
                                            let m_decl as ptr[Node] = body_decls[m_i]
                                            if node_kind(m_decl) == NodeType.FunDecl and strcmp(node_name(m_decl).data to cstr, prop_name.data to cstr) == 0:
                                                let m_type as ptr[Type] = make_type(TypeKind.Function)
                                                let m_ret_annot as ptr[TypeAnnotation] = node_return_type_annot(m_decl)
                                                if m_ret_annot != None to ptr[TypeAnnotation]:
                                                    if (deref m_ret_annot).name.len > 0 to usize:
                                                        (deref m_type).return_type = self.resolve_type_annotation(m_ret_annot)
                                                    else:
                                                        (deref m_type).return_type = make_type(TypeKind.Void)
                                                else:
                                                    (deref m_type).return_type = make_type(TypeKind.Void)
                                                ret_type = m_type
                                                break
                                            m_i = m_i + 1 to i64
                    if ret_type == None to ptr[Type] or (deref ret_type).kind == TypeKind.Void:
                        ret_type = make_type(TypeKind.Any)
                else:
                    ret_type = make_type(TypeKind.Any)
        elif nt == NodeType.WithStmt:
            let expr_t as ptr[Type] = self.typecheck_node(node_left(node))
            var bound_type as ptr[Type] = expr_t
            if bound_type == None to ptr[Type]:
                bound_type = make_type(TypeKind.Void)
            let var_name as String = node_name(node)
            let sema_ptr as ptr[Sema] = (deref self).sema
            var prev_scope as ptr[Scope] = None to ptr[Scope]
            if (deref sema_ptr).fn_scopes.has(node to usize):
                let child_scope as ptr[Scope] = (deref sema_ptr).fn_scopes[node to usize]
                if var_name.len > 0 to usize and (deref child_scope).symbols.has(var_name):
                    let sym as ptr[Symbol] = (deref child_scope).symbols[var_name]
                    (deref sym).resolved_type = bound_type
                prev_scope = (deref sema_ptr).current_scope
                (deref sema_ptr).current_scope = child_scope

            set_node_inferred_type(node, bound_type)
            let body_t as ptr[Type] = self.typecheck_node(node_body(node))
            if prev_scope != None to ptr[Scope]:
                (deref sema_ptr).current_scope = prev_scope
            ret_type = body_t

        elif nt == NodeType.IfStmt:
            let dummy_c as ptr[Type] = self.typecheck_node(node_cond(node))
            let then_t as ptr[Type] = self.typecheck_node(node_then_branch(node))
            let else_opt_raw as Option[ptr[Node]] = node_else_branch(node)
            let else_opt as ptr[u8] = (ref else_opt_raw) to ptr[u8]
            if option_has_value(else_opt):
                let else_node as ptr[Node] = option_value(else_opt) to ptr[Node]
                let else_t as ptr[Type] = self.typecheck_node(else_node)
                // Merge branch types
                if (deref then_t).kind == (deref else_t).kind:
                    ret_type = then_t
                elif (deref then_t).kind == TypeKind.Void or (deref else_t).kind == TypeKind.Void:
                    ret_type = make_type(TypeKind.Void)
                elif (deref then_t).kind == TypeKind.Any or (deref else_t).kind == TypeKind.Any:
                    ret_type = make_type(TypeKind.Any)
                elif (deref then_t).kind == TypeKind.Unknown or (deref else_t).kind == TypeKind.Unknown:
                    ret_type = make_type(TypeKind.Unknown)
                else:
                    ret_type = make_type(TypeKind.Void)
            else:
                ret_type = make_type(TypeKind.Void)

        elif nt == NodeType.UnaryExpr:
            let op as String = node_op(node)
            if op.data != None to ptr[u8] and strcmp(op.data to cstr, "size" to cstr) == 0:
                ret_type = make_type(TypeKind.I64)
                set_node_inferred_type(node, ret_type)
                return ret_type
            let operand_t as ptr[Type] = self.typecheck_node(node_left(node))
            if strcmp(op.data to cstr, "not" to cstr) == 0:
                ret_type = make_type(TypeKind.Boolean)
            elif strcmp(op.data to cstr, "-" to cstr) == 0 or strcmp(op.data to cstr, "+" to cstr) == 0:
                ret_type = operand_t
            elif strcmp(op.data to cstr, "ref" to cstr) == 0 or strcmp(op.data to cstr, "ref mut" to cstr) == 0:
                let payload_t as ptr[Type] = make[Type](1 to usize) to ptr[Type]
                (deref payload_t) = deref operand_t
                ret_type = make_ptr_type(payload_t)
            elif strcmp(op.data to cstr, "deref" to cstr) == 0:
                if (deref operand_t).kind == TypeKind.RawPointer and (deref operand_t).payload != None to ptr[Type]:
                    ret_type = (deref operand_t).payload
                elif (deref operand_t).kind == TypeKind.Class or (deref operand_t).kind == TypeKind.Struct:
                    ret_type = operand_t
                else:
                    ret_type = make_type(TypeKind.Any)
            elif strcmp(op.data to cstr, "~" to cstr) == 0:
                ret_type = operand_t
            else:
                ret_type = operand_t

        elif nt == NodeType.CastExpr:
            let _dummy_op as ptr[Type] = self.typecheck_node(node_left(node))
            let target_name as String = node_op(node)
            if target_name.len > 0 to usize:
                let tmp_annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
                (deref tmp_annot).name = target_name
                (deref tmp_annot).lifetime = Empty
                (deref tmp_annot).generics = Empty
                (deref tmp_annot).params = Empty
                (deref tmp_annot).return_type = None to ptr[TypeAnnotation]
                ret_type = self.resolve_type_annotation(tmp_annot)
            else:
                ret_type = make_type(TypeKind.Any)

        elif nt == NodeType.MatchStmt:
            let subject_t as ptr[Type] = self.typecheck_node(node_left(node))
            let cases as List[ptr[Node]] = node_declarations(node)
            let case_count as i64 = cases.length()
            var c_idx as i64 = 0 to i64
            while c_idx < case_count:
                let case_node as ptr[Node] = cases[c_idx]
                if node_kind(case_node) == NodeType.BinaryExpr:
                    let parent_scope as ptr[Scope] = (deref (deref self).sema).current_scope
                    if (deref (deref self).sema).fn_scopes.has(case_node to usize):
                        let child_scope as ptr[Scope] = (deref (deref self).sema).fn_scopes[case_node to usize]
                        (deref (deref self).sema).current_scope = child_scope

                    let pat_wrapper as ptr[Node] = node_left(case_node)
                    let case_body as ptr[Node] = node_right(case_node)
                    var inner_pat as ptr[Node] = pat_wrapper
                    var guard_expr as ptr[Node] = None to ptr[Node]
                    if pat_wrapper != None to ptr[Node]:
                        if node_kind(pat_wrapper) == NodeType.BinaryExpr and strcmp(node_op(pat_wrapper).data to cstr, "if" to cstr) == 0:
                            inner_pat = node_left(pat_wrapper)
                            guard_expr = node_right(pat_wrapper)

                    if inner_pat != None to ptr[Node]:
                        if node_kind(inner_pat) == NodeType.Identifier:
                            let pat_name as String = node_name(inner_pat)
                            if strcmp(pat_name.data to cstr, "_" to cstr) != 0:
                                let sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(pat_name)
                                if sym != None to ptr[Symbol]:
                                    (deref sym).resolved_type = subject_t
                                set_node_inferred_type(inner_pat, subject_t)
                        elif node_kind(inner_pat) == NodeType.CallExpr:
                            let callee_pat as ptr[Node] = node_left(inner_pat)
                            let pat_args as List[ptr[Node]] = node_params(inner_pat)
                            let pa_count as i64 = pat_args.length()

                            var var_decl_node as ptr[Node] = None to ptr[Node]
                            if callee_pat != None to ptr[Node]:
                                let v_sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(node_name(callee_pat))
                                if v_sym != None to ptr[Symbol]:
                                    var_decl_node = (deref v_sym).decl_node

                            var v_params as List[ptr[Node]] = List[ptr[Node]]()
                            if var_decl_node != None to ptr[Node] and node_kind(var_decl_node) == NodeType.FunDecl:
                                v_params = node_params(var_decl_node)

                            var pa_i as i64 = 0 to i64
                            while pa_i < pa_count:
                                let p_node as ptr[Node] = pat_args[pa_i]
                                var field_t as ptr[Type] = make_type(TypeKind.F32)
                                if pa_i < v_params.length():
                                    let v_p as ptr[Node] = v_params[pa_i]
                                    if node_type_annots(v_p) != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                                        let ann_l_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(v_p)
                                        if (deref ann_l_ptr).length() > 0 to i64:
                                            let opt_ann as Option[ptr[TypeAnnotation]] = (deref ann_l_ptr)[0 to i64]
                                            let opt_ref as ptr[OptionLayout] = (ref opt_ann) to ptr[OptionLayout]
                                            if option_has_value(opt_ref to ptr[u8]):
                                                let val_p as ptr[u8] = option_value(opt_ref to ptr[u8])
                                                let annot_val as ptr[TypeAnnotation] = val_p to ptr[TypeAnnotation]
                                                if annot_val != None to ptr[TypeAnnotation]:
                                                    field_t = self.resolve_type_annotation(annot_val)

                                if node_kind(p_node) == NodeType.Identifier:
                                    let p_name as String = node_name(p_node)
                                    let p_sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(p_name)
                                    if p_sym != None to ptr[Symbol]:
                                        (deref p_sym).resolved_type = field_t
                                    set_node_inferred_type(p_node, field_t)
                                pa_i = pa_i + 1 to i64
                        else:
                            let _dummy_p as ptr[Type] = self.typecheck_node(inner_pat)

