            let var_name as String = node_name(node)
            let parent_scope as ptr[Scope] = (deref (deref self).sema).current_scope
            var child_scope as ptr[Scope] = None to ptr[Scope]
            if (deref (deref self).sema).fn_scopes.has(node to usize):
                child_scope = (deref (deref self).sema).fn_scopes[node to usize]
                (deref (deref self).sema).current_scope = child_scope
                if var_name.len > 0 to usize and (deref child_scope).symbols.has(var_name):
                    let sym as ptr[Symbol] = (deref child_scope).symbols[var_name]
                    (deref sym).resolved_type = make_type(TypeKind.I32)

