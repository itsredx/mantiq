            let d_count as i64 = d_items.length()
            var d_i as i64 = 0 to i64
            while d_i < d_count:
                let _d_t as ptr[Type] = self.typecheck_node(d_items[d_i])
                d_i = d_i + 1 to i64

        elif nt == NodeType.IndexExpr:
            let coll_t as ptr[Type] = self.typecheck_node(node_left(node))
            let _dummy_idx as ptr[Type] = self.typecheck_node(node_right(node))
            if coll_t != None to ptr[Type]:
                if (deref coll_t).kind == TypeKind.List or (deref coll_t).kind == TypeKind.Slice or (deref coll_t).kind == TypeKind.RawPointer:
