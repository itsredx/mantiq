                        let _dummy_g as ptr[Type] = self.typecheck_node(guard_expr)

                    if case_body != None to ptr[Node]:
                        let _dummy_b as ptr[Type] = self.typecheck_node(case_body)

                    let self_ref_tc_m as ptr[TypeChecker] = self
                    (deref (deref self_ref_tc_m).sema).current_scope = parent_scope
                c_idx = c_idx + 1 to i64
            ret_type = make_type(TypeKind.Void)

        elif nt == NodeType.TryStmt:
            let body_t as ptr[Type] = self.typecheck_node(node_left(node))
            var unwrapped_t as ptr[Type] = None to ptr[Type]
            // Unwrap Result/Option type
            if body_t != None to ptr[Type] and ((deref body_t).kind == TypeKind.Result or (deref body_t).kind == TypeKind.Option):
                if (deref body_t).payload != None to ptr[Type]:
                    unwrapped_t = (deref body_t).payload
                else:
                    unwrapped_t = make_type(TypeKind.Any)
            else:
                unwrapped_t = body_t
            if unwrapped_t == None to ptr[Type]:
