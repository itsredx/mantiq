            ret_type = make_union_type(union_name)
            if node_body(node) != None to ptr[Node]:
                let dummy_ud as ptr[Type] = self.typecheck_node(node_body(node))

        let _sep2 as i32 = 0
        set_node_inferred_type(node, ret_type)
        return ret_type
