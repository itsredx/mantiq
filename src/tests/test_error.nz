// ── Imports ─────────────────────────────────────────────────────────────
import std.collections
from std.string import String
from std.collections import List
from std.mem import make
import symbols
from symbols import Span
import error
from error import DiagnosticEngine, Diagnostic, Severity, Label, Suggestion

// ── C FFI Declarations ───────────────────────────────────────────────────
extern fn printf(format as cstr, ...) as i32

// ── Main Unit Test Runner ────────────────────────────────────────────────
fn main() -> i32:
    let _header as i32 = printf("=== Running error.nz Unit Tests ===\n\n" to cstr)

    let engine as ptr[DiagnosticEngine] = make[DiagnosticEngine](1 to usize) to ptr[DiagnosticEngine]
    engine.init()

    let sample_source as cstr = "fn calculate_total(items as List[Item]) as i32:\n    let count as i32 = \"42\"\n    return count\n" to cstr
    let file_name as String = String.make("src/services/billing.nz" to cstr)

    // ── Test 1: Type Mismatch Error ──────────────────────────────────────
    let error_span as Span = Span(start_byte = 53 to u32, end_byte = 57 to u32, start_row = 1 to u32, start_col = 23 to u32, end_row = 1 to u32, end_col = 27 to u32)
    let diag1 as ptr[Diagnostic] = engine.report_error("E0308" to cstr, String.make("mismatched types: expected `i32`, found `String`" to cstr), file_name, error_span)

    diag1.set_explanation(String.make("Nizam enforces strict static type discipline during variable assignments and function returns. Implicit type coercion is prohibited to ensure memory safety and determinism." to cstr))
    diag1.add_help(String.make("To convert a `String` to `i32`, call `.parse_i32()` on the string value, or check if the source expression can directly provide an integer." to cstr))
    diag1.add_suggestion(error_span, String.make("42" to cstr), String.make("Replace string literal with integer literal in assignment expression" to cstr))

    // ── Test 2: Unused Variable Warning ──────────────────────────────────
    let warn_span as Span = Span(start_byte = 64 to u32, end_byte = 69 to u32, start_row = 2 to u32, start_col = 11 to u32, end_row = 2 to u32, end_col = 16 to u32)
    let diag2 as ptr[Diagnostic] = engine.report_warning("W0012" to cstr, String.make("unused variable `count`" to cstr), file_name, warn_span)
    diag2.add_note(String.make("If this is intended, prefix variable with an underscore: `_count`" to cstr))

    // ── Test 3: Panic Reporting ──────────────────────────────────────────
    let panic_span as Span = Span(start_byte = 0 to u32, end_byte = 10 to u32, start_row = 0 to u32, start_col = 1 to u32, end_row = 0 to u32, end_col = 10 to u32)
    let diag3 as ptr[Diagnostic] = engine.report_panic(String.make("index out of bounds: the len is 3 but the index is 5" to cstr), file_name, panic_span)

    // ── Emit Diagnostics ─────────────────────────────────────────────────
    engine.emit_all(sample_source)

    // ── Verification ────────────────────────────────────────────────────
    if (deref engine).error_count == 1 to u32 and (deref engine).warning_count == 1 to u32 and (deref engine).panic_count == 1 to u32:
        let _r as i32 = printf("\n[PASS] error.nz Unit Tests Completed Successfully! (Errors: %d, Warnings: %d, Panics: %d)\n" to cstr, (deref engine).error_count, (deref engine).warning_count, (deref engine).panic_count)
        return 0 to i32
    else:
        let _r as i32 = printf("\n[FAIL] Diagnostic counter mismatch! (Errors: %d, Warnings: %d, Panics: %d)\n" to cstr, (deref engine).error_count, (deref engine).warning_count, (deref engine).panic_count)
        return 1 to i32
