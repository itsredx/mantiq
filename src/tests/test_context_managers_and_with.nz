// ── Context Managers and With Statements Test ─────────────────────────

static var g_enter_order = 0 to i32
static var g_exit_order = 0 to i32
static var g_step = 0 to i32

struct SimpleResource:
    var fd as i32

struct ManagedResource:
    var id as i32

    fn __enter__(self as ptr[ManagedResource]):
        g_step += 1 to i32
        g_enter_order = g_step

    fn __exit__(self as ptr[ManagedResource]):
        g_step += 1 to i32
        g_exit_order = g_step

struct NestResource:
    var level as i32

    fn __enter__(self as ptr[NestResource]):
        g_step += 1 to i32

    fn __exit__(self as ptr[NestResource]):
        g_step += 1 to i32

fn main() as i32:
    // 1. Basic struct context manager with 'as' binding
    let r1 = SimpleResource(fd = 42 to i32)
    var read_fd as i32 = 0 to i32
    with r1 as f:
        read_fd = f.fd
    if read_fd != 42 to i32:
        return 1 to i32

    // 2. Protocol lifecycle verification (__enter__ -> body -> __exit__)
    g_step = 0 to i32
    g_enter_order = 0 to i32
    g_exit_order = 0 to i32
    var body_executed as bool = False

    let mgr = ManagedResource(id = 100 to i32)
    with mgr as m:
        if g_enter_order != 1 to i32:
            return 2 to i32
        if g_exit_order != 0 to i32:
            return 3 to i32
        if m.id != 100 to i32:
            return 4 to i32
        body_executed = True

    if not body_executed:
        return 5 to i32
    if g_exit_order != 2 to i32:
        return 6 to i32

    // 3. Anonymous context manager (without 'as' clause)
    let anon_mgr = ManagedResource(id = 200 to i32)
    g_step = 0 to i32
    g_enter_order = 0 to i32
    g_exit_order = 0 to i32
    with anon_mgr:
        if g_enter_order != 1 to i32:
            return 7 to i32
    if g_exit_order != 2 to i32:
        return 8 to i32

    // 4. Nested context managers
    g_step = 0 to i32
    let outer = NestResource(level = 1 to i32)
    let inner = NestResource(level = 2 to i32)
    with outer as o:
        if g_step != 1 to i32:
            return 9 to i32
        with inner as i:
            if g_step != 2 to i32:
                return 10 to i32
            if o.level != 1 to i32 or i.level != 2 to i32:
                return 11 to i32
        if g_step != 3 to i32:
            return 12 to i32
    if g_step != 4 to i32:
        return 13 to i32

    // 5. Verification of user pattern: with _f + 'is Any' intrinsic check
    let _f = SimpleResource(fd = 7 to i32)
    with _f:
        pass
    let _is as bool = _f is Any
    if not _is:
        return 14 to i32

    return 0 to i32
