from std.string import String
import[c] "stdio.h"
import[c] "stdlib.h"
import[c] "string.h"

extern fn printf(fmt as cstr, ...) as i32
extern fn puts(s as cstr) as i32

struct Point:
    var x as i32
    var y as i32

struct MixedRecord:
    var id as i32
    var val as i64
    var active as bool

fn test_primitive_arithmetic() as bool:
    let a as i32 = 1000
    let b as i32 = 337
    let sum as i32 = a + b
    let diff as i32 = a - b
    let prod as i32 = a * 2
    let div as i32 = a / 4
    if sum == 1337 and diff == 663 and prod == 2000 and div == 250:
        return True
    return False

fn test_struct_layout() as bool:
    let p as Point = Point(x = 10 to i32, y = 20 to i32)
    let m as MixedRecord = MixedRecord(id = 42 to i32, val = 10000000000 to i64, active = True)
    if p.x == 10 and p.y == 20 and m.id == 42 and m.val == 10000000000 to i64 and m.active:
        return True
    return False

fn test_string_operations() as bool:
    let greeting as String = String.make("Hello WebAssembly!" to cstr)
    if greeting.len == 18 to usize:
        return True
    return False

fn main() as i32:
    puts("=== Testing WASM ABI & Data Layout ===" to cstr)
    if not test_primitive_arithmetic():
        puts("[FAIL] Primitive arithmetic failed!" to cstr)
        return 1
    puts("Test 1 (Primitive Arithmetic): PASSED!" to cstr)

    if not test_struct_layout():
        puts("[FAIL] Struct layout failed!" to cstr)
        return 1
    puts("Test 2 (Struct Layout & 64-bit Fields): PASSED!" to cstr)

    if not test_string_operations():
        puts("[FAIL] String operations failed!" to cstr)
        return 1
    puts("Test 3 (String Layout & Length): PASSED!" to cstr)

    puts("\n[PASS] All WASM ABI tests passed!" to cstr)
    return 0
