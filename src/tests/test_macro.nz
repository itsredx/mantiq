from lower import Lowerer, make_lowerer_from_cstr, make_lowerer_mantiq_from_cstr
from symbols import Node, NodeType, node_kind, node_name_ptr, node_left, node_right, node_body, node_declarations, node_val
from std.collections import List
from std.string import String

extern fn strcmp(s1 as cstr, s2 as cstr) as i32
extern fn printf(format as cstr, val as cstr) as i32

fn main() -> i32:
    let src_nizam as cstr = "class MyClass:\n    var val as i32\n" to cstr
    var lower_nizam as ptr[Lowerer] = make_lowerer_from_cstr(src_nizam, "test_nizam.nz" to cstr)
    let root_nizam as ptr = (deref lower_nizam).lower_source() to ptr
    let root_nizam_node as ptr[Node] = root_nizam to ptr[Node]
    if root_nizam_node == None to ptr[Node] or node_declarations(root_nizam_node).length() == 0 to i64:
        let r1 as i32 = printf("Nizam strict mode successfully rejected class definition!\n" to cstr, "" to cstr)
    else:
        let r1 as i32 = printf("FAILED: Nizam mode allowed class definition!\n" to cstr, "" to cstr)

    let src_mantiq as cstr = "class MyClass:\n    var val as i32\n" to cstr
    var lower_mantiq as ptr[Lowerer] = make_lowerer_mantiq_from_cstr(src_mantiq, "test_mantiq.mq" to cstr)
    let root_mantiq as ptr = (deref lower_mantiq).lower_source() to ptr
    if root_mantiq != None:
        let r2 as i32 = printf("Mantiq mode successfully allowed class definition!\n" to cstr, "" to cstr)
    else:
        let r2 as i32 = printf("FAILED: Mantiq mode rejected class definition!\n" to cstr, "" to cstr)

    let src_macro as cstr = "macro twice(x):\n    x + x\n\nmacro make_local(val):\n    let y = val\n    y + y\n\nlet res = twice!(5)\nlet res2 = make_local!(10)\n" to cstr
    var lower_macro as ptr[Lowerer] = make_lowerer_from_cstr(src_macro, "test_macro.nz" to cstr)
    let root_macro_ast as ptr = (deref lower_macro).lower_source() to ptr
    if root_macro_ast == None:
        let r3 as i32 = printf("FAILED: CST to AST lowering with macros returned null!\n" to cstr, "" to cstr)
        return 1 to i32

    let root as ptr[Node] = root_macro_ast to ptr[Node]
    let decls_list as List[ptr[Node]] = node_declarations(root)
    let decls_len as i64 = decls_list.length()

    if decls_len == 0:
        let r4 as i32 = printf("FAILED: root declarations is empty!\n" to cstr, "" to cstr)
        return 1 to i32

    let r_len as i32 = printf("Declarations count: %d\n" to cstr, decls_len to cstr)

    var idx as i64 = 0 to i64
    while idx < decls_len:
        let decl as ptr[Node] = decls_list[idx]
        let nt as NodeType = node_kind(decl)
        let name_p as ptr[String] = node_name_ptr(decl)
        var name_cstr as cstr = "" to cstr
        if name_p != None to ptr[String] and (deref name_p).data != None:
            name_cstr = (deref name_p).data to cstr
        let r_info as i32 = printf("Decl index node_type: %s\n" to cstr, name_cstr)

        if idx == 2 to i64:
            if nt == NodeType.VarDecl:
                let r_v1 as i32 = printf("res VarDecl variable name: %s\n" to cstr, name_cstr)

                let init_node as ptr[Node] = node_left(decl)

                if init_node != None to ptr[Node] and node_kind(init_node) == NodeType.BinaryExpr:
                    let r_v2 as i32 = printf("twice!(5) expanded to BinaryExpr!\n" to cstr, "" to cstr)
                    let left as ptr[Node] = node_left(init_node)
                    let right as ptr[Node] = node_right(init_node)
                    if node_kind(left) == NodeType.NumberLiteral and node_kind(right) == NodeType.NumberLiteral:
                        if node_val(left) == 5 to f64 and node_val(right) == 5 to f64:
                            let r_v3 as i32 = printf("twice!(5) arguments successfully substituted (5 + 5)!\n" to cstr, "" to cstr)

        elif idx == 3 to i64:
            if nt == NodeType.VarDecl:
                let r_v4 as i32 = printf("res2 VarDecl variable name: %s\n" to cstr, name_cstr)

                let init_node as ptr[Node] = node_left(decl)

                if init_node != None to ptr[Node] and node_kind(init_node) == NodeType.BlockStmt:
                    let r_v5 as i32 = printf("make_local!(10) expanded to BlockStmt!\n" to cstr, "" to cstr)

                    let block_decls as List[ptr[Node]] = node_declarations(init_node)
                    let block_len as i64 = block_decls.length()

                    if block_len == 2 to i64:
                        let block_decl0 as ptr[Node] = block_decls[0]
                        let block_decl1 as ptr[Node] = block_decls[1]

                        if node_kind(block_decl0) == NodeType.VarDecl:
                            let local_var_p as ptr[String] = node_name_ptr(block_decl0)
                            var local_var_name as cstr = "" to cstr
                            if local_var_p != None to ptr[String] and (deref local_var_p).data != None:
                                local_var_name = (deref local_var_p).data to cstr
                            let r_v6 as i32 = printf("Mangled local variable name in block: %s\n" to cstr, local_var_name)

                            if node_kind(block_decl1) == NodeType.BinaryExpr:
                                let left as ptr[Node] = node_left(block_decl1)
                                let right as ptr[Node] = node_right(block_decl1)
                                if left != None to ptr[Node] and right != None to ptr[Node]:
                                    let l_p as ptr[String] = node_name_ptr(left)
                                    let r_p as ptr[String] = node_name_ptr(right)
                                    var l_name as cstr = "" to cstr
                                    var r_name as cstr = "" to cstr
                                    if l_p != None to ptr[String] and (deref l_p).data != None:
                                        l_name = (deref l_p).data to cstr
                                    if r_p != None to ptr[String] and (deref r_p).data != None:
                                        r_name = (deref r_p).data to cstr

                                    if strcmp(local_var_name, l_name) == 0 and strcmp(local_var_name, r_name) == 0:
                                        let r_v8 as i32 = printf("Hygienic macro expansion and mangling verified successfully!\n" to cstr, "" to cstr)
        idx = idx + 1 to i64

    return 0 to i32
