import string
from string import String
import error
from error import DiagnosticEngine
import symbols
from symbols import Node, NodeType, LanguageMode, node_kind, node_is_async
import lower
from lower import Lowerer, make_lowerer_mantiq_from_cstr
import types
from types import Type, TypeKind
import sema
from sema import Sema
import typecheck
from typecheck import TypeChecker

extern fn printf(fmt as cstr, ...) as i32
extern fn exit(code as i32)

// ── Assertions ─────────────────────────────────────────────────────────────
fn assert_true(cond as bool, msg as cstr):
    if not cond:
        let _ as i32 = printf("FAIL: %s\n" to cstr, msg)
        exit(1 to i32)

// ── AST Lowering, Sema & Typecheck Tests ────────────────────────────────────
fn test_ast_lowering_and_sema():
    let src as cstr = "async fn worker(x as i32) as i32:\n    return x * 2\n\nfn main():\n    let t = spawn worker(10)\n    let res = await t\n" to cstr
    let lr as ptr[Lowerer] = make_lowerer_mantiq_from_cstr(src, "test_async.mq" to cstr)
    let ast_root as ptr[Node] = (deref lr).lower_source()
    assert_true(ast_root != None to ptr[Node], "AST Root must not be null" to cstr)
    assert_true(node_kind(ast_root) == NodeType.Program, "Root must be Program" to cstr)

    let engine as ptr[DiagnosticEngine] = make[DiagnosticEngine](1 to usize) to ptr[DiagnosticEngine]
    engine.init()
    engine.register_source(String.make("test_async.mq"), String.make(src))

    let s as ptr[Sema] = make[Sema](1 to usize) to ptr[Sema]
    s.init_sema(engine)
    (deref s).mode = LanguageMode.Mantiq
    s.declare_pass(ast_root)
    s.resolve_pass(ast_root)
    assert_true((deref engine).diagnostics.length() == 0 to i64, "Sema must report zero errors" to cstr)

    let tc as ptr[TypeChecker] = make[TypeChecker](1 to usize) to ptr[TypeChecker]
    tc.init_tc(s)
    tc.typecheck_node(ast_root)
    assert_true((deref engine).diagnostics.length() == 0 to i64, "Typecheck root must succeed" to cstr)
    let _ as i32 = printf("  PASS: Async / Concurrency AST lowering, sema, and typecheck\n" to cstr)

// ── Async Functions ────────────────────────────────────────────────────────
async fn async_add(a as i32, b as i32) as i32:
    return a + b

async fn async_factorial(n as i32) as i32:
    if n <= 1 to i32:
        return 1 to i32
    var res as i32 = 1 to i32
    var i as i32 = 2 to i32
    while i <= n:
        res = res * i
        i = i + 1 to i32
    return res

async fn async_multiply(x as i32, y as i32) as i32:
    return x * y

// ── Runtime Execution Tests ────────────────────────────────────────────────
fn test_basic_async_spawn_await():
    let t1 = spawn async_add(25 to i32, 17 to i32)
    let t2 = spawn async_factorial(5 to i32)

    let res1 as i32 = await t1
    let res2 as i32 = await t2

    assert_true(res1 == 42 to i32, "async_add(25, 17) must be 42" to cstr)
    assert_true(res2 == 120 to i32, "async_factorial(5) must be 120" to cstr)
    let _ as i32 = printf("  PASS: Basic spawn and await execution\n" to cstr)

fn test_multiple_concurrent_tasks():
    let t_a = spawn async_add(100 to i32, 200 to i32)
    let t_b = spawn async_multiply(6 to i32, 7 to i32)
    let t_c = spawn async_factorial(6 to i32)
    let t_d = spawn async_add(500 to i32, 500 to i32)

    let val_a as i32 = await t_a
    let val_b as i32 = await t_b
    let val_c as i32 = await t_c
    let val_d as i32 = await t_d

    assert_true(val_a == 300 to i32, "t_a must be 300" to cstr)
    assert_true(val_b == 42 to i32, "t_b must be 42" to cstr)
    assert_true(val_c == 720 to i32, "t_c must be 720" to cstr)
    assert_true(val_d == 1000 to i32, "t_d must be 1000" to cstr)
    let _ as i32 = printf("  PASS: Multiple concurrent async tasks\n" to cstr)

// ── Main Entry ─────────────────────────────────────────────────────────────
fn main():
    let _1 as i32 = printf("[TEST SUITE] Async & Concurrency (async fn, spawn, await)\n" to cstr)
    test_ast_lowering_and_sema()
    test_basic_async_spawn_await()
    test_multiple_concurrent_tasks()
    let _2 as i32 = printf("[ALL TESTS PASSED] 3/3 Async & Concurrency test suites succeeded!\n" to cstr)
