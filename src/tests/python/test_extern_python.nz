// ── Tier 2 Static Typed extern[python] Declarations Test ──────────────
extern fn printf(fmt as cstr, ...) as i32
extern fn strcmp(s1 as cstr, s2 as cstr) as i32

// Block syntax with "math"
extern[python] "math":
    fn sqrt(x as f64) as f64
    fn pow(base as f64, exp as f64) as f64
    fn floor(x as f64) as f64
    fn hypot(x as f64, y as f64) as f64

// Inline syntax
extern[python] "math" fn ceil(x as f64) as f64
extern[python] "math" fn isnan(x as f64) as bool

// Block syntax with "os.path" (cstr parameters and cstr return)
extern[python] "os.path":
    fn join(a as cstr, b as cstr) as cstr
    fn dirname(p as cstr) as cstr

// Builtins module with integer primitive
extern[python] "builtins":
    fn abs(x as i64) as i64

// PyObject return unboxing
extern[python] "math" fn fabs(x as f64) as PyObject

fn test_block_syntax() as bool:
    let s as f64 = sqrt(144.0)
    printf("  [Test 1] sqrt(144.0) = %f\n" to cstr, s)
    if s != 12.0:
        return False

    let p as f64 = pow(2.0, 10.0)
    printf("  [Test 2] pow(2.0, 10.0) = %f\n" to cstr, p)
    if p != 1024.0:
        return False

    let fl as f64 = floor(3.7)
    printf("  [Test 3] floor(3.7) = %f\n" to cstr, fl)
    if fl != 3.0:
        return False

    let h as f64 = hypot(3.0, 4.0)
    printf("  [Test 4] hypot(3.0, 4.0) = %f\n" to cstr, h)
    if h != 5.0:
        return False

    return True

fn test_inline_syntax() as bool:
    let c as f64 = ceil(3.2)
    printf("  [Test 5] ceil(3.2) = %f\n" to cstr, c)
    if c != 4.0:
        return False

    let is_nan as bool = isnan(42.0)
    printf("  [Test 6] isnan(42.0) = %d\n" to cstr, is_nan to i32)
    if is_nan:
        return False

    return True

extern fn free(p as ptr)

fn test_string_marshalling() as bool:
    let joined as cstr = join("foo" to cstr, "bar" to cstr)
    printf("  [Test 7] join(\"foo\", \"bar\") = %s\n" to cstr, joined)
    let ok1 as bool = strcmp(joined, "foo/bar" to cstr) == 0
    free(joined to ptr)
    if not ok1:
        return False

    let dir as cstr = dirname("/usr/local/bin" to cstr)
    printf("  [Test 8] dirname(\"/usr/local/bin\") = %s\n" to cstr, dir)
    let ok2 as bool = strcmp(dir, "/usr/local" to cstr) == 0
    free(dir to ptr)
    if not ok2:
        return False

    return True

fn test_integer_and_pyobject() as bool:
    let a as i64 = abs(-42 to i64)
    printf("  [Test 9] abs(-42) = %lld\n" to cstr, a)
    if a != 42 to i64:
        return False

    let obj as PyObject = fabs(-5.5)
    let v as f64 = obj.to[f64]()
    printf("  [Test 10] fabs(-5.5) as PyObject -> f64 = %f\n" to cstr, v)
    if v != 5.5:
        return False

    return True

fn test_cache_stability_loop() as bool:
    var i as i64 = 0 to i64
    while i < 1000 to i64:
        let s as f64 = sqrt(25.0)
        if s != 5.0:
            return False
        i = i + 1 to i64
    printf("  [Test 11] 1000 iterations of cached extern[python] calls completed\n" to cstr)
    return True

fn main() as i32:
    printf("============================================================\n" to cstr)
    printf(" Running Tier 2 Static Typed extern[python] Verification\n" to cstr)
    printf("============================================================\n" to cstr)

    if not test_block_syntax():
        printf("FAILED: test_block_syntax\n" to cstr)
        return 1 to i32

    if not test_inline_syntax():
        printf("FAILED: test_inline_syntax\n" to cstr)
        return 2 to i32

    if not test_string_marshalling():
        printf("FAILED: test_string_marshalling\n" to cstr)
        return 3 to i32

    if not test_integer_and_pyobject():
        printf("FAILED: test_integer_and_pyobject\n" to cstr)
        return 4 to i32

    if not test_cache_stability_loop():
        printf("FAILED: test_cache_stability_loop\n" to cstr)
        return 5 to i32

    printf("ALL TIER 2 EXTERN[PYTHON] TESTS PASSED!\n" to cstr)
    return 0 to i32
