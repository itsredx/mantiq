// ── Imports ─────────────────────────────────────────────────────────────
import std.collections
from std.string import String
from std.collections import List, Dict
import symbols
from symbols import Node, NodeType, Span, Symbol, node_kind, node_name, node_declarations
import lower
from lower import Lowerer, make_lowerer_mantiq_from_cstr
import sema
from sema import Sema
import typecheck
from typecheck import TypeChecker
import borrowck
from borrowck import BorrowChecker

// ── C FFI Declarations ───────────────────────────────────────────────────
extern fn printf(format as cstr, ...) as i32
extern fn strcmp(s1 as cstr, s2 as cstr) as i32

// ── Test 1: Valid NLL Early Release ──────────────────────────────────────
fn test_nll_early_release() as bool:
    let src as cstr = "fn test_nll():\n    var x as i32 = 42\n    let r as life[a] i32 = ref x\n    let v as i32 = deref r\n    x = 100\n" to cstr
    let lr as ptr[Lowerer] = make_lowerer_mantiq_from_cstr(src, "test_nll1.nz" to cstr)
    let root as ptr[Node] = lr.lower_source()
    
    let s as ptr[Sema] = make[Sema](1 to usize) to ptr[Sema]
    s.init_sema("test_nll1.nz" to cstr)
    s.declare_pass(root)
    s.resolve_pass(root)
    
    let tc as ptr[TypeChecker] = make[TypeChecker](1 to usize) to ptr[TypeChecker]
    tc.init_tc(s)
    tc.typecheck_node(root)
    
    let bc as ptr[BorrowChecker] = make[BorrowChecker](1 to usize) to ptr[BorrowChecker]
    bc.init_bc()
    (deref bc).sema = s
    (deref bc).current_file = String.make("test_nll1.nz" to cstr)
    bc.walk_ast(root)
    
    let errs1 as ptr[List[String]] = ref (deref bc).errors
    if (deref errs1).length() == 0 to i64:
        printf("  [PASS] NLL Early Release (assign after last use permitted)\n" to cstr)
        return True
    else:
        printf("  [FAIL] NLL Early Release reported false positive error!\n" to cstr)
        return False

// ── Test 2: Move While Borrowed Rejection ────────────────────────────────
fn test_move_while_borrowed() as bool:
    let src as cstr = "fn test_mv():\n    var x as String = String()\n    let r as life[a] String = ref x\n    let y as String = x\n    let v as String = deref r\n" to cstr
    let lr as ptr[Lowerer] = make_lowerer_mantiq_from_cstr(src, "test_nll2.nz" to cstr)
    let root as ptr[Node] = lr.lower_source()
    
    let s as ptr[Sema] = make[Sema](1 to usize) to ptr[Sema]
    s.init_sema("test_nll2.nz" to cstr)
    s.declare_pass(root)
    s.resolve_pass(root)
    
    let bc as ptr[BorrowChecker] = make[BorrowChecker](1 to usize) to ptr[BorrowChecker]
    bc.init_bc()
    (deref bc).sema = s
    (deref bc).current_file = String.make("test_nll2.nz" to cstr)
    bc.walk_ast(root)
    
    let errs2 as ptr[List[String]] = ref (deref bc).errors
    if (deref errs2).length() > 0 to i64:
        printf("  [PASS] Move While Borrowed correctly rejected (E0403)\n" to cstr)
        return True
    else:
        printf("  [FAIL] Move While Borrowed was NOT detected!\n" to cstr)
        return False

