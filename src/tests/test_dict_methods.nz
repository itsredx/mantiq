// ── Test Dict Methods Parity ──────────────────────────────────────────

import std.collections
from std.collections import Dict, List, Tuple2
import std.string
from std.string import String

fn main() as i32:
    print("[TEST SUITE] Native Dict Methods Parity (keys, values, copy, update, setdefault, pop, clear)")

    // ── Test 1: Keys & Values ──────────────────────────────────────────
    var d as Dict[String, i32] = {}
    d["apple"] = 10
    d["banana"] = 20
    d["cherry"] = 30

    if d.len() != 3 to usize:
        print("  FAIL: Initial dict length expected 3")
        return 1

    let ks as List[String] = d.keys()
    if ks.len() != 3 to usize:
        print("  FAIL: d.keys().len() expected 3")
        return 1

    let vs as List[i32] = d.values()
    if vs.len() != 3 to usize:
        print("  FAIL: d.values().len() expected 3")
        return 1

    var sum_v as i32 = 0
    var vi as i64 = 0 to i64
    let v_cnt as i64 = vs.len() to i64
    while vi < v_cnt:
        sum_v = sum_v + vs[vi]
        vi = vi + 1 to i64
    if sum_v != 60:
        print("  FAIL: d.values() sum expected 60")
        return 1
    print("  PASS: keys() and values()")

    // ── Test 2: Copy Semantics ─────────────────────────────────────────
    var d_copy as Dict[String, i32] = d.copy()
    if d_copy.len() != 3 to usize:
        print("  FAIL: d.copy().len() expected 3")
        return 1

    d_copy["date"] = 40
    if d_copy.len() != 4 to usize:
        print("  FAIL: d_copy length after addition expected 4")
        return 1
    if d.len() != 3 to usize:
        print("  FAIL: original dict mutated after copy mutation")
        return 1
    print("  PASS: copy()")

    // ── Test 3: Setdefault ─────────────────────────────────────────────
    let ex as i32 = d.setdefault("apple", 999)
    if ex != 10:
        print("  FAIL: setdefault on existing key expected 10")
        return 1

    let nw as i32 = d.setdefault("elderberry", 50)
    if nw != 50:
        print("  FAIL: setdefault on missing key expected 50")
        return 1
    if d.len() != 4 to usize:
        print("  FAIL: d.len() after setdefault expected 4")
        return 1
    if d["elderberry"] != 50:
        print("  FAIL: d['elderberry'] expected 50")
        return 1
    print("  PASS: setdefault()")

    // ── Test 4: Pop with & without Default ──────────────────────────────
    let p1 as i32 = d.pop("banana", 0)
    if p1 != 20:
        print("  FAIL: pop existing key expected 20")
        return 1
    if d.has("banana"):
        print("  FAIL: pop did not remove banana")
        return 1
    if d.len() != 3 to usize:
        print("  FAIL: d.len() after pop expected 3")
        return 1

    let p_missing as i32 = d.pop("nonexistent", 99)
    if p_missing != 99:
        print("  FAIL: pop missing key expected default 99")
        return 1
    print("  PASS: pop()")

    // ── Test 5: Update / Merge ─────────────────────────────────────────
    var other as Dict[String, i32] = {}
    other["fig"] = 60
    other["grape"] = 70
    other["apple"] = 100

    d.update(other)
    if d["apple"] != 100:
        print("  FAIL: update overwritten key expected 100")
        return 1
    if d["fig"] != 60 or d["grape"] != 70:
        print("  FAIL: update new keys missing")
        return 1
    if d.len() != 5 to usize:
        print("  FAIL: d.len() after update expected 5")
        return 1
    print("  PASS: update()")

    // ── Test 6: Clear ──────────────────────────────────────────────────
    d.clear()
    if d.len() != 0 to usize:
        print("  FAIL: d.len() after clear expected 0")
        return 1
    print("  PASS: clear()")

    // ── Test 7: Fromkeys ───────────────────────────────────────────────
    var keys_list as List[String] = List[String]()
    keys_list.append(String.make("alpha" to cstr))
    keys_list.append(String.make("beta" to cstr))
    keys_list.append(String.make("gamma" to cstr))

    var d_proto as Dict[String, i32] = {}
    var d_fk as Dict[String, i32] = d_proto.fromkeys(keys_list, 42)
    if d_fk.len() != 3 to usize:
        print("  FAIL: d.fromkeys().len() expected 3")
        return 1
    if d_fk["alpha"] != 42 or d_fk["beta"] != 42 or d_fk["gamma"] != 42:
        print("  FAIL: d.fromkeys() values expected 42")
        return 1
    print("  PASS: fromkeys()")

    // ── Test 8: Items View & Mapping ───────────────────────────────────
    let items_view = d_fk.items()
    if items_view.len() != 3 to usize:
        print("  FAIL: items_view.len() expected 3")
        return 1
    if items_view.length() != 3 to usize:
        print("  FAIL: items_view.length() expected 3")
        return 1
    let m_dict as Dict[String, i32] = items_view.mapping()
    if m_dict.len() != 3 to usize or m_dict["beta"] != 42:
        print("  FAIL: items_view.mapping() expected underlying dict")
        return 1
    let iv_keys as List[String] = items_view.keys()
    if iv_keys.len() != 3 to usize:
        print("  FAIL: items_view.keys().len() expected 3")
        return 1
    let iv_vals as List[i32] = items_view.values()
    if iv_vals.len() != 3 to usize:
        print("  FAIL: items_view.values().len() expected 3")
        return 1
    let iv_list as List[Tuple2[String, i32]] = items_view.to_list()
    if iv_list.len() != 3 to usize:
        print("  FAIL: items_view.to_list().len() expected 3")
        return 1
    print("  PASS: items() and mapping()")

    // ── Test 9: Popitem ────────────────────────────────────────────────
    var pk as String = ""
    var pv as i32 = 0
    let popped as bool = d_fk.popitem(ref pk, ref pv)
    if not popped:
        print("  FAIL: popitem expected true")
        return 1
    if pv != 42:
        print("  FAIL: popitem expected popped value 42")
        return 1
    if d_fk.len() != 2 to usize:
        print("  FAIL: d_fk.len() after popitem expected 2")
        return 1
    if d_fk.has(pk):
        print("  FAIL: popped key still in dict")
        return 1

    var pk2 as String = ""
    var pv2 as i32 = 0
    let popped2 as bool = d_fk.popitem(ref pk2, ref pv2)
    let popped3 as bool = d_fk.popitem(ref pk2, ref pv2)
    if not popped2 or not popped3:
        print("  FAIL: popitem on remaining items expected true")
        return 1
    if d_fk.len() != 0 to usize:
        print("  FAIL: dict should be empty after popping all")
        return 1
    let pop_empty as bool = d_fk.popitem(ref pk2, ref pv2)
    if pop_empty:
        print("  FAIL: popitem on empty dict expected false")
        return 1
    print("  PASS: popitem()")

    print("ALL DICT METHOD TESTS PASSED")
    return 0
