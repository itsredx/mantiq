    public fn lower_struct_decl(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        extern fn memset(s as ptr, c as i32, n as usize) as ptr
        let span as Span = self.get_span(ts_node)
        var name as String = String.make("" to cstr)
        var access_mod as String = String.make("public" to cstr)
        let body_stmts as List[ptr[Node]] = List[ptr[Node]]()

        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                let c_kind as cstr = ts_node_type_ptr(ref child)
                if strcmp(c_kind, "access_modifier" to cstr) == 0:
                    let a_str as ptr[String] = self.slice_string_from_node(ref child)
                    access_mod = deref a_str
                    drop(a_str to ptr)
                elif strcmp(c_kind, "identifier" to cstr) == 0 or strcmp(c_kind, "type_identifier" to cstr) == 0:
                    if name.len == 0 to usize:
                        let slice_ptr as ptr[String] = self.slice_string_from_node(ref child)
                        name = deref slice_ptr
                        drop(slice_ptr to ptr)
                elif strcmp(c_kind, "block_body" to cstr) == 0 or strcmp(c_kind, "block" to cstr) == 0:
                    let b_count as u32 = ts_node_child_count_ptr(ref child)
                    var b as u32 = 0 to u32
                    while b < b_count:
                        var b_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                        ts_node_child_ptr(ref child, b, ref b_child)
                        if ts_node_is_named_ptr(ref b_child):
                            let b_type as cstr = ts_node_type_ptr(ref b_child)
                            if strcmp(b_type, "var_decl" to cstr) == 0 or strcmp(b_type, "field_decl" to cstr) == 0 or strcmp(b_type, "fun_decl" to cstr) == 0 or strcmp(b_type, "named_function" to cstr) == 0:
                                let lowered as ptr[Node] = self.lower_node(ref b_child)
                                if lowered != None to ptr[Node]:
                                    body_stmts.append(lowered)
                        b = b + 1 to u32
            i = i + 1 to u32

        // Build a BlockStmt for the body
        let body_node as ptr[Node] = make_node(NodeType.BlockStmt, span)
        let body_data as ptr[BlockStmtData] = make[BlockStmtData](1 to usize) to ptr[BlockStmtData]
        (deref body_data).declarations = body_stmts
        (deref body_data).auto_drops = List[String]()
        (deref body_node).data = body_data to ptr[u8]

        let n as ptr[Node] = make_node(NodeType.StructDecl, span)
        let data as ptr[StructDeclData] = make[StructDeclData](1 to usize) to ptr[StructDeclData]
        (deref data).name = name
        (deref data).body = body_node
        (deref data).access_modifier = access_mod
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_enum_variant(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var name as String = String.make("" to cstr)
        let params as List[ptr[Node]] = List[ptr[Node]]()

        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                let c_kind as cstr = ts_node_type_ptr(ref child)
                if strcmp(c_kind, "identifier" to cstr) == 0:
                    if name.len == 0 to usize:
                        let slice_ptr as ptr[String] = self.slice_string_from_node(ref child)
                        name = deref slice_ptr
                        drop(slice_ptr to ptr)
                elif strcmp(c_kind, "typed_params" to cstr) == 0:
                    let tp_count as u32 = ts_node_child_count_ptr(ref child)
                    var j as u32 = 0 to u32
                    while j < tp_count:
                        var tp_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                        ts_node_child_ptr(ref child, j, ref tp_child)
                        if ts_node_is_named_ptr(ref tp_child):
                            let tp_kind as cstr = ts_node_type_ptr(ref tp_child)
                            if strcmp(tp_kind, "param_decl" to cstr) == 0 or strcmp(tp_kind, "typed_var" to cstr) == 0 or strcmp(tp_kind, "param" to cstr) == 0 or strcmp(tp_kind, "typed_param" to cstr) == 0:
                                let pd_count as u32 = ts_node_child_count_ptr(ref tp_child)
                                var annot as ptr[TypeAnnotation] = None to ptr[TypeAnnotation]
                                var annot_idx as u32 = 0 to u32
                                while annot_idx < pd_count:
                                    var pd_child_annot as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                                    ts_node_child_ptr(ref tp_child, annot_idx, ref pd_child_annot)
                                    if ts_node_is_named_ptr(ref pd_child_annot):
                                        let pd_kind as cstr = ts_node_type_ptr(ref pd_child_annot)
                                        if strcmp(pd_kind, "type_annotation" to cstr) == 0:
                                            annot = self.lower_type_annotation(ref pd_child_annot)
                                    annot_idx = annot_idx + 1 to u32
                                
                                var k as u32 = 0 to u32
                                while k < pd_count:
                                    var pd_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                                    ts_node_child_ptr(ref tp_child, k, ref pd_child)
                                    if ts_node_is_named_ptr(ref pd_child):
                                        let pd_kind as cstr = ts_node_type_ptr(ref pd_child)
                                        if strcmp(pd_kind, "identifier" to cstr) == 0:
                                            let p_slice as ptr[String] = self.slice_string_from_node(ref pd_child)
                                            let p_node as ptr[Node] = make_node(NodeType.VarDecl, self.get_span(ref pd_child))
                                            let p_data as ptr[VarDeclData] = make[VarDeclData](1 to usize) to ptr[VarDeclData]
                                            (deref p_data).name = deref p_slice
                                            (deref p_data).left = None to ptr[Node]
                                            (deref p_data).is_mut = False

                                            let p_wrapper as ptr[TypeAnnotListWrapper] = make[TypeAnnotListWrapper](1 to usize) to ptr[TypeAnnotListWrapper]
                                            (deref p_wrapper).list = List[Option[ptr[TypeAnnotation]]]()
                                            if annot != None to ptr[TypeAnnotation]:
                                                (deref p_wrapper).list.append(Some(annot))
                                            else:
                                                (deref p_wrapper).list.append(Empty)
                                            let p_annots_list_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = ref (deref p_wrapper).list
                                            (deref p_data).type_annots = p_annots_list_ptr
                                            (deref p_node).data = p_data to ptr[u8]

                                            params.append(p_node)
                                            drop(p_slice to ptr)
                                    k = k + 1 to u32
                        j = j + 1 to u32
            i = i + 1 to u32

        if params.length() > 0 to i64:
            let fn_node as ptr[Node] = make_node(NodeType.FunDecl, span)
            let fn_data as ptr[FunDeclData] = make[FunDeclData](1 to usize) to ptr[FunDeclData]
            (deref fn_data).name = name
            (deref fn_data).params = params
            (deref fn_data).body = None to ptr[Node]
            (deref fn_data).is_extern = False
            (deref fn_data).is_variadic = False
            (deref fn_data).return_type_annot = None to ptr[TypeAnnotation]
            (deref fn_node).data = fn_data to ptr[u8]
            return fn_node
        else:
            let id_node as ptr[Node] = make_node(NodeType.Identifier, span)
            let id_data as ptr[IdentifierData] = make[IdentifierData](1 to usize) to ptr[IdentifierData]
            (deref id_data).name = name
            (deref id_node).data = id_data to ptr[u8]
            return id_node

    public fn lower_type_decl(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var name as String = String.make("" to cstr)
        var annot as ptr[TypeAnnotation] = None to ptr[TypeAnnotation]

        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                let c_kind as cstr = ts_node_type_ptr(ref child)
                if (strcmp(c_kind, "identifier" to cstr) == 0 or strcmp(c_kind, "type_identifier" to cstr) == 0) and name.len == 0 to usize:
                    let slice_ptr as ptr[String] = self.slice_string_from_node(ref child)
                    name = deref slice_ptr
                    drop(slice_ptr to ptr)
                elif strcmp(c_kind, "type_annotation" to cstr) == 0:
                    annot = self.lower_type_annotation(ref child)
                elif strcmp(c_kind, "type_identifier" to cstr) == 0 or strcmp(c_kind, "primitive_type" to cstr) == 0 or strcmp(c_kind, "pointer_type" to cstr) == 0 or strcmp(c_kind, "generic_type" to cstr) == 0 or strcmp(c_kind, "identifier" to cstr) == 0:
                    let t_slice as ptr[String] = self.slice_string_from_node(ref child)
                    annot = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
                    (deref annot).name = deref t_slice
                    (deref annot).is_ref = False
                    (deref annot).is_mut = False
                    (deref annot).lifetime = Empty
                    (deref annot).generics = Empty
                    (deref annot).params = Empty
                    (deref annot).return_type = None to ptr[TypeAnnotation]
                    drop(t_slice to ptr)
            i = i + 1 to u32

        let n as ptr[Node] = make_node(NodeType.FieldDecl, span)
        let data as ptr[FieldDeclData] = make[FieldDeclData](1 to usize) to ptr[FieldDeclData]
        (deref data).name = name
        let wrapper as ptr[TypeAnnotListWrapper] = make[TypeAnnotListWrapper](1 to usize) to ptr[TypeAnnotListWrapper]
        (deref wrapper).list = List[Option[ptr[TypeAnnotation]]]()
        if annot != None to ptr[TypeAnnotation]:
            (deref wrapper).list.append(Some(annot))
        else:
            (deref wrapper).list.append(Empty)
        (deref data).type_annots = ref (deref wrapper).list
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_enum_decl(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var name as String = String.make("" to cstr)
        let declarations as List[ptr[Node]] = List[ptr[Node]]()

        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                let c_kind as cstr = ts_node_type_ptr(ref child)
                if strcmp(c_kind, "identifier" to cstr) == 0 or strcmp(c_kind, "type_identifier" to cstr) == 0:
                    if name.len == 0 to usize:
                        let slice_ptr as ptr[String] = self.slice_string_from_node(ref child)
                        name = deref slice_ptr
                        drop(slice_ptr to ptr)
                elif strcmp(c_kind, "enum_body" to cstr) == 0:
                    let eb_count as u32 = ts_node_child_count_ptr(ref child)
                    var eb_i as u32 = 0 to u32
                    while eb_i < eb_count:
                        var eb_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                        ts_node_child_ptr(ref child, eb_i, ref eb_child)
                        if ts_node_is_named_ptr(ref eb_child):
                            let eb_kind as cstr = ts_node_type_ptr(ref eb_child)
                            if strcmp(eb_kind, "enum_variant" to cstr) == 0:
                                let v_lowered as ptr[Node] = self.lower_enum_variant(ref eb_child)
                                if v_lowered != None to ptr[Node]:
                                    declarations.append(v_lowered)
                            elif strcmp(eb_kind, "fun_decl" to cstr) == 0 or strcmp(eb_kind, "named_function" to cstr) == 0 or strcmp(eb_kind, "function_definition" to cstr) == 0:
                                let fn_lowered as ptr[Node] = self.lower_fun_decl(ref eb_child)
                                if fn_lowered != None to ptr[Node]:
                                    declarations.append(fn_lowered)
                        eb_i = eb_i + 1 to u32
                elif strcmp(c_kind, "enum_variant" to cstr) == 0:
                    let v_lowered as ptr[Node] = self.lower_enum_variant(ref child)
                    if v_lowered != None to ptr[Node]:
                        declarations.append(v_lowered)
                elif strcmp(c_kind, "fun_decl" to cstr) == 0 or strcmp(c_kind, "named_function" to cstr) == 0 or strcmp(c_kind, "function_definition" to cstr) == 0:
                    let fn_lowered as ptr[Node] = self.lower_fun_decl(ref child)
                    if fn_lowered != None to ptr[Node]:
                        declarations.append(fn_lowered)
            i = i + 1 to u32

        let n as ptr[Node] = make_node(NodeType.EnumDecl, span)
        let data as ptr[EnumDeclData] = make[EnumDeclData](1 to usize) to ptr[EnumDeclData]
        (deref data).name = name
        (deref data).declarations = declarations
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_union_decl(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        extern fn memset(s as ptr, c as i32, n as usize) as ptr
        let span as Span = self.get_span(ts_node)
        var name as String = String.make("" to cstr)
        let body_stmts as List[ptr[Node]] = List[ptr[Node]]()

        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                let c_kind as cstr = ts_node_type_ptr(ref child)
                if strcmp(c_kind, "identifier" to cstr) == 0 or strcmp(c_kind, "type_identifier" to cstr) == 0:
                    if name.len == 0 to usize:
                        let slice_ptr as ptr[String] = self.slice_string_from_node(ref child)
                        name = deref slice_ptr
                        drop(slice_ptr to ptr)
                elif strcmp(c_kind, "block_body" to cstr) == 0 or strcmp(c_kind, "block" to cstr) == 0:
                    let b_count as u32 = ts_node_child_count_ptr(ref child)
                    var b as u32 = 0 to u32
                    while b < b_count:
                        var b_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                        ts_node_child_ptr(ref child, b, ref b_child)
                        if ts_node_is_named_ptr(ref b_child):
                            let b_type as cstr = ts_node_type_ptr(ref b_child)
                            if strcmp(b_type, "var_decl" to cstr) == 0 or strcmp(b_type, "fun_decl" to cstr) == 0 or strcmp(b_type, "named_function" to cstr) == 0:
                                let lowered as ptr[Node] = self.lower_node(ref b_child)
                                if lowered != None to ptr[Node]:
                                    body_stmts.append(lowered)
                        b = b + 1 to u32
            i = i + 1 to u32

        let body_node as ptr[Node] = make_node(NodeType.BlockStmt, span)
        let body_data as ptr[BlockStmtData] = make[BlockStmtData](1 to usize) to ptr[BlockStmtData]
        (deref body_data).declarations = body_stmts
        (deref body_data).auto_drops = List[String]()
        (deref body_node).data = body_data to ptr[u8]

        let n as ptr[Node] = make_node(NodeType.UnionDecl, span)
        let data as ptr[UnionDeclData] = make[UnionDeclData](1 to usize) to ptr[UnionDeclData]
        (deref data).name = name
        (deref data).body = body_node
        (deref n).data = data to ptr[u8]
        return n

fn make_lowerer_from_cstr(source as cstr, path as cstr) as ptr[Lowerer]:
    let low as ptr[Lowerer] = make[Lowerer](1 to usize) to ptr[Lowerer]
    low.init_lowerer(source, LanguageMode.Nizam, path)
    return low

fn make_lowerer_mantiq_from_cstr(source as cstr, path as cstr) as ptr[Lowerer]:
    let low as ptr[Lowerer] = make[Lowerer](1 to usize) to ptr[Lowerer]
    low.init_lowerer(source, LanguageMode.Mantiq, path)
    return low

// ── AST Origin Tagging ───────────────────────────────────────────────────
fn tag_node_file_path(node as ptr[Node], file_path as cstr):
    if node == None to ptr[Node] or file_path == None to cstr:
        return
    set_node_file_path(node, file_path)
    
    let k as NodeType = node_kind(node)
    if k == NodeType.Program or k == NodeType.BlockStmt or k == NodeType.EnumDecl or k == NodeType.ListLiteral or k == NodeType.DictLiteral:
        let decls_p as ptr[List[ptr[Node]]] = node_declarations_ptr(node)
        if decls_p != None to ptr[List[ptr[Node]]]:
            let count as i64 = (deref decls_p).length()
            var i as i64 = 0 to i64
            while i < count:
                tag_node_file_path((deref decls_p)[i], file_path)
                i = i + 1 to i64
    elif k == NodeType.FunDecl or k == NodeType.MacroDecl or k == NodeType.MacroInvocation or k == NodeType.ClosureExpr or k == NodeType.ParamBlockStmt:
        let params_p as ptr[List[ptr[Node]]] = node_params_ptr(node)
        if params_p != None to ptr[List[ptr[Node]]]:
            let p_count as i64 = (deref params_p).length()
            var pi as i64 = 0 to i64
            while pi < p_count:
                tag_node_file_path((deref params_p)[pi], file_path)
                pi = pi + 1 to i64
        tag_node_file_path(node_body(node), file_path)
    elif k == NodeType.CallExpr:
        tag_node_file_path(node_left(node), file_path)
        let args_p as ptr[List[ptr[Node]]] = node_params_ptr(node)
        if args_p != None to ptr[List[ptr[Node]]]:
            let a_cnt as i64 = (deref args_p).length()
            var ai as i64 = 0 to i64
            while ai < a_cnt:
                tag_node_file_path((deref args_p)[ai], file_path)
                ai = ai + 1 to i64
    elif k == NodeType.BinaryExpr or k == NodeType.IndexExpr:
        tag_node_file_path(node_left(node), file_path)
        tag_node_file_path(node_right(node), file_path)
    elif k == NodeType.IfStmt:
        tag_node_file_path(node_cond(node), file_path)
        tag_node_file_path(node_then_branch(node), file_path)
        let else_opt_raw as Option[ptr[Node]] = node_else_branch(node)
        let else_opt_ref as ptr[OptionLayout] = (ref else_opt_raw) to ptr[OptionLayout]
        if (deref else_opt_ref).has_val == 1 to u8 and (deref else_opt_ref).val_ptr != None to ptr[u8]:
            let else_ptr as ptr[Node] = (deref else_opt_ref).val_ptr to ptr[Node]
            tag_node_file_path(else_ptr, file_path)
    elif k == NodeType.WhileStmt:
        tag_node_file_path(node_cond(node), file_path)
        tag_node_file_path(node_body(node), file_path)
    elif k == NodeType.ForStmt:
        tag_node_file_path(node_left(node), file_path)
        tag_node_file_path(node_body(node), file_path)
    elif k == NodeType.StructDecl or k == NodeType.UnionDecl or k == NodeType.WithStmt or k == NodeType.TryStmt or k == NodeType.MatchStmt:
        tag_node_file_path(node_left(node), file_path)
        tag_node_file_path(node_body(node), file_path)
    elif k == NodeType.VarDecl or k == NodeType.ReturnStmt or k == NodeType.UnaryExpr or k == NodeType.CastExpr or k == NodeType.MemberExpr or k == NodeType.SpreadExpr or k == NodeType.AwaitExpr or k == NodeType.SpawnStmt:
        tag_node_file_path(node_left(node), file_path)
        tag_node_file_path(node_body(node), file_path)
