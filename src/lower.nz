// ── String Slice Helper ──────────────────────────────────────────────────
fn slice_string(s_data as ptr[u8], s_len as usize, start as usize, end as usize) as ptr:
    if end <= start or start >= s_len:
        let d as ptr[u8] = make[u8](1 to usize) to ptr[u8]
        d[0] = 0 to u8
        let res as ptr[String] = make[String](1 to usize) to ptr[String]
        (deref res) = String(data = d, len = 0 to usize, capacity = 1 to usize)
        return res to ptr
    let len as usize = end - start
    let cap as usize = len + 1
    let d as ptr[u8] = make[u8](cap) to ptr[u8]
    var i as usize = 0 to usize
    while i < len:
        d[i] = s_data[start + i]
        i = i + 1 to usize
    d[len] = 0 to u8
    let res as ptr[String] = make[String](1 to usize) to ptr[String]
    (deref res) = String(data = d, len = len, capacity = cap)
    return res to ptr

fn strip_quotes(d as ptr[u8], len as usize) as String:
    if len >= 2 to usize:
        let c0 as u8 = deref d
        let c1 as u8 = deref ((d to usize + len - 1 to usize) to ptr[u8])
        if (c0 == 34 to u8 and c1 == 34 to u8) or (c0 == 39 to u8 and c1 == 39 to u8):
            let inner as ptr[String] = slice_string(d, len, 1 to usize, len - 1 to usize) to ptr[String]
            let res as String = deref inner
            drop(inner to ptr)
            return res
    let slice_all as ptr[String] = slice_string(d, len, 0 to usize, len) to ptr[String]
    let res_all as String = deref slice_all
    drop(slice_all to ptr)
    return res_all

fn hex_digit_to_val(c as u8) as u32:
    if c >= 48 to u8 and c <= 57 to u8:
        return (c - 48 to u8) to u32
    if c >= 97 to u8 and c <= 102 to u8:
        return ((c - 97 to u8) + 10 to u8) to u32
    if c >= 65 to u8 and c <= 70 to u8:
        return ((c - 65 to u8) + 10 to u8) to u32
    return 0 to u32

// ── Option Layout Helpers ────────────────────────────────────────────────
fn option_has_value(opt as ptr[OptionLayout]) as bool:
    if opt == None to ptr[OptionLayout]:
        return False
    return (deref opt).has_val == 1 to u8

fn option_unwrap_ptr(opt as ptr[OptionLayout]) as ptr[u8]:
    if opt == None to ptr[OptionLayout]:
        return None to ptr[u8]
    return (deref opt).val_ptr

// ── Macro Definition Storage ─────────────────────────────────────────────
struct MacroDef:
    public var param_names as List[String]
    public var body_ast as ptr[Node]

struct TypeAnnotListWrapper:
    public var list as List[Option[ptr[TypeAnnotation]]]

// ── AST Lowerer State ───────────────────────────────────────────────────
struct Lowerer:
    public var source_code as String
    public var mode as LanguageMode
    public var file_path as String
    public var macros as Dict[String, MacroDef]
    public var macro_args as Dict[String, ptr[Node]]
    public var next_hygiene_id as i64

    public fn init_lowerer(self as ptr[Lowerer], source as cstr, mode as LanguageMode, path as cstr):
        (deref self).source_code = String.make(source)
        (deref self).mode = mode
        (deref self).file_path = String.make(path)
        (deref self).macros = Dict[String, MacroDef]()
        (deref self).macro_args = Dict[String, ptr[Node]]()
        (deref self).next_hygiene_id = 1 to i64

    public fn lower_source(self as ptr[Lowerer]) as ptr[Node]:
        let parser as ptr = ts_parser_new()
        let language as ptr = tree_sitter_mantiq()
        let ok as bool = ts_parser_set_language(parser, language)
        if not ok:
            ts_parser_delete(parser)
            return None to ptr[Node]
        
        let tree as ptr = ts_parser_parse_string(parser, None to ptr, (deref self).source_code.data, (deref self).source_code.len to u32)
        if tree == None:
            ts_parser_delete(parser)
            return None to ptr[Node]
            
        var root_ts as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        ts_tree_root_node_ptr(tree, ref root_ts)
        
        let root_ast as ptr[Node] = self.lower_node(ref root_ts)
        ts_parser_delete(parser)
        if root_ast != None to ptr[Node]:
            tag_node_file_path(root_ast, (deref self).file_path.data to cstr)
        return root_ast

    public fn slice_string_from_node(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[String]:
        let start as usize = ts_node_start_byte_ptr(ts_node) to usize
        let end as usize = ts_node_end_byte_ptr(ts_node) to usize
        return slice_string((deref self).source_code.data, (deref self).source_code.len, start, end) to ptr[String]

    public fn lower_type_annotation(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[TypeAnnotation]:
        let annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
        (deref annot).lifetime = Empty
        (deref annot).generics = Empty
        (deref annot).params = Empty
        (deref annot).return_type = None to ptr[TypeAnnotation]
        
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var first_name_start as usize = 0 to usize
        var last_name_end as usize = 0 to usize
        var idx as u32 = 0 to u32
        while idx < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, idx, ref child)
            let child_kind as cstr = ts_node_type_ptr(ref child)
            if strcmp(child_kind, "ref" to cstr) == 0:
                (deref annot).is_ref = True
            elif strcmp(child_kind, "mut" to cstr) == 0:
                (deref annot).is_mut = True
            elif strcmp(child_kind, "life" to cstr) == 0:
                (deref annot).is_ref = True
                let l_cnt as u32 = ts_node_child_count_ptr(ref child)
                var li as u32 = 0 to u32
                while li < l_cnt:
                    var l_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                    ts_node_child_ptr(ref child, li, ref l_child)
                    let l_kind as cstr = ts_node_type_ptr(ref l_child)
                    if strcmp(l_kind, "lifetime_args" to cstr) == 0 or strcmp(l_kind, "identifier" to cstr) == 0 or strcmp(l_kind, "expression" to cstr) == 0:
                        let lt_slice as ptr[String] = self.slice_string_from_node(ref l_child)
                        (deref annot).lifetime = Some(deref lt_slice)
                        drop(lt_slice to ptr)
                    li = li + 1 to u32
            elif strcmp(child_kind, "expression" to cstr) == 0 or strcmp(child_kind, "lifetime_args" to cstr) == 0:
                if (deref annot).is_ref and first_name_start == 0 to usize:
                    let lt_slice as ptr[String] = self.slice_string_from_node(ref child)
                    (deref annot).lifetime = Some(deref lt_slice)
                    drop(lt_slice to ptr)
            elif strcmp(child_kind, "identifier" to cstr) == 0:
                if first_name_start == 0 to usize:
                    first_name_start = ts_node_start_byte_ptr(ref child) to usize
                last_name_end = ts_node_end_byte_ptr(ref child) to usize
                let name_slice as ptr[String] = self.slice_string_from_node(ref child)
                (deref annot).name = deref name_slice
                drop(name_slice to ptr)
            elif strcmp(child_kind, "generic_params" to cstr) == 0:
                last_name_end = ts_node_end_byte_ptr(ref child) to usize
            idx = idx + 1 to u32
        
        if first_name_start > 0 to usize:
            let type_end as usize = ts_node_end_byte_ptr(ts_node) to usize
            var end_pos as usize = type_end
            while end_pos > first_name_start and (deref (((deref self).source_code.data to usize + end_pos - 1 to usize) to ptr[u8])) <= 32 to u8:
                end_pos = end_pos - 1 to usize
            if end_pos > first_name_start:
                let full_slice as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, first_name_start, end_pos) to ptr[String]
                (deref annot).name = deref full_slice
                drop(full_slice to ptr)
        
        return annot

    public fn get_span(self as ptr[Lowerer], ts_node as ptr[TSNode]) as Span:
        return Span(start_byte = ts_node_start_byte_ptr(ts_node), end_byte = ts_node_end_byte_ptr(ts_node), start_row = ts_node_start_row_ptr(ts_node), start_col = ts_node_start_col_ptr(ts_node), end_row = ts_node_end_row_ptr(ts_node), end_col = ts_node_end_col_ptr(ts_node))

    public fn lower_node(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let kind as cstr = ts_node_type_ptr(ts_node)
        if strcmp(kind, "program" to cstr) == 0:
            return self.lower_program(ts_node)
        elif strcmp(kind, "identifier" to cstr) == 0 or strcmp(kind, "type_identifier" to cstr) == 0 or strcmp(kind, "primitive_type" to cstr) == 0:
            return self.lower_identifier(ts_node)
        elif strcmp(kind, "number" to cstr) == 0:
            return self.lower_number(ts_node)
        elif strcmp(kind, "string" to cstr) == 0:
            return self.lower_string(ts_node)
        elif strcmp(kind, "color_literal" to cstr) == 0:
            return self.lower_color_literal(ts_node)
        elif strcmp(kind, "binary_expression" to cstr) == 0:
            return self.lower_binary(ts_node)
        elif strcmp(kind, "super" to cstr) == 0:
            let n as ptr[Node] = make_node(NodeType.Identifier, self.get_span(ts_node))
            let data as ptr[IdentifierData] = make[IdentifierData](1 to usize) to ptr[IdentifierData]
            (deref data).name = String.make("super" to cstr)
            (deref n).data = data to ptr[u8]
            return n
        elif strcmp(kind, "primary" to cstr) == 0:
            let slice_ptr as ptr[String] = self.slice_string_from_node(ts_node)
            let s_text as String = deref slice_ptr
            drop(slice_ptr to ptr)
            if s_text.len >= 5 to usize and strncmp(s_text.data to cstr, "super" to cstr, 5 to usize) == 0:
                let n as ptr[Node] = make_node(NodeType.Identifier, self.get_span(ts_node))
                let data as ptr[IdentifierData] = make[IdentifierData](1 to usize) to ptr[IdentifierData]
                (deref data).name = String.make("super" to cstr)
                (deref n).data = data to ptr[u8]
                return n
            let count as u32 = ts_node_child_count_ptr(ts_node)
            var i as u32 = 0 to u32
            while i < count:
                var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                ts_node_child_ptr(ts_node, i, ref child)
                if ts_node_is_named_ptr(ref child):
                    return self.lower_node(ref child)
                i = i + 1 to u32
            return None to ptr[Node]
        elif strcmp(kind, "collection_item" to cstr) == 0:
            return self.lower_collection_item(ts_node)
        elif strcmp(kind, "expression" to cstr) == 0 or strcmp(kind, "statement" to cstr) == 0 or strcmp(kind, "expr_stmt" to cstr) == 0 or strcmp(kind, "parenthesized_expression" to cstr) == 0 or strcmp(kind, "expression_statement" to cstr) == 0:
            let count as u32 = ts_node_child_count_ptr(ts_node)
            var i as u32 = 0 to u32
            while i < count:
                var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                ts_node_child_ptr(ts_node, i, ref child)
                if ts_node_is_named_ptr(ref child):
                    return self.lower_node(ref child)
                i = i + 1 to u32
            return None to ptr[Node]
        elif strcmp(kind, "var_decl" to cstr) == 0:
            return self.lower_var_decl(ts_node)
        elif strcmp(kind, "macro_decl" to cstr) == 0:
            return self.lower_macro_decl(ts_node)
        elif strcmp(kind, "macro_invocation" to cstr) == 0:
            return self.lower_macro_invocation(ts_node)
        elif strcmp(kind, "block_body" to cstr) == 0 or strcmp(kind, "block" to cstr) == 0 or strcmp(kind, "unsafe_block" to cstr) == 0 or strcmp(kind, "block_stmt" to cstr) == 0:
            return self.lower_block(ts_node)
        elif strcmp(kind, "fun_decl" to cstr) == 0:
            return self.lower_fun_decl(ts_node)
        elif strcmp(kind, "named_function" to cstr) == 0:
            return self.lower_fun_decl(ts_node)
        elif strcmp(kind, "function_definition" to cstr) == 0:
            return self.lower_fun_decl(ts_node)
        elif strcmp(kind, "import_decl" to cstr) == 0 or strcmp(kind, "import_stmt" to cstr) == 0:
            return self.lower_import(ts_node)
        elif strcmp(kind, "link_decl" to cstr) == 0:
            return self.lower_import(ts_node)
        elif strcmp(kind, "call_expression" to cstr) == 0:
            return self.lower_call_expr(ts_node)
        elif strcmp(kind, "jump_stmt" to cstr) == 0 or strcmp(kind, "raise_statement" to cstr) == 0 or strcmp(kind, "throw_stmt" to cstr) == 0:
            return self.lower_jump_stmt(ts_node)
        elif strcmp(kind, "while_stmt" to cstr) == 0:
            return self.lower_while_stmt(ts_node)
        elif strcmp(kind, "for_stmt" to cstr) == 0:
            return self.lower_for_stmt(ts_node)
        elif strcmp(kind, "member_expression" to cstr) == 0:
            return self.lower_member_expr(ts_node)
        elif strcmp(kind, "with_stmt" to cstr) == 0 or strcmp(kind, "with_statement" to cstr) == 0:
            return self.lower_with_stmt(ts_node)
        elif strcmp(kind, "try_expr" to cstr) == 0 or strcmp(kind, "try_stmt" to cstr) == 0 or strcmp(kind, "try_statement" to cstr) == 0:
            return self.lower_try_stmt(ts_node)
        elif strcmp(kind, "pass_stmt" to cstr) == 0:
            let n as ptr[Node] = make_node(NodeType.NumberLiteral, self.get_span(ts_node))
            let data as ptr[NumberLiteralData] = make[NumberLiteralData](1 to usize) to ptr[NumberLiteralData]
            (deref data).val = 0 to f64
            (deref n).data = data to ptr[u8]
            return n
        elif strcmp(kind, "assignment" to cstr) == 0 or strcmp(kind, "assignment_expression" to cstr) == 0 or strcmp(kind, "assign_stmt" to cstr) == 0 or strcmp(kind, "augmented_assignment" to cstr) == 0:
            return self.lower_binary(ts_node)
        elif strcmp(kind, "class_decl" to cstr) == 0:
            return self.lower_class_decl(ts_node)
        elif strcmp(kind, "interface_decl" to cstr) == 0:
            return self.lower_interface_decl(ts_node)
        elif strcmp(kind, "struct_decl" to cstr) == 0:
            return self.lower_struct_decl(ts_node)
        elif strcmp(kind, "enum_decl" to cstr) == 0:
            return self.lower_enum_decl(ts_node)
        elif strcmp(kind, "union_decl" to cstr) == 0:
            return self.lower_union_decl(ts_node)
        elif strcmp(kind, "type_decl" to cstr) == 0:
            return self.lower_type_decl(ts_node)
        elif strcmp(kind, "cast_expression" to cstr) == 0:
            return self.lower_cast_expr(ts_node)
        elif strcmp(kind, "null_literal" to cstr) == 0:
            let n as ptr[Node] = make_node(NodeType.Identifier, self.get_span(ts_node))
            let data as ptr[IdentifierData] = make[IdentifierData](1 to usize) to ptr[IdentifierData]
            (deref data).name = String.make("None" to cstr)
            (deref n).data = data to ptr[u8]
            return n
        elif strcmp(kind, "boolean_literal" to cstr) == 0:
            let text as ptr[String] = self.slice_string_from_node(ts_node)
            let s_data as ptr[u8] = (deref text).data
            let c0 as u8 = deref s_data
            let val as bool = c0 == 84 to u8 or c0 == 116 to u8
            drop(text to ptr)
            let n as ptr[Node] = make_node(NodeType.BooleanLiteral, self.get_span(ts_node))
            let data as ptr[BooleanLiteralData] = make[BooleanLiteralData](1 to usize) to ptr[BooleanLiteralData]
            if val:
                (deref data).val = 1 to f64
            else:
                (deref data).val = 0 to f64
            (deref n).data = data to ptr[u8]
            return n
        elif strcmp(kind, "quantum_literal" to cstr) == 0:
            let text as ptr[String] = self.slice_string_from_node(ts_node)
            let s_data as ptr[u8] = (deref text).data
            var q_val as f64 = 0.0
            if (deref text).len >= 2 to usize:
                let c1 as u8 = deref ((s_data to usize + 1 to usize) to ptr[u8])
                if c1 == 49 to u8: // '1' in |1>
                    q_val = 1.0
            drop(text to ptr)
            let n as ptr[Node] = make_node(NodeType.CallExpr, self.get_span(ts_node))
            let data as ptr[CallExprData] = make[CallExprData](1 to usize) to ptr[CallExprData]
            let callee as ptr[Node] = make_node(NodeType.Identifier, self.get_span(ts_node))
            let cdata as ptr[IdentifierData] = make[IdentifierData](1 to usize) to ptr[IdentifierData]
            (deref cdata).name = String.make("qbit" to cstr)
            (deref callee).data = cdata to ptr[u8]
            (deref data).left = callee
            let arg_n as ptr[Node] = make_node(NodeType.NumberLiteral, self.get_span(ts_node))
            let arg_d as ptr[NumberLiteralData] = make[NumberLiteralData](1 to usize) to ptr[NumberLiteralData]
            (deref arg_d).val = q_val
            (deref arg_d).is_float = False
            (deref arg_n).data = arg_d to ptr[u8]
            var args as List[ptr[Node]] = List[ptr[Node]]()
            args.append(arg_n)
            (deref data).params = args
            (deref data).type_annots = None to ptr[List[Option[ptr[TypeAnnotation]]]]
            (deref n).data = data to ptr[u8]
            return n
        elif strcmp(kind, "self_reference" to cstr) == 0:
            let slice_ptr as ptr[String] = self.slice_string_from_node(ts_node)
            let name as String = deref slice_ptr
            drop(slice_ptr to ptr)
            let n as ptr[Node] = make_node(NodeType.Identifier, self.get_span(ts_node))
            let data as ptr[IdentifierData] = make[IdentifierData](1 to usize) to ptr[IdentifierData]
            (deref data).name = name
            (deref n).data = data to ptr[u8]
            return n
        elif strcmp(kind, "unary_expression" to cstr) == 0 or strcmp(kind, "async_expression" to cstr) == 0:
            return self.lower_unary_expr(ts_node)
        elif strcmp(kind, "spawn_stmt" to cstr) == 0:
            return self.lower_spawn_stmt(ts_node)
        elif strcmp(kind, "if_stmt" to cstr) == 0:
            return self.lower_if_stmt(ts_node)
        elif strcmp(kind, "match_stmt" to cstr) == 0:
            return self.lower_match_stmt(ts_node)
        elif strcmp(kind, "ternary" to cstr) == 0:
            return self.lower_ternary(ts_node)
        elif strcmp(kind, "list_literal" to cstr) == 0:
            return self.lower_list_literal(ts_node)
        elif strcmp(kind, "dict_literal" to cstr) == 0:
            return self.lower_dict_literal(ts_node)
        elif strcmp(kind, "interpolated_str" to cstr) == 0:
            return self.lower_interpolated_str(ts_node)
        elif strcmp(kind, "spread_expr" to cstr) == 0:
            return self.lower_spread_expr(ts_node)
        elif strcmp(kind, "index_expression" to cstr) == 0:
            return self.lower_index_expr(ts_node)
        elif strcmp(kind, "comment" to cstr) == 0:
            return None to ptr[Node]

        let n as ptr[Node] = make_node(NodeType.Identifier, self.get_span(ts_node))
        let data as ptr[IdentifierData] = make[IdentifierData](1 to usize) to ptr[IdentifierData]
        (deref data).name = String.make("UNSUPPORTED" to cstr)
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_if_stmt(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var root_if as ptr[Node] = None to ptr[Node]
        var current_if as ptr[Node] = None to ptr[Node]
        var state as i32 = 0 to i32
        var temp_cond as ptr[Node] = None to ptr[Node]
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            let c_type as cstr = ts_node_type_ptr(ref child)
            if strcmp(c_type, ":" to cstr) != 0 and strcmp(c_type, "comment" to cstr) != 0:
                if state == 0 to i32:
                    if strcmp(c_type, "if" to cstr) == 0:
                        state = 1 to i32
                elif state == 1 to i32:
                    if ts_node_is_named_ptr(ref child):
                        temp_cond = self.lower_node(ref child)
                        state = 2 to i32
                elif state == 2 to i32:
                    if ts_node_is_named_ptr(ref child):
                        let branch as ptr[Node] = self.lower_if_branch(ref child)
                        let if_node as ptr[Node] = make_node(NodeType.IfStmt, self.get_span(ref child))
                        let if_data as ptr[IfStmtData] = make[IfStmtData](1 to usize) to ptr[IfStmtData]
                        (deref if_data).cond = temp_cond
                        (deref if_data).then_branch = branch
                        (deref if_data).else_branch = Empty
                        (deref if_node).data = if_data to ptr[u8]
                        if root_if == None to ptr[Node]:
                            root_if = if_node
                            (deref if_node).span = span
                        else:
                            set_node_else_branch(current_if, Some(if_node))
                        current_if = if_node
                        state = 3 to i32
                elif state == 3 to i32:
                    if strcmp(c_type, "elif" to cstr) == 0:
                        state = 4 to i32
                    elif strcmp(c_type, "else" to cstr) == 0:
                        state = 5 to i32
                elif state == 4 to i32:
                    if ts_node_is_named_ptr(ref child):
                        temp_cond = self.lower_node(ref child)
                        state = 2 to i32
                elif state == 5 to i32:
                    if ts_node_is_named_ptr(ref child):
                        let branch as ptr[Node] = self.lower_if_branch(ref child)
                        set_node_else_branch(current_if, Some(branch))
                        state = 3 to i32
            i = i + 1 to u32
        return root_if

    public fn lower_if_branch(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let kind as cstr = ts_node_type_ptr(ts_node)
        if strcmp(kind, "block_body" to cstr) == 0:
            let stmts as List[ptr[Node]] = List[ptr[Node]]()
            let count as u32 = ts_node_child_count_ptr(ts_node)
            var i as u32 = 0 to u32
            while i < count:
                var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                ts_node_child_ptr(ts_node, i, ref child)
                if ts_node_is_named_ptr(ref child):
                    let stmt as ptr[Node] = self.lower_node(ref child)
                    if stmt != None to ptr[Node]:
                        stmts.append(stmt)
                i = i + 1 to u32
            let n as ptr[Node] = make_node(NodeType.BlockStmt, self.get_span(ts_node))
            let data as ptr[BlockStmtData] = make[BlockStmtData](1 to usize) to ptr[BlockStmtData]
            (deref data).declarations = stmts
            (deref data).auto_drops = List[String]()
            (deref n).data = data to ptr[u8]
            return n
        else:
            return self.lower_node(ts_node)

    public fn lower_match_stmt(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var subject as ptr[Node] = None to ptr[Node]
        let cases as List[ptr[Node]] = List[ptr[Node]]()

        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                let c_type as cstr = ts_node_type_ptr(ref child)
                if strcmp(c_type, "comment" to cstr) != 0 and strcmp(c_type, "kw_match" to cstr) != 0 and strcmp(c_type, "match" to cstr) != 0:
                    if strcmp(c_type, "match_case" to cstr) == 0:
                        var pattern as ptr[Node] = None to ptr[Node]
                        var is_var_node as ptr[Node] = None to ptr[Node]
                        var is_type_node as ptr[Node] = None to ptr[Node]
                        var saw_is as bool = False
                        var guard as ptr[Node] = None to ptr[Node]
                        var body as ptr[Node] = None to ptr[Node]
                        var saw_if as bool = False

                        let case_child_count as u32 = ts_node_child_count_ptr(ref child)
                        var j as u32 = 0 to u32
                        while j < case_child_count:
                            var cc as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                            ts_node_child_ptr(ref child, j, ref cc)
                            let cc_type as cstr = ts_node_type_ptr(ref cc)
                            if strcmp(cc_type, "if" to cstr) == 0:
                                saw_if = True
                            elif strcmp(cc_type, "kw_is" to cstr) == 0 or strcmp(cc_type, "is" to cstr) == 0:
                                saw_is = True
                                is_var_node = pattern
                                pattern = None to ptr[Node]
                            elif ts_node_is_named_ptr(ref cc):
                                if strcmp(cc_type, "comment" to cstr) != 0 and strcmp(cc_type, "kw_case" to cstr) != 0 and strcmp(cc_type, "case" to cstr) != 0:
                                    if strcmp(cc_type, "block_body" to cstr) == 0 or strcmp(cc_type, "block" to cstr) == 0:
                                        body = self.lower_block(ref cc)
                                    elif strcmp(cc_type, "statement" to cstr) == 0 or strcmp(cc_type, "expr_stmt" to cstr) == 0 or strcmp(cc_type, "expression_statement" to cstr) == 0 or strcmp(cc_type, "jump_stmt" to cstr) == 0:
                                        body = self.lower_node(ref cc)
                                    elif saw_if:
                                        guard = self.lower_node(ref cc)
                                    elif saw_is and is_var_node != None to ptr[Node] and is_type_node == None to ptr[Node]:
                                        is_type_node = self.lower_node(ref cc)
                                        let is_node as ptr[Node] = make_node(NodeType.BinaryExpr, self.get_span(ref child))
                                        let is_data as ptr[BinaryExprData] = make[BinaryExprData](1 to usize) to ptr[BinaryExprData]
                                        (deref is_data).op = String.make("is" to cstr)
                                        (deref is_data).left = is_var_node
                                        (deref is_data).right = is_type_node
                                        (deref is_node).data = is_data to ptr[u8]
                                        pattern = is_node
                                    elif pattern == None to ptr[Node]:
                                        pattern = self.lower_node(ref cc)
                                    elif guard == None to ptr[Node]:
                                        guard = self.lower_node(ref cc)
                            j = j + 1 to u32

                        if pattern != None to ptr[Node]:
                            var case_pat as ptr[Node] = pattern
                            if guard != None to ptr[Node]:
                                let g_node as ptr[Node] = make_node(NodeType.BinaryExpr, self.get_span(ref child))
                                let g_data as ptr[BinaryExprData] = make[BinaryExprData](1 to usize) to ptr[BinaryExprData]
                                (deref g_data).op = String.make("if" to cstr)
                                (deref g_data).left = pattern
                                (deref g_data).right = guard
                                (deref g_node).data = g_data to ptr[u8]
                                case_pat = g_node

                            let c_node as ptr[Node] = make_node(NodeType.BinaryExpr, self.get_span(ref child))
                            let c_data as ptr[BinaryExprData] = make[BinaryExprData](1 to usize) to ptr[BinaryExprData]
                            (deref c_data).op = String.make("case" to cstr)
                            (deref c_data).left = case_pat
                            (deref c_data).right = body
                            (deref c_node).data = c_data to ptr[u8]
                            cases.append(c_node)
                    elif subject == None to ptr[Node]:
                        subject = self.lower_node(ref child)
            i = i + 1 to u32

        let n as ptr[Node] = make_node(NodeType.MatchStmt, span)
        let data as ptr[MatchStmtData] = make[MatchStmtData](1 to usize) to ptr[MatchStmtData]
        (deref data).left = subject
        (deref data).declarations = cases
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_ternary(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let then_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        ts_node_named_child_ptr(ts_node, 0 to u32, ref then_child)
        let cond_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        ts_node_named_child_ptr(ts_node, 1 to u32, ref cond_child)
        let else_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        ts_node_named_child_ptr(ts_node, 2 to u32, ref else_child)
        let then_node as ptr[Node] = self.lower_node(ref then_child)
        let cond_node as ptr[Node] = self.lower_node(ref cond_child)
        let else_node as ptr[Node] = self.lower_node(ref else_child)
        let n as ptr[Node] = make_node(NodeType.IfStmt, self.get_span(ts_node))
        let data as ptr[IfStmtData] = make[IfStmtData](1 to usize) to ptr[IfStmtData]
        (deref data).cond = cond_node
        (deref data).then_branch = then_node
        (deref data).else_branch = Some(else_node)
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_unary_expr(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let count as u32 = ts_node_child_count_ptr(ts_node)
        if count == 0 to u32:
            return None to ptr[Node]
        let op_node as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        ts_node_child_ptr(ts_node, 0 to u32, ref op_node)
        let op_type as cstr = ts_node_type_ptr(ref op_node)
        if count == 1 to u32 and ts_node_is_named_ptr(ref op_node) and strcmp(op_type, "kw_not" to cstr) != 0 and strcmp(op_type, "not" to cstr) != 0 and strcmp(op_type, "!" to cstr) != 0 and strcmp(op_type, "-" to cstr) != 0 and strcmp(op_type, "+" to cstr) != 0 and strcmp(op_type, "ref" to cstr) != 0 and strcmp(op_type, "deref" to cstr) != 0 and strcmp(op_type, "~" to cstr) != 0 and strcmp(op_type, "size" to cstr) != 0:
            return self.lower_node(ref op_node)
        var operand as ptr[Node] = None to ptr[Node]
        var idx as u32 = 1 to u32
        while idx < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, idx, ref child)
            if ts_node_is_named_ptr(ref child):
                operand = self.lower_node(ref child)
                break
            idx = idx + 1 to u32
        if strcmp(op_type, "await" to cstr) == 0 or strcmp(op_type, "async" to cstr) == 0:
            let n as ptr[Node] = make_node(NodeType.AwaitExpr, self.get_span(ts_node))
            let data as ptr[AwaitExprData] = make[AwaitExprData](1 to usize) to ptr[AwaitExprData]
            (deref data).left = operand
            (deref n).data = data to ptr[u8]
            return n
        elif strcmp(op_type, "spawn" to cstr) == 0:
            let n as ptr[Node] = make_node(NodeType.SpawnStmt, self.get_span(ts_node))
            let data as ptr[SpawnStmtData] = make[SpawnStmtData](1 to usize) to ptr[SpawnStmtData]
            (deref data).left = operand
            (deref n).data = data to ptr[u8]
            return n
        elif strcmp(op_type, "kw_not" to cstr) == 0 or strcmp(op_type, "not" to cstr) == 0 or strcmp(op_type, "!" to cstr) == 0:
            let n as ptr[Node] = make_node(NodeType.UnaryExpr, self.get_span(ts_node))
            let data as ptr[UnaryExprData] = make[UnaryExprData](1 to usize) to ptr[UnaryExprData]
            (deref data).op = String.make("not" to cstr)
            (deref data).left = operand
            (deref n).data = data to ptr[u8]
            return n
        elif strcmp(op_type, "-" to cstr) == 0 or strcmp(op_type, "+" to cstr) == 0:
            let n as ptr[Node] = make_node(NodeType.UnaryExpr, self.get_span(ts_node))
            let data as ptr[UnaryExprData] = make[UnaryExprData](1 to usize) to ptr[UnaryExprData]
            (deref data).op = String.make(op_type)
            (deref data).left = operand
            (deref n).data = data to ptr[u8]
            return n
        elif strcmp(op_type, "ref" to cstr) == 0:
            var is_mut as bool = False
            if count >= 3 to u32:
                let second as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                ts_node_child_ptr(ts_node, 1 to u32, ref second)
                let second_type as cstr = ts_node_type_ptr(ref second)
                if strcmp(second_type, "mut" to cstr) == 0:
                    is_mut = True
                    operand = None to ptr[Node]
                    var j as u32 = 2 to u32
                    while j < count:
                        var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                        ts_node_child_ptr(ts_node, j, ref child)
                        if ts_node_is_named_ptr(ref child):
                            operand = self.lower_node(ref child)
                            break
                        j = j + 1 to u32
            var op_str as String = String.make("ref" to cstr)
            if is_mut:
                op_str = String.make("ref mut" to cstr)
            let n as ptr[Node] = make_node(NodeType.UnaryExpr, self.get_span(ts_node))
            let data as ptr[UnaryExprData] = make[UnaryExprData](1 to usize) to ptr[UnaryExprData]
            (deref data).op = op_str
            (deref data).left = operand
            (deref n).data = data to ptr[u8]
            return n
        elif strcmp(op_type, "deref" to cstr) == 0:
            let n as ptr[Node] = make_node(NodeType.UnaryExpr, self.get_span(ts_node))
            let data as ptr[UnaryExprData] = make[UnaryExprData](1 to usize) to ptr[UnaryExprData]
            (deref data).op = String.make("deref" to cstr)
            (deref data).left = operand
            (deref n).data = data to ptr[u8]
            return n
        elif strcmp(op_type, "~" to cstr) == 0:
            let n as ptr[Node] = make_node(NodeType.UnaryExpr, self.get_span(ts_node))
            let data as ptr[UnaryExprData] = make[UnaryExprData](1 to usize) to ptr[UnaryExprData]
            (deref data).op = String.make("~" to cstr)
            (deref data).left = operand
            (deref n).data = data to ptr[u8]
            return n
        elif strcmp(op_type, "size" to cstr) == 0:
            let n as ptr[Node] = make_node(NodeType.UnaryExpr, self.get_span(ts_node))
            let data as ptr[UnaryExprData] = make[UnaryExprData](1 to usize) to ptr[UnaryExprData]
            (deref data).op = String.make("size" to cstr)
            (deref data).left = operand
            (deref n).data = data to ptr[u8]
            return n
        return operand

    public fn lower_spawn_stmt(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        var call_expr as ptr[Node] = None to ptr[Node]
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                call_expr = self.lower_node(ref child)
                break
            i = i + 1 to u32
        let n as ptr[Node] = make_node(NodeType.SpawnStmt, self.get_span(ts_node))
        let data as ptr[SpawnStmtData] = make[SpawnStmtData](1 to usize) to ptr[SpawnStmtData]
        (deref data).left = call_expr
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_collection_item(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var is_for as bool = False
        var is_if as bool = False
        var iter_name as String = String.make("" to cstr)
        var iter_type_annots as ptr[List[Option[ptr[TypeAnnotation]]]] = None to ptr[List[Option[ptr[TypeAnnotation]]]]
        var iterable_node as ptr[Node] = None to ptr[Node]
        var yield_expr as ptr[Node] = None to ptr[Node]
        var condition as ptr[Node] = None to ptr[Node]
        var if_cond as ptr[Node] = None to ptr[Node]
        var if_then as ptr[Node] = None to ptr[Node]
        var if_else as ptr[Node] = None to ptr[Node]

        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            let child_type as cstr = ts_node_type_ptr(ref child)
            if strcmp(child_type, "for" to cstr) == 0:
                is_for = True
            elif strcmp(child_type, "if" to cstr) == 0:
                is_if = True
            elif strcmp(child_type, "identifier" to cstr) == 0 and is_for and iter_name.len == 0 to usize:
                let slice_ptr as ptr[String] = self.slice_string_from_node(ref child)
                iter_name = deref slice_ptr
                drop(slice_ptr to ptr)
            elif strcmp(child_type, "type_annotation" to cstr) == 0 and is_for:
                let annot as ptr[TypeAnnotation] = self.lower_type_annotation(ref child)
                let wrapper as ptr[TypeAnnotListWrapper] = make[TypeAnnotListWrapper](1 to usize) to ptr[TypeAnnotListWrapper]
                (deref wrapper).list = List[Option[ptr[TypeAnnotation]]]()
                (deref wrapper).list.append(Some(annot))
            elif strcmp(child_type, "kw_in" to cstr) == 0 or strcmp(child_type, "in" to cstr) == 0:
                // Skip 'in' keyword
                pass
            elif is_for and iterable_node == None to ptr[Node] and ts_node_is_named_ptr(ref child):
                iterable_node = self.lower_node(ref child)
            elif is_for and iterable_node != None to ptr[Node] and ts_node_is_named_ptr(ref child):
                let lowered_item as ptr[Node] = self.lower_node(ref child)
                if lowered_item != None to ptr[Node]:
                    if (deref lowered_item).kind == NodeType.IfStmt:
                        condition = node_cond(lowered_item)
                        yield_expr = node_then_branch(lowered_item)
                    else:
                        yield_expr = lowered_item
            elif is_if and if_cond == None to ptr[Node] and ts_node_is_named_ptr(ref child):
                if_cond = self.lower_node(ref child)
            elif is_if and if_cond != None to ptr[Node] and if_then == None to ptr[Node] and ts_node_is_named_ptr(ref child):
                if_then = self.lower_node(ref child)
            elif is_if and if_then != None to ptr[Node] and ts_node_is_named_ptr(ref child):
                if_else = self.lower_node(ref child)
            i = i + 1 to u32

        if is_for and iterable_node != None to ptr[Node] and yield_expr != None to ptr[Node]:
            let n as ptr[Node] = make_node(NodeType.ListComprehension, self.get_span(ts_node))
            let data as ptr[ListComprehensionData] = make[ListComprehensionData](1 to usize) to ptr[ListComprehensionData]
            (deref data).name = iter_name
            (deref data).left = iterable_node
            (deref data).cond = condition
            (deref data).right = yield_expr
            (deref data).type_annots = iter_type_annots
            (deref n).data = data to ptr[u8]
            return n

        if is_if and if_cond != None to ptr[Node] and if_then != None to ptr[Node]:
            let n as ptr[Node] = make_node(NodeType.IfStmt, self.get_span(ts_node))
            let data as ptr[IfStmtData] = make[IfStmtData](1 to usize) to ptr[IfStmtData]
            (deref data).cond = if_cond
            (deref data).then_branch = if_then
            if if_else != None to ptr[Node]:
                (deref data).else_branch = Some(if_else)
            else:
                (deref data).else_branch = Empty
            (deref n).data = data to ptr[u8]
            return n

        // Fallback: unwrap first named child
        var j as u32 = 0 to u32
        while j < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, j, ref child)
            if ts_node_is_named_ptr(ref child):
                return self.lower_node(ref child)
            j = j + 1 to u32
        return None to ptr[Node]

    public fn lower_list_literal(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let elements as List[ptr[Node]] = List[ptr[Node]]()
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            let child_type as cstr = ts_node_type_ptr(ref child)
            if strcmp(child_type, "arguments" to cstr) == 0 or strcmp(child_type, "argument_list" to cstr) == 0:
                let arg_count as u32 = ts_node_child_count_ptr(ref child)
                var a as u32 = 0 to u32
                while a < arg_count:
                    var arg_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                    ts_node_child_ptr(ref child, a, ref arg_child)
                    if ts_node_is_named_ptr(ref arg_child):
                        let el as ptr[Node] = self.lower_node(ref arg_child)
                        if el != None to ptr[Node]:
                            elements.append(el)
                    a = a + 1 to u32
            elif ts_node_is_named_ptr(ref child):
                let el as ptr[Node] = self.lower_node(ref child)
                if el != None to ptr[Node]:
                    elements.append(el)
            i = i + 1 to u32

        if elements.length() == 1 to i64:
            let first_item as ptr[Node] = elements[0 to i64]
            if first_item != None to ptr[Node] and (deref first_item).kind == NodeType.ListComprehension:
                return first_item

        let n as ptr[Node] = make_node(NodeType.ListLiteral, self.get_span(ts_node))
        let data as ptr[ListLiteralData] = make[ListLiteralData](1 to usize) to ptr[ListLiteralData]
        (deref data).declarations = elements
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_dict_literal(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let items as List[ptr[Node]] = List[ptr[Node]]()
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            let child_type as cstr = ts_node_type_ptr(ref child)
            if strcmp(child_type, "dict_arguments" to cstr) == 0:
                let arg_count as u32 = ts_node_child_count_ptr(ref child)
                var a as u32 = 0 to u32
                while a < arg_count:
                    var arg_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                    ts_node_child_ptr(ref child, a, ref arg_child)
                    let arg_type as cstr = ts_node_type_ptr(ref arg_child)
                    if strcmp(arg_type, "dict_item" to cstr) == 0:
                        var key_node as ptr[Node] = None to ptr[Node]
                        var val_node as ptr[Node] = None to ptr[Node]
                        let item_count as u32 = ts_node_child_count_ptr(ref arg_child)
                        var j as u32 = 0 to u32
                        while j < item_count:
                            var item_part as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                            ts_node_child_ptr(ref arg_child, j, ref item_part)
                            if ts_node_is_named_ptr(ref item_part):
                                if key_node == None to ptr[Node]:
                                    key_node = self.lower_node(ref item_part)
                                elif val_node == None to ptr[Node]:
                                    val_node = self.lower_node(ref item_part)
                            j = j + 1 to u32
                        if key_node != None to ptr[Node]:
                            if (deref key_node).kind == NodeType.SpreadExpr:
                                items.append(key_node)
                            elif val_node != None to ptr[Node]:
                                items.append(key_node)
                                items.append(val_node)
                    elif strcmp(arg_type, "spread_expr" to cstr) == 0:
                        let sp_node as ptr[Node] = self.lower_spread_expr(ref arg_child)
                        if sp_node != None to ptr[Node]:
                            items.append(sp_node)
                    a = a + 1 to u32
            i = i + 1 to u32
        let n as ptr[Node] = make_node(NodeType.DictLiteral, self.get_span(ts_node))
        let data as ptr[DictLiteralData] = make[DictLiteralData](1 to usize) to ptr[DictLiteralData]
        (deref data).declarations = items
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_spread_expr(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        var iterable as ptr[Node] = None to ptr[Node]
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                iterable = self.lower_node(ref child)
                break
            i = i + 1 to u32
        if iterable == None to ptr[Node]:
            return None to ptr[Node]
        let n as ptr[Node] = make_node(NodeType.SpreadExpr, self.get_span(ts_node))
        let data as ptr[SpreadExprData] = make[SpreadExprData](1 to usize) to ptr[SpreadExprData]
        (deref data).left = iterable
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_interpolated_str(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let parts as List[ptr[Node]] = List[ptr[Node]]()
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            let child_type as cstr = ts_node_type_ptr(ref child)
            if strcmp(child_type, "string_content" to cstr) == 0:
                let slice_ptr as ptr[String] = self.slice_string_from_node(ref child)
                let text as String = deref slice_ptr
                drop(slice_ptr to ptr)
                var unescaped_sb as StringBuilder = StringBuilder()
                let t_data as ptr[u8] = text.data
                let t_len as usize = text.len
                var ti as usize = 0 to usize
                while ti < t_len:
                    let b as u8 = t_data[ti]
                    if b == 123 to u8 and ti + 1 to usize < t_len and t_data[ti + 1 to usize] == 123 to u8:
                        unescaped_sb.append("{" to cstr)
                        ti = ti + 2 to usize
                    elif b == 125 to u8 and ti + 1 to usize < t_len and t_data[ti + 1 to usize] == 125 to u8:
                        unescaped_sb.append("}" to cstr)
                        ti = ti + 2 to usize
                    else:
                        let sbuf as ptr[u8] = make[u8](2 to usize) to ptr[u8]
                        sbuf[0] = b
                        sbuf[1] = 0 to u8
                        unescaped_sb.append(sbuf to cstr)
                        drop(sbuf to ptr)
                        ti = ti + 1 to usize
                let final_text as String = unescaped_sb.to_string()
                unescaped_sb.deinit()
                let n as ptr[Node] = make_node(NodeType.StringLiteral, self.get_span(ref child))
                let data as ptr[StringLiteralData] = make[StringLiteralData](1 to usize) to ptr[StringLiteralData]
                (deref data).str_val = final_text
                (deref n).data = data to ptr[u8]
                parts.append(n)
            elif strcmp(child_type, "interpolation" to cstr) == 0:
                let expr_count as u32 = ts_node_child_count_ptr(ref child)
                var j as u32 = 0 to u32
                while j < expr_count:
                    var expr_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                    ts_node_child_ptr(ref child, j, ref expr_child)
                    if ts_node_is_named_ptr(ref expr_child):
                        let lowered_expr as ptr[Node] = self.lower_node(ref expr_child)
                        if lowered_expr != None to ptr[Node]:
                            parts.append(lowered_expr)
                    j = j + 1 to u32
            i = i + 1 to u32

        let n as ptr[Node] = make_node(NodeType.InterpolatedString, self.get_span(ts_node))
        let data as ptr[InterpolatedStringData] = make[InterpolatedStringData](1 to usize) to ptr[InterpolatedStringData]
        (deref data).declarations = parts
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_index_expr(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let count as u32 = ts_node_child_count_ptr(ts_node)
        if count < 4 to u32:
            return None to ptr[Node]
        var object_node as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        ts_node_child_ptr(ts_node, 0 to u32, ref object_node)
        var index_node as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        var found_index as bool = False
        var idx as u32 = 1 to u32
        while idx < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, idx, ref child)
            let sub_t as cstr = ts_node_type_ptr(ref child)
            if strcmp(sub_t, "[" to cstr) != 0 and strcmp(sub_t, "]" to cstr) != 0:
                index_node = child
                found_index = True
                break
            idx = idx + 1 to u32
        if not found_index:
            return None to ptr[Node]
        let object as ptr[Node] = self.lower_node(ref object_node)
        let index as ptr[Node] = self.lower_node(ref index_node)
        let n as ptr[Node] = make_node(NodeType.IndexExpr, self.get_span(ts_node))
        let data as ptr[IndexExprData] = make[IndexExprData](1 to usize) to ptr[IndexExprData]
        (deref data).left = object
        (deref data).right = index
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_program(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        let decls as List[ptr[Node]] = List[ptr[Node]]()
        
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            let lowered as ptr[Node] = self.lower_node(ref child)
            if lowered != None to ptr[Node]:
                decls.append(lowered)
            i = i + 1 to u32

        let n as ptr[Node] = make_node(NodeType.Program, span)
        let data as ptr[ProgramData] = make[ProgramData](1 to usize) to ptr[ProgramData]
        (deref data).declarations = decls
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_block(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        let stmts as List[ptr[Node]] = List[ptr[Node]]()
        let params as List[ptr[Node]] = List[ptr[Node]]()
        let return_names as List[String] = List[String]()
        var has_params_or_returns as bool = False

        let p_wrapper as ptr[TypeAnnotListWrapper] = make[TypeAnnotListWrapper](1 to usize) to ptr[TypeAnnotListWrapper]
        (deref p_wrapper).list = List[Option[ptr[TypeAnnotation]]]()
        let param_annots_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = ref (deref p_wrapper).list

        let r_wrapper as ptr[TypeAnnotListWrapper] = make[TypeAnnotListWrapper](1 to usize) to ptr[TypeAnnotListWrapper]
        (deref r_wrapper).list = List[Option[ptr[TypeAnnotation]]]()
        let return_annots_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = ref (deref r_wrapper).list

        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                let c_type as cstr = ts_node_type_ptr(ref child)
                if strcmp(c_type, "typed_params" to cstr) == 0:
                    has_params_or_returns = True
                    let p_count as u32 = ts_node_child_count_ptr(ref child)
                    var p as u32 = 0 to u32
                    while p < p_count:
                        var p_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                        ts_node_child_ptr(ref child, p, ref p_child)
                        if ts_node_is_named_ptr(ref p_child):
                            let p_kind as cstr = ts_node_type_ptr(ref p_child)
                            if strcmp(p_kind, "param_decl" to cstr) == 0 or strcmp(p_kind, "typed_var" to cstr) == 0:
                                var p_name_node as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                                ts_node_child_by_field_name_ptr(ref p_child, "name" to cstr, 4 to u32, ref p_name_node)
                                var p_type_node as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                                ts_node_child_by_field_name_ptr(ref p_child, "type" to cstr, 4 to u32, ref p_type_node)
                                if not ts_node_is_null_ptr(ref p_name_node):
                                    let p_slice as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ts_node_start_byte_ptr(ref p_name_node) to usize, ts_node_end_byte_ptr(ref p_name_node) to usize) to ptr[String]
                                    let param_node as ptr[Node] = make_node(NodeType.VarDecl, self.get_span(ref p_name_node))
                                    let param_data as ptr[VarDeclData] = make[VarDeclData](1 to usize) to ptr[VarDeclData]
                                    (deref param_data).name = deref p_slice
                                    (deref param_data).left = None to ptr[Node]
                                    (deref param_data).is_mut = False
                                    drop(p_slice to ptr)

                                    if not ts_node_is_null_ptr(ref p_type_node):
                                        let annot as ptr[TypeAnnotation] = self.lower_type_annotation(ref p_type_node)
                                        (deref param_annots_ptr).append(Some(annot))
                                    else:
                                        (deref param_annots_ptr).append(Empty)
                                    (deref param_data).type_annots = param_annots_ptr
                                    (deref param_node).data = param_data to ptr[u8]
                                    params.append(param_node)
                            elif strcmp(p_kind, "identifier" to cstr) == 0:
                                let p_slice as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ts_node_start_byte_ptr(ref p_child) to usize, ts_node_end_byte_ptr(ref p_child) to usize) to ptr[String]
                                let param_node as ptr[Node] = make_node(NodeType.VarDecl, self.get_span(ref p_child))
                                let param_data as ptr[VarDeclData] = make[VarDeclData](1 to usize) to ptr[VarDeclData]
                                (deref param_data).name = deref p_slice
                                (deref param_data).left = None to ptr[Node]
                                (deref param_data).is_mut = False
                                (deref param_annots_ptr).append(Empty)
                                (deref param_data).type_annots = param_annots_ptr
                                (deref param_node).data = param_data to ptr[u8]
                                params.append(param_node)
                                drop(p_slice to ptr)
                        p = p + 1 to u32
                elif strcmp(c_type, "return_annotation" to cstr) == 0:
                    has_params_or_returns = True
                    let r_count as u32 = ts_node_child_count_ptr(ref child)
                    var r_idx as u32 = 0 to u32
                    while r_idx < r_count:
                        var r_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                        ts_node_child_ptr(ref child, r_idx, ref r_child)
                        if ts_node_is_named_ptr(ref r_child):
                            let rc_type as cstr = ts_node_type_ptr(ref r_child)
                            if strcmp(rc_type, "tuple_type_list" to cstr) == 0:
                                let tup_count as u32 = ts_node_child_count_ptr(ref r_child)
                                var t_i as u32 = 0 to u32
                                while t_i < tup_count:
                                    var tup_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                                    ts_node_child_ptr(ref r_child, t_i, ref tup_child)
                                    if ts_node_is_named_ptr(ref tup_child):
                                        let tc_type as cstr = ts_node_type_ptr(ref tup_child)
                                        if strcmp(tc_type, "tuple_type" to cstr) == 0:
                                            let tc_count as u32 = ts_node_child_count_ptr(ref tup_child)
                                            var r_name as String = String.make("" to cstr)
                                            var r_annot as ptr[TypeAnnotation] = None to ptr[TypeAnnotation]
                                            var tc_i as u32 = 0 to u32
                                            while tc_i < tc_count:
                                                var elem as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                                                ts_node_child_ptr(ref tup_child, tc_i, ref elem)
                                                if ts_node_is_named_ptr(ref elem):
                                                    let el_type as cstr = ts_node_type_ptr(ref elem)
                                                    if r_name.len == 0 to usize and (strcmp(el_type, "identifier" to cstr) == 0 or strcmp(el_type, "typed_var" to cstr) == 0):
                                                        let el_slice as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ts_node_start_byte_ptr(ref elem) to usize, ts_node_end_byte_ptr(ref elem) to usize) to ptr[String]
                                                        r_name = deref el_slice
                                                        drop(el_slice to ptr)
                                                    else:
                                                        r_annot = self.lower_type_annotation(ref elem)
                                                tc_i = tc_i + 1 to u32
                                            if r_name.len > 0 to usize:
                                                return_names.append(r_name)
                                                if r_annot != None to ptr[TypeAnnotation]:
                                                    (deref return_annots_ptr).append(Some(r_annot))
                                                else:
                                                    (deref return_annots_ptr).append(Empty)
                                        elif strcmp(tc_type, "identifier" to cstr) == 0:
                                            let id_slice as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ts_node_start_byte_ptr(ref tup_child) to usize, ts_node_end_byte_ptr(ref tup_child) to usize) to ptr[String]
                                            return_names.append(deref id_slice)
                                            (deref return_annots_ptr).append(Empty)
                                            drop(id_slice to ptr)
                                    t_i = t_i + 1 to u32
                            else:
                                let ra_annot as ptr[TypeAnnotation] = self.lower_type_annotation(ref r_child)
                                if ra_annot != None to ptr[TypeAnnotation]:
                                    return_names.append(String.make("ret" to cstr))
                                    (deref return_annots_ptr).append(Some(ra_annot))
                        r_idx = r_idx + 1 to u32
                elif strcmp(c_type, "block_body" to cstr) == 0:
                    let bb_count as u32 = ts_node_child_count_ptr(ref child)
                    var bb_i as u32 = 0 to u32
                    while bb_i < bb_count:
                        var bb_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                        ts_node_child_ptr(ref child, bb_i, ref bb_child)
                        if ts_node_is_named_ptr(ref bb_child):
                            let lowered as ptr[Node] = self.lower_node(ref bb_child)
                            if lowered != None to ptr[Node]:
                                stmts.append(lowered)
                        bb_i = bb_i + 1 to u32
                elif strcmp(c_type, "kw_unsafe" to cstr) != 0 and strcmp(c_type, "comment" to cstr) != 0:
                    let lowered as ptr[Node] = self.lower_node(ref child)
                    if lowered != None to ptr[Node]:
                        stmts.append(lowered)
            i = i + 1 to u32

        let block_body as ptr[Node] = make_node(NodeType.BlockStmt, span)
        let b_data as ptr[BlockStmtData] = make[BlockStmtData](1 to usize) to ptr[BlockStmtData]
        (deref b_data).declarations = stmts
        (deref b_data).auto_drops = List[String]()
        (deref block_body).data = b_data to ptr[u8]

        if has_params_or_returns:
            let param_block as ptr[Node] = make_node(NodeType.ParamBlockStmt, span)
            let pb_data as ptr[ParamBlockStmtData] = make[ParamBlockStmtData](1 to usize) to ptr[ParamBlockStmtData]
            (deref pb_data).params = params
            (deref pb_data).body = block_body
            (deref pb_data).return_names = return_names
            (deref pb_data).type_annots = param_annots_ptr
            (deref pb_data).return_type_annots = return_annots_ptr
            (deref pb_data).auto_drops = List[String]()
            (deref param_block).data = pb_data to ptr[u8]
            return param_block

        if stmts.length() == 1 to i64:
            return stmts[0]

        return block_body

    public fn lower_var_decl(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var name as String = String.make("" to cstr)
        var left as ptr[Node] = None to ptr[Node]
        var found_equal as bool = False
        var annot as ptr[TypeAnnotation] = None to ptr[TypeAnnotation]
        var access_mod as String = String.make("public" to cstr)
        
        let wrapper as ptr[TypeAnnotListWrapper] = make[TypeAnnotListWrapper](1 to usize) to ptr[TypeAnnotListWrapper]
        (deref wrapper).list = List[Option[ptr[TypeAnnotation]]]()
        let annots_list_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = ref (deref wrapper).list
        
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            let child_kind as cstr = ts_node_type_ptr(ref child)
            if ts_node_is_named_ptr(ref child):
                let child_kind_str as cstr = ts_node_type_ptr(ref child)
                if strcmp(child_kind_str, "access_modifier" to cstr) == 0:
                    let a_str as ptr[String] = self.slice_string_from_node(ref child)
                    access_mod = deref a_str
                    drop(a_str to ptr)
                elif strcmp(child_kind_str, "typed_var" to cstr) == 0:
                    let tv_count as u32 = ts_node_child_count_ptr(ref child)
                    var j as u32 = 0 to u32
                    while j < tv_count:
                        var tv_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                        ts_node_child_ptr(ref child, j, ref tv_child)
                        if ts_node_is_named_ptr(ref tv_child):
                            let tv_kind as cstr = ts_node_type_ptr(ref tv_child)
                            if strcmp(tv_kind, "identifier" to cstr) == 0:
                                let slice_ptr as ptr[String] = self.slice_string_from_node(ref tv_child)
                                name = deref slice_ptr
                                drop(slice_ptr to ptr)
                            elif strcmp(tv_kind, "type_annotation" to cstr) == 0:
                                annot = self.lower_type_annotation(ref tv_child)
                        j = j + 1 to u32
                elif strcmp(child_kind_str, "identifier" to cstr) == 0:
                    if name.len == 0 to usize:
                        let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ts_node_start_byte_ptr(ref child) to usize, ts_node_end_byte_ptr(ref child) to usize) to ptr[String]
                        name = deref slice_ptr
                        drop(slice_ptr to ptr)
                    elif found_equal:
                        left = self.lower_node(ref child)
                elif strcmp(child_kind_str, "type_annotation" to cstr) == 0:
                    annot = self.lower_type_annotation(ref child)
                else:
                    if found_equal:
                        left = self.lower_node(ref child)
            elif strcmp(child_kind, "=" to cstr) == 0:
                found_equal = True
            i = i + 1 to u32

        if name.len > 0 to usize:
            if annot != None to ptr[TypeAnnotation]:
                (deref annots_list_ptr).append(Some(annot))
            else:
                (deref annots_list_ptr).append(Empty)

        let n as ptr[Node] = make_node(NodeType.VarDecl, span)
        let data as ptr[VarDeclData] = make[VarDeclData](1 to usize) to ptr[VarDeclData]
        (deref data).name = name
        (deref data).left = left
        (deref data).is_mut = False
        (deref data).type_annots = annots_list_ptr
        (deref data).access_modifier = access_mod
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_identifier(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, span.start_byte to usize, span.end_byte to usize) to ptr[String]
        let slice_str as String = deref slice_ptr
        drop(slice_ptr to ptr)

        let n as ptr[Node] = make_node(NodeType.Identifier, span)
        let data as ptr[IdentifierData] = make[IdentifierData](1 to usize) to ptr[IdentifierData]
        (deref data).name = slice_str
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_number(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, span.start_byte to usize, span.end_byte to usize) to ptr[String]
        let num_str as String = deref slice_ptr
        let val as f64 = strtod(num_str.data to cstr, None to ptr)
        drop(slice_ptr to ptr)

        let n as ptr[Node] = make_node(NodeType.NumberLiteral, span)
        let data as ptr[NumberLiteralData] = make[NumberLiteralData](1 to usize) to ptr[NumberLiteralData]
        (deref data).val = val
        extern fn strchr(s as cstr, c as i32) as cstr
        let is_flt as bool = strchr(num_str.data to cstr, '.' to i32) != None to cstr
        (deref data).is_float = is_flt
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_string(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, span.start_byte to usize, span.end_byte to usize) to ptr[String]
        let slice_str as String = deref slice_ptr
        drop(slice_ptr to ptr)
        
        let n as ptr[Node] = make_node(NodeType.StringLiteral, span)
        let data as ptr[StringLiteralData] = make[StringLiteralData](1 to usize) to ptr[StringLiteralData]
        (deref data).str_val = slice_str
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_color_literal(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, span.start_byte to usize, span.end_byte to usize) to ptr[String]
        let s_text as String = deref slice_ptr
        let s_data as ptr[u8] = s_text.data
        let s_len as usize = s_text.len

        var offset as usize = 0 to usize
        if s_len > 0 to usize and (deref s_data) == 35 to u8: // '#'
            offset = 1 to usize

        let hex_len as usize = s_len - offset
        var r as u32 = 0 to u32
        var g as u32 = 0 to u32
        var b as u32 = 0 to u32
        var a as u32 = 255 to u32

        if hex_len == 3 to usize:
            let r_n as u32 = hex_digit_to_val(deref ((s_data to usize + offset) to ptr[u8]))
            let g_n as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 1 to usize) to ptr[u8]))
            let b_n as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 2 to usize) to ptr[u8]))
            r = (r_n * 16 to u32) + r_n
            g = (g_n * 16 to u32) + g_n
            b = (b_n * 16 to u32) + b_n
            a = 255 to u32
        elif hex_len == 6 to usize:
            let r1 as u32 = hex_digit_to_val(deref ((s_data to usize + offset) to ptr[u8]))
            let r0 as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 1 to usize) to ptr[u8]))
            let g1 as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 2 to usize) to ptr[u8]))
            let g0 as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 3 to usize) to ptr[u8]))
            let b1 as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 4 to usize) to ptr[u8]))
            let b0 as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 5 to usize) to ptr[u8]))
            r = (r1 * 16 to u32) + r0
            g = (g1 * 16 to u32) + g0
            b = (b1 * 16 to u32) + b0
            a = 255 to u32
        elif hex_len == 8 to usize:
            let r1 as u32 = hex_digit_to_val(deref ((s_data to usize + offset) to ptr[u8]))
            let r0 as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 1 to usize) to ptr[u8]))
            let g1 as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 2 to usize) to ptr[u8]))
            let g0 as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 3 to usize) to ptr[u8]))
            let b1 as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 4 to usize) to ptr[u8]))
            let b0 as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 5 to usize) to ptr[u8]))
            let a1 as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 6 to usize) to ptr[u8]))
            let a0 as u32 = hex_digit_to_val(deref ((s_data to usize + offset + 7 to usize) to ptr[u8]))
            r = (r1 * 16 to u32) + r0
            g = (g1 * 16 to u32) + g0
            b = (b1 * 16 to u32) + b0
            a = (a1 * 16 to u32) + a0

        drop(slice_ptr to ptr)
        let argb as u64 = ((a to u64) * 16777216 to u64) + ((r to u64) * 65536 to u64) + ((g to u64) * 256 to u64) + (b to u64)
        let n as ptr[Node] = make_node(NodeType.ColorLiteral, span)
        let data as ptr[ColorLiteralData] = make[ColorLiteralData](1 to usize) to ptr[ColorLiteralData]
        (deref data).val = argb to f64
        (deref data).r = r to u8
        (deref data).g = g to u8
        (deref data).b = b to u8
        (deref data).a = a to u8
        (deref n).data = data to ptr[u8]
        return n


    public fn lower_binary(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        
        var left as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        var op as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        var right as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        
        ts_node_child_by_field_name_ptr(ts_node, "left" to cstr, 4 to u32, ref left)
        ts_node_child_by_field_name_ptr(ts_node, "operator" to cstr, 8 to u32, ref op)
        ts_node_child_by_field_name_ptr(ts_node, "right" to cstr, 5 to u32, ref right)
        
        if ts_node_is_null_ptr(ref left) or ts_node_is_null_ptr(ref op) or ts_node_is_null_ptr(ref right):
            ts_node_child_ptr(ts_node, 0 to u32, ref left)
            ts_node_child_ptr(ts_node, 1 to u32, ref op)
            ts_node_child_ptr(ts_node, 2 to u32, ref right)
            
        let op_span as Span = self.get_span(ref op)
        let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, op_span.start_byte to usize, op_span.end_byte to usize) to ptr[String]
        let op_str as String = deref slice_ptr
        drop(slice_ptr to ptr)

        let n as ptr[Node] = make_node(NodeType.BinaryExpr, span)
        let data as ptr[BinaryExprData] = make[BinaryExprData](1 to usize) to ptr[BinaryExprData]
        (deref data).op = op_str
        (deref data).left = self.lower_node(ref left)
        (deref data).right = self.lower_node(ref right)
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_macro_decl(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var name as String = String.make("" to cstr)
        let param_names as List[String] = List[String]()
        
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            let c_kind as cstr = ts_node_type_ptr(ref child)
            if strcmp(c_kind, "identifier" to cstr) == 0:
                if name.len == 0 to usize:
                    let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ts_node_start_byte_ptr(ref child) to usize, ts_node_end_byte_ptr(ref child) to usize) to ptr[String]
                    name = deref slice_ptr
                    drop(slice_ptr to ptr)
            elif strcmp(c_kind, "typed_params" to cstr) == 0:
                let tp_count as u32 = ts_node_child_count_ptr(ref child)
                var j as u32 = 0 to u32
                while j < tp_count:
                    var tp_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                    ts_node_child_ptr(ref child, j, ref tp_child)
                    let tp_kind as cstr = ts_node_type_ptr(ref tp_child)
                    if strcmp(tp_kind, "param_decl" to cstr) == 0:
                        let pd_count as u32 = ts_node_child_count_ptr(ref tp_child)
                        var k as u32 = 0 to u32
                        while k < pd_count:
                            var pd_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                            ts_node_child_ptr(ref tp_child, k, ref pd_child)
                            let pd_child_kind as cstr = ts_node_type_ptr(ref pd_child)
                            if strcmp(pd_child_kind, "identifier" to cstr) == 0:
                                let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ts_node_start_byte_ptr(ref pd_child) to usize, ts_node_end_byte_ptr(ref pd_child) to usize) to ptr[String]
                                param_names.append(deref slice_ptr)
                                drop(slice_ptr to ptr)
                            k = k + 1 to u32
                    j = j + 1 to u32
            i = i + 1 to u32

        var body_ts as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        var body_idx as i32 = count to i32 - 1
        var found_body as bool = False
        while body_idx >= 0:
            ts_node_child_ptr(ts_node, body_idx to u32, ref body_ts)
            if ts_node_is_named_ptr(ref body_ts):
                found_body = True
                break
            body_idx = body_idx - 1
            
        if not found_body:
            return None to ptr[Node]
            
        let body_ast as ptr[Node] = self.lower_node(ref body_ts)
        let m_def as MacroDef = MacroDef(param_names = param_names, body_ast = body_ast)
        (deref self).macros[name] = m_def
        
        let n as ptr[Node] = make_node(NodeType.MacroDecl, span)
        let data as ptr[MacroDeclData] = make[MacroDeclData](1 to usize) to ptr[MacroDeclData]
        (deref data).name = name
        (deref data).params = List[ptr[Node]]()
        (deref data).body = body_ast
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_macro_invocation(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        var name as String = String.make("" to cstr)
        var args_node as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        var has_args as bool = False
        
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            let c_kind as cstr = ts_node_type_ptr(ref child)
            if strcmp(c_kind, "identifier" to cstr) == 0:
                let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ts_node_start_byte_ptr(ref child) to usize, ts_node_end_byte_ptr(ref child) to usize) to ptr[String]
                name = deref slice_ptr
                drop(slice_ptr to ptr)
            elif strcmp(c_kind, "arguments" to cstr) == 0:
                args_node = child
                has_args = True
            i = i + 1 to u32

        if not (deref self).macros.has(name):
            let r_err as i32 = printf("Error: macro '%s' is undefined.\n" to cstr, name.data to cstr)
            return None to ptr[Node]
            
        let m_def as MacroDef = (deref self).macros[name]
        let args as List[ptr[Node]] = List[ptr[Node]]()
        if has_args:
            let arg_count as u32 = ts_node_child_count_ptr(ref args_node)
            var j as u32 = 0 to u32
            while j < arg_count:
                var arg_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                ts_node_child_ptr(ref args_node, j, ref arg_child)
                if ts_node_is_named_ptr(ref arg_child):
                    args.append(self.lower_node(ref arg_child))
                j = j + 1 to u32

        if args.length() != m_def.param_names.length():
            let r_err2 as i32 = printf("Error: macro '%s' expects arguments size mismatch.\n" to cstr, name.data to cstr)
            return None to ptr[Node]

        // Bind parameter names to argument nodes
        let p_len as i64 = m_def.param_names.length()
        var p_idx as i64 = 0 to i64
        while p_idx < p_len:
            (deref self).macro_args[m_def.param_names[p_idx]] = args[p_idx]
            p_idx = p_idx + 1 to i64

        let hygiene_id as i64 = (deref self).next_hygiene_id
        (deref self).next_hygiene_id = (deref self).next_hygiene_id + 1 to i64
        
        let locals as Dict[String, bool] = Dict[String, bool]()
        self.collect_macro_locals(m_def.body_ast, locals)
        
        let expanded as ptr[Node] = self.clone_node(m_def.body_ast, hygiene_id, locals)

        // Unbind parameter names
        var u_idx as i64 = 0 to i64
        while u_idx < p_len:
            let dummy as bool = (deref self).macro_args.remove(m_def.param_names[u_idx])
            u_idx = u_idx + 1 to i64

        return expanded

    public fn collect_macro_locals(self as ptr[Lowerer], node as ptr[Node], locals as Dict[String, bool]):
        if node == None to ptr[Node]:
            return
        
        let nt as NodeType = node_kind(node)
        if nt == NodeType.Program or nt == NodeType.BlockStmt or nt == NodeType.WithStmt or nt == NodeType.MatchStmt or nt == NodeType.TryStmt:
            let decls as List[ptr[Node]] = node_declarations(node)
            let count as i64 = decls.length()
            var i as i64 = 0 to i64
            while i < count:
                self.collect_macro_locals(decls[i], locals)
                i = i + 1 to i64
        elif nt == NodeType.VarDecl or nt == NodeType.FunDecl:
            let v_name as String = node_name(node)
            if v_name.len > 0 to usize:
                locals[v_name] = True
        elif nt == NodeType.ParamBlockStmt:
            let ret_names as List[String] = node_return_names(node)
            let r_count as i64 = ret_names.length()
            var r_idx as i64 = 0 to i64
            while r_idx < r_count:
                let r_name as String = ret_names[r_idx]
                if r_name.len > 0 to usize:
                    locals[r_name] = True
                r_idx = r_idx + 1 to i64
        
        self.collect_macro_locals(node_left(node), locals)
        self.collect_macro_locals(node_right(node), locals)
        self.collect_macro_locals(node_body(node), locals)
        self.collect_macro_locals(node_cond(node), locals)
        self.collect_macro_locals(node_then_branch(node), locals)
        let eb_opt as Option[ptr[Node]] = node_else_branch(node)
        let eb_ref as ptr[OptionLayout] = (ref eb_opt) to ptr[OptionLayout]
        if option_has_value(eb_ref):
            self.collect_macro_locals(option_unwrap_ptr(eb_ref) to ptr[Node], locals)

    public fn mangle_name(self as ptr[Lowerer], name as String, hygiene_id as i64, locals as Dict[String, bool]) as String:
        if hygiene_id == 0 to i64:
            return name
        if locals.has(name):
            let cap as usize = name.len + 32 to usize
            let buf as ptr[u8] = make(cap) to ptr[u8]
            extern fn snprintf(str as ptr[u8], size as usize, format as cstr, ...) as i32
            let snprintf_len as i32 = snprintf(buf, cap, "%s_mac%d" to cstr, name.data to cstr, hygiene_id)
            let mangled_len as usize = snprintf_len to usize
            return String(data = buf, len = mangled_len, capacity = cap)
        return name

    public fn clone_ast(self as ptr[Lowerer], node as ptr[Node]) as ptr[Node]:
        if node == None to ptr[Node]:
            return None to ptr[Node]
        
        let nt as NodeType = node_kind(node)
        let span_val as Span = node_span(node)
        
        if nt == NodeType.Identifier:
            let res as ptr[Node] = make_node(NodeType.Identifier, span_val)
            let res_data as ptr[IdentifierData] = make[IdentifierData](1 to usize) to ptr[IdentifierData]
            (deref res_data).name = node_name(node)
            (deref res).data = res_data to ptr[u8]
            return res
        
        let res as ptr[Node] = make_node(nt, span_val)
        (deref res).module_name = (deref node).module_name
        set_node_val(res, node_val(node))
        set_node_op(res, node_op(node))
        set_node_is_mut(res, node_is_mut(node))
        set_node_is_async(res, node_is_async(node))
        set_node_name(res, node_name(node))

        set_node_left(res, self.clone_ast(node_left(node)))
        set_node_right(res, self.clone_ast(node_right(node)))
        set_node_body(res, self.clone_ast(node_body(node)))
        set_node_cond(res, self.clone_ast(node_cond(node)))
        set_node_then_branch(res, self.clone_ast(node_then_branch(node)))
        
        let orig_else as Option[ptr[Node]] = node_else_branch(node)
        let eb_ref as ptr[OptionLayout] = (ref orig_else) to ptr[OptionLayout]
        if option_has_value(eb_ref):
            let eb_node as ptr[Node] = option_unwrap_ptr(eb_ref) to ptr[Node]
            set_node_else_branch(res, Some(self.clone_ast(eb_node)))
        else:
            set_node_else_branch(res, orig_else)
            
        set_node_str_val(res, node_str_val(node))
        set_node_type_annots(res, node_type_annots(node))
        
        if nt == NodeType.ParamBlockStmt:
            set_node_return_names(res, node_return_names(node))
            set_node_return_type_annots(res, node_return_type_annots(node))
        
        let orig_decls as List[ptr[Node]] = node_declarations(node)
        let count as i64 = orig_decls.length()
        let decls as List[ptr[Node]] = List[ptr[Node]]()
        var i as i64 = 0 to i64
        while i < count:
            decls.append(self.clone_ast(orig_decls[i]))
            i = i + 1 to i64
        set_node_declarations(res, decls)

        let orig_params as List[ptr[Node]] = node_params(node)
        let p_count as i64 = orig_params.length()
        let params_list as List[ptr[Node]] = List[ptr[Node]]()
        var p_idx as i64 = 0 to i64
        while p_idx < p_count:
            params_list.append(self.clone_ast(orig_params[p_idx]))
            p_idx = p_idx + 1 to i64
        set_node_params(res, params_list)

        return res

    public fn clone_node(self as ptr[Lowerer], node as ptr[Node], hygiene_id as i64, locals as Dict[String, bool]) as ptr[Node]:
        if node == None to ptr[Node]:
            return None to ptr[Node]
        
        let nt as NodeType = node_kind(node)
        let span_val as Span = node_span(node)
        
        if nt == NodeType.Identifier:
            let name as String = node_name(node)
            if (deref self).macro_args.has(name):
                let arg as ptr[Node] = (deref self).macro_args[name]
                return self.clone_ast(arg)
            
            let res as ptr[Node] = make_node(NodeType.Identifier, span_val)
            let res_data as ptr[IdentifierData] = make[IdentifierData](1 to usize) to ptr[IdentifierData]
            (deref res_data).name = self.mangle_name(name, hygiene_id, locals)
            (deref res).data = res_data to ptr[u8]
            return res
        
        // Generic clone: copy all fields via accessors
        let res as ptr[Node] = make_node(nt, span_val)
        (deref res).module_name = (deref node).module_name
        set_node_val(res, node_val(node))
        set_node_op(res, node_op(node))
        set_node_is_mut(res, node_is_mut(node))
        set_node_is_async(res, node_is_async(node))

        var clone_name as String = node_name(node)
        if nt == NodeType.VarDecl or nt == NodeType.FunDecl:
            clone_name = self.mangle_name(node_name(node), hygiene_id, locals)
        set_node_name(res, clone_name)

        set_node_left(res, self.clone_node(node_left(node), hygiene_id, locals))
        set_node_right(res, self.clone_node(node_right(node), hygiene_id, locals))
        set_node_body(res, self.clone_node(node_body(node), hygiene_id, locals))
        set_node_cond(res, self.clone_node(node_cond(node), hygiene_id, locals))
        set_node_then_branch(res, self.clone_node(node_then_branch(node), hygiene_id, locals))
        
        let orig_else as Option[ptr[Node]] = node_else_branch(node)
        let eb_ref as ptr[OptionLayout] = (ref orig_else) to ptr[OptionLayout]
        if option_has_value(eb_ref):
            let eb_node as ptr[Node] = option_unwrap_ptr(eb_ref) to ptr[Node]
            set_node_else_branch(res, Some(self.clone_node(eb_node, hygiene_id, locals)))
        else:
            set_node_else_branch(res, orig_else)
            
        set_node_str_val(res, node_str_val(node))
        set_node_type_annots(res, node_type_annots(node))
        
        if nt == NodeType.ParamBlockStmt:
            set_node_return_names(res, node_return_names(node))
            set_node_return_type_annots(res, node_return_type_annots(node))
        
        let orig_decls as List[ptr[Node]] = node_declarations(node)
        let count as i64 = orig_decls.length()
        let decls as List[ptr[Node]] = List[ptr[Node]]()
        var i as i64 = 0 to i64
        while i < count:
            decls.append(self.clone_node(orig_decls[i], hygiene_id, locals))
            i = i + 1 to i64
        set_node_declarations(res, decls)

        let orig_params as List[ptr[Node]] = node_params(node)
        let p_count as i64 = orig_params.length()
        let params_list as List[ptr[Node]] = List[ptr[Node]]()
        var p_idx as i64 = 0 to i64
        while p_idx < p_count:
            params_list.append(self.clone_node(orig_params[p_idx], hygiene_id, locals))
            p_idx = p_idx + 1 to i64
        set_node_params(res, params_list)

        return res

    public fn verify_ast(self as ptr[Lowerer], root_ast as ptr) as bool:
        if root_ast == None to ptr:
            return False
        
        let root as ptr[Node] = root_ast to ptr[Node]
        if node_kind(root) == NodeType.Program:
            let r1 as i32 = printf("Root node is Program!\n" to cstr, "" to cstr)
            let decls as List[ptr[Node]] = node_declarations(root)
            let count as i64 = decls.length()
            if count == 1 to i64:
                let r2 as i32 = printf("Program has 1 declaration!\n" to cstr, "" to cstr)
                var expr as ptr[Node] = decls[0]
                if node_kind(expr) == NodeType.VarDecl:
                    expr = node_left(expr)
                if expr != None to ptr[Node] and node_kind(expr) == NodeType.BinaryExpr:
                    let r3 as i32 = printf("Child is BinaryExpr!\n" to cstr, "" to cstr)
                    let r4 as i32 = printf("Operator is: %s\n" to cstr, node_op(expr).data to cstr)
                    
                    let left as ptr[Node] = node_left(expr)
                    if node_kind(left) == NodeType.Identifier:
                        let r5 as i32 = printf("Left operand name is: %s\n" to cstr, node_name(left).data to cstr)
                        
                    let right as ptr[Node] = node_right(expr)
                    if node_kind(right) == NodeType.NumberLiteral:
                        if node_val(right) == 42.0:
                            let r6 as i32 = printf("Right operand value is: 42\n" to cstr, "" to cstr)
                            let r7 as i32 = printf("CST to AST lowering verified successfully!\n" to cstr, "" to cstr)
                            return True
        return False

    public fn lower_cast_expr(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var operand_ts as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        var target_ts as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
        
        ts_node_child_by_field_name_ptr(ts_node, "operand" to cstr, 7 to u32, ref operand_ts)
        ts_node_child_by_field_name_ptr(ts_node, "target" to cstr, 6 to u32, ref target_ts)
        
        var operand_node as ptr[Node] = None to ptr[Node]
        var target_name as String = String.make("" to cstr)
        
        if not ts_node_is_null_ptr(ref operand_ts):
            operand_node = self.lower_node(ref operand_ts)
            
        if not ts_node_is_null_ptr(ref target_ts):
            let t_start as usize = ts_node_start_byte_ptr(ref target_ts) to usize
            let t_end as usize = ts_node_end_byte_ptr(ref target_ts) to usize
            var t_full_end as usize = t_end
            let src_data as ptr[u8] = (deref self).source_code.data
            let src_len as usize = (deref self).source_code.len
            if t_end < src_len:
                let after_ptr as ptr[u8] = (src_data to usize + t_end to usize) to ptr[u8]
                if (deref after_ptr) == 91 to u8:
                    var depth as i32 = 1 to i32
                    var j as usize = t_end + 1 to usize
                    while j < src_len and depth > 0:
                        let ch as u8 = deref ((src_data to usize + j to usize) to ptr[u8])
                        if ch == 91 to u8:
                            depth = depth + 1 to i32
                        elif ch == 93 to u8:
                            depth = depth - 1 to i32
                        if depth > 0:
                            j = j + 1 to usize
                        else:
                            t_full_end = j + 1 to usize
                            j = src_len
            if t_full_end > t_start:
                let slice_ptr as ptr[String] = slice_string(src_data, src_len, t_start, t_full_end) to ptr[String]
                target_name = deref slice_ptr
                drop(slice_ptr to ptr)
        else:
            let count as u32 = ts_node_child_count_ptr(ts_node)
            var i as u32 = 0 to u32
            while i < count:
                var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                ts_node_child_ptr(ts_node, i, ref child)
                if ts_node_is_named_ptr(ref child):
                    let c_kind as cstr = ts_node_type_ptr(ref child)
                    if strcmp(c_kind, "kw_to" to cstr) != 0 and strcmp(c_kind, "to" to cstr) != 0:
                        if operand_node == None to ptr[Node]:
                            operand_node = self.lower_node(ref child)
                        else:
                            let c_start as usize = ts_node_start_byte_ptr(ref child) to usize
                            let c_end as usize = ts_node_end_byte_ptr(ref child) to usize
                            if c_end > c_start:
                                let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, c_start, c_end) to ptr[String]
                                target_name = deref slice_ptr
                                drop(slice_ptr to ptr)
                i = i + 1 to u32
        
        let n as ptr[Node] = make_node(NodeType.CastExpr, span)
        let data as ptr[CastExprData] = make[CastExprData](1 to usize) to ptr[CastExprData]
        (deref data).op = target_name
        (deref data).left = operand_node
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_fun_decl(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var name as String = String.make("" to cstr)
        let params as List[ptr[Node]] = List[ptr[Node]]()
        var body_ast as ptr[Node] = None to ptr[Node]
        var is_extern_fn as bool = False
        var is_variadic_fn as bool = False
        var ret_type_annot as ptr[TypeAnnotation] = None to ptr[TypeAnnotation]
        
        let src_len as usize = (deref self).source_code.len
        let src_buf as ptr[u8] = (deref self).source_code.data
        let sb as usize = span.start_byte to usize
        if src_buf != None to ptr[u8]:
            var cur_sb as usize = sb
            while cur_sb < src_len and (src_buf[cur_sb] == 32 to u8 or src_buf[cur_sb] == 9 to u8 or src_buf[cur_sb] == 10 to u8 or src_buf[cur_sb] == 13 to u8):
                cur_sb = cur_sb + 1 to usize
            if cur_sb + 6 to usize <= src_len:
                if src_buf[cur_sb] == 101 to u8 and src_buf[cur_sb + 1 to usize] == 120 to u8 and src_buf[cur_sb + 2 to usize] == 116 to u8 and src_buf[cur_sb + 3 to usize] == 101 to u8 and src_buf[cur_sb + 4 to usize] == 114 to u8 and src_buf[cur_sb + 5 to usize] == 110 to u8:
                    is_extern_fn = True
            var prev_b as usize = sb
            while prev_b > 0 and (src_buf[prev_b - 1] == 32 to u8 or src_buf[prev_b - 1] == 9 to u8 or src_buf[prev_b - 1] == 10 to u8 or src_buf[prev_b - 1] == 13 to u8):
                prev_b = prev_b - 1 to usize
            if prev_b >= 6:
                if src_buf[prev_b - 6] == 101 to u8 and src_buf[prev_b - 5] == 120 to u8 and src_buf[prev_b - 4] == 116 to u8 and src_buf[prev_b - 3] == 101 to u8 and src_buf[prev_b - 2] == 114 to u8 and src_buf[prev_b - 1] == 110 to u8:
                    is_extern_fn = True

        var is_override as bool = False
        var is_final_fn as bool = False
        var is_async_fn as bool = False
        var access_mod as String = String.make("public" to cstr)

        var nf_node as TSNode = deref ts_node
        let kind as cstr = ts_node_type_ptr(ts_node)
        if strcmp(kind, "fun_decl" to cstr) == 0 or strcmp(kind, "function_definition" to cstr) == 0 or strcmp(kind, "named_function" to cstr) == 0:
            let count as u32 = ts_node_child_count_ptr(ts_node)
            var i as u32 = 0 to u32
            while i < count:
                var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                ts_node_child_ptr(ts_node, i, ref child)
                let c_type as cstr = ts_node_type_ptr(ref child)
                if strcmp(c_type, "named_function" to cstr) == 0 or strcmp(c_type, "function_definition" to cstr) == 0:
                    nf_node = child
                elif strcmp(c_type, "extern" to cstr) == 0:
                    is_extern_fn = True
                elif strcmp(c_type, "async" to cstr) == 0:
                    is_async_fn = True
                elif strcmp(c_type, "decorator" to cstr) == 0:
                    let d_str as ptr[String] = self.slice_string_from_node(ref child)
                    if strstr((deref d_str).data to cstr, "override" to cstr) != None to cstr:
                        is_override = True
                    if strstr((deref d_str).data to cstr, "final" to cstr) != None to cstr:
                        is_final_fn = True
                    if strstr((deref d_str).data to cstr, "async" to cstr) != None to cstr:
                        is_async_fn = True
                    drop(d_str to ptr)
                elif strcmp(c_type, "fun_modifier" to cstr) == 0:
                    let m_str as ptr[String] = self.slice_string_from_node(ref child)
                    if strcmp((deref m_str).data to cstr, "final" to cstr) == 0:
                        is_final_fn = True
                    elif strcmp((deref m_str).data to cstr, "extern" to cstr) == 0:
                        is_extern_fn = True
                    elif strcmp((deref m_str).data to cstr, "async" to cstr) == 0:
                        is_async_fn = True
                    drop(m_str to ptr)
                elif strcmp(c_type, "access_modifier" to cstr) == 0:
                    let a_str as ptr[String] = self.slice_string_from_node(ref child)
                    access_mod = deref a_str
                    drop(a_str to ptr)
                else:
                    let c_start as usize = ts_node_start_byte_ptr(ref child) to usize
                    let c_end as usize = ts_node_end_byte_ptr(ref child) to usize
                    if c_end - c_start == 6 and src_buf != None to ptr[u8]:
                        if src_buf[c_start] == 101 to u8 and src_buf[c_start + 1 to usize] == 120 to u8 and src_buf[c_start + 2 to usize] == 116 to u8 and src_buf[c_start + 3 to usize] == 101 to u8 and src_buf[c_start + 4 to usize] == 114 to u8 and src_buf[c_start + 5 to usize] == 110 to u8:
                            is_extern_fn = True
                i = i + 1 to u32
        
        let count as u32 = ts_node_child_count_ptr(ref nf_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ref nf_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                let c_kind as cstr = ts_node_type_ptr(ref child)
                if strcmp(c_kind, "identifier" to cstr) == 0:
                    let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ts_node_start_byte_ptr(ref child) to usize, ts_node_end_byte_ptr(ref child) to usize) to ptr[String]
                    name = deref slice_ptr
                    drop(slice_ptr to ptr)
                elif strcmp(c_kind, "typed_params" to cstr) == 0:
                    let tp_count as u32 = ts_node_child_count_ptr(ref child)
                    var j as u32 = 0 to u32
                    while j < tp_count:
                        var tp_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                        ts_node_child_ptr(ref child, j, ref tp_child)
                        if ts_node_is_named_ptr(ref tp_child):
                            let tp_kind as cstr = ts_node_type_ptr(ref tp_child)
                            if strcmp(tp_kind, "param_decl" to cstr) == 0 or strcmp(tp_kind, "typed_var" to cstr) == 0 or strcmp(tp_kind, "self_param" to cstr) == 0 or strcmp(tp_kind, "parameter" to cstr) == 0 or strcmp(tp_kind, "param" to cstr) == 0 or strcmp(tp_kind, "typed_param" to cstr) == 0:
                                let pd_count as u32 = ts_node_child_count_ptr(ref tp_child)
                                var this_has_variadic as bool = False
                                var k as u32 = 0 to u32
                                var annot as ptr[TypeAnnotation] = None to ptr[TypeAnnotation]
                                var is_param_mut as bool = False
                                var is_param_ref as bool = False
                                var param_lifetime as Option[String] = Empty
                                var has_param_lifetime as bool = False
                                var annot_idx as u32 = 0 to u32
                                while annot_idx < pd_count:
                                    var pd_child_annot as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                                    ts_node_child_ptr(ref tp_child, annot_idx, ref pd_child_annot)
                                    // Check for ... variadic token (anonymous node)
                                    let pd_ann_child_type as cstr = ts_node_type_ptr(ref pd_child_annot)
                                    if strcmp(pd_ann_child_type, "..." to cstr) == 0:
                                        is_variadic_fn = True
                                        this_has_variadic = True
                                    elif strcmp(pd_ann_child_type, "mut" to cstr) == 0:
                                        is_param_mut = True
                                    elif strcmp(pd_ann_child_type, "ref" to cstr) == 0:
                                        is_param_ref = True
                                    elif strcmp(pd_ann_child_type, "life" to cstr) == 0:
                                        is_param_ref = True
                                        let l_cnt as u32 = ts_node_child_count_ptr(ref pd_child_annot)
                                        var li as u32 = 0 to u32
                                        while li < l_cnt:
                                            var l_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                                            ts_node_child_ptr(ref pd_child_annot, li, ref l_child)
                                            let l_kind as cstr = ts_node_type_ptr(ref l_child)
                                            if strcmp(l_kind, "lifetime_args" to cstr) == 0 or strcmp(l_kind, "identifier" to cstr) == 0 or strcmp(l_kind, "expression" to cstr) == 0:
                                                let lt_slice as ptr[String] = self.slice_string_from_node(ref l_child)
                                                param_lifetime = Some(deref lt_slice)
                                                has_param_lifetime = True
                                                drop(lt_slice to ptr)
                                            li = li + 1 to u32
                                    if ts_node_is_named_ptr(ref pd_child_annot):
                                        let pd_kind as cstr = ts_node_type_ptr(ref pd_child_annot)
                                        if strcmp(pd_kind, "type_annotation" to cstr) == 0:
                                            annot = self.lower_type_annotation(ref pd_child_annot)
                                    annot_idx = annot_idx + 1 to u32
                                
                                if this_has_variadic:
                                    j = j + 1 to u32
                                    continue
                                
                                if annot != None to ptr[TypeAnnotation]:
                                    if is_param_ref:
                                        (deref annot).is_ref = True
                                    if is_param_mut:
                                        (deref annot).is_mut = True
                                    if has_param_lifetime:
                                        (deref annot).lifetime = param_lifetime
                                
                                while k < pd_count:
                                    var pd_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                                    ts_node_child_ptr(ref tp_child, k, ref pd_child)
                                    if ts_node_is_named_ptr(ref pd_child):
                                        let pd_kind as cstr = ts_node_type_ptr(ref pd_child)
                                        if strcmp(pd_kind, "identifier" to cstr) == 0 or strcmp(pd_kind, "self_reference" to cstr) == 0:
                                            let p_slice as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ts_node_start_byte_ptr(ref pd_child) to usize, ts_node_end_byte_ptr(ref pd_child) to usize) to ptr[String]
                                            let p_node as ptr[Node] = make_node(NodeType.VarDecl, self.get_span(ref pd_child))
                                            let p_data as ptr[VarDeclData] = make[VarDeclData](1 to usize) to ptr[VarDeclData]
                                            (deref p_data).name = deref p_slice
                                            (deref p_data).left = None to ptr[Node]
                                            (deref p_data).is_mut = is_param_mut

                                            let p_wrapper as ptr[TypeAnnotListWrapper] = make[TypeAnnotListWrapper](1 to usize) to ptr[TypeAnnotListWrapper]
                                            (deref p_wrapper).list = List[Option[ptr[TypeAnnotation]]]()
                                            if annot != None to ptr[TypeAnnotation]:
                                                (deref p_wrapper).list.append(Some(annot))
                                            else:
                                                (deref p_wrapper).list.append(Empty)
                                            let p_annots_list_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = ref (deref p_wrapper).list
                                            (deref p_data).type_annots = p_annots_list_ptr
                                            (deref p_node).data = p_data to ptr[u8]

                                            params.append(p_node)
                                            drop(p_slice to ptr)
                                    k = k + 1 to u32
                            elif strcmp(tp_kind, "identifier" to cstr) == 0 or strcmp(tp_kind, "self" to cstr) == 0:
                                let p_slice as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ts_node_start_byte_ptr(ref tp_child) to usize, ts_node_end_byte_ptr(ref tp_child) to usize) to ptr[String]
                                let p_node as ptr[Node] = make_node(NodeType.VarDecl, self.get_span(ref tp_child))
                                let p_data as ptr[VarDeclData] = make[VarDeclData](1 to usize) to ptr[VarDeclData]
                                (deref p_data).name = deref p_slice
                                (deref p_data).left = None to ptr[Node]
                                (deref p_data).is_mut = False

                                let p_wrapper as ptr[TypeAnnotListWrapper] = make[TypeAnnotListWrapper](1 to usize) to ptr[TypeAnnotListWrapper]
                                (deref p_wrapper).list = List[Option[ptr[TypeAnnotation]]]()
                                let p_annots_list_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = ref (deref p_wrapper).list
                                (deref p_annots_list_ptr).append(Empty)
                                (deref p_data).type_annots = p_annots_list_ptr

                                (deref p_node).data = p_data to ptr[u8]
                                params.append(p_node)
                                drop(p_slice to ptr)
                        j = j + 1 to u32
                elif strcmp(c_kind, "block_body" to cstr) == 0 or strcmp(c_kind, "block" to cstr) == 0:
                    body_ast = self.lower_node(ref child)
                elif strcmp(c_kind, "return_annotation" to cstr) != 0 and strcmp(c_kind, "generic_params" to cstr) != 0 and strcmp(c_kind, "typed_params" to cstr) != 0 and strcmp(c_kind, "identifier" to cstr) != 0 and strcmp(c_kind, "decorator" to cstr) != 0 and strcmp(c_kind, "fun_modifier" to cstr) != 0 and strcmp(c_kind, "extern" to cstr) != 0:
                    let expr_node as ptr[Node] = self.lower_node(ref child)
                    if expr_node != None to ptr[Node]:
                        let ret_stmt as ptr[Node] = make_node(NodeType.ReturnStmt, self.get_span(ref child))
                        let ret_data as ptr[ReturnStmtData] = make[ReturnStmtData](1 to usize) to ptr[ReturnStmtData]
                        (deref ret_data).body = expr_node
                        (deref ret_stmt).data = ret_data to ptr[u8]
                        body_ast = ret_stmt
                elif strcmp(c_kind, "return_annotation" to cstr) == 0:
                    let ra_count as u32 = ts_node_child_count_ptr(ref child)
                    var ra_idx as u32 = 0 to u32
                    var ra_name_start as usize = 0 to usize
                    var ra_name_end as usize = 0 to usize
                    while ra_idx < ra_count:
                        var ra_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                        ts_node_child_ptr(ref child, ra_idx, ref ra_child)
                        if ts_node_is_named_ptr(ref ra_child):
                            if ra_name_start == 0 to usize:
                                ra_name_start = ts_node_start_byte_ptr(ref ra_child) to usize
                            ra_name_end = ts_node_end_byte_ptr(ref ra_child) to usize
                        ra_idx = ra_idx + 1 to u32
                    if ra_name_start > 0 to usize and ra_name_end > ra_name_start:
                        let ra_slice as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ra_name_start, ra_name_end) to ptr[String]
                        ret_type_annot = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
                        (deref ret_type_annot).name = deref ra_slice
                        drop(ra_slice to ptr)
                        (deref ret_type_annot).lifetime = Empty
                        (deref ret_type_annot).generics = Empty
                        (deref ret_type_annot).params = Empty
                        (deref ret_type_annot).return_type = None to ptr[TypeAnnotation]
                        (deref ret_type_annot).is_ref = False
                        (deref ret_type_annot).is_mut = False
            i = i + 1 to u32

        // Second pass: if this was a fun_decl, look for block_body in the original node
        if body_ast == None to ptr[Node] and strcmp(kind, "fun_decl" to cstr) == 0:
            let count2 as u32 = ts_node_child_count_ptr(ts_node)
            var i2 as u32 = 0 to u32
            while i2 < count2:
                var child2 as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                ts_node_child_ptr(ts_node, i2, ref child2)
                if ts_node_is_named_ptr(ref child2):
                    let c_kind2 as cstr = ts_node_type_ptr(ref child2)
                    if strcmp(c_kind2, "block_body" to cstr) == 0 or strcmp(c_kind2, "block" to cstr) == 0:
                        body_ast = self.lower_node(ref child2)
                i2 = i2 + 1 to u32

        let n as ptr[Node] = make_node(NodeType.FunDecl, span)
        let data as ptr[FunDeclData] = make[FunDeclData](1 to usize) to ptr[FunDeclData]
        (deref data).name = name
        (deref data).params = params
        if is_extern_fn:
            (deref data).body = None to ptr[Node]
        else:
            (deref data).body = body_ast
        (deref data).is_async = is_async_fn
        (deref data).is_extern = is_extern_fn
        (deref data).is_variadic = is_variadic_fn
        (deref data).return_type_annot = ret_type_annot
        (deref data).is_override = is_override
        (deref data).is_final = is_final_fn
        (deref data).access_modifier = access_mod
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_import(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        
        let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, span.start_byte to usize, span.end_byte to usize) to ptr[String]
        let text_str as String = deref slice_ptr
        drop(slice_ptr to ptr)
        
        let text as cstr = text_str.data to cstr
        
        var target as String = String.make("" to cstr)
        let imported_symbols as List[String] = List[String]()
        var alias as Option[String] = Empty
        var kind as ImportKind = ImportKind.Normal
        
        extern fn strstr(haystack as cstr, needle as cstr) as cstr
        extern fn strtok(str as cstr, delim as cstr) as cstr
        extern fn strdup(s as cstr) as cstr
        extern fn free(p as ptr)
        extern fn strlen(s as cstr) as usize
        
        if strstr(text, "[c]" to cstr) != None to cstr or strstr(text, "[C]" to cstr) != None to cstr:
            kind = ImportKind.C
        elif strstr(text, "[vendor]" to cstr) != None to cstr:
            kind = ImportKind.Vendor
        elif strstr(text, "[path]" to cstr) != None to cstr:
            kind = ImportKind.Path
        elif strstr(text, "[pkg]" to cstr) != None to cstr:
            kind = ImportKind.Pkg
        
        let buf as cstr = strdup(text)
        var b_idx as usize = 0 to usize
        while (deref ((buf to usize + b_idx) to ptr[u8])) != 0 to u8:
            let b_char as u8 = deref ((buf to usize + b_idx) to ptr[u8])
            if b_char == 91 to u8 or b_char == 93 to u8:
                let b_p as ptr[u8] = (buf to usize + b_idx) to ptr[u8]
                deref b_p = 32 to u8
            b_idx = b_idx + 1 to usize
            
        let delims as cstr = " \t\r\n," to cstr
        
        var first_tok as cstr = strtok(buf, delims)
        if first_tok != None to cstr:
            if strcmp(first_tok, "from" to cstr) == 0:
                let target_tok as cstr = strtok(None to cstr, delims)
                if target_tok != None to cstr:
                    target = strip_quotes(target_tok to ptr[u8], strlen(target_tok))
                    
                let import_tok as cstr = strtok(None to cstr, delims)
                
                var sym_tok as cstr = strtok(None to cstr, delims)
                while sym_tok != None to cstr:
                    imported_symbols.append(String.make(sym_tok))
                    sym_tok = strtok(None to cstr, delims)
            elif strcmp(first_tok, "import" to cstr) == 0:
                let tokens as List[String] = List[String]()
                var tok as cstr = strtok(None to cstr, delims)
                while tok != None to cstr:
                    tokens.append(String.make(tok))
                    tok = strtok(None to cstr, delims)
                
                var start_tok_idx as i64 = 0 to i64
                let tok_len as i64 = tokens.length()
                if tok_len > 0 to i64:
                    let t0 as cstr = tokens[0].data to cstr
                    if strcmp(t0, "c" to cstr) == 0 or strcmp(t0, "vendor" to cstr) == 0 or strcmp(t0, "path" to cstr) == 0 or strcmp(t0, "pkg" to cstr) == 0:
                        start_tok_idx = 1 to i64
                
                var from_idx as i64 = -1 to i64
                var idx as i64 = start_tok_idx
                while idx < tok_len:
                    if strcmp(tokens[idx].data to cstr, "from" to cstr) == 0:
                        from_idx = idx
                        break
                    idx = idx + 1 to i64
                
                if from_idx != -1 to i64:
                    if from_idx + 1 to i64 < tok_len:
                        let t_str as String = tokens[from_idx + 1 to i64]
                        target = strip_quotes(t_str.data, t_str.len)
                    
                    var s_idx as i64 = start_tok_idx
                    while s_idx < from_idx:
                        imported_symbols.append(tokens[s_idx])
                        s_idx = s_idx + 1 to i64
                else:
                    if tok_len > start_tok_idx:
                        let t_str as String = tokens[start_tok_idx]
                        target = strip_quotes(t_str.data, t_str.len)
                    
                    var placeholder_str as String = String.make("" to cstr)
                    if tok_len >= start_tok_idx + 3 to i64:
                        placeholder_str = tokens[start_tok_idx + 2 to i64]
                        let opt_alias as Option[String] = Some(placeholder_str)
                        if strcmp(tokens[start_tok_idx + 1 to i64].data to cstr, "as" to cstr) == 0:
                            alias = opt_alias
            elif strcmp(first_tok, "link" to cstr) == 0:
                if kind == ImportKind.Normal:
                    kind = ImportKind.C
                let tokens as List[String] = List[String]()
                var tok as cstr = strtok(None to cstr, delims)
                while tok != None to cstr:
                    tokens.append(String.make(tok))
                    tok = strtok(None to cstr, delims)
                
                var start_tok_idx as i64 = 0 to i64
                let tok_len as i64 = tokens.length()
                if tok_len > 0 to i64:
                    let t0 as cstr = tokens[0].data to cstr
                    if strcmp(t0, "c" to cstr) == 0 or strcmp(t0, "pkg" to cstr) == 0:
                        start_tok_idx = 1 to i64
                if tok_len > start_tok_idx:
                    let t_str as String = tokens[start_tok_idx]
                    target = strip_quotes(t_str.data, t_str.len)
        
        free(buf to ptr)
        text_str.deinit()
        
        let n as ptr[Node] = make_node(NodeType.ImportDecl, span)
        let data as ptr[ImportDeclData] = make[ImportDeclData](1 to usize) to ptr[ImportDeclData]
        (deref data).kind = kind
        (deref data).target = target
        (deref data).imported_symbols = imported_symbols
        (deref data).alias = alias
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_call_expr(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var callee as ptr[Node] = None to ptr[Node]
        let args as List[ptr[Node]] = List[ptr[Node]]()
        var callee_start_byte as usize = 0 to usize
        var generic_end_byte as usize = 0 to usize
        var has_generic as bool = False
        
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        var found_paren as bool = False
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            let c_kind as cstr = ts_node_type_ptr(ref child)
            if strcmp(c_kind, "arguments" to cstr) == 0:
                let arg_count as u32 = ts_node_child_count_ptr(ref child)
                var j as u32 = 0 to u32
                while j < arg_count:
                    var arg_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                    ts_node_child_ptr(ref child, j, ref arg_child)
                    if ts_node_is_named_ptr(ref arg_child):
                        args.append(self.lower_node(ref arg_child))
                    j = j + 1 to u32
            elif strcmp(c_kind, "(" to cstr) == 0:
                found_paren = True
            elif strcmp(c_kind, ")" to cstr) == 0:
                break
            elif strcmp(c_kind, "generic_params" to cstr) == 0:
                has_generic = True
                generic_end_byte = ts_node_end_byte_ptr(ref child) to usize
            elif callee == None to ptr[Node]:
                if callee_start_byte == 0 to usize:
                    callee_start_byte = ts_node_start_byte_ptr(ref child) to usize
                callee = self.lower_node(ref child)
            i = i + 1 to u32
        
        let n as ptr[Node] = make_node(NodeType.CallExpr, span)
        let data as ptr[CallExprData] = make[CallExprData](1 to usize) to ptr[CallExprData]
        (deref data).left = callee
        (deref data).params = args
        (deref data).type_annots = None to ptr[List[Option[ptr[TypeAnnotation]]]]
        if has_generic and callee_start_byte > 0 to usize and generic_end_byte > callee_start_byte:
            let g_slice as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, callee_start_byte, generic_end_byte) to ptr[String]
            let g_annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
            (deref g_annot).name = deref g_slice
            (deref g_annot).lifetime = Empty
            (deref g_annot).generics = Empty
            (deref g_annot).params = Empty
            (deref g_annot).return_type = None to ptr[TypeAnnotation]
            (deref g_annot).is_ref = False
            (deref g_annot).is_mut = False
            drop(g_slice to ptr)
            let g_wrapper as ptr[TypeAnnotListWrapper] = make[TypeAnnotListWrapper](1 to usize) to ptr[TypeAnnotListWrapper]
            (deref g_wrapper).list = List[Option[ptr[TypeAnnotation]]]()
            let g_annots_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = ref (deref g_wrapper).list
            (deref g_annots_ptr).append(Some(g_annot))
            (deref data).type_annots = g_annots_ptr
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_jump_stmt(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        
        // Get the text content to determine the jump kind
        let text_len as usize = span.end_byte to usize - span.start_byte to usize
        let text_ptr as ptr[u8] = (deref self).source_code.data to ptr[u8]
        let is_return as bool = text_len >= 6 and text_ptr[span.start_byte to usize] == 114 to u8 and text_ptr[span.start_byte to usize + 1] == 101 to u8 and text_ptr[span.start_byte to usize + 2] == 116 to u8 and text_ptr[span.start_byte to usize + 3] == 117 to u8 and text_ptr[span.start_byte to usize + 4] == 114 to u8 and text_ptr[span.start_byte to usize + 5] == 110 to u8
        
        let is_raise as bool = text_len >= 5 and text_ptr[span.start_byte to usize] == 114 to u8 and text_ptr[span.start_byte to usize + 1] == 97 to u8 and text_ptr[span.start_byte to usize + 2] == 105 to u8 and text_ptr[span.start_byte to usize + 3] == 115 to u8 and text_ptr[span.start_byte to usize + 4] == 101 to u8
        if is_raise:
            var raise_val as ptr[Node] = None to ptr[Node]
            let count as u32 = ts_node_child_count_ptr(ts_node)
            var i as u32 = 0 to u32
            while i < count:
                var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                ts_node_child_ptr(ts_node, i, ref child)
                if ts_node_is_named_ptr(ref child):
                    let c_kind as cstr = ts_node_type_ptr(ref child)
                    if strcmp(c_kind, "expression" to cstr) == 0 or strcmp(c_kind, "primary" to cstr) == 0 or strcmp(c_kind, "binary_expression" to cstr) == 0 or strcmp(c_kind, "call_expression" to cstr) == 0 or strcmp(c_kind, "identifier" to cstr) == 0 or strcmp(c_kind, "number" to cstr) == 0 or strcmp(c_kind, "string" to cstr) == 0:
                        raise_val = self.lower_node(ref child)
                i = i + 1 to u32
            let n as ptr[Node] = make_node(NodeType.ThrowStmt, span)
            let data as ptr[ThrowStmtData] = make[ThrowStmtData](1 to usize) to ptr[ThrowStmtData]
            (deref data).left = raise_val
            (deref n).data = data to ptr[u8]
            return n
            
        if not is_return:
            let is_break as bool = text_len >= 5 and text_ptr[span.start_byte to usize] == 98 to u8 and text_ptr[span.start_byte to usize + 1] == 114 to u8 and text_ptr[span.start_byte to usize + 2] == 101 to u8 and text_ptr[span.start_byte to usize + 3] == 97 to u8 and text_ptr[span.start_byte to usize + 4] == 107 to u8
            let is_continue as bool = text_len >= 8 and text_ptr[span.start_byte to usize] == 99 to u8 and text_ptr[span.start_byte to usize + 1] == 111 to u8 and text_ptr[span.start_byte to usize + 2] == 110 to u8 and text_ptr[span.start_byte to usize + 3] == 116 to u8
            let n as ptr[Node] = make_node(NodeType.Identifier, span)
            let data as ptr[IdentifierData] = make[IdentifierData](1 to usize) to ptr[IdentifierData]
            if is_break:
                (deref data).name = String.make("break" to cstr)
            elif is_continue:
                (deref data).name = String.make("continue" to cstr)
            else:
                (deref data).name = String.make("UNSUPPORTED_JUMP" to cstr)
            (deref n).data = data to ptr[u8]
            return n
        
        // Parse return value(s) - collect named children after the "return" keyword
        let return_vals as List[ptr[Node]] = List[ptr[Node]]()
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                let lowered as ptr[Node] = self.lower_node(ref child)
                if lowered != None to ptr[Node]:
                    return_vals.append(lowered)
            i = i + 1 to u32
        
        var return_val as ptr[Node] = None to ptr[Node]
        if return_vals.length() == 1 to i64:
            return_val = return_vals[0]
        elif return_vals.length() > 1 to i64:
            let list_node as ptr[Node] = make_node(NodeType.ListLiteral, span)
            let list_data as ptr[ListLiteralData] = make[ListLiteralData](1 to usize) to ptr[ListLiteralData]
            (deref list_data).declarations = return_vals
            (deref list_node).data = list_data to ptr[u8]
            return_val = list_node
        
        let n as ptr[Node] = make_node(NodeType.ReturnStmt, span)
        let data as ptr[ReturnStmtData] = make[ReturnStmtData](1 to usize) to ptr[ReturnStmtData]
        (deref data).body = return_val
        (deref data).auto_drops = List[String]()
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_while_stmt(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var cond_node as ptr[Node] = None to ptr[Node]
        var body_node as ptr[Node] = None to ptr[Node]
        
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        var named_count as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                let c_kind as cstr = ts_node_type_ptr(ref child)
                if strcmp(c_kind, "loop_modifier" to cstr) != 0:
                    if named_count == 0 to u32:
                        cond_node = self.lower_node(ref child)
                    else:
                        body_node = self.lower_node(ref child)
                    named_count = named_count + 1 to u32
            i = i + 1 to u32
        
        let n as ptr[Node] = make_node(NodeType.WhileStmt, span)
        let data as ptr[WhileStmtData] = make[WhileStmtData](1 to usize) to ptr[WhileStmtData]
        (deref data).cond = cond_node
        (deref data).body = body_node
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_for_stmt(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var iter_name as String = String.make("" to cstr)
        var iterable_node as ptr[Node] = None to ptr[Node]
        var body_node as ptr[Node] = None to ptr[Node]
        var is_parallel as bool = False
        var is_vectorized as bool = False
        
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            let c_kind as cstr = ts_node_type_ptr(ref child)
            if strcmp(c_kind, "loop_modifier" to cstr) == 0:
                let mod_len as usize = ts_node_end_byte_ptr(ref child) to usize - ts_node_start_byte_ptr(ref child) to usize
                let mod_text as ptr[u8] = (deref self).source_code.data to ptr[u8]
                let mod_start as usize = ts_node_start_byte_ptr(ref child) to usize
                if mod_len == 4 and mod_text[mod_start] == 64 to u8 and mod_text[mod_start + 1] == 112 to u8 and mod_text[mod_start + 2] == 97 to u8 and mod_text[mod_start + 3] == 114 to u8:
                    is_parallel = True
                elif mod_len == 4 and mod_text[mod_start] == 64 to u8 and mod_text[mod_start + 1] == 118 to u8 and mod_text[mod_start + 2] == 101 to u8 and mod_text[mod_start + 3] == 99 to u8:
                    is_vectorized = True
            elif strcmp(c_kind, "identifier" to cstr) == 0 and iter_name.len == 0 to usize:
                let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ts_node_start_byte_ptr(ref child) to usize, ts_node_end_byte_ptr(ref child) to usize) to ptr[String]
                iter_name = deref slice_ptr
                drop(slice_ptr to ptr)
            elif strcmp(c_kind, "kw_in" to cstr) == 0:
                pass
            elif strcmp(c_kind, "expression" to cstr) == 0 or strcmp(c_kind, "primary" to cstr) == 0 or strcmp(c_kind, "binary_expression" to cstr) == 0 or strcmp(c_kind, "call_expression" to cstr) == 0 or strcmp(c_kind, "identifier" to cstr) == 0 or strcmp(c_kind, "number" to cstr) == 0:
                if iterable_node == None to ptr[Node]:
                    iterable_node = self.lower_node(ref child)
                else:
                    body_node = self.lower_node(ref child)
            elif strcmp(c_kind, "block_body" to cstr) == 0 or strcmp(c_kind, "block" to cstr) == 0:
                body_node = self.lower_node(ref child)
            i = i + 1 to u32
        
        let n as ptr[Node] = make_node(NodeType.ForStmt, span)
        let data as ptr[ForStmtData] = make[ForStmtData](1 to usize) to ptr[ForStmtData]
        (deref data).name = iter_name
        (deref data).left = iterable_node
        (deref data).body = body_node
        (deref data).is_async = is_parallel
        (deref data).is_vectorized = is_vectorized
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_member_expr(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var obj_node as ptr[Node] = None to ptr[Node]
        var prop_name as String = String.make("" to cstr)
        
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                if obj_node == None to ptr[Node]:
                    obj_node = self.lower_node(ref child)
                else:
                    let slice_ptr as ptr[String] = slice_string((deref self).source_code.data, (deref self).source_code.len, ts_node_start_byte_ptr(ref child) to usize, ts_node_end_byte_ptr(ref child) to usize) to ptr[String]
                    prop_name = deref slice_ptr
                    drop(slice_ptr to ptr)
            i = i + 1 to u32
        
        let n as ptr[Node] = make_node(NodeType.MemberExpr, span)
        let data as ptr[MemberExprData] = make[MemberExprData](1 to usize) to ptr[MemberExprData]
        (deref data).left = obj_node
        (deref data).name = prop_name
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_with_stmt(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var expr_node as ptr[Node] = None to ptr[Node]
        var var_name as String = String.make("" to cstr)
        var body_node as ptr[Node] = None to ptr[Node]
        
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                let c_kind as cstr = ts_node_type_ptr(ref child)
                if strcmp(c_kind, "comment" to cstr) == 0:
                    // ignore comment
                    let dummy_c as i32 = 0
                elif strcmp(c_kind, "block_body" to cstr) == 0 or strcmp(c_kind, "block" to cstr) == 0:
                    body_node = self.lower_block(ref child)
                elif strcmp(c_kind, "kw_with" to cstr) == 0 or strcmp(c_kind, "with" to cstr) == 0 or strcmp(c_kind, "as" to cstr) == 0:
                    // ignore keywords
                    let dummy_kw as i32 = 0
                else:
                    if expr_node == None to ptr[Node]:
                        expr_node = self.lower_node(ref child)
                    elif strcmp(c_kind, "identifier" to cstr) == 0:
                        let slice_ptr as ptr[String] = self.slice_string_from_node(ref child)
                        var_name = deref slice_ptr
                        drop(slice_ptr to ptr)
            i = i + 1 to u32
            
        let n as ptr[Node] = make_node(NodeType.WithStmt, span)
        let data as ptr[WithStmtData] = make[WithStmtData](1 to usize) to ptr[WithStmtData]
        (deref data).left = expr_node
        (deref data).name = var_name
        (deref data).body = body_node
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_try_stmt(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let span as Span = self.get_span(ts_node)
        var body_node as ptr[Node] = None to ptr[Node]
        var catch_body as ptr[Node] = None to ptr[Node]
        var err_var as String = String.make("" to cstr)
        var finally_node as ptr[Node] = None to ptr[Node]
        var in_except as bool = False
        
        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            let c_kind as cstr = ts_node_type_ptr(ref child)
            if strcmp(c_kind, "comment" to cstr) == 0:
                let dummy_c as i32 = 0
            elif strcmp(c_kind, "except" to cstr) == 0 or strcmp(c_kind, "catch" to cstr) == 0 or strcmp(c_kind, "kw_except" to cstr) == 0 or strcmp(c_kind, "kw_catch" to cstr) == 0:
                in_except = True
            elif strcmp(c_kind, "except_clause" to cstr) == 0 or strcmp(c_kind, "catch_clause" to cstr) == 0:
                in_except = True
                let ec_count as u32 = ts_node_child_count_ptr(ref child)
                var j as u32 = 0 to u32
                while j < ec_count:
                    var ec_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                    ts_node_child_ptr(ref child, j, ref ec_child)
                    if ts_node_is_named_ptr(ref ec_child):
                        let ec_kind as cstr = ts_node_type_ptr(ref ec_child)
                        if strcmp(ec_kind, "block_body" to cstr) == 0 or strcmp(ec_kind, "block" to cstr) == 0:
                            catch_body = self.lower_block(ref ec_child)
                        elif strcmp(ec_kind, "identifier" to cstr) == 0:
                            let slice_ptr as ptr[String] = self.slice_string_from_node(ref ec_child)
                            err_var = deref slice_ptr
                            drop(slice_ptr to ptr)
                        elif strcmp(ec_kind, "as_pattern" to cstr) == 0:
                            let ec_node as ptr[Node] = self.lower_node(ref ec_child)
                            if ec_node != None to ptr[Node] and node_kind(ec_node) == NodeType.Identifier:
                                err_var = node_name(ec_node)
                        elif catch_body == None to ptr[Node]:
                            catch_body = self.lower_node(ref ec_child)
                    j = j + 1 to u32
            elif strcmp(c_kind, "finally_clause" to cstr) == 0:
                let fc_count as u32 = ts_node_child_count_ptr(ref child)
                var j as u32 = 0 to u32
                while j < fc_count:
                    var fc_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                    ts_node_child_ptr(ref child, j, ref fc_child)
                    if ts_node_is_named_ptr(ref fc_child):
                        let fc_kind as cstr = ts_node_type_ptr(ref fc_child)
                        if strcmp(fc_kind, "block_body" to cstr) == 0 or strcmp(fc_kind, "block" to cstr) == 0:
                            finally_node = self.lower_block(ref fc_child)
                    j = j + 1 to u32
            elif strcmp(c_kind, "block_body" to cstr) == 0 or strcmp(c_kind, "block" to cstr) == 0:
                if in_except:
                    catch_body = self.lower_block(ref child)
                else:
                    body_node = self.lower_block(ref child)
            elif ts_node_is_named_ptr(ref child):
                if in_except:
                    if strcmp(c_kind, "identifier" to cstr) == 0 and err_var.len == 0 to usize:
                        let slice_ptr as ptr[String] = self.slice_string_from_node(ref child)
                        err_var = deref slice_ptr
                        drop(slice_ptr to ptr)
                    elif catch_body == None to ptr[Node]:
                        catch_body = self.lower_node(ref child)
                else:
                    if strcmp(c_kind, "kw_try" to cstr) != 0 and strcmp(c_kind, "try" to cstr) != 0 and body_node == None to ptr[Node]:
                        body_node = self.lower_node(ref child)
            i = i + 1 to u32
            
        let n as ptr[Node] = make_node(NodeType.TryStmt, span)
        let data as ptr[TryStmtData] = make[TryStmtData](1 to usize) to ptr[TryStmtData]
        (deref data).left = body_node
        (deref data).name = err_var
        (deref data).body = catch_body
        (deref n).data = data to ptr[u8]
        return n

    public fn lower_class_decl(self as ptr[Lowerer], ts_node as ptr[TSNode]) as ptr[Node]:
        let m as i32 = (deref self).mode to i32
        let target_mode as i32 = LanguageMode.Nizam to i32
        if m == target_mode:
            let r_err as i32 = printf("Error: 'class' is a Mantiq-only feature. Use 'struct' in Nizam strict mode.\n" to cstr, "" to cstr)
            return None to ptr[Node]

        let span as Span = self.get_span(ts_node)
        var name as String = String.make("" to cstr)
        var base_name as String = String.make("" to cstr)
        var is_final_class as bool = False
        var access_mod as String = String.make("public" to cstr)
        let ifaces as List[String] = List[String]()
        let body_stmts as List[ptr[Node]] = List[ptr[Node]]()

        let count as u32 = ts_node_child_count_ptr(ts_node)
        var i as u32 = 0 to u32
        while i < count:
            var child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
            ts_node_child_ptr(ts_node, i, ref child)
            if ts_node_is_named_ptr(ref child):
                let c_kind as cstr = ts_node_type_ptr(ref child)
                if strcmp(c_kind, "decorator" to cstr) == 0:
                    let d_str as ptr[String] = self.slice_string_from_node(ref child)
                    if strstr((deref d_str).data to cstr, "final" to cstr) != None to cstr:
                        is_final_class = True
                    drop(d_str to ptr)
                elif strcmp(c_kind, "access_modifier" to cstr) == 0:
                    let a_str as ptr[String] = self.slice_string_from_node(ref child)
                    access_mod = deref a_str
                    drop(a_str to ptr)
                elif strcmp(c_kind, "identifier" to cstr) == 0 or strcmp(c_kind, "type_identifier" to cstr) == 0:
                    let slice_ptr as ptr[String] = self.slice_string_from_node(ref child)
                    let text as String = deref slice_ptr
                    drop(slice_ptr to ptr)
                    if name.len == 0 to usize:
                        name = text
                    elif base_name.len == 0 to usize:
                        base_name = text
                    else:
                        ifaces.append(text)
                elif strcmp(c_kind, "block_body" to cstr) == 0 or strcmp(c_kind, "block" to cstr) == 0:
                    let b_count as u32 = ts_node_child_count_ptr(ref child)
                    var b as u32 = 0 to u32
                    while b < b_count:
                        var b_child as TSNode = TSNode(c0 = 0 to u32, c1 = 0 to u32, c2 = 0 to u32, c3 = 0 to u32, id = None to ptr, tree = None to ptr)
                        ts_node_child_ptr(ref child, b, ref b_child)
                        if ts_node_is_named_ptr(ref b_child):
                            let b_type as cstr = ts_node_type_ptr(ref b_child)
                            if strcmp(b_type, "var_decl" to cstr) == 0 or strcmp(b_type, "field_decl" to cstr) == 0 or strcmp(b_type, "fun_decl" to cstr) == 0 or strcmp(b_type, "named_function" to cstr) == 0 or strcmp(b_type, "function_decl" to cstr) == 0:
                                let lowered as ptr[Node] = self.lower_node(ref b_child)
                                if lowered != None to ptr[Node]:
                                    body_stmts.append(lowered)
                        b = b + 1 to u32
            i = i + 1 to u32

        let body_node as ptr[Node] = make_node(NodeType.BlockStmt, span)
        let body_data as ptr[BlockStmtData] = make[BlockStmtData](1 to usize) to ptr[BlockStmtData]
        (deref body_data).declarations = body_stmts
        (deref body_data).auto_drops = List[String]()
        (deref body_node).data = body_data to ptr[u8]

        let n as ptr[Node] = make_node(NodeType.ClassDecl, span)
        let data as ptr[ClassDeclData] = make[ClassDeclData](1 to usize) to ptr[ClassDeclData]
        (deref data).name = name
        (deref data).target = base_name
        (deref data).imported_symbols = ifaces
        (deref data).body = body_node
        (deref data).is_final = is_final_class
        (deref data).access_modifier = access_mod
        (deref n).data = data to ptr[u8]
        return n

