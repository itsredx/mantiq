// ── Imports ─────────────────────────────────────────────────────────────
import std.collections
from std.string import String, StringBuilder
from std.collections import List, Dict
from std.mem import make, drop, resize

extern fn printf(format as cstr, ...) as i32
extern fn strcmp(s1 as cstr, s2 as cstr) as i32
extern fn strlen(s as cstr) as usize
extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr

// ── String Helpers ──────────────────────────────────────────────────────
fn str_eq(a as String, b as String) as bool:
    return strcmp(a.data to cstr, b.data to cstr) == 0

fn str_ne(a as String, b as String) as bool:
    return strcmp(a.data to cstr, b.data to cstr) != 0

fn safe_append(sb as ptr[StringBuilder], s as String):
    if s.data != None to ptr[u8]:
        sb.append(s.data to cstr)

fn append_json_escaped(sb as ptr[StringBuilder], s as String):
    if s.data == None to ptr[u8] or s.len == 0 to usize:
        return
    let l as usize = s.len
    let d as ptr[u8] = s.data
    let needed as usize = (deref sb).len + (l * (2 to usize)) + (2 to usize)
    if needed >= (deref sb).capacity:
        let new_cap as usize = (needed + (1 to usize)) * (2 to usize)
        (deref sb).buffer = resize((deref sb).buffer to ptr, new_cap) to ptr[u8]
        (deref sb).capacity = new_cap
    var buf_ptr as ptr[u8] = (deref sb).buffer
    var cur_len as usize = (deref sb).len
    var i as usize = 0 to usize
    while i < l:
        let c as u8 = d[i]
        if c == 34 to u8:
            buf_ptr[cur_len] = 92 to u8
            buf_ptr[cur_len + (1 to usize)] = 34 to u8
            cur_len = cur_len + (2 to usize)
        elif c == 92 to u8:
            buf_ptr[cur_len] = 92 to u8
            buf_ptr[cur_len + (1 to usize)] = 92 to u8
            cur_len = cur_len + (2 to usize)
        elif c == 10 to u8:
            buf_ptr[cur_len] = 92 to u8
            buf_ptr[cur_len + (1 to usize)] = 110 to u8
            cur_len = cur_len + (2 to usize)
        elif c == 13 to u8:
            buf_ptr[cur_len] = 92 to u8
            buf_ptr[cur_len + (1 to usize)] = 114 to u8
            cur_len = cur_len + (2 to usize)
        elif c == 9 to u8:
            buf_ptr[cur_len] = 92 to u8
            buf_ptr[cur_len + (1 to usize)] = 116 to u8
            cur_len = cur_len + (2 to usize)
        else:
            buf_ptr[cur_len] = c
            cur_len = cur_len + (1 to usize)
        i = i + (1 to usize)
    buf_ptr[cur_len] = 0 to u8
    (deref sb).len = cur_len

// ── Data Structures ──────────────────────────────────────────────────────
struct WidgetNode:
    public var id as String
    public var tag as String
    public var key as String
    public var props as String
    public var children_ids as String

    public fn init(id as String, tag as String, key as String, props as String, children_ids as String) as WidgetNode:
        return WidgetNode(id = id, tag = tag, key = key, props = props, children_ids = children_ids)

struct RenderedNode:
    public var html_id as String
    public var widget_type as String
    public var key as String
    public var props as Dict[String, String]
    public var children_keys as List[String]
    public var parent_html_id as String
    public var parent_key as String

struct Patch:
    public var action as String
    public var html_id as String
    public var payload as String

fn make_patch(action as String, html_id as String, payload as String) as ptr[Patch]:
    let p as ptr[Patch] = make[Patch](1 to usize) to ptr[Patch]
    (deref p).action = action
    (deref p).html_id = html_id
    (deref p).payload = payload
    return p

struct DiffResult:
    public var patches as List[ptr[Patch]]
    public var new_rendered_map as Dict[String, RenderedNode]

// ── JSON Parser & Serializer ─────────────────────────────────────────────
struct JsonParser:
    public var src as String
    public var pos as usize

    public fn init(self as ptr[JsonParser], s as String):
        (deref self).src = s
        (deref self).pos = 0 to usize

    public fn skip_ws(self as ptr[JsonParser]):
        let d as ptr[u8] = (deref self).src.data
        let l as usize = (deref self).src.len
        while (deref self).pos < l:
            let c as u8 = d[(deref self).pos]
            if c == 32 to u8 or c == 9 to u8 or c == 10 to u8 or c == 13 to u8:
                (deref self).pos = (deref self).pos + (1 to usize)
            else:
                return

    public fn peek(self as ptr[JsonParser]) as u8:
        self.skip_ws()
        if (deref self).pos >= (deref self).src.len:
            return 0 to u8
        return (deref self).src.data[(deref self).pos]

    public fn consume(self as ptr[JsonParser], expected as u8) as bool:
        self.skip_ws()
        if (deref self).pos < (deref self).src.len and (deref self).src.data[(deref self).pos] == expected:
            (deref self).pos = (deref self).pos + (1 to usize)
            return True
        return False

    public fn parse_string(self as ptr[JsonParser]) as String:
        self.skip_ws()
        let d as ptr[u8] = (deref self).src.data
        let l as usize = (deref self).src.len
        if (deref self).pos >= l or d[(deref self).pos] != 34 to u8:
            return String.make("" to cstr)
        (deref self).pos = (deref self).pos + (1 to usize)
        let start as usize = (deref self).pos
        while (deref self).pos < l and d[(deref self).pos] != 34 to u8:
            (deref self).pos = (deref self).pos + (1 to usize)
        let str_len as usize = (deref self).pos - start
        let buf as ptr[u8] = make[u8](str_len + (1 to usize)) to ptr[u8]
        let _ as ptr = memcpy(buf to ptr, (d to usize + start) to ptr, str_len)
        buf[str_len] = 0 to u8
        if (deref self).pos < l:
            (deref self).pos = (deref self).pos + (1 to usize)
        return String.make(buf to cstr)

    public fn parse_props(self as ptr[JsonParser]) as Dict[String, String]:
        var props as Dict[String, String] = Dict[String, String]()
        let _ as bool = self.consume(123 to u8)
        while self.peek() != 125 to u8 and self.peek() != 0 to u8:
            let k as String = self.parse_string()
            let _ as bool = self.consume(58 to u8)
            let v as String = self.parse_string()
            if k.len > 0 to usize:
                props[k] = v
            if self.peek() == 44 to u8:
                let _ as bool = self.consume(44 to u8)
            else:
                break
        let _ as bool = self.consume(125 to u8)
        return props

    public fn parse_node(self as ptr[JsonParser], parent_id as String, parent_k as String, node_map as Dict[String, RenderedNode]) as ptr[RenderedNode]:
        let ok as bool = self.consume(123 to u8)
        if not ok:
            return None to ptr[RenderedNode]

        var html_id as String = String.make("" to cstr)
        var wtype as String = String.make("div" to cstr)
        var key as String = String.make("" to cstr)
        var props as Dict[String, String] = Dict[String, String]()
        var children_keys as List[String] = List[String]()

        while self.peek() != 125 to u8 and self.peek() != 0 to u8:
            let field as String = self.parse_string()
            let _ as bool = self.consume(58 to u8)
            if str_eq(field, String.make("id" to cstr)) or str_eq(field, String.make("html_id" to cstr)):
                html_id = self.parse_string()
            elif str_eq(field, String.make("type" to cstr)) or str_eq(field, String.make("widget_type" to cstr)) or str_eq(field, String.make("tag" to cstr)):
                wtype = self.parse_string()
            elif str_eq(field, String.make("key" to cstr)):
                key = self.parse_string()
            elif str_eq(field, String.make("props" to cstr)):
                props = self.parse_props()
            elif str_eq(field, String.make("children" to cstr)):
                let _ as bool = self.consume(91 to u8)
                while self.peek() != 93 to u8 and self.peek() != 0 to u8:
                    let child_node as ptr[RenderedNode] = self.parse_node(html_id, key, node_map)
                    if child_node != None to ptr[RenderedNode]:
                        let ck as String = (deref child_node).key
                        children_keys.append(ck)
                    if self.peek() == 44 to u8:
                        let _ as bool = self.consume(44 to u8)
                    else:
                        break
                let _ as bool = self.consume(93 to u8)
            else:
                let _ as String = self.parse_string()

            if self.peek() == 44 to u8:
                let _ as bool = self.consume(44 to u8)
            else:
                break

        let _ as bool = self.consume(125 to u8)

        if key.len == 0 to usize:
            key = html_id

        let node_ptr as ptr[RenderedNode] = make[RenderedNode](1 to usize) to ptr[RenderedNode]
        (deref node_ptr).html_id = html_id
        (deref node_ptr).widget_type = wtype
        (deref node_ptr).key = key
        (deref node_ptr).props = props
        (deref node_ptr).children_keys = children_keys
        (deref node_ptr).parent_html_id = parent_id
        (deref node_ptr).parent_key = parent_k

        node_map[key] = (deref node_ptr)
        return node_ptr

fn patches_to_json(patches as List[ptr[Patch]]) as String:
    var sb as StringBuilder = StringBuilder.make()
    sb.append("[" to cstr)
    var i as i64 = 0
    let count as i64 = patches.length()
    while i < count:
        if i > 0:
            sb.append("," to cstr)
        let p as ptr[Patch] = patches[i]
        sb.append("{\"action\":\"" to cstr)
        safe_append(ref sb, (deref p).action)
        sb.append("\",\"html_id\":\"" to cstr)
        safe_append(ref sb, (deref p).html_id)
        sb.append("\",\"payload\":\"" to cstr)
        append_json_escaped(ref sb, (deref p).payload)
        sb.append("\"}" to cstr)
        i = i + 1
    sb.append("]" to cstr)
    return sb.to_string()

// ── Reconciler Implementation ───────────────────────────────────────────
struct Reconciler:
    public var id_counter as i64

    public fn init(self as ptr[Reconciler]) as void:
        (deref self).id_counter = 0

    public fn fresh_html_id(self as ptr[Reconciler]) as String:
        let buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
        extern fn sprintf(buf as ptr[u8], fmt as cstr, ...) as i32
        let _ as i32 = sprintf(buf, "el_%ld" to cstr, (deref self).id_counter)
        (deref self).id_counter = (deref self).id_counter + 1
        return String.make(buf to cstr)

    public fn diff_props_to_payload(self as ptr[Reconciler], old_props as Dict[String, String], new_props as Dict[String, String]) as String:
        var sb as StringBuilder = StringBuilder.make()
        let old_keys as List[String] = old_props.keys()
        var has_any as bool = False
        var i as i64 = 0
        let old_count as i64 = old_keys.length()
        while i < old_count:
            let k as String = old_keys[i]
            if new_props.has(k):
                let old_val as String = old_props[k]
                let new_val as String = new_props[k]
                if str_ne(old_val, new_val):
                    if has_any:
                        sb.append(";" to cstr)
                    safe_append(ref sb, k)
                    sb.append("=" to cstr)
                    safe_append(ref sb, new_val)
                    has_any = True
            else:
                if has_any:
                    sb.append(";" to cstr)
                safe_append(ref sb, k)
                sb.append("=" to cstr)
                has_any = True
            i = i + 1
        let new_keys as List[String] = new_props.keys()
        var j as i64 = 0
        let new_count as i64 = new_keys.length()
        while j < new_count:
            let k2 as String = new_keys[j]
            if not old_props.has(k2):
                if has_any:
                    sb.append(";" to cstr)
                safe_append(ref sb, k2)
                sb.append("=" to cstr)
                safe_append(ref sb, new_props[k2])
                has_any = True
            j = j + 1
        if not has_any:
            return String.make("" to cstr)
        return sb.to_string()

    public fn generate_html_stub(self as ptr[Reconciler], widget as ptr[RenderedNode]) as String:
        if widget == None to ptr[RenderedNode]:
            return String.make("" to cstr)
        let wid as String = (deref widget).html_id
        let wtype as String = (deref widget).widget_type
        let buf as ptr[u8] = make[u8](256 to usize) to ptr[u8]
        extern fn sprintf(buf as ptr[u8], fmt as cstr, ...) as i32
        let _ as i32 = sprintf(buf, "<div id=\"%s\" data-type=\"%s\"></div>" to cstr, wid.data to cstr, wtype.data to cstr)
        return String.make(buf to cstr)

    public fn find_next_stable_html_id(self as ptr[Reconciler], start_idx as i64, new_children_keys as List[String], old_key_to_index as Dict[String, i64], rendered_map as Dict[String, RenderedNode]) as String:
        var si as i64 = start_idx
        let sc as i64 = new_children_keys.length()
        while si < sc:
            let sk as String = new_children_keys[si]
            if old_key_to_index.has(sk) and rendered_map.has(sk):
                let sn as RenderedNode = rendered_map[sk]
                return sn.html_id
            si = si + 1
        return String.make("" to cstr)

    public fn insert_node_recursive(self as ptr[Reconciler], widget as ptr[RenderedNode], parent_html_id as String, parent_key as String, result as ptr[DiffResult], previous_map as Dict[String, RenderedNode], new_map as Dict[String, RenderedNode]) as void:
        if widget == None to ptr[RenderedNode]:
            return
        let new_html as String = self.generate_html_stub(widget)
        let new_id as String = (deref widget).html_id
        let new_k as String = (deref widget).key
        let wtype as String = (deref widget).widget_type
        (deref result).patches.append(make_patch(String.make("INSERT" to cstr), (deref widget).html_id, new_html))
        (deref result).new_rendered_map[new_k] = RenderedNode(html_id = (deref widget).html_id, widget_type = wtype, key = (deref widget).key, props = (deref widget).props, children_keys = (deref widget).children_keys, parent_html_id = parent_html_id, parent_key = parent_key)
        let is_sw as bool = str_eq(wtype, String.make("StatefulWidget" to cstr))
        let is_sl as bool = str_eq(wtype, String.make("StatelessWidget" to cstr))
        let is_container as bool = is_sw or is_sl
        var child_parent as String = (deref widget).html_id
        if is_container:
            child_parent = parent_key
        self.diff_children_recursive(List[String](), (deref widget).children_keys, child_parent, new_id, result, previous_map, new_map)

    public fn diff_children_recursive(self as ptr[Reconciler], old_children_keys as List[String], new_children_keys as List[String], parent_html_id as String, parent_key as String, result as ptr[DiffResult], previous_map as Dict[String, RenderedNode], new_map as Dict[String, RenderedNode]) as void:
        if old_children_keys.length() == 0 and new_children_keys.length() == 0:
            return
        var old_key_to_index as Dict[String, i64] = Dict[String, i64]()
        var m as i64 = 0
        let old_cnt as i64 = old_children_keys.length()
        while m < old_cnt:
            old_key_to_index[old_children_keys[m]] = m
            m = m + 1
        var new_key_to_index as Dict[String, i64] = Dict[String, i64]()
        var n as i64 = 0
        let new_cnt as i64 = new_children_keys.length()
        while n < new_cnt:
            new_key_to_index[new_children_keys[n]] = n
            n = n + 1
        var oi as i64 = 0
        while oi < old_cnt:
            let ok as String = old_children_keys[oi]
            if not new_key_to_index.has(ok):
                if previous_map.has(ok):
                    let old_data as RenderedNode = previous_map[ok]
                    (deref result).patches.append(make_patch(String.make("REMOVE" to cstr), old_data.html_id, String.make("" to cstr)))
            oi = oi + 1
        var has_placed as bool = False
        var last_placed_old_idx as i64 = 0
        var ni as i64 = 0
        while ni < new_cnt:
            let nk as String = new_children_keys[ni]
            if old_key_to_index.has(nk):
                if previous_map.has(nk):
                    let old_data2 as RenderedNode = previous_map[nk]
                    let stub as ptr[RenderedNode] = make[RenderedNode](1 to usize) to ptr[RenderedNode]
                    (deref stub).html_id = old_data2.html_id
                    (deref stub).widget_type = old_data2.widget_type
                    (deref stub).key = nk
                    if new_map.has(nk):
                        let nw as RenderedNode = new_map[nk]
                        (deref stub).props = nw.props
                        (deref stub).children_keys = nw.children_keys
                        (deref stub).widget_type = nw.widget_type
                    else:
                        (deref stub).props = old_data2.props
                        (deref stub).children_keys = old_data2.children_keys
                    (deref stub).parent_html_id = parent_html_id
                    (deref stub).parent_key = parent_key
                    self.diff_node_recursive(nk, stub, parent_html_id, parent_key, result, previous_map, new_map)
                let old_idx as i64 = old_key_to_index[nk]
                if has_placed:
                    if old_idx < last_placed_old_idx:
                        if (deref result).new_rendered_map.has(nk):
                            let moved_node as RenderedNode = (deref result).new_rendered_map[nk]
                            let before_id as String = self.find_next_stable_html_id(ni + 1, new_children_keys, old_key_to_index, (deref result).new_rendered_map)
                            var move_pl as StringBuilder = StringBuilder.make()
                            move_pl.append("before=" to cstr)
                            safe_append(ref move_pl, before_id)
                            (deref result).patches.append(make_patch(String.make("MOVE" to cstr), moved_node.html_id, move_pl.to_string()))
                if not has_placed or old_idx > last_placed_old_idx:
                    last_placed_old_idx = old_idx
                    has_placed = True
            else:
                let before_id2 as String = self.find_next_stable_html_id(ni + 1, new_children_keys, old_key_to_index, (deref result).new_rendered_map)
                let new_stub as ptr[RenderedNode] = make[RenderedNode](1 to usize) to ptr[RenderedNode]
                (deref new_stub).html_id = self.fresh_html_id()
                (deref new_stub).widget_type = String.make("Unknown" to cstr)
                (deref new_stub).key = nk
                if new_map.has(nk):
                    let nw2 as RenderedNode = new_map[nk]
                    (deref new_stub).props = nw2.props
                    (deref new_stub).children_keys = nw2.children_keys
                    (deref new_stub).widget_type = nw2.widget_type
                else:
                    (deref new_stub).props = Dict[String, String]()
                    (deref new_stub).children_keys = List[String]()
                (deref new_stub).parent_html_id = parent_html_id
                (deref new_stub).parent_key = parent_key
                self.insert_node_recursive(new_stub, parent_html_id, parent_key, result, previous_map, new_map)
            ni = ni + 1

    public fn diff_node_recursive(self as ptr[Reconciler], old_node_key as String, new_widget as ptr[RenderedNode], parent_html_id as String, parent_key as String, result as ptr[DiffResult], previous_map as Dict[String, RenderedNode], new_map as Dict[String, RenderedNode]) as void:
        if new_widget == None to ptr[RenderedNode]:
            return
        let new_key as String = (deref new_widget).html_id
        if not previous_map.has(old_node_key):
            self.insert_node_recursive(new_widget, parent_html_id, parent_key, result, previous_map, new_map)
            return
        let old_data as RenderedNode = previous_map[old_node_key]
        let new_type as String = (deref new_widget).widget_type
        let old_type as String = old_data.widget_type
        let new_key_val as String = (deref new_widget).key
        let old_key_val as String = old_data.key
        let types_differ as bool = str_ne(old_type, new_type)
        let keys_differ as bool = str_ne(new_key_val, old_key_val)
        if types_differ or keys_differ:
            let new_html_stub as String = self.generate_html_stub(new_widget)
            (deref result).patches.append(make_patch(String.make("REPLACE" to cstr), old_data.html_id, new_html_stub))
            (deref result).new_rendered_map[new_key_val] = RenderedNode(html_id = old_data.html_id, widget_type = new_type, key = new_key_val, props = (deref new_widget).props, children_keys = (deref new_widget).children_keys, parent_html_id = parent_html_id, parent_key = parent_key)
            return
        let html_id as String = old_data.html_id
        let new_props as Dict[String, String] = (deref new_widget).props
        let old_props_from_map as Dict[String, String] = old_data.props
        let prop_payload as String = self.diff_props_to_payload(old_props_from_map, new_props)
        let is_sw2 as bool = str_eq(old_type, String.make("StatefulWidget" to cstr))
        let is_sl2 as bool = str_eq(old_type, String.make("StatelessWidget" to cstr))
        let is_container as bool = is_sw2 or is_sl2
        if not is_container:
            if prop_payload.len > 0 to usize:
                (deref result).patches.append(make_patch(String.make("UPDATE" to cstr), html_id, prop_payload))
        (deref result).new_rendered_map[new_key_val] = RenderedNode(html_id = html_id, widget_type = new_type, key = new_key_val, props = new_props, children_keys = (deref new_widget).children_keys, parent_html_id = parent_html_id, parent_key = parent_key)
        var child_parent as String = html_id
        if is_container:
            child_parent = parent_key
        self.diff_children_recursive(old_data.children_keys, (deref new_widget).children_keys, child_parent, (deref new_widget).html_id, result, previous_map, new_map)

// ── Exported C-Extension API ─────────────────────────────────────────────
@nogil
fn reconcile_json(old_tree_json as String, new_tree_json as String) as String:
    var old_map as Dict[String, RenderedNode] = Dict[String, RenderedNode]()
    var new_map as Dict[String, RenderedNode] = Dict[String, RenderedNode]()

    var p1 as JsonParser = JsonParser()
    p1.init(old_tree_json)
    let old_root as ptr[RenderedNode] = p1.parse_node(String.make("root" to cstr), String.make("root_k" to cstr), old_map)

    var p2 as JsonParser = JsonParser()
    p2.init(new_tree_json)
    let new_root as ptr[RenderedNode] = p2.parse_node(String.make("root" to cstr), String.make("root_k" to cstr), new_map)

    var reconciler as Reconciler = Reconciler()
    reconciler.init()

    var result_node as DiffResult = DiffResult(patches = List[ptr[Patch]](), new_rendered_map = Dict[String, RenderedNode]())
    let r_ptr as ptr[DiffResult] = ref result_node

    if old_root == None to ptr[RenderedNode] and new_root != None to ptr[RenderedNode]:
        reconciler.insert_node_recursive(new_root, String.make("root" to cstr), String.make("root_k" to cstr), r_ptr, old_map, new_map)
    elif old_root != None to ptr[RenderedNode] and new_root == None to ptr[RenderedNode]:
        (deref r_ptr).patches.append(make_patch(String.make("REMOVE" to cstr), (deref old_root).html_id, String.make("" to cstr)))
    elif old_root != None to ptr[RenderedNode] and new_root != None to ptr[RenderedNode]:
        reconciler.diff_node_recursive((deref old_root).key, new_root, String.make("root" to cstr), String.make("root_k" to cstr), r_ptr, old_map, new_map)

    return patches_to_json((deref r_ptr).patches)

fn reconcile_bench(node_count as i64) as i64:
    var reconciler as Reconciler = Reconciler()
    reconciler.init()
    var old_map as Dict[String, RenderedNode] = Dict[String, RenderedNode]()
    var new_map as Dict[String, RenderedNode] = Dict[String, RenderedNode]()
    var old_children as List[String] = List[String]()
    var new_children as List[String] = List[String]()

    var i as i64 = 0
    while i < node_count:
        let id_buf as ptr[u8] = make[u8](32 to usize) to ptr[u8]
        extern fn sprintf(buf as ptr[u8], fmt as cstr, ...) as i32
        let _ as i32 = sprintf(id_buf, "node_%ld" to cstr, i)
        let key_str1 as String = String.make(id_buf to cstr)
        let key_str2 as String = String.make(id_buf to cstr)
        let key_str3 as String = String.make(id_buf to cstr)
        let key_str4 as String = String.make(id_buf to cstr)
        let key_str5 as String = String.make(id_buf to cstr)
        let key_str6 as String = String.make(id_buf to cstr)
        old_children.append(key_str1)
        if i % 10 != 0:
            new_children.append(key_str2)
        var p1 as Dict[String, String] = Dict[String, String]()
        p1[String.make("val" to cstr)] = String.make("100" to cstr)
        var p2 as Dict[String, String] = Dict[String, String]()
        p2[String.make("val" to cstr)] = String.make("100" to cstr)
        old_map[key_str3] = RenderedNode(html_id = key_str4, widget_type = String.make("item" to cstr), key = String.make(id_buf to cstr), props = p1, children_keys = List[String](), parent_html_id = String.make("root" to cstr), parent_key = String.make("root" to cstr))
        new_map[key_str5] = RenderedNode(html_id = key_str6, widget_type = String.make("item" to cstr), key = String.make(id_buf to cstr), props = p2, children_keys = List[String](), parent_html_id = String.make("root" to cstr), parent_key = String.make("root" to cstr))
        i = i + 1

    var result_node as DiffResult = DiffResult(patches = List[ptr[Patch]](), new_rendered_map = Dict[String, RenderedNode]())
    reconciler.diff_children_recursive(old_children, new_children, String.make("root" to cstr), String.make("root_k" to cstr), ref result_node, old_map, new_map)
    return result_node.patches.length()

// ── Standalone Self-Verification ─────────────────────────────────────────
fn main() as i32:
    printf("=== Nizam UI Reconciler Standalone Test ===\n" to cstr)
    let old_json as String = String.make("{\"id\":\"el_0\",\"type\":\"div\",\"key\":\"k0\",\"props\":{\"color\":\"red\"},\"children\":[{\"id\":\"el_1\",\"type\":\"span\",\"key\":\"k1\",\"props\":{\"text\":\"v1\"},\"children\":[]}]}" to cstr)
    let new_json as String = String.make("{\"id\":\"el_0\",\"type\":\"div\",\"key\":\"k0\",\"props\":{\"color\":\"blue\"},\"children\":[{\"id\":\"el_1\",\"type\":\"span\",\"key\":\"k1\",\"props\":{\"text\":\"v2\"},\"children\":[]}]}" to cstr)

    let patches_str as String = reconcile_json(old_json, new_json)
    printf("Reconciliation result: %s\n" to cstr, patches_str.data to cstr)

    let bench_ops as i64 = reconcile_bench(1000)
    printf("Benchmark 1000 nodes: generated %lld patch operations.\n" to cstr, bench_ops)
    printf("✔ All Nizam UI Reconciler verification tests passed!\n" to cstr)
    return 0
