    elif k == NodeType.FieldDecl:
        let d as ptr[FieldDeclData] = (deref n).data to ptr[FieldDeclData]
        r = (deref d).type_annots
    elif k == NodeType.ClosureExpr:
        let d as ptr[ClosureExprData] = (deref n).data to ptr[ClosureExprData]
        r = (deref d).type_annots
    elif k == NodeType.CallExpr:
        let d as ptr[CallExprData] = (deref n).data to ptr[CallExprData]
        r = (deref d).type_annots
    return r

fn set_node_type_annots(n as ptr[Node], type_annots as ptr[List[Option[ptr[TypeAnnotation]]]]):
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return
    let k as NodeType = (deref n).kind
    if k == NodeType.FunDecl:
        let d as ptr[FunDeclData] = (deref n).data to ptr[FunDeclData]
        (deref d).type_annots = type_annots
    elif k == NodeType.VarDecl:
        let d as ptr[VarDeclData] = (deref n).data to ptr[VarDeclData]
        (deref d).type_annots = type_annots
    elif k == NodeType.FieldDecl:
        let d as ptr[FieldDeclData] = (deref n).data to ptr[FieldDeclData]
        (deref d).type_annots = type_annots
    elif k == NodeType.ClosureExpr:
        let d as ptr[ClosureExprData] = (deref n).data to ptr[ClosureExprData]
        (deref d).type_annots = type_annots
    elif k == NodeType.CallExpr:
        let d as ptr[CallExprData] = (deref n).data to ptr[CallExprData]
        (deref d).type_annots = type_annots

// auto_drops accessor (ReturnStmt, BlockStmt):
fn node_auto_drops(n as ptr[Node]) as List[String]:
    var r as List[String] = List[String]()
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return r
    let k as NodeType = (deref n).kind
    if k == NodeType.ReturnStmt:
        let d as ptr[ReturnStmtData] = (deref n).data to ptr[ReturnStmtData]
        r = (deref d).auto_drops
    elif k == NodeType.BlockStmt:
        let d as ptr[BlockStmtData] = (deref n).data to ptr[BlockStmtData]
        r = (deref d).auto_drops
    return r

fn set_node_auto_drops(n as ptr[Node], drops as List[String]):
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return
    let k as NodeType = (deref n).kind
    if k == NodeType.ReturnStmt:
        let d as ptr[ReturnStmtData] = (deref n).data to ptr[ReturnStmtData]
        (deref d).auto_drops = drops
    elif k == NodeType.BlockStmt:
        let d as ptr[BlockStmtData] = (deref n).data to ptr[BlockStmtData]
        (deref d).auto_drops = drops

// target accessor (ImportDecl):
fn node_target(n as ptr[Node]) as String:
    var r as String = String.make("" to cstr)
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return r
    if (deref n).kind == NodeType.ImportDecl:
        let d as ptr[ImportDeclData] = (deref n).data to ptr[ImportDeclData]
        r = (deref d).target
    return r

fn set_node_target(n as ptr[Node], target as String):
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return
    if (deref n).kind == NodeType.ImportDecl:
        let d as ptr[ImportDeclData] = (deref n).data to ptr[ImportDeclData]
        (deref d).target = target

// imported_symbols accessor (ImportDecl):
fn node_imported_symbols(n as ptr[Node]) as List[String]:
    var r as List[String] = List[String]()
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return r
    if (deref n).kind == NodeType.ImportDecl:
        let d as ptr[ImportDeclData] = (deref n).data to ptr[ImportDeclData]
        r = (deref d).imported_symbols
    return r

fn set_node_imported_symbols(n as ptr[Node], syms as List[String]):
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return
    if (deref n).kind == NodeType.ImportDecl:
        let d as ptr[ImportDeclData] = (deref n).data to ptr[ImportDeclData]
        (deref d).imported_symbols = syms

// alias accessor (ImportDecl):
fn node_alias(n as ptr[Node]) as Option[String]:
    var r as Option[String] = Empty
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return r
    if (deref n).kind == NodeType.ImportDecl:
        let d as ptr[ImportDeclData] = (deref n).data to ptr[ImportDeclData]
        r = (deref d).alias
    return r

fn set_node_alias(n as ptr[Node], alias as Option[String]):
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return
    if (deref n).kind == NodeType.ImportDecl:
        let d as ptr[ImportDeclData] = (deref n).data to ptr[ImportDeclData]
        (deref d).alias = alias

// kind accessor (ImportDecl):
fn node_import_kind(n as ptr[Node]) as ImportKind:
    var r as ImportKind = ImportKind.Normal
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return r
    if (deref n).kind == NodeType.ImportDecl:
        let d as ptr[ImportDeclData] = (deref n).data to ptr[ImportDeclData]
        r = (deref d).kind
    return r

fn set_node_import_kind(n as ptr[Node], kind as ImportKind):
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return
    if (deref n).kind == NodeType.ImportDecl:
        let d as ptr[ImportDeclData] = (deref n).data to ptr[ImportDeclData]
        (deref d).kind = kind

// ── SymbolKind ─────────────────────────────────────────────────────────
enum SymbolKind:
    Variable
    Function
    Struct
    Union
    Enum
    Module
    TypeAlias

// ── Symbol ─────────────────────────────────────────────────────────────
struct Symbol:
    public var name as String
    public var kind as SymbolKind
    public var decl_node as ptr[Node]
    public var sym_type as Option[TypeAnnotation]
    public var is_context_manager as bool
    public var resolved_type as ptr[Type]

// ── Scope ──────────────────────────────────────────────────────────────
struct Scope:
    public var parent as ptr[Scope]
    public var symbols as Dict[String, ptr[Symbol]]
    public var closure_node as ptr[Node]
