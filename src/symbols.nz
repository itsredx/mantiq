// ── Imports ─────────────────────────────────────────────────────────────
import std.collections
from std.string import String
from std.collections import List
from std.collections import Dict
from std.option import Option, Empty
from std.mem import make
import types
from types import Type

// ── LanguageMode ───────────────────────────────────────────────────────
enum LanguageMode:
    Nizam
    Mantiq

// ── Span ───────────────────────────────────────────────────────────────
struct Span:
    public var start_byte as u32
    public var end_byte as u32
    public var start_row as u32
    public var start_col as u32
    public var end_row as u32
    public var end_col as u32

// ── TypeAnnotation ─────────────────────────────────────────────────────
struct TypeAnnotation:
    public var name as String
    public var is_ref as bool
    public var is_mut as bool
    public var lifetime as Option[String]
    public var generics as Option[List[TypeAnnotation]]
    public var params as Option[List[TypeAnnotation]]
    public var return_type as ptr[TypeAnnotation]

// ── NodeType Enum ──────────────────────────────────────────────────────
enum NodeType:
    Program
    ImportDecl
    FunDecl
    VarDecl
    IfStmt
    ClassDecl
    BinaryExpr
    Identifier
    NumberLiteral
    StringLiteral
    MacroDecl
    MacroInvocation
    CallExpr
    ReturnStmt
    WhileStmt
    ForStmt
    MemberExpr
    UnaryExpr
    CastExpr
    BlockStmt
    WithStmt
    MatchStmt
    TryStmt
    ThrowStmt
    ListLiteral
    DictLiteral
    IndexExpr
    SpreadExpr
    BooleanLiteral
    AwaitExpr
    ClosureExpr
    StructDecl
    EnumDecl
    UnionDecl
    FieldDecl

enum ImportKind:
    Normal
    Path
    Vendor
    C
    Pkg

// ── Per-Variant Data Structs ───────────────────────────────────────────
// Each node type has exactly the fields it needs, no more.

struct ProgramData:
    public var declarations as List[ptr[Node]]

struct ImportDeclData:
    public var kind as ImportKind
    public var target as String
    public var imported_symbols as List[String]
    public var alias as Option[String]

struct FunDeclData:
    public var name as String
    public var params as List[ptr[Node]]
    public var body as ptr[Node]
    public var is_async as bool
    public var is_extern as bool
    public var is_variadic as bool
    public var return_type_annot as ptr[TypeAnnotation]
    public var type_annots as ptr[List[Option[ptr[TypeAnnotation]]]]

struct VarDeclData:
    public var name as String
    public var left as ptr[Node]
    public var is_mut as bool
    public var type_annots as ptr[List[Option[ptr[TypeAnnotation]]]]

struct IfStmtData:
    public var cond as ptr[Node]
    public var then_branch as ptr[Node]
    public var else_branch as Option[ptr[Node]]

struct ClassDeclData:
    public var name as String

struct BinaryExprData:
    public var op as String
    public var left as ptr[Node]
    public var right as ptr[Node]

struct IdentifierData:
    public var name as String

struct NumberLiteralData:
    public var val as f64
    public var is_float as bool

struct StringLiteralData:
    public var str_val as String

struct MacroDeclData:
    public var name as String
    public var params as List[ptr[Node]]
    public var body as ptr[Node]

struct MacroInvocationData:
    public var name as String
    public var params as List[ptr[Node]]

struct CallExprData:
    public var left as ptr[Node]
    public var params as List[ptr[Node]]
    public var type_annots as ptr[List[Option[ptr[TypeAnnotation]]]]

struct ReturnStmtData:
    public var body as ptr[Node]
    public var auto_drops as List[String]

struct WhileStmtData:
    public var cond as ptr[Node]
    public var body as ptr[Node]

struct ForStmtData:
    public var name as String
    public var left as ptr[Node]
    public var body as ptr[Node]
    public var is_async as bool

struct MemberExprData:
    public var left as ptr[Node]
    public var name as String

struct UnaryExprData:
    public var op as String
    public var left as ptr[Node]

struct CastExprData:
    public var op as String
    public var left as ptr[Node]

struct BlockStmtData:
    public var declarations as List[ptr[Node]]
    public var auto_drops as List[String]

struct WithStmtData:
    public var left as ptr[Node]
    public var name as String
    public var body as ptr[Node]

struct MatchStmtData:
    public var left as ptr[Node]
    public var declarations as List[ptr[Node]]

struct TryStmtData:
    public var left as ptr[Node]
    public var name as String
    public var body as ptr[Node]

struct ThrowStmtData:
    public var left as ptr[Node]

struct ListLiteralData:
    public var declarations as List[ptr[Node]]

struct DictLiteralData:
    public var declarations as List[ptr[Node]]

struct IndexExprData:
    public var left as ptr[Node]
    public var right as ptr[Node]

struct SpreadExprData:
    public var left as ptr[Node]

struct BooleanLiteralData:
    public var val as f64

struct AwaitExprData:
    public var left as ptr[Node]

struct ClosureExprData:
    public var params as List[ptr[Node]]
    public var body as ptr[Node]
    public var type_annots as ptr[List[Option[ptr[TypeAnnotation]]]]

struct StructDeclData:
    public var name as String
    public var body as ptr[Node]

struct EnumDeclData:
    public var name as String
    public var declarations as List[ptr[Node]]

struct UnionDeclData:
    public var name as String
    public var body as ptr[Node]

struct FieldDeclData:
    public var name as String
    public var type_annots as ptr[List[Option[ptr[TypeAnnotation]]]]

struct OptionLayout:
    public var has_val as u8
    public var val_ptr as ptr[u8]

struct StringOptionLayout:
    public var has_val as u8
    public var val as String

// ── Node ───────────────────────────────────────────────────────────────
// Common header for all node types. Variant-specific data is in data ptr.
struct Node:
    public var kind as NodeType
    public var span as Span
    public var module_name as Option[String]
    public var inferred_type as ptr[Type]
    public var data as ptr[u8]

// ── Node Factory ───────────────────────────────────────────────────────
fn make_node(kind as NodeType, span as Span) as ptr[Node]:
    let n as ptr[Node] = make[Node](1 to usize) to ptr[Node]
    let nk as NodeType = kind
    (deref n).kind = nk
    let sp as Span = span
    (deref n).span = sp
    (deref n).module_name = Empty
    (deref n).inferred_type = None to ptr[Type]
    if nk == NodeType.Program:
        (deref n).data = make[ProgramData](1 to usize) to ptr[u8]
    elif nk == NodeType.ImportDecl:
        (deref n).data = make[ImportDeclData](1 to usize) to ptr[u8]
    elif nk == NodeType.FunDecl:
        (deref n).data = make[FunDeclData](1 to usize) to ptr[u8]
    elif nk == NodeType.VarDecl:
        (deref n).data = make[VarDeclData](1 to usize) to ptr[u8]
    elif nk == NodeType.IfStmt:
        (deref n).data = make[IfStmtData](1 to usize) to ptr[u8]
    elif nk == NodeType.ClassDecl:
        (deref n).data = make[ClassDeclData](1 to usize) to ptr[u8]
    elif nk == NodeType.BinaryExpr:
        (deref n).data = make[BinaryExprData](1 to usize) to ptr[u8]
    elif nk == NodeType.Identifier:
        (deref n).data = make[IdentifierData](1 to usize) to ptr[u8]
    elif nk == NodeType.NumberLiteral:
        (deref n).data = make[NumberLiteralData](1 to usize) to ptr[u8]
    elif nk == NodeType.StringLiteral:
        (deref n).data = make[StringLiteralData](1 to usize) to ptr[u8]
    elif nk == NodeType.MacroDecl:
        (deref n).data = make[MacroDeclData](1 to usize) to ptr[u8]
    elif nk == NodeType.MacroInvocation:
        (deref n).data = make[MacroInvocationData](1 to usize) to ptr[u8]
    elif nk == NodeType.CallExpr:
        (deref n).data = make[CallExprData](1 to usize) to ptr[u8]
    elif nk == NodeType.ReturnStmt:
        (deref n).data = make[ReturnStmtData](1 to usize) to ptr[u8]
    elif nk == NodeType.WhileStmt:
        (deref n).data = make[WhileStmtData](1 to usize) to ptr[u8]
    elif nk == NodeType.ForStmt:
        (deref n).data = make[ForStmtData](1 to usize) to ptr[u8]
    elif nk == NodeType.MemberExpr:
        (deref n).data = make[MemberExprData](1 to usize) to ptr[u8]
    elif nk == NodeType.UnaryExpr:
        (deref n).data = make[UnaryExprData](1 to usize) to ptr[u8]
    elif nk == NodeType.CastExpr:
        (deref n).data = make[CastExprData](1 to usize) to ptr[u8]
    elif nk == NodeType.BlockStmt:
        (deref n).data = make[BlockStmtData](1 to usize) to ptr[u8]
    elif nk == NodeType.WithStmt:
        (deref n).data = make[WithStmtData](1 to usize) to ptr[u8]
    elif nk == NodeType.MatchStmt:
        (deref n).data = make[MatchStmtData](1 to usize) to ptr[u8]
    elif nk == NodeType.TryStmt:
        (deref n).data = make[TryStmtData](1 to usize) to ptr[u8]
    elif nk == NodeType.ThrowStmt:
        (deref n).data = make[ThrowStmtData](1 to usize) to ptr[u8]
    elif nk == NodeType.ListLiteral:
        (deref n).data = make[ListLiteralData](1 to usize) to ptr[u8]
    elif nk == NodeType.DictLiteral:
        (deref n).data = make[DictLiteralData](1 to usize) to ptr[u8]
    elif nk == NodeType.IndexExpr:
        (deref n).data = make[IndexExprData](1 to usize) to ptr[u8]
    elif nk == NodeType.SpreadExpr:
        (deref n).data = make[SpreadExprData](1 to usize) to ptr[u8]
    elif nk == NodeType.BooleanLiteral:
        (deref n).data = make[BooleanLiteralData](1 to usize) to ptr[u8]
    elif nk == NodeType.AwaitExpr:
        (deref n).data = make[AwaitExprData](1 to usize) to ptr[u8]
    elif nk == NodeType.ClosureExpr:
        (deref n).data = make[ClosureExprData](1 to usize) to ptr[u8]
    elif nk == NodeType.StructDecl:
        (deref n).data = make[StructDeclData](1 to usize) to ptr[u8]
    elif nk == NodeType.EnumDecl:
        (deref n).data = make[EnumDeclData](1 to usize) to ptr[u8]
    elif nk == NodeType.UnionDecl:
        (deref n).data = make[UnionDeclData](1 to usize) to ptr[u8]
    elif nk == NodeType.FieldDecl:
        (deref n).data = make[FieldDeclData](1 to usize) to ptr[u8]
    else:
        (deref n).data = None to ptr[u8]
    return n

// ── Node Accessors ─────────────────────────────────────────────────────
// Common field accessors (no cast needed):

fn node_span(n as ptr[Node]) as Span:
    if n == None to ptr[Node]:
        return Span(start_byte = 0 to i32, end_byte = 0 to i32, start_row = 0 to i32, start_col = 0 to i32, end_row = 0 to i32, end_col = 0 to i32)
    return (deref n).span

fn node_kind(n as ptr[Node]) as NodeType:
    if n == None to ptr[Node]:
        return NodeType.Program
    return (deref n).kind

fn node_inferred_type(n as ptr[Node]) as ptr[Type]:
    if n == None to ptr[Node]:
        return None to ptr[Type]
    return (deref n).inferred_type

fn set_node_inferred_type(n as ptr[Node], t as ptr[Type]):
    if n != None to ptr[Node]:
        (deref n).inferred_type = t

fn node_module_name(n as ptr[Node]) as Option[String]:
    if n == None to ptr[Node]:
        return Empty
    return (deref n).module_name

fn set_node_module_name(n as ptr[Node], m as Option[String]):
    if n != None to ptr[Node]:
        (deref n).module_name = m

fn set_node_file_path(n as ptr[Node], path as cstr):
    if n != None to ptr[Node] and path != None to cstr:
        let s_ptr as ptr[String] = make[String](1 to usize) to ptr[String]
        (deref s_ptr) = String.make(path)
        let opt_ref as ptr[OptionLayout] = (ref (deref n).module_name) to ptr[OptionLayout]
        (deref opt_ref).has_val = 1 to u8
        (deref opt_ref).val_ptr = s_ptr to ptr[u8]

fn node_file_path(n as ptr[Node], default_file as String) as String:
    if n == None to ptr[Node]:
        return default_file
    let opt_raw as Option[String] = (deref n).module_name
    let opt_ref as ptr[OptionLayout] = (ref opt_raw) to ptr[OptionLayout]
    if (deref opt_ref).has_val == 1 to u8 and (deref opt_ref).val_ptr != None to ptr[u8]:
        let s_ptr as ptr[String] = (deref opt_ref).val_ptr to ptr[String]
        if s_ptr != None to ptr[String] and (deref s_ptr).data != None to ptr[u8] and (deref s_ptr).len > 0 to usize:
            return deref s_ptr
    return default_file

// name accessor (14 node types have it):
fn node_name(n as ptr[Node]) as String:
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return String.make("" to cstr)
    let k as NodeType = (deref n).kind
    if k == NodeType.FunDecl:
        let d as ptr[FunDeclData] = (deref n).data to ptr[FunDeclData]
        return (deref d).name
    elif k == NodeType.VarDecl:
        let d as ptr[VarDeclData] = (deref n).data to ptr[VarDeclData]
        return (deref d).name
    elif k == NodeType.Identifier:
        let d as ptr[IdentifierData] = (deref n).data to ptr[IdentifierData]
        return (deref d).name
    elif k == NodeType.MemberExpr:
        let d as ptr[MemberExprData] = (deref n).data to ptr[MemberExprData]
        return (deref d).name
    elif k == NodeType.StructDecl:
        let d as ptr[StructDeclData] = (deref n).data to ptr[StructDeclData]
        return (deref d).name
    elif k == NodeType.EnumDecl:
        let d as ptr[EnumDeclData] = (deref n).data to ptr[EnumDeclData]
        return (deref d).name
    elif k == NodeType.UnionDecl:
        let d as ptr[UnionDeclData] = (deref n).data to ptr[UnionDeclData]
        return (deref d).name
    elif k == NodeType.FieldDecl:
        let d as ptr[FieldDeclData] = (deref n).data to ptr[FieldDeclData]
        return (deref d).name
    elif k == NodeType.MacroDecl:
        let d as ptr[MacroDeclData] = (deref n).data to ptr[MacroDeclData]
        return (deref d).name
    elif k == NodeType.MacroInvocation:
        let d as ptr[MacroInvocationData] = (deref n).data to ptr[MacroInvocationData]
        return (deref d).name
    elif k == NodeType.WithStmt:
        let d as ptr[WithStmtData] = (deref n).data to ptr[WithStmtData]
        return (deref d).name
    elif k == NodeType.TryStmt:
        let d as ptr[TryStmtData] = (deref n).data to ptr[TryStmtData]
        return (deref d).name
    elif k == NodeType.ForStmt:
        let d as ptr[ForStmtData] = (deref n).data to ptr[ForStmtData]
        return (deref d).name
    elif k == NodeType.ClassDecl:
        let d as ptr[ClassDeclData] = (deref n).data to ptr[ClassDeclData]
        return (deref d).name
    return String.make("" to cstr)

fn node_name_ptr(n as ptr[Node]) as ptr[String]:
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return None to ptr[String]
    let k as NodeType = (deref n).kind
    if k == NodeType.FunDecl:
        let d as ptr[FunDeclData] = (deref n).data to ptr[FunDeclData]
        return ref (deref d).name
    elif k == NodeType.VarDecl:
        let d as ptr[VarDeclData] = (deref n).data to ptr[VarDeclData]
        return ref (deref d).name
    elif k == NodeType.Identifier:
        let d as ptr[IdentifierData] = (deref n).data to ptr[IdentifierData]
        return ref (deref d).name
    elif k == NodeType.MemberExpr:
        let d as ptr[MemberExprData] = (deref n).data to ptr[MemberExprData]
        return ref (deref d).name
    elif k == NodeType.StructDecl:
        let d as ptr[StructDeclData] = (deref n).data to ptr[StructDeclData]
        return ref (deref d).name
    elif k == NodeType.EnumDecl:
        let d as ptr[EnumDeclData] = (deref n).data to ptr[EnumDeclData]
        return ref (deref d).name
    elif k == NodeType.UnionDecl:
        let d as ptr[UnionDeclData] = (deref n).data to ptr[UnionDeclData]
        return ref (deref d).name
    elif k == NodeType.FieldDecl:
        let d as ptr[FieldDeclData] = (deref n).data to ptr[FieldDeclData]
        return ref (deref d).name
    elif k == NodeType.MacroDecl:
        let d as ptr[MacroDeclData] = (deref n).data to ptr[MacroDeclData]
        return ref (deref d).name
    elif k == NodeType.MacroInvocation:
        let d as ptr[MacroInvocationData] = (deref n).data to ptr[MacroInvocationData]
        return ref (deref d).name
    elif k == NodeType.WithStmt:
        let d as ptr[WithStmtData] = (deref n).data to ptr[WithStmtData]
        return ref (deref d).name
    elif k == NodeType.TryStmt:
        let d as ptr[TryStmtData] = (deref n).data to ptr[TryStmtData]
        return ref (deref d).name
    elif k == NodeType.ForStmt:
        let d as ptr[ForStmtData] = (deref n).data to ptr[ForStmtData]
        return ref (deref d).name
    elif k == NodeType.ClassDecl:
        let d as ptr[ClassDeclData] = (deref n).data to ptr[ClassDeclData]
        return ref (deref d).name
    return None to ptr[String]

fn set_node_name(n as ptr[Node], name as String):
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return
    let k as NodeType = (deref n).kind
    if k == NodeType.FunDecl:
        let d as ptr[FunDeclData] = (deref n).data to ptr[FunDeclData]
        (deref d).name = name
    elif k == NodeType.VarDecl:
        let d as ptr[VarDeclData] = (deref n).data to ptr[VarDeclData]
        (deref d).name = name
    elif k == NodeType.Identifier:
        let d as ptr[IdentifierData] = (deref n).data to ptr[IdentifierData]
        (deref d).name = name
    elif k == NodeType.MemberExpr:
        let d as ptr[MemberExprData] = (deref n).data to ptr[MemberExprData]
        (deref d).name = name
    elif k == NodeType.StructDecl:
        let d as ptr[StructDeclData] = (deref n).data to ptr[StructDeclData]
        (deref d).name = name
    elif k == NodeType.EnumDecl:
        let d as ptr[EnumDeclData] = (deref n).data to ptr[EnumDeclData]
        (deref d).name = name
    elif k == NodeType.UnionDecl:
        let d as ptr[UnionDeclData] = (deref n).data to ptr[UnionDeclData]
        (deref d).name = name
    elif k == NodeType.FieldDecl:
        let d as ptr[FieldDeclData] = (deref n).data to ptr[FieldDeclData]
        (deref d).name = name
    elif k == NodeType.MacroDecl:
        let d as ptr[MacroDeclData] = (deref n).data to ptr[MacroDeclData]
        (deref d).name = name
    elif k == NodeType.MacroInvocation:
        let d as ptr[MacroInvocationData] = (deref n).data to ptr[MacroInvocationData]
        (deref d).name = name
    elif k == NodeType.WithStmt:
        let d as ptr[WithStmtData] = (deref n).data to ptr[WithStmtData]
        (deref d).name = name
    elif k == NodeType.TryStmt:
        let d as ptr[TryStmtData] = (deref n).data to ptr[TryStmtData]
        (deref d).name = name
    elif k == NodeType.ForStmt:
        let d as ptr[ForStmtData] = (deref n).data to ptr[ForStmtData]
        (deref d).name = name
    elif k == NodeType.ClassDecl:
        let d as ptr[ClassDeclData] = (deref n).data to ptr[ClassDeclData]
        (deref d).name = name

// left accessor (14 node types have it):
fn node_left(n as ptr[Node]) as ptr[Node]:
    var r as ptr[Node] = None to ptr[Node]
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return r
    let k as NodeType = (deref n).kind
    if k == NodeType.BinaryExpr:
        let d as ptr[BinaryExprData] = (deref n).data to ptr[BinaryExprData]
        r = (deref d).left
    elif k == NodeType.CallExpr:
        let d as ptr[CallExprData] = (deref n).data to ptr[CallExprData]
        r = (deref d).left
    elif k == NodeType.UnaryExpr:
        let d as ptr[UnaryExprData] = (deref n).data to ptr[UnaryExprData]
        r = (deref d).left
    elif k == NodeType.CastExpr:
        let d as ptr[CastExprData] = (deref n).data to ptr[CastExprData]
        r = (deref d).left
    elif k == NodeType.MemberExpr:
        let d as ptr[MemberExprData] = (deref n).data to ptr[MemberExprData]
        r = (deref d).left
    elif k == NodeType.VarDecl:
        let d as ptr[VarDeclData] = (deref n).data to ptr[VarDeclData]
        r = (deref d).left
    elif k == NodeType.ReturnStmt:
        let d as ptr[ReturnStmtData] = (deref n).data to ptr[ReturnStmtData]
        r = (deref d).body
    elif k == NodeType.ThrowStmt:
        let d as ptr[ThrowStmtData] = (deref n).data to ptr[ThrowStmtData]
        r = (deref d).left
    elif k == NodeType.SpreadExpr:
        let d as ptr[SpreadExprData] = (deref n).data to ptr[SpreadExprData]
        r = (deref d).left
    elif k == NodeType.AwaitExpr:
        let d as ptr[AwaitExprData] = (deref n).data to ptr[AwaitExprData]
        r = (deref d).left
    elif k == NodeType.ForStmt:
        let d as ptr[ForStmtData] = (deref n).data to ptr[ForStmtData]
        r = (deref d).left
    elif k == NodeType.IndexExpr:
        let d as ptr[IndexExprData] = (deref n).data to ptr[IndexExprData]
        r = (deref d).left
    elif k == NodeType.WithStmt:
        let d as ptr[WithStmtData] = (deref n).data to ptr[WithStmtData]
        r = (deref d).left
    elif k == NodeType.MatchStmt:
        let d as ptr[MatchStmtData] = (deref n).data to ptr[MatchStmtData]
        r = (deref d).left
    elif k == NodeType.TryStmt:
        let d as ptr[TryStmtData] = (deref n).data to ptr[TryStmtData]
        r = (deref d).left
    return r

fn set_node_left(n as ptr[Node], left as ptr[Node]):
    if n == None to ptr[Node] or (deref n).data == None to ptr[u8]:
        return
    let k as NodeType = (deref n).kind
    if k == NodeType.BinaryExpr:
        let d as ptr[BinaryExprData] = (deref n).data to ptr[BinaryExprData]
        (deref d).left = left
    elif k == NodeType.CallExpr:
        let d as ptr[CallExprData] = (deref n).data to ptr[CallExprData]
        (deref d).left = left
    elif k == NodeType.UnaryExpr:
        let d as ptr[UnaryExprData] = (deref n).data to ptr[UnaryExprData]
        (deref d).left = left
    elif k == NodeType.CastExpr:
        let d as ptr[CastExprData] = (deref n).data to ptr[CastExprData]
        (deref d).left = left
    elif k == NodeType.MemberExpr:
        let d as ptr[MemberExprData] = (deref n).data to ptr[MemberExprData]
        (deref d).left = left
    elif k == NodeType.VarDecl:
        let d as ptr[VarDeclData] = (deref n).data to ptr[VarDeclData]
        (deref d).left = left
    elif k == NodeType.ThrowStmt:
        let d as ptr[ThrowStmtData] = (deref n).data to ptr[ThrowStmtData]
        (deref d).left = left
    elif k == NodeType.SpreadExpr:
        let d as ptr[SpreadExprData] = (deref n).data to ptr[SpreadExprData]
        (deref d).left = left
    elif k == NodeType.AwaitExpr:
        let d as ptr[AwaitExprData] = (deref n).data to ptr[AwaitExprData]
        (deref d).left = left
    elif k == NodeType.ForStmt:
        let d as ptr[ForStmtData] = (deref n).data to ptr[ForStmtData]
        (deref d).left = left
    elif k == NodeType.IndexExpr:
        let d as ptr[IndexExprData] = (deref n).data to ptr[IndexExprData]
        (deref d).left = left
    elif k == NodeType.WithStmt:
        let d as ptr[WithStmtData] = (deref n).data to ptr[WithStmtData]
        (deref d).left = left
    elif k == NodeType.MatchStmt:
