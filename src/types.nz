// ── Imports ─────────────────────────────────────────────────────────────
import std.collections
from std.string import String
from std.collections import List
from std.mem import make

// ── TypeKind ────────────────────────────────────────────────────────────
enum TypeKind:
    I8
    I16
    I32
    I64
    I128
    ISize
    U8
    U16
    U32
    U64
    U128
    USize
    F16
    BFloat16
    F32
    F64
    F128
    Boolean
    Char
    String
    CStr
    AsciiStr
    Utf8Str
    WebStr
    RangeStr
    Slice
    List
    Tuple
    Dict
    Result
    Option
    Task
    QBit
    QReg
    Closure
    Class
    Interface
    Error
    Struct
    Enum
    Union
    Module
    Function
    RawPointer
    Unknown
    Any
    Void

// ── Type ────────────────────────────────────────────────────────────────
struct Type:
    public var kind as TypeKind
    public var payload as ptr[Type]
    public var tuple_types as List[Type]
    public var name as String
    public var param_types as List[Type]
    public var return_type as ptr[Type]

// ── Helper Constructors ──────────────────────────────────────────────────
extern fn memset(ptr as ptr[u8], val as i32, num as usize) as ptr[u8]

fn make_type(kind as TypeKind) as ptr[Type]:
    let t as ptr[Type] = make[u8](256 to usize) to ptr[Type]
    let _ as ptr[u8] = memset(t to ptr[u8], 0 to i32, 256 to usize)
    (deref t).kind = kind
    (deref t).payload = None to ptr[Type]
    (deref t).return_type = None to ptr[Type]
    return t

fn make_ptr_type(element as ptr[Type]) as ptr[Type]:
    let t as ptr[Type] = make_type(TypeKind.RawPointer)
    (deref t).payload = element
    return t

fn make_struct_type(name as String) as ptr[Type]:
    let t as ptr[Type] = make_type(TypeKind.Struct)
    (deref t).name = name
    return t

fn make_enum_type(name as String) as ptr[Type]:
    let t as ptr[Type] = make_type(TypeKind.Enum)
    (deref t).name = name
    return t

fn make_union_type(name as String) as ptr[Type]:
    let t as ptr[Type] = make_type(TypeKind.Union)
    (deref t).name = name
    return t

// ── Copy/Move Type Classification ──────────────────────────────────────
fn is_copy_type(t as ptr[Type]) as bool:
    if t == None to ptr[Type]:
        return False
    let k as TypeKind = (deref t).kind
    if k == TypeKind.I8:
        return True
    if k == TypeKind.I16:
        return True
    if k == TypeKind.I32:
        return True
    if k == TypeKind.I64:
        return True
    if k == TypeKind.I128:
        return True
    if k == TypeKind.ISize:
        return True
    if k == TypeKind.U8:
        return True
    if k == TypeKind.U16:
        return True
    if k == TypeKind.U32:
        return True
    if k == TypeKind.U64:
        return True
    if k == TypeKind.U128:
        return True
    if k == TypeKind.USize:
        return True
    if k == TypeKind.F16:
        return True
    if k == TypeKind.BFloat16:
        return True
    if k == TypeKind.F32:
        return True
    if k == TypeKind.F64:
        return True
    if k == TypeKind.F128:
        return True
    if k == TypeKind.Boolean:
        return True
    if k == TypeKind.Char:
        return True
    if k == TypeKind.CStr:
        return True
    if k == TypeKind.AsciiStr:
        return True
    if k == TypeKind.Utf8Str:
        return True
    if k == TypeKind.WebStr:
        return True
    if k == TypeKind.RangeStr:
        return True
    if k == TypeKind.Function:
        return True
    if k == TypeKind.Closure:
        return True
    if k == TypeKind.RawPointer:
        return True
    if k == TypeKind.Option:
        let pt as ptr[Type] = (deref t).payload
        if pt != None to ptr[Type]:
            return is_copy_type(pt)
        return True
    if k == TypeKind.Enum:
        return True
    return False

fn is_move_type(t as ptr[Type]) as bool:
    return not is_copy_type(t)
