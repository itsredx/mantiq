            append_cstr(ref (deref self).main_out, key_alloc to cstr)
            append_cstr(ref (deref self).main_out, ", i32 ")
            append_cstr(ref (deref self).main_out, hash_reg to cstr)
            append_cstr(ref (deref self).main_out, ")\n")
            let rem_b as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, rem_b to cstr)
            append_cstr(ref (deref self).main_out, " = icmp eq i8 ")
            append_cstr(ref (deref self).main_out, res_v to cstr)
            append_cstr(ref (deref self).main_out, ", 1\n")
            let rl_addr as ptr[u8] = self.emit_lvalue_ptr(obj_node)
            let rl_gep as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, rl_gep to cstr)
            append_cstr(ref (deref self).main_out, " = getelementptr { ptr, i64, i64 }, ptr ")
            append_cstr(ref (deref self).main_out, rl_addr to cstr)
            append_cstr(ref (deref self).main_out, ", i32 0, i32 1\n")
            let rl_old as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, rl_old to cstr)
            append_cstr(ref (deref self).main_out, " = load i64, ptr ")
            append_cstr(ref (deref self).main_out, rl_gep to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            let rl_new as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, rl_new to cstr)
            append_cstr(ref (deref self).main_out, " = sub i64 ")
            append_cstr(ref (deref self).main_out, rl_old to cstr)
            append_cstr(ref (deref self).main_out, ", 1\n")
            let rl_sel as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, rl_sel to cstr)
            append_cstr(ref (deref self).main_out, " = select i1 ")
            append_cstr(ref (deref self).main_out, rem_b to cstr)
            append_cstr(ref (deref self).main_out, ", i64 ")
            append_cstr(ref (deref self).main_out, rl_new to cstr)
            append_cstr(ref (deref self).main_out, ", i64 ")
            append_cstr(ref (deref self).main_out, rl_old to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, "  store i64 ")
            append_cstr(ref (deref self).main_out, rl_sel to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, rl_gep to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            let rem_z as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, rem_z to cstr)
            append_cstr(ref (deref self).main_out, " = zext i1 ")
            append_cstr(ref (deref self).main_out, rem_b to cstr)
            append_cstr(ref (deref self).main_out, " to i8\n")
            return rem_z
        if strcmp(mname, "keys") == 0 and is_dict:
            let k_rec as ptr[u8] = self.emit_expr(obj_node)
            var kd_p as ptr[u8] = k_rec
            if (deref k_rec) == 37 to u8:
                let kext as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, kext to cstr)
                append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
                append_cstr(ref (deref self).main_out, k_rec to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")
                kd_p = kext
            let kl_alloc as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, kl_alloc to cstr)
            append_cstr(ref (deref self).main_out, " = alloca { ptr, i64, i64 }\n")
            append_cstr(ref (deref self).main_out, "  store { ptr, i64, i64 } zeroinitializer, ptr ")
            append_cstr(ref (deref self).main_out, kl_alloc to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, "  call void @__mantiq_dict_keys(ptr ")
            append_cstr(ref (deref self).main_out, kd_p to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, kl_alloc to cstr)
            append_cstr(ref (deref self).main_out, ", i32 24)\n")
            let kl_val as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, kl_val to cstr)
            append_cstr(ref (deref self).main_out, " = load { ptr, i64, i64 }, ptr ")
            append_cstr(ref (deref self).main_out, kl_alloc to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return kl_val
        return None to ptr[u8]

    public fn emit_return(self as ptr[LLVMCodegen], node as ptr[Node]):
        let drops as List[String] = node_auto_drops(node)
        if drops.length() > 0 to i64:
            self.emit_auto_drops(drops)

        if (deref self).active_param_block != None to ptr[Node]:
            let apb as ptr[Node] = (deref self).active_param_block
            let ret_names as List[String] = node_return_names(apb)
            let val as ptr[Node] = node_body(node)
            if val != None to ptr[Node]:
                if node_kind(val) == NodeType.ListLiteral:
                    let ret_exprs as List[ptr[Node]] = node_declarations(val)
                    let expr_count as i64 = ret_exprs.length()
                    var ei as i64 = 0 to i64
                    while ei < expr_count:
                        if ei < ret_names.length():
                            let r_name_str as String = ret_names[ei]
                            if r_name_str.data != None to ptr[u8] and r_name_str.len > 0 to usize:
                                let r_cstr as cstr = r_name_str.data to cstr
                                let r_name as String = String.make(r_cstr)
                                var r_slot as String = r_name
                                var r_type as String = String.make("i64" to cstr)
                                if (deref self).var_slots.has(r_name):
                                    r_slot = (deref self).var_slots[r_name]
                                if (deref self).var_types.has(r_name):
                                    r_type = (deref self).var_types[r_name]
                                let r_expr as ptr[Node] = ret_exprs[ei]
                                let val_reg as ptr[u8] = self.emit_expr(r_expr)

                                var real_val as ptr[u8] = val_reg
                                let expr_t_str as String = type_to_llvm(node_inferred_type(r_expr))
                                if strcmp(r_type.data to cstr, "i64" to cstr) == 0 and strcmp(expr_t_str.data to cstr, "i32" to cstr) == 0:
                                    let ext_reg as ptr[u8] = self.fresh_temp()
                                    append_cstr(ref (deref self).main_out, "  ")
                                    append_cstr(ref (deref self).main_out, ext_reg to cstr)
                                    append_cstr(ref (deref self).main_out, " = sext i32 ")
                                    append_cstr(ref (deref self).main_out, val_reg to cstr)
                                    append_cstr(ref (deref self).main_out, " to i64\n")
                                    real_val = ext_reg

                                append_cstr(ref (deref self).main_out, "  store ")
                                append_str(ref (deref self).main_out, r_type)
                                append_cstr(ref (deref self).main_out, " ")
                                append_cstr(ref (deref self).main_out, real_val to cstr)
                                append_cstr(ref (deref self).main_out, ", ptr %")
                                append_str(ref (deref self).main_out, r_slot)
                                append_cstr(ref (deref self).main_out, "\n")
                        ei = ei + 1 to i64
                else:
                    let val_reg as ptr[u8] = self.emit_expr(val)
                    if ret_names.length() > 0 to i64:
                        let r_name_str as String = ret_names[0]
                        if r_name_str.data != None to ptr[u8] and r_name_str.len > 0 to usize:
                            let r_cstr as cstr = r_name_str.data to cstr
                            let r_name as String = String.make(r_cstr)
                            var r_slot as String = r_name
                            var r_type as String = String.make("i64" to cstr)
                            if (deref self).var_slots.has(r_name):
                                r_slot = (deref self).var_slots[r_name]
                            if (deref self).var_types.has(r_name):
                                r_type = (deref self).var_types[r_name]

                            var real_val as ptr[u8] = val_reg
                            let expr_t_str as String = type_to_llvm(node_inferred_type(val))
                            if strcmp(r_type.data to cstr, "i64" to cstr) == 0 and strcmp(expr_t_str.data to cstr, "i32" to cstr) == 0:
                                let ext_reg as ptr[u8] = self.fresh_temp()
                                append_cstr(ref (deref self).main_out, "  ")
                                append_cstr(ref (deref self).main_out, ext_reg to cstr)
                                append_cstr(ref (deref self).main_out, " = sext i32 ")
                                append_cstr(ref (deref self).main_out, val_reg to cstr)
                                append_cstr(ref (deref self).main_out, " to i64\n")
                                real_val = ext_reg

                            append_cstr(ref (deref self).main_out, "  store ")
                            append_str(ref (deref self).main_out, r_type)
                            append_cstr(ref (deref self).main_out, " ")
                            append_cstr(ref (deref self).main_out, real_val to cstr)
                            append_cstr(ref (deref self).main_out, ", ptr %")
                            append_str(ref (deref self).main_out, r_slot)
                            append_cstr(ref (deref self).main_out, "\n")

            if (deref self).active_block_exit.len > 0 to usize:
                append_cstr(ref (deref self).main_out, "  br label %")
                append_str(ref (deref self).main_out, (deref self).active_block_exit)
                append_cstr(ref (deref self).main_out, "\n")
            return

        let val as ptr[Node] = node_body(node)
        if val != None to ptr[Node]:
            var ret_type as String = (deref self).current_return_type
            if strcmp(ret_type.data to cstr, "void" to cstr) == 0:
                ret_type = type_to_llvm(node_inferred_type(val))
            let val_reg as ptr[u8] = self.emit_expr(val)
            if strcmp(ret_type.data to cstr, "void" to cstr) == 0:
                if (deref val_reg) == 37 to u8:
                    ret_type = String.make("ptr" to cstr)
            var real_val as ptr[u8] = val_reg
            if strcmp(ret_type.data to cstr, "{ ptr, i64, i64 }" to cstr) == 0 and (deref val_reg) == 37 to u8:
                let val_t_str as String = type_to_llvm(node_inferred_type(val))
                var is_raw_ptr as bool = False
                if strcmp(val_t_str.data to cstr, "{ ptr, i64, i64 }" to cstr) != 0:
                    is_raw_ptr = True
                if node_kind(val) == NodeType.CallExpr:
                    let c_node as ptr[Node] = node_left(val)
                    if c_node != None to ptr[Node] and node_kind(c_node) == NodeType.Identifier:
                        let c_name_ptr as ptr[String] = node_name_ptr(c_node)
                        if c_name_ptr != None to ptr[String] and (deref c_name_ptr).data != None:
                            if strcmp((deref c_name_ptr).data to cstr, "String" to cstr) == 0:
                                is_raw_ptr = False
                if is_raw_ptr:
                    let i1_reg as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, i1_reg to cstr)
                    append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } undef, ptr ")
                    append_cstr(ref (deref self).main_out, val_reg to cstr)
                    append_cstr(ref (deref self).main_out, ", 0\n")

                    let i2_reg as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, i2_reg to cstr)
                    append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } ")
                    append_cstr(ref (deref self).main_out, i1_reg to cstr)
                    append_cstr(ref (deref self).main_out, ", i64 0, 1\n")

                    let i3_reg as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, i3_reg to cstr)
                    append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } ")
                    append_cstr(ref (deref self).main_out, i2_reg to cstr)
                    append_cstr(ref (deref self).main_out, ", i64 0, 2\n")

                    real_val = i3_reg
            var ret_needs_zext as bool = False
            if node_kind(val) == NodeType.BinaryExpr:
                let rv_op as String = node_op(val)
                if rv_op.data != None to ptr[u8]:
                    let rv_op_c as cstr = rv_op.data to cstr
                    if strcmp(rv_op_c, "==" to cstr) == 0 or strcmp(rv_op_c, "!=" to cstr) == 0 or strcmp(rv_op_c, "<" to cstr) == 0 or strcmp(rv_op_c, ">" to cstr) == 0 or strcmp(rv_op_c, "<=" to cstr) == 0 or strcmp(rv_op_c, ">=" to cstr) == 0 or strcmp(rv_op_c, "and" to cstr) == 0 or strcmp(rv_op_c, "or" to cstr) == 0:
                        ret_needs_zext = True
            elif node_kind(val) == NodeType.BooleanLiteral:
                ret_needs_zext = True
            elif node_kind(val) == NodeType.UnaryExpr:
                let rv_uop as String = node_op(val)
                if rv_uop.data != None to ptr[u8] and strcmp(rv_uop.data to cstr, "not" to cstr) == 0:
                    ret_needs_zext = True
            if strcmp(ret_type.data to cstr, "i8" to cstr) == 0 and ret_needs_zext:
                let b_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, b_temp to cstr)
                append_cstr(ref (deref self).main_out, " = zext i1 ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, " to i8\n")
                real_val = b_temp
            elif strcmp(ret_type.data to cstr, "float" to cstr) == 0:
                let val_t_str as String = type_to_llvm(node_inferred_type(val))
                if strcmp(val_t_str.data to cstr, "double" to cstr) == 0:
                    let f_temp as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, f_temp to cstr)
                    append_cstr(ref (deref self).main_out, " = fptrunc double ")
                    append_cstr(ref (deref self).main_out, real_val to cstr)
                    append_cstr(ref (deref self).main_out, " to float\n")
                    real_val = f_temp
            elif strcmp(ret_type.data to cstr, "double" to cstr) == 0:
                let val_t_str as String = type_to_llvm(node_inferred_type(val))
                if strcmp(val_t_str.data to cstr, "float" to cstr) == 0:
                    let f_temp as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, f_temp to cstr)
                    append_cstr(ref (deref self).main_out, " = fpext float ")
                    append_cstr(ref (deref self).main_out, real_val to cstr)
                    append_cstr(ref (deref self).main_out, " to double\n")
                    real_val = f_temp
            append_cstr(ref (deref self).main_out, "  ret ")
            append_str(ref (deref self).main_out, ret_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, real_val to cstr)
            append_cstr(ref (deref self).main_out, "\n")
        else:
            let cur_ret as String = (deref self).current_return_type
            if strcmp(cur_ret.data to cstr, "i32" to cstr) == 0:
                append_cstr(ref (deref self).main_out, "  ret i32 0\n")
            elif strcmp(cur_ret.data to cstr, "void" to cstr) == 0:
                append_cstr(ref (deref self).main_out, "  ret void\n")
            else:
                append_cstr(ref (deref self).main_out, "  ret ")
                append_str(ref (deref self).main_out, cur_ret)
                append_cstr(ref (deref self).main_out, " undef\n")

    public fn emit_if(self as ptr[LLVMCodegen], node as ptr[Node]):
        let cond as ptr[Node] = node_cond(node)
        let then_b as ptr[Node] = node_then_branch(node)
        let else_b_raw as Option[ptr[Node]] = node_else_branch(node)
        let else_b_ref as ptr[OptionLayout] = (ref else_b_raw) to ptr[OptionLayout]

        let then_label as ptr[u8] = self.fresh_label()
        let else_label as ptr[u8] = self.fresh_label()
        let end_label as ptr[u8] = self.fresh_label()

        let cond_reg as ptr[u8] = self.emit_expr(cond)
        var cond_type as String = cond_llvm_type(cond)
        var is_not_uop as bool = False
        if node_kind(cond) == NodeType.UnaryExpr:
            let cond_op_str as String = node_op(cond)
            if cond_op_str.data != None to ptr[u8]:
                if strcmp(cond_op_str.data to cstr, "not" to cstr) == 0:
                    is_not_uop = True
        if is_not_uop:
            cond_type = String.make("i1" to cstr)
        var cond_bool as ptr[u8] = cond_reg

        let is_cmp as bool = node_kind(cond) == NodeType.BinaryExpr or node_kind(cond) == NodeType.BooleanLiteral or is_not_uop
        if strcmp(cond_type.data to cstr, "ptr" to cstr) == 0:
            let temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, temp to cstr)
            append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
            append_cstr(ref (deref self).main_out, cond_reg to cstr)
            append_cstr(ref (deref self).main_out, ", null\n")
            cond_bool = temp
        elif not is_cmp and strcmp(cond_type.data to cstr, "i1" to cstr) != 0:
            let temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, temp to cstr)
            append_cstr(ref (deref self).main_out, " = icmp ne ")
            append_str(ref (deref self).main_out, cond_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, cond_reg to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")
            cond_bool = temp

        if option_has_value(else_b_ref):
            append_cstr(ref (deref self).main_out, "  br i1 ")
            append_cstr(ref (deref self).main_out, cond_bool to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, then_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, else_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")
        else:
            append_cstr(ref (deref self).main_out, "  br i1 ")
            append_cstr(ref (deref self).main_out, cond_bool to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, then_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, end_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

        append_cstr(ref (deref self).main_out, "\n")
        append_cstr(ref (deref self).main_out, then_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")
        self.emit_node(then_b)
        append_cstr(ref (deref self).main_out, "  br label %")
        append_cstr(ref (deref self).main_out, end_label to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        if option_has_value(else_b_ref):
            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, else_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            self.emit_node(option_unwrap_ptr(else_b_ref))
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, end_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

        append_cstr(ref (deref self).main_out, "\n")
        append_cstr(ref (deref self).main_out, end_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")

    public fn emit_match_stmt(self as ptr[LLVMCodegen], node as ptr[Node]):
        let subject_node as ptr[Node] = node_left(node)
        if subject_node == None to ptr[Node]:
            return

        let subject_reg as ptr[u8] = self.emit_expr(subject_node)
        var subject_type as String = type_to_llvm(node_inferred_type(subject_node))
        if subject_type.len == 0 to usize or strcmp(subject_type.data to cstr, "void" to cstr) == 0:
            subject_type = String.make("i32" to cstr)

        let is_ptr_subject as bool = strcmp(subject_type.data to cstr, "ptr" to cstr) == 0
        var subj_slot as ptr[u8] = subject_reg
        if not is_ptr_subject and subject_type.len > 0 to usize and deref (subject_type.data) == 37 to u8:
            let temp_slot as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, temp_slot to cstr)
            append_cstr(ref (deref self).main_out, " = alloca ")
            append_str(ref (deref self).main_out, subject_type)
            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, subject_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, subject_reg to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, temp_slot to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            subj_slot = temp_slot

        let cases as List[ptr[Node]] = node_declarations(node)
        let case_count as i64 = cases.length()
        let end_label as ptr[u8] = self.fresh_label()

        let case_labels as List[ptr[u8]] = List[ptr[u8]]()
        var ci as i64 = 0 to i64
        while ci < case_count:
            case_labels.append(self.fresh_label())
            ci = ci + 1 to i64

        if case_count > 0 to i64:
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, case_labels[0 to i64] to cstr)
            append_cstr(ref (deref self).main_out, "\n")
        else:
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, end_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

        ci = 0 to i64
        while ci < case_count:
            let case_node as ptr[Node] = cases[ci]
            let curr_case_lbl as ptr[u8] = case_labels[ci]
            var next_lbl as ptr[u8] = end_label
            if ci + 1 to i64 < case_count:
                next_lbl = case_labels[ci + 1 to i64]

            let body_label as ptr[u8] = self.fresh_label()
            let guard_label as ptr[u8] = self.fresh_label()

            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, curr_case_lbl to cstr)
            append_cstr(ref (deref self).main_out, ":\n")

            let pat_wrapper as ptr[Node] = node_left(case_node)
            let case_body as ptr[Node] = node_right(case_node)
            var inner_pat as ptr[Node] = pat_wrapper
            var guard_expr as ptr[Node] = None to ptr[Node]
            if pat_wrapper != None to ptr[Node]:
                if node_kind(pat_wrapper) == NodeType.BinaryExpr and strcmp(node_op(pat_wrapper).data to cstr, "if" to cstr) == 0:
                    inner_pat = node_left(pat_wrapper)
                    guard_expr = node_right(pat_wrapper)

            var is_wildcard as bool = False
            var is_call_pat as bool = False
            var matched_cond as ptr[u8] = "1" to ptr[u8]

            if inner_pat != None to ptr[Node]:
                let pat_k as NodeType = node_kind(inner_pat)
                if pat_k == NodeType.Identifier:
                    let pat_name as String = node_name(inner_pat)
                    if strcmp(pat_name.data to cstr, "_" to cstr) == 0:
                        is_wildcard = True
                        matched_cond = "1" to ptr[u8]
                    elif (deref self).enum_variant_tags.has(pat_name):
                        let v_tag as i32 = (deref self).enum_variant_tags[pat_name]
                        let tag_ptr as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, tag_ptr to cstr)
                        append_cstr(ref (deref self).main_out, " = getelementptr inbounds { i32, [32 x i8] }, ptr ")
                        append_cstr(ref (deref self).main_out, subj_slot to cstr)
                        append_cstr(ref (deref self).main_out, ", i32 0, i32 0\n")

                        let tag_val as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, tag_val to cstr)
                        append_cstr(ref (deref self).main_out, " = load i32, ptr ")
                        append_cstr(ref (deref self).main_out, tag_ptr to cstr)
                        append_cstr(ref (deref self).main_out, "\n")

                        let cmp as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, cmp to cstr)
                        append_cstr(ref (deref self).main_out, " = icmp eq i32 ")
                        append_cstr(ref (deref self).main_out, tag_val to cstr)
                        append_cstr(ref (deref self).main_out, ", ")
                        let t_buf as ptr[u8] = make[u8](16 to usize) to ptr[u8]
                        let _st as i32 = sprintf(t_buf, "%d" to cstr, v_tag)
                        append_cstr(ref (deref self).main_out, t_buf to cstr)
                        free(t_buf to ptr)
                        append_cstr(ref (deref self).main_out, "\n")
                        matched_cond = cmp
                    else:
                        var count as i32 = 0 to i32
                        if (deref self).var_counts.has(pat_name):
                            count = (deref self).var_counts[pat_name]
                        set_dict_i32(ref (deref self).var_counts, pat_name, count + 1 to i32)
                        var slot_name as String = pat_name
                        if count > 0 to i32:
                            let slot_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
                            let _ as i32 = sprintf(slot_buf, "%s_%d" to cstr, pat_name.data to cstr, count)
                            slot_name = String.make(slot_buf to cstr)
                        set_dict_str(ref (deref self).var_slots, pat_name, slot_name)
                        set_dict_str(ref (deref self).var_types, pat_name, subject_type)

                        append_cstr(ref (deref self).main_out, "  %")
                        append_str(ref (deref self).main_out, slot_name)
                        append_cstr(ref (deref self).main_out, " = alloca ")
                        append_str(ref (deref self).main_out, subject_type)
                        append_cstr(ref (deref self).main_out, "\n")

                        append_cstr(ref (deref self).main_out, "  store ")
                        append_str(ref (deref self).main_out, subject_type)
                        append_cstr(ref (deref self).main_out, " ")
                        append_cstr(ref (deref self).main_out, subject_reg to cstr)
                        append_cstr(ref (deref self).main_out, ", ptr %")
                        append_str(ref (deref self).main_out, slot_name)
                        append_cstr(ref (deref self).main_out, "\n")

                        is_wildcard = True
                        matched_cond = "1" to ptr[u8]
                elif pat_k == NodeType.CallExpr:
                    is_call_pat = True
                    let callee as ptr[Node] = node_left(inner_pat)
                    let callee_name as String = node_name(callee)
                    var v_tag as i32 = 0 to i32
                    if (deref self).enum_variant_tags.has(callee_name):
                        v_tag = (deref self).enum_variant_tags[callee_name]

                    let tag_ptr as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, tag_ptr to cstr)
                    append_cstr(ref (deref self).main_out, " = getelementptr inbounds { i32, [32 x i8] }, ptr ")
                    append_cstr(ref (deref self).main_out, subj_slot to cstr)
                    append_cstr(ref (deref self).main_out, ", i32 0, i32 0\n")

                    let tag_val as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, tag_val to cstr)
                    append_cstr(ref (deref self).main_out, " = load i32, ptr ")
                    append_cstr(ref (deref self).main_out, tag_ptr to cstr)
                    append_cstr(ref (deref self).main_out, "\n")

                    let cmp as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, cmp to cstr)
                    append_cstr(ref (deref self).main_out, " = icmp eq i32 ")
                    append_cstr(ref (deref self).main_out, tag_val to cstr)
                    append_cstr(ref (deref self).main_out, ", ")
                    let t_buf as ptr[u8] = make[u8](16 to usize) to ptr[u8]
                    let _st as i32 = sprintf(t_buf, "%d" to cstr, v_tag)
                    append_cstr(ref (deref self).main_out, t_buf to cstr)
                    free(t_buf to ptr)
                    append_cstr(ref (deref self).main_out, "\n")
                    matched_cond = cmp
                elif pat_k == NodeType.BinaryExpr and strcmp(node_op(inner_pat).data to cstr, ".." to cstr) == 0:
                    let low_node as ptr[Node] = node_left(inner_pat)
                    let high_node as ptr[Node] = node_right(inner_pat)
                    let low_reg as ptr[u8] = self.emit_expr(low_node)
                    let high_reg as ptr[u8] = self.emit_expr(high_node)

                    let cmp1 as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, cmp1 to cstr)
                    append_cstr(ref (deref self).main_out, " = icmp sge ")
                    append_str(ref (deref self).main_out, subject_type)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, subject_reg to cstr)
                    append_cstr(ref (deref self).main_out, ", ")
                    append_cstr(ref (deref self).main_out, low_reg to cstr)
                    append_cstr(ref (deref self).main_out, "\n")

                    let cmp2 as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, cmp2 to cstr)
                    append_cstr(ref (deref self).main_out, " = icmp sle ")
                    append_str(ref (deref self).main_out, subject_type)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, subject_reg to cstr)
                    append_cstr(ref (deref self).main_out, ", ")
                    append_cstr(ref (deref self).main_out, high_reg to cstr)
                    append_cstr(ref (deref self).main_out, "\n")

                    let combined as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, combined to cstr)
                    append_cstr(ref (deref self).main_out, " = and i1 ")
                    append_cstr(ref (deref self).main_out, cmp1 to cstr)
                    append_cstr(ref (deref self).main_out, ", ")
                    append_cstr(ref (deref self).main_out, cmp2 to cstr)
                    append_cstr(ref (deref self).main_out, "\n")
                    matched_cond = combined
                elif pat_k == NodeType.BinaryExpr and strcmp(node_op(inner_pat).data to cstr, "is" to cstr) == 0:
                    let is_var as ptr[Node] = node_left(inner_pat)
                    let is_t_node as ptr[Node] = node_right(inner_pat)
                    var target_t_name as String = String.make("" to cstr)
                    if is_t_node != None to ptr[Node]:
                        target_t_name = node_name(is_t_node)
                    let target_type_id as i32 = self.compute_type_id(target_t_name)

                    var rtti_ptr_reg as ptr[u8] = "null" to ptr[u8]
                    var data_ptr_reg as ptr[u8] = subject_reg
                    if strcmp(subject_type.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                        let rtti_tmp as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, rtti_tmp to cstr)
                        append_cstr(ref (deref self).main_out, " = extractvalue { ptr, ptr } ")
                        append_cstr(ref (deref self).main_out, subject_reg to cstr)
                        append_cstr(ref (deref self).main_out, ", 1\n")
                        rtti_ptr_reg = rtti_tmp

                        let data_tmp as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, data_tmp to cstr)
                        append_cstr(ref (deref self).main_out, " = extractvalue { ptr, ptr } ")
                        append_cstr(ref (deref self).main_out, subject_reg to cstr)
                        append_cstr(ref (deref self).main_out, ", 0\n")
                        data_ptr_reg = data_tmp
                    else:
                        let rtti_tmp as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, rtti_tmp to cstr)
                        append_cstr(ref (deref self).main_out, " = load ptr, ptr ")
                        append_cstr(ref (deref self).main_out, subj_slot to cstr)
                        append_cstr(ref (deref self).main_out, "\n")
                        rtti_ptr_reg = rtti_tmp

                    let isa_call as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, isa_call to cstr)
                    append_cstr(ref (deref self).main_out, " = call i32 @mantiq_isa(ptr ")
                    append_cstr(ref (deref self).main_out, rtti_ptr_reg to cstr)
                    append_cstr(ref (deref self).main_out, ", i32 ")
                    let t_id_buf as ptr[u8] = make[u8](32 to usize) to ptr[u8]
                    let _spt as i32 = sprintf(t_id_buf, "%d" to cstr, target_type_id)
                    append_cstr(ref (deref self).main_out, t_id_buf to cstr)
                    free(t_id_buf to ptr)
                    append_cstr(ref (deref self).main_out, ")\n")

                    let cmp as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, cmp to cstr)
                    append_cstr(ref (deref self).main_out, " = icmp ne i32 ")
                    append_cstr(ref (deref self).main_out, isa_call to cstr)
                    append_cstr(ref (deref self).main_out, ", 0\n")
                    matched_cond = cmp

                    if is_var != None to ptr[Node] and node_kind(is_var) == NodeType.Identifier:
                        let pat_name as String = node_name(is_var)
                        if strcmp(pat_name.data to cstr, "_" to cstr) != 0:
                            var var_target_type as String = type_to_llvm(node_inferred_type(is_var))
                            if var_target_type.len == 0 to usize or strcmp(var_target_type.data to cstr, "void" to cstr) == 0:
                                var_target_type = String.make("ptr" to cstr)

                            var count as i32 = 0 to i32
                            if (deref self).var_counts.has(pat_name):
                                count = (deref self).var_counts[pat_name]
                            set_dict_i32(ref (deref self).var_counts, pat_name, count + 1 to i32)
                            var slot_name as String = pat_name
                            if count > 0 to i32:
                                let slot_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
                                let _ as i32 = sprintf(slot_buf, "%s_%d" to cstr, pat_name.data to cstr, count)
                                slot_name = String.make(slot_buf to cstr)
                            set_dict_str(ref (deref self).var_slots, pat_name, slot_name)
                            set_dict_str(ref (deref self).var_types, pat_name, var_target_type)

                            append_cstr(ref (deref self).main_out, "  %")
                            append_str(ref (deref self).main_out, slot_name)
                            append_cstr(ref (deref self).main_out, " = alloca ")
                            append_str(ref (deref self).main_out, var_target_type)
                            append_cstr(ref (deref self).main_out, "\n")

                            if strcmp(var_target_type.data to cstr, "ptr" to cstr) == 0 or (var_target_type.len > 0 to usize and deref (var_target_type.data) == 37 to u8):
                                append_cstr(ref (deref self).main_out, "  store ptr ")
                                append_cstr(ref (deref self).main_out, data_ptr_reg to cstr)
                                append_cstr(ref (deref self).main_out, ", ptr %")
                                append_str(ref (deref self).main_out, slot_name)
                                append_cstr(ref (deref self).main_out, "\n")
                            else:
                                let unboxed_val as ptr[u8] = self.fresh_temp()
                                append_cstr(ref (deref self).main_out, "  ")
                                append_cstr(ref (deref self).main_out, unboxed_val to cstr)
                                append_cstr(ref (deref self).main_out, " = load ")
                                append_str(ref (deref self).main_out, var_target_type)
                                append_cstr(ref (deref self).main_out, ", ptr ")
                                append_cstr(ref (deref self).main_out, data_ptr_reg to cstr)
                                append_cstr(ref (deref self).main_out, "\n")

                                append_cstr(ref (deref self).main_out, "  store ")
                                append_str(ref (deref self).main_out, var_target_type)
                                append_cstr(ref (deref self).main_out, " ")
                                append_cstr(ref (deref self).main_out, unboxed_val to cstr)
                                append_cstr(ref (deref self).main_out, ", ptr %")
                                append_str(ref (deref self).main_out, slot_name)
                                append_cstr(ref (deref self).main_out, "\n")
                else:
                    let pat_reg as ptr[u8] = self.emit_expr(inner_pat)
                    var pat_type as String = type_to_llvm(node_inferred_type(inner_pat))
                    if pat_type.len == 0 to usize or strcmp(pat_type.data to cstr, "void" to cstr) == 0:
                        pat_type = subject_type

                    let cmp as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, cmp to cstr)
                    if strcmp(subject_type.data to cstr, "double" to cstr) == 0 or strcmp(subject_type.data to cstr, "float" to cstr) == 0:
                        append_cstr(ref (deref self).main_out, " = fcmp oeq ")
                    else:
                        append_cstr(ref (deref self).main_out, " = icmp eq ")
                    append_str(ref (deref self).main_out, subject_type)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, subject_reg to cstr)
                    append_cstr(ref (deref self).main_out, ", ")
                    append_cstr(ref (deref self).main_out, pat_reg to cstr)
                    append_cstr(ref (deref self).main_out, "\n")
                    matched_cond = cmp

            if guard_expr != None to ptr[Node]:
                if is_wildcard:
                    append_cstr(ref (deref self).main_out, "  br label %")
                    append_cstr(ref (deref self).main_out, guard_label to cstr)
                    append_cstr(ref (deref self).main_out, "\n")
                else:
                    append_cstr(ref (deref self).main_out, "  br i1 ")
                    append_cstr(ref (deref self).main_out, matched_cond to cstr)
                    append_cstr(ref (deref self).main_out, ", label %")
                    append_cstr(ref (deref self).main_out, guard_label to cstr)
                    append_cstr(ref (deref self).main_out, ", label %")
                    append_cstr(ref (deref self).main_out, next_lbl to cstr)
                    append_cstr(ref (deref self).main_out, "\n")

                append_cstr(ref (deref self).main_out, "\n")
                append_cstr(ref (deref self).main_out, guard_label to cstr)
                append_cstr(ref (deref self).main_out, ":\n")

                let guard_reg as ptr[u8] = self.emit_expr(guard_expr)
                var guard_type as String = cond_llvm_type(guard_expr)
                var guard_bool as ptr[u8] = guard_reg
                let is_g_cmp as bool = node_kind(guard_expr) == NodeType.BinaryExpr or node_kind(guard_expr) == NodeType.BooleanLiteral
                if not is_g_cmp and strcmp(guard_type.data to cstr, "i1" to cstr) != 0:
                    let g_temp as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, g_temp to cstr)
                    append_cstr(ref (deref self).main_out, " = icmp ne ")
                    append_str(ref (deref self).main_out, guard_type)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, guard_reg to cstr)
                    append_cstr(ref (deref self).main_out, ", 0\n")
                    guard_bool = g_temp

                append_cstr(ref (deref self).main_out, "  br i1 ")
                append_cstr(ref (deref self).main_out, guard_bool to cstr)
                append_cstr(ref (deref self).main_out, ", label %")
                append_cstr(ref (deref self).main_out, body_label to cstr)
                append_cstr(ref (deref self).main_out, ", label %")
                append_cstr(ref (deref self).main_out, next_lbl to cstr)
                append_cstr(ref (deref self).main_out, "\n")
            else:
                if is_wildcard:
                    append_cstr(ref (deref self).main_out, "  br label %")
                    append_cstr(ref (deref self).main_out, body_label to cstr)
                    append_cstr(ref (deref self).main_out, "\n")
                else:
                    append_cstr(ref (deref self).main_out, "  br i1 ")
                    append_cstr(ref (deref self).main_out, matched_cond to cstr)
                    append_cstr(ref (deref self).main_out, ", label %")
                    append_cstr(ref (deref self).main_out, body_label to cstr)
                    append_cstr(ref (deref self).main_out, ", label %")
                    append_cstr(ref (deref self).main_out, next_lbl to cstr)
                    append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, body_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")

            if is_call_pat:
                let pat_args as List[ptr[Node]] = node_params(inner_pat)
                let pa_count as i64 = pat_args.length()
                let pay_ptr as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, pay_ptr to cstr)
                append_cstr(ref (deref self).main_out, " = getelementptr inbounds { i32, [32 x i8] }, ptr ")
                append_cstr(ref (deref self).main_out, subj_slot to cstr)
                append_cstr(ref (deref self).main_out, ", i32 0, i32 1\n")

                var cur_off as i64 = 0 to i64
                var pai as i64 = 0 to i64
                while pai < pa_count:
                    let arg_node as ptr[Node] = pat_args[pai]
                    if node_kind(arg_node) == NodeType.Identifier:
                        let arg_name as String = node_name(arg_node)
                        var arg_llvm_t as String = type_to_llvm(node_inferred_type(arg_node))
                        if arg_llvm_t.len == 0 to usize or strcmp(arg_llvm_t.data to cstr, "void" to cstr) == 0:
                            arg_llvm_t = String.make("float" to cstr)

                        let field_slot as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, field_slot to cstr)
                        append_cstr(ref (deref self).main_out, " = getelementptr inbounds i8, ptr ")
                        append_cstr(ref (deref self).main_out, pay_ptr to cstr)
                        append_cstr(ref (deref self).main_out, ", i64 ")
                        let off_buf as ptr[u8] = make[u8](16 to usize) to ptr[u8]
                        let _so as i32 = sprintf(off_buf, "%lld" to cstr, cur_off)
                        append_cstr(ref (deref self).main_out, off_buf to cstr)
                        free(off_buf to ptr)
                        append_cstr(ref (deref self).main_out, "\n")

                        let val_loaded as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, val_loaded to cstr)
                        append_cstr(ref (deref self).main_out, " = load ")
                        append_str(ref (deref self).main_out, arg_llvm_t)
                        append_cstr(ref (deref self).main_out, ", ptr ")
                        append_cstr(ref (deref self).main_out, field_slot to cstr)
                        append_cstr(ref (deref self).main_out, "\n")

                        var count as i32 = 0 to i32
                        if (deref self).var_counts.has(arg_name):
                            count = (deref self).var_counts[arg_name]
                        set_dict_i32(ref (deref self).var_counts, arg_name, count + 1 to i32)
                        var slot_name as String = arg_name
                        if count > 0 to i32:
                            let slot_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
                            let _ as i32 = sprintf(slot_buf, "%s_%d" to cstr, arg_name.data to cstr, count)
                            slot_name = String.make(slot_buf to cstr)
                        set_dict_str(ref (deref self).var_slots, arg_name, slot_name)
                        set_dict_str(ref (deref self).var_types, arg_name, arg_llvm_t)

                        append_cstr(ref (deref self).main_out, "  %")
                        append_str(ref (deref self).main_out, slot_name)
                        append_cstr(ref (deref self).main_out, " = alloca ")
                        append_str(ref (deref self).main_out, arg_llvm_t)
                        append_cstr(ref (deref self).main_out, "\n")

                        append_cstr(ref (deref self).main_out, "  store ")
                        append_str(ref (deref self).main_out, arg_llvm_t)
                        append_cstr(ref (deref self).main_out, " ")
                        append_cstr(ref (deref self).main_out, val_loaded to cstr)
                        append_cstr(ref (deref self).main_out, ", ptr %")
                        append_str(ref (deref self).main_out, slot_name)
                        append_cstr(ref (deref self).main_out, "\n")

                        if strcmp(arg_llvm_t.data to cstr, "double" to cstr) == 0 or strcmp(arg_llvm_t.data to cstr, "i64" to cstr) == 0:
                            cur_off = cur_off + 8 to i64
                        elif strcmp(arg_llvm_t.data to cstr, "float" to cstr) == 0 or strcmp(arg_llvm_t.data to cstr, "i32" to cstr) == 0:
                            cur_off = cur_off + 4 to i64
                        else:
                            cur_off = cur_off + 8 to i64
                    pai = pai + 1 to i64

            if case_body != None to ptr[Node]:
                self.emit_node(case_body)

            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, end_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            ci = ci + 1 to i64

        append_cstr(ref (deref self).main_out, "\n")
        append_cstr(ref (deref self).main_out, end_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")

    public fn emit_while(self as ptr[LLVMCodegen], node as ptr[Node]):
        let cond as ptr[Node] = node_cond(node)
        let body as ptr[Node] = node_body(node)

        let cond_label as ptr[u8] = self.fresh_label()
        let body_label as ptr[u8] = self.fresh_label()
        let end_label as ptr[u8] = self.fresh_label()

        append_cstr(ref (deref self).main_out, "  br label %")
        append_cstr(ref (deref self).main_out, cond_label to cstr)
        append_cstr(ref (deref self).main_out, "\n\n")

        append_cstr(ref (deref self).main_out, cond_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")
        let cond_reg as ptr[u8] = self.emit_expr(cond)
        let cond_type as String = cond_llvm_type(cond)
        var cond_bool as ptr[u8] = cond_reg

        let is_cmp as bool = node_kind(cond) == NodeType.BinaryExpr or node_kind(cond) == NodeType.BooleanLiteral
        if strcmp(cond_type.data to cstr, "ptr" to cstr) == 0:
            let temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, temp to cstr)
            append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
            append_cstr(ref (deref self).main_out, cond_reg to cstr)
            append_cstr(ref (deref self).main_out, ", null\n")
            cond_bool = temp
        elif not is_cmp and strcmp(cond_type.data to cstr, "i1" to cstr) != 0:
            let temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, temp to cstr)
            append_cstr(ref (deref self).main_out, " = icmp ne ")
            append_str(ref (deref self).main_out, cond_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, cond_reg to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")
            cond_bool = temp

        append_cstr(ref (deref self).main_out, "  br i1 ")
        append_cstr(ref (deref self).main_out, cond_bool to cstr)
        append_cstr(ref (deref self).main_out, ", label %")
        append_cstr(ref (deref self).main_out, body_label to cstr)
        append_cstr(ref (deref self).main_out, ", label %")
        append_cstr(ref (deref self).main_out, end_label to cstr)
        append_cstr(ref (deref self).main_out, "\n\n")

        append_cstr(ref (deref self).main_out, body_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")
        let prev_break as String = (deref self).current_break_label
        let prev_continue as String = (deref self).current_continue_label
        (deref self).current_break_label = String.make(end_label to cstr)
        (deref self).current_continue_label = String.make(cond_label to cstr)
        self.emit_node(body)
        (deref self).current_break_label = prev_break
        (deref self).current_continue_label = prev_continue
        append_cstr(ref (deref self).main_out, "  br label %")
        append_cstr(ref (deref self).main_out, cond_label to cstr)
        append_cstr(ref (deref self).main_out, "\n\n")

        append_cstr(ref (deref self).main_out, end_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")

    public fn extract_range_nodes(self as ptr[LLVMCodegen], iterable as ptr[Node], start_node_ptr as ptr[ptr[Node]], end_node_ptr as ptr[ptr[Node]]) as bool:
        if iterable == None to ptr[Node]:
            return False
        let iter_nt as NodeType = node_kind(iterable)
        if iter_nt == NodeType.CallExpr:
            let callee as ptr[Node] = node_left(iterable)
            if callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier:
                let callee_name_ptr as ptr[String] = node_name_ptr(callee)
                if callee_name_ptr != None to ptr[String] and strcmp((deref callee_name_ptr).data to cstr, "range" to cstr) == 0:
                    let args_raw as List[ptr[Node]] = node_params(iterable)
                    let args as ptr[List[ptr[Node]]] = ref args_raw
                    if (deref args).length() >= 2 to i64:
                        deref start_node_ptr = get_node_decl(args, 0)
                        deref end_node_ptr = get_node_decl(args, 1)
                        return True
        if iter_nt == NodeType.BinaryExpr:
            if strcmp(node_op(iterable).data to cstr, ".." to cstr) == 0:
                deref start_node_ptr = node_left(iterable)
                deref end_node_ptr = node_right(iterable)
                return True
        return False

    public fn emit_for(self as ptr[LLVMCodegen], node as ptr[Node]):
        let iter_name_ptr as ptr[String] = node_name_ptr(node)
        let iterable as ptr[Node] = node_left(node)
        let body as ptr[Node] = node_body(node)

        let cond_label as ptr[u8] = self.fresh_label()
        let body_label as ptr[u8] = self.fresh_label()
        let inc_label as ptr[u8] = self.fresh_label()
        let end_label as ptr[u8] = self.fresh_label()

        var start_node as ptr[Node] = None to ptr[Node]
        var end_node as ptr[Node] = None to ptr[Node]
        let is_range as bool = self.extract_range_nodes(iterable, ref start_node, ref end_node)
        var start_val as ptr[u8] = "0" to ptr[u8]
        var end_val as ptr[u8] = "0" to ptr[u8]
        if is_range:
            start_val = self.emit_expr(start_node)
            if start_val != None to ptr[u8] and deref start_val == 37 to u8:
                let st_t as String = type_to_llvm(node_inferred_type(start_node))
                if strcmp(st_t.data to cstr, "i32" to cstr) == 0:
                    let ext as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, ext to cstr)
                    append_cstr(ref (deref self).main_out, " = sext i32 ")
                    append_cstr(ref (deref self).main_out, start_val to cstr)
                    append_cstr(ref (deref self).main_out, " to i64\n")
                    start_val = ext
            end_val = self.emit_expr(end_node)
            if end_val != None to ptr[u8] and deref end_val == 37 to u8:
                let et_t as String = type_to_llvm(node_inferred_type(end_node))
                if strcmp(et_t.data to cstr, "i32" to cstr) == 0:
                    let ext as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, ext to cstr)
                    append_cstr(ref (deref self).main_out, " = sext i32 ")
                    append_cstr(ref (deref self).main_out, end_val to cstr)
                    append_cstr(ref (deref self).main_out, " to i64\n")
                    end_val = ext

        var final_iter_type as String = type_to_llvm(node_inferred_type(node))
        if is_range or strcmp(final_iter_type.data to cstr, "i32" to cstr) == 0:
            final_iter_type = String.make("i64" to cstr)
        elif strcmp(final_iter_type.data to cstr, "void" to cstr) == 0 and iterable != None to ptr[Node]:
            let alt_type as String = type_to_llvm(node_inferred_type(iterable))
            if strcmp(alt_type.data to cstr, "void" to cstr) != 0:
                final_iter_type = alt_type
            else:
                final_iter_type = String.make("i64" to cstr)

        var iter_name as String = String.make("" to cstr)
        if iter_name_ptr != None to ptr[String]:
            iter_name = deref iter_name_ptr

        var slot_name as String = iter_name
        var count as i32 = 0 to i32
        if (deref self).var_counts.has(iter_name):
            count = (deref self).var_counts[iter_name]
        set_dict_i32(ref (deref self).var_counts, iter_name, count + 1 to i32)
        if count > 0 to i32:
            let slot_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
            let _ as i32 = sprintf(slot_buf, "%s_%d" to cstr, iter_name.data to cstr, count)
            slot_name = String.make(slot_buf to cstr)
        set_dict_str(ref (deref self).var_slots, iter_name, slot_name)
        set_dict_str(ref (deref self).var_types, iter_name, final_iter_type)

        append_cstr(ref (deref self).main_out, "  %")
        append_str(ref (deref self).main_out, slot_name)
        append_cstr(ref (deref self).main_out, " = alloca ")
        append_str(ref (deref self).main_out, final_iter_type)
        append_cstr(ref (deref self).main_out, "\n")

        if is_range:
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, final_iter_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, start_val to cstr)
            append_cstr(ref (deref self).main_out, ", ptr %")
            append_str(ref (deref self).main_out, slot_name)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, cond_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

            append_cstr(ref (deref self).main_out, cond_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            let cond_load as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, cond_load to cstr)
            append_cstr(ref (deref self).main_out, " = load ")
            append_str(ref (deref self).main_out, final_iter_type)
            append_cstr(ref (deref self).main_out, ", ptr %")
            append_str(ref (deref self).main_out, slot_name)
            append_cstr(ref (deref self).main_out, "\n")
            let cmp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, cmp to cstr)
            append_cstr(ref (deref self).main_out, " = icmp slt ")
            append_str(ref (deref self).main_out, final_iter_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, cond_load to cstr)
            append_cstr(ref (deref self).main_out, ", ")
            append_cstr(ref (deref self).main_out, end_val to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, "  br i1 ")
            append_cstr(ref (deref self).main_out, cmp to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, body_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, end_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

            append_cstr(ref (deref self).main_out, body_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            let prev_break as String = (deref self).current_break_label
            let prev_continue as String = (deref self).current_continue_label
            (deref self).current_break_label = String.make(end_label to cstr)
            (deref self).current_continue_label = String.make(inc_label to cstr)
            self.emit_node(body)
            (deref self).current_break_label = prev_break
            (deref self).current_continue_label = prev_continue
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, inc_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

            append_cstr(ref (deref self).main_out, inc_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            let inc_load as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, inc_load to cstr)
            append_cstr(ref (deref self).main_out, " = load ")
            append_str(ref (deref self).main_out, final_iter_type)
            append_cstr(ref (deref self).main_out, ", ptr %")
            append_str(ref (deref self).main_out, slot_name)
            append_cstr(ref (deref self).main_out, "\n")
            let inc_val as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, inc_val to cstr)
            append_cstr(ref (deref self).main_out, " = add ")
            append_str(ref (deref self).main_out, final_iter_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, inc_load to cstr)
            append_cstr(ref (deref self).main_out, ", 1\n")
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, final_iter_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, inc_val to cstr)
            append_cstr(ref (deref self).main_out, ", ptr %")
            append_str(ref (deref self).main_out, slot_name)
            append_cstr(ref (deref self).main_out, "\n")
            if node_is_vectorized(node):
                if (deref self).metadata_out.len == 0 to usize:
                    append_cstr(ref (deref self).metadata_out, "!0 = distinct !{!0, !1}\n!1 = !{!\"llvm.loop.vectorize.enable\", i1 1}\n")
                append_cstr(ref (deref self).main_out, "  br label %")
                append_cstr(ref (deref self).main_out, cond_label to cstr)
                append_cstr(ref (deref self).main_out, ", !llvm.loop !0\n\n")
            else:
                append_cstr(ref (deref self).main_out, "  br label %")
                append_cstr(ref (deref self).main_out, cond_label to cstr)
                append_cstr(ref (deref self).main_out, "\n\n")
        else:
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, cond_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

            append_cstr(ref (deref self).main_out, cond_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            append_cstr(ref (deref self).main_out, "  br i1 true, label %")
            append_cstr(ref (deref self).main_out, body_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, end_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

            append_cstr(ref (deref self).main_out, body_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            let prev_break2 as String = (deref self).current_break_label
            let prev_continue2 as String = (deref self).current_continue_label
            (deref self).current_break_label = String.make(end_label to cstr)
            (deref self).current_continue_label = String.make(cond_label to cstr)
            self.emit_node(body)
            (deref self).current_break_label = prev_break2
            (deref self).current_continue_label = prev_continue2
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, cond_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

        append_cstr(ref (deref self).main_out, end_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")

    public fn emit_with(self as ptr[LLVMCodegen], node as ptr[Node]):
        extern fn sprintf(str as ptr[u8], format as cstr, ...) as i32
        extern fn snprintf(str as ptr[u8], size as usize, format as cstr, ...) as i32
        extern fn free(p as ptr)
        let res_expr as ptr[Node] = node_left(node)
        let body as ptr[Node] = node_body(node)
        var var_name as String = node_name(node)

        var res_reg as ptr[u8] = "null" to ptr[u8]
        var res_type as String = String.make("ptr" to cstr)
        if res_expr != None to ptr[Node]:
            res_reg = self.emit_expr(res_expr)
            let inferred as ptr[Type] = node_inferred_type(res_expr)
            if inferred != None to ptr[Type]:
                let t_str as String = type_to_llvm(inferred)
                if t_str.len > 0 to usize and strcmp(t_str.data to cstr, "void" to cstr) != 0 and strcmp(t_str.data to cstr, "{ ptr, ptr }" to cstr) != 0:
                    res_type = t_str
                elif (deref inferred).kind == TypeKind.Struct:
                    let sn as String = (deref inferred).name
                    if sn.len > 0 to usize:
                        let s_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
                        let _ as i32 = sprintf(s_buf, "%%%s" to cstr, sn.data to cstr)
                        res_type = String.make(s_buf to cstr)
                        free(s_buf to ptr)
                elif (deref inferred).kind == TypeKind.I32:
                    res_type = String.make("i32" to cstr)
                elif (deref inferred).kind == TypeKind.I64:
                    res_type = String.make("i64" to cstr)
            if (strcmp(res_type.data to cstr, "ptr" to cstr) == 0 or strcmp(res_type.data to cstr, "void" to cstr) == 0 or strcmp(res_type.data to cstr, "{ ptr, ptr }" to cstr) == 0) and node_kind(res_expr) == NodeType.Identifier:
                let id_n as String = node_name(res_expr)
                if id_n.len > 0 to usize and (deref self).var_types.has(id_n):
                    res_type = (deref self).var_types[id_n]

        if var_name.len == 0 to usize:
            let cap as usize = 32 to usize
            let buf as ptr[u8] = make[u8](cap) to ptr[u8]
            let snprintf_len as i32 = snprintf(buf, cap, "_with_temp_%d" to cstr, node_span(node).start_byte)
            var_name = String(data = buf, len = snprintf_len to usize, capacity = cap)

        var slot_name as String = var_name
        var count as i32 = 0 to i32
        if (deref self).var_counts.has(var_name):
            count = (deref self).var_counts[var_name]
        set_dict_i32(ref (deref self).var_counts, var_name, count + 1 to i32)
        if count > 0 to i32:
            let slot_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
            let _ as i32 = sprintf(slot_buf, "%s_%d" to cstr, var_name.data to cstr, count)
            slot_name = String.make(slot_buf to cstr)
            free(slot_buf to ptr)
        set_dict_str(ref (deref self).var_slots, var_name, slot_name)
        set_dict_str(ref (deref self).var_types, var_name, res_type)

        append_cstr(ref (deref self).main_out, "  %")
        append_str(ref (deref self).main_out, slot_name)
        append_cstr(ref (deref self).main_out, " = alloca ")
        append_str(ref (deref self).main_out, res_type)
        append_cstr(ref (deref self).main_out, "\n")

        append_cstr(ref (deref self).main_out, "  store ")
        append_str(ref (deref self).main_out, res_type)
        append_cstr(ref (deref self).main_out, " ")
        append_cstr(ref (deref self).main_out, res_reg to cstr)
        append_cstr(ref (deref self).main_out, ", ptr %")
        append_str(ref (deref self).main_out, slot_name)
        append_cstr(ref (deref self).main_out, "\n")

        // Protocol hook: __enter__
        var struct_name as String = String.make("" to cstr)
        if res_expr != None to ptr[Node]:
            let inferred_s as ptr[Type] = node_inferred_type(res_expr)
            if inferred_s != None to ptr[Type] and (deref inferred_s).kind == TypeKind.Struct:
                struct_name = (deref inferred_s).name
        if struct_name.len == 0 to usize and res_type.len > 1 to usize:
            if (deref (res_type.data to ptr[u8])) == 37 to u8:
                struct_name = String.make((res_type.data to usize + 1 to usize) to cstr)

        if struct_name.len > 0 to usize:
            let enter_fn as StringBuilder = StringBuilder.make()
            append_str(ref enter_fn, struct_name)
            append_cstr(ref enter_fn, "___enter__" to cstr)
            let enter_name as String = enter_fn.to_string()
            if (deref self).defined_functions.has(enter_name) or (deref self).program_functions.has(enter_name):
                append_cstr(ref (deref self).main_out, "  call void @")
                append_str(ref (deref self).main_out, enter_name)
                append_cstr(ref (deref self).main_out, "(ptr %")
                append_str(ref (deref self).main_out, slot_name)
                append_cstr(ref (deref self).main_out, ")\n")
            else:
                let enter_fn2 as StringBuilder = StringBuilder.make()
                append_str(ref enter_fn2, struct_name)
                append_cstr(ref enter_fn2, "_enter" to cstr)
                let enter_name2 as String = enter_fn2.to_string()
                if (deref self).defined_functions.has(enter_name2) or (deref self).program_functions.has(enter_name2):
                    append_cstr(ref (deref self).main_out, "  call void @")
                    append_str(ref (deref self).main_out, enter_name2)
                    append_cstr(ref (deref self).main_out, "(ptr %")
                    append_str(ref (deref self).main_out, slot_name)
                    append_cstr(ref (deref self).main_out, ")\n")

        // Emit body
        if body != None to ptr[Node]:
            if node_kind(body) == NodeType.BlockStmt:
                self.emit_block(body)
            else:
                self.emit_node(body)

        // Protocol hook: __exit__
        if struct_name.len > 0 to usize:
            let exit_fn as StringBuilder = StringBuilder.make()
            append_str(ref exit_fn, struct_name)
            append_cstr(ref exit_fn, "___exit__" to cstr)
            let exit_name as String = exit_fn.to_string()
            if (deref self).defined_functions.has(exit_name) or (deref self).program_functions.has(exit_name):
                append_cstr(ref (deref self).main_out, "  call void @")
                append_str(ref (deref self).main_out, exit_name)
                append_cstr(ref (deref self).main_out, "(ptr %")
                append_str(ref (deref self).main_out, slot_name)
                append_cstr(ref (deref self).main_out, ")\n")
            else:
                let exit_fn2 as StringBuilder = StringBuilder.make()
                append_str(ref exit_fn2, struct_name)
                append_cstr(ref exit_fn2, "_exit" to cstr)
                let exit_name2 as String = exit_fn2.to_string()
                if (deref self).defined_functions.has(exit_name2) or (deref self).program_functions.has(exit_name2):
                    append_cstr(ref (deref self).main_out, "  call void @")
                    append_str(ref (deref self).main_out, exit_name2)
                    append_cstr(ref (deref self).main_out, "(ptr %")
                    append_str(ref (deref self).main_out, slot_name)
                    append_cstr(ref (deref self).main_out, ")\n")

        // Auto-drops
        if (deref self).auto_drops.has(node to usize):
            let drops as List[String] = (deref self).auto_drops[node to usize]
            if drops.length() > 0 to i64:
                self.emit_auto_drops(drops)

    // ── Exception and Result Handling ─────────────────────────────────────

    public fn emit_throw(self as ptr[LLVMCodegen], node as ptr[Node]):
        let drops as List[String] = node_auto_drops(node)
        if drops.length() > 0 to i64:
            self.emit_auto_drops(drops)

        let val as ptr[Node] = node_left(node)
        var err_val as ptr[u8] = "0" to ptr[u8]
        var err_llvm as String = String.make("i32" to cstr)
        if val != None to ptr[Node]:
            err_val = self.emit_expr(val)
            let err_type as ptr[Type] = node_inferred_type(val)
            if err_type != None to ptr[Type]:
                let e_str as String = type_to_llvm(err_type)
                if e_str.len > 0 to usize and strcmp(e_str.data to cstr, "void" to cstr) != 0 and strcmp(e_str.data to cstr, "{ ptr, ptr }" to cstr) != 0:
                    err_llvm = e_str

        let box_ptr as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, box_ptr to cstr)
        append_cstr(ref (deref self).main_out, " = call ptr @mantiq_malloc(i64 32)\n")

        append_cstr(ref (deref self).main_out, "  store ")
        append_str(ref (deref self).main_out, err_llvm)
        append_cstr(ref (deref self).main_out, " ")
        append_cstr(ref (deref self).main_out, err_val to cstr)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, box_ptr to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let t1 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, t1 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { i8, ptr, ptr } undef, i8 1, 0\n")

        let t2 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, t2 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { i8, ptr, ptr } ")
        append_cstr(ref (deref self).main_out, t1 to cstr)
        append_cstr(ref (deref self).main_out, ", ptr null, 1\n")

        let t3 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, t3 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { i8, ptr, ptr } ")
        append_cstr(ref (deref self).main_out, t2 to cstr)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, box_ptr to cstr)
        append_cstr(ref (deref self).main_out, ", 2\n")

        append_cstr(ref (deref self).main_out, "  ret { i8, ptr, ptr } ")
        append_cstr(ref (deref self).main_out, t3 to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let dead_l as ptr[u8] = self.fresh_label()
        append_cstr(ref (deref self).main_out, dead_l to cstr)
        append_cstr(ref (deref self).main_out, ":\n")

    public fn emit_try(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        extern fn sprintf(str as ptr[u8], format as cstr, ...) as i32
        extern fn free(p as ptr)
        let body_node as ptr[Node] = node_left(node)
        var body_val as ptr[u8] = "null" to ptr[u8]
        var target_fallible as ptr[Node] = body_node
        if body_node != None to ptr[Node]:
            if node_kind(body_node) == NodeType.BlockStmt:
                let b_stmts as List[ptr[Node]] = node_declarations(body_node)
                let b_count as i64 = b_stmts.length()
                var bi as i64 = 0 to i64
                while bi < b_count - 1 to i64:
                    self.emit_node(get_node_decl(ref b_stmts, bi))
                    bi = bi + 1 to i64
                if b_count > 0 to i64:
                    target_fallible = get_node_decl(ref b_stmts, b_count - 1 to i64)
            body_val = self.emit_expr(target_fallible)

        let body_type as ptr[Type] = node_inferred_type(target_fallible)
        var is_option as bool = False
        if body_type != None to ptr[Type] and (deref body_type).kind == TypeKind.Option:
            is_option = True

        var payload_llvm as String = String.make("i32" to cstr)
        let node_t as ptr[Type] = node_inferred_type(node)
        if node_t != None to ptr[Type]:
            let pl_str as String = type_to_llvm(node_t)
            if pl_str.len > 0 to usize and strcmp(pl_str.data to cstr, "void" to cstr) != 0 and strcmp(pl_str.data to cstr, "{ ptr, ptr }" to cstr) != 0:
                payload_llvm = pl_str
        elif body_type != None to ptr[Type] and (deref body_type).payload != None to ptr[Type]:
            let pl_str as String = type_to_llvm((deref body_type).payload)
            if pl_str.len > 0 to usize and strcmp(pl_str.data to cstr, "void" to cstr) != 0 and strcmp(pl_str.data to cstr, "{ ptr, ptr }" to cstr) != 0:
                payload_llvm = pl_str

        let res_alloc as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, res_alloc to cstr)
        append_cstr(ref (deref self).main_out, " = alloca ")
        append_str(ref (deref self).main_out, payload_llvm)
        append_cstr(ref (deref self).main_out, "\n")

        let tag_reg as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, tag_reg to cstr)
        if is_option:
            append_cstr(ref (deref self).main_out, " = extractvalue { i8, ptr } ")
        else:
            append_cstr(ref (deref self).main_out, " = extractvalue { i8, ptr, ptr } ")
        append_cstr(ref (deref self).main_out, body_val to cstr)
        append_cstr(ref (deref self).main_out, ", 0\n")

        let cmp_reg as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, cmp_reg to cstr)
        if is_option:
            append_cstr(ref (deref self).main_out, " = icmp eq i8 ")
            append_cstr(ref (deref self).main_out, tag_reg to cstr)
            append_cstr(ref (deref self).main_out, ", 1\n")
        else:
            append_cstr(ref (deref self).main_out, " = icmp eq i8 ")
            append_cstr(ref (deref self).main_out, tag_reg to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")

        let try_ok as ptr[u8] = self.fresh_label()
        let try_err as ptr[u8] = self.fresh_label()
        let try_end as ptr[u8] = self.fresh_label()

        append_cstr(ref (deref self).main_out, "  br i1 ")
        append_cstr(ref (deref self).main_out, cmp_reg to cstr)
        append_cstr(ref (deref self).main_out, ", label %")
        append_cstr(ref (deref self).main_out, try_ok to cstr)
        append_cstr(ref (deref self).main_out, ", label %")
        append_cstr(ref (deref self).main_out, try_err to cstr)
        append_cstr(ref (deref self).main_out, "\n\n")

        // Ok / Some block
        append_cstr(ref (deref self).main_out, try_ok to cstr)
        append_cstr(ref (deref self).main_out, ":\n")

        let payload_ptr as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, payload_ptr to cstr)
        if is_option:
            append_cstr(ref (deref self).main_out, " = extractvalue { i8, ptr } ")
        else:
            append_cstr(ref (deref self).main_out, " = extractvalue { i8, ptr, ptr } ")
        append_cstr(ref (deref self).main_out, body_val to cstr)
        append_cstr(ref (deref self).main_out, ", 1\n")

        let payload_val as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, payload_val to cstr)
        append_cstr(ref (deref self).main_out, " = load ")
        append_str(ref (deref self).main_out, payload_llvm)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, payload_ptr to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        append_cstr(ref (deref self).main_out, "  store ")
        append_str(ref (deref self).main_out, payload_llvm)
        append_cstr(ref (deref self).main_out, " ")
        append_cstr(ref (deref self).main_out, payload_val to cstr)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, res_alloc to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        append_cstr(ref (deref self).main_out, "  br label %")
        append_cstr(ref (deref self).main_out, try_end to cstr)
        append_cstr(ref (deref self).main_out, "\n\n")

        // Err / Empty block
        append_cstr(ref (deref self).main_out, try_err to cstr)
        append_cstr(ref (deref self).main_out, ":\n")

        let var_name as String = node_name(node)
        if var_name.len > 0 to usize and strcmp(var_name.data to cstr, "_" to cstr) != 0:
            let err_ptr as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, err_ptr to cstr)
            if is_option:
                append_cstr(ref (deref self).main_out, " = extractvalue { i8, ptr } ")
                append_cstr(ref (deref self).main_out, body_val to cstr)
                append_cstr(ref (deref self).main_out, ", 1\n")
            else:
                append_cstr(ref (deref self).main_out, " = extractvalue { i8, ptr, ptr } ")
                append_cstr(ref (deref self).main_out, body_val to cstr)
                append_cstr(ref (deref self).main_out, ", 2\n")

            let err_val as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, err_val to cstr)
            append_cstr(ref (deref self).main_out, " = load i32, ptr ")
            append_cstr(ref (deref self).main_out, err_ptr to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            var slot_name as String = var_name
            var count as i32 = 0 to i32
            if (deref self).var_counts.has(var_name):
                count = (deref self).var_counts[var_name]
            set_dict_i32(ref (deref self).var_counts, var_name, count + 1 to i32)
            if count > 0 to i32:
                let slot_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
                let _ as i32 = sprintf(slot_buf, "%s_%d" to cstr, var_name.data to cstr, count)
                slot_name = String.make(slot_buf to cstr)
                free(slot_buf to ptr)
            set_dict_str(ref (deref self).var_slots, var_name, slot_name)
            set_dict_str(ref (deref self).var_types, var_name, String.make("i32" to cstr))

            append_cstr(ref (deref self).main_out, "  %")
            append_str(ref (deref self).main_out, slot_name)
            append_cstr(ref (deref self).main_out, " = alloca i32\n")

            append_cstr(ref (deref self).main_out, "  store i32 ")
            append_cstr(ref (deref self).main_out, err_val to cstr)
            append_cstr(ref (deref self).main_out, ", ptr %")
            append_str(ref (deref self).main_out, slot_name)
            append_cstr(ref (deref self).main_out, "\n")

        let catch_b as ptr[Node] = node_body(node)
        if catch_b != None to ptr[Node]:
            if node_kind(catch_b) == NodeType.BlockStmt:
                let stmts as List[ptr[Node]] = node_declarations(catch_b)
                let count as i64 = stmts.length()
                var s_i as i64 = 0 to i64
                while s_i < count:
                    let stmt as ptr[Node] = get_node_decl(ref stmts, s_i)
                    if s_i == count - 1 to i64:
                        let sk as NodeType = node_kind(stmt)
                        if sk == NodeType.NumberLiteral or sk == NodeType.Identifier or sk == NodeType.BinaryExpr or sk == NodeType.UnaryExpr or sk == NodeType.CallExpr or sk == NodeType.CastExpr or sk == NodeType.MemberExpr or sk == NodeType.IndexExpr or sk == NodeType.BooleanLiteral or sk == NodeType.StringLiteral:
                            let catch_val as ptr[u8] = self.emit_expr(stmt)
                            if strcmp(catch_val to cstr, "void" to cstr) != 0 and strcmp(catch_val to cstr, "null" to cstr) != 0:
                                append_cstr(ref (deref self).main_out, "  store ")
                                append_str(ref (deref self).main_out, payload_llvm)
                                append_cstr(ref (deref self).main_out, " ")
                                append_cstr(ref (deref self).main_out, catch_val to cstr)
                                append_cstr(ref (deref self).main_out, ", ptr ")
                                append_cstr(ref (deref self).main_out, res_alloc to cstr)
                                append_cstr(ref (deref self).main_out, "\n")
                        else:
                            self.emit_node(stmt)
                    else:
                        self.emit_node(stmt)
                    s_i = s_i + 1 to i64
            else:
                let catch_val as ptr[u8] = self.emit_expr(catch_b)
                if strcmp(catch_val to cstr, "void" to cstr) != 0 and strcmp(catch_val to cstr, "null" to cstr) != 0:
                    append_cstr(ref (deref self).main_out, "  store ")
                    append_str(ref (deref self).main_out, payload_llvm)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, catch_val to cstr)
                    append_cstr(ref (deref self).main_out, ", ptr ")
                    append_cstr(ref (deref self).main_out, res_alloc to cstr)
                    append_cstr(ref (deref self).main_out, "\n")

        append_cstr(ref (deref self).main_out, "  br label %")
        append_cstr(ref (deref self).main_out, try_end to cstr)
        append_cstr(ref (deref self).main_out, "\n\n")

        // End block
        append_cstr(ref (deref self).main_out, try_end to cstr)
        append_cstr(ref (deref self).main_out, ":\n")

        let final_res as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, final_res to cstr)
        append_cstr(ref (deref self).main_out, " = load ")
        append_str(ref (deref self).main_out, payload_llvm)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, res_alloc to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        return final_res

    public fn emit_block(self as ptr[LLVMCodegen], node as ptr[Node]):
        let stmts as List[ptr[Node]] = node_declarations(node)
        let count as i64 = stmts.length()
        var i as i64 = 0 to i64
        while i < count:
            self.emit_node(get_node_decl(ref stmts, i))
            i = i + 1 to i64

        var last_is_ret as bool = False
        if count > 0 to i64:
            let last_stmt as ptr[Node] = get_node_decl(ref stmts, count - 1)
            if last_stmt != None to ptr[Node] and node_kind(last_stmt) == NodeType.ReturnStmt:
                last_is_ret = True
        if not last_is_ret:
            let drops as List[String] = node_auto_drops(node)
            if drops.length() > 0 to i64:
                self.emit_auto_drops(drops)

    public fn emit_param_block(self as ptr[LLVMCodegen], node as ptr[Node]):
        // 1. Allocate return variables in current function frame if not already allocated
        let ret_names as List[String] = node_return_names(node)
        let ret_count as i64 = ret_names.length()
        let ret_annots_p as ptr[List[Option[ptr[TypeAnnotation]]]] = node_return_type_annots(node)
        var r_i as i64 = 0 to i64
        while r_i < ret_count:
            let r_name_str as String = ret_names[r_i]
            if r_name_str.data != None to ptr[u8] and r_name_str.len > 0 to usize:
                let r_cstr as cstr = r_name_str.data to cstr
                let r_name as String = String.make(r_cstr)
                var r_type as String = String.make("i64" to cstr)
                if ret_annots_p != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                    let r_annots as List[Option[ptr[TypeAnnotation]]] = deref ret_annots_p
                    if r_i < r_annots.length():
                        let opt as Option[ptr[TypeAnnotation]] = r_annots[r_i]
                        let opt_ref as ptr[OptionLayout] = (ref opt) to ptr[OptionLayout]
                        if option_has_value(opt_ref):
                            let pa as ptr[TypeAnnotation] = option_unwrap_ptr(opt_ref) to ptr[TypeAnnotation]
                            if pa != None to ptr[TypeAnnotation] and (deref pa).name.data != None:
                                let pa_name as cstr = (deref pa).name.data to cstr
                                if strcmp(pa_name, "i32" to cstr) == 0 or strcmp(pa_name, "u32" to cstr) == 0 or strcmp(pa_name, "color" to cstr) == 0 or strcmp(pa_name, "Color" to cstr) == 0:
                                    r_type = String.make("i32" to cstr)
                                elif strcmp(pa_name, "i64" to cstr) == 0 or strcmp(pa_name, "u64" to cstr) == 0 or strcmp(pa_name, "usize" to cstr) == 0 or strcmp(pa_name, "isize" to cstr) == 0:
                                    r_type = String.make("i64" to cstr)
                                elif strcmp(pa_name, "f64" to cstr) == 0:
                                    r_type = String.make("double" to cstr)
                                elif strcmp(pa_name, "f32" to cstr) == 0:
                                    r_type = String.make("float" to cstr)
                                elif strcmp(pa_name, "bool" to cstr) == 0 or strcmp(pa_name, "i8" to cstr) == 0 or strcmp(pa_name, "u8" to cstr) == 0:
                                    r_type = String.make("i8" to cstr)
                                elif strcmp(pa_name, "ptr" to cstr) == 0 or (deref pa).is_ref:
                                    r_type = String.make("ptr" to cstr)
                                elif strcmp(pa_name, "String" to cstr) == 0 or strcmp(pa_name, "List" to cstr) == 0 or strcmp(pa_name, "Dict" to cstr) == 0:
                                    r_type = String.make("{ ptr, i64, i64 }" to cstr)
                                else:
                                    r_type = String.make(pa_name)
                
                var r_count as i32 = 0 to i32
                if (deref self).var_counts.has(r_name):
                    r_count = (deref self).var_counts[r_name]
                set_dict_i32(ref (deref self).var_counts, r_name, r_count + 1 to i32)
                var r_slot_name as String = r_name
                if r_count > 0 to i32:
                    let slot_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
                    let _ as i32 = sprintf(slot_buf, "%s_%d" to cstr, r_name.data to cstr, r_count)
                    r_slot_name = String.make(slot_buf to cstr)
                set_dict_str(ref (deref self).var_slots, r_name, r_slot_name)
                set_dict_str(ref (deref self).var_types, r_name, r_type)

                append_cstr(ref (deref self).main_out, "  %")
                append_str(ref (deref self).main_out, r_slot_name)
                append_cstr(ref (deref self).main_out, " = alloca ")
                append_str(ref (deref self).main_out, r_type)
                append_cstr(ref (deref self).main_out, "\n")
            r_i = r_i + 1 to i64

        // 2. Setup parameters (shadow outer variables, initialize with existing outer values if any)
        let params as List[ptr[Node]] = node_params(node)
        let param_count as i64 = params.length()
        let saved_slots as Dict[String, String] = Dict[String, String]()
        let saved_types as Dict[String, String] = Dict[String, String]()
        let had_saved as Dict[String, bool] = Dict[String, bool]()

        var p_i as i64 = 0 to i64
        while p_i < param_count:
            let p_node as ptr[Node] = params[p_i]
            let p_cstr as cstr = node_name(p_node).data to cstr
            let p_name as String = String.make(p_cstr)
            var p_type as String = type_to_llvm(node_inferred_type(p_node))
            if strcmp(p_type.data to cstr, "void" to cstr) == 0 or p_type.len == 0 to usize:
                p_type = String.make("i32" to cstr)

            if (deref self).var_slots.has(p_name):
                set_dict_bool(ref had_saved, p_name, True)
                set_dict_str(ref saved_slots, p_name, (deref self).var_slots[p_name])
                set_dict_str(ref saved_types, p_name, (deref self).var_types[p_name])
            else:
                set_dict_bool(ref had_saved, p_name, False)

            var p_count as i32 = 0 to i32
            if (deref self).var_counts.has(p_name):
                p_count = (deref self).var_counts[p_name]
            set_dict_i32(ref (deref self).var_counts, p_name, p_count + 1 to i32)
            var p_slot_name as String = p_name
            if p_count > 0 to i32:
                let slot_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
                let _ as i32 = sprintf(slot_buf, "%s_%d" to cstr, p_name.data to cstr, p_count)
                p_slot_name = String.make(slot_buf to cstr)

            append_cstr(ref (deref self).main_out, "  %")
            append_str(ref (deref self).main_out, p_slot_name)
            append_cstr(ref (deref self).main_out, " = alloca ")
            append_str(ref (deref self).main_out, p_type)
            append_cstr(ref (deref self).main_out, "\n")

            if had_saved[p_name]:
                let old_slot as String = saved_slots[p_name]
                let old_type as String = saved_types[p_name]
                let load_reg as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, load_reg to cstr)
                append_cstr(ref (deref self).main_out, " = load ")
                append_str(ref (deref self).main_out, old_type)
                append_cstr(ref (deref self).main_out, ", ptr %")
                append_str(ref (deref self).main_out, old_slot)
                append_cstr(ref (deref self).main_out, "\n")

                append_cstr(ref (deref self).main_out, "  store ")
                append_str(ref (deref self).main_out, p_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, load_reg to cstr)
                append_cstr(ref (deref self).main_out, ", ptr %")
                append_str(ref (deref self).main_out, p_slot_name)
                append_cstr(ref (deref self).main_out, "\n")

            set_dict_str(ref (deref self).var_slots, p_name, p_slot_name)
            set_dict_str(ref (deref self).var_types, p_name, p_type)

            p_i = p_i + 1 to i64

        // 3. Set up exit label and active param block context
        let exit_lbl as ptr[u8] = self.fresh_label()
        let prev_pb as ptr[Node] = (deref self).active_param_block
        let prev_exit as String = (deref self).active_block_exit
        (deref self).active_param_block = node
        (deref self).active_block_exit = String.make(exit_lbl to cstr)

        // 4. Emit body
        var last_is_ret as bool = False
        let body_node as ptr[Node] = node_body(node)
        if body_node != None to ptr[Node]:
            let stmts as List[ptr[Node]] = node_declarations(body_node)
            let scount as i64 = stmts.length()
            if scount > 0 to i64:
                let last_stmt as ptr[Node] = stmts[scount - 1]
                if last_stmt != None to ptr[Node] and node_kind(last_stmt) == NodeType.ReturnStmt:
                    last_is_ret = True
            self.emit_block(body_node)

        // 5. Emit branch to exit if not already returned, and place label
        if not last_is_ret:
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, exit_lbl to cstr)
            append_cstr(ref (deref self).main_out, "\n")
        append_cstr(ref (deref self).main_out, "\n")
        append_cstr(ref (deref self).main_out, exit_lbl to cstr)
        append_cstr(ref (deref self).main_out, ":\n")

        // 6. Restore active param block context & parameter slots
        (deref self).active_param_block = prev_pb
        (deref self).active_block_exit = prev_exit

        var p_r as i64 = 0 to i64
        while p_r < param_count:
            let p_node as ptr[Node] = params[p_r]
            let p_name as String = node_name(p_node)
            if had_saved.has(p_name) and had_saved[p_name]:
                set_dict_str(ref (deref self).var_slots, p_name, saved_slots[p_name])
                set_dict_str(ref (deref self).var_types, p_name, saved_types[p_name])
            p_r = p_r + 1 to i64

        // 7. Emit auto-drops for the param block
        let drops as List[String] = node_auto_drops(node)
        if drops.length() > 0 to i64:
            self.emit_auto_drops(drops)

    public fn emit_unary_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let op as String = node_op(node)
        append_cstr(ref (deref self).main_out, "  ; UNARY OP: ")
        if op.data != None to ptr[u8]:
            append_str(ref (deref self).main_out, op)
        append_cstr(ref (deref self).main_out, "\n")
        let operand as ptr[Node] = node_left(node)
        if op.data != None to ptr[u8] and strcmp(op.data to cstr, "size" to cstr) == 0:
            let sz_val as i64 = self.eval_type_size_node(operand)
            let s_buf as ptr[u8] = make[u8](32 to usize) to ptr[u8]
            let _ as i32 = sprintf(s_buf, "%lld" to cstr, sz_val)
            return s_buf
        let operand_val as ptr[u8] = self.emit_expr(operand)
        let t as String = type_to_llvm(node_inferred_type(operand))
        let reg as ptr[u8] = self.fresh_temp()

        if strcmp(op.data to cstr, "not" to cstr) == 0:
            var cmp_t as String = t
            if cmp_t.len == 0 to usize or strcmp(cmp_t.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                cmp_t = String.make("i8" to cstr)
            if strcmp(cmp_t.data to cstr, "i1" to cstr) != 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp eq ")
                append_str(ref (deref self).main_out, cmp_t)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, operand_val to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")
                set_node_inferred_type(node, make_type(TypeKind.Boolean))
                return temp
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = xor i1 ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, ", 1\n")
            set_node_inferred_type(node, make_type(TypeKind.Boolean))
            return reg
        elif strcmp(op.data to cstr, "-" to cstr) == 0:
            let is_float as bool = strcmp(t.data to cstr, "float" to cstr) == 0 or strcmp(t.data to cstr, "double" to cstr) == 0 or strcmp(t.data to cstr, "half" to cstr) == 0 or strcmp(t.data to cstr, "bfloat" to cstr) == 0 or strcmp(t.data to cstr, "fp128" to cstr) == 0
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            if is_float:
                append_cstr(ref (deref self).main_out, " = fneg ")
            else:
                append_cstr(ref (deref self).main_out, " = sub ")
                append_str(ref (deref self).main_out, t)
                append_cstr(ref (deref self).main_out, " 0, ")
                append_cstr(ref (deref self).main_out, operand_val to cstr)
                append_cstr(ref (deref self).main_out, "\n")
                return reg
            append_cstr(ref (deref self).main_out, " ")
            append_str(ref (deref self).main_out, t)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return reg
        elif strcmp(op.data to cstr, "+" to cstr) == 0:
            return operand_val
        elif strcmp(op.data to cstr, "~" to cstr) == 0:
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = xor ")
            append_str(ref (deref self).main_out, t)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, ", -1\n")
            return reg
        elif strcmp(op.data to cstr, "ref" to cstr) == 0 or strcmp(op.data to cstr, "ref mut" to cstr) == 0:
            return self.emit_lvalue_ptr(operand)
        elif strcmp(op.data to cstr, "deref" to cstr) == 0:
            var pointee_t as String = type_to_llvm(node_inferred_type(node))
            if operand != None to ptr[Node] and node_kind(operand) == NodeType.CastExpr:
                let cast_target as String = node_op(operand)
                if cast_target.data != None to ptr[u8]:
                    let ct as cstr = cast_target.data to cstr
                    extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
                    if strncmp(ct, "ptr[" to cstr, 4 to usize) == 0:
                        let inner as cstr = (ct to usize + 4 to usize) to cstr
                        if strncmp(inner, "cstr" to cstr, 4 to usize) == 0 or strncmp(inner, "ptr" to cstr, 3 to usize) == 0:
                            pointee_t = String.make("ptr" to cstr)
                        elif strncmp(inner, "u8" to cstr, 2 to usize) == 0 or strncmp(inner, "i8" to cstr, 2 to usize) == 0 or strncmp(inner, "bool" to cstr, 4 to usize) == 0 or strncmp(inner, "byte" to cstr, 4 to usize) == 0:
                            pointee_t = String.make("i8" to cstr)
                        elif strncmp(inner, "i16" to cstr, 3 to usize) == 0 or strncmp(inner, "u16" to cstr, 3 to usize) == 0:
                            pointee_t = String.make("i16" to cstr)
                        elif strncmp(inner, "i32" to cstr, 3 to usize) == 0 or strncmp(inner, "u32" to cstr, 3 to usize) == 0 or strncmp(inner, "char" to cstr, 4 to usize) == 0:
                            pointee_t = String.make("i32" to cstr)
                        elif strncmp(inner, "i64" to cstr, 3 to usize) == 0 or strncmp(inner, "u64" to cstr, 3 to usize) == 0 or strncmp(inner, "usize" to cstr, 5 to usize) == 0 or strncmp(inner, "isize" to cstr, 5 to usize) == 0:
                            pointee_t = String.make("i64" to cstr)
                        elif strncmp(inner, "f32" to cstr, 3 to usize) == 0:
                            pointee_t = String.make("float" to cstr)
                        elif strncmp(inner, "f64" to cstr, 3 to usize) == 0:
                            pointee_t = String.make("double" to cstr)
                        elif strncmp(inner, "String" to cstr, 6 to usize) == 0 or strncmp(inner, "List" to cstr, 4 to usize) == 0 or strncmp(inner, "Dict" to cstr, 4 to usize) == 0:
                            pointee_t = String.make("{ ptr, i64, i64 }" to cstr)
                        else:
                            pointee_t = String.make("ptr" to cstr)
            elif strcmp(pointee_t.data to cstr, "void" to cstr) == 0 or strcmp(pointee_t.data to cstr, "{ ptr, ptr }" to cstr) == 0 or pointee_t.len == 0 to usize:
                if (deref self).current_return_type.len > 0 to usize and strcmp((deref self).current_return_type.data to cstr, "void" to cstr) != 0:
                    pointee_t = (deref self).current_return_type
                else:
                    pointee_t = String.make("i8" to cstr)
            if strcmp(pointee_t.data to cstr, "void" to cstr) == 0:
                pointee_t = String.make("i8" to cstr)
            var ptr_reg as ptr[u8] = operand_val
            var needs_inttoptr as bool = False
            if node_kind(operand) == NodeType.BinaryExpr:
                needs_inttoptr = True
            if needs_inttoptr:
                let p_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, p_temp to cstr)
                append_cstr(ref (deref self).main_out, " = inttoptr i64 ")
                append_cstr(ref (deref self).main_out, operand_val to cstr)
                append_cstr(ref (deref self).main_out, " to ptr\n")
                ptr_reg = p_temp
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = load ")
            append_str(ref (deref self).main_out, pointee_t)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, ptr_reg to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return reg
        else:
            return operand_val

    public fn emit_cast_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let operand as ptr[Node] = node_left(node)
        let operand_val as ptr[u8] = self.emit_expr(operand)
        if operand != None to ptr[Node]:
            if node_kind(operand) == NodeType.MemberExpr:
                let dl as ptr[Node] = node_left(operand)
                if dl != None to ptr[Node]:
                    if node_kind(dl) == NodeType.Identifier:
                        let enum_obj as String = node_name(dl)
                        if enum_obj.data != None to ptr[u8]:
                            let e_cstr as cstr = enum_obj.data to cstr
                            if strcmp(e_cstr, "NodeType" to cstr) == 0 or strcmp(e_cstr, "TypeKind" to cstr) == 0 or strcmp(e_cstr, "LanguageMode" to cstr) == 0 or strcmp(e_cstr, "SymbolKind" to cstr) == 0 or strcmp(e_cstr, "LabelKind" to cstr) == 0 or strcmp(e_cstr, "Severity" to cstr) == 0 or strcmp(e_cstr, "ObjectState" to cstr) == 0 or strcmp(e_cstr, "Endianness" to cstr) == 0 or strcmp(e_cstr, "PassMode" to cstr) == 0 or strcmp(e_cstr, "ImportKind" to cstr) == 0:
                                return operand_val
        var source_type as String = type_to_llvm(node_inferred_type(operand))
        if operand != None to ptr[Node]:
            if node_kind(operand) == NodeType.StringLiteral:
                source_type = String.make("ptr" to cstr)
            elif node_kind(operand) == NodeType.MemberExpr:
                let field_name as String = node_name(operand)
                let obj as ptr[Node] = node_left(operand)
                if obj != None to ptr[Node]:
                    var s_name as String = String.make("Node" to cstr)
                    let target_t as ptr[Type] = node_inferred_type(obj)
                    if target_t != None to ptr[Type]:
                        if (deref target_t).kind == TypeKind.Struct:
                            s_name = (deref target_t).name
                        elif (deref target_t).kind == TypeKind.RawPointer and (deref target_t).payload != None to ptr[Type]:
                            let pl as ptr[Type] = (deref target_t).payload
                            if (deref pl).kind == TypeKind.Struct:
                                s_name = (deref pl).name
                    var obj_inner as ptr[Node] = obj
                    if node_kind(obj_inner) == NodeType.UnaryExpr:
                        let in_node as ptr[Node] = node_left(obj_inner)
                        if in_node != None to ptr[Node]:
                            obj_inner = in_node
                    if node_kind(obj_inner) == NodeType.Identifier:
                        let id_nm as String = node_name(obj_inner)
                        if id_nm.data != None and strcmp(id_nm.data to cstr, "self" to cstr) == 0 and (deref self).current_struct_name.len > 0 to usize:
                            s_name = (deref self).current_struct_name
                    let f_t as String = get_struct_field_type(s_name.data to cstr, field_name.data to cstr)
                    if strcmp(f_t.data to cstr, "{ ptr, ptr }") != 0:
                        source_type = f_t
            elif node_kind(operand) == NodeType.Identifier:
                let id_nm_str as String = node_name(operand)
                if id_nm_str.data != None and (deref self).var_types.has(id_nm_str):
                    source_type = (deref self).var_types[id_nm_str]
            elif node_kind(operand) == NodeType.NumberLiteral:
                extern fn strstr(haystack as cstr, needle as cstr) as cstr
                if node_is_float(operand) or strncmp(operand_val to cstr, "0x" to cstr, 2 to usize) == 0 or strstr(operand_val to cstr, "." to cstr) != None to cstr or strstr(operand_val to cstr, "e" to cstr) != None to cstr or strstr(operand_val to cstr, "E" to cstr) != None to cstr:
                    source_type = String.make("double" to cstr)
                else:
                    source_type = String.make("i64" to cstr)
        var target_type as String = type_to_llvm(node_inferred_type(node))
        let target_op as String = node_op(node)
        if target_op.data != None to ptr[u8]:
            let target_cstr as cstr = target_op.data to cstr
            if strcmp(target_cstr, "usize" to cstr) == 0 or strcmp(target_cstr, "isize" to cstr) == 0 or strcmp(target_cstr, "i64" to cstr) == 0 or strcmp(target_cstr, "u64" to cstr) == 0:
                target_type = String.make("i64" to cstr)
            elif strcmp(target_cstr, "i1024" to cstr) == 0 or strcmp(target_cstr, "u1024" to cstr) == 0:
                target_type = String.make("i1024" to cstr)
            elif strcmp(target_cstr, "i512" to cstr) == 0 or strcmp(target_cstr, "u512" to cstr) == 0:
                target_type = String.make("i512" to cstr)
            elif strcmp(target_cstr, "i256" to cstr) == 0 or strcmp(target_cstr, "u256" to cstr) == 0:
                target_type = String.make("i256" to cstr)
            elif strcmp(target_cstr, "i128" to cstr) == 0 or strcmp(target_cstr, "u128" to cstr) == 0:
                target_type = String.make("i128" to cstr)
            elif strcmp(target_cstr, "i32" to cstr) == 0 or strcmp(target_cstr, "u32" to cstr) == 0:
                target_type = String.make("i32" to cstr)
            elif strcmp(target_cstr, "i16" to cstr) == 0 or strcmp(target_cstr, "u16" to cstr) == 0:
                target_type = String.make("i16" to cstr)
            elif strcmp(target_cstr, "i8" to cstr) == 0 or strcmp(target_cstr, "u8" to cstr) == 0 or strcmp(target_cstr, "bool" to cstr) == 0:
                target_type = String.make("i8" to cstr)
            elif strcmp(target_cstr, "f128" to cstr) == 0 or strcmp(target_cstr, "fp128" to cstr) == 0:
                target_type = String.make("fp128" to cstr)
            elif strcmp(target_cstr, "f64" to cstr) == 0 or strcmp(target_cstr, "double" to cstr) == 0:
                target_type = String.make("double" to cstr)
            elif strcmp(target_cstr, "f32" to cstr) == 0 or strcmp(target_cstr, "float" to cstr) == 0:
                target_type = String.make("float" to cstr)
            elif strcmp(target_cstr, "f16" to cstr) == 0 or strcmp(target_cstr, "half" to cstr) == 0:
                target_type = String.make("half" to cstr)
            elif strcmp(target_cstr, "bf16" to cstr) == 0 or strcmp(target_cstr, "bfloat" to cstr) == 0 or strcmp(target_cstr, "BFloat16" to cstr) == 0:
                target_type = String.make("bfloat" to cstr)
            elif strcmp(target_cstr, "ptr" to cstr) == 0 or (deref (target_cstr to ptr[u8])) == 112 to u8 or (deref (target_cstr to ptr[u8])) == 91 to u8:
                target_type = String.make("ptr" to cstr)
            elif strcmp(target_cstr, "Any" to cstr) == 0:
                target_type = String.make("{ ptr, ptr }" to cstr)
        if (deref target_type.data) == 37 to u8:
            target_type = String.make("ptr" to cstr)

        if strcmp(target_type.data to cstr, "{ ptr, ptr }" to cstr) == 0 or (target_op.data != None and strcmp(target_op.data to cstr, "Any" to cstr) == 0):
            return self.emit_box_to_any(operand_val, source_type, operand)

        if operand != None to ptr[Node] and node_kind(operand) == NodeType.StringLiteral and (deref target_type.data) == 105 to u8:
            let reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = load i8, ptr ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            if strcmp(target_type.data to cstr, "i8" to cstr) == 0:
                return reg
            let ext as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, ext to cstr)
            append_cstr(ref (deref self).main_out, " = zext i8 ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " to ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, "\n")
            return ext

        if strcmp(operand_val to cstr, "zeroinitializer" to cstr) == 0:
            return "zeroinitializer" to ptr[u8]

        if strcmp(source_type.data to cstr, "void" to cstr) == 0 or strcmp(source_type.data to cstr, target_type.data to cstr) == 0:
            return operand_val

        let reg as ptr[u8] = self.fresh_temp()

        let src_is_int as bool = (deref source_type.data) == 105 to u8 or (deref source_type.data) == 117 to u8
        let tgt_is_int as bool = (deref target_type.data) == 105 to u8 or (deref target_type.data) == 117 to u8
        if src_is_int and tgt_is_int:
            var src_bits as i32 = 64 to i32
            let s_c as cstr = source_type.data to cstr
            if strcmp(s_c, "i1024" to cstr) == 0 or strcmp(s_c, "u1024" to cstr) == 0:
                src_bits = 1024 to i32
            elif strcmp(s_c, "i512" to cstr) == 0 or strcmp(s_c, "u512" to cstr) == 0:
                src_bits = 512 to i32
            elif strcmp(s_c, "i256" to cstr) == 0 or strcmp(s_c, "u256" to cstr) == 0:
                src_bits = 256 to i32
            elif strcmp(s_c, "i128" to cstr) == 0 or strcmp(s_c, "u128" to cstr) == 0:
                src_bits = 128 to i32
            elif strcmp(s_c, "i32" to cstr) == 0 or strcmp(s_c, "u32" to cstr) == 0:
                src_bits = 32 to i32
            elif strcmp(s_c, "i16" to cstr) == 0 or strcmp(s_c, "u16" to cstr) == 0:
                src_bits = 16 to i32
            elif strcmp(s_c, "i8" to cstr) == 0 or strcmp(s_c, "u8" to cstr) == 0 or strcmp(s_c, "i1" to cstr) == 0:
                src_bits = 8 to i32

            var tgt_bits as i32 = 64 to i32
            let t_c as cstr = target_type.data to cstr
            if strcmp(t_c, "i1024" to cstr) == 0 or strcmp(t_c, "u1024" to cstr) == 0:
                tgt_bits = 1024 to i32
            elif strcmp(t_c, "i512" to cstr) == 0 or strcmp(t_c, "u512" to cstr) == 0:
                tgt_bits = 512 to i32
            elif strcmp(t_c, "i256" to cstr) == 0 or strcmp(t_c, "u256" to cstr) == 0:
                tgt_bits = 256 to i32
            elif strcmp(t_c, "i128" to cstr) == 0 or strcmp(t_c, "u128" to cstr) == 0:
                tgt_bits = 128 to i32
            elif strcmp(t_c, "i32" to cstr) == 0 or strcmp(t_c, "u32" to cstr) == 0:
                tgt_bits = 32 to i32
            elif strcmp(t_c, "i16" to cstr) == 0 or strcmp(t_c, "u16" to cstr) == 0:
                tgt_bits = 16 to i32
            elif strcmp(t_c, "i8" to cstr) == 0 or strcmp(t_c, "u8" to cstr) == 0 or strcmp(t_c, "i1" to cstr) == 0:
                tgt_bits = 8 to i32

            if src_bits == tgt_bits:
                return operand_val

            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            if src_bits < tgt_bits:
                append_cstr(ref (deref self).main_out, " = zext ")
            else:
                append_cstr(ref (deref self).main_out, " = trunc ")
            append_str(ref (deref self).main_out, source_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, " to ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, "\n")
            return reg

        let src_is_float as bool = strcmp(source_type.data to cstr, "float" to cstr) == 0 or strcmp(source_type.data to cstr, "double" to cstr) == 0 or strcmp(source_type.data to cstr, "half" to cstr) == 0 or strcmp(source_type.data to cstr, "bfloat" to cstr) == 0 or strcmp(source_type.data to cstr, "fp128" to cstr) == 0
        let tgt_is_float as bool = strcmp(target_type.data to cstr, "float" to cstr) == 0 or strcmp(target_type.data to cstr, "double" to cstr) == 0 or strcmp(target_type.data to cstr, "half" to cstr) == 0 or strcmp(target_type.data to cstr, "bfloat" to cstr) == 0 or strcmp(target_type.data to cstr, "fp128" to cstr) == 0
        if src_is_float and tgt_is_int:
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = fptosi ")
            append_str(ref (deref self).main_out, source_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, " to ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, "\n")
            return reg
        if src_is_int and tgt_is_float:
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = sitofp ")
            append_str(ref (deref self).main_out, source_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, " to ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, "\n")
            return reg

        if src_is_float and tgt_is_float:
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            var src_f_rank as i32 = 0
            let sf_c as cstr = source_type.data to cstr
            if strcmp(sf_c, "fp128" to cstr) == 0:
                src_f_rank = 4
            elif strcmp(sf_c, "double" to cstr) == 0:
                src_f_rank = 3
            elif strcmp(sf_c, "float" to cstr) == 0:
                src_f_rank = 2
            elif strcmp(sf_c, "half" to cstr) == 0 or strcmp(sf_c, "bfloat" to cstr) == 0:
                src_f_rank = 1

            var tgt_f_rank as i32 = 0
            let tf_c as cstr = target_type.data to cstr
            if strcmp(tf_c, "fp128" to cstr) == 0:
                tgt_f_rank = 4
            elif strcmp(tf_c, "double" to cstr) == 0:
                tgt_f_rank = 3
            elif strcmp(tf_c, "float" to cstr) == 0:
                tgt_f_rank = 2
            elif strcmp(tf_c, "half" to cstr) == 0 or strcmp(tf_c, "bfloat" to cstr) == 0:
                tgt_f_rank = 1

            if src_f_rank > tgt_f_rank:
                append_cstr(ref (deref self).main_out, " = fptrunc ")
            else:
                append_cstr(ref (deref self).main_out, " = fpext ")
            append_str(ref (deref self).main_out, source_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, " to ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, "\n")
            return reg

        let src_is_ptr as bool = strcmp(source_type.data to cstr, "ptr" to cstr) == 0
        let tgt_is_ptr as bool = strcmp(target_type.data to cstr, "ptr" to cstr) == 0

        if (deref (operand_val to ptr[u8])) == 37 to u8:
            if tgt_is_ptr:
                if src_is_int:
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, reg to cstr)
                    append_cstr(ref (deref self).main_out, " = inttoptr ")
                    append_str(ref (deref self).main_out, source_type)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, operand_val to cstr)
                    append_cstr(ref (deref self).main_out, " to ptr\n")
                    return reg
                return operand_val
            if tgt_is_int:
                if src_is_ptr:
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, reg to cstr)
                    append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
                    append_cstr(ref (deref self).main_out, operand_val to cstr)
                    append_cstr(ref (deref self).main_out, " to ")
                    append_str(ref (deref self).main_out, target_type)
                    append_cstr(ref (deref self).main_out, "\n")
                    return reg
                else:
                    return operand_val

        if tgt_is_ptr:
            var int_type as String = String.make("i64" to cstr)
            if strcmp(source_type.data to cstr, "i32" to cstr) == 0:
                int_type = String.make("i32" to cstr)
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = inttoptr ")
            append_str(ref (deref self).main_out, int_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, " to ptr\n")
            return reg

        if tgt_is_ptr and src_is_ptr:
            return operand_val

        if src_is_ptr and tgt_is_int:
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, " to ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, "\n")
            return reg

        if tgt_is_ptr and ((deref source_type.data) == 123 to u8 or (deref source_type.data) == 37 to u8):
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = extractvalue ")
            append_str(ref (deref self).main_out, source_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")
            return reg

        if tgt_is_int and ((deref source_type.data) == 123 to u8 or (deref source_type.data) == 37 to u8):
            let ext_ptr as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, ext_ptr to cstr)
            append_cstr(ref (deref self).main_out, " = extractvalue ")
            append_str(ref (deref self).main_out, source_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
            append_cstr(ref (deref self).main_out, ext_ptr to cstr)
            append_cstr(ref (deref self).main_out, " to ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, "\n")
            return reg

        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, reg to cstr)
        append_cstr(ref (deref self).main_out, " = bitcast ")
        append_str(ref (deref self).main_out, source_type)
        append_cstr(ref (deref self).main_out, " ")
        append_cstr(ref (deref self).main_out, operand_val to cstr)
        append_cstr(ref (deref self).main_out, " to ")
        append_str(ref (deref self).main_out, target_type)
        append_cstr(ref (deref self).main_out, "\n")
        return reg

    public fn emit_list_literal(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let items as List[ptr[Node]] = node_declarations(node)
        let count as i64 = items.length()
        let list_t as ptr[Type] = node_inferred_type(node)
        var elem_t as ptr[Type] = None to ptr[Type]
        if list_t != None to ptr[Type] and (deref list_t).payload != None to ptr[Type]:
            elem_t = (deref list_t).payload
        elif count > 0 to i64:
            elem_t = node_inferred_type(get_node_decl(ref items, 0 to i64))
        var elem_type as String = String.make("i64" to cstr)
        var elem_size as i64 = 8 to i64
        if elem_t != None to ptr[Type]:
            elem_type = type_to_llvm(elem_t)
            if strcmp(elem_type.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                elem_type = String.make("ptr" to cstr)
            elem_size = self.type_llvm_byte_size(elem_t)
        if elem_size <= 0 to i64:
            elem_size = 8 to i64

        var has_spread as bool = False
        var i as i64 = 0 to i64
        while i < count:
            let item_check as ptr[Node] = get_node_decl(ref items, i)
            if item_check != None to ptr[Node] and (deref item_check).kind == NodeType.SpreadExpr:
                has_spread = True
            i = i + 1 to i64

        if has_spread:
            let list_alloca as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, list_alloca to cstr)
            append_cstr(ref (deref self).main_out, " = alloca { ptr, i64, i64 }\n")
            append_cstr(ref (deref self).main_out, "  store { ptr, i64, i64 } zeroinitializer, ptr ")
            append_cstr(ref (deref self).main_out, list_alloca to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            i = 0 to i64
            while i < count:
                let it_node as ptr[Node] = get_node_decl(ref items, i)
                if it_node != None to ptr[Node] and (deref it_node).kind == NodeType.SpreadExpr:
                    let src_val as ptr[u8] = self.emit_expr(node_left(it_node))
                    let src_alloca as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, src_alloca to cstr)
                    append_cstr(ref (deref self).main_out, " = alloca { ptr, i64, i64 }\n")
                    append_cstr(ref (deref self).main_out, "  store { ptr, i64, i64 } ")
                    append_cstr(ref (deref self).main_out, src_val to cstr)
                    append_cstr(ref (deref self).main_out, ", ptr ")
                    append_cstr(ref (deref self).main_out, src_alloca to cstr)
                    append_cstr(ref (deref self).main_out, "\n")

                    append_cstr(ref (deref self).main_out, "  call void @__mantiq_list_extend(ptr ")
                    append_cstr(ref (deref self).main_out, list_alloca to cstr)
                    append_cstr(ref (deref self).main_out, ", ptr ")
                    append_cstr(ref (deref self).main_out, src_alloca to cstr)
                    append_cstr(ref (deref self).main_out, ", i64 ")
                    append_i64(ref (deref self).main_out, elem_size)
                    append_cstr(ref (deref self).main_out, ")\n")
                else:
                    let elem_val as ptr[u8] = self.emit_expr(it_node)
                    let elem_alloca as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, elem_alloca to cstr)
                    append_cstr(ref (deref self).main_out, " = alloca ")
                    append_str(ref (deref self).main_out, elem_type)
                    append_cstr(ref (deref self).main_out, "\n")
                    append_cstr(ref (deref self).main_out, "  store ")
                    append_str(ref (deref self).main_out, elem_type)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, elem_val to cstr)
                    append_cstr(ref (deref self).main_out, ", ptr ")
                    append_cstr(ref (deref self).main_out, elem_alloca to cstr)
                    append_cstr(ref (deref self).main_out, "\n")

                    append_cstr(ref (deref self).main_out, "  call void @__mantiq_list_append(ptr ")
                    append_cstr(ref (deref self).main_out, list_alloca to cstr)
                    append_cstr(ref (deref self).main_out, ", ptr ")
                    append_cstr(ref (deref self).main_out, elem_alloca to cstr)
                    append_cstr(ref (deref self).main_out, ", i64 ")
                    append_i64(ref (deref self).main_out, elem_size)
                    append_cstr(ref (deref self).main_out, ")\n")
                i = i + 1 to i64

            let res_load as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, res_load to cstr)
            append_cstr(ref (deref self).main_out, " = load { ptr, i64, i64 }, ptr ")
            append_cstr(ref (deref self).main_out, list_alloca to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return res_load

        let buf_temp as ptr[u8] = self.fresh_temp()
        let count_val as i64 = count
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, buf_temp to cstr)
        append_cstr(ref (deref self).main_out, " = call ptr @malloc(i64 ")
        var buf_size as i64 = count_val * elem_size
        if buf_size <= 0 to i64:
            buf_size = 8 to i64
        append_i64(ref (deref self).main_out, buf_size)
        append_cstr(ref (deref self).main_out, ")\n")

        i = 0 to i64
        while i < count:
            let elem_val as ptr[u8] = self.emit_expr(get_node_decl(ref items, i))
            let idx_temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, idx_temp to cstr)
            append_cstr(ref (deref self).main_out, " = getelementptr i8, ptr ")
            append_cstr(ref (deref self).main_out, buf_temp to cstr)
            append_cstr(ref (deref self).main_out, ", i64 ")
            append_i64(ref (deref self).main_out, i * elem_size)
            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, elem_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, elem_val to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, idx_temp to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            i = i + 1 to i64

        let list_temp as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, list_temp to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } undef, ptr ")
        append_cstr(ref (deref self).main_out, buf_temp to cstr)
        append_cstr(ref (deref self).main_out, ", 0\n")
        let list_temp2 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, list_temp2 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } ")
        append_cstr(ref (deref self).main_out, list_temp to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_i64(ref (deref self).main_out, count_val)
        append_cstr(ref (deref self).main_out, ", 1\n")
        let list_temp3 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, list_temp3 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } ")
        append_cstr(ref (deref self).main_out, list_temp2 to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_i64(ref (deref self).main_out, buf_size)
        append_cstr(ref (deref self).main_out, ", 2\n")
        return list_temp3

    public fn emit_dict_literal(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let dict_t as ptr[Type] = node_inferred_type(node)
        var k_type as String = String.make("i32" to cstr)
        var v_type as String = String.make("i32" to cstr)
        var k_size as i64 = 4 to i64
        var v_size as i64 = 4 to i64
        var is_str as bool = False
        var is_heap_str as bool = False

        if dict_t != None to ptr[Type] and (deref dict_t).payload != None to ptr[Type]:
            let k_t as ptr[Type] = (deref dict_t).payload
            k_type = type_to_llvm(k_t)
            k_size = self.type_llvm_byte_size(k_t)
            if (deref k_t).kind == TypeKind.String:
                is_heap_str = True
            elif (deref k_t).kind == TypeKind.AsciiStr or (deref k_t).kind == TypeKind.Utf8Str or (deref k_t).kind == TypeKind.WebStr or (deref k_t).kind == TypeKind.RangeStr:
                is_str = True

        let items as List[ptr[Node]] = node_declarations(node)
        let count as i64 = items.length()

        var inspect_i as i64 = 0 to i64
        while inspect_i < count:
            let inspect_item as ptr[Node] = get_node_decl(ref items, inspect_i)
            if inspect_item != None to ptr[Node] and (deref inspect_item).kind != NodeType.SpreadExpr:
                let ik_t as ptr[Type] = node_inferred_type(inspect_item)
                if ik_t != None to ptr[Type]:
                    k_type = type_to_llvm(ik_t)
                    k_size = self.type_llvm_byte_size(ik_t)
                    if (deref ik_t).kind == TypeKind.String:
                        is_heap_str = True
                    elif (deref ik_t).kind == TypeKind.AsciiStr or (deref ik_t).kind == TypeKind.Utf8Str or (deref ik_t).kind == TypeKind.WebStr or (deref ik_t).kind == TypeKind.RangeStr:
                        is_str = True
                if inspect_i + 1 to i64 < count:
                    let iv_t as ptr[Type] = node_inferred_type(get_node_decl(ref items, inspect_i + 1 to i64))
                    if iv_t != None to ptr[Type]:
                        v_type = type_to_llvm(iv_t)
                        v_size = self.type_llvm_byte_size(iv_t)
                break
            inspect_i = inspect_i + 1 to i64

        if k_size <= 0 to i64:
            k_size = 8 to i64
        if v_size <= 0 to i64:
            v_size = 8 to i64

        var is_str_flag as i32 = 0 to i32
        if is_heap_str:
            is_str_flag = 2 to i32
        elif is_str:
            is_str_flag = 1 to i32

        let dict_ptr as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, dict_ptr to cstr)
        append_cstr(ref (deref self).main_out, " = call ptr @__mantiq_dict_create(i32 ")
        append_i64(ref (deref self).main_out, k_size)
        append_cstr(ref (deref self).main_out, ", i32 ")
        append_i64(ref (deref self).main_out, v_size)
        append_cstr(ref (deref self).main_out, ", i32 ")
        append_i32(ref (deref self).main_out, is_str_flag)
        append_cstr(ref (deref self).main_out, ")\n")

        var idx as i64 = 0 to i64
        while idx < count:
            let item as ptr[Node] = get_node_decl(ref items, idx)
            if item != None to ptr[Node] and (deref item).kind == NodeType.SpreadExpr:
                let src_dict_val as ptr[u8] = self.emit_expr(node_left(item))
                let src_ptr as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, src_ptr to cstr)
                append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
                append_cstr(ref (deref self).main_out, src_dict_val to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")

                append_cstr(ref (deref self).main_out, "  call void @__mantiq_dict_merge(ptr ")
                append_cstr(ref (deref self).main_out, dict_ptr to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, src_ptr to cstr)
                append_cstr(ref (deref self).main_out, ")\n")
                idx = idx + 1 to i64
            else:
                let key_node as ptr[Node] = item
                let val_node as ptr[Node] = get_node_decl(ref items, idx + 1 to i64)
                let key_val as ptr[u8] = self.emit_expr(key_node)
                let val_val as ptr[u8] = self.emit_expr(val_node)

                let k_alloc as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, k_alloc to cstr)
                append_cstr(ref (deref self).main_out, " = alloca ")
                append_str(ref (deref self).main_out, k_type)
                append_cstr(ref (deref self).main_out, "\n")
                append_cstr(ref (deref self).main_out, "  store ")
                append_str(ref (deref self).main_out, k_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, key_val to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, k_alloc to cstr)
                append_cstr(ref (deref self).main_out, "\n")

                let v_alloc as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, v_alloc to cstr)
                append_cstr(ref (deref self).main_out, " = alloca ")
                append_str(ref (deref self).main_out, v_type)
                append_cstr(ref (deref self).main_out, "\n")
                append_cstr(ref (deref self).main_out, "  store ")
                append_str(ref (deref self).main_out, v_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, val_val to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, v_alloc to cstr)
                append_cstr(ref (deref self).main_out, "\n")

                let hash_temp as ptr[u8] = self.fresh_temp()
                if is_str or is_heap_str:
                    let str_ptr as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, str_ptr to cstr)
                    append_cstr(ref (deref self).main_out, " = extractvalue ")
                    append_str(ref (deref self).main_out, k_type)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, key_val to cstr)
                    append_cstr(ref (deref self).main_out, ", 0\n")

                    let str_len as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, str_len to cstr)
                    append_cstr(ref (deref self).main_out, " = extractvalue ")
                    append_str(ref (deref self).main_out, k_type)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, key_val to cstr)
                    append_cstr(ref (deref self).main_out, ", 1\n")

                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, hash_temp to cstr)
                    append_cstr(ref (deref self).main_out, " = call i32 @__mantiq_hash_string(ptr ")
                    append_cstr(ref (deref self).main_out, str_ptr to cstr)
                    append_cstr(ref (deref self).main_out, ", i64 ")
                    append_cstr(ref (deref self).main_out, str_len to cstr)
                    append_cstr(ref (deref self).main_out, ")\n")
                else:
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, hash_temp to cstr)
                    append_cstr(ref (deref self).main_out, " = call i32 @__mantiq_hash_bytes(ptr ")
                    append_cstr(ref (deref self).main_out, k_alloc to cstr)
                    append_cstr(ref (deref self).main_out, ", i64 ")
                    append_i64(ref (deref self).main_out, k_size)
                    append_cstr(ref (deref self).main_out, ")\n")

                append_cstr(ref (deref self).main_out, "  call void @__mantiq_dict_set(ptr ")
                append_cstr(ref (deref self).main_out, dict_ptr to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, k_alloc to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, v_alloc to cstr)
                append_cstr(ref (deref self).main_out, ", i32 ")
                append_cstr(ref (deref self).main_out, hash_temp to cstr)
                append_cstr(ref (deref self).main_out, ")\n")
                idx = idx + 2 to i64

        let count_ptr as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, count_ptr to cstr)
        append_cstr(ref (deref self).main_out, " = getelementptr i8, ptr ")
        append_cstr(ref (deref self).main_out, dict_ptr to cstr)
        append_cstr(ref (deref self).main_out, ", i64 36\n")

        let count_32 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, count_32 to cstr)
        append_cstr(ref (deref self).main_out, " = load i32, ptr ")
        append_cstr(ref (deref self).main_out, count_ptr to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let final_len as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, final_len to cstr)
        append_cstr(ref (deref self).main_out, " = zext i32 ")
        append_cstr(ref (deref self).main_out, count_32 to cstr)
        append_cstr(ref (deref self).main_out, " to i64\n")

        let dict_temp as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, dict_temp to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } undef, ptr ")
        append_cstr(ref (deref self).main_out, dict_ptr to cstr)
        append_cstr(ref (deref self).main_out, ", 0\n")

        let dict_temp2 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, dict_temp2 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } ")
        append_cstr(ref (deref self).main_out, dict_temp to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_cstr(ref (deref self).main_out, final_len to cstr)
        append_cstr(ref (deref self).main_out, ", 1\n")

        let dict_temp3 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, dict_temp3 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } ")
        append_cstr(ref (deref self).main_out, dict_temp2 to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_cstr(ref (deref self).main_out, final_len to cstr)
        append_cstr(ref (deref self).main_out, ", 2\n")

        return dict_temp3

    public fn emit_list_comprehension(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let yield_node as ptr[Node] = node_right(node)
        let yield_t_desc as ptr[Type] = node_inferred_type(yield_node)
        var yield_llvm_type as String = String.make("i64" to cstr)
        var yield_byte_size as i64 = 8 to i64
        if yield_t_desc != None to ptr[Type]:
            yield_llvm_type = type_to_llvm(yield_t_desc)
            if strcmp(yield_llvm_type.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                yield_llvm_type = String.make("ptr" to cstr)
            yield_byte_size = self.type_llvm_byte_size(yield_t_desc)
        if yield_byte_size <= 0 to i64:
            yield_byte_size = 8 to i64

        let iter_name_ptr as ptr[String] = node_name_ptr(node)
        var iter_name as String = String.make("" to cstr)
        if iter_name_ptr != None to ptr[String]:
            iter_name = deref iter_name_ptr

        let iterable as ptr[Node] = node_left(node)
        var start_node as ptr[Node] = None to ptr[Node]
        var end_node as ptr[Node] = None to ptr[Node]
        let is_range as bool = self.extract_range_nodes(iterable, ref start_node, ref end_node)

        var start_val as ptr[u8] = "0" to ptr[u8]
        var end_val as ptr[u8] = "0" to ptr[u8]
        var total_count_temp as ptr[u8] = "0" to ptr[u8]
        var src_ptr as ptr[u8] = "null" to ptr[u8]
        var elem_llvm_type as String = String.make("i64" to cstr)
        var elem_byte_size as i64 = 8 to i64

        if is_range:
            start_val = self.emit_expr(start_node)
            if start_val != None to ptr[u8] and deref start_val == 37 to u8:
                let st_t as String = type_to_llvm(node_inferred_type(start_node))
                if strcmp(st_t.data to cstr, "i32" to cstr) == 0:
                    let ext as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, ext to cstr)
                    append_cstr(ref (deref self).main_out, " = sext i32 ")
                    append_cstr(ref (deref self).main_out, start_val to cstr)
                    append_cstr(ref (deref self).main_out, " to i64\n")
                    start_val = ext
            end_val = self.emit_expr(end_node)
            if end_val != None to ptr[u8] and deref end_val == 37 to u8:
                let et_t as String = type_to_llvm(node_inferred_type(end_node))
                if strcmp(et_t.data to cstr, "i32" to cstr) == 0:
                    let ext as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, ext to cstr)
                    append_cstr(ref (deref self).main_out, " = sext i32 ")
                    append_cstr(ref (deref self).main_out, end_val to cstr)
                    append_cstr(ref (deref self).main_out, " to i64\n")
                    end_val = ext

            let diff_temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, diff_temp to cstr)
            append_cstr(ref (deref self).main_out, " = sub i64 ")
            append_cstr(ref (deref self).main_out, end_val to cstr)
            append_cstr(ref (deref self).main_out, ", ")
            append_cstr(ref (deref self).main_out, start_val to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            total_count_temp = diff_temp
            let start_t as ptr[Type] = node_inferred_type(start_node)
            if start_t != None to ptr[Type]:
                elem_llvm_type = type_to_llvm(start_t)
                elem_byte_size = self.type_llvm_byte_size(start_t)
        else:
            let iter_val as ptr[u8] = self.emit_expr(iterable)
            let s_ptr_temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, s_ptr_temp to cstr)
            append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
            append_cstr(ref (deref self).main_out, iter_val to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")
            src_ptr = s_ptr_temp

            let s_len_temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, s_len_temp to cstr)
            append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
            append_cstr(ref (deref self).main_out, iter_val to cstr)
            append_cstr(ref (deref self).main_out, ", 1\n")
            total_count_temp = s_len_temp

            let iter_t_desc as ptr[Type] = node_inferred_type(iterable)
            if iter_t_desc != None to ptr[Type] and (deref iter_t_desc).payload != None to ptr[Type]:
                let pl as ptr[Type] = (deref iter_t_desc).payload
                elem_llvm_type = type_to_llvm(pl)
                if strcmp(elem_llvm_type.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                    elem_llvm_type = String.make("ptr" to cstr)
                elem_byte_size = self.type_llvm_byte_size(pl)
            if elem_byte_size <= 0 to i64:
                elem_byte_size = 8 to i64

        let cap_cmp as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, cap_cmp to cstr)
        append_cstr(ref (deref self).main_out, " = icmp sgt i64 ")
        append_cstr(ref (deref self).main_out, total_count_temp to cstr)
        append_cstr(ref (deref self).main_out, ", 0\n")

        let alloc_cap as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, alloc_cap to cstr)
        append_cstr(ref (deref self).main_out, " = select i1 ")
        append_cstr(ref (deref self).main_out, cap_cmp to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_cstr(ref (deref self).main_out, total_count_temp to cstr)
        append_cstr(ref (deref self).main_out, ", i64 8\n")

        let byte_size_temp as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, byte_size_temp to cstr)
        append_cstr(ref (deref self).main_out, " = mul i64 ")
        append_cstr(ref (deref self).main_out, alloc_cap to cstr)
        append_cstr(ref (deref self).main_out, ", ")
        append_i64(ref (deref self).main_out, yield_byte_size)
        append_cstr(ref (deref self).main_out, "\n")

        let buf_temp as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, buf_temp to cstr)
        append_cstr(ref (deref self).main_out, " = call ptr @malloc(i64 ")
        append_cstr(ref (deref self).main_out, byte_size_temp to cstr)
        append_cstr(ref (deref self).main_out, ")\n")

        let acc_buf_slot as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, acc_buf_slot to cstr)
        append_cstr(ref (deref self).main_out, " = alloca ptr\n")
        append_cstr(ref (deref self).main_out, "  store ptr ")
        append_cstr(ref (deref self).main_out, buf_temp to cstr)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, acc_buf_slot to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let acc_len_slot as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, acc_len_slot to cstr)
        append_cstr(ref (deref self).main_out, " = alloca i64\n")
        append_cstr(ref (deref self).main_out, "  store i64 0, ptr ")
        append_cstr(ref (deref self).main_out, acc_len_slot to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let idx_slot as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, idx_slot to cstr)
        append_cstr(ref (deref self).main_out, " = alloca i64\n")
        append_cstr(ref (deref self).main_out, "  store i64 0, ptr ")
        append_cstr(ref (deref self).main_out, idx_slot to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        var slot_name as String = iter_name
        var count as i32 = 0 to i32
        if (deref self).var_counts.has(iter_name):
            count = (deref self).var_counts[iter_name]
        set_dict_i32(ref (deref self).var_counts, iter_name, count + 1 to i32)
        if count > 0 to i32:
            let slot_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
            let _ as i32 = sprintf(slot_buf, "%s_%d" to cstr, iter_name.data to cstr, count)
            slot_name = String.make(slot_buf to cstr)
        set_dict_str(ref (deref self).var_slots, iter_name, slot_name)
        set_dict_str(ref (deref self).var_types, iter_name, elem_llvm_type)

        append_cstr(ref (deref self).main_out, "  %")
        append_str(ref (deref self).main_out, slot_name)
        append_cstr(ref (deref self).main_out, " = alloca ")
        append_str(ref (deref self).main_out, elem_llvm_type)
        append_cstr(ref (deref self).main_out, "\n")

        let cond_label as ptr[u8] = self.fresh_label()
        let body_label as ptr[u8] = self.fresh_label()
        let yield_label as ptr[u8] = self.fresh_label()
        let inc_label as ptr[u8] = self.fresh_label()
        let end_label as ptr[u8] = self.fresh_label()

        append_cstr(ref (deref self).main_out, "  br label %")
        append_cstr(ref (deref self).main_out, cond_label to cstr)
        append_cstr(ref (deref self).main_out, "\n\n")

        // Condition label
        append_cstr(ref (deref self).main_out, cond_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")
        let curr_idx as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, curr_idx to cstr)
        append_cstr(ref (deref self).main_out, " = load i64, ptr ")
        append_cstr(ref (deref self).main_out, idx_slot to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let loop_cmp as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, loop_cmp to cstr)
        append_cstr(ref (deref self).main_out, " = icmp slt i64 ")
        append_cstr(ref (deref self).main_out, curr_idx to cstr)
        append_cstr(ref (deref self).main_out, ", ")
        append_cstr(ref (deref self).main_out, total_count_temp to cstr)
        append_cstr(ref (deref self).main_out, "\n")
        append_cstr(ref (deref self).main_out, "  br i1 ")
        append_cstr(ref (deref self).main_out, loop_cmp to cstr)
        append_cstr(ref (deref self).main_out, ", label %")
        append_cstr(ref (deref self).main_out, body_label to cstr)
        append_cstr(ref (deref self).main_out, ", label %")
        append_cstr(ref (deref self).main_out, end_label to cstr)
        append_cstr(ref (deref self).main_out, "\n\n")

        // Body label
        append_cstr(ref (deref self).main_out, body_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")
        if is_range:
            let r_item as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, r_item to cstr)
            append_cstr(ref (deref self).main_out, " = add i64 ")
            append_cstr(ref (deref self).main_out, start_val to cstr)
            append_cstr(ref (deref self).main_out, ", ")
            append_cstr(ref (deref self).main_out, curr_idx to cstr)
            var store_val as ptr[u8] = r_item
            if strcmp(elem_llvm_type.data to cstr, "i32" to cstr) == 0:
                let tr as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, tr to cstr)
                append_cstr(ref (deref self).main_out, " = trunc i64 ")
                append_cstr(ref (deref self).main_out, r_item to cstr)
                append_cstr(ref (deref self).main_out, " to i32\n")
                store_val = tr
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, elem_llvm_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, store_val to cstr)
            append_cstr(ref (deref self).main_out, ", ptr %")
            append_str(ref (deref self).main_out, slot_name)
            append_cstr(ref (deref self).main_out, "\n")
        else:
            let elem_offset as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, elem_offset to cstr)
            append_cstr(ref (deref self).main_out, " = mul i64 ")
            append_cstr(ref (deref self).main_out, curr_idx to cstr)
            append_cstr(ref (deref self).main_out, ", ")
            append_i64(ref (deref self).main_out, elem_byte_size)
            append_cstr(ref (deref self).main_out, "\n")

            let elem_ptr as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, elem_ptr to cstr)
            append_cstr(ref (deref self).main_out, " = getelementptr i8, ptr ")
            append_cstr(ref (deref self).main_out, src_ptr to cstr)
            append_cstr(ref (deref self).main_out, ", i64 ")
            append_cstr(ref (deref self).main_out, elem_offset to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            let elem_val as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, elem_val to cstr)
            append_cstr(ref (deref self).main_out, " = load ")
            append_str(ref (deref self).main_out, elem_llvm_type)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, elem_ptr to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, elem_llvm_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, elem_val to cstr)
            append_cstr(ref (deref self).main_out, ", ptr %")
            append_str(ref (deref self).main_out, slot_name)
            append_cstr(ref (deref self).main_out, "\n")

        // Condition check
        if node_cond(node) != None to ptr[Node]:
            let cond_val as ptr[u8] = self.emit_expr(node_cond(node))
            let cond_cmp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, cond_cmp to cstr)
            append_cstr(ref (deref self).main_out, " = icmp ne i1 ")
            append_cstr(ref (deref self).main_out, cond_val to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")
            append_cstr(ref (deref self).main_out, "  br i1 ")
            append_cstr(ref (deref self).main_out, cond_cmp to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, yield_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, inc_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")
        else:
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, yield_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

        // Yield label
        append_cstr(ref (deref self).main_out, yield_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")
        let yielded_val as ptr[u8] = self.emit_expr(yield_node)

        let cur_len_temp as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, cur_len_temp to cstr)
        append_cstr(ref (deref self).main_out, " = load i64, ptr ")
        append_cstr(ref (deref self).main_out, acc_len_slot to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let cur_buf_temp as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, cur_buf_temp to cstr)
        append_cstr(ref (deref self).main_out, " = load ptr, ptr ")
        append_cstr(ref (deref self).main_out, acc_buf_slot to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let dest_offset as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, dest_offset to cstr)
        append_cstr(ref (deref self).main_out, " = mul i64 ")
        append_cstr(ref (deref self).main_out, cur_len_temp to cstr)
        append_cstr(ref (deref self).main_out, ", ")
        append_i64(ref (deref self).main_out, yield_byte_size)
        append_cstr(ref (deref self).main_out, "\n")

        let dest_ptr as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, dest_ptr to cstr)
        append_cstr(ref (deref self).main_out, " = getelementptr i8, ptr ")
        append_cstr(ref (deref self).main_out, cur_buf_temp to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_cstr(ref (deref self).main_out, dest_offset to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        append_cstr(ref (deref self).main_out, "  store ")
        append_str(ref (deref self).main_out, yield_llvm_type)
        append_cstr(ref (deref self).main_out, " ")
        append_cstr(ref (deref self).main_out, yielded_val to cstr)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, dest_ptr to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let next_len as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, next_len to cstr)
        append_cstr(ref (deref self).main_out, " = add i64 ")
        append_cstr(ref (deref self).main_out, cur_len_temp to cstr)
        append_cstr(ref (deref self).main_out, ", 1\n")
        append_cstr(ref (deref self).main_out, "  store i64 ")
        append_cstr(ref (deref self).main_out, next_len to cstr)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, acc_len_slot to cstr)
        append_cstr(ref (deref self).main_out, "\n")
        append_cstr(ref (deref self).main_out, "  br label %")
        append_cstr(ref (deref self).main_out, inc_label to cstr)
        append_cstr(ref (deref self).main_out, "\n\n")

        // Inc label
        append_cstr(ref (deref self).main_out, inc_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")
        let next_idx as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, next_idx to cstr)
        append_cstr(ref (deref self).main_out, " = add i64 ")
        append_cstr(ref (deref self).main_out, curr_idx to cstr)
        append_cstr(ref (deref self).main_out, ", 1\n")
        append_cstr(ref (deref self).main_out, "  store i64 ")
        append_cstr(ref (deref self).main_out, next_idx to cstr)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, idx_slot to cstr)
        append_cstr(ref (deref self).main_out, "\n")
        append_cstr(ref (deref self).main_out, "  br label %")
        append_cstr(ref (deref self).main_out, cond_label to cstr)
        append_cstr(ref (deref self).main_out, "\n\n")

        // End label
        append_cstr(ref (deref self).main_out, end_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")
        let final_buf as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, final_buf to cstr)
        append_cstr(ref (deref self).main_out, " = load ptr, ptr ")
        append_cstr(ref (deref self).main_out, acc_buf_slot to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let final_len as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, final_len to cstr)
        append_cstr(ref (deref self).main_out, " = load i64, ptr ")
        append_cstr(ref (deref self).main_out, acc_len_slot to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let fat1 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, fat1 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } undef, ptr ")
        append_cstr(ref (deref self).main_out, final_buf to cstr)
        append_cstr(ref (deref self).main_out, ", 0\n")

        let fat2 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, fat2 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } ")
        append_cstr(ref (deref self).main_out, fat1 to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_cstr(ref (deref self).main_out, final_len to cstr)
        append_cstr(ref (deref self).main_out, ", 1\n")

        let fat3 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, fat3 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } ")
        append_cstr(ref (deref self).main_out, fat2 to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_cstr(ref (deref self).main_out, final_len to cstr)
        append_cstr(ref (deref self).main_out, ", 2\n")

        return fat3

    public fn emit_interpolated_string(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let parts as List[ptr[Node]] = node_declarations(node)
        let count as i64 = parts.length()
        if count == 0 to i64:
            let r_empty as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, r_empty to cstr)
            append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } { ptr null, i64 0, i64 0 }, ptr null, 0\n")
            return r_empty

        var accum_ptr as ptr[u8] = "null" to ptr[u8]
        var accum_len as ptr[u8] = "0" to ptr[u8]

        var i as i64 = 0 to i64
        while i < count:
            let part as ptr[Node] = parts[i]
            let part_val as ptr[u8] = self.emit_expr(part)
            var part_t as ptr[Type] = node_inferred_type(part)
            if part_t == None to ptr[Type]:
                part_t = make_type(TypeKind.Any)

            var new_ptr as ptr[u8] = "null" to ptr[u8]
            var new_len as ptr[u8] = "0" to ptr[u8]

            let pk as TypeKind = (deref part_t).kind
            var is_fat_str as bool = False
            if pk == TypeKind.String or pk == TypeKind.Slice:
                is_fat_str = True
            elif node_kind(part) == NodeType.Identifier:
                let id_n as String = node_name(part)
                if id_n.len > 0 to usize and (deref self).var_types.has(id_n):
                    let vt as String = (deref self).var_types[id_n]
                    if strcmp(vt.data to cstr, "{ ptr, i64, i64 }" to cstr) == 0:
                        is_fat_str = True

            if node_kind(part) == NodeType.StringLiteral:
                new_ptr = part_val
                let len_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, len_temp to cstr)
                append_cstr(ref (deref self).main_out, " = call i64 @strlen(ptr ")
                append_cstr(ref (deref self).main_out, new_ptr to cstr)
                append_cstr(ref (deref self).main_out, ")\n")
                new_len = len_temp
            elif is_fat_str:
                let r_p as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, r_p to cstr)
                append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
                append_cstr(ref (deref self).main_out, part_val to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")
                new_ptr = r_p

                let r_l as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, r_l to cstr)
                append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
                append_cstr(ref (deref self).main_out, part_val to cstr)
                append_cstr(ref (deref self).main_out, ", 1\n")
                new_len = r_l
            elif pk == TypeKind.I32:
                let len_alloca as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, " = alloca i64\n")

                let str_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, str_temp to cstr)
                append_cstr(ref (deref self).main_out, " = call ptr @mantiq_i32_to_str(i32 ")
                append_cstr(ref (deref self).main_out, part_val to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, ")\n")
                new_ptr = str_temp

                let len_load as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, len_load to cstr)
                append_cstr(ref (deref self).main_out, " = load i64, ptr ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, "\n")
                new_len = len_load
            elif pk == TypeKind.I64 or pk == TypeKind.U64 or pk == TypeKind.USize or pk == TypeKind.ISize:
                let len_alloca as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, " = alloca i64\n")

                let str_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, str_temp to cstr)
                append_cstr(ref (deref self).main_out, " = call ptr @mantiq_i64_to_str(i64 ")
                append_cstr(ref (deref self).main_out, part_val to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, ")\n")
                new_ptr = str_temp

                let len_load as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, len_load to cstr)
                append_cstr(ref (deref self).main_out, " = load i64, ptr ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, "\n")
                new_len = len_load
            elif pk == TypeKind.F32:
                let len_alloca as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, " = alloca i64\n")

                let str_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, str_temp to cstr)
                append_cstr(ref (deref self).main_out, " = call ptr @mantiq_float_to_str(float ")
                append_cstr(ref (deref self).main_out, part_val to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, ")\n")
                new_ptr = str_temp

                let len_load as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, len_load to cstr)
                append_cstr(ref (deref self).main_out, " = load i64, ptr ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, "\n")
                new_len = len_load
            elif pk == TypeKind.F64:
                let len_alloca as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, " = alloca i64\n")

                let str_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, str_temp to cstr)
                append_cstr(ref (deref self).main_out, " = call ptr @mantiq_f64_to_str(double ")
                append_cstr(ref (deref self).main_out, part_val to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, ")\n")
                new_ptr = str_temp

                let len_load as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, len_load to cstr)
                append_cstr(ref (deref self).main_out, " = load i64, ptr ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, "\n")
                new_len = len_load
            elif pk == TypeKind.Boolean:
                let i32_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, i32_temp to cstr)
                append_cstr(ref (deref self).main_out, " = zext i8 ")
                append_cstr(ref (deref self).main_out, part_val to cstr)
                append_cstr(ref (deref self).main_out, " to i32\n")

                let len_alloca as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, " = alloca i64\n")

                let str_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, str_temp to cstr)
                append_cstr(ref (deref self).main_out, " = call ptr @mantiq_bool_to_str(i32 ")
                append_cstr(ref (deref self).main_out, i32_temp to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, ")\n")
                new_ptr = str_temp

                let len_load as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, len_load to cstr)
                append_cstr(ref (deref self).main_out, " = load i64, ptr ")
                append_cstr(ref (deref self).main_out, len_alloca to cstr)
                append_cstr(ref (deref self).main_out, "\n")
                new_len = len_load
            else:
                new_ptr = part_val
                let len_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, len_temp to cstr)
                append_cstr(ref (deref self).main_out, " = call i64 @strlen(ptr ")
                append_cstr(ref (deref self).main_out, new_ptr to cstr)
                append_cstr(ref (deref self).main_out, ")\n")
                new_len = len_temp

            let concat_temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, concat_temp to cstr)
            append_cstr(ref (deref self).main_out, " = call ptr @mantiq_concat_str(ptr ")
            append_cstr(ref (deref self).main_out, accum_ptr to cstr)
            append_cstr(ref (deref self).main_out, ", i64 ")
            append_cstr(ref (deref self).main_out, accum_len to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, new_ptr to cstr)
            append_cstr(ref (deref self).main_out, ", i64 ")
            append_cstr(ref (deref self).main_out, new_len to cstr)
            append_cstr(ref (deref self).main_out, ")\n")
            accum_ptr = concat_temp

            let add_temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, add_temp to cstr)
            append_cstr(ref (deref self).main_out, " = add i64 ")
            append_cstr(ref (deref self).main_out, accum_len to cstr)
            append_cstr(ref (deref self).main_out, ", ")
            append_cstr(ref (deref self).main_out, new_len to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            accum_len = add_temp

            i = i + 1 to i64

        let cap_temp as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, cap_temp to cstr)
        append_cstr(ref (deref self).main_out, " = add i64 ")
        append_cstr(ref (deref self).main_out, accum_len to cstr)
        append_cstr(ref (deref self).main_out, ", 1\n")

        let fat1 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, fat1 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } undef, ptr ")
        append_cstr(ref (deref self).main_out, accum_ptr to cstr)
        append_cstr(ref (deref self).main_out, ", 0\n")

        let fat2 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, fat2 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } ")
        append_cstr(ref (deref self).main_out, fat1 to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_cstr(ref (deref self).main_out, accum_len to cstr)
        append_cstr(ref (deref self).main_out, ", 1\n")

        let fat3 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, fat3 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } ")
        append_cstr(ref (deref self).main_out, fat2 to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_cstr(ref (deref self).main_out, cap_temp to cstr)
        append_cstr(ref (deref self).main_out, ", 2\n")

        return fat3

    public fn emit_spawn_stmt(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let call_expr as ptr[Node] = node_left(node)
        if call_expr == None to ptr[Node]:
            return "null" to ptr[u8]

        if node_kind(call_expr) == NodeType.CallExpr:
            let callee as ptr[Node] = node_left(call_expr)
            var func_name as String = String.make("" to cstr)
            if callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier:
                func_name = node_name(callee)
            let func_name_cstr as cstr = func_name.data to cstr

            var resolved_func_name as String = func_name

            var actual_ret_type as ptr[Type] = node_inferred_type(node)
            if actual_ret_type != None to ptr[Type] and (deref actual_ret_type).kind == TypeKind.Task and (deref actual_ret_type).payload != None to ptr[Type]:
                actual_ret_type = (deref actual_ret_type).payload
            var ret_t as String = String.make("void" to cstr)
            if actual_ret_type != None to ptr[Type]:
                ret_t = type_to_llvm(actual_ret_type)
                if strcmp(ret_t.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                    ret_t = String.make("ptr" to cstr)

            let tramp_id as i32 = (deref self).temp_counter
            (deref self).temp_counter = (deref self).temp_counter + 1 to i32

            let env_struct_buf as ptr[u8] = make[u8](256 to usize) to ptr[u8]
            let _s2 as i32 = sprintf(env_struct_buf, "%%env_struct_%s_%d" to cstr, func_name_cstr, tramp_id)
            let env_struct_name as String = String.make(env_struct_buf to cstr)
            free(env_struct_buf to ptr)

            let args as List[ptr[Node]] = node_params(call_expr)
            let arg_cnt as i64 = args.length()

            // Construct environment struct type
            append_str(ref (deref self).type_out, env_struct_name)
            append_cstr(ref (deref self).type_out, " = type { ")
            var i as i64 = 0 to i64
            while i < arg_cnt:
                if i > 0 to i64:
                    append_cstr(ref (deref self).type_out, ", ")
                let arg_node as ptr[Node] = get_node_decl(ref args, i)
                let arg_t_desc as ptr[Type] = node_inferred_type(arg_node)
                var arg_llvm as String = String.make("ptr" to cstr)
                if arg_t_desc != None to ptr[Type]:
                    arg_llvm = type_to_llvm(arg_t_desc)
                    if strcmp(arg_llvm.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                        arg_llvm = String.make("ptr" to cstr)
                append_str(ref (deref self).type_out, arg_llvm)
                i = i + 1 to i64
            append_cstr(ref (deref self).type_out, " }\n")

            // Allocate env buffer
            let env_ptr as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, env_ptr to cstr)
            append_cstr(ref (deref self).main_out, " = call ptr @mantiq_malloc(i64 128)\n")

            // Evaluate each argument and store into %env
            i = 0 to i64
            while i < arg_cnt:
                let arg_node as ptr[Node] = get_node_decl(ref args, i)
                let arg_val as ptr[u8] = self.emit_expr(arg_node)
                let arg_t_desc as ptr[Type] = node_inferred_type(arg_node)
                var arg_llvm as String = String.make("ptr" to cstr)
                if arg_t_desc != None to ptr[Type]:
                    arg_llvm = type_to_llvm(arg_t_desc)
                    if strcmp(arg_llvm.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                        arg_llvm = String.make("ptr" to cstr)
                let f_ptr as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, f_ptr to cstr)
                append_cstr(ref (deref self).main_out, " = getelementptr inbounds ")
                append_str(ref (deref self).main_out, env_struct_name)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, env_ptr to cstr)
                append_cstr(ref (deref self).main_out, ", i32 0, i32 ")
                append_i64(ref (deref self).main_out, i)
                append_cstr(ref (deref self).main_out, "\n")

                append_cstr(ref (deref self).main_out, "  store ")
                append_str(ref (deref self).main_out, arg_llvm)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, arg_val to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, f_ptr to cstr)
                append_cstr(ref (deref self).main_out, "\n")
                i = i + 1 to i64

            // Define outlined trampoline
            let tramp_buf as ptr[u8] = make[u8](256 to usize) to ptr[u8]
            let _s3 as i32 = sprintf(tramp_buf, "%s_trampoline_%d" to cstr, func_name_cstr, tramp_id)
            let tramp_name as String = String.make(tramp_buf to cstr)
            free(tramp_buf to ptr)

            append_cstr(ref (deref self).outlined_out, "define ptr @")
            append_str(ref (deref self).outlined_out, tramp_name)
            append_cstr(ref (deref self).outlined_out, "(ptr %env) {\nentry:\n")

            i = 0 to i64
            while i < arg_cnt:
                let arg_node as ptr[Node] = get_node_decl(ref args, i)
                let arg_t_desc as ptr[Type] = node_inferred_type(arg_node)
                var arg_llvm as String = String.make("ptr" to cstr)
                if arg_t_desc != None to ptr[Type]:
                    arg_llvm = type_to_llvm(arg_t_desc)
                    if strcmp(arg_llvm.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                        arg_llvm = String.make("ptr" to cstr)

                append_cstr(ref (deref self).outlined_out, "  %arg_ptr.")
                append_i64(ref (deref self).outlined_out, i)
                append_cstr(ref (deref self).outlined_out, " = getelementptr inbounds ")
                append_str(ref (deref self).outlined_out, env_struct_name)
                append_cstr(ref (deref self).outlined_out, ", ptr %env, i32 0, i32 ")
                append_i64(ref (deref self).outlined_out, i)
                append_cstr(ref (deref self).outlined_out, "\n")

                append_cstr(ref (deref self).outlined_out, "  %arg.")
                append_i64(ref (deref self).outlined_out, i)
                append_cstr(ref (deref self).outlined_out, " = load ")
                append_str(ref (deref self).outlined_out, arg_llvm)
                append_cstr(ref (deref self).outlined_out, ", ptr %arg_ptr.")
                append_i64(ref (deref self).outlined_out, i)
                append_cstr(ref (deref self).outlined_out, "\n")
                i = i + 1 to i64

            // Call function in trampoline
            if strcmp(ret_t.data to cstr, "void" to cstr) == 0:
                append_cstr(ref (deref self).outlined_out, "  call void @")
                append_str(ref (deref self).outlined_out, resolved_func_name)
                append_cstr(ref (deref self).outlined_out, "(")
                i = 0 to i64
                while i < arg_cnt:
                    if i > 0 to i64:
                        append_cstr(ref (deref self).outlined_out, ", ")
                    let arg_node as ptr[Node] = get_node_decl(ref args, i)
                    let arg_t_desc as ptr[Type] = node_inferred_type(arg_node)
                    var arg_llvm as String = String.make("ptr" to cstr)
                    if arg_t_desc != None to ptr[Type]:
                        arg_llvm = type_to_llvm(arg_t_desc)
                        if strcmp(arg_llvm.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                            arg_llvm = String.make("ptr" to cstr)
                    append_str(ref (deref self).outlined_out, arg_llvm)
                    append_cstr(ref (deref self).outlined_out, " %arg.")
                    append_i64(ref (deref self).outlined_out, i)
                    i = i + 1 to i64
                append_cstr(ref (deref self).outlined_out, ")\n  ret ptr null\n}\n\n")
            else:
                append_cstr(ref (deref self).outlined_out, "  %res = call ")
                append_str(ref (deref self).outlined_out, ret_t)
                append_cstr(ref (deref self).outlined_out, " @")
                append_str(ref (deref self).outlined_out, resolved_func_name)
                append_cstr(ref (deref self).outlined_out, "(")
                i = 0 to i64
                while i < arg_cnt:
                    if i > 0 to i64:
                        append_cstr(ref (deref self).outlined_out, ", ")
                    let arg_node as ptr[Node] = get_node_decl(ref args, i)
                    let arg_t_desc as ptr[Type] = node_inferred_type(arg_node)
                    var arg_llvm as String = String.make("ptr" to cstr)
                    if arg_t_desc != None to ptr[Type]:
                        arg_llvm = type_to_llvm(arg_t_desc)
                        if strcmp(arg_llvm.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                            arg_llvm = String.make("ptr" to cstr)
                    append_str(ref (deref self).outlined_out, arg_llvm)
                    append_cstr(ref (deref self).outlined_out, " %arg.")
                    append_i64(ref (deref self).outlined_out, i)
                    i = i + 1 to i64
                append_cstr(ref (deref self).outlined_out, ")\n")
                append_cstr(ref (deref self).outlined_out, "  %res_ptr = call ptr @mantiq_malloc(i64 128)\n")
                append_cstr(ref (deref self).outlined_out, "  store ")
                append_str(ref (deref self).outlined_out, ret_t)
                append_cstr(ref (deref self).outlined_out, " %res, ptr %res_ptr\n")
                append_cstr(ref (deref self).outlined_out, "  ret ptr %res_ptr\n}\n\n")

            // Spawn task
            let task_ptr as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, task_ptr to cstr)
            append_cstr(ref (deref self).main_out, " = call ptr @mantiq_spawn(ptr @")
            append_str(ref (deref self).main_out, tramp_name)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, env_ptr to cstr)
            append_cstr(ref (deref self).main_out, ")\n")
            return task_ptr

        elif node_kind(call_expr) == NodeType.ClosureExpr:
            let closure_val as ptr[u8] = self.emit_expr(call_expr)
            let task_ptr as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, task_ptr to cstr)
            append_cstr(ref (deref self).main_out, " = call ptr @mantiq_spawn(ptr @")
            append_cstr(ref (deref self).main_out, closure_val to cstr)
            append_cstr(ref (deref self).main_out, ", ptr null)\n")
            return task_ptr

        return "null" to ptr[u8]

    public fn emit_await_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let task_expr as ptr[Node] = node_left(node)
        if task_expr == None to ptr[Node]:
            return "null" to ptr[u8]

        let task_val as ptr[u8] = self.emit_expr(task_expr)
        let await_res as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, await_res to cstr)
        append_cstr(ref (deref self).main_out, " = call ptr @mantiq_await(ptr ")
        append_cstr(ref (deref self).main_out, task_val to cstr)
        append_cstr(ref (deref self).main_out, ")\n")

        let ret_type_desc as ptr[Type] = node_inferred_type(node)
        var t as String = String.make("i32" to cstr)
        if ret_type_desc != None to ptr[Type]:
            t = type_to_llvm(ret_type_desc)
            if strcmp(t.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                t = String.make("ptr" to cstr)

        if strcmp(t.data to cstr, "void" to cstr) == 0:
            return "null" to ptr[u8]

        let loaded as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, loaded to cstr)
        append_cstr(ref (deref self).main_out, " = load ")
        append_str(ref (deref self).main_out, t)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, await_res to cstr)
        append_cstr(ref (deref self).main_out, "\n")
        return loaded

    public fn node_index_collection_is_dict(self as ptr[LLVMCodegen], node as ptr[Node]) as bool:
        let collection as ptr[Node] = node_left(node)
        if collection == None to ptr[Node]:
            return False
        var t as ptr[Type] = node_inferred_type(collection)
        if t != None to ptr[Type]:
            if (deref t).kind == TypeKind.RawPointer and (deref t).payload != None to ptr[Type]:
                let pl as ptr[Type] = (deref t).payload
                t = pl
            if (deref t).kind == TypeKind.Dict:
                return True
            if (deref t).kind == TypeKind.List:
                return False
        if node_kind(collection) == NodeType.MemberExpr:
            let f_nm as String = node_name(collection)
            if f_nm.data != None to ptr[u8]:
                let f_c as cstr = f_nm.data to cstr
                if strcmp(f_c, "symbols" to cstr) == 0 or strcmp(f_c, "loaded_modules" to cstr) == 0 or strcmp(f_c, "module_asts" to cstr) == 0 or strcmp(f_c, "fn_scopes" to cstr) == 0 or strcmp(f_c, "var_slots" to cstr) == 0 or strcmp(f_c, "var_counts" to cstr) == 0 or strcmp(f_c, "var_types" to cstr) == 0 or strcmp(f_c, "struct_sizes" to cstr) == 0 or strcmp(f_c, "struct_field_indices" to cstr) == 0 or strcmp(f_c, "defined_types" to cstr) == 0 or strcmp(f_c, "external_decls" to cstr) == 0 or strcmp(f_c, "auto_drops" to cstr) == 0 or strcmp(f_c, "symbol_states" to cstr) == 0 or strcmp(f_c, "macros" to cstr) == 0 or strcmp(f_c, "macro_args" to cstr) == 0 or strcmp(f_c, "defined_functions" to cstr) == 0 or strcmp(f_c, "program_functions" to cstr) == 0 or strcmp(f_c, "enum_variant_tags" to cstr) == 0 or strcmp(f_c, "type_aliases" to cstr) == 0 or strcmp(f_c, "global_vars" to cstr) == 0 or strcmp(f_c, "global_types" to cstr) == 0:
                    return True
        let index as ptr[Node] = node_right(node)
        if index != None to ptr[Node]:
            let idx_t as ptr[Type] = node_inferred_type(index)
            if idx_t != None to ptr[Type] and (deref idx_t).kind == TypeKind.String:
                return True
            let idx_kind as NodeType = node_kind(index)
            if idx_kind == NodeType.StringLiteral:
                return True
            if idx_kind == NodeType.CallExpr:
                let callee as ptr[Node] = node_left(index)
                if callee != None to ptr[Node] and node_kind(callee) == NodeType.MemberExpr:
                    let m_nm as String = node_name(callee)
                    if m_nm.data != None to ptr[u8] and strcmp(m_nm.data to cstr, "make" to cstr) == 0:
                        return True
        return False

    public fn dict_index_value_llvm(self as ptr[LLVMCodegen], node as ptr[Node]) as String:
        let collection as ptr[Node] = node_left(node)
        if collection == None to ptr[Node]:
            return String.make("ptr" to cstr)
        var t as ptr[Type] = node_inferred_type(collection)
        if t != None to ptr[Type]:
            if (deref t).kind == TypeKind.RawPointer and (deref t).payload != None to ptr[Type]:
                let pl as ptr[Type] = (deref t).payload
                t = pl
            if (deref t).kind == TypeKind.Dict and (deref t).payload != None to ptr[Type]:
                let v as String = type_to_llvm((deref t).payload)
                if strcmp(v.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                    return String.make("ptr" to cstr)
                return v
        if node_kind(collection) == NodeType.MemberExpr:
            let f_nm as String = node_name(collection)
            if f_nm.data != None to ptr[u8]:
                let f_c as cstr = f_nm.data to cstr
                if strcmp(f_c, "struct_sizes" to cstr) == 0:
                    return String.make("i64" to cstr)
                if strcmp(f_c, "struct_field_indices" to cstr) == 0 or strcmp(f_c, "var_counts" to cstr) == 0 or strcmp(f_c, "enum_variant_tags" to cstr) == 0:
                    return String.make("i32" to cstr)
                if strcmp(f_c, "defined_types" to cstr) == 0 or strcmp(f_c, "external_decls" to cstr) == 0 or strcmp(f_c, "defined_functions" to cstr) == 0 or strcmp(f_c, "program_functions" to cstr) == 0 or strcmp(f_c, "global_vars" to cstr) == 0:
                    return String.make("i1" to cstr)
                if strcmp(f_c, "var_slots" to cstr) == 0 or strcmp(f_c, "var_types" to cstr) == 0 or strcmp(f_c, "auto_drops" to cstr) == 0 or strcmp(f_c, "type_aliases" to cstr) == 0 or strcmp(f_c, "global_types" to cstr) == 0:
                    return String.make("{ ptr, i64, i64 }" to cstr)
                if strcmp(f_c, "macros" to cstr) == 0:
                    return String.make("%MacroDef" to cstr)
                if strcmp(f_c, "symbol_states" to cstr) == 0:
                    return String.make("%VarInfo" to cstr)
        return String.make("ptr" to cstr)

    public fn wrap_string_literal_key(self as ptr[LLVMCodegen], node as ptr[Node], raw_val as ptr[u8]) as ptr[u8]:
        let sp as ptr[String] = node_str_val_ptr(node)
        var slen as i64 = 0 to i64
        if sp != None to ptr[String]:
            slen = (deref sp).len to i64
            if (deref sp).data != None to ptr[u8] and (deref (deref sp).data) == 34 to u8 and slen >= 2 to i64:
                slen = slen - 2 to i64
        let w1 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, w1 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } undef, ptr ")
        append_cstr(ref (deref self).main_out, raw_val to cstr)
        append_cstr(ref (deref self).main_out, ", 0\n")
        let w2 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, w2 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } ")
        append_cstr(ref (deref self).main_out, w1 to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_i64(ref (deref self).main_out, slen)
        append_cstr(ref (deref self).main_out, ", 1\n")
        return w2

    public fn dict_key_size_from_name(self as ptr[LLVMCodegen], name as cstr) as i64:
        if strcmp(name, "String" to cstr) == 0:
            return 24 to i64
        elif strcmp(name, "i8" to cstr) == 0 or strcmp(name, "u8" to cstr) == 0 or strcmp(name, "byte" to cstr) == 0 or strcmp(name, "bool" to cstr) == 0 or strcmp(name, "char" to cstr) == 0:
            return 1 to i64
        elif strcmp(name, "i16" to cstr) == 0 or strcmp(name, "u16" to cstr) == 0:
            return 2 to i64
        elif strcmp(name, "i32" to cstr) == 0 or strcmp(name, "u32" to cstr) == 0 or strcmp(name, "f32" to cstr) == 0:
            return 4 to i64
        return 8 to i64

    public fn dict_declared_key_size(self as ptr[LLVMCodegen], node as ptr[Node]) as i64:
        var t as ptr[Type] = node_inferred_type(node)
        if t != None to ptr[Type]:
            if (deref t).kind == TypeKind.RawPointer and (deref t).payload != None to ptr[Type]:
                t = (deref t).payload
            if (deref t).kind == TypeKind.Dict and (deref t).name.data != None to ptr[u8] and (deref t).name.len > 0 to usize:
                return self.dict_key_size_from_name((deref t).name.data to cstr)
        if node_kind(node) == NodeType.MemberExpr:
            let f_nm as String = node_name(node)
            if f_nm.data != None to ptr[u8]:
                let f_c as cstr = f_nm.data to cstr
                if strcmp(f_c, "macros" to cstr) == 0 or strcmp(f_c, "macro_args" to cstr) == 0 or strcmp(f_c, "symbols" to cstr) == 0 or strcmp(f_c, "loaded_modules" to cstr) == 0 or strcmp(f_c, "module_asts" to cstr) == 0 or strcmp(f_c, "var_slots" to cstr) == 0 or strcmp(f_c, "var_counts" to cstr) == 0 or strcmp(f_c, "var_types" to cstr) == 0 or strcmp(f_c, "struct_sizes" to cstr) == 0 or strcmp(f_c, "struct_field_indices" to cstr) == 0 or strcmp(f_c, "defined_types" to cstr) == 0 or strcmp(f_c, "external_decls" to cstr) == 0 or strcmp(f_c, "symbol_states" to cstr) == 0 or strcmp(f_c, "defined_functions" to cstr) == 0 or strcmp(f_c, "program_functions" to cstr) == 0 or strcmp(f_c, "enum_variant_tags" to cstr) == 0 or strcmp(f_c, "type_aliases" to cstr) == 0 or strcmp(f_c, "global_vars" to cstr) == 0 or strcmp(f_c, "global_types" to cstr) == 0:
                    return 24 to i64
        return 8 to i64

    public fn widen_literal_int_key(self as ptr[LLVMCodegen], node as ptr[Node], val as ptr[u8], vtype as String, declared_size as i64) as ptr[u8]:
        if node_kind(node) == NodeType.NumberLiteral and strcmp(vtype.data to cstr, "i32") == 0 and declared_size == 8 to i64:
            let w as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, w to cstr)
            append_cstr(ref (deref self).main_out, " = sext i32 ")
            append_cstr(ref (deref self).main_out, val to cstr)
            append_cstr(ref (deref self).main_out, " to i64\n")
            return w
        return val

    public fn emit_dict_index_slot(self as ptr[LLVMCodegen], node as ptr[Node], for_write as bool) as ptr[u8]:
        let collection as ptr[Node] = node_left(node)
        let index as ptr[Node] = node_right(node)
        let coll_val as ptr[u8] = self.emit_expr(collection)
        let coll_type as String = type_to_llvm(node_inferred_type(collection))
        var ptr_temp as ptr[u8] = coll_val
        var is_struct_val as bool = False
        if strcmp(coll_type.data to cstr, "{ ptr, i64, i64 }" to cstr) == 0:
            is_struct_val = True
        elif node_kind(collection) == NodeType.MemberExpr:
            let f_nm as String = node_name(collection)
            if f_nm.data != None to ptr[u8]:
                let f_c as cstr = f_nm.data to cstr
                if strcmp(f_c, "macros" to cstr) == 0 or strcmp(f_c, "macro_args" to cstr) == 0 or strcmp(f_c, "symbols" to cstr) == 0 or strcmp(f_c, "loaded_modules" to cstr) == 0 or strcmp(f_c, "module_asts" to cstr) == 0 or strcmp(f_c, "fn_scopes" to cstr) == 0 or strcmp(f_c, "var_slots" to cstr) == 0 or strcmp(f_c, "var_counts" to cstr) == 0 or strcmp(f_c, "var_types" to cstr) == 0 or strcmp(f_c, "struct_sizes" to cstr) == 0 or strcmp(f_c, "struct_field_indices" to cstr) == 0 or strcmp(f_c, "defined_types" to cstr) == 0 or strcmp(f_c, "external_decls" to cstr) == 0 or strcmp(f_c, "auto_drops" to cstr) == 0 or strcmp(f_c, "symbol_states" to cstr) == 0 or strcmp(f_c, "defined_functions" to cstr) == 0 or strcmp(f_c, "program_functions" to cstr) == 0 or strcmp(f_c, "enum_variant_tags" to cstr) == 0 or strcmp(f_c, "type_aliases" to cstr) == 0 or strcmp(f_c, "global_vars" to cstr) == 0 or strcmp(f_c, "global_types" to cstr) == 0:
                    is_struct_val = True
        if is_struct_val and (deref coll_val) == 37 to u8:
            let ext as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, ext to cstr)
            append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
            append_cstr(ref (deref self).main_out, coll_val to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")
            ptr_temp = ext
        let idx_val as ptr[u8] = self.emit_expr(index)
        var idx_type as String = type_to_llvm(node_inferred_type(index))
        if node_kind(index) == NodeType.IndexExpr:
            idx_type = self.index_value_llvm(index)
        var idx_emit as ptr[u8] = idx_val
        if node_kind(index) == NodeType.StringLiteral and strcmp(idx_type.data to cstr, "{ ptr, i64, i64 }") == 0:
            idx_emit = self.wrap_string_literal_key(index, idx_val)
        let d_key_size as i64 = self.dict_declared_key_size(collection)
        if strcmp(idx_type.data to cstr, "void" to cstr) == 0 or strcmp(idx_type.data to cstr, "{ ptr, ptr }" to cstr) == 0 or idx_type.len == 0 to usize:
            if d_key_size == 24 to i64:
                idx_type = String.make("{ ptr, i64, i64 }" to cstr)
            elif d_key_size == 4 to i64:
                idx_type = String.make("i32" to cstr)
            elif d_key_size == 2 to i64:
                idx_type = String.make("i16" to cstr)
            elif d_key_size == 1 to i64:
                idx_type = String.make("i8" to cstr)
            else:
                idx_type = String.make("i64" to cstr)
        if strcmp(idx_type.data to cstr, "{ ptr, i64, i64 }") != 0:
            let widened as ptr[u8] = self.widen_literal_int_key(index, idx_emit, idx_type, d_key_size)
            if widened != idx_emit:
                idx_emit = widened
                idx_type = String.make("i64" to cstr)
        let key_alloc as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, key_alloc to cstr)
        append_cstr(ref (deref self).main_out, " = alloca ")
        append_str(ref (deref self).main_out, idx_type)
        append_cstr(ref (deref self).main_out, "\n")
        append_cstr(ref (deref self).main_out, "  store ")
        append_str(ref (deref self).main_out, idx_type)
        append_cstr(ref (deref self).main_out, " ")
        append_cstr(ref (deref self).main_out, idx_emit to cstr)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, key_alloc to cstr)
        append_cstr(ref (deref self).main_out, "\n")
        var hash_reg as ptr[u8] = "0" to ptr[u8]
        if strcmp(idx_type.data to cstr, "{ ptr, i64, i64 }" to cstr) == 0:
            let str_ptr as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, str_ptr to cstr)
            append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
            append_cstr(ref (deref self).main_out, idx_emit to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")
            let str_len as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, str_len to cstr)
            append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
            append_cstr(ref (deref self).main_out, idx_emit to cstr)
            append_cstr(ref (deref self).main_out, ", 1\n")
            let h_t as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, h_t to cstr)
            append_cstr(ref (deref self).main_out, " = call i32 @__mantiq_hash_string(ptr ")
            append_cstr(ref (deref self).main_out, str_ptr to cstr)
            append_cstr(ref (deref self).main_out, ", i64 ")
            append_cstr(ref (deref self).main_out, str_len to cstr)
            append_cstr(ref (deref self).main_out, ")\n")
            hash_reg = h_t
        else:
            let h_b as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, h_b to cstr)
            append_cstr(ref (deref self).main_out, " = call i32 @__mantiq_hash_bytes(ptr ")
            append_cstr(ref (deref self).main_out, key_alloc to cstr)
            append_cstr(ref (deref self).main_out, ", i64 ")
            append_i64(ref (deref self).main_out, d_key_size)
            append_cstr(ref (deref self).main_out, ")\n")
            hash_reg = h_b
        let slot as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, slot to cstr)
        if for_write:
            append_cstr(ref (deref self).main_out, " = call ptr @__mantiq_dict_get_or_insert(ptr ")
        else:
            append_cstr(ref (deref self).main_out, " = call ptr @__mantiq_dict_get(ptr ")
        append_cstr(ref (deref self).main_out, ptr_temp to cstr)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, key_alloc to cstr)
        append_cstr(ref (deref self).main_out, ", i32 ")
        append_cstr(ref (deref self).main_out, hash_reg to cstr)
        append_cstr(ref (deref self).main_out, ")\n")
        return slot

    public fn emit_index_addr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let collection as ptr[Node] = node_left(node)
        let index as ptr[Node] = node_right(node)
        if self.node_index_collection_is_dict(node):
            return self.emit_dict_index_slot(node, False)
        let coll_val as ptr[u8] = self.emit_expr(collection)
        let idx_val as ptr[u8] = self.emit_expr(index)
        var real_idx as ptr[u8] = idx_val
        let idx_type as String = type_to_llvm(node_inferred_type(index))
        let is_int_idx as bool = strcmp(idx_type.data to cstr, "i64" to cstr) == 0 or strcmp(idx_type.data to cstr, "i32" to cstr) == 0 or node_kind(index) == NodeType.NumberLiteral
        if strcmp(idx_type.data to cstr, "{ ptr, i64, i64 }" to cstr) == 0 and (deref idx_val) == 37 to u8:
            let ext_idx as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, ext_idx to cstr)
            append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
            append_cstr(ref (deref self).main_out, idx_val to cstr)
            append_cstr(ref (deref self).main_out, ", 1\n")
            real_idx = ext_idx
        elif strcmp(idx_type.data to cstr, "ptr" to cstr) == 0 or (not is_int_idx and (deref idx_val) == 37 to u8):
            let p2i_reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, p2i_reg to cstr)
            append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
            append_cstr(ref (deref self).main_out, real_idx to cstr)
            append_cstr(ref (deref self).main_out, " to i64\n")
            real_idx = p2i_reg

        let coll_type as String = type_to_llvm(node_inferred_type(collection))
        var ptr_temp as ptr[u8] = coll_val
        var is_agg_coll as bool = strcmp(coll_type.data to cstr, "{ ptr, i64, i64 }" to cstr) == 0
        if not is_agg_coll and node_kind(collection) == NodeType.MemberExpr:
            let f_nm as String = node_name(collection)
            if f_nm.data != None:
                let f_t as String = get_struct_field_type("Node" to cstr, f_nm.data to cstr)
                if strcmp(f_t.data to cstr, "{ ptr, i64, i64 }" to cstr) == 0:
                    is_agg_coll = True
        if is_agg_coll:
            let ext_reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, ext_reg to cstr)
            append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
            append_cstr(ref (deref self).main_out, coll_val to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")
            ptr_temp = ext_reg

        let gelem_t as String = self.index_value_llvm(node)
        let elem_ptr as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, elem_ptr to cstr)
        append_cstr(ref (deref self).main_out, " = getelementptr inbounds ")
        append_str(ref (deref self).main_out, gelem_t)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, ptr_temp to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_cstr(ref (deref self).main_out, real_idx to cstr)
        append_cstr(ref (deref self).main_out, "\n")
        return elem_ptr

    public fn index_value_llvm(self as ptr[LLVMCodegen], node as ptr[Node]) as String:
        if self.node_index_collection_is_dict(node):
            return self.dict_index_value_llvm(node)
        let collection as ptr[Node] = node_left(node)
        var elem_type as String = type_to_llvm(node_inferred_type(node))
        let coll_t as ptr[Type] = node_inferred_type(collection)
        var is_byte_buf as bool = False
        if node_name(collection).data != None:
            let cn as cstr = node_name(collection).data to cstr
            if strcmp(cn, "source_code") == 0:
                is_byte_buf = True
        var resolved_elem as bool = False
        if coll_t != None to ptr[Type]:
            var ct as ptr[Type] = coll_t
            if (deref ct).kind == TypeKind.RawPointer and (deref ct).payload != None to ptr[Type]:
                let pl as ptr[Type] = (deref ct).payload
                let pe as String = type_to_llvm(pl)
                var pe_s as String = pe
                if strcmp(pe_s.data to cstr, "{ ptr, ptr }") == 0:
                    pe_s = String.make("ptr" to cstr)
                elif strcmp(pe_s.data to cstr, "i1") == 0:
                    pe_s = String.make("i8" to cstr)
                elem_type = pe_s
                resolved_elem = True
            elif (deref ct).kind == TypeKind.List or (deref ct).kind == TypeKind.Dict:
                if (deref ct).payload != None to ptr[Type]:
                    let pe as String = type_to_llvm((deref ct).payload)
                    var pe_s as String = pe
                    if strcmp(pe_s.data to cstr, "{ ptr, ptr }") == 0:
                        pe_s = String.make("ptr" to cstr)
                    elif strcmp(pe_s.data to cstr, "i1") == 0:
                        pe_s = String.make("i8" to cstr)
                    elem_type = pe_s
                    resolved_elem = True
            elif (deref ct).kind == TypeKind.String or (deref ct).kind == TypeKind.U8 or (deref ct).kind == TypeKind.I8:
                elem_type = String.make("i8" to cstr)
                resolved_elem = True
        if not resolved_elem:
            if strcmp((deref self).current_return_type.data to cstr, "i8") == 0:
                elem_type = String.make("i8" to cstr)
            elif strcmp(elem_type.data to cstr, "{ ptr, ptr }" to cstr) == 0 or strcmp(elem_type.data to cstr, "ptr") == 0:
                if is_byte_buf:
                    elem_type = String.make("i8" to cstr)
                else:
                    elem_type = String.make("ptr" to cstr)
        return elem_type

    public fn emit_index_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        if self.node_index_collection_is_dict(node):
            let slot as ptr[u8] = self.emit_dict_index_slot(node, False)
            let elem_t as String = self.index_value_llvm(node)
            let reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = load ")
            append_str(ref (deref self).main_out, elem_t)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, slot to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return reg

        let elem_type as String = self.index_value_llvm(node)
        let elem_ptr as ptr[u8] = self.emit_index_addr(node)
        let reg as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, reg to cstr)
        append_cstr(ref (deref self).main_out, " = load ")
        append_str(ref (deref self).main_out, elem_type)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, elem_ptr to cstr)
        append_cstr(ref (deref self).main_out, "\n")
        return reg

    public fn emit_closure_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let fn_name as ptr[u8] = self.fresh_closure_name()
        let params as List[ptr[Node]] = node_params(node)
        let body as ptr[Node] = node_body(node)

        var ret_type as String = type_to_llvm(node_inferred_type(node))
        if str_eq(ret_type, String.make("void" to cstr)):
            if body != None to ptr[Node] and node_kind(body) != NodeType.BlockStmt:
                let body_t as String = type_to_llvm(node_inferred_type(body))
                if str_eq(body_t, String.make("void" to cstr)) == False:
                    ret_type = body_t
                else:
                    ret_type = String.make("i64" to cstr)
            else:
                ret_type = String.make("i64" to cstr)

        let temp_main as StringBuilder = (deref self).main_out
        (deref self).main_out = (deref self).outlined_out

        append_cstr(ref (deref self).main_out, "define ")
        append_str(ref (deref self).main_out, ret_type)
        append_cstr(ref (deref self).main_out, " @")
        append_cstr(ref (deref self).main_out, fn_name to cstr)
        append_cstr(ref (deref self).main_out, "(ptr %env")

        let p_count as i64 = params.length()
        var p_idx as i64 = 0 to i64
        while p_idx < p_count:
            let p as ptr[Node] = get_node_decl(ref params, p_idx)
            let p_name_ptr as ptr[String] = node_name_ptr(p)
            let p_type as String = type_to_llvm(node_inferred_type(p))
            append_cstr(ref (deref self).main_out, ", ")
            append_str(ref (deref self).main_out, p_type)
            append_cstr(ref (deref self).main_out, " %")
            if p_name_ptr != None to ptr[String]:
                append_str(ref (deref self).main_out, deref p_name_ptr)
            p_idx = p_idx + 1 to i64

        append_cstr(ref (deref self).main_out, ") {\nentry:\n")

        if body != None to ptr[Node]:
            if node_kind(body) != NodeType.BlockStmt:
                let ret_reg as ptr[u8] = self.emit_expr(body)
                append_cstr(ref (deref self).main_out, "  ret ")
                append_str(ref (deref self).main_out, ret_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, ret_reg to cstr)
                append_cstr(ref (deref self).main_out, "\n")
            else:
                self.emit_node(body)

        append_cstr(ref (deref self).main_out, "}\n\n")

        (deref self).outlined_out = (deref self).main_out
        (deref self).main_out = temp_main

        let closure_reg as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, closure_reg to cstr)
        append_cstr(ref (deref self).main_out, " = alloca { ptr, ptr }\n")

        let fn_ptr_reg as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, fn_ptr_reg to cstr)
        append_cstr(ref (deref self).main_out, " = getelementptr inbounds { ptr, ptr }, ptr ")
        append_cstr(ref (deref self).main_out, closure_reg to cstr)
        append_cstr(ref (deref self).main_out, ", i32 0, i32 0\n")
        append_cstr(ref (deref self).main_out, "  store ptr @")
        append_cstr(ref (deref self).main_out, fn_name to cstr)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, fn_ptr_reg to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let env_ptr_reg as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, env_ptr_reg to cstr)
        append_cstr(ref (deref self).main_out, " = getelementptr inbounds { ptr, ptr }, ptr ")
        append_cstr(ref (deref self).main_out, closure_reg to cstr)
        append_cstr(ref (deref self).main_out, ", i32 0, i32 1\n")
        append_cstr(ref (deref self).main_out, "  store ptr null, ptr ")
        append_cstr(ref (deref self).main_out, env_ptr_reg to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        return closure_reg

    public fn emit_auto_drops(self as ptr[LLVMCodegen], drops as List[String]):
        let count as i64 = drops.length()
        var i as i64 = 0 to i64
        while i < count:
            var var_name as String = drops[i]
            if (deref self).var_slots.has(var_name):
                var_name = (deref self).var_slots[var_name]
            let load_reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, load_reg to cstr)
            append_cstr(ref (deref self).main_out, " = load ptr, ptr %")
            append_str(ref (deref self).main_out, var_name)
            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, "  call void @mantiq_free(ptr ")
            append_cstr(ref (deref self).main_out, load_reg to cstr)
            append_cstr(ref (deref self).main_out, ")\n")
            i = i + 1 to i64

    public fn populate_auto_drops_from_borrowck(self as ptr[LLVMCodegen], borroWck_auto_drops as Dict[usize, List[ptr[Symbol]]]):
        pass

    public fn set_auto_drops_for_node(self as ptr[LLVMCodegen], node_addr as usize, drop_names as List[String]):
        set_dict_drops(ref (deref self).auto_drops, node_addr, drop_names)

    public fn emit_struct_methods(self as ptr[LLVMCodegen], node as ptr[Node]):
        extern fn strcmp(s1 as cstr, s2 as cstr) as i32
        let struct_name as String = node_name(node)
        if node_body(node) != None to ptr[Node]:
            let body as ptr[Node] = node_body(node)
            let decls_raw3 as List[ptr[Node]] = node_declarations(body)
            let decls as ptr[List[ptr[Node]]] = ref decls_raw3
            let count as i64 = (deref decls).length()
            var i as i64 = 0 to i64
            while i < count:
                let decl as ptr[Node] = get_node_decl(decls, i)
                let is_fun as bool = node_kind(decl) == NodeType.FunDecl
                if is_fun:
                    let method_name as String = node_name(decl)
                    let mangled as StringBuilder = StringBuilder.make()
                    append_str(ref mangled, struct_name)
                    append_cstr(ref mangled, "_" to cstr)
                    append_str(ref mangled, method_name)
                    set_node_name(decl, mangled.to_string())
                    let saved_st as String = (deref self).current_struct_name
                    (deref self).current_struct_name = struct_name
                    self.emit_fun_decl(decl)
                    (deref self).current_struct_name = saved_st
                    set_node_name(decl, method_name)
                    mangled.deinit()
                i = i + 1 to i64

    public fn get_field_llvm_type(self as ptr[LLVMCodegen], decl as ptr[Node]) as String:
        let resolved_type as ptr[Type] = self.resolve_field_type(decl)
        if resolved_type != None to ptr[Type]:
            let r_llvm as String = type_to_llvm(resolved_type)
            if r_llvm.data != None to ptr[u8]:
                return r_llvm
        let f_nm as String = node_name(decl)
        if f_nm.data != None to ptr[u8]:
            return get_struct_field_type("Node" to cstr, f_nm.data to cstr)
        return String.make("ptr" to cstr)

    public fn emit_one_struct_field(self as ptr[LLVMCodegen], decl as ptr[Node], fields_str as ptr[StringBuilder], field_idx_ptr as ptr[i64]):
        let is_var as bool = node_kind(decl) == NodeType.VarDecl or node_kind(decl) == NodeType.FieldDecl
        if is_var:
            if deref field_idx_ptr > 0 to i64:
                append_cstr(fields_str, ", " to cstr)
            let f_t as String = self.get_field_llvm_type(decl)
            if f_t.data != None to ptr[u8]:
                append_cstr(fields_str, f_t.data to cstr)
            deref field_idx_ptr = deref field_idx_ptr + 1 to i64

    public fn emit_struct_fields(self as ptr[LLVMCodegen], node as ptr[Node], name as String):
        let fields_str as StringBuilder = StringBuilder.make()
        var field_idx as i64 = 0 to i64

        let body as ptr[Node] = node_body(node)
        if body != None to ptr[Node]:
            let decls_raw as List[ptr[Node]] = node_declarations(body)
            let decls as ptr[List[ptr[Node]]] = ref decls_raw
            let count as i64 = (deref decls).length()
            var i as i64 = 0 to i64
            while i < count:
                let decl as ptr[Node] = get_node_decl(decls, i)
                if node_kind(decl) == NodeType.VarDecl or node_kind(decl) == NodeType.FieldDecl:
                    let f_nm as String = node_name(decl)
                    if f_nm.data != None to ptr[u8]:
                        let f_key as StringBuilder = StringBuilder.make()
                        append_str(ref f_key, name)
                        append_cstr(ref f_key, "." to cstr)
                        append_str(ref f_key, f_nm)
                        let f_ks as String = f_key.to_string()
                        set_dict_i32(ref (deref self).struct_field_indices, f_ks, field_idx to i32)
                        f_key.deinit()
                self.emit_one_struct_field(decl, ref fields_str, ref field_idx)
                i = i + 1 to i64
        else:
            let decls_raw as List[ptr[Node]] = node_declarations(node)
            let decls as ptr[List[ptr[Node]]] = ref decls_raw
            let count as i64 = (deref decls).length()
            var i as i64 = 0 to i64
            while i < count:
                let decl as ptr[Node] = get_node_decl(decls, i)
                if node_kind(decl) == NodeType.VarDecl or node_kind(decl) == NodeType.FieldDecl:
                    let f_nm as String = node_name(decl)
                    if f_nm.data != None to ptr[u8]:
                        let f_key as StringBuilder = StringBuilder.make()
                        append_str(ref f_key, name)
                        append_cstr(ref f_key, "." to cstr)
                        append_str(ref f_key, f_nm)
                        let f_ks as String = f_key.to_string()
                        set_dict_i32(ref (deref self).struct_field_indices, f_ks, field_idx to i32)
                        f_key.deinit()
                self.emit_one_struct_field(decl, ref fields_str, ref field_idx)
                i = i + 1 to i64

        if field_idx == 0 to i64:
            append_cstr(ref fields_str, "i8" to cstr)

        let body_str as StringBuilder = StringBuilder.make()
        append_cstr(ref body_str, "{ " to cstr)
        append_str(ref body_str, fields_str.to_string())
        append_cstr(ref body_str, " }" to cstr)
        let body_s as String = body_str.to_string()

        append_cstr(ref (deref self).type_out, "%" to cstr)
        append_str(ref (deref self).type_out, name)
        append_cstr(ref (deref self).type_out, " = type " to cstr)
        append_str(ref (deref self).type_out, body_s)
        append_cstr(ref (deref self).type_out, "\n\n" to cstr)

        if not (deref self).struct_sizes.has(name):
            let sz as i64 = self.llvm_type_byte_size(body_s)
            set_dict_i64(ref (deref self).struct_sizes, name, sz)
        fields_str.deinit()
        body_str.deinit()

    public fn resolve_field_type(self as ptr[LLVMCodegen], decl as ptr[Node]) as ptr[Type]:
        let inf as ptr[Type] = node_inferred_type(decl)
        if inf != None to ptr[Type]:
            return inf
        let annots_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(decl)
        if annots_ptr != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
            let annots as List[Option[ptr[TypeAnnotation]]] = deref annots_ptr
            if annots.length() > 0 to i64:
                let opt as Option[ptr[TypeAnnotation]] = annots[0 to i64]
                let opt_ref as ptr[OptionLayout] = (ref opt) to ptr[OptionLayout]
                if option_has_value(opt_ref):
                    let pa as ptr[TypeAnnotation] = option_unwrap_ptr(opt_ref) to ptr[TypeAnnotation]
                    if pa != None to ptr[TypeAnnotation] and (deref pa).name.data != None:
                        return (deref self).resolve_type_from_annotation(pa)
        return None to ptr[Type]

    public fn emit_struct_decl(self as ptr[LLVMCodegen], node as ptr[Node]):
        let name as String = node_name(node)
        if not (deref self).defined_types.has(name):
            set_dict_bool(ref (deref self).defined_types, name, True)
            self.emit_struct_fields(node, name)

        self.emit_struct_methods(node)

    public fn compute_type_id(self as ptr[LLVMCodegen], type_name as String) as i32:
        if type_name.data == None to ptr[u8] or type_name.len == 0 to usize:
            return 0 to i32
        var h as i64 = 5381 to i64
        var i as usize = 0 to usize
        while i < type_name.len:
            let b as u8 = deref ((type_name.data to usize + i) to ptr[u8])
            let b_val as i64 = b to i64
            h = ((h * (33 to i64)) + b_val) % (2147483647 to i64)
            i = i + 1 to usize
        let res as i32 = (h % (2147483647 to i64)) to i32
        if res == 0 to i32:
            return 1 to i32
        return res

    public fn emit_box_to_any(self as ptr[LLVMCodegen], val_reg as ptr[u8], val_type as String, val_node as ptr[Node]) as ptr[u8]:
        var type_name as String = String.make("i32" to cstr)
        if val_node != None to ptr[Node]:
            let inf_t as ptr[Type] = node_inferred_type(val_node)
            if inf_t != None to ptr[Type]:
                if (deref inf_t).kind == TypeKind.Class or (deref inf_t).kind == TypeKind.Struct or (deref inf_t).kind == TypeKind.Interface:
                    type_name = (deref inf_t).name
                elif (deref inf_t).kind == TypeKind.RawPointer and (deref inf_t).payload != None to ptr[Type]:
                    let pl as ptr[Type] = (deref inf_t).payload
                    if (deref pl).kind == TypeKind.Class or (deref pl).kind == TypeKind.Struct or (deref pl).kind == TypeKind.Interface:
                        type_name = (deref pl).name
                elif (deref inf_t).kind == TypeKind.I32:
                    type_name = String.make("i32" to cstr)
                elif (deref inf_t).kind == TypeKind.I64:
                    type_name = String.make("i64" to cstr)
                elif (deref inf_t).kind == TypeKind.F32:
                    type_name = String.make("f32" to cstr)
                elif (deref inf_t).kind == TypeKind.F64:
                    type_name = String.make("f64" to cstr)
                elif (deref inf_t).kind == TypeKind.Boolean:
                    type_name = String.make("bool" to cstr)
                elif (deref inf_t).kind == TypeKind.Color:
                    type_name = String.make("color" to cstr)
                elif (deref inf_t).kind == TypeKind.String:
                    type_name = String.make("String" to cstr)

        self.ensure_rtti_for_type(type_name)

        var data_ptr as ptr[u8] = val_reg
        if strcmp(val_type.data to cstr, "ptr" to cstr) != 0:
            let box_ptr as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, box_ptr to cstr)
            append_cstr(ref (deref self).main_out, " = call ptr @mantiq_malloc(i64 32)\n")
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, val_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, val_reg to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, box_ptr to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            data_ptr = box_ptr

        let fat1 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, fat1 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, ptr } undef, ptr ")
        append_cstr(ref (deref self).main_out, data_ptr to cstr)
        append_cstr(ref (deref self).main_out, ", 0\n")

        let fat2 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, fat2 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, ptr } ")
        append_cstr(ref (deref self).main_out, fat1 to cstr)
        append_cstr(ref (deref self).main_out, ", ptr @__rtti_")
        append_str(ref (deref self).main_out, type_name)
        append_cstr(ref (deref self).main_out, ", 1\n")

        return fat2

    public fn ensure_rtti_for_type(self as ptr[LLVMCodegen], type_name as String):
        if type_name.data == None to ptr[u8] or type_name.len == 0 to usize:
            return
        let marker as StringBuilder = StringBuilder.make()
        append_cstr(ref marker, "__rtti_emitted_" to cstr)
        append_str(ref marker, type_name)
        let marker_s as String = marker.to_string()
        marker.deinit()
        if (deref self).defined_types.has(marker_s):
            return
        set_dict_bool(ref (deref self).defined_types, marker_s, True)

        let t_id as i32 = self.compute_type_id(type_name)
        let rstr_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
        let _sr as i32 = sprintf(rstr_buf, "@.str.rtti_%s = private unnamed_addr constant [%zu x i8] c\"%s\\00\"\n" to cstr, type_name.data to cstr, type_name.len + 1 to usize, type_name.data to cstr)
        append_cstr(ref (deref self).type_out, rstr_buf to cstr)
        free(rstr_buf to ptr)

        let rdesc_buf as ptr[u8] = make[u8](256 to usize) to ptr[u8]
        let _rd as i32 = sprintf(rdesc_buf, "@__rtti_%s = constant { i32, ptr, i32, i32, ptr } { i32 %d, ptr @.str.rtti_%s, i32 0, i32 0, ptr null }\n" to cstr, type_name.data to cstr, t_id, type_name.data to cstr)
        append_cstr(ref (deref self).type_out, rdesc_buf to cstr)
        free(rdesc_buf to ptr)

    public fn emit_class_decl(self as ptr[LLVMCodegen], node as ptr[Node]):
        let name as String = node_name(node)
        let target_base as String = node_target(node)
        if target_base.data != None to ptr[u8] and target_base.len > 0 to usize:
            let base_k as StringBuilder = StringBuilder.make()
            append_cstr(ref base_k, "__base_" to cstr)
            append_str(ref base_k, name)
            set_dict_str(ref (deref self).type_aliases, base_k.to_string(), target_base)
            base_k.deinit()

        if not (deref self).defined_types.has(name):
            set_dict_bool(ref (deref self).defined_types, name, True)
            let is_cls_k as StringBuilder = StringBuilder.make()
            append_cstr(ref is_cls_k, "__is_class_" to cstr)
            append_str(ref is_cls_k, name)
            set_dict_i32(ref (deref self).struct_field_indices, is_cls_k.to_string(), 1 to i32)
            is_cls_k.deinit()

            // Emit RTTI descriptor for class
            let class_id as i32 = self.compute_type_id(name)
            var parent_id as i32 = 0 to i32
            if target_base.data != None to ptr[u8] and target_base.len > 0 to usize:
                parent_id = self.compute_type_id(target_base)

            let ifaces as List[String] = node_imported_symbols(node)
            let iface_cnt as i64 = ifaces.length()
            var iface_arr_ref as ptr[u8] = "null" to ptr[u8]

            if iface_cnt > 0 to i64:
                let if_arr_k as StringBuilder = StringBuilder.make()
                append_cstr(ref if_arr_k, "@__ifaces_" to cstr)
                append_str(ref if_arr_k, name)
                let if_arr_s as String = if_arr_k.to_string()
                if_arr_k.deinit()

                let if_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
                let _s1 as i32 = sprintf(if_buf, "%s = constant [%lld x i32] [" to cstr, if_arr_s.data to cstr, iface_cnt)
                append_cstr(ref (deref self).type_out, if_buf to cstr)
                free(if_buf to ptr)

                var if_i as i64 = 0 to i64
                while if_i < iface_cnt:
                    let if_nm as String = ifaces[if_i]
                    let if_id as i32 = self.compute_type_id(if_nm)
                    if if_i > 0 to i64:
                        append_cstr(ref (deref self).type_out, ", " to cstr)
                    let id_buf as ptr[u8] = make[u8](32 to usize) to ptr[u8]
                    let _s2 as i32 = sprintf(id_buf, "i32 %d" to cstr, if_id)
                    append_cstr(ref (deref self).type_out, id_buf to cstr)
                    free(id_buf to ptr)
                    if_i = if_i + 1 to i64
                append_cstr(ref (deref self).type_out, "]\n")
                iface_arr_ref = if_arr_s.data to ptr[u8]

            let rstr_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
            let _sr as i32 = sprintf(rstr_buf, "@.str.rtti_%s = private unnamed_addr constant [%zu x i8] c\"%s\\00\"\n" to cstr, name.data to cstr, name.len + 1 to usize, name.data to cstr)
            append_cstr(ref (deref self).type_out, rstr_buf to cstr)
            free(rstr_buf to ptr)

            let rdesc_buf as ptr[u8] = make[u8](256 to usize) to ptr[u8]
            let _rd as i32 = sprintf(rdesc_buf, "@__rtti_%s = constant { i32, ptr, i32, i32, ptr } { i32 %d, ptr @.str.rtti_%s, i32 %d, i32 %lld, ptr %s }\n" to cstr, name.data to cstr, class_id, name.data to cstr, parent_id, iface_cnt, iface_arr_ref to cstr)
            append_cstr(ref (deref self).type_out, rdesc_buf to cstr)
            free(rdesc_buf to ptr)

            let marker as StringBuilder = StringBuilder.make()
            append_cstr(ref marker, "__rtti_emitted_" to cstr)
            append_str(ref marker, name)
            set_dict_bool(ref (deref self).defined_types, marker.to_string(), True)
            marker.deinit()

            self.emit_class_fields(node, name)

        self.emit_class_methods(node, name)

    public fn emit_class_fields(self as ptr[LLVMCodegen], node as ptr[Node], name as String):
        let fields_str as StringBuilder = StringBuilder.make()
        append_cstr(ref fields_str, "ptr" to cstr)
        var field_idx as i64 = 1 to i64

        let all_fields_str as StringBuilder = StringBuilder.make()

        let target_base as String = node_target(node)
        if target_base.data != None to ptr[u8] and target_base.len > 0 to usize:
            let base_fk as StringBuilder = StringBuilder.make()
            append_cstr(ref base_fk, "__all_fields_" to cstr)
            append_str(ref base_fk, target_base)
            let base_fk_s as String = base_fk.to_string()
            if (deref self).type_aliases.has(base_fk_s):
                let base_f_str as String = (deref self).type_aliases[base_fk_s]
                if base_f_str.len > 0 to usize:
                    append_cstr(ref fields_str, ", " to cstr)
                    append_str(ref fields_str, base_f_str)
                    append_str(ref all_fields_str, base_f_str)
                    var b_ci as usize = 0 to usize
                    while b_ci < base_f_str.len:
                        if (deref ((base_f_str.data to usize + b_ci) to ptr[u8])) == 44 to u8:
                            field_idx = field_idx + 1 to i64
                        b_ci = b_ci + 1 to usize
                    field_idx = field_idx + 1 to i64
            base_fk.deinit()

        let body as ptr[Node] = node_body(node)
        if body != None to ptr[Node]:
            let decls_raw as List[ptr[Node]] = node_declarations(body)
            let decls as ptr[List[ptr[Node]]] = ref decls_raw
            let count as i64 = (deref decls).length()
            var i as i64 = 0 to i64
            while i < count:
                let decl as ptr[Node] = get_node_decl(decls, i)
                if node_kind(decl) == NodeType.VarDecl or node_kind(decl) == NodeType.FieldDecl:
                    let f_nm as String = node_name(decl)
                    if f_nm.data != None to ptr[u8]:
                        let f_key as StringBuilder = StringBuilder.make()
                        append_str(ref f_key, name)
                        append_cstr(ref f_key, "." to cstr)
                        append_str(ref f_key, f_nm)
                        let f_ks as String = f_key.to_string()
                        set_dict_i32(ref (deref self).struct_field_indices, f_ks, field_idx to i32)
                        f_key.deinit()
                    let f_t as String = self.get_field_llvm_type(decl)
                    if all_fields_str.len > 0 to usize:
                        append_cstr(ref all_fields_str, ", " to cstr)
                    append_str(ref all_fields_str, f_t)
                    self.emit_one_struct_field(decl, ref fields_str, ref field_idx)
                i = i + 1 to i64

        let save_fk as StringBuilder = StringBuilder.make()
        append_cstr(ref save_fk, "__all_fields_" to cstr)
        append_str(ref save_fk, name)
        set_dict_str(ref (deref self).type_aliases, save_fk.to_string(), all_fields_str.to_string())
        save_fk.deinit()
        all_fields_str.deinit()

        let body_str as StringBuilder = StringBuilder.make()
        append_cstr(ref body_str, "{ " to cstr)
        append_str(ref body_str, fields_str.to_string())
        append_cstr(ref body_str, " }" to cstr)
        let body_s as String = body_str.to_string()

        append_cstr(ref (deref self).type_out, "%" to cstr)
        append_str(ref (deref self).type_out, name)
        append_cstr(ref (deref self).type_out, " = type " to cstr)
        append_str(ref (deref self).type_out, body_s)
        append_cstr(ref (deref self).type_out, "\n\n" to cstr)

        if not (deref self).struct_sizes.has(name):
            let sz as i64 = self.llvm_type_byte_size(body_s)
            set_dict_i64(ref (deref self).struct_sizes, name, sz)
        fields_str.deinit()
        body_str.deinit()

    public fn emit_class_methods(self as ptr[LLVMCodegen], node as ptr[Node], name as String):
        let body as ptr[Node] = node_body(node)
        if body == None to ptr[Node]:
            return

        let decls_raw as List[ptr[Node]] = node_declarations(body)
        let decls as ptr[List[ptr[Node]]] = ref decls_raw
        let count as i64 = (deref decls).length()

        var method_count as i64 = 0 to i64
        let vtable_entries as StringBuilder = StringBuilder.make()
        var i as i64 = 0 to i64
        while i < count:
            let decl as ptr[Node] = get_node_decl(decls, i)
            if node_kind(decl) == NodeType.FunDecl:
                let m_nm as String = node_name(decl)
                if method_count > 0 to i64:
                    append_cstr(ref vtable_entries, ", " to cstr)
                append_cstr(ref vtable_entries, "ptr @" to cstr)
                append_str(ref vtable_entries, name)
                append_cstr(ref vtable_entries, "_" to cstr)
                append_str(ref vtable_entries, m_nm)

                let m_key as StringBuilder = StringBuilder.make()
                append_str(ref m_key, name)
                append_cstr(ref m_key, "." to cstr)
                append_str(ref m_key, m_nm)
                set_dict_i32(ref (deref self).struct_field_indices, m_key.to_string(), method_count to i32)
                m_key.deinit()

                method_count = method_count + 1 to i64
            i = i + 1 to i64

        if method_count > 0 to i64:
            let vt_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
            let _ as i32 = sprintf(vt_buf, "@__vtable_%s = global [%lld x ptr] [" to cstr, name.data to cstr, method_count)
            append_cstr(ref (deref self).type_out, vt_buf to cstr)
            free(vt_buf to ptr)
            append_str(ref (deref self).type_out, vtable_entries.to_string())
            append_cstr(ref (deref self).type_out, "]\n\n" to cstr)
        vtable_entries.deinit()

        i = 0 to i64
        while i < count:
            let decl as ptr[Node] = get_node_decl(decls, i)
            if node_kind(decl) == NodeType.FunDecl:
                let old_name as String = node_name(decl)
                let mangled as StringBuilder = StringBuilder.make()
                append_str(ref mangled, name)
                append_cstr(ref mangled, "_" to cstr)
                append_str(ref mangled, old_name)
                let m_str as String = mangled.to_string()
                set_node_name(decl, m_str)
                let saved_st as String = (deref self).current_struct_name
                (deref self).current_struct_name = name
                self.emit_fun_decl(decl)
                (deref self).current_struct_name = saved_st
                set_node_name(decl, old_name)
                mangled.deinit()
            i = i + 1 to i64

        let del_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
        let _ as i32 = sprintf(del_buf, "define void @%s___del__(ptr %%self) {\nentry:\n  ret void\n}\n\n" to cstr, name.data to cstr)
        append_cstr(ref (deref self).main_out, del_buf to cstr)
        free(del_buf to ptr)

    public fn emit_interface_decl(self as ptr[LLVMCodegen], node as ptr[Node]):
        let name as String = node_name(node)
        if (deref self).defined_types.has(name):
            return
        set_dict_bool(ref (deref self).defined_types, name, True)

        append_cstr(ref (deref self).type_out, "%" to cstr)
        append_str(ref (deref self).type_out, name)
        append_cstr(ref (deref self).type_out, " = type { ptr, ptr }\n\n" to cstr)

        let body as ptr[Node] = node_body(node)
        if body != None to ptr[Node]:
            let decls_raw as List[ptr[Node]] = node_declarations(body)
            let decls as ptr[List[ptr[Node]]] = ref decls_raw
            let count as i64 = (deref decls).length()
            var m_idx as i64 = 0 to i64
            var i as i64 = 0 to i64
            while i < count:
                let decl as ptr[Node] = get_node_decl(decls, i)
                if node_kind(decl) == NodeType.FunDecl:
                    let m_nm as String = node_name(decl)
                    let m_key as StringBuilder = StringBuilder.make()
                    append_str(ref m_key, name)
                    append_cstr(ref m_key, "." to cstr)
                    append_str(ref m_key, m_nm)
                    set_dict_i32(ref (deref self).struct_field_indices, m_key.to_string(), m_idx to i32)
                    m_key.deinit()
                    m_idx = m_idx + 1 to i64
                i = i + 1 to i64

    public fn resolve_type_from_annotation(self as ptr[LLVMCodegen], annot as ptr[TypeAnnotation]) as ptr[Type]:
        extern fn strcmp(s1 as cstr, s2 as cstr) as i32
        extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
        extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
        extern fn free(p as ptr)
        let name as cstr = (deref annot).name.data to cstr
        if (deref self).type_aliases.has(String.make(name)):
            let target_nm as String = (deref self).type_aliases[String.make(name)]
            if target_nm.data != None to ptr[u8] and target_nm.len > 0 to usize:
                let alias_annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
                (deref alias_annot).name = target_nm
                (deref alias_annot).lifetime = Empty
                (deref alias_annot).generics = Empty
                (deref alias_annot).params = Empty
                (deref alias_annot).return_type = None to ptr[TypeAnnotation]
                (deref alias_annot).is_ref = (deref annot).is_ref
                (deref alias_annot).is_mut = (deref annot).is_mut
                let res as ptr[Type] = (deref self).resolve_type_from_annotation(alias_annot)
                free(alias_annot to ptr)
                return res
        if strcmp(name, "i8" to cstr) == 0 or strcmp(name, "u8" to cstr) == 0 or strcmp(name, "byte" to cstr) == 0:
            return make_type(TypeKind.I8)
        elif strcmp(name, "i16" to cstr) == 0 or strcmp(name, "u16" to cstr) == 0:
            return make_type(TypeKind.I16)
        elif strcmp(name, "i32" to cstr) == 0 or strcmp(name, "u32" to cstr) == 0:
            return make_type(TypeKind.I32)
        elif strcmp(name, "i64" to cstr) == 0 or strcmp(name, "u64" to cstr) == 0 or strcmp(name, "usize" to cstr) == 0 or strcmp(name, "isize" to cstr) == 0:
            return make_type(TypeKind.I64)
        elif strcmp(name, "f32" to cstr) == 0:
            return make_type(TypeKind.F32)
        elif strcmp(name, "f64" to cstr) == 0:
            return make_type(TypeKind.F64)
        elif strcmp(name, "NodeType" to cstr) == 0 or strcmp(name, "TypeKind" to cstr) == 0 or strcmp(name, "LanguageMode" to cstr) == 0 or strcmp(name, "SymbolKind" to cstr) == 0 or strcmp(name, "LabelKind" to cstr) == 0 or strcmp(name, "Severity" to cstr) == 0 or strcmp(name, "ObjectState" to cstr) == 0 or strcmp(name, "Endianness" to cstr) == 0 or strcmp(name, "PassMode" to cstr) == 0 or strcmp(name, "ImportKind" to cstr) == 0:
            return make_type(TypeKind.I32)
        elif strcmp(name, "bool" to cstr) == 0:
            return make_type(TypeKind.Boolean)
        elif strcmp(name, "String" to cstr) == 0:
            return make_type(TypeKind.String)
        elif strcmp(name, "char" to cstr) == 0:
            return make_type(TypeKind.Char)
        elif strcmp(name, "ptr" to cstr) == 0 or strncmp(name, "ptr[" to cstr, 4 to usize) == 0:
            return make_ptr_type(make_type(TypeKind.Void))
        elif strcmp(name, "List" to cstr) == 0:
            return make_type(TypeKind.List)
        elif strcmp(name, "Dict" to cstr) == 0:
            return make_type(TypeKind.Dict)
        elif strncmp(name, "Option[" to cstr, 7 to usize) == 0:
            return make_type(TypeKind.Option)
        elif strncmp(name, "List[" to cstr, 5 to usize) == 0:
            return make_type(TypeKind.List)
        elif strncmp(name, "Dict[" to cstr, 5 to usize) == 0:
            return make_type(TypeKind.Dict)
        elif strncmp(name, "make[" to cstr, 5 to usize) == 0:
            extern fn strrchr(s as cstr, c as i32) as cstr
            let close_b as cstr = strrchr(name, ']' to i32)
            if close_b != None to cstr and (close_b to usize) > (name to usize) + 5 to usize:
                let inner_len as usize = (close_b to usize) - (name to usize) - 5 to usize
                let ibuf as ptr[u8] = make[u8](inner_len + 1 to usize) to ptr[u8]
                let _mi as ptr = memcpy(ibuf to ptr, (name to usize + 5 to usize) to ptr, inner_len)
                ibuf[inner_len] = 0 to u8
                let inner_annot as ptr[TypeAnnotation] = make[TypeAnnotation](1 to usize) to ptr[TypeAnnotation]
                (deref inner_annot).name = String.make(ibuf to cstr)
                (deref inner_annot).lifetime = Empty
                (deref inner_annot).generics = Empty
                (deref inner_annot).params = Empty
                (deref inner_annot).return_type = None to ptr[TypeAnnotation]
                (deref inner_annot).is_ref = False
                (deref inner_annot).is_mut = False
                let inner_t as ptr[Type] = (deref self).resolve_type_from_annotation(inner_annot)
                free(ibuf to ptr)
                free(inner_annot to ptr)
                return inner_t
            return make_struct_type(String.make(name))
        return make_struct_type(String.make(name))

    public fn emit_single_constructor(self as ptr[LLVMCodegen], enum_name as String, fn_name as String, tag as i32, params_ptr as ptr[List[ptr[Node]]]):
        if (deref self).defined_functions.has(fn_name):
            return
        set_dict_bool(ref (deref self).defined_functions, fn_name, True)
        set_dict_bool(ref (deref self).program_functions, fn_name, True)

        let params as List[ptr[Node]] = deref params_ptr
        let p_count as i64 = params.length()

        append_cstr(ref (deref self).main_out, "\ndefine %")
        append_str(ref (deref self).main_out, enum_name)
        append_cstr(ref (deref self).main_out, " @")
        append_str(ref (deref self).main_out, fn_name)
        append_cstr(ref (deref self).main_out, "(")

        var pi as i64 = 0 to i64
        while pi < p_count:
            if pi > 0 to i64:
                append_cstr(ref (deref self).main_out, ", ")
            let p as ptr[Node] = params[pi]
            let pt_obj as ptr[Type] = self.resolve_make_elem_type(p)
            var pt as String = type_to_llvm(pt_obj)
            if pt.len == 0 to usize or strcmp(pt.data to cstr, "void" to cstr) == 0:
                pt = String.make("float" to cstr)
            append_str(ref (deref self).main_out, pt)
            append_cstr(ref (deref self).main_out, " %p")
            let p_buf as ptr[u8] = make[u8](16 to usize) to ptr[u8]
            let _s as i32 = sprintf(p_buf, "%lld" to cstr, pi)
            append_cstr(ref (deref self).main_out, p_buf to cstr)
            free(p_buf to ptr)
            pi = pi + 1 to i64

        append_cstr(ref (deref self).main_out, ") {\nentry:\n")
        append_cstr(ref (deref self).main_out, "  %res = alloca %")
        append_str(ref (deref self).main_out, enum_name)
        append_cstr(ref (deref self).main_out, "\n")

        append_cstr(ref (deref self).main_out, "  %tag_ptr = getelementptr inbounds { i32, [32 x i8] }, ptr %res, i32 0, i32 0\n")
        append_cstr(ref (deref self).main_out, "  store i32 ")
        let t_buf as ptr[u8] = make[u8](16 to usize) to ptr[u8]
        let _st as i32 = sprintf(t_buf, "%d" to cstr, tag)
        append_cstr(ref (deref self).main_out, t_buf to cstr)
        free(t_buf to ptr)
        append_cstr(ref (deref self).main_out, ", ptr %tag_ptr\n")

        if p_count > 0 to i64:
            append_cstr(ref (deref self).main_out, "  %pay_buf = getelementptr inbounds { i32, [32 x i8] }, ptr %res, i32 0, i32 1\n")
            var byte_offset as i64 = 0 to i64
            pi = 0 to i64
            while pi < p_count:
                let p as ptr[Node] = params[pi]
                let pt_obj as ptr[Type] = self.resolve_make_elem_type(p)
                var pt as String = type_to_llvm(pt_obj)
                if pt.len == 0 to usize or strcmp(pt.data to cstr, "void" to cstr) == 0:
                    pt = String.make("float" to cstr)
                let slot as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, slot to cstr)
                append_cstr(ref (deref self).main_out, " = getelementptr inbounds i8, ptr %pay_buf, i64 ")
                let off_buf as ptr[u8] = make[u8](16 to usize) to ptr[u8]
                let _so as i32 = sprintf(off_buf, "%lld" to cstr, byte_offset)
                append_cstr(ref (deref self).main_out, off_buf to cstr)
                free(off_buf to ptr)
                append_cstr(ref (deref self).main_out, "\n")

                append_cstr(ref (deref self).main_out, "  store ")
                append_str(ref (deref self).main_out, pt)
                append_cstr(ref (deref self).main_out, " %p")
                let p_buf2 as ptr[u8] = make[u8](16 to usize) to ptr[u8]
                let _s2 as i32 = sprintf(p_buf2, "%lld" to cstr, pi)
                append_cstr(ref (deref self).main_out, p_buf2 to cstr)
                free(p_buf2 to ptr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, slot to cstr)
                append_cstr(ref (deref self).main_out, "\n")

                if strcmp(pt.data to cstr, "double" to cstr) == 0 or strcmp(pt.data to cstr, "i64" to cstr) == 0:
                    byte_offset = byte_offset + 8 to i64
                elif strcmp(pt.data to cstr, "float" to cstr) == 0 or strcmp(pt.data to cstr, "i32" to cstr) == 0:
                    byte_offset = byte_offset + 4 to i64
                else:
                    byte_offset = byte_offset + 8 to i64

                pi = pi + 1 to i64

        append_cstr(ref (deref self).main_out, "  %ret_val = load %")
        append_str(ref (deref self).main_out, enum_name)
        append_cstr(ref (deref self).main_out, ", ptr %res\n")
        append_cstr(ref (deref self).main_out, "  ret %")
        append_str(ref (deref self).main_out, enum_name)
        append_cstr(ref (deref self).main_out, " %ret_val\n}\n")

    public fn emit_enum_variant_constructor(self as ptr[LLVMCodegen], enum_name as String, var_name as String, tag as i32, params_ptr as ptr[List[ptr[Node]]]):
        let full_name_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
        let _ as i32 = sprintf(full_name_buf, "%s_%s" to cstr, enum_name.data to cstr, var_name.data to cstr)
        let full_name as String = String.make(full_name_buf to cstr)
        self.emit_single_constructor(enum_name, full_name, tag, params_ptr)
        self.emit_single_constructor(enum_name, var_name, tag, params_ptr)
        free(full_name_buf to ptr)

    public fn emit_enum_decl(self as ptr[LLVMCodegen], node as ptr[Node]):
        let name as String = node_name(node)
        if (deref self).defined_types.has(name):
            return
        set_dict_bool(ref (deref self).defined_types, name, True)

        let decls as List[ptr[Node]] = node_declarations(node)
        let count as i64 = decls.length()

        var has_payloads as bool = False
        var i as i64 = 0 to i64
        while i < count:
            let d as ptr[Node] = decls[i]
            if node_kind(d) == NodeType.FunDecl:
                if node_body(d) == None to ptr[Node] and node_params(d).length() > 0 to i64:
                    has_payloads = True
            i = i + 1 to i64

        append_cstr(ref (deref self).type_out, "%" to cstr)
        append_str(ref (deref self).type_out, name)
        if has_payloads:
            append_cstr(ref (deref self).type_out, " = type { i32, [32 x i8] }\n\n" to cstr)
        else:
            append_cstr(ref (deref self).type_out, " = type i32\n\n" to cstr)

        var variant_tag as i32 = 0 to i32
        i = 0 to i64
        while i < count:
            let d as ptr[Node] = decls[i]
            let d_kind as NodeType = node_kind(d)
            let v_name as String = node_name(d)
            if d_kind == NodeType.FunDecl:
                if node_body(d) != None to ptr[Node]:
                    // Member method (e.g. fn area(ref self) as f32:)
                    let old_fn_name as String = node_name(d)
                    let mangled_name_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
                    let _ as i32 = sprintf(mangled_name_buf, "%s_%s" to cstr, name.data to cstr, old_fn_name.data to cstr)
                    let mangled_name as String = String.make(mangled_name_buf to cstr)
                    set_node_name(d, mangled_name)
                    self.emit_fun_decl(d)
                    set_node_name(d, old_fn_name)
                    free(mangled_name_buf to ptr)
                else:
                    let v_params as List[ptr[Node]] = node_params(d)
                    let full_v_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
                    let _ as i32 = sprintf(full_v_buf, "%s.%s" to cstr, name.data to cstr, v_name.data to cstr)
                    let full_v_name as String = String.make(full_v_buf to cstr)
                    set_dict_i32(ref (deref self).enum_variant_tags, full_v_name, variant_tag)
                    set_dict_i32(ref (deref self).enum_variant_tags, v_name, variant_tag)
                    free(full_v_buf to ptr)

                    self.emit_enum_variant_constructor(name, v_name, variant_tag, ref v_params)
                    variant_tag = variant_tag + 1 to i32
            else:
                let full_v_buf2 as ptr[u8] = make[u8](128 to usize) to ptr[u8]
                let _ as i32 = sprintf(full_v_buf2, "%s.%s" to cstr, name.data to cstr, v_name.data to cstr)
                let full_v_name2 as String = String.make(full_v_buf2 to cstr)
                set_dict_i32(ref (deref self).enum_variant_tags, full_v_name2, variant_tag)
                set_dict_i32(ref (deref self).enum_variant_tags, v_name, variant_tag)
                free(full_v_buf2 to ptr)

                if has_payloads:
                    var empty_p as List[ptr[Node]] = List[ptr[Node]]()
                    self.emit_enum_variant_constructor(name, v_name, variant_tag, ref empty_p)

                variant_tag = variant_tag + 1 to i32
            i = i + 1 to i64

    public fn emit_union_decl(self as ptr[LLVMCodegen], node as ptr[Node]):
        let name as String = node_name(node)
        if (deref self).defined_types.has(name):
            return
        set_dict_bool(ref (deref self).defined_types, name, True)

        append_cstr(ref (deref self).type_out, "%" to cstr)
        append_str(ref (deref self).type_out, name)
        append_cstr(ref (deref self).type_out, " = type { i32, [32 x i8] }\n\n" to cstr)

        if node_body(node) != None to ptr[Node]:
            let body as ptr[Node] = node_body(node)
            let decls_raw4 as List[ptr[Node]] = node_declarations(body)
            let decls as ptr[List[ptr[Node]]] = ref decls_raw4
            let count as i64 = (deref decls).length()
            var i as i64 = 0 to i64
            while i < count:
                let decl as ptr[Node] = get_node_decl(decls, i)
                if node_kind(decl) == NodeType.FunDecl:
                    self.emit_fun_decl(decl)
                i = i + 1 to i64
