from types import Type, TypeKind, make_type, make_ptr_type, make_struct_type

// ── C FFI ───────────────────────────────────────────────────────────────
extern fn printf(format as cstr, ...) as i32
extern fn memset(s as ptr, c as i32, n as usize) as ptr
extern fn sprintf(buf as ptr[u8], format as cstr, ...) as i32
extern fn strcmp(s1 as cstr, s2 as cstr) as i32

// ── Free Helpers ────────────────────────────────────────────────────────
fn append_i32(sb as ptr[StringBuilder], val as i32):
    let buf as ptr[u8] = make(32 to usize) to ptr[u8]
    let _ as i32 = sprintf(buf, "%d" to cstr, val)
    (deref sb).append(buf to cstr)

fn append_i64(sb as ptr[StringBuilder], val as i64):
    let buf as ptr[u8] = make(32 to usize) to ptr[u8]
    let _ as i32 = sprintf(buf, "%ld" to cstr, val)
    (deref sb).append(buf to cstr)

fn append_f64(sb as ptr[StringBuilder], val as f64):
    let buf as ptr[u8] = make(64 to usize) to ptr[u8]
    let _ as i32 = sprintf(buf, "%g" to cstr, val)
    (deref sb).append(buf to cstr)

fn append_str(sb as ptr[StringBuilder], s as String):
    (deref sb).append(s.data to cstr)

fn append_cstr(sb as ptr[StringBuilder], s as cstr):
    (deref sb).append(s)

fn str_eq(a as String, b as String) as bool:
    if a.len != b.len:
        return False
    var i as usize = 0 to usize
    while i < a.len:
        let addr_a as ptr[u8] = ((a.data to usize) + i) to ptr[u8]
        let ca as u8 = deref addr_a
        let addr_b as ptr[u8] = ((b.data to usize) + i) to ptr[u8]
        let cb as u8 = deref addr_b
        if ca != cb:
            return False
        i = i + 1 to usize
    return True

fn strlen_buf(s as ptr[u8]) as usize:
    var len as usize = 0 to usize
    let start_addr as usize = s to usize
    var continue_loop as bool = True
    while continue_loop == True:
        let cur_addr as ptr[u8] = (start_addr + len) to ptr[u8]
        let byte_val as u8 = deref cur_addr
        if byte_val == 0 to u8:
            continue_loop = False
        else:
            len = len + 1 to usize
    return len

fn is_hex_digit(b as u8) as bool:
    if b >= 48 to u8 and b <= 57 to u8:
        return True
    if b >= 65 to u8 and b <= 70 to u8:
        return True
    if b >= 97 to u8 and b <= 102 to u8:
        return True
    return False

fn llvm_string_len(buf as ptr[u8], len as i64) as i64:
    var count as i64 = 0 to i64
    var i as i64 = 0 to i64
    while i < len:
        let b as u8 = buf[i]
        if b == 92 to u8 and i < len - 2 to i64:
            let b1 as u8 = buf[i + 1]
            let b2 as u8 = buf[i + 2]
            if is_hex_digit(b1) and is_hex_digit(b2):
                i = i + 2 to i64
        count = count + 1 to i64
        i = i + 1 to i64
    return count

struct OptionLayout:
    public var has_val as u8
    public var val_ptr as ptr[u8]

fn option_has_value(opt as ptr[OptionLayout]) as bool:
    return (deref opt).has_val == 1 to u8

fn option_value_ptr(opt as ptr[OptionLayout]) as ptr[u8]:
    return (deref opt).val_ptr

fn option_unwrap_ptr(opt as ptr[OptionLayout]) as ptr[Node]:
    let vp as ptr[u8] = (deref opt).val_ptr
    return vp to ptr[Node]

fn get_node_decl(decls as ptr[List[ptr[Node]]], index as i64) as ptr[Node]:
    let items_addr as usize = deref (decls to ptr[usize])
    let idx_us as usize = index to usize
    let offset as usize = idx_us * 8 to usize
    let elem_addr as ptr[ptr[Node]] = (items_addr + offset) to ptr[ptr[Node]]
    return deref elem_addr

fn get_string_at(drops as ptr[List[String]], index as i64) as String:
    let items_addr as usize = deref (drops to ptr[usize])
    let idx_us as usize = index to usize
    let offset as usize = idx_us * 24 to usize
    let elem_addr as ptr[String] = (items_addr + offset) to ptr[String]
    return deref elem_addr

fn set_buf_byte(buf as ptr[u8], idx as i64, val as u8):
    let buf_addr as usize = buf to usize
    let idx_us as usize = idx to usize
    let addr as ptr[u8] = (buf_addr + idx_us) to ptr[u8]
    deref addr = val

fn set_dict_bool(dict_ptr as ptr[Dict[String, bool]], key as String, val as bool):
    (deref dict_ptr)[key] = val

fn set_dict_str(dict_ptr as ptr[Dict[String, String]], key as String, val as String):
    (deref dict_ptr)[key] = val

fn set_dict_i32(dict_ptr as ptr[Dict[String, i32]], key as String, val as i32):
    (deref dict_ptr)[key] = val

fn set_dict_drops(dict_ptr as ptr[Dict[usize, List[String]]], addr as usize, drops as List[String]):
    (deref dict_ptr)[addr] = drops

fn get_struct_field_type(s_cstr as cstr, f_cstr as cstr) as String:
    if strcmp(f_cstr, "name" to cstr) == 0 or strcmp(f_cstr, "op" to cstr) == 0 or strcmp(f_cstr, "target" to cstr) == 0 or strcmp(f_cstr, "str_val" to cstr) == 0 or strcmp(f_cstr, "source_code" to cstr) == 0 or strcmp(f_cstr, "file_path" to cstr) == 0 or strcmp(f_cstr, "current_file" to cstr) == 0 or strcmp(f_cstr, "message" to cstr) == 0 or strcmp(f_cstr, "explanation" to cstr) == 0 or strcmp(f_cstr, "replacement" to cstr) == 0 or strcmp(f_cstr, "hint" to cstr) == 0 or strcmp(f_cstr, "note" to cstr) == 0:
        return String.make("{ ptr, i64, i64 }" to cstr)
    elif strcmp(f_cstr, "kind" to cstr) == 0 or strcmp(f_cstr, "mode" to cstr) == 0 or strcmp(f_cstr, "severity" to cstr) == 0 or strcmp(f_cstr, "error_count" to cstr) == 0 or strcmp(f_cstr, "warning_count" to cstr) == 0 or strcmp(f_cstr, "panic_count" to cstr) == 0:
        return String.make("i32" to cstr)
    elif strcmp(f_cstr, "span" to cstr) == 0 or strcmp(f_cstr, "primary_span" to cstr) == 0:
        return String.make("%Span" to cstr)
    elif strcmp(f_cstr, "module_name" to cstr) == 0:
        return String.make("{ i8, ptr, i64, i64 }" to cstr)
    elif strcmp(f_cstr, "val" to cstr) == 0:
        return String.make("double" to cstr)
    elif strcmp(f_cstr, "is_async" to cstr) == 0 or strcmp(f_cstr, "is_extern" to cstr) == 0 or strcmp(f_cstr, "is_variadic" to cstr) == 0 or strcmp(f_cstr, "is_mut" to cstr) == 0 or strcmp(f_cstr, "is_context_manager" to cstr) == 0 or strcmp(f_cstr, "use_color" to cstr) == 0:
        return String.make("i8" to cstr)
    elif strcmp(f_cstr, "next_hygiene_id" to cstr) == 0:
        return String.make("i64" to cstr)
    elif strcmp(f_cstr, "left" to cstr) == 0 or strcmp(f_cstr, "right" to cstr) == 0 or strcmp(f_cstr, "body" to cstr) == 0 or strcmp(f_cstr, "cond" to cstr) == 0 or strcmp(f_cstr, "then_branch" to cstr) == 0 or strcmp(f_cstr, "else_branch" to cstr) == 0 or strcmp(f_cstr, "inferred_type" to cstr) == 0 or strcmp(f_cstr, "data" to cstr) == 0 or strcmp(f_cstr, "return_type_annot" to cstr) == 0 or strcmp(f_cstr, "type_annots" to cstr) == 0 or strcmp(f_cstr, "payload" to cstr) == 0 or strcmp(f_cstr, "return_type" to cstr) == 0 or strcmp(f_cstr, "sema" to cstr) == 0 or strcmp(f_cstr, "current_scope" to cstr) == 0 or strcmp(f_cstr, "global_scope" to cstr) == 0 or strcmp(f_cstr, "current_function_return" to cstr) == 0 or strcmp(f_cstr, "inferred_return_type" to cstr) == 0 or strcmp(f_cstr, "decl_node" to cstr) == 0:
        return String.make("ptr" to cstr)
    return String.make("{ ptr, ptr }" to cstr)

