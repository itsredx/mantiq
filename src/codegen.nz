            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = load i1, ptr ")
            append_cstr(ref (deref self).main_out, or_tmp to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return reg

        if strcmp(op.data to cstr, "=" to cstr) == 0:
            return self.emit_expr(right)

        if strcmp(op.data to cstr, "is" to cstr) == 0:
            var is_match as bool = True
            let left_t as ptr[Type] = node_inferred_type(left)
            let right_name as String = node_name(right)
            if right_name.len > 0 to usize and strcmp(right_name.data to cstr, "Any" to cstr) == 0:
                is_match = True
            elif left_t != None to ptr[Type] and right_name.len > 0 to usize:
                if (deref left_t).kind == TypeKind.Struct:
                    if strcmp((deref left_t).name.data to cstr, right_name.data to cstr) == 0:
                        is_match = True
                    else:
                        is_match = False
            if is_match:
                return "1" to ptr[u8]
            else:
                return "0" to ptr[u8]

        let left_reg as ptr[u8] = self.emit_expr(left)
        let right_reg as ptr[u8] = self.emit_expr(right)
        var left_t_str as String = type_to_llvm(node_inferred_type(left))
        if node_kind(left) == NodeType.CallExpr:
            let c_node as ptr[Node] = node_left(left)
            if c_node != None to ptr[Node]:
                let c_name_ptr as ptr[String] = node_name_ptr(c_node)
                if c_name_ptr != None to ptr[String] and (deref c_name_ptr).data != None:
                    let cn as cstr = (deref c_name_ptr).data to cstr
                    if strcmp(cn, "strcmp" to cstr) == 0 or strcmp(cn, "strncmp" to cstr) == 0 or strcmp(cn, "fseek" to cstr) == 0 or strcmp(cn, "fclose" to cstr) == 0 or strcmp(cn, "sprintf" to cstr) == 0 or strcmp(cn, "snprintf" to cstr) == 0 or strcmp(cn, "printf" to cstr) == 0 or strcmp(cn, "node_kind" to cstr) == 0:
                        left_t_str = String.make("i32" to cstr)
                    elif strcmp(cn, "ftell" to cstr) == 0 or strcmp(cn, "strlen" to cstr) == 0 or strcmp(cn, "length" to cstr) == 0 or strcmp(cn, "len" to cstr) == 0:
                        left_t_str = String.make("i64" to cstr)
        elif node_kind(left) == NodeType.MemberExpr:
            let field_name as String = node_name(left)
            let obj as ptr[Node] = node_left(left)
            var is_enum_variant as bool = False
            if obj != None to ptr[Node] and node_kind(obj) == NodeType.Identifier:
                let id_n as String = node_name(obj)
                if id_n.data != None:
                    let id_c as cstr = id_n.data to cstr
                    if strcmp(id_c, "NodeType" to cstr) == 0 or strcmp(id_c, "TypeKind" to cstr) == 0 or strcmp(id_c, "LanguageMode" to cstr) == 0 or strcmp(id_c, "PassMode" to cstr) == 0 or strcmp(id_c, "ObjectState" to cstr) == 0 or strcmp(id_c, "Endianness" to cstr) == 0 or strcmp(id_c, "Severity" to cstr) == 0 or strcmp(id_c, "LabelKind" to cstr) == 0 or strcmp(id_c, "ImportKind" to cstr) == 0:
                        is_enum_variant = True
            if is_enum_variant:
                left_t_str = String.make("i32" to cstr)
            elif field_name.data != None and strcmp(left_t_str.data to cstr, "{ ptr, ptr }") == 0:
                var s_name as String = String.make("Node" to cstr)
                if obj != None to ptr[Node]:
                    let target_t as ptr[Type] = node_inferred_type(obj)
                    if target_t != None to ptr[Type]:
                        if (deref target_t).kind == TypeKind.Struct:
                            s_name = (deref target_t).name
                        elif (deref target_t).kind == TypeKind.RawPointer and (deref target_t).payload != None to ptr[Type]:
                            let pl as ptr[Type] = (deref target_t).payload
                            if (deref pl).kind == TypeKind.Struct:
                                s_name = (deref pl).name
                    var obj_inner as ptr[Node] = obj
                    if node_kind(obj_inner) == NodeType.UnaryExpr:
                        let in_node as ptr[Node] = node_left(obj_inner)
                        if in_node != None to ptr[Node]:
                            obj_inner = in_node
                    if node_kind(obj_inner) == NodeType.Identifier:
                        let id_nm as String = node_name(obj_inner)
                        if id_nm.data != None and strcmp(id_nm.data to cstr, "self" to cstr) == 0 and (deref self).current_struct_name.len > 0 to usize:
                            s_name = (deref self).current_struct_name
                let f_t as String = get_struct_field_type(s_name.data to cstr, field_name.data to cstr)
                if strcmp(f_t.data to cstr, "{ ptr, ptr }") != 0:
                    left_t_str = f_t
        elif node_kind(left) == NodeType.Identifier:
            let id_nm_str as String = node_name(left)
            if id_nm_str.data != None and (deref self).var_types.has(id_nm_str):
                left_t_str = (deref self).var_types[id_nm_str]
        elif node_kind(left) == NodeType.CastExpr:
            let op_str as String = node_op(left)
            if op_str.data != None to ptr[u8]:
                let c_n as cstr = op_str.data to cstr
                if strcmp(c_n, "ptr" to cstr) == 0 or (deref (c_n to ptr[u8])) == 112 to u8 or (deref (c_n to ptr[u8])) == 91 to u8:
                    left_t_str = String.make("ptr" to cstr)
                elif strcmp(c_n, "i8" to cstr) == 0 or strcmp(c_n, "u8" to cstr) == 0 or strcmp(c_n, "bool" to cstr) == 0 or strcmp(c_n, "byte" to cstr) == 0:
                    left_t_str = String.make("i8" to cstr)
                elif strcmp(c_n, "i16" to cstr) == 0 or strcmp(c_n, "u16" to cstr) == 0:
                    left_t_str = String.make("i16" to cstr)
                elif strcmp(c_n, "i32" to cstr) == 0 or strcmp(c_n, "u32" to cstr) == 0 or strcmp(c_n, "char" to cstr) == 0:
                    left_t_str = String.make("i32" to cstr)
                elif strcmp(c_n, "i128" to cstr) == 0 or strcmp(c_n, "u128" to cstr) == 0:
                    left_t_str = String.make("i128" to cstr)
                elif strcmp(c_n, "i256" to cstr) == 0 or strcmp(c_n, "u256" to cstr) == 0:
                    left_t_str = String.make("i256" to cstr)
                elif strcmp(c_n, "i512" to cstr) == 0 or strcmp(c_n, "u512" to cstr) == 0:
                    left_t_str = String.make("i512" to cstr)
                elif strcmp(c_n, "i1024" to cstr) == 0 or strcmp(c_n, "u1024" to cstr) == 0:
                    left_t_str = String.make("i1024" to cstr)
                elif strcmp(c_n, "f16" to cstr) == 0 or strcmp(c_n, "half" to cstr) == 0:
                    left_t_str = String.make("half" to cstr)
                elif strcmp(c_n, "bf16" to cstr) == 0 or strcmp(c_n, "bfloat" to cstr) == 0 or strcmp(c_n, "BFloat16" to cstr) == 0:
                    left_t_str = String.make("bfloat" to cstr)
                elif strcmp(c_n, "f32" to cstr) == 0 or strcmp(c_n, "float" to cstr) == 0:
                    left_t_str = String.make("float" to cstr)
                elif strcmp(c_n, "f64" to cstr) == 0 or strcmp(c_n, "double" to cstr) == 0:
                    left_t_str = String.make("double" to cstr)
                elif strcmp(c_n, "f128" to cstr) == 0 or strcmp(c_n, "fp128" to cstr) == 0:
                    left_t_str = String.make("fp128" to cstr)
                else:
                    left_t_str = String.make("i64" to cstr)
        elif node_kind(left) == NodeType.IndexExpr:
            left_t_str = self.index_value_llvm(left)

        var right_t_str as String = type_to_llvm(node_inferred_type(right))
        if node_kind(right) == NodeType.CallExpr:
            let c_node as ptr[Node] = node_left(right)
            if c_node != None to ptr[Node]:
                let c_name_ptr as ptr[String] = node_name_ptr(c_node)
                if c_name_ptr != None to ptr[String] and (deref c_name_ptr).data != None:
                    let cn as cstr = (deref c_name_ptr).data to cstr
                    if strcmp(cn, "strcmp" to cstr) == 0 or strcmp(cn, "strncmp" to cstr) == 0 or strcmp(cn, "fseek" to cstr) == 0 or strcmp(cn, "fclose" to cstr) == 0 or strcmp(cn, "sprintf" to cstr) == 0 or strcmp(cn, "snprintf" to cstr) == 0 or strcmp(cn, "printf" to cstr) == 0 or strcmp(cn, "node_kind" to cstr) == 0:
                        right_t_str = String.make("i32" to cstr)
                    elif strcmp(cn, "ftell" to cstr) == 0 or strcmp(cn, "strlen" to cstr) == 0 or strcmp(cn, "length" to cstr) == 0 or strcmp(cn, "len" to cstr) == 0:
                        right_t_str = String.make("i64" to cstr)
        elif node_kind(right) == NodeType.MemberExpr:
            let field_name as String = node_name(right)
            let obj as ptr[Node] = node_left(right)
            var is_enum_variant as bool = False
            if obj != None to ptr[Node] and node_kind(obj) == NodeType.Identifier:
                let id_n as String = node_name(obj)
                if id_n.data != None:
                    let id_c as cstr = id_n.data to cstr
                    if strcmp(id_c, "NodeType" to cstr) == 0 or strcmp(id_c, "TypeKind" to cstr) == 0 or strcmp(id_c, "LanguageMode" to cstr) == 0 or strcmp(id_c, "PassMode" to cstr) == 0 or strcmp(id_c, "ObjectState" to cstr) == 0 or strcmp(id_c, "Endianness" to cstr) == 0 or strcmp(id_c, "Severity" to cstr) == 0 or strcmp(id_c, "LabelKind" to cstr) == 0 or strcmp(id_c, "ImportKind" to cstr) == 0:
                        is_enum_variant = True
            if is_enum_variant:
                right_t_str = String.make("i32" to cstr)
            elif field_name.data != None and strcmp(right_t_str.data to cstr, "{ ptr, ptr }") == 0:
                var s_name as String = String.make("Node" to cstr)
                if obj != None to ptr[Node]:
                    let target_t as ptr[Type] = node_inferred_type(obj)
                    if target_t != None to ptr[Type]:
                        if (deref target_t).kind == TypeKind.Struct:
                            s_name = (deref target_t).name
                        elif (deref target_t).kind == TypeKind.RawPointer and (deref target_t).payload != None to ptr[Type]:
                            let pl as ptr[Type] = (deref target_t).payload
                            if (deref pl).kind == TypeKind.Struct:
                                s_name = (deref pl).name
                    var obj_inner as ptr[Node] = obj
                    if node_kind(obj_inner) == NodeType.UnaryExpr:
                        let in_node as ptr[Node] = node_left(obj_inner)
                        if in_node != None to ptr[Node]:
                            obj_inner = in_node
                    if node_kind(obj_inner) == NodeType.Identifier:
                        let id_nm as String = node_name(obj_inner)
                        if id_nm.data != None and strcmp(id_nm.data to cstr, "self" to cstr) == 0 and (deref self).current_struct_name.len > 0 to usize:
                            s_name = (deref self).current_struct_name
                let f_t as String = get_struct_field_type(s_name.data to cstr, field_name.data to cstr)
                if strcmp(f_t.data to cstr, "{ ptr, ptr }") != 0:
                    right_t_str = f_t
        elif node_kind(right) == NodeType.Identifier:
            let id_nm_str as String = node_name(right)
            if id_nm_str.data != None and (deref self).var_types.has(id_nm_str):
                right_t_str = (deref self).var_types[id_nm_str]
        elif node_kind(right) == NodeType.CastExpr:
            let op_str as String = node_op(right)
            if op_str.data != None to ptr[u8]:
                let c_n as cstr = op_str.data to cstr
                if strcmp(c_n, "ptr" to cstr) == 0 or (deref (c_n to ptr[u8])) == 112 to u8 or (deref (c_n to ptr[u8])) == 91 to u8:
                    right_t_str = String.make("ptr" to cstr)
                elif strcmp(c_n, "i8" to cstr) == 0 or strcmp(c_n, "u8" to cstr) == 0 or strcmp(c_n, "bool" to cstr) == 0 or strcmp(c_n, "byte" to cstr) == 0:
                    right_t_str = String.make("i8" to cstr)
                elif strcmp(c_n, "i16" to cstr) == 0 or strcmp(c_n, "u16" to cstr) == 0:
                    right_t_str = String.make("i16" to cstr)
                elif strcmp(c_n, "i32" to cstr) == 0 or strcmp(c_n, "u32" to cstr) == 0 or strcmp(c_n, "char" to cstr) == 0:
                    right_t_str = String.make("i32" to cstr)
                elif strcmp(c_n, "i128" to cstr) == 0 or strcmp(c_n, "u128" to cstr) == 0:
                    right_t_str = String.make("i128" to cstr)
                elif strcmp(c_n, "i256" to cstr) == 0 or strcmp(c_n, "u256" to cstr) == 0:
                    right_t_str = String.make("i256" to cstr)
                elif strcmp(c_n, "i512" to cstr) == 0 or strcmp(c_n, "u512" to cstr) == 0:
                    right_t_str = String.make("i512" to cstr)
                elif strcmp(c_n, "i1024" to cstr) == 0 or strcmp(c_n, "u1024" to cstr) == 0:
                    right_t_str = String.make("i1024" to cstr)
                elif strcmp(c_n, "f16" to cstr) == 0 or strcmp(c_n, "half" to cstr) == 0:
                    right_t_str = String.make("half" to cstr)
                elif strcmp(c_n, "bf16" to cstr) == 0 or strcmp(c_n, "bfloat" to cstr) == 0 or strcmp(c_n, "BFloat16" to cstr) == 0:
                    right_t_str = String.make("bfloat" to cstr)
                elif strcmp(c_n, "f32" to cstr) == 0 or strcmp(c_n, "float" to cstr) == 0:
                    right_t_str = String.make("float" to cstr)
                elif strcmp(c_n, "f64" to cstr) == 0 or strcmp(c_n, "double" to cstr) == 0:
                    right_t_str = String.make("double" to cstr)
                elif strcmp(c_n, "f128" to cstr) == 0 or strcmp(c_n, "fp128" to cstr) == 0:
                    right_t_str = String.make("fp128" to cstr)
                else:
                    right_t_str = String.make("i64" to cstr)
        elif node_kind(right) == NodeType.IndexExpr:
            right_t_str = self.index_value_llvm(right)

        var left_is_ptr as bool = strcmp(left_t_str.data to cstr, "ptr" to cstr) == 0
        var right_is_ptr as bool = strcmp(right_t_str.data to cstr, "ptr" to cstr) == 0

        let is_cmp as bool = strcmp(op.data to cstr, "==" to cstr) == 0 or strcmp(op.data to cstr, "!=" to cstr) == 0 or strcmp(op.data to cstr, "<" to cstr) == 0 or strcmp(op.data to cstr, ">" to cstr) == 0 or strcmp(op.data to cstr, "<=" to cstr) == 0 or strcmp(op.data to cstr, ">=" to cstr) == 0
        var actual_left as ptr[Node] = left
        if node_kind(actual_left) == NodeType.CastExpr:
            let inner as ptr[Node] = node_left(actual_left)
            if inner != None to ptr[Node]:
                actual_left = inner

        var actual_right as ptr[Node] = right
        if node_kind(actual_right) == NodeType.CastExpr:
            let inner as ptr[Node] = node_left(actual_right)
            if inner != None to ptr[Node]:
                actual_right = inner

        var left_is_cmp as bool = False
        if node_kind(actual_left) == NodeType.BinaryExpr:
            let left_op as String = node_op(actual_left)
            if left_op.data != None to ptr[u8]:
                let lo as cstr = left_op.data to cstr
                if strcmp(lo, "==" to cstr) == 0 or strcmp(lo, "!=" to cstr) == 0 or strcmp(lo, "<" to cstr) == 0 or strcmp(lo, ">" to cstr) == 0 or strcmp(lo, "<=" to cstr) == 0 or strcmp(lo, ">=" to cstr) == 0:
                    left_is_cmp = True
        var right_is_cmp as bool = False
        if node_kind(actual_right) == NodeType.BinaryExpr:
            let right_op as String = node_op(actual_right)
            if right_op.data != None to ptr[u8]:
                let ro as cstr = right_op.data to cstr
                if strcmp(ro, "==" to cstr) == 0 or strcmp(ro, "!=" to cstr) == 0 or strcmp(ro, "<" to cstr) == 0 or strcmp(ro, ">" to cstr) == 0 or strcmp(ro, "<=" to cstr) == 0 or strcmp(ro, ">=" to cstr) == 0:
                    right_is_cmp = True
        let is_arith as bool = strcmp(op.data to cstr, "+" to cstr) == 0 or strcmp(op.data to cstr, "-" to cstr) == 0 or strcmp(op.data to cstr, "*" to cstr) == 0 or strcmp(op.data to cstr, "/" to cstr) == 0 or strcmp(op.data to cstr, "%" to cstr) == 0 or strcmp(op.data to cstr, "or" to cstr) == 0 or strcmp(op.data to cstr, "and" to cstr) == 0 or strcmp(op.data to cstr, "&" to cstr) == 0 or strcmp(op.data to cstr, "|" to cstr) == 0 or strcmp(op.data to cstr, "^" to cstr) == 0 or strcmp(op.data to cstr, "<<" to cstr) == 0 or strcmp(op.data to cstr, ">>" to cstr) == 0
        var operand_type as String = left_t_str
        if is_arith:
            if left_is_cmp or right_is_cmp or strcmp(left_t_str.data to cstr, "i1" to cstr) == 0 or strcmp(right_t_str.data to cstr, "i1" to cstr) == 0:
                operand_type = String.make("i1" to cstr)
            else:
                let left_bits as i32 = llvm_int_bits(left_t_str)
                let right_bits as i32 = llvm_int_bits(right_t_str)
                let left_f_rank as i32 = llvm_float_rank(left_t_str)
                let right_f_rank as i32 = llvm_float_rank(right_t_str)
                if left_f_rank > 0 to i32 or right_f_rank > 0 to i32:
                    if left_f_rank >= right_f_rank:
                        operand_type = left_t_str
                    else:
                        operand_type = right_t_str
                elif left_bits > 0 to i32 or right_bits > 0 to i32:
                    if left_bits >= right_bits:
                        operand_type = left_t_str
                    else:
                        operand_type = right_t_str
                else:
                    operand_type = left_t_str
        elif left_is_ptr or right_is_ptr:
            operand_type = String.make("ptr" to cstr)
        elif is_cmp:
            let left_bits as i32 = llvm_int_bits(left_t_str)
            let right_bits as i32 = llvm_int_bits(right_t_str)
            let left_f_rank as i32 = llvm_float_rank(left_t_str)
            let right_f_rank as i32 = llvm_float_rank(right_t_str)
            if left_f_rank > 0 to i32 or right_f_rank > 0 to i32:
                if left_f_rank >= right_f_rank:
                    operand_type = left_t_str
                else:
                    operand_type = right_t_str
            elif left_bits > 0 to i32 or right_bits > 0 to i32:
                if left_bits >= right_bits:
                    operand_type = left_t_str
                else:
                    operand_type = right_t_str
            else:
                operand_type = left_t_str

        var result_type as String = type_to_llvm(node_inferred_type(node))
        if is_cmp:
            result_type = String.make("i1" to cstr)
        elif is_arith:
            result_type = operand_type

        var real_left as ptr[u8] = left_reg
        var real_right as ptr[u8] = right_reg
        if strcmp(operand_type.data to cstr, "ptr" to cstr) == 0:
            if not left_is_ptr and (deref left_reg) != 37 to u8:
                let p_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, p_temp to cstr)
                append_cstr(ref (deref self).main_out, " = inttoptr i64 ")
                append_cstr(ref (deref self).main_out, left_reg to cstr)
                append_cstr(ref (deref self).main_out, " to ptr\n")
                real_left = p_temp
            if not right_is_ptr and (deref right_reg) != 37 to u8:
                let p_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, p_temp to cstr)
                append_cstr(ref (deref self).main_out, " = inttoptr i64 ")
                append_cstr(ref (deref self).main_out, right_reg to cstr)
                append_cstr(ref (deref self).main_out, " to ptr\n")
                real_right = p_temp
        elif is_arith or is_cmp:
            if left_is_ptr and (deref left_reg) == 37 to u8:
                let i_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, i_temp to cstr)
                append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
                append_cstr(ref (deref self).main_out, left_reg to cstr)
                append_cstr(ref (deref self).main_out, " to i64\n")
                real_left = i_temp
            if right_is_ptr and (deref right_reg) == 37 to u8:
                let i_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, i_temp to cstr)
                append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
                append_cstr(ref (deref self).main_out, right_reg to cstr)
                append_cstr(ref (deref self).main_out, " to i64\n")
                real_right = i_temp
            if not left_is_ptr and strcmp(left_t_str.data to cstr, operand_type.data to cstr) != 0:
                let left_bits as i32 = llvm_int_bits(left_t_str)
                let op_bits as i32 = llvm_int_bits(operand_type)
                let left_f_rank as i32 = llvm_float_rank(left_t_str)
                let op_f_rank as i32 = llvm_float_rank(operand_type)

                if op_bits > 0 to i32 and left_bits > 0 to i32:
                    let cv_l as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, cv_l to cstr)
                    if left_bits < op_bits:
                        append_cstr(ref (deref self).main_out, " = sext ")
                    else:
                        append_cstr(ref (deref self).main_out, " = trunc ")
                    append_str(ref (deref self).main_out, left_t_str)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, left_reg to cstr)
                    append_cstr(ref (deref self).main_out, " to ")
                    append_str(ref (deref self).main_out, operand_type)
                    append_cstr(ref (deref self).main_out, "\n")
                    real_left = cv_l
                elif op_f_rank > 0 to i32 and left_f_rank > 0 to i32:
                    let cv_l as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, cv_l to cstr)
                    if left_f_rank < op_f_rank:
                        append_cstr(ref (deref self).main_out, " = fpext ")
                    else:
                        append_cstr(ref (deref self).main_out, " = fptrunc ")
                    append_str(ref (deref self).main_out, left_t_str)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, left_reg to cstr)
                    append_cstr(ref (deref self).main_out, " to ")
                    append_str(ref (deref self).main_out, operand_type)
                    append_cstr(ref (deref self).main_out, "\n")
                    real_left = cv_l
                elif op_f_rank > 0 to i32 and left_bits > 0 to i32:
                    let cv_l as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, cv_l to cstr)
                    append_cstr(ref (deref self).main_out, " = sitofp ")
                    append_str(ref (deref self).main_out, left_t_str)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, left_reg to cstr)
                    append_cstr(ref (deref self).main_out, " to ")
                    append_str(ref (deref self).main_out, operand_type)
                    append_cstr(ref (deref self).main_out, "\n")
                    real_left = cv_l
            if not right_is_ptr and strcmp(right_t_str.data to cstr, operand_type.data to cstr) != 0:
                let right_bits as i32 = llvm_int_bits(right_t_str)
                let op_bits as i32 = llvm_int_bits(operand_type)
                let right_f_rank as i32 = llvm_float_rank(right_t_str)
                let op_f_rank as i32 = llvm_float_rank(operand_type)

                if op_bits > 0 to i32 and right_bits > 0 to i32:
                    let cv_r as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, cv_r to cstr)
                    if right_bits < op_bits:
                        append_cstr(ref (deref self).main_out, " = sext ")
                    else:
                        append_cstr(ref (deref self).main_out, " = trunc ")
                    append_str(ref (deref self).main_out, right_t_str)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, right_reg to cstr)
                    append_cstr(ref (deref self).main_out, " to ")
                    append_str(ref (deref self).main_out, operand_type)
                    append_cstr(ref (deref self).main_out, "\n")
                    real_right = cv_r
                elif op_f_rank > 0 to i32 and right_f_rank > 0 to i32:
                    let cv_r as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, cv_r to cstr)
                    if right_f_rank < op_f_rank:
                        append_cstr(ref (deref self).main_out, " = fpext ")
                    else:
                        append_cstr(ref (deref self).main_out, " = fptrunc ")
                    append_str(ref (deref self).main_out, right_t_str)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, right_reg to cstr)
                    append_cstr(ref (deref self).main_out, " to ")
                    append_str(ref (deref self).main_out, operand_type)
                    append_cstr(ref (deref self).main_out, "\n")
                    real_right = cv_r
                elif op_f_rank > 0 to i32 and right_bits > 0 to i32:
                    let cv_r as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, cv_r to cstr)
                    append_cstr(ref (deref self).main_out, " = sitofp ")
                    append_str(ref (deref self).main_out, right_t_str)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, right_reg to cstr)
                    append_cstr(ref (deref self).main_out, " to ")
                    append_str(ref (deref self).main_out, operand_type)
                    append_cstr(ref (deref self).main_out, "\n")
                    real_right = cv_r

        let is_fop as bool = strcmp(operand_type.data to cstr, "double" to cstr) == 0 or strcmp(operand_type.data to cstr, "float" to cstr) == 0 or strcmp(operand_type.data to cstr, "half" to cstr) == 0 or strcmp(operand_type.data to cstr, "bfloat" to cstr) == 0 or strcmp(operand_type.data to cstr, "fp128" to cstr) == 0
        if is_fop:
            if node_kind(actual_right) == NodeType.NumberLiteral and (deref real_right) != 37 to u8:
                real_right = self.float_const_reg(actual_right)
            if node_kind(actual_left) == NodeType.NumberLiteral and (deref real_left) != 37 to u8:
                real_left = self.float_const_reg(actual_left)

        let reg as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, reg to cstr)

        if op.data == None:
            if is_fop:
                append_cstr(ref (deref self).main_out, " = fadd ")
            else:
                append_cstr(ref (deref self).main_out, " = add ")
        elif strcmp(op.data to cstr, "+" to cstr) == 0:
            if is_fop:
                append_cstr(ref (deref self).main_out, " = fadd ")
            else:
                append_cstr(ref (deref self).main_out, " = add ")
        elif strcmp(op.data to cstr, "-" to cstr) == 0:
            if is_fop:
                append_cstr(ref (deref self).main_out, " = fsub ")
            else:
                append_cstr(ref (deref self).main_out, " = sub ")
        elif strcmp(op.data to cstr, "*" to cstr) == 0:
            if is_fop:
                append_cstr(ref (deref self).main_out, " = fmul ")
            else:
                append_cstr(ref (deref self).main_out, " = mul ")
        elif strcmp(op.data to cstr, "/" to cstr) == 0:
            if is_fop:
                append_cstr(ref (deref self).main_out, " = fdiv ")
            else:
                append_cstr(ref (deref self).main_out, " = sdiv ")
        elif strcmp(op.data to cstr, "%" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = srem ")
        elif strcmp(op.data to cstr, "or" to cstr) == 0 or strcmp(op.data to cstr, "|" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = or ")
        elif strcmp(op.data to cstr, "and" to cstr) == 0 or strcmp(op.data to cstr, "&" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = and ")
        elif strcmp(op.data to cstr, "^" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = xor ")
        elif strcmp(op.data to cstr, "<<" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = shl ")
        elif strcmp(op.data to cstr, ">>" to cstr) == 0:
            var is_unsigned as bool = False
            let left_t as ptr[Type] = node_inferred_type(actual_left)
            if left_t != None to ptr[Type]:
                let lk as TypeKind = (deref left_t).kind
                if lk == TypeKind.U8 or lk == TypeKind.U16 or lk == TypeKind.U32 or lk == TypeKind.U64 or lk == TypeKind.U128 or lk == TypeKind.U256 or lk == TypeKind.U512 or lk == TypeKind.U1024 or lk == TypeKind.USize or lk == TypeKind.Color:
                    is_unsigned = True
            if is_unsigned:
                append_cstr(ref (deref self).main_out, " = lshr ")
            else:
                append_cstr(ref (deref self).main_out, " = ashr ")
        elif strcmp(op.data to cstr, "<" to cstr) == 0:
            if is_fop:
                append_cstr(ref (deref self).main_out, " = fcmp olt ")
            else:
                append_cstr(ref (deref self).main_out, " = icmp slt ")
        elif strcmp(op.data to cstr, ">" to cstr) == 0:
            if is_fop:
                append_cstr(ref (deref self).main_out, " = fcmp ogt ")
            else:
                append_cstr(ref (deref self).main_out, " = icmp sgt ")
        elif strcmp(op.data to cstr, "<=" to cstr) == 0:
            if is_fop:
                append_cstr(ref (deref self).main_out, " = fcmp ole ")
            else:
                append_cstr(ref (deref self).main_out, " = icmp sle ")
        elif strcmp(op.data to cstr, ">=" to cstr) == 0:
            if is_fop:
                append_cstr(ref (deref self).main_out, " = fcmp oge ")
            else:
                append_cstr(ref (deref self).main_out, " = icmp sge ")
        elif strcmp(op.data to cstr, "==" to cstr) == 0:
            if is_fop:
                append_cstr(ref (deref self).main_out, " = fcmp oeq ")
            else:
                append_cstr(ref (deref self).main_out, " = icmp eq ")
        elif strcmp(op.data to cstr, "!=" to cstr) == 0:
            if is_fop:
                append_cstr(ref (deref self).main_out, " = fcmp one ")
            else:
                append_cstr(ref (deref self).main_out, " = icmp ne ")
        else:
            append_cstr(ref (deref self).main_out, " = add ")

        append_cstr(ref (deref self).main_out, " ")
        append_str(ref (deref self).main_out, operand_type)
        append_cstr(ref (deref self).main_out, " ")
        append_cstr(ref (deref self).main_out, real_left to cstr)
        append_cstr(ref (deref self).main_out, ", ")
        append_cstr(ref (deref self).main_out, real_right to cstr)
        append_cstr(ref (deref self).main_out, "\n")
        return reg

    public fn emit_call_stmt(self as ptr[LLVMCodegen], node as ptr[Node]):
        let _ as ptr[u8] = self.emit_call_expr(node)

    public fn emit_call_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        if node == None to ptr[Node]:
            return "null" to ptr[u8]
        let callee as ptr[Node] = node_left(node)
        if callee == None to ptr[Node]:
            return "null" to ptr[u8]
        let args as List[ptr[Node]] = node_params(node)
        let callee_name_ptr as ptr[String] = node_name_ptr(callee)
        let callee_t as ptr[Type] = node_inferred_type(callee)
        var ret_type as String = type_to_llvm(node_inferred_type(node))
        if ret_type.len == 0 to usize or strcmp(ret_type.data to cstr, "void" to cstr) == 0:
            if callee_t != None to ptr[Type] and (deref callee_t).kind == TypeKind.Function and (deref callee_t).return_type != None to ptr[Type]:
                ret_type = type_to_llvm((deref callee_t).return_type)
        if strcmp(ret_type.data to cstr, "{ ptr, ptr }" to cstr) == 0 or strcmp(ret_type.data to cstr, "ptr" to cstr) == 0:
            var is_dict_list as bool = False
            var c_n as cstr = None to cstr
            if callee_name_ptr != None to ptr[String]:
                let cn_str as String = deref callee_name_ptr
                if cn_str.data != None to ptr[u8]:
                    if cn_str.len > 0 to usize:
                        c_n = cn_str.data to cstr
            elif node_kind(callee) == NodeType.MemberExpr:
                let m_nm as String = node_name(callee)
                if m_nm.data != None to ptr[u8]:
                    if m_nm.len > 0 to usize:
                        c_n = m_nm.data to cstr

            if (c_n to usize) != 0 to usize:
                extern fn strstr(haystack as cstr, needle as cstr) as cstr
                extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
                let has_has as bool = strncmp(c_n, "has" to cstr, 3 to usize) == 0
                let has_is as bool = strncmp(c_n, "is" to cstr, 2 to usize) == 0
                let has_remove as bool = (strstr(c_n, "remove" to cstr) to usize) != 0 to usize
                let has_contains as bool = (strstr(c_n, "contains" to cstr) to usize) != 0 to usize
                let is_ts_byte as bool = (strstr(c_n, "_byte_ptr" to cstr) to usize) != 0 to usize or (strstr(c_n, "_row_ptr" to cstr) to usize) != 0 to usize or (strstr(c_n, "_col_ptr" to cstr) to usize) != 0 to usize or (strstr(c_n, "_count_ptr" to cstr) to usize) != 0 to usize
                let has_set_lang as bool = strcmp(c_n, "ts_parser_set_language" to cstr) == 0
                if has_has or has_is or has_remove or has_contains or has_set_lang or strcmp(c_n, "__getitem__" to cstr) == 0:
                    ret_type = String.make("i8" to cstr)
                elif strcmp(c_n, "node_kind" to cstr) == 0 or strcmp(c_n, "sprintf" to cstr) == 0 or strcmp(c_n, "snprintf" to cstr) == 0 or strcmp(c_n, "printf" to cstr) == 0 or strcmp(c_n, "strcmp" to cstr) == 0 or strcmp(c_n, "strncmp" to cstr) == 0 or strcmp(c_n, "fseek" to cstr) == 0 or strcmp(c_n, "fclose" to cstr) == 0:
                    ret_type = String.make("i32" to cstr)
                elif strcmp(c_n, "ftell" to cstr) == 0 or strcmp(c_n, "strlen" to cstr) == 0 or strcmp(c_n, "length" to cstr) == 0 or strcmp(c_n, "len" to cstr) == 0 or is_ts_byte:
                    ret_type = String.make("i64" to cstr)
                elif strcmp(c_n, "Dict" to cstr) == 0 or strcmp(c_n, "List" to cstr) == 0:
                    is_dict_list = True
                elif (deref (c_n to ptr[u8])) >= 65 to u8 and (deref (c_n to ptr[u8])) <= 90 to u8:
                    if strcmp(c_n, "String" to cstr) == 0 or strcmp(c_n, "List" to cstr) == 0 or strcmp(c_n, "Dict" to cstr) == 0 or strcmp(c_n, "Set" to cstr) == 0:
                        ret_type = String.make("{ ptr, i64, i64 }" to cstr)
                    else:
                        let s_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
                        let _ as i32 = sprintf(s_buf, "%%%s" to cstr, c_n)
                        ret_type = String.make(s_buf to cstr)
                else:
                    ret_type = String.make("ptr" to cstr)
            else:
                ret_type = String.make("ptr" to cstr)

        if callee == None to ptr[Node]:
            return "0" to ptr[u8]

        if callee_name_ptr != None to ptr[String]:
            if node_kind(callee) == NodeType.Identifier:
                let c_name as String = deref callee_name_ptr
                if c_name.data != None to ptr[u8]:
                    if c_name.len > 0 to usize:
                        let c_cstr as cstr = c_name.data to cstr
                        let c_len as usize = c_name.len
                        if (c_len == 4 to usize and strncmp(c_cstr, "size" to cstr, 4 to usize) == 0) or (c_len == 7 to usize and strncmp(c_cstr, "size_of" to cstr, 7 to usize) == 0) or (c_len == 6 to usize and strncmp(c_cstr, "sizeof" to cstr, 6 to usize) == 0):
                            if args.length() > 0 to i64:
                                let sz_arg as ptr[Node] = get_node_decl(ref args, 0 to i64)
                                let sz_val as i64 = self.eval_type_size_node(sz_arg)
                                let s_buf as ptr[u8] = make[u8](32 to usize) to ptr[u8]
                                let _ as i32 = sprintf(s_buf, "%lld" to cstr, sz_val)
                                return s_buf
                        elif (c_len == 7 to usize and strncmp(c_cstr, "alignof" to cstr, 7 to usize) == 0) or (c_len == 8 to usize and strncmp(c_cstr, "align_of" to cstr, 8 to usize) == 0):
                            if args.length() > 0 to i64:
                                let al_arg as ptr[Node] = get_node_decl(ref args, 0 to i64)
                                let al_val as i64 = self.eval_type_align_node(al_arg)
                                let a_buf as ptr[u8] = make[u8](32 to usize) to ptr[u8]
                                let _ as i32 = sprintf(a_buf, "%lld" to cstr, al_val)
                                return a_buf
                        if strcmp(c_name.data to cstr, "Ok" to cstr) == 0:
                            if args.length() > 0 to i64:
                                var ok_arg as ptr[Node] = get_node_decl(ref args, 0 to i64)
                                if node_kind(ok_arg) == NodeType.BinaryExpr:
                                    let fb_op as ptr[String] = node_op_ptr(ok_arg)
                                    if fb_op != None to ptr[String] and (deref fb_op).data != None and strcmp((deref fb_op).data to cstr, "=" to cstr) == 0:
                                        let f_r as ptr[Node] = node_right(ok_arg)
                                        if f_r != None to ptr[Node]:
                                            ok_arg = f_r
                                let ok_val as ptr[u8] = self.emit_expr(ok_arg)
                                let ok_arg_type as ptr[Type] = node_inferred_type(ok_arg)
                                var ok_is_ptr as bool = False
                                if ok_arg_type != None to ptr[Type]:
                                    if (deref ok_arg_type).kind == TypeKind.RawPointer:
                                        ok_is_ptr = True
                                let t1 as ptr[u8] = self.fresh_temp()
                                append_cstr(ref (deref self).main_out, "  ")
                                append_cstr(ref (deref self).main_out, t1 to cstr)
                                append_cstr(ref (deref self).main_out, " = insertvalue { i8, ptr, ptr } undef, i8 0, 0\n")
                                if ok_is_ptr:
                                    let t2 as ptr[u8] = self.fresh_temp()
                                    append_cstr(ref (deref self).main_out, "  ")
                                    append_cstr(ref (deref self).main_out, t2 to cstr)
                                    append_cstr(ref (deref self).main_out, " = insertvalue { i8, ptr, ptr } ")
                                    append_cstr(ref (deref self).main_out, t1 to cstr)
                                    append_cstr(ref (deref self).main_out, ", ptr ")
                                    append_cstr(ref (deref self).main_out, ok_val to cstr)
                                    append_cstr(ref (deref self).main_out, ", 1\n")
                                    let t3 as ptr[u8] = self.fresh_temp()
                                    append_cstr(ref (deref self).main_out, "  ")
                                    append_cstr(ref (deref self).main_out, t3 to cstr)
                                    append_cstr(ref (deref self).main_out, " = insertvalue { i8, ptr, ptr } ")
                                    append_cstr(ref (deref self).main_out, t2 to cstr)
                                    append_cstr(ref (deref self).main_out, ", ptr null, 2\n")
                                    return t3
                                let box_reg as ptr[u8] = self.fresh_temp()
                                append_cstr(ref (deref self).main_out, "  ")
                                append_cstr(ref (deref self).main_out, box_reg to cstr)
                                append_cstr(ref (deref self).main_out, " = call ptr @mantiq_malloc(i64 32)\n")
                                var ok_arg_ll as String = type_to_llvm(ok_arg_type)
