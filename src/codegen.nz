    public fn generate(self as ptr[LLVMCodegen], root as ptr[Node]) as String:
        set_dict_bool(ref (deref self).external_decls, String.make("malloc" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("free" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_free" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_malloc" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_isa" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("__mantiq_list_append" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("__mantiq_list_extend" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("__mantiq_dict_get" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("__mantiq_dict_get_or_insert" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("__mantiq_dict_clear" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("__mantiq_dict_remove" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("__mantiq_dict_keys" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("__mantiq_dict_merge" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("__mantiq_dict_set" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("__mantiq_hash_string" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("__mantiq_hash_bytes" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("strlen" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_concat_str" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_i32_to_str" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_i64_to_str" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_u64_to_str" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_float_to_str" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_f64_to_str" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_char_to_str" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_bool_to_str" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_spawn" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_await" to cstr), True)
        append_cstr(ref (deref self).type_out, "declare i32 @mantiq_isa(ptr, i32)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @mantiq_malloc(i64)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @mantiq_spawn(ptr, ptr)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @mantiq_await(ptr)\n")
        append_cstr(ref (deref self).type_out, "declare void @mantiq_print_i32(i32)\n")
        append_cstr(ref (deref self).type_out, "declare void @mantiq_print_bool(i32)\n")
        append_cstr(ref (deref self).type_out, "declare void @mantiq_print_float(float)\n")
        append_cstr(ref (deref self).type_out, "declare void @mantiq_print_ptr(ptr)\n")
        append_cstr(ref (deref self).type_out, "declare void @mantiq_print_space()\n")
        append_cstr(ref (deref self).type_out, "declare void @mantiq_print_newline()\n")
        append_cstr(ref (deref self).type_out, "declare void @mantiq_print_str(ptr, i64)\n")
        append_cstr(ref (deref self).type_out, "declare void @mantiq_print_cstr(ptr)\n")
        append_cstr(ref (deref self).type_out, "declare void @__mantiq_list_append(ptr, ptr, i64)\n")
        append_cstr(ref (deref self).type_out, "declare void @__mantiq_list_extend(ptr, ptr, i64)\n")
        append_cstr(ref (deref self).type_out, "declare i32 @__mantiq_hash_string(ptr, i64)\n")
        append_cstr(ref (deref self).type_out, "declare i32 @__mantiq_hash_bytes(ptr, i64)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @__mantiq_dict_create(i32, i32, i32)\n")
        append_cstr(ref (deref self).type_out, "declare void @__mantiq_dict_set(ptr, ptr, ptr, i32)\n")
        append_cstr(ref (deref self).type_out, "declare void @__mantiq_dict_merge(ptr, ptr)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @__mantiq_dict_get(ptr, ptr, i32)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @__mantiq_dict_get_or_insert(ptr, ptr, i32)\n")
        append_cstr(ref (deref self).type_out, "declare i8 @__mantiq_dict_remove(ptr, ptr, i32)\n")
        append_cstr(ref (deref self).type_out, "declare void @__mantiq_dict_clear(ptr)\n")
        append_cstr(ref (deref self).type_out, "declare void @__mantiq_dict_keys(ptr, ptr, i32)\n")
        append_cstr(ref (deref self).type_out, "declare i32 @mantiq_quantum_qbit(i32)\n")
        append_cstr(ref (deref self).type_out, "declare i32 @mantiq_quantum_h(i32)\n")
        append_cstr(ref (deref self).type_out, "declare i32 @mantiq_quantum_measure(i32)\n")
        append_cstr(ref (deref self).type_out, "declare void @mantiq_quantum_cnot(i32, i32)\n")
        append_cstr(ref (deref self).type_out, "declare i32 @mantiq_quantum_x(i32)\n")
        append_cstr(ref (deref self).type_out, "declare i32 @mantiq_quantum_y(i32)\n")
        append_cstr(ref (deref self).type_out, "declare i32 @mantiq_quantum_z(i32)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @mantiq_concat_str(ptr, i64, ptr, i64)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @mantiq_i32_to_str(i32, ptr)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @mantiq_i64_to_str(i64, ptr)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @mantiq_u64_to_str(i64, ptr)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @mantiq_float_to_str(float, ptr)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @mantiq_f64_to_str(double, ptr)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @mantiq_char_to_str(i8, ptr)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @mantiq_bool_to_str(i32, ptr)\n")
        append_cstr(ref (deref self).type_out, "declare i64 @strlen(ptr)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @__mantiq_channel_new(i64, i64)\n")
        append_cstr(ref (deref self).type_out, "declare void @__mantiq_channel_send(ptr, ptr, i64)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @__mantiq_channel_recv(ptr, i64)\n")
        append_cstr(ref (deref self).type_out, "declare i32 @__mantiq_channel_try_send(ptr, ptr, i64)\n")
        append_cstr(ref (deref self).type_out, "declare ptr @__mantiq_channel_try_recv(ptr, i64, ptr)\n")
        append_cstr(ref (deref self).type_out, "declare void @__mantiq_channel_close(ptr)\n")
        append_cstr(ref (deref self).type_out, "declare i32 @__mantiq_channel_is_closed(ptr)\n")
        append_cstr(ref (deref self).type_out, "declare i64 @__mantiq_channel_len(ptr)\n")
        append_cstr(ref (deref self).type_out, "declare i64 @__mantiq_channel_cap(ptr)\n")
        append_cstr(ref (deref self).type_out, "declare void @__mantiq_channel_free(ptr)\n")
        append_cstr(ref (deref self).type_out, "%MantiqDict = type { ptr, ptr, ptr, ptr, i32, i32, i32, i32 }\n")
        self.emit_builtin_struct_types()
        self.emit_node(root)
        let out as StringBuilder = StringBuilder.make()
        append_cstr(ref out, "; ModuleID = 'MantiqModule'\n")
        append_cstr(ref out, "source_filename = \"test\"\n")
        append_cstr(ref out, "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"\n")
        append_cstr(ref out, "target triple = \"x86_64-unknown-linux-gnu\"\n\n")
        append_cstr(ref out, "declare ptr @malloc(i64)\n")
        append_cstr(ref out, "declare void @free(ptr)\n")
        append_cstr(ref out, "declare void @mantiq_free(ptr)\n")
        append_cstr(ref out, "declare ptr @mantiq_realloc(ptr, i64)\n\n")
        if (deref self).type_out.buffer != None to ptr[u8]:
            append_cstr(ref out, (deref self).type_out.buffer to cstr)
        if (deref self).main_out.buffer != None to ptr[u8]:
            append_cstr(ref out, (deref self).main_out.buffer to cstr)
        if (deref self).outlined_out.buffer != None to ptr[u8]:
            append_cstr(ref out, (deref self).outlined_out.buffer to cstr)
        if (deref self).metadata_out.buffer != None to ptr[u8]:
            append_cstr(ref out, (deref self).metadata_out.buffer to cstr)
        return out.to_string()

    public fn emit_node(self as ptr[LLVMCodegen], node as ptr[Node]):
        if node == None to ptr[Node]:
            return
        let nt as NodeType = node_kind(node)
        if nt == NodeType.Program:
            self.emit_program(node)
        elif nt == NodeType.FunDecl:
            self.emit_fun_decl(node)
        elif nt == NodeType.VarDecl:
            self.emit_var_decl(node)
        elif nt == NodeType.BinaryExpr:
            self.emit_binary_stmt(node)
        elif nt == NodeType.Identifier:
            let name_str as String = node_name(node)
            if name_str.data != None:
                if strcmp(name_str.data to cstr, "break" to cstr) == 0:
                    if (deref self).current_break_label.len > 0 to usize:
                        append_cstr(ref (deref self).main_out, "  br label %")
                        append_str(ref (deref self).main_out, (deref self).current_break_label)
                        append_cstr(ref (deref self).main_out, "\n")
                        let dead_l as ptr[u8] = self.fresh_label()
                        append_cstr(ref (deref self).main_out, dead_l to cstr)
                        append_cstr(ref (deref self).main_out, ":\n")
                elif strcmp(name_str.data to cstr, "continue" to cstr) == 0:
                    if (deref self).current_continue_label.len > 0 to usize:
                        append_cstr(ref (deref self).main_out, "  br label %")
                        append_str(ref (deref self).main_out, (deref self).current_continue_label)
                        append_cstr(ref (deref self).main_out, "\n")
                        let dead_l2 as ptr[u8] = self.fresh_label()
                        append_cstr(ref (deref self).main_out, dead_l2 to cstr)
                        append_cstr(ref (deref self).main_out, ":\n")
        elif nt == NodeType.NumberLiteral:
            pass
        elif nt == NodeType.StringLiteral:
            pass
        elif nt == NodeType.CallExpr:
            self.emit_call_stmt(node)
        elif nt == NodeType.ReturnStmt:
            self.emit_return(node)
        elif nt == NodeType.IfStmt:
            self.emit_if(node)
        elif nt == NodeType.MatchStmt:
            self.emit_match_stmt(node)
        elif nt == NodeType.WhileStmt:
            self.emit_while(node)
        elif nt == NodeType.ForStmt:
            self.emit_for(node)
        elif nt == NodeType.WithStmt:
            self.emit_with(node)
        elif nt == NodeType.TryStmt:
            let _ as ptr[u8] = self.emit_try(node)
        elif nt == NodeType.ThrowStmt:
            self.emit_throw(node)
        elif nt == NodeType.BlockStmt:
            self.emit_block(node)
        elif nt == NodeType.ParamBlockStmt:
            self.emit_param_block(node)
        elif nt == NodeType.BinaryExpr: // BinaryExpr / Assignment as statement
            self.emit_binary_stmt(node)
        elif nt == NodeType.MemberExpr: // MemberExpr as statement
            let _ as ptr[u8] = self.emit_expr(node)
        elif nt == NodeType.UnaryExpr: // UnaryExpr as statement
            let _ as ptr[u8] = self.emit_expr(node)
        elif nt == NodeType.CastExpr: // CastExpr as statement
            let _ as ptr[u8] = self.emit_expr(node)
        elif nt == NodeType.ListLiteral: // ListLiteral as statement
            let _ as ptr[u8] = self.emit_expr(node)
        elif nt == NodeType.ListComprehension: // ListComprehension as statement
            let _ as ptr[u8] = self.emit_expr(node)
        elif nt == NodeType.InterpolatedString: // InterpolatedString as statement
            let _ as ptr[u8] = self.emit_expr(node)
        elif nt == NodeType.IndexExpr: // IndexExpr as statement
            let _ as ptr[u8] = self.emit_expr(node)
        elif nt == NodeType.StructDecl: // StructDecl
            self.emit_struct_decl(node)
        elif nt == NodeType.ClassDecl: // ClassDecl
            self.emit_class_decl(node)
        elif nt == NodeType.InterfaceDecl: // InterfaceDecl
            self.emit_interface_decl(node)
        elif nt == NodeType.EnumDecl: // EnumDecl
            self.emit_enum_decl(node)
        elif nt == NodeType.UnionDecl: // UnionDecl
            self.emit_union_decl(node)

    public fn emit_program(self as ptr[LLVMCodegen], node as ptr[Node]):
        let decls as List[ptr[Node]] = node_declarations(node)
        let count as i64 = decls.length()
        var i as i64 = 0 to i64
        while i < count:
            let decl as ptr[Node] = get_node_decl(ref decls, i)
            let dk as NodeType = node_kind(decl)
            if dk == NodeType.FunDecl:
                let fn_nm as String = node_name(decl)
                if fn_nm.data != None and not node_is_extern(decl):
                    set_dict_bool(ref (deref self).program_functions, fn_nm, True)
            elif dk == NodeType.StructDecl:
                let sn as String = node_name(decl)
                if node_body(decl) != None to ptr[Node]:
                    let s_body as ptr[Node] = node_body(decl)
                    let s_decls as List[ptr[Node]] = node_declarations(s_body)
                    let s_cnt as i64 = s_decls.length()
                    var s_i as i64 = 0 to i64
                    while s_i < s_cnt:
                        let s_d as ptr[Node] = get_node_decl(ref s_decls, s_i)
                        if node_kind(s_d) == NodeType.FunDecl:
                            let m_nm as String = node_name(s_d)
                            let m_mangled as StringBuilder = StringBuilder.make()
                            append_str(ref m_mangled, sn)
                            append_cstr(ref m_mangled, "_" to cstr)
                            append_str(ref m_mangled, m_nm)
                            set_dict_bool(ref (deref self).program_functions, m_mangled.to_string(), True)
                        s_i = s_i + 1 to i64
            elif dk == NodeType.ClassDecl:
                let cn as String = node_name(decl)
                let target_base as String = node_target(decl)
                if target_base.data != None to ptr[u8] and target_base.len > 0 to usize:
                    let base_k as StringBuilder = StringBuilder.make()
                    append_cstr(ref base_k, "__base_" to cstr)
                    append_str(ref base_k, cn)
                    set_dict_str(ref (deref self).type_aliases, base_k.to_string(), target_base)
                    base_k.deinit()
                if node_body(decl) != None to ptr[Node]:
                    let c_body as ptr[Node] = node_body(decl)
                    let c_decls as List[ptr[Node]] = node_declarations(c_body)
                    let c_cnt as i64 = c_decls.length()
                    var c_i as i64 = 0 to i64
                    while c_i < c_cnt:
                        let c_d as ptr[Node] = get_node_decl(ref c_decls, c_i)
                        if node_kind(c_d) == NodeType.FunDecl:
                            let m_nm as String = node_name(c_d)
                            let m_mangled as StringBuilder = StringBuilder.make()
                            append_str(ref m_mangled, cn)
                            append_cstr(ref m_mangled, "_" to cstr)
                            append_str(ref m_mangled, m_nm)
                            set_dict_bool(ref (deref self).program_functions, m_mangled.to_string(), True)
                        c_i = c_i + 1 to i64
            elif dk == NodeType.VarDecl:
                let v_name as String = node_name(decl)
                if v_name.data != None to ptr[u8] and v_name.len > 0 to usize:
                    var v_type as String = type_to_llvm(node_inferred_type(decl))
                    if v_type.len == 0 to usize or strcmp(v_type.data to cstr, "void" to cstr) == 0:
                        v_type = String.make("i32" to cstr)
                    let init_node as ptr[Node] = node_left(decl)
                    var init_val as ptr[u8] = "0" to ptr[u8]
                    if (deref (v_type.data)) == 123 to u8 or strcmp(v_type.data to cstr, "ptr" to cstr) == 0:
                        init_val = "zeroinitializer" to ptr[u8]
                    if init_node != None to ptr[Node] and node_kind(init_node) == NodeType.NumberLiteral:
                        let s_raw as String = node_str_val(init_node)
                        if s_raw.data != None to ptr[u8] and s_raw.len > 0 to usize:
                            init_val = s_raw.data
                        else:
                            let num_val as i64 = node_val(init_node) to i64
                            let buf as ptr[u8] = make[u8](32 to usize) to ptr[u8]
                            let _ as i32 = sprintf(buf, "%ld" to cstr, num_val)
                            init_val = buf
                    elif init_node != None to ptr[Node] and node_kind(init_node) == NodeType.ColorLiteral:
                        let c_val as u64 = node_val(init_node) to u64
                        let buf as ptr[u8] = make[u8](32 to usize) to ptr[u8]
                        let _ as i32 = sprintf(buf, "%u" to cstr, c_val to u32)
                        init_val = buf
                    elif init_node != None to ptr[Node] and node_kind(init_node) == NodeType.StringLiteral:
                        let _ as ptr[u8] = self.emit_expr(init_node)
                        init_val = "zeroinitializer" to ptr[u8]
                    append_cstr(ref (deref self).type_out, "@")
                    append_str(ref (deref self).type_out, v_name)
                    append_cstr(ref (deref self).type_out, " = internal global ")
                    append_str(ref (deref self).type_out, v_type)
                    append_cstr(ref (deref self).type_out, " ")
                    append_cstr(ref (deref self).type_out, init_val to cstr)
                    append_cstr(ref (deref self).type_out, ", align 8\n" to cstr)

                    set_dict_bool(ref (deref self).global_vars, v_name, True)
                    set_dict_str(ref (deref self).global_types, v_name, v_type)
            elif dk == NodeType.FieldDecl:
                let t_name as String = node_name(decl)
                let ann_list as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(decl)
                if ann_list != None to ptr[List[Option[ptr[TypeAnnotation]]]] and (deref ann_list).length() > 0 to i64:
                    let opt_ann as Option[ptr[TypeAnnotation]] = (deref ann_list)[0]
                    let opt_ref as ptr[OptionLayout] = (ref opt_ann) to ptr[OptionLayout]
                    if option_has_value(opt_ref):
                        let ta_p as ptr[TypeAnnotation] = (deref opt_ref).val_ptr to ptr[TypeAnnotation]
                        if ta_p != None to ptr[TypeAnnotation]:
                            let tgt_name as String = (deref ta_p).name
                            set_dict_str(ref (deref self).type_aliases, t_name, tgt_name)
            i = i + 1 to i64
        i = 0 to i64
        while i < count:
            let decl as ptr[Node] = get_node_decl(ref decls, i)
            let dk as NodeType = node_kind(decl)
            if dk != NodeType.VarDecl and dk != NodeType.FieldDecl:
                self.emit_node(decl)
            i = i + 1 to i64

    public fn emit_fun_decl(self as ptr[LLVMCodegen], node as ptr[Node]):
        let name as String = node_name(node)
        if strcmp(name.data to cstr, "__init__" to cstr) == 0:
            return
        if (deref self).defined_functions.has(name):
            return
        set_dict_bool(ref (deref self).defined_functions, name, True)

        let saved_struct_name as String = (deref self).current_struct_name

        if (deref self).current_struct_name.len == 0 to usize:
            if name.data != None:
                let u_ptr as cstr = strchr(name.data to cstr, '_' to i32)
                if u_ptr != None to cstr:
                    var prefix_len as usize = (u_ptr to usize) - (name.data to usize)
                    if prefix_len == 0 to usize and name.len > 1 to usize:
                        let u_ptr2 as cstr = strchr((name.data to usize + 1 to usize) to cstr, '_' to i32)
                        if u_ptr2 != None to cstr:
                            prefix_len = (u_ptr2 to usize) - (name.data to usize)
                    if prefix_len > 0 to usize:
                        let p_buf as ptr[u8] = make[u8](prefix_len + 1 to usize) to ptr[u8]
                        let _ as ptr = memcpy(p_buf to ptr, name.data to ptr, prefix_len)
                        p_buf[prefix_len] = 0 to u8
                        let cand_st as String = String.make(p_buf to cstr)
                        if (deref self).defined_types.has(cand_st):
                            (deref self).current_struct_name = cand_st
                        free(p_buf to ptr)

        let params as List[ptr[Node]] = node_params(node)
        let body as ptr[Node] = node_body(node)
        var ret_type as String = type_to_llvm(node_inferred_type(node))
        let fn_t as ptr[Type] = node_inferred_type(node)
        if fn_t != None to ptr[Type]:
            if (deref fn_t).kind == TypeKind.Function and (deref fn_t).return_type != None to ptr[Type]:
                ret_type = type_to_llvm((deref fn_t).return_type)
        let r_annot as ptr[TypeAnnotation] = node_return_type_annot(node)
        if (ret_type.len == 0 to usize or strcmp(ret_type.data to cstr, "void" to cstr) == 0 or strcmp(ret_type.data to cstr, "i64" to cstr) == 0) and r_annot != None to ptr[TypeAnnotation]:
            if (deref r_annot).name.data != None to ptr[u8] and (deref r_annot).name.len > 0 to usize:
                let rn as cstr = (deref r_annot).name.data to cstr
                extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
                if strcmp(rn, "cstr" to cstr) == 0 or strcmp(rn, "ptr" to cstr) == 0 or strncmp(rn, "ptr[" to cstr, 4 to usize) == 0:
                    ret_type = String.make("ptr" to cstr)
                elif strcmp(rn, "i32" to cstr) == 0 or strcmp(rn, "u32" to cstr) == 0:
                    ret_type = String.make("i32" to cstr)
                elif strcmp(rn, "i64" to cstr) == 0 or strcmp(rn, "u64" to cstr) == 0 or strcmp(rn, "usize" to cstr) == 0:
                    ret_type = String.make("i64" to cstr)
                elif strcmp(rn, "bool" to cstr) == 0 or strcmp(rn, "u8" to cstr) == 0 or strcmp(rn, "i8" to cstr) == 0:
                    ret_type = String.make("i8" to cstr)
                elif strncmp(rn, "Dict" to cstr, 4 to usize) == 0 or strncmp(rn, "List" to cstr, 4 to usize) == 0 or strncmp(rn, "String" to cstr, 6 to usize) == 0:
                    ret_type = String.make("{ ptr, i64, i64 }" to cstr)
        if ret_type.len == 0 to usize:
            ret_type = String.make("void" to cstr)

        if strcmp(name.data to cstr, "memset" to cstr) == 0:
            ret_type = String.make("ptr" to cstr)

        // Handle extern functions: emit declare instead of define
        if node_is_extern(node):
            if (deref self).external_decls.has(name):
                (deref self).current_struct_name = saved_struct_name
                return
            set_dict_bool(ref (deref self).external_decls, name, True)
            let param_buf as StringBuilder = StringBuilder.make()
            let p_count as i64 = params.length()
            var p_idx as i64 = 0 to i64
            while p_idx < p_count:
                let p as ptr[Node] = get_node_decl(ref params, p_idx)
                let p_type as String = type_to_llvm(node_inferred_type(p))
                append_str(ref param_buf, p_type)
                if p_idx < p_count - 1 to i64:
                    append_cstr(ref param_buf, ", ")
                p_idx = p_idx + 1 to i64
            if node_is_variadic(node):
                if p_count > 0 to i64:
                    append_cstr(ref param_buf, ", ")
                append_cstr(ref param_buf, "...")
            append_cstr(ref (deref self).type_out, "declare ")
            append_str(ref (deref self).type_out, ret_type)
            append_cstr(ref (deref self).type_out, " @")
            append_str(ref (deref self).type_out, name)
            append_cstr(ref (deref self).type_out, "(")
            if param_buf.buffer != None to ptr[u8]:
                append_cstr(ref (deref self).type_out, param_buf.buffer to cstr)
            param_buf.deinit()
            append_cstr(ref (deref self).type_out, ")\n")
            (deref self).current_struct_name = saved_struct_name
            return
        var is_main as bool = strcmp(name.data to cstr, "main" to cstr) == 0
        if is_main and strcmp(ret_type.data to cstr, "void" to cstr) == 0:
            ret_type = String.make("i32" to cstr)
        let has_return as bool = str_eq(ret_type, String.make("void" to cstr)) == False

        let param_buf as StringBuilder = StringBuilder.make()
        let p_count as i64 = params.length()
        var p_idx as i64 = 0 to i64
        while p_idx < p_count:
            let param as ptr[Node] = get_node_decl(ref params, p_idx)
            var param_type as String = type_to_llvm(node_inferred_type(param))
            let p_annots_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(param)
            if p_annots_ptr != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                let p_annots as List[Option[ptr[TypeAnnotation]]] = deref p_annots_ptr
                if p_annots.length() > 0 to i64:
                    let opt as Option[ptr[TypeAnnotation]] = p_annots[0 to i64]
                    let opt_ref as ptr[OptionLayout] = (ref opt) to ptr[OptionLayout]
                    if option_has_value(opt_ref):
                        let pa as ptr[TypeAnnotation] = option_unwrap_ptr(opt_ref) to ptr[TypeAnnotation]
                        if pa != None to ptr[TypeAnnotation] and (deref pa).name.data != None:
                            if (deref pa).is_ref:
                                param_type = String.make("ptr" to cstr)
                            else:
                                let pa_name as cstr = (deref pa).name.data to cstr
                                extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
                                if strcmp(pa_name, "ptr" to cstr) == 0 or strcmp(pa_name, "cstr" to cstr) == 0 or strncmp(pa_name, "ptr[" to cstr, 4 to usize) == 0:
                                    param_type = String.make("ptr" to cstr)
                                elif strcmp(pa_name, "i32" to cstr) == 0 or strcmp(pa_name, "u32" to cstr) == 0 or strcmp(pa_name, "color" to cstr) == 0 or strcmp(pa_name, "Color" to cstr) == 0:
                                    param_type = String.make("i32" to cstr)
                                elif strcmp(pa_name, "i64" to cstr) == 0 or strcmp(pa_name, "u64" to cstr) == 0 or strcmp(pa_name, "usize" to cstr) == 0:
                                    param_type = String.make("i64" to cstr)
                                elif strcmp(pa_name, "Any" to cstr) == 0:
                                    param_type = String.make("{ ptr, ptr }" to cstr)
                                elif strncmp(pa_name, "Dict" to cstr, 4 to usize) == 0 or strncmp(pa_name, "List" to cstr, 4 to usize) == 0 or strncmp(pa_name, "String" to cstr, 6 to usize) == 0:
                                    param_type = String.make("{ ptr, i64, i64 }" to cstr)
            if param_type.len == 0 to usize:
                param_type = String.make("i64" to cstr)
            let is_bv as bool = is_struct_byval(param_type)
            if is_bv:
                append_cstr(ref param_buf, "ptr %")
            else:
                append_str(ref param_buf, param_type)
                append_cstr(ref param_buf, " %")
            append_str(ref param_buf, node_name(param))
            append_cstr(ref param_buf, "_param")
            if p_idx < p_count - 1 to i64:
                append_cstr(ref param_buf, ", ")
            p_idx = p_idx + 1 to i64

        append_cstr(ref (deref self).main_out, "define ")
        append_str(ref (deref self).main_out, ret_type)
        append_cstr(ref (deref self).main_out, " @")
        append_str(ref (deref self).main_out, name)
        append_cstr(ref (deref self).main_out, "(")
        if param_buf.buffer != None to ptr[u8]:
            append_cstr(ref (deref self).main_out, param_buf.buffer to cstr)
        param_buf.deinit()
        append_cstr(ref (deref self).main_out, ") {\n")
        append_cstr(ref (deref self).main_out, "entry:\n")

        (deref self).current_return_type = ret_type
        (deref self).var_slots = Dict[String, String]()
        (deref self).var_counts = Dict[String, i32]()
        (deref self).var_types = Dict[String, String]()

        p_idx = 0 to i64
        while p_idx < p_count:
            let p as ptr[Node] = get_node_decl(ref params, p_idx)
            let p_name as String = node_name(p)
            set_dict_i32(ref (deref self).var_counts, p_name, 1 to i32)
            set_dict_str(ref (deref self).var_slots, p_name, p_name)
            var p_type as String = type_to_llvm(node_inferred_type(p))
            let p_ann_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(p)
            if p_ann_ptr != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                let p_anns as List[Option[ptr[TypeAnnotation]]] = deref p_ann_ptr
                if p_anns.length() > 0 to i64:
                    let p_opt as Option[ptr[TypeAnnotation]] = p_anns[0 to i64]
                    let p_opt_ref as ptr[OptionLayout] = (ref p_opt) to ptr[OptionLayout]
                    if option_has_value(p_opt_ref):
                        let pa as ptr[TypeAnnotation] = option_unwrap_ptr(p_opt_ref) to ptr[TypeAnnotation]
                        if pa != None to ptr[TypeAnnotation] and (deref pa).name.data != None:
                            if (deref pa).is_ref:
                                p_type = String.make("ptr" to cstr)
                            else:
                                let pa_name as cstr = (deref pa).name.data to cstr
                                extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
                                if strcmp(pa_name, "ptr" to cstr) == 0 or strcmp(pa_name, "cstr" to cstr) == 0 or strncmp(pa_name, "ptr[" to cstr, 4 to usize) == 0:
                                    p_type = String.make("ptr" to cstr)
                                elif strcmp(pa_name, "i32" to cstr) == 0 or strcmp(pa_name, "u32" to cstr) == 0 or strcmp(pa_name, "color" to cstr) == 0 or strcmp(pa_name, "Color" to cstr) == 0:
                                    p_type = String.make("i32" to cstr)
                                elif strcmp(pa_name, "i64" to cstr) == 0 or strcmp(pa_name, "u64" to cstr) == 0 or strcmp(pa_name, "usize" to cstr) == 0:
                                    p_type = String.make("i64" to cstr)
                                elif strcmp(pa_name, "Any" to cstr) == 0:
                                    p_type = String.make("{ ptr, ptr }" to cstr)
                                elif strncmp(pa_name, "Dict" to cstr, 4 to usize) == 0 or strncmp(pa_name, "List" to cstr, 4 to usize) == 0 or strncmp(pa_name, "String" to cstr, 6 to usize) == 0:
                                    p_type = String.make("{ ptr, i64, i64 }" to cstr)
            if p_type.len == 0 to usize:
                p_type = String.make("i64" to cstr)
            set_dict_str(ref (deref self).var_types, p_name, p_type)
            let p_key as StringBuilder = StringBuilder.make()
            append_str(ref p_key, name)
            append_cstr(ref p_key, "#" to cstr)
            let p_buf as ptr[u8] = make[u8](32 to usize) to ptr[u8]
            let _ as i32 = sprintf(p_buf, "%lld" to cstr, p_idx)
            append_cstr(ref p_key, p_buf to cstr)
            free(p_buf to ptr)
            set_dict_str(ref (deref self).type_aliases, p_key.to_string(), p_type)
            p_key.deinit()
            let is_bv_p as bool = is_struct_byval(p_type)
            append_cstr(ref (deref self).main_out, "  %")
            append_str(ref (deref self).main_out, p_name)
            append_cstr(ref (deref self).main_out, " = alloca ")
            append_str(ref (deref self).main_out, p_type)
            append_cstr(ref (deref self).main_out, "\n")
            if is_bv_p:
                let tmp_bv as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, tmp_bv to cstr)
                append_cstr(ref (deref self).main_out, " = load ")
                append_str(ref (deref self).main_out, p_type)
                append_cstr(ref (deref self).main_out, ", ptr %")
                append_str(ref (deref self).main_out, p_name)
                append_cstr(ref (deref self).main_out, "_param\n  store ")
                append_str(ref (deref self).main_out, p_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, tmp_bv to cstr)
                append_cstr(ref (deref self).main_out, ", ptr %")
                append_str(ref (deref self).main_out, p_name)
                append_cstr(ref (deref self).main_out, "\n")
            else:
                append_cstr(ref (deref self).main_out, "  store ")
                append_str(ref (deref self).main_out, p_type)
                append_cstr(ref (deref self).main_out, " %")
                append_str(ref (deref self).main_out, p_name)
                append_cstr(ref (deref self).main_out, "_param, ptr %")
                append_str(ref (deref self).main_out, p_name)
                append_cstr(ref (deref self).main_out, "\n")
            p_idx = p_idx + 1 to i64

        if body != None to ptr[Node]:
            self.emit_node(body)

        if not has_return:
            append_cstr(ref (deref self).main_out, "  ret void\n")
        else:
            var t_idx as i64 = (deref self).main_out.len to i64 - 1 to i64
            let out_buf as ptr[u8] = (deref self).main_out.buffer
            while t_idx >= 0 to i64 and ((deref ((out_buf to usize + t_idx to usize) to ptr[u8])) == 10 to u8 or (deref ((out_buf to usize + t_idx to usize) to ptr[u8])) == 32 to u8):
                t_idx = t_idx - 1 to i64
            if is_main:
                append_cstr(ref (deref self).main_out, "  ret i32 0\n")
            elif t_idx >= 0 to i64 and (deref ((out_buf to usize + t_idx to usize) to ptr[u8])) == 58 to u8:
                append_cstr(ref (deref self).main_out, "  unreachable\n")
        append_cstr(ref (deref self).main_out, "}\n\n")
        (deref self).current_struct_name = saved_struct_name

    public fn emit_var_decl(self as ptr[LLVMCodegen], node as ptr[Node]):
        let name_ptr as ptr[String] = node_name_ptr(node)
        var var_type as String = type_to_llvm(node_inferred_type(node))
        let init_node as ptr[Node] = node_left(node)

        if strcmp(var_type.data to cstr, "void" to cstr) == 0 or strcmp(var_type.data to cstr, "{ ptr, ptr }" to cstr) == 0 or var_type.len == 0 to usize:
            let v_annots_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(node)
            if v_annots_ptr != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
                let v_annots as List[Option[ptr[TypeAnnotation]]] = deref v_annots_ptr
                if v_annots.length() > 0 to i64:
                    let opt as Option[ptr[TypeAnnotation]] = v_annots[0 to i64]
                    let opt_ref as ptr[OptionLayout] = (ref opt) to ptr[OptionLayout]
                    if option_has_value(opt_ref):
                        let pa as ptr[TypeAnnotation] = option_unwrap_ptr(opt_ref) to ptr[TypeAnnotation]
                        if pa != None to ptr[TypeAnnotation] and (deref pa).name.data != None:
                            if (deref pa).is_ref:
                                var_type = String.make("ptr" to cstr)
                            else:
                                let pa_name as cstr = (deref pa).name.data to cstr
                                extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
                                extern fn strlen(s as cstr) as usize
                                let pa_len as usize = strlen(pa_name)
                                if (pa_len > 1 to usize and (deref (((deref pa).name.data to usize + pa_len - 1 to usize) to ptr[u8])) == 63 to u8) or strncmp(pa_name, "Option", 6 to usize) == 0:
                                    var_type = String.make("{ i8, ptr }" to cstr)
                                elif strcmp(pa_name, "usize" to cstr) == 0 or strcmp(pa_name, "isize" to cstr) == 0 or strcmp(pa_name, "i64" to cstr) == 0 or strcmp(pa_name, "u64" to cstr) == 0:
                                    var_type = String.make("i64" to cstr)
                                elif strcmp(pa_name, "i32" to cstr) == 0 or strcmp(pa_name, "u32" to cstr) == 0 or strcmp(pa_name, "char" to cstr) == 0 or strcmp(pa_name, "color" to cstr) == 0 or strcmp(pa_name, "Color" to cstr) == 0:
                                    var_type = String.make("i32" to cstr)
                                elif strcmp(pa_name, "i16" to cstr) == 0 or strcmp(pa_name, "u16" to cstr) == 0:
                                    var_type = String.make("i16" to cstr)
                                elif strcmp(pa_name, "i8" to cstr) == 0 or strcmp(pa_name, "u8" to cstr) == 0 or strcmp(pa_name, "bool" to cstr) == 0 or strcmp(pa_name, "byte" to cstr) == 0:
                                    var_type = String.make("i8" to cstr)
                                elif strcmp(pa_name, "f64" to cstr) == 0:
                                    var_type = String.make("double" to cstr)
                                elif strcmp(pa_name, "f32" to cstr) == 0:
                                    var_type = String.make("float" to cstr)
                                elif strcmp(pa_name, "Any" to cstr) == 0:
                                    var_type = String.make("{ ptr, ptr }" to cstr)
                                elif strncmp(pa_name, "Dict" to cstr, 4 to usize) == 0 or strncmp(pa_name, "List" to cstr, 4 to usize) == 0 or strncmp(pa_name, "String" to cstr, 6 to usize) == 0:
                                    var_type = String.make("{ ptr, i64, i64 }" to cstr)
                                else:
                                    var_type = String.make(pa_name)
                                    if (deref var_type.data) != 37 to u8 and strcmp(pa_name, "ptr" to cstr) != 0 and (deref var_type.data) != 105 to u8:
                                        let s_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
                                        let _ as i32 = sprintf(s_buf, "%%%s" to cstr, pa_name)
                                        var_type = String.make(s_buf to cstr)
        if (strcmp(var_type.data to cstr, "void" to cstr) == 0 or strcmp(var_type.data to cstr, "{ ptr, ptr }" to cstr) == 0 or var_type.len == 0 to usize) and init_node != None to ptr[Node]:
            if node_kind(init_node) == NodeType.CallExpr:
                let c_node as ptr[Node] = node_left(init_node)
                if c_node != None to ptr[Node]:
                    let c_name_ptr as ptr[String] = node_name_ptr(c_node)
                    if c_name_ptr != None to ptr[String] and (deref c_name_ptr).data != None:
                        let cn as cstr = (deref c_name_ptr).data to cstr
                        if strcmp(cn, "get_size" to cstr) == 0 or strcmp(cn, "get_align" to cstr) == 0 or strcmp(cn, "strlen" to cstr) == 0 or strcmp(cn, "length" to cstr) == 0 or strcmp(cn, "len" to cstr) == 0 or strcmp(cn, "ftell" to cstr) == 0:
                            var_type = String.make("i64" to cstr)
                        elif strcmp(cn, "strcmp" to cstr) == 0 or strcmp(cn, "printf" to cstr) == 0 or strcmp(cn, "node_kind" to cstr) == 0:
                            var_type = String.make("i32" to cstr)
            elif node_kind(init_node) == NodeType.CastExpr:
                let c_op as String = node_op(init_node)
                if c_op.data != None:
                    let c_op_c as cstr = c_op.data to cstr
                    if strcmp(c_op_c, "usize" to cstr) == 0 or strcmp(c_op_c, "isize" to cstr) == 0 or strcmp(c_op_c, "i64" to cstr) == 0 or strcmp(c_op_c, "u64" to cstr) == 0:
                        var_type = String.make("i64" to cstr)
                    elif strcmp(c_op_c, "i32" to cstr) == 0 or strcmp(c_op_c, "u32" to cstr) == 0 or strcmp(c_op_c, "char" to cstr) == 0:
                        var_type = String.make("i32" to cstr)

        var var_name as String = String.make("" to cstr)
        if name_ptr != None to ptr[String]:
            var_name = deref name_ptr
        if var_name.len == 0:
            let anon as ptr[u8] = self.fresh_temp()
            var_name = String.make(anon to cstr)
            if (deref var_name.data) == 37 to u8:
                var_name.data = (var_name.data to usize + 1 to usize) to ptr[u8]
                var_name.len = var_name.len - 1

        var count as i32 = 0 to i32
        if (deref self).var_counts.has(var_name):
            count = (deref self).var_counts[var_name]
        set_dict_i32(ref (deref self).var_counts, var_name, count + 1 to i32)
        var slot_name as String = var_name
        if count > 0 to i32:
            let slot_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
            let _ as i32 = sprintf(slot_buf, "%s_%d" to cstr, var_name.data to cstr, count)
            slot_name = String.make(slot_buf to cstr)
        set_dict_str(ref (deref self).var_slots, var_name, slot_name)
        set_dict_str(ref (deref self).var_types, var_name, var_type)

        append_cstr(ref (deref self).main_out, "  %")
        append_str(ref (deref self).main_out, slot_name)
        append_cstr(ref (deref self).main_out, " = alloca ")
        append_str(ref (deref self).main_out, var_type)
        append_cstr(ref (deref self).main_out, "\n")

        if init_node != None to ptr[Node]:
            if (node_inferred_type(init_node) == None to ptr[Type] or (deref (node_inferred_type(init_node))).kind == TypeKind.Any) and node_inferred_type(node) != None to ptr[Type]:
                set_node_inferred_type(init_node, node_inferred_type(node))
            let val_reg as ptr[u8] = self.emit_expr(init_node)
            var final_reg as ptr[u8] = val_reg
            var val_type as String = type_to_llvm(node_inferred_type(init_node))
            if node_kind(init_node) == NodeType.IndexExpr and self.node_index_collection_is_dict(init_node):
                val_type = var_type
            if node_kind(init_node) == NodeType.IndexExpr and not self.node_index_collection_is_dict(init_node):
                val_type = self.index_value_llvm(init_node)
            if node_kind(init_node) == NodeType.MemberExpr:
                let mem_fn as String = node_name(init_node)
                if mem_fn.data != None to ptr[u8]:
                    let mfc as cstr = mem_fn.data to cstr
                    if strcmp(mfc, "name" to cstr) == 0 or strcmp(mfc, "source_code" to cstr) == 0 or strcmp(mfc, "file_path" to cstr) == 0 or strcmp(mfc, "current_file" to cstr) == 0:
                        val_type = String.make("{ ptr, i64, i64 }" to cstr)
                    elif strcmp(mfc, "symbols" to cstr) == 0 or strcmp(mfc, "loaded_modules" to cstr) == 0 or strcmp(mfc, "module_asts" to cstr) == 0 or strcmp(mfc, "auto_drops" to cstr) == 0 or strcmp(mfc, "symbol_states" to cstr) == 0 or strcmp(mfc, "macros" to cstr) == 0 or strcmp(mfc, "macro_args" to cstr) == 0:
                        val_type = String.make("{ ptr, i64, i64 }" to cstr)
            if node_kind(init_node) == NodeType.CallExpr:
                let c_fn as ptr[Node] = node_left(init_node)
                let c_np as ptr[String] = node_name_ptr(c_fn)
                var c_n as cstr = None to cstr
                if c_np != None to ptr[String]:
                    c_n = (deref c_np).data to cstr
                elif node_kind(c_fn) == NodeType.MemberExpr:
                    let m_nm as String = node_name(c_fn)
                    if m_nm.data != None:
                        c_n = m_nm.data to cstr
                if c_n != None to cstr:
                    extern fn strstr(haystack as cstr, needle as cstr) as cstr
                    extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
                    let inferred_cat as cstr = val_type.data to cstr
                    if (deref (inferred_cat to ptr[u8])) != 105 to u8:
                        let is_ts_byte as bool = strstr(c_n, "_byte_ptr" to cstr) != None to cstr or strstr(c_n, "_row_ptr" to cstr) != None to cstr or strstr(c_n, "_col_ptr" to cstr) != None to cstr or strstr(c_n, "_count_ptr" to cstr) != None to cstr
                        if strcmp(c_n, "ftell" to cstr) == 0 or strcmp(c_n, "strlen" to cstr) == 0 or strcmp(c_n, "length" to cstr) == 0 or strcmp(c_n, "len" to cstr) == 0 or is_ts_byte:
                            val_type = String.make("i64" to cstr)
                        elif strcmp(c_n, "node_kind" to cstr) == 0 or strcmp(c_n, "sprintf" to cstr) == 0 or strcmp(c_n, "strcmp" to cstr) == 0:
                            val_type = String.make("i32" to cstr)
                        elif strncmp(c_n, "has" to cstr, 3 to usize) == 0 or strncmp(c_n, "is" to cstr, 2 to usize) == 0 or strcmp(c_n, "ts_parser_set_language" to cstr) == 0:
                            val_type = String.make("i8" to cstr)
            if strcmp(var_type.data to cstr, "ptr" to cstr) == 0 and (strcmp(val_type.data to cstr, "i64" to cstr) == 0 or strcmp(val_type.data to cstr, "i32" to cstr) == 0) and (deref val_reg) != 37 to u8:
                let ptr_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, ptr_temp to cstr)
                append_cstr(ref (deref self).main_out, " = inttoptr ")
                append_str(ref (deref self).main_out, val_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, " to ptr\n")
                final_reg = ptr_temp
            elif strcmp(var_type.data to cstr, "i64" to cstr) == 0 and strcmp(val_type.data to cstr, "ptr" to cstr) == 0:
                let int_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, int_temp to cstr)
                append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, " to i64\n")
                final_reg = int_temp
            elif strcmp(var_type.data to cstr, "i32" to cstr) == 0 and strcmp(val_type.data to cstr, "i64" to cstr) == 0:
                let trunc_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, trunc_temp to cstr)
                append_cstr(ref (deref self).main_out, " = trunc i64 ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, " to i32\n")
                final_reg = trunc_temp
            elif strcmp(var_type.data to cstr, "i64" to cstr) == 0 and strcmp(val_type.data to cstr, "i32" to cstr) == 0:
                let zext_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, zext_temp to cstr)
                append_cstr(ref (deref self).main_out, " = zext i32 ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, " to i64\n")
                final_reg = zext_temp
            elif (deref var_type.data) == 37 to u8 and (deref val_reg) == 37 to u8 and strcmp(var_type.data to cstr, val_type.data to cstr) != 0:
                var is_struct_ctor as bool = False
                if node_kind(init_node) == NodeType.CallExpr:
                    is_struct_ctor = True
                if not is_struct_ctor:
                    let ld_st as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, ld_st to cstr)
                    append_cstr(ref (deref self).main_out, " = load ")
                    append_str(ref (deref self).main_out, var_type)
                    append_cstr(ref (deref self).main_out, ", ptr ")
                    append_cstr(ref (deref self).main_out, val_reg to cstr)
                    append_cstr(ref (deref self).main_out, "\n")
                    final_reg = ld_st
            elif strcmp(var_type.data to cstr, "{ ptr, ptr }" to cstr) == 0 and strcmp(val_type.data to cstr, "{ ptr, ptr }" to cstr) != 0:
                final_reg = self.emit_box_to_any(val_reg, val_type, init_node)
            elif (deref var_type.data) == 123 to u8 and (deref val_reg) == 37 to u8 and strcmp(var_type.data to cstr, val_type.data to cstr) != 0:
                var is_struct_ctor2 as bool = False
                if node_kind(init_node) == NodeType.CallExpr:
                    is_struct_ctor2 = True
                if not is_struct_ctor2:
                    let agg_temp as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, agg_temp to cstr)
                    append_cstr(ref (deref self).main_out, " = insertvalue ")
                    append_str(ref (deref self).main_out, var_type)
                    append_cstr(ref (deref self).main_out, " undef, ")
                    var actual_val_type as String = val_type
                    if (deref val_reg) == 37 to u8:
                        actual_val_type = String.make("ptr" to cstr)
                    append_str(ref (deref self).main_out, actual_val_type)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, val_reg to cstr)
                    append_cstr(ref (deref self).main_out, ", 0\n")
                    final_reg = agg_temp

            if strcmp(var_type.data to cstr, "i8" to cstr) == 0:
                var var_need_zext as bool = False
                if node_kind(init_node) == NodeType.BinaryExpr:
                    let v_op as String = node_op(init_node)
                    if v_op.data != None to ptr[u8]:
                        let v_op_c as cstr = v_op.data to cstr
                        if strcmp(v_op_c, "==" to cstr) == 0 or strcmp(v_op_c, "!=" to cstr) == 0 or strcmp(v_op_c, "<" to cstr) == 0 or strcmp(v_op_c, ">" to cstr) == 0 or strcmp(v_op_c, "<=" to cstr) == 0 or strcmp(v_op_c, ">=" to cstr) == 0 or strcmp(v_op_c, "and" to cstr) == 0 or strcmp(v_op_c, "or" to cstr) == 0:
                            var_need_zext = True
                elif node_kind(init_node) == NodeType.UnaryExpr:
                    let v_uop as String = node_op(init_node)
                    if v_uop.data != None to ptr[u8] and strcmp(v_uop.data to cstr, "not" to cstr) == 0:
                        var_need_zext = True
                if var_need_zext:
                    let vz_temp as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, vz_temp to cstr)
                    append_cstr(ref (deref self).main_out, " = zext i1 ")
                    append_cstr(ref (deref self).main_out, final_reg to cstr)
                    append_cstr(ref (deref self).main_out, " to i8\n")
                    final_reg = vz_temp

            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, var_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, final_reg to cstr)
            append_cstr(ref (deref self).main_out, ", ptr %")
            append_str(ref (deref self).main_out, slot_name)
            append_cstr(ref (deref self).main_out, "\n")
        else:
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, var_type)
            append_cstr(ref (deref self).main_out, " zeroinitializer, ptr %")
            append_str(ref (deref self).main_out, slot_name)
            append_cstr(ref (deref self).main_out, "\n")

    public fn emit_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        if node == None to ptr[Node]:
            return "void" to ptr[u8]
        let nt as NodeType = node_kind(node)
        if nt == NodeType.NumberLiteral:
            let val as f64 = node_val(node)
            let inf_t as ptr[Type] = node_inferred_type(node)
            var is_float as bool = node_is_float(node)
            if inf_t != None to ptr[Type]:
                let tk as TypeKind = (deref inf_t).kind
                if tk == TypeKind.F16 or tk == TypeKind.BFloat16 or tk == TypeKind.F32 or tk == TypeKind.F64 or tk == TypeKind.F128:
                    is_float = True
            if not is_float and ((deref self).current_return_type.len > 0 to usize and (strcmp((deref self).current_return_type.data to cstr, "double" to cstr) == 0 or strcmp((deref self).current_return_type.data to cstr, "float" to cstr) == 0 or strcmp((deref self).current_return_type.data to cstr, "half" to cstr) == 0 or strcmp((deref self).current_return_type.data to cstr, "bfloat" to cstr) == 0 or strcmp((deref self).current_return_type.data to cstr, "fp128" to cstr) == 0)):
                is_float = True
            let s_raw as String = node_str_val(node)
            if not is_float and s_raw.data != None to ptr[u8] and s_raw.len > 0 to usize:
                extern fn strstr(haystack as cstr, needle as cstr) as cstr
                if strstr(s_raw.data to cstr, "." to cstr) != None to cstr:
                    is_float = True
            let buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
            if is_float:
                var is_f32 as i32 = 1
                if inf_t != None to ptr[Type] and ((deref inf_t).kind == TypeKind.F64 or (deref inf_t).kind == TypeKind.F128):
                    is_f32 = 0
                elif strcmp((deref self).current_return_type.data to cstr, "double" to cstr) == 0 or strcmp((deref self).current_return_type.data to cstr, "fp128" to cstr) == 0:
                    is_f32 = 0
                extern fn format_llvm_float(val as f64, is_f32 as i32, out_buf as ptr[u8])
                format_llvm_float(val, is_f32, buf)
            else:
                let _ as i32 = sprintf(buf, "%lld" to cstr, val to i64)
            return buf
        elif nt == NodeType.Identifier:
            let id_name_ptr as ptr[String] = node_name_ptr(node)
            if id_name_ptr != None to ptr[String]:
                let name_cstr as cstr = (deref id_name_ptr).data to cstr
                if strcmp(name_cstr, "Empty" to cstr) == 0 or strcmp(name_cstr, "None" to cstr) == 0:
                    return "zeroinitializer" to ptr[u8]
                if strcmp(name_cstr, "True" to cstr) == 0 or strcmp(name_cstr, "true" to cstr) == 0:
                    return "1" to ptr[u8]
                if strcmp(name_cstr, "False" to cstr) == 0 or strcmp(name_cstr, "false" to cstr) == 0:
                    return "0" to ptr[u8]
                if strcmp(name_cstr, "UNSUPPORTED" to cstr) == 0:
                    return "0" to ptr[u8]
            var var_type as String = type_to_llvm(node_inferred_type(node))
            let id_nm_str as String = node_name(node)
            if strcmp(id_nm_str.data to cstr, "self" to cstr) == 0 and strcmp(var_type.data to cstr, "{ ptr, i64, i64 }" to cstr) != 0 and (var_type.len == 0 to usize or deref (var_type.data) != 37 to u8):
                var_type = String.make("ptr" to cstr)
            if not (deref self).var_slots.has(id_nm_str) and (deref self).enum_variant_tags.has(id_nm_str) and ((deref self).program_functions.has(id_nm_str) or (deref self).defined_functions.has(id_nm_str)):
                let reg as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, reg to cstr)
                append_cstr(ref (deref self).main_out, " = call ")
                append_str(ref (deref self).main_out, var_type)
                append_cstr(ref (deref self).main_out, " @")
                append_str(ref (deref self).main_out, id_nm_str)
                append_cstr(ref (deref self).main_out, "()\n")
                return reg
            if strcmp(var_type.data to cstr, "void" to cstr) == 0 or var_type.len == 0 to usize:
                if (deref self).var_types.has(id_nm_str):
                    let vt as String = (deref self).var_types[id_nm_str]
                    if strcmp(vt.data to cstr, "void" to cstr) != 0 and vt.len > 0 to usize:
                        var_type = vt
                    elif (deref self).var_slots.has(id_nm_str):
                        var_type = String.make("ptr" to cstr)
                    else:
                        return "0" to ptr[u8]
                elif (deref self).global_types.has(id_nm_str):
                    var_type = (deref self).global_types[id_nm_str]
                elif (deref self).var_slots.has(id_nm_str):
                    var_type = String.make("ptr" to cstr)
                else:
                    return "0" to ptr[u8]
            let reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = load ")
            append_str(ref (deref self).main_out, var_type)
            var is_global as bool = False
            var id_nm as String = String.make("" to cstr)
            if id_name_ptr != None to ptr[String]:
                id_nm = deref id_name_ptr
                if (deref self).var_slots.has(id_nm):
                    id_nm = (deref self).var_slots[id_nm]
                elif (deref self).global_vars.has(id_nm):
                    is_global = True
                if id_nm.data != None to ptr[u8] and id_nm.len > 0 to usize and deref (id_nm.data) == 64 to u8:
                    is_global = True
            if is_global:
                append_cstr(ref (deref self).main_out, ", ptr @")
                if id_nm.data != None to ptr[u8] and id_nm.len > 0 to usize and deref (id_nm.data) == 64 to u8:
                    let raw_nm as ptr[u8] = (id_nm.data to usize + 1 to usize) to ptr[u8]
                    append_cstr(ref (deref self).main_out, raw_nm to cstr)
                else:
                    append_str(ref (deref self).main_out, id_nm)
            else:
                append_cstr(ref (deref self).main_out, ", ptr %")
                append_str(ref (deref self).main_out, id_nm)
            append_cstr(ref (deref self).main_out, "\n")
            return reg
        elif nt == NodeType.BinaryExpr:
            return self.emit_binary_expr(node)
        elif nt == NodeType.CallExpr:
            return self.emit_call_expr(node)
        elif nt == NodeType.StringLiteral:
            let str_id as i32 = (deref self).string_counter
            (deref self).string_counter = (deref self).string_counter + 1 to i32
            let str_ptr as ptr[String] = node_str_val_ptr(node)
            var str_data as ptr[u8] = (deref str_ptr).data
            var str_len as i64 = (deref str_ptr).len to i64
            if (deref str_data) == 39 to u8 and str_len == 3:
                str_data = (str_data to usize + 1 to usize) to ptr[u8]
                str_len = str_len - 2
            if (deref str_data) == 34 to u8 and str_len >= 2:
                str_data = (str_data to usize + 1 to usize) to ptr[u8]
                str_len = str_len - 2

            let escaped_buf as StringBuilder = StringBuilder.make()
            let single_buf as ptr[u8] = make[u8](2 to usize) to ptr[u8]
            var raw_len as i64 = 0 to i64
            var i as i64 = 0 to i64
            while i < str_len:
                let b as u8 = str_data[i]
                if b == 92 to u8 and i < str_len - 1 to i64:
                    let nb as u8 = str_data[i + 1]
                    if nb == 110 to u8:
                        append_cstr(ref escaped_buf, "\\0A" to cstr)
                        i = i + 1 to i64
                    elif nb == 114 to u8:
                        append_cstr(ref escaped_buf, "\\0D" to cstr)
                        i = i + 1 to i64
                    elif nb == 116 to u8:
                        append_cstr(ref escaped_buf, "\\09" to cstr)
                        i = i + 1 to i64
                    elif nb == 101 to u8:
                        append_cstr(ref escaped_buf, "\\1B" to cstr)
                        i = i + 1 to i64
                    elif nb == 120 to u8 and i < str_len - 3 to i64:
                        let h1 as u8 = str_data[i + 2]
                        let h2 as u8 = str_data[i + 3]
                        var hex_val as u8 = 0 to u8
                        if h1 >= 48 to u8 and h1 <= 57 to u8:
                            hex_val = (h1 - 48 to u8) * 16 to u8
                        elif h1 >= 65 to u8 and h1 <= 70 to u8:
                            hex_val = (h1 - 55 to u8) * 16 to u8
                        elif h1 >= 97 to u8 and h1 <= 102 to u8:
                            hex_val = (h1 - 87 to u8) * 16 to u8
                            
                        if h2 >= 48 to u8 and h2 <= 57 to u8:
                            hex_val = hex_val + (h2 - 48 to u8)
                        elif h2 >= 65 to u8 and h2 <= 70 to u8:
                            hex_val = hex_val + (h2 - 55 to u8)
                        elif h2 >= 97 to u8 and h2 <= 102 to u8:
                            hex_val = hex_val + (h2 - 87 to u8)
                            
                        let hex_chars as cstr = "0123456789ABCDEF" to cstr
                        let esc_hex as ptr[u8] = make[u8](4 to usize) to ptr[u8]
                        esc_hex[0] = 92 to u8
                        esc_hex[1] = (deref ((hex_chars to usize + (hex_val / 16 to u8) to usize) to ptr[u8]))
                        esc_hex[2] = (deref ((hex_chars to usize + (hex_val % 16 to u8) to usize) to ptr[u8]))
                        esc_hex[3] = 0 to u8
                        append_cstr(ref escaped_buf, esc_hex to cstr)
                        free(esc_hex to ptr)
                        i = i + 3 to i64
                    elif nb == 34 to u8:
                        append_cstr(ref escaped_buf, "\\22" to cstr)
                        i = i + 1 to i64
                    elif nb == 92 to u8:
                        append_cstr(ref escaped_buf, "\\5C" to cstr)
                        i = i + 1 to i64
                    elif nb == 48 to u8:
                        append_cstr(ref escaped_buf, "\\00" to cstr)
                        i = i + 1 to i64
                    else:
                        append_cstr(ref escaped_buf, "\\5C" to cstr)
                elif b == 34 to u8:
                    append_cstr(ref escaped_buf, "\\22" to cstr)
                elif b == 92 to u8:
                    append_cstr(ref escaped_buf, "\\5C" to cstr)
                else:
                    single_buf[0] = b
                    single_buf[1] = 0 to u8
                    append_cstr(ref escaped_buf, single_buf to cstr)
                raw_len = raw_len + 1 to i64
                i = i + 1 to i64
            free(single_buf to ptr)

            append_cstr(ref (deref self).type_out, "@.str.")
            append_i32(ref (deref self).type_out, str_id)
            append_cstr(ref (deref self).type_out, " = private unnamed_addr constant [")
            append_i64(ref (deref self).type_out, raw_len + 1 to i64)
            append_cstr(ref (deref self).type_out, " x i8] c\"")
            if escaped_buf.buffer != None to ptr[u8]:
                append_cstr(ref (deref self).type_out, escaped_buf.buffer to cstr)
            escaped_buf.deinit()
            append_cstr(ref (deref self).type_out, "\\00\"\n" to cstr)
            let reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = getelementptr [")
            append_i64(ref (deref self).main_out, raw_len + 1 to i64)
            append_cstr(ref (deref self).main_out, " x i8], ptr @.str.")
            append_i32(ref (deref self).main_out, str_id)
            append_cstr(ref (deref self).main_out, ", i32 0, i32 0\n")
            return reg
        elif nt == NodeType.UnaryExpr: // UnaryExpr
            return self.emit_unary_expr(node)
        elif nt == NodeType.CastExpr: // CastExpr
            return self.emit_cast_expr(node)
        elif nt == NodeType.ListLiteral: // ListLiteral
            return self.emit_list_literal(node)
        elif nt == NodeType.DictLiteral: // DictLiteral
            return self.emit_dict_literal(node)
        elif nt == NodeType.ListComprehension: // ListComprehension
            return self.emit_list_comprehension(node)
        elif nt == NodeType.InterpolatedString: // InterpolatedString
            return self.emit_interpolated_string(node)
        elif nt == NodeType.SpawnStmt: // SpawnStmt
            return self.emit_spawn_stmt(node)
        elif nt == NodeType.AwaitExpr: // AwaitExpr
            return self.emit_await_expr(node)
        elif nt == NodeType.IndexExpr: // IndexExpr
            return self.emit_index_expr(node)
        elif nt == NodeType.MemberExpr: // MemberExpr
            let obj as ptr[Node] = node_left(node)
            if obj != None to ptr[Node] and node_kind(obj) == NodeType.Identifier and node_name(obj).data != None:
                let id_name as cstr = node_name(obj).data to cstr
                let variant_name as String = node_name(node)
                if variant_name.data != None:
                    let v_cstr as cstr = variant_name.data to cstr
                    if strcmp(id_name, "NodeType" to cstr) == 0 or strcmp(id_name, "TypeKind" to cstr) == 0 or strcmp(id_name, "LanguageMode" to cstr) == 0 or strcmp(id_name, "SymbolKind" to cstr) == 0 or strcmp(id_name, "LabelKind" to cstr) == 0 or strcmp(id_name, "Severity" to cstr) == 0 or strcmp(id_name, "ObjectState" to cstr) == 0 or strcmp(id_name, "Endianness" to cstr) == 0 or strcmp(id_name, "PassMode" to cstr) == 0 or strcmp(id_name, "ImportKind" to cstr) == 0:
                        return get_enum_variant_val(id_name, v_cstr)
                    let full_v_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
                    let _ as i32 = sprintf(full_v_buf, "%s.%s" to cstr, id_name, v_cstr)
                    let full_v_name as String = String.make(full_v_buf to cstr)
                    if (deref self).enum_variant_tags.has(full_v_name) and ((deref self).program_functions.has(variant_name) or (deref self).defined_functions.has(variant_name)):
                        free(full_v_buf to ptr)
                        var ret_t as String = type_to_llvm(node_inferred_type(node))
                        if ret_t.len == 0 to usize or strcmp(ret_t.data to cstr, "void" to cstr) == 0:
                            let t_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
                            let _ as i32 = sprintf(t_buf, "%%%s" to cstr, id_name)
                            ret_t = String.make(t_buf to cstr)
                            free(t_buf to ptr)
                        let reg as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, reg to cstr)
                        append_cstr(ref (deref self).main_out, " = call ")
                        append_str(ref (deref self).main_out, ret_t)
                        append_cstr(ref (deref self).main_out, " @")
                        append_str(ref (deref self).main_out, variant_name)
                        append_cstr(ref (deref self).main_out, "()\n")
                        return reg
                    free(full_v_buf to ptr)
            let obj_val as ptr[u8] = self.emit_expr(obj)
            let field_name as String = node_name(node)
            var target_st_type as String = type_to_llvm(node_inferred_type(obj))
            let is_str_or_sb as bool = strcmp(target_st_type.data to cstr, "{ ptr, i64, i64 }" to cstr) == 0 or strcmp(target_st_type.data to cstr, "%String" to cstr) == 0 or strcmp(target_st_type.data to cstr, "%StringBuilder" to cstr) == 0 or strcmp(target_st_type.data to cstr, "String" to cstr) == 0 or strcmp(target_st_type.data to cstr, "{ ptr, ptr }" to cstr) == 0
            if is_str_or_sb and field_name.data != None and (strcmp(field_name.data to cstr, "data" to cstr) == 0 or strcmp(field_name.data to cstr, "len" to cstr) == 0) and strcmp(target_st_type.data to cstr, "%Node" to cstr) != 0:
                if strcmp(target_st_type.data to cstr, "{ ptr, ptr }" to cstr) == 0 or target_st_type.len == 0 to usize:
                    target_st_type = String.make("{ ptr, i64, i64 }" to cstr)
                if strcmp(field_name.data to cstr, "data" to cstr) == 0:
                    let reg as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, reg to cstr)
                    append_cstr(ref (deref self).main_out, " = extractvalue ")
                    append_str(ref (deref self).main_out, target_st_type)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, obj_val to cstr)
                    append_cstr(ref (deref self).main_out, ", 0\n")
                    set_node_inferred_type(node, make_ptr_type(make_type(TypeKind.U8)))
                    return reg
                elif strcmp(field_name.data to cstr, "len" to cstr) == 0:
                    let reg as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, reg to cstr)
                    append_cstr(ref (deref self).main_out, " = extractvalue ")
                    append_str(ref (deref self).main_out, target_st_type)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, obj_val to cstr)
                    append_cstr(ref (deref self).main_out, ", 1\n")
                    set_node_inferred_type(node, make_type(TypeKind.I64))
                    return reg
            let field_ptr as ptr[u8] = self.emit_lvalue_ptr(node)
            var res_type as String = type_to_llvm(node_inferred_type(node))
            let inf_t as ptr[Type] = node_inferred_type(node)
            if inf_t != None to ptr[Type] and (deref inf_t).kind != TypeKind.Any and (deref inf_t).kind != TypeKind.Void and (deref inf_t).kind != TypeKind.Unknown:
                res_type = type_to_llvm(inf_t)
            elif strcmp(res_type.data to cstr, "{ ptr, ptr }" to cstr) == 0 or strcmp(res_type.data to cstr, "void" to cstr) == 0 or strcmp(res_type.data to cstr, "i64" to cstr) == 0:
                if field_name.data != None:
                    var struct_name as String = String.make("Node" to cstr)
                    if obj != None to ptr[Node]:
                        var target_t as ptr[Type] = node_inferred_type(obj)
                        if target_t != None to ptr[Type]:
                            if (deref target_t).kind == TypeKind.Struct or (deref target_t).kind == TypeKind.Class or (deref target_t).kind == TypeKind.Interface:
                                struct_name = (deref target_t).name
                            elif (deref target_t).kind == TypeKind.RawPointer and (deref target_t).payload != None to ptr[Type]:
                                let pl as ptr[Type] = (deref target_t).payload
                                if (deref pl).kind == TypeKind.Struct or (deref pl).kind == TypeKind.Class or (deref pl).kind == TypeKind.Interface:
                                    struct_name = (deref pl).name
                    if (struct_name.len == 0 to usize or strcmp(struct_name.data to cstr, "Node" to cstr) == 0):
                        if (deref self).current_struct_name.len > 0 to usize:
                            var is_self as bool = False
                            if obj != None to ptr[Node] and node_kind(obj) == NodeType.Identifier and strcmp(node_name(obj).data to cstr, "self" to cstr) == 0:
                                is_self = True
                            elif obj != None to ptr[Node] and node_kind(obj) == NodeType.UnaryExpr:
                                let in_n as ptr[Node] = node_left(obj)
                                if in_n != None to ptr[Node] and node_kind(in_n) == NodeType.Identifier and strcmp(node_name(in_n).data to cstr, "self" to cstr) == 0:
                                    is_self = True
                            if is_self:
                                struct_name = (deref self).current_struct_name
                    if (struct_name.len == 0 to usize or strcmp(struct_name.data to cstr, "Node" to cstr) == 0) and obj != None to ptr[Node] and node_kind(obj) == NodeType.UnaryExpr:
                        let inner_n as ptr[Node] = node_left(obj)
                        if inner_n != None to ptr[Node] and node_kind(inner_n) == NodeType.CastExpr:
                            struct_name = node_op(inner_n)
                            if struct_name.len > 5 to usize and (deref struct_name.data) == 112 to u8 and (deref (struct_name.data to usize + 1 to usize) to ptr[u8]) == 116 to u8 and (deref (struct_name.data to usize + 2 to usize) to ptr[u8]) == 114 to u8 and (deref (struct_name.data to usize + 3 to usize) to ptr[u8]) == 91 to u8:
                                let inner_l as usize = struct_name.len - 5 to usize
                                let inner_b as ptr[u8] = make[u8](inner_l + 1 to usize) to ptr[u8]
                                var c_i as usize = 0 to usize
                                while c_i < inner_l:
                                    inner_b[c_i] = deref ((struct_name.data to usize + 4 to usize + c_i) to ptr[u8])
                                    c_i = c_i + 1 to usize
                                inner_b[inner_l] = 0 to u8
                                struct_name = String.make(inner_b to cstr)
                    if struct_name.data != None:
                        res_type = get_struct_field_type(struct_name.data to cstr, field_name.data to cstr)
            if strcmp(res_type.data to cstr, "void" to cstr) == 0:
                return field_ptr
            let reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = load ")
            append_str(ref (deref self).main_out, res_type)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, field_ptr to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return reg
        elif nt == NodeType.IfStmt: // IfStmt used as expression (ternary)
            let cond as ptr[Node] = node_cond(node)
            let then_b as ptr[Node] = node_then_branch(node)
            let else_b_raw as Option[ptr[Node]] = node_else_branch(node)
            let else_b_ref as ptr[OptionLayout] = (ref else_b_raw) to ptr[OptionLayout]
            let ret_type as String = type_to_llvm(node_inferred_type(node))
            let cond_reg as ptr[u8] = self.emit_expr(cond)
            let cond_type as String = cond_llvm_type(cond)
            var cond_bool as ptr[u8] = cond_reg
            let is_cmp as bool = node_kind(cond) == NodeType.BinaryExpr or node_kind(cond) == NodeType.BooleanLiteral
            if strcmp(cond_type.data to cstr, "ptr" to cstr) == 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
                append_cstr(ref (deref self).main_out, cond_reg to cstr)
                append_cstr(ref (deref self).main_out, ", null\n")
                cond_bool = temp
            elif not is_cmp and strcmp(cond_type.data to cstr, "i1" to cstr) != 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ")
                append_str(ref (deref self).main_out, cond_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, cond_reg to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")
                cond_bool = temp
            let is_void as bool = strcmp(ret_type.data to cstr, "void" to cstr) == 0
            var res_alloc as ptr[u8] = "null" to ptr[u8]
            if not is_void:
                res_alloc = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, res_alloc to cstr)
                append_cstr(ref (deref self).main_out, " = alloca ")
                append_str(ref (deref self).main_out, ret_type)
                append_cstr(ref (deref self).main_out, "\n")
            let then_label as ptr[u8] = self.fresh_label()
            let else_label as ptr[u8] = self.fresh_label()
            let merge_label as ptr[u8] = self.fresh_label()
            append_cstr(ref (deref self).main_out, "  br i1 ")
            append_cstr(ref (deref self).main_out, cond_bool to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, then_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, else_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")
            append_cstr(ref (deref self).main_out, then_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            let then_val as ptr[u8] = self.emit_expr(then_b)
            if not is_void:
                append_cstr(ref (deref self).main_out, "  store ")
                append_str(ref (deref self).main_out, ret_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, then_val to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, res_alloc to cstr)
                append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, merge_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")
            append_cstr(ref (deref self).main_out, else_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            if option_has_value(else_b_ref):
                let else_val as ptr[u8] = self.emit_expr(option_unwrap_ptr(else_b_ref))
                if not is_void:
                    append_cstr(ref (deref self).main_out, "  store ")
                    append_str(ref (deref self).main_out, ret_type)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, else_val to cstr)
                    append_cstr(ref (deref self).main_out, ", ptr ")
                    append_cstr(ref (deref self).main_out, res_alloc to cstr)
                    append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, merge_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")
            append_cstr(ref (deref self).main_out, merge_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            if is_void:
                return "null" to ptr[u8]
            let reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = load ")
            append_str(ref (deref self).main_out, ret_type)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, res_alloc to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return reg
        elif nt == NodeType.TryStmt:
            return self.emit_try(node)
        elif nt == NodeType.ClosureExpr: // ClosureExpr
            return self.emit_closure_expr(node)
        elif nt == NodeType.BlockStmt:
            let decls as List[ptr[Node]] = node_declarations(node)
            let count as i64 = decls.length()
            if count == 0 to i64:
                return "void" to ptr[u8]
            var i as i64 = 0 to i64
            while i < count - 1 to i64:
                self.emit_node(decls[i])
                i = i + 1 to i64
            let last_stmt as ptr[Node] = decls[count - 1 to i64]
            if node_kind(last_stmt) == NodeType.ReturnStmt:
                return self.emit_expr(node_body(last_stmt))
            return self.emit_expr(last_stmt)
        elif nt == NodeType.BooleanLiteral: // BooleanLiteral
            if node_val(node) > 0.5:
                return "1" to ptr[u8]
            else:
                return "0" to ptr[u8]
        elif nt == NodeType.ColorLiteral:
            let val as f64 = node_val(node)
            let buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
            let _ as i32 = sprintf(buf, "%u" to cstr, (val to u64) to u32)
            return buf
        return "void" to ptr[u8]

    public fn emit_lvalue_ptr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        if node == None to ptr[Node]:
            return "null" to ptr[u8]
        let nt as NodeType = node_kind(node)
        if nt == NodeType.Identifier:
            let name_ptr as ptr[String] = node_name_ptr(node)
            let ptr_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
            if name_ptr != None to ptr[String]:
                var is_global as bool = False
                var var_nm as String = deref name_ptr
                if (deref self).var_slots.has(var_nm):
                    var_nm = (deref self).var_slots[var_nm]
                elif (deref self).global_vars.has(var_nm):
                    is_global = True
                if is_global or (var_nm.data != None to ptr[u8] and var_nm.len > 0 to usize and deref (var_nm.data) == 64 to u8):
                    if var_nm.data != None to ptr[u8] and var_nm.len > 0 to usize and deref (var_nm.data) == 64 to u8:
                        let _ as i32 = sprintf(ptr_buf, "%s" to cstr, var_nm.data to cstr)
                    else:
                        let _ as i32 = sprintf(ptr_buf, "@%s" to cstr, var_nm.data to cstr)
                else:
                    let _ as i32 = sprintf(ptr_buf, "%%%s" to cstr, var_nm.data to cstr)
            else:
                let _ as i32 = sprintf(ptr_buf, "%%tmp" to cstr)
            return ptr_buf
        elif nt == NodeType.UnaryExpr:
            let op as String = node_op(node)
            if strcmp(op.data to cstr, "deref" to cstr) == 0:
                return self.emit_expr(node_left(node))
            return self.emit_lvalue_ptr(node_left(node))
        elif nt == NodeType.CallExpr:
            let callee_node as ptr[Node] = node_left(node)
            if callee_node != None to ptr[Node] and node_kind(callee_node) == NodeType.Identifier and node_name(callee_node).data != None:
                if strcmp(node_name(callee_node).data to cstr, "deref" to cstr) == 0:
                    let args_list as List[ptr[Node]] = node_params(node)
                    if args_list.length() > 0 to i64:
                        return self.emit_lvalue_ptr(get_node_decl(ref args_list, 0 to i64))
            return self.emit_expr(node)
        elif nt == NodeType.MemberExpr:
            let obj as ptr[Node] = node_left(node)
            let obj_ptr as ptr[u8] = self.emit_lvalue_ptr(obj)
            let field_name as String = node_name(node)
            var struct_name as String = String.make("" to cstr)
            var target_type as ptr[Type] = node_inferred_type(obj)
            if target_type == None to ptr[Type] and node_kind(obj) == NodeType.UnaryExpr:
                let inner_n as ptr[Node] = node_left(obj)
                if inner_n != None to ptr[Node]:
                    target_type = node_inferred_type(inner_n)
            if target_type != None to ptr[Type]:
                if (deref target_type).kind == TypeKind.Struct or (deref target_type).kind == TypeKind.Class or (deref target_type).kind == TypeKind.Interface:
                    struct_name = (deref target_type).name
                elif (deref target_type).kind == TypeKind.RawPointer and (deref target_type).payload != None to ptr[Type]:
                    let pl as ptr[Type] = (deref target_type).payload
                    if (deref pl).kind == TypeKind.Struct or (deref pl).kind == TypeKind.Class or (deref pl).kind == TypeKind.Interface:
                        struct_name = (deref pl).name
            if (struct_name.len == 0 to usize or strcmp(struct_name.data to cstr, "Node" to cstr) == 0):
                if (deref self).current_struct_name.len > 0 to usize:
                    var is_self as bool = False
                    if obj != None to ptr[Node] and node_kind(obj) == NodeType.Identifier and strcmp(node_name(obj).data to cstr, "self" to cstr) == 0:
                        is_self = True
                    elif obj != None to ptr[Node] and node_kind(obj) == NodeType.UnaryExpr:
                        let in_n as ptr[Node] = node_left(obj)
                        if in_n != None to ptr[Node] and node_kind(in_n) == NodeType.Identifier and strcmp(node_name(in_n).data to cstr, "self" to cstr) == 0:
                            is_self = True
                    if is_self:
                        struct_name = (deref self).current_struct_name
            if struct_name.len == 0 to usize and node_kind(obj) == NodeType.UnaryExpr:
                let inner_n as ptr[Node] = node_left(obj)
                if inner_n != None to ptr[Node]:
                    if node_kind(inner_n) == NodeType.CastExpr:
                        struct_name = node_op(inner_n)
                    elif node_kind(inner_n) == NodeType.Identifier and node_name(inner_n).data != None:
                        let id_n as cstr = node_name(inner_n).data to cstr
                        if strcmp(id_n, "lowerer" to cstr) == 0:
                            struct_name = String.make("Lowerer" to cstr)
                        elif strcmp(id_n, "sema" to cstr) == 0:
                            struct_name = String.make("Sema" to cstr)
                        elif strcmp(id_n, "tc" to cstr) == 0:
                            struct_name = String.make("TypeChecker" to cstr)
                        elif strcmp(id_n, "bc" to cstr) == 0:
                            struct_name = String.make("BorrowChecker" to cstr)
                        elif strcmp(id_n, "cg" to cstr) == 0:
                            struct_name = String.make("LLVMCodegen" to cstr)
            if struct_name.len == 0 to usize:
                if field_name.data != None to ptr[u8]:
                    let fn_c as cstr = field_name.data to cstr
                    if strcmp(fn_c, "data" to cstr) == 0 or strcmp(fn_c, "len" to cstr) == 0 or strcmp(fn_c, "capacity" to cstr) == 0:
                        struct_name = String.make("String" to cstr)
                    else:
                        struct_name = String.make("Node" to cstr)
                else:
                    struct_name = String.make("Node" to cstr)
            if struct_name.len > 5 to usize and (deref struct_name.data) == 112 to u8 and (deref (struct_name.data to usize + 1 to usize) to ptr[u8]) == 116 to u8 and (deref (struct_name.data to usize + 2 to usize) to ptr[u8]) == 114 to u8 and (deref (struct_name.data to usize + 3 to usize) to ptr[u8]) == 91 to u8:
                let inner_l as usize = struct_name.len - 5 to usize
                let inner_b as ptr[u8] = make[u8](inner_l + 1 to usize) to ptr[u8]
                var c_i as usize = 0 to usize
                while c_i < inner_l:
                    inner_b[c_i] = deref ((struct_name.data to usize + 4 to usize + c_i) to ptr[u8])
                    c_i = c_i + 1 to usize
                inner_b[inner_l] = 0 to u8
                struct_name = String.make(inner_b to cstr)
            if struct_name.data != None to ptr[u8]:
                let s_c as cstr = struct_name.data to cstr
                extern fn strchr(s as cstr, c as i32) as cstr
                let b_ptr as cstr = strchr(s_c, '[' to i32)
                if b_ptr != None to cstr:
                    let b_len as usize = (b_ptr to usize) - (s_c to usize)
                    if b_len > 0 to usize:
                        extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
                        let b_buf as ptr[u8] = make[u8](b_len + 1 to usize) to ptr[u8]
                        let _m as ptr = memcpy(b_buf to ptr, s_c to ptr, b_len)
                        b_buf[b_len] = 0 to u8
                        struct_name = String.make(b_buf to cstr)
            var field_idx as i32 = 0 to i32
            if field_name.data != None to ptr[u8] and struct_name.data != None to ptr[u8]:
                var s_cstr as cstr = struct_name.data to cstr
                if (deref (s_cstr to ptr[u8])) == 37 to u8:
                    s_cstr = (s_cstr to usize + 1 to usize) to cstr
                let f_cstr as cstr = field_name.data to cstr
                if strcmp(s_cstr, "Lowerer" to cstr) == 0:
                    if strcmp(f_cstr, "source_code" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "mode" to cstr) == 0:
                        field_idx = 1 to i32
                    elif strcmp(f_cstr, "file_path" to cstr) == 0:
                        field_idx = 2 to i32
                    elif strcmp(f_cstr, "macros" to cstr) == 0:
                        field_idx = 3 to i32
                    elif strcmp(f_cstr, "macro_args" to cstr) == 0:
                        field_idx = 4 to i32
                    elif strcmp(f_cstr, "next_hygiene_id" to cstr) == 0:
                        field_idx = 5 to i32
                elif strcmp(s_cstr, "Sema" to cstr) == 0:
                    if strcmp(f_cstr, "current_scope" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "global_scope" to cstr) == 0:
                        field_idx = 1 to i32
                    elif strcmp(f_cstr, "loaded_modules" to cstr) == 0:
                        field_idx = 2 to i32
                    elif strcmp(f_cstr, "module_asts" to cstr) == 0:
                        field_idx = 3 to i32
                    elif strcmp(f_cstr, "fn_scopes" to cstr) == 0:
                        field_idx = 4 to i32
                    elif strcmp(f_cstr, "errors" to cstr) == 0:
                        field_idx = 5 to i32
                    elif strcmp(f_cstr, "current_file" to cstr) == 0:
                        field_idx = 6 to i32
                    elif strcmp(f_cstr, "mode" to cstr) == 0:
                        field_idx = 7 to i32
                    elif strcmp(f_cstr, "root_ast" to cstr) == 0:
                        field_idx = 8 to i32
                    elif strcmp(f_cstr, "engine" to cstr) == 0:
                        field_idx = 9 to i32
                    elif strcmp(f_cstr, "link_targets" to cstr) == 0:
                        field_idx = 10 to i32
                elif strcmp(s_cstr, "TypeChecker" to cstr) == 0:
                    if strcmp(f_cstr, "sema" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "current_function_return" to cstr) == 0:
                        field_idx = 1 to i32
                    elif strcmp(f_cstr, "inferred_return_type" to cstr) == 0:
                        field_idx = 2 to i32
                    elif strcmp(f_cstr, "current_struct_type" to cstr) == 0:
                        field_idx = 3 to i32
                elif strcmp(s_cstr, "BorrowChecker" to cstr) == 0:
                    if strcmp(f_cstr, "errors" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "current_file" to cstr) == 0:
                        field_idx = 1 to i32
                    elif strcmp(f_cstr, "symbol_states" to cstr) == 0:
                        field_idx = 2 to i32
                    elif strcmp(f_cstr, "auto_drops" to cstr) == 0:
                        field_idx = 3 to i32
                    elif strcmp(f_cstr, "scopes" to cstr) == 0:
                        field_idx = 4 to i32
                    elif strcmp(f_cstr, "sema" to cstr) == 0:
                        field_idx = 5 to i32
                    elif strcmp(f_cstr, "scope_depth" to cstr) == 0:
                        field_idx = 6 to i32
                    elif strcmp(f_cstr, "active_borrows" to cstr) == 0:
                        field_idx = 7 to i32
                    elif strcmp(f_cstr, "var_decl_depth" to cstr) == 0:
                        field_idx = 8 to i32
                    elif strcmp(f_cstr, "var_source_map" to cstr) == 0:
                        field_idx = 9 to i32
                    elif strcmp(f_cstr, "var_last_use" to cstr) == 0:
                        field_idx = 10 to i32
                    elif strcmp(f_cstr, "current_row" to cstr) == 0:
                        field_idx = 11 to i32
                elif strcmp(s_cstr, "BorrowRecord" to cstr) == 0:
                    if strcmp(f_cstr, "borrower_name" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "source_name" to cstr) == 0:
                        field_idx = 1 to i32
                    elif strcmp(f_cstr, "lifetime" to cstr) == 0:
                        field_idx = 2 to i32
                    elif strcmp(f_cstr, "is_mut" to cstr) == 0:
                        field_idx = 3 to i32
                    elif strcmp(f_cstr, "borrow_span" to cstr) == 0:
                        field_idx = 4 to i32
                    elif strcmp(f_cstr, "last_use_row" to cstr) == 0:
                        field_idx = 5 to i32
                    elif strcmp(f_cstr, "is_active" to cstr) == 0:
                        field_idx = 6 to i32
                elif strcmp(s_cstr, "VarInfo" to cstr) == 0:
                    if strcmp(f_cstr, "state" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "var_type" to cstr) == 0:
                        field_idx = 1 to i32
                elif strcmp(s_cstr, "MacroDef" to cstr) == 0:
                    if strcmp(f_cstr, "param_names" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "body_ast" to cstr) == 0:
                        field_idx = 1 to i32
                elif strcmp(s_cstr, "ProgramData" to cstr) == 0:
                    if strcmp(f_cstr, "declarations" to cstr) == 0:
                        field_idx = 0 to i32
                elif strcmp(s_cstr, "Label" to cstr) == 0:
                    if strcmp(f_cstr, "span" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "message" to cstr) == 0:
                        field_idx = 1 to i32
                    elif strcmp(f_cstr, "kind" to cstr) == 0:
                        field_idx = 2 to i32
                elif strcmp(s_cstr, "Suggestion" to cstr) == 0:
                    if strcmp(f_cstr, "span" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "replacement" to cstr) == 0:
                        field_idx = 1 to i32
                    elif strcmp(f_cstr, "message" to cstr) == 0:
                        field_idx = 2 to i32
                elif strcmp(s_cstr, "Diagnostic" to cstr) == 0:
                    if strcmp(f_cstr, "severity" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "code" to cstr) == 0:
                        field_idx = 1 to i32
                    elif strcmp(f_cstr, "message" to cstr) == 0:
                        field_idx = 2 to i32
                    elif strcmp(f_cstr, "file_path" to cstr) == 0:
                        field_idx = 3 to i32
                    elif strcmp(f_cstr, "primary_span" to cstr) == 0:
                        field_idx = 4 to i32
                    elif strcmp(f_cstr, "labels" to cstr) == 0:
                        field_idx = 5 to i32
                    elif strcmp(f_cstr, "friendly_explanation" to cstr) == 0:
                        field_idx = 6 to i32
                    elif strcmp(f_cstr, "help_hints" to cstr) == 0:
                        field_idx = 7 to i32
                    elif strcmp(f_cstr, "notes" to cstr) == 0:
                        field_idx = 8 to i32
                    elif strcmp(f_cstr, "suggestions" to cstr) == 0:
                        field_idx = 9 to i32
