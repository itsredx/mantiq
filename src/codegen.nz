        self.register_builtin_struct("AwaitExprData", "{ ptr }")
        self.register_builtin_struct("SpawnStmtData", "{ ptr }")
        self.register_builtin_struct("ClosureExprData", "{ { ptr, i64, i64 }, ptr, ptr }")
        self.register_builtin_struct("StructDeclData", "{ { ptr, i64, i64 }, ptr, { ptr, i64, i64 } }")
        self.register_builtin_struct("EnumDeclData", "{ { ptr, i64, i64 }, { ptr, i64, i64 } }")
        self.register_builtin_struct("UnionDeclData", "{ { ptr, i64, i64 }, ptr }")
        self.register_builtin_struct("FieldDeclData", "{ { ptr, i64, i64 }, ptr }")
        self.register_builtin_struct("ColorLiteralData", "{ double, i8, i8, i8, i8 }")
        self.register_builtin_struct("ListComprehensionData", "{ { ptr, i64, i64 }, ptr, ptr, ptr, ptr }")
        self.register_builtin_struct("InterpolatedStringData", "{ { ptr, i64, i64 } }")
        self.register_builtin_struct("Span", "{ i32, i32, i32, i32, i32, i32 }")
        self.register_builtin_struct("Label", "{ %Span, { ptr, i64, i64 }, i32 }")
        self.register_builtin_struct("Suggestion", "{ %Span, { ptr, i64, i64 }, { ptr, i64, i64 } }")
        self.register_builtin_struct("Diagnostic", "{ i32, { i8, ptr }, { ptr, i64, i64 }, { ptr, i64, i64 }, %Span, { ptr, i64, i64 }, { i8, ptr }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 } }")
        self.register_builtin_struct("DiagnosticEngine", "{ { ptr, i64, i64 }, i32, i32, i32, i8, { ptr, i64, i64 } }")
        self.register_builtin_struct("Set", "{ { ptr, i64, i64 } }")
        self.register_builtin_struct("StringBuilder", "{ ptr, i64, i64 }")
        self.register_builtin_struct("Type", "{ i32, ptr, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, ptr }")
        self.register_builtin_struct("Symbol", "{ { ptr, i64, i64 }, i32, ptr, { i8, ptr }, i8, ptr }")
        self.register_builtin_struct("Scope", "{ ptr, { ptr, i64, i64 }, ptr }")
        self.register_builtin_struct("TypeAnnotation", "{ { ptr, i64, i64 }, i8, i8, { i8, ptr }, { i8, ptr }, { i8, ptr }, ptr }")
        self.register_builtin_struct("TSNode", "{ i32, i32, i32, i32, ptr, ptr }")

        self.register_field_idx("Node" to cstr, "kind" to cstr, 0 to i32)
        self.register_field_idx("Node" to cstr, "span" to cstr, 1 to i32)
