                    append_cstr(ref (deref self).main_out, z_arg to cstr)
                    append_cstr(ref (deref self).main_out, " = zext i1 ")
                    append_cstr(ref (deref self).main_out, arg_val to cstr)
                    append_cstr(ref (deref self).main_out, " to i8\n")
                    arg_val = z_arg

            var fn_len_name as cstr = None to cstr
            if callee_name_ptr != None to ptr[String] and (deref callee_name_ptr).data != None:
                fn_len_name = (deref callee_name_ptr).data to cstr
            elif node_kind(callee) == NodeType.MemberExpr:
                let fn_m_nm as String = node_name(callee)
                if fn_m_nm.data != None:
                    fn_len_name = fn_m_nm.data to cstr
            if fn_len_name != None to cstr and (strcmp(fn_len_name, "length" to cstr) == 0 or strcmp(fn_len_name, "len" to cstr) == 0 or strcmp(fn_len_name, "ftell" to cstr) == 0 or strcmp(fn_len_name, "strlen" to cstr) == 0):
                let arg_inf as String = type_to_llvm(node_inferred_type(arg_node))
                if strcmp(arg_inf.data to cstr, "{ ptr, i64, i64 }") == 0 and (deref arg_val) == 37 to u8:
                    var rec_ptr as ptr[u8] = arg_val
                    if node_kind(arg_node) == NodeType.Identifier:
                        let l_arg as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, l_arg to cstr)
                        append_cstr(ref (deref self).main_out, " = load { ptr, i64, i64 }, ptr ")
                        append_cstr(ref (deref self).main_out, arg_val to cstr)
                        append_cstr(ref (deref self).main_out, "\n")
                        rec_ptr = l_arg
                    let d_arg as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, d_arg to cstr)
                    append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
                    append_cstr(ref (deref self).main_out, rec_ptr to cstr)
                    append_cstr(ref (deref self).main_out, ", 0\n")
                    arg_val = d_arg
            var expected_p_type as String = String.make("" to cstr)
            if callee_name_ptr != None to ptr[String] and (deref callee_name_ptr).data != None:
                let p_lookup as StringBuilder = StringBuilder.make()
                append_str(ref p_lookup, deref callee_name_ptr)
                append_cstr(ref p_lookup, "#" to cstr)
                let p_buf as ptr[u8] = make[u8](32 to usize) to ptr[u8]
                let _ as i32 = sprintf(p_buf, "%lld" to cstr, a_idx)
                append_cstr(ref p_lookup, p_buf to cstr)
                free(p_buf to ptr)
                let p_key_s as String = p_lookup.to_string()
                p_lookup.deinit()
                if (deref self).type_aliases.has(p_key_s):
                    expected_p_type = (deref self).type_aliases[p_key_s]

            if strcmp(expected_p_type.data to cstr, "{ ptr, ptr }" to cstr) == 0 and strcmp(arg_type.data to cstr, "{ ptr, ptr }" to cstr) != 0:
                arg_val = self.emit_box_to_any(arg_val, arg_type, arg_node)
                arg_type = String.make("{ ptr, ptr }" to cstr)

            if is_struct_byval(arg_type):
                let t_spill as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, t_spill to cstr)
                append_cstr(ref (deref self).main_out, " = alloca ")
                append_str(ref (deref self).main_out, arg_type)
                append_cstr(ref (deref self).main_out, "\n  store ")
                append_str(ref (deref self).main_out, arg_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, arg_val to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, t_spill to cstr)
                append_cstr(ref (deref self).main_out, "\n")
                append_cstr(ref arg_buf, "ptr ")
                append_cstr(ref arg_buf, t_spill to cstr)
            else:
                append_str(ref arg_buf, arg_type)
                append_cstr(ref arg_buf, " ")
                append_cstr(ref arg_buf, arg_val to cstr)
            if a_idx < a_count - 1 to i64:
                append_cstr(ref arg_buf, ", ")
            a_idx = a_idx + 1 to i64

        var fn_target_name as String = String.make("" to cstr)
        if callee_name_ptr != None to ptr[String]:
            fn_target_name = deref callee_name_ptr
            if fn_target_name.len > 0 to usize:
                let bp2 as cstr = strchr(fn_target_name.data to cstr, '[' to i32)
                if bp2 != None to cstr:
                    let base_len2 as usize = (bp2 to usize) - (fn_target_name.data to usize)
                    if base_len2 > 0 to usize:
                        let buf2 as ptr[u8] = make[u8](base_len2 + 1 to usize) to ptr[u8]
                        let _m2 as ptr = memcpy(buf2 to ptr, fn_target_name.data to ptr, base_len2)
                        buf2[base_len2] = 0 to u8
                        fn_target_name = String.make(buf2 to cstr)
                        free(buf2 to ptr)

        if node_kind(callee) == NodeType.MemberExpr:
            let method_name as String = node_name(callee)
            let obj_node as ptr[Node] = node_left(callee)
            var s_nm as String = String.make("" to cstr)
            if obj_node != None to ptr[Node]:
                let obj_t as ptr[Type] = node_inferred_type(obj_node)
                if obj_t != None to ptr[Type]:
                    if (deref obj_t).kind == TypeKind.Struct or (deref obj_t).kind == TypeKind.Class or (deref obj_t).kind == TypeKind.Interface or (deref obj_t).kind == TypeKind.Enum or (deref obj_t).kind == TypeKind.Union:
                        s_nm = (deref obj_t).name
                    elif (deref obj_t).kind == TypeKind.String:
                        s_nm = String.make("String" to cstr)
                    elif (deref obj_t).kind == TypeKind.List:
                        s_nm = String.make("List" to cstr)
                    elif (deref obj_t).kind == TypeKind.Dict:
                        s_nm = String.make("Dict" to cstr)
                    elif (deref obj_t).kind == TypeKind.RawPointer and (deref obj_t).payload != None to ptr[Type]:
                        let pl as ptr[Type] = (deref obj_t).payload
                        if (deref pl).kind == TypeKind.Struct or (deref pl).kind == TypeKind.Class or (deref pl).kind == TypeKind.Interface or (deref pl).kind == TypeKind.Enum or (deref pl).kind == TypeKind.Union:
                            s_nm = (deref pl).name
                        elif (deref pl).kind == TypeKind.String:
                            s_nm = String.make("String" to cstr)
                        elif (deref pl).kind == TypeKind.List:
                            s_nm = String.make("List" to cstr)
                        elif (deref pl).kind == TypeKind.Dict:
                            s_nm = String.make("Dict" to cstr)
                if s_nm.len == 0 to usize:
                    var target_id_node as ptr[Node] = obj_node
                    while target_id_node != None to ptr[Node] and (node_kind(target_id_node) == NodeType.UnaryExpr or node_kind(target_id_node) == NodeType.CallExpr):
                        let next_n as ptr[Node] = node_left(target_id_node)
                        if node_kind(target_id_node) == NodeType.CallExpr:
                            let args_l as List[ptr[Node]] = node_params(target_id_node)
                            if args_l.length() > 0 to i64:
                                target_id_node = get_node_decl(ref args_l, 0 to i64)
                            else:
                                target_id_node = next_n
                        else:
                            target_id_node = next_n
                    if node_kind(target_id_node) == NodeType.Identifier:
                        let o_name as String = node_name(target_id_node)
                        if strcmp(o_name.data to cstr, "sema" to cstr) == 0:
                            s_nm = String.make("Sema" to cstr)
                        elif strcmp(o_name.data to cstr, "tc" to cstr) == 0:
                            s_nm = String.make("TypeChecker" to cstr)
                        elif strcmp(o_name.data to cstr, "bc" to cstr) == 0:
                            s_nm = String.make("BorrowChecker" to cstr)
                        elif strcmp(o_name.data to cstr, "cg" to cstr) == 0:
                            s_nm = String.make("LLVMCodegen" to cstr)
                        elif strcmp(o_name.data to cstr, "lowerer" to cstr) == 0:
                            s_nm = String.make("Lowerer" to cstr)
                        elif strcmp(o_name.data to cstr, "self" to cstr) == 0:
                            if (deref self).current_struct_name.len > 0 to usize:
                                s_nm = (deref self).current_struct_name
                            else:
                                s_nm = String.make("DiagnosticEngine" to cstr)
                        elif o_name.data != None:
                            let fc as u8 = deref (o_name.data to ptr[u8])
                            if fc >= 65 to u8 and fc <= 90 to u8:
                                s_nm = o_name

                if s_nm.len == 0 to usize and node_kind(obj_node) == NodeType.MemberExpr:
                    let f_nm as String = node_name(obj_node)
                    if f_nm.data != None:
                        let fn_cstr as cstr = f_nm.data to cstr
                        if strcmp(fn_cstr, "main_out" to cstr) == 0 or strcmp(fn_cstr, "type_out" to cstr) == 0 or strcmp(fn_cstr, "outlined_out" to cstr) == 0 or strcmp(fn_cstr, "metadata_out" to cstr) == 0 or strcmp(fn_cstr, "sb" to cstr) == 0 or strcmp(fn_cstr, "buf" to cstr) == 0 or strcmp(fn_cstr, "buffer" to cstr) == 0 or strcmp(fn_cstr, "builder" to cstr) == 0:
                            s_nm = String.make("StringBuilder" to cstr)

                if s_nm.len == 0 to usize and method_name.data != None:
                    let m_cstr as cstr = method_name.data to cstr
                    if strcmp(m_cstr, "to_string" to cstr) == 0 or strcmp(m_cstr, "builder_to_string" to cstr) == 0 or strcmp(m_cstr, "append_str" to cstr) == 0 or strcmp(m_cstr, "append_cstr" to cstr) == 0 or strcmp(m_cstr, "append_builder" to cstr) == 0 or strcmp(m_cstr, "deinit_builder" to cstr) == 0:
                        s_nm = String.make("StringBuilder" to cstr)

                // Strip generic params from type name for LLVM symbol name compatibility
                if s_nm.len > 0 to usize:
                    let bp as cstr = strchr(s_nm.data to cstr, '[' to i32)
                    if bp != None to cstr:
                        let base_len as usize = (bp to usize) - (s_nm.data to usize)
                        if base_len > 0 to usize:
                            let buf as ptr[u8] = make[u8](base_len + 1 to usize) to ptr[u8]
                            let _m as ptr = memcpy(buf to ptr, s_nm.data to ptr, base_len)
                            buf[base_len] = 0 to u8
                            s_nm = String.make(buf to cstr)
                            free(buf to ptr)

            if s_nm.len > 0 to usize:
                let fn_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
                let _ as i32 = sprintf(fn_buf, "%s_%s" to cstr, s_nm.data to cstr, method_name.data to cstr)
                fn_target_name = String.make(fn_buf to cstr)
                free(fn_buf to ptr)

            if method_name.data != None to ptr[u8]:
                let m_cstr as cstr = method_name.data to cstr
                if strcmp(m_cstr, "add" to cstr) == 0 or strcmp(m_cstr, "clear" to cstr) == 0 or strcmp(m_cstr, "push" to cstr) == 0 or strcmp(m_cstr, "append" to cstr) == 0 or strcmp(m_cstr, "insert" to cstr) == 0 or strcmp(m_cstr, "deinit" to cstr) == 0 or strcmp(m_cstr, "deinit_builder" to cstr) == 0 or strcmp(m_cstr, "append_builder" to cstr) == 0 or strcmp(m_cstr, "append_str" to cstr) == 0 or strcmp(m_cstr, "append_cstr" to cstr) == 0:
                    ret_type = String.make("void" to cstr)
                elif strcmp(m_cstr, "to_string" to cstr) == 0 or strcmp(m_cstr, "builder_to_string" to cstr) == 0:
                    ret_type = String.make("{ ptr, i64, i64 }" to cstr)

        if fn_target_name.len > 0 to usize and node_kind(callee) != NodeType.MemberExpr and not (deref self).external_decls.has(fn_target_name) and not (deref self).defined_functions.has(fn_target_name) and not (deref self).program_functions.has(fn_target_name):
            set_dict_bool(ref (deref self).external_decls, fn_target_name, True)
            append_cstr(ref (deref self).type_out, "declare ")
            append_str(ref (deref self).type_out, ret_type)
            append_cstr(ref (deref self).type_out, " @")
            append_str(ref (deref self).type_out, fn_target_name)
            append_cstr(ref (deref self).type_out, "(...)\n")

        let is_void as bool = str_eq(ret_type, String.make("void" to cstr))
        if not is_void:
            let reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = call ")
            append_str(ref (deref self).main_out, ret_type)
            append_cstr(ref (deref self).main_out, " @")
            append_str(ref (deref self).main_out, fn_target_name)
            append_cstr(ref (deref self).main_out, "(")
            if arg_buf.buffer != None to ptr[u8]:
                append_cstr(ref (deref self).main_out, arg_buf.buffer to cstr)
            arg_buf.deinit()
            append_cstr(ref (deref self).main_out, ")\n")
            return reg
        else:
            append_cstr(ref (deref self).main_out, "  call ")
            append_str(ref (deref self).main_out, ret_type)
            append_cstr(ref (deref self).main_out, " @")
            append_str(ref (deref self).main_out, fn_target_name)
            append_cstr(ref (deref self).main_out, "(")
            if arg_buf.buffer != None to ptr[u8]:
                append_cstr(ref (deref self).main_out, arg_buf.buffer to cstr)
            arg_buf.deinit()
            append_cstr(ref (deref self).main_out, ")\n")
            return "0" to ptr[u8]

    public fn emit_collection_method(self as ptr[LLVMCodegen], node as ptr[Node], obj_node as ptr[Node], mname as cstr) as ptr[u8]:
        let obj_t as ptr[Type] = node_inferred_type(obj_node)
        var is_list as bool = False
        var is_dict as bool = False
        var is_str as bool = False
        var is_channel as bool = False
        if obj_t != None to ptr[Type]:
            let ok as TypeKind = (deref obj_t).kind
            if ok == TypeKind.List:
                is_list = True
            elif ok == TypeKind.Dict:
                is_dict = True
            elif ok == TypeKind.String:
                is_str = True
            elif ok == TypeKind.Channel:
                is_channel = True
            elif ok == TypeKind.RawPointer and (deref obj_t).payload != None to ptr[Type]:
                let pl as ptr[Type] = (deref obj_t).payload
                let pk as TypeKind = (deref pl).kind
                if pk == TypeKind.List:
                    is_list = True
                elif pk == TypeKind.Dict:
                    is_dict = True
                elif pk == TypeKind.String:
                    is_str = True
                elif pk == TypeKind.Channel:
                    is_channel = True
        if not is_list and not is_dict and not is_str and not is_channel:
            if obj_t != None to ptr[Type]:
                let obj_ll as String = type_to_llvm(obj_t)
                if strcmp(obj_ll.data to cstr, "{ ptr, i64, i64 }" to cstr) == 0:
                    is_list = True
            if not is_list:
                if strcmp(mname, "has" to cstr) == 0 or strcmp(mname, "remove" to cstr) == 0:
                    is_dict = True
                elif strcmp(mname, "send" to cstr) == 0 or strcmp(mname, "recv" to cstr) == 0 or strcmp(mname, "try_send" to cstr) == 0 or strcmp(mname, "try_recv" to cstr) == 0 or strcmp(mname, "is_closed" to cstr) == 0 or strcmp(mname, "capacity" to cstr) == 0 or strcmp(mname, "cap" to cstr) == 0:
                    is_channel = True
                elif strcmp(mname, "length" to cstr) == 0 or strcmp(mname, "len" to cstr) == 0 or strcmp(mname, "append" to cstr) == 0 or strcmp(mname, "clear" to cstr) == 0 or strcmp(mname, "get" to cstr) == 0 or strcmp(mname, "is_some" to cstr) == 0 or strcmp(mname, "is_none" to cstr) == 0 or strcmp(mname, "unwrap" to cstr) == 0:
                    is_list = True
                else:
                    return None to ptr[u8]

        if is_channel:
            let chan_val as ptr[u8] = self.emit_expr(obj_node)
            var elem_llvm as String = String.make("i64" to cstr)
            if obj_t != None to ptr[Type] and (deref obj_t).payload != None to ptr[Type]:
                let pld as ptr[Type] = (deref obj_t).payload
                elem_llvm = type_to_llvm(pld)
            elif obj_t != None to ptr[Type] and (deref obj_t).kind == TypeKind.RawPointer and (deref obj_t).payload != None to ptr[Type] and (deref (deref obj_t).payload).payload != None to ptr[Type]:
                let pld as ptr[Type] = (deref (deref obj_t).payload).payload
                elem_llvm = type_to_llvm(pld)

            if strcmp(mname, "send" to cstr) == 0:
                let args as List[ptr[Node]] = node_params(node)
                if args.length() > 0 to i64:
                    let arg_node as ptr[Node] = get_node_decl(ref args, 0 to i64)
                    let arg_val as ptr[u8] = self.emit_expr(arg_node)
                    let arg_t as ptr[Type] = node_inferred_type(arg_node)
                    var arg_llvm as String = elem_llvm
                    if arg_t != None to ptr[Type]:
                        arg_llvm = type_to_llvm(arg_t)
                    let slot_alloc as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, slot_alloc to cstr)
                    append_cstr(ref (deref self).main_out, " = alloca ")
                    append_str(ref (deref self).main_out, arg_llvm)
                    append_cstr(ref (deref self).main_out, "\n")
                    append_cstr(ref (deref self).main_out, "  store ")
                    append_str(ref (deref self).main_out, arg_llvm)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, arg_val to cstr)
                    append_cstr(ref (deref self).main_out, ", ptr ")
                    append_cstr(ref (deref self).main_out, slot_alloc to cstr)
                    append_cstr(ref (deref self).main_out, "\n")
                    append_cstr(ref (deref self).main_out, "  call void @__mantiq_channel_send(ptr ")
                    append_cstr(ref (deref self).main_out, chan_val to cstr)
                    append_cstr(ref (deref self).main_out, ", ptr ")
                    append_cstr(ref (deref self).main_out, slot_alloc to cstr)
                    append_cstr(ref (deref self).main_out, ", i64 8)\n")
                return "0" to ptr[u8]

            if strcmp(mname, "recv" to cstr) == 0:
                let ret_ptr as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, ret_ptr to cstr)
                append_cstr(ref (deref self).main_out, " = call ptr @__mantiq_channel_recv(ptr ")
                append_cstr(ref (deref self).main_out, chan_val to cstr)
                append_cstr(ref (deref self).main_out, ", i64 8)\n")
                let loaded as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, loaded to cstr)
                append_cstr(ref (deref self).main_out, " = load ")
                append_str(ref (deref self).main_out, elem_llvm)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, ret_ptr to cstr)
                append_cstr(ref (deref self).main_out, "\n")
                return loaded

            if strcmp(mname, "try_send" to cstr) == 0:
                let args as List[ptr[Node]] = node_params(node)
                if args.length() > 0 to i64:
                    let arg_node as ptr[Node] = get_node_decl(ref args, 0 to i64)
                    let arg_val as ptr[u8] = self.emit_expr(arg_node)
                    let arg_t as ptr[Type] = node_inferred_type(arg_node)
                    var arg_llvm as String = elem_llvm
                    if arg_t != None to ptr[Type]:
                        arg_llvm = type_to_llvm(arg_t)
                    let slot_alloc as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, slot_alloc to cstr)
                    append_cstr(ref (deref self).main_out, " = alloca ")
                    append_str(ref (deref self).main_out, arg_llvm)
                    append_cstr(ref (deref self).main_out, "\n")
                    append_cstr(ref (deref self).main_out, "  store ")
                    append_str(ref (deref self).main_out, arg_llvm)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, arg_val to cstr)
                    append_cstr(ref (deref self).main_out, ", ptr ")
                    append_cstr(ref (deref self).main_out, slot_alloc to cstr)
                    append_cstr(ref (deref self).main_out, "\n")
                    let res_i32 as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, res_i32 to cstr)
                    append_cstr(ref (deref self).main_out, " = call i32 @__mantiq_channel_try_send(ptr ")
                    append_cstr(ref (deref self).main_out, chan_val to cstr)
                    append_cstr(ref (deref self).main_out, ", ptr ")
                    append_cstr(ref (deref self).main_out, slot_alloc to cstr)
                    append_cstr(ref (deref self).main_out, ", i64 8)\n")
                    let res_i8 as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, res_i8 to cstr)
                    append_cstr(ref (deref self).main_out, " = trunc i32 ")
                    append_cstr(ref (deref self).main_out, res_i32 to cstr)
                    append_cstr(ref (deref self).main_out, " to i8\n")
                    return res_i8
                return "0" to ptr[u8]

            if strcmp(mname, "try_recv" to cstr) == 0:
                let has_val_alloc as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, has_val_alloc to cstr)
                append_cstr(ref (deref self).main_out, " = alloca i32\n")
                append_cstr(ref (deref self).main_out, "  store i32 0, ptr ")
                append_cstr(ref (deref self).main_out, has_val_alloc to cstr)
                append_cstr(ref (deref self).main_out, "\n")
                let ret_ptr as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, ret_ptr to cstr)
                append_cstr(ref (deref self).main_out, " = call ptr @__mantiq_channel_try_recv(ptr ")
                append_cstr(ref (deref self).main_out, chan_val to cstr)
                append_cstr(ref (deref self).main_out, ", i64 8, ptr ")
                append_cstr(ref (deref self).main_out, has_val_alloc to cstr)
                append_cstr(ref (deref self).main_out, ")\n")
                let has_val_i32 as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, has_val_i32 to cstr)
                append_cstr(ref (deref self).main_out, " = load i32, ptr ")
