        elif strcmp(v_cstr, "Void" to cstr) == 0:
            return "53" to ptr[u8]
    return "0" to ptr[u8]

fn type_to_llvm(t as ptr[Type]) as String:
    if t == None to ptr[Type]:
        return String.make("i64" to cstr)
    let k as TypeKind = (deref t).kind
    if k == TypeKind.Void:
        return String.make("void" to cstr)
    if k == TypeKind.I8 or k == TypeKind.U8 or k == TypeKind.Boolean or k == TypeKind.Char:
        return String.make("i8" to cstr)
    if k == TypeKind.I16 or k == TypeKind.U16:
        return String.make("i16" to cstr)
    if k == TypeKind.I32 or k == TypeKind.U32 or k == TypeKind.Color:
        return String.make("i32" to cstr)
    if k == TypeKind.I64 or k == TypeKind.U64 or k == TypeKind.ISize or k == TypeKind.USize:
        return String.make("i64" to cstr)
    if k == TypeKind.I128 or k == TypeKind.U128:
        return String.make("i128" to cstr)
    if k == TypeKind.I256 or k == TypeKind.U256:
        return String.make("i256" to cstr)
    if k == TypeKind.I512 or k == TypeKind.U512:
        return String.make("i512" to cstr)
    if k == TypeKind.I1024 or k == TypeKind.U1024:
        return String.make("i1024" to cstr)
    if k == TypeKind.F16:
        return String.make("half" to cstr)
    if k == TypeKind.BFloat16:
        return String.make("bfloat" to cstr)
    if k == TypeKind.F32:
        return String.make("float" to cstr)
    if k == TypeKind.F64:
        return String.make("double" to cstr)
    if k == TypeKind.F128:
        return String.make("fp128" to cstr)
    if k == TypeKind.String:
        return String.make("{ ptr, i64, i64 }" to cstr)
    if k == TypeKind.CStr:
        return String.make("ptr" to cstr)
    if k == TypeKind.RawPointer:
        return String.make("ptr" to cstr)
    if k == TypeKind.List:
        return String.make("{ ptr, i64, i64 }" to cstr)
    if k == TypeKind.Dict:
        return String.make("{ ptr, i64, i64 }" to cstr)
    if k == TypeKind.Option:
        return String.make("{ i8, ptr }" to cstr)
    if k == TypeKind.Result:
        return String.make("{ i8, ptr, ptr }" to cstr)
    if k == TypeKind.QBit:
        return String.make("i32" to cstr)
    if k == TypeKind.QReg:
        return String.make("{ ptr, i64, i64 }" to cstr)
    if k == TypeKind.Any:
        return String.make("{ ptr, ptr }" to cstr)
    if k == TypeKind.Class or k == TypeKind.Task or k == TypeKind.Channel:
        return String.make("ptr" to cstr)
    if k == TypeKind.Interface:
        return String.make("{ ptr, ptr }" to cstr)
    if k == TypeKind.Struct:
        let t_name as cstr = (deref t).name.data to cstr
        if t_name != None to cstr:
            extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
            if strcmp(t_name, "ptr" to cstr) == 0 or strncmp(t_name, "ptr[" to cstr, 4 to usize) == 0 or strcmp(t_name, "cstr" to cstr) == 0:
                return String.make("ptr" to cstr)
            if strcmp(t_name, "String" to cstr) == 0 or strcmp(t_name, "List" to cstr) == 0 or strcmp(t_name, "Dict" to cstr) == 0:
                return String.make("{ ptr, i64, i64 }" to cstr)
            if strncmp(t_name, "List[" to cstr, 5 to usize) == 0 or strncmp(t_name, "Dict[" to cstr, 5 to usize) == 0 or strncmp(t_name, "Set[" to cstr, 4 to usize) == 0:
                return String.make("{ ptr, i64, i64 }" to cstr)
        if t_name != None to cstr and (deref t).name.len > 0 to usize and (deref (t_name to ptr[u8]) == 91 to u8 or (deref t).name.len == 1 to usize):
            return String.make("ptr" to cstr)
        if t_name != None to cstr:
            extern fn strchr(s as cstr, c as i32) as cstr
            let brace as cstr = strchr(t_name, '[' to i32)
            if brace != None to cstr:
                let base_len as usize = (brace to usize) - (t_name to usize)
                let buf as ptr[u8] = make[u8](base_len + 2 to usize) to ptr[u8]
                buf[0] = 37 to u8
                let _m as ptr = memcpy((buf to usize + 1 to usize) to ptr, t_name to ptr, base_len)
                buf[base_len + 1 to usize] = 0 to u8
                let res as String = String.make(buf to cstr)
                free(buf to ptr)
                return res
            else:
                let t_len as usize = (deref t).name.len
                let buf as ptr[u8] = make[u8](t_len + 2 to usize) to ptr[u8]
                buf[0] = 37 to u8
                let _m as ptr = memcpy((buf to usize + 1 to usize) to ptr, t_name to ptr, t_len)
                buf[t_len + 1 to usize] = 0 to u8
                let res as String = String.make(buf to cstr)
                free(buf to ptr)
                return res
    if k == TypeKind.Enum:
        let e_name as cstr = (deref t).name.data to cstr
        if e_name != None to cstr and (deref t).name.len > 0 to usize:
            let e_len as usize = (deref t).name.len
            let buf as ptr[u8] = make[u8](e_len + 2 to usize) to ptr[u8]
            buf[0] = 37 to u8
            let _m as ptr = memcpy((buf to usize + 1 to usize) to ptr, e_name to ptr, e_len)
            buf[e_len + 1 to usize] = 0 to u8
            let res as String = String.make(buf to cstr)
            free(buf to ptr)
            return res
        return String.make("i32" to cstr)
    if k == TypeKind.Union:
        let u_name as cstr = (deref t).name.data to cstr
        if u_name != None to cstr:
            let u_len as usize = (deref t).name.len
            let buf as ptr[u8] = make[u8](u_len + 2 to usize) to ptr[u8]
            buf[0] = 37 to u8
            let _m as ptr = memcpy((buf to usize + 1 to usize) to ptr, u_name to ptr, u_len)
            buf[u_len + 1 to usize] = 0 to u8
            let res as String = String.make(buf to cstr)
            free(buf to ptr)
            return res
        return String.make("ptr" to cstr)
    return String.make("i64" to cstr)

fn type_size(t as ptr[Type]) as i64:
    if t == None to ptr[Type]:
        return 256 to i64
    let k as TypeKind = (deref t).kind
    if k == TypeKind.I8 or k == TypeKind.U8 or k == TypeKind.Boolean or k == TypeKind.Char:
        return 1 to i64
    if k == TypeKind.I16 or k == TypeKind.U16 or k == TypeKind.F16 or k == TypeKind.BFloat16:
        return 2 to i64
    if k == TypeKind.I32 or k == TypeKind.U32 or k == TypeKind.F32:
        return 4 to i64
    if k == TypeKind.I64 or k == TypeKind.U64 or k == TypeKind.ISize or k == TypeKind.USize or k == TypeKind.F64 or k == TypeKind.RawPointer or k == TypeKind.CStr:
        return 8 to i64
    if k == TypeKind.I128 or k == TypeKind.U128 or k == TypeKind.F128:
        return 16 to i64
    if k == TypeKind.I256 or k == TypeKind.U256:
        return 32 to i64
    if k == TypeKind.I512 or k == TypeKind.U512:
        return 64 to i64
    if k == TypeKind.I1024 or k == TypeKind.U1024:
        return 128 to i64
    if k == TypeKind.String or k == TypeKind.List or k == TypeKind.Dict:
        return 24 to i64
    if k == TypeKind.Option:
        return 16 to i64
    if k == TypeKind.Struct and (deref t).name.data != None:
        let sn as cstr = (deref t).name.data to cstr
        if strcmp(sn, "Span" to cstr) == 0 or strcmp(sn, "String" to cstr) == 0 or strcmp(sn, "StringBuilder" to cstr) == 0 or strcmp(sn, "Set" to cstr) == 0 or strcmp(sn, "List" to cstr) == 0 or strcmp(sn, "Dict" to cstr) == 0:
            return 24 to i64
        elif strcmp(sn, "Label" to cstr) == 0:
            return 56 to i64
        elif strcmp(sn, "Suggestion" to cstr) == 0:
            return 72 to i64
        elif strcmp(sn, "Diagnostic" to cstr) == 0:
            return 240 to i64
        elif strcmp(sn, "DiagnosticEngine" to cstr) == 0:
            return 64 to i64
        elif strcmp(sn, "TSNode" to cstr) == 0:
            return 32 to i64
        elif strcmp(sn, "PerfPhase" to cstr) == 0:
            return 32 to i64
        elif strcmp(sn, "PerfState" to cstr) == 0:
            return 64 to i64
    return 256 to i64

fn llvm_int_bits(t as String) as i32:
    if t.data == None to ptr[u8] or t.len == 0 to usize:
        return 0 to i32
    let c as cstr = t.data to cstr
    if strcmp(c, "i1024" to cstr) == 0 or strcmp(c, "u1024" to cstr) == 0:
        return 1024 to i32
    if strcmp(c, "i512" to cstr) == 0 or strcmp(c, "u512" to cstr) == 0:
        return 512 to i32
    if strcmp(c, "i256" to cstr) == 0 or strcmp(c, "u256" to cstr) == 0:
        return 256 to i32
    if strcmp(c, "i128" to cstr) == 0 or strcmp(c, "u128" to cstr) == 0:
        return 128 to i32
    if strcmp(c, "i64" to cstr) == 0 or strcmp(c, "u64" to cstr) == 0 or strcmp(c, "isize" to cstr) == 0 or strcmp(c, "usize" to cstr) == 0:
        return 64 to i32
    if strcmp(c, "i32" to cstr) == 0 or strcmp(c, "u32" to cstr) == 0:
        return 32 to i32
    if strcmp(c, "i16" to cstr) == 0 or strcmp(c, "u16" to cstr) == 0:
        return 16 to i32
    if strcmp(c, "i8" to cstr) == 0 or strcmp(c, "u8" to cstr) == 0 or strcmp(c, "i1" to cstr) == 0 or strcmp(c, "byte" to cstr) == 0:
        return 8 to i32
    return 0 to i32

fn llvm_float_rank(t as String) as i32:
    if t.data == None to ptr[u8] or t.len == 0 to usize:
        return 0 to i32
    let c as cstr = t.data to cstr
    if strcmp(c, "fp128" to cstr) == 0 or strcmp(c, "f128" to cstr) == 0:
        return 4 to i32
    if strcmp(c, "double" to cstr) == 0 or strcmp(c, "f64" to cstr) == 0:
        return 3 to i32
    if strcmp(c, "float" to cstr) == 0 or strcmp(c, "f32" to cstr) == 0:
        return 2 to i32
    if strcmp(c, "half" to cstr) == 0 or strcmp(c, "f16" to cstr) == 0 or strcmp(c, "bfloat" to cstr) == 0 or strcmp(c, "bf16" to cstr) == 0:
        return 1 to i32
    return 0 to i32

fn is_struct_byval(t as String) as bool:
    if t.data == None to ptr[u8] or t.len == 0 to usize:
        return False
    let tc as cstr = t.data to cstr
    extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
    if strcmp(tc, "{ ptr, i64, i64 }" to cstr) == 0 or strcmp(tc, "{ i8, ptr }" to cstr) == 0 or strcmp(tc, "{ i8, ptr, ptr }" to cstr) == 0 or strcmp(tc, "{ ptr, ptr }" to cstr) == 0:
        return True
    if deref (t.data to ptr[u8]) == 123 to u8:
        return True
    if deref (t.data to ptr[u8]) == 37 to u8:
        if strcmp(tc, "%NodeType" to cstr) == 0 or strcmp(tc, "%TypeKind" to cstr) == 0 or strcmp(tc, "%LanguageMode" to cstr) == 0 or strcmp(tc, "%SymbolKind" to cstr) == 0 or strcmp(tc, "%LabelKind" to cstr) == 0 or strcmp(tc, "%Severity" to cstr) == 0 or strcmp(tc, "%ObjectState" to cstr) == 0 or strcmp(tc, "%Endianness" to cstr) == 0 or strcmp(tc, "%PassMode" to cstr) == 0 or strcmp(tc, "%ImportKind" to cstr) == 0:
            return False
        return True
    return False

fn cond_llvm_type(node as ptr[Node]) as String:
    if node == None to ptr[Node]:
        return String.make("i1" to cstr)
    let nt as NodeType = node_kind(node)
    if nt == NodeType.BinaryExpr:
        let op as String = node_op(node)
        if op.data != None to ptr[u8]:
            let op_c as cstr = op.data to cstr
            if strcmp(op_c, "==" to cstr) == 0 or strcmp(op_c, "!=" to cstr) == 0 or strcmp(op_c, "<" to cstr) == 0 or strcmp(op_c, ">" to cstr) == 0 or strcmp(op_c, "<=" to cstr) == 0 or strcmp(op_c, ">=" to cstr) == 0 or strcmp(op_c, "and" to cstr) == 0 or strcmp(op_c, "or" to cstr) == 0:
                return String.make("i1" to cstr)
    elif nt == NodeType.UnaryExpr:
        let uop_str as String = node_op(node)
        if uop_str.data != None to ptr[u8]:
            if strcmp(uop_str.data to cstr, "not" to cstr) == 0:
                return String.make("i1" to cstr)
    elif nt == NodeType.BooleanLiteral:
        return String.make("i1" to cstr)
    var t as String = type_to_llvm(node_inferred_type(node))
    if node_kind(node) == NodeType.MemberExpr:
        let m_nm as String = node_name(node)
        if m_nm.data != None:
            let mc as cstr = m_nm.data to cstr
            if strcmp(mc, "is_context_manager" to cstr) == 0 or strcmp(mc, "is_used" to cstr) == 0 or strcmp(mc, "is_moved" to cstr) == 0 or strncmp(mc, "is_" to cstr, 3 to usize) == 0 or strncmp(mc, "has_" to cstr, 4 to usize) == 0:
                return String.make("i8" to cstr)
            elif strcmp(mc, "kind" to cstr) == 0:
                return String.make("i32" to cstr)
            elif strcmp(mc, "len" to cstr) == 0 or strcmp(mc, "length" to cstr) == 0:
                return String.make("i64" to cstr)
    if node_kind(node) == NodeType.CallExpr:
        let c_node as ptr[Node] = node_left(node)
        var c_n as cstr = None to cstr
        if c_node != None to ptr[Node]:
            if node_kind(c_node) == NodeType.Identifier:
                let cnp as ptr[String] = node_name_ptr(c_node)
                if cnp != None to ptr[String] and (deref cnp).data != None:
                    c_n = (deref cnp).data to cstr
            elif node_kind(c_node) == NodeType.MemberExpr:
                let m_nm as String = node_name(c_node)
                if m_nm.data != None:
                    c_n = m_nm.data to cstr
        if c_n != None to cstr:
            extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
            extern fn strstr(haystack as cstr, needle as cstr) as cstr
            let has_has as bool = strncmp(c_n, "has" to cstr, 3 to usize) == 0
            let has_is as bool = strncmp(c_n, "is" to cstr, 2 to usize) == 0
            let has_remove as bool = strstr(c_n, "remove" to cstr) != None to cstr
            let has_contains as bool = strstr(c_n, "contains" to cstr) != None to cstr
            if has_has or has_is or has_remove or has_contains or strcmp(c_n, "ts_parser_set_language" to cstr) == 0 or strcmp(c_n, "__getitem__" to cstr) == 0:
                t = String.make("i8" to cstr)
            elif strcmp(c_n, "node_kind" to cstr) == 0 or strcmp(c_n, "strcmp" to cstr) == 0 or strcmp(c_n, "strncmp" to cstr) == 0 or strcmp(c_n, "sprintf" to cstr) == 0 or strcmp(c_n, "fseek" to cstr) == 0 or strcmp(c_n, "fclose" to cstr) == 0:
                t = String.make("i32" to cstr)
            elif strcmp(c_n, "strlen" to cstr) == 0 or strcmp(c_n, "ftell" to cstr) == 0 or strcmp(c_n, "length" to cstr) == 0 or strcmp(c_n, "len" to cstr) == 0:
                t = String.make("i64" to cstr)
    if strcmp(t.data to cstr, "{ ptr, ptr }" to cstr) == 0 or strcmp(t.data to cstr, "void" to cstr) == 0 or t.len == 0 to usize:
        t = String.make("i8" to cstr)
    return t

// ── LLVMCodegen ─────────────────────────────────────────────────────────
struct LLVMCodegen:
    public var type_out as StringBuilder
    public var outlined_out as StringBuilder
    public var metadata_out as StringBuilder
    public var main_out as StringBuilder
    public var temp_counter as i32
    public var label_counter as i32
    public var string_counter as i32
    public var closure_counter as i32
    public var defined_types as Dict[String, bool]
    public var external_decls as Dict[String, bool]
    public var auto_drops as Dict[usize, List[String]]
    public var var_slots as Dict[String, String]
    public var var_counts as Dict[String, i32]
    public var var_types as Dict[String, String]
    public var defined_functions as Dict[String, bool]
    public var program_functions as Dict[String, bool]
    public var current_return_type as String
    public var current_struct_name as String
    public var struct_sizes as Dict[String, i64]
    public var struct_field_indices as Dict[String, i32]
    public var current_break_label as String
    public var current_continue_label as String
    public var enum_variant_tags as Dict[String, i32]
    public var type_aliases as Dict[String, String]
    public var global_vars as Dict[String, bool]
    public var global_types as Dict[String, String]
    public var active_param_block as ptr[Node]
    public var active_block_exit as String

    public fn init_cg(self as ptr[LLVMCodegen]):
        (deref self).type_out = StringBuilder.make()
        (deref self).outlined_out = StringBuilder.make()
        (deref self).metadata_out = StringBuilder.make()
        (deref self).main_out = StringBuilder.make()
        (deref self).temp_counter = 1
        (deref self).label_counter = 1
        (deref self).string_counter = 1
        (deref self).closure_counter = 1
        (deref self).defined_types = Dict[String, bool]()
        (deref self).external_decls = Dict[String, bool]()
        (deref self).auto_drops = Dict[usize, List[String]]()
        (deref self).var_slots = Dict[String, String]()
        (deref self).var_counts = Dict[String, i32]()
        (deref self).var_types = Dict[String, String]()
        (deref self).defined_functions = Dict[String, bool]()
        (deref self).program_functions = Dict[String, bool]()
        (deref self).current_return_type = String.make("void" to cstr)
        (deref self).current_struct_name = String.make("" to cstr)
        (deref self).struct_sizes = Dict[String, i64]()
        (deref self).struct_field_indices = Dict[String, i32]()
        (deref self).current_break_label = String.make("" to cstr)
        (deref self).current_continue_label = String.make("" to cstr)
        (deref self).enum_variant_tags = Dict[String, i32]()
        (deref self).type_aliases = Dict[String, String]()
        (deref self).global_vars = Dict[String, bool]()
        (deref self).global_types = Dict[String, String]()
        (deref self).active_param_block = None to ptr[Node]
        (deref self).active_block_exit = String.make("" to cstr)

    public fn fresh_temp(self as ptr[LLVMCodegen]) as ptr[u8]:
        let buf as ptr[u8] = make(32 to usize) to ptr[u8]
        let _ as i32 = sprintf(buf, "%%t.%d" to cstr, (deref self).temp_counter)
        (deref self).temp_counter = (deref self).temp_counter + 1 to i32
        return buf

    public fn fresh_label(self as ptr[LLVMCodegen]) as ptr[u8]:
        let buf as ptr[u8] = make(32 to usize) to ptr[u8]
        let _ as i32 = sprintf(buf, "label_%d" to cstr, (deref self).label_counter)
        (deref self).label_counter = (deref self).label_counter + 1 to i32
        return buf

    public fn fresh_closure_name(self as ptr[LLVMCodegen]) as ptr[u8]:
        let buf as ptr[u8] = make(64 to usize) to ptr[u8]
        let _ as i32 = sprintf(buf, "__closure_%d" to cstr, (deref self).closure_counter)
        (deref self).closure_counter = (deref self).closure_counter + 1 to i32
        return buf

    public fn trimmed(self as ptr[LLVMCodegen], t as String) as cstr:
        let d as ptr[u8] = t.data
        if d == None to ptr[u8]:
            return None to cstr
        let len as usize = t.len
        var s as usize = 0 to usize
        while s < len and (deref ((d to usize + s) to ptr[u8])) == 32 to u8:
            s = s + 1 to usize
        var e as usize = len
        while e > s and (deref ((d to usize + e - 1) to ptr[u8])) == 32 to u8:
            e = e - 1 to usize
        let n as usize = e - s
        if n == 0 to usize:
            return None to cstr
        extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
        let buf as ptr[u8] = make[u8](n + 1 to usize) to ptr[u8]
        let src_addr as usize = (d to usize) + s
        let _m as ptr = memcpy(buf to ptr, src_addr to ptr, n)
        buf[n] = 0 to u8
        return buf to cstr

    public fn resolve_struct_size(self as ptr[LLVMCodegen], t as String) as i64:
        if t.data == None to ptr[u8] or t.len < 2 to usize:
            return 1024 to i64
        let nm as String = String.make((t.data to usize + 1 to usize) to cstr)
        if (deref self).struct_sizes.has(nm):
            return (deref self).struct_sizes[nm]
        return 1024 to i64

    public fn llvm_type_align(self as ptr[LLVMCodegen], t as String) as i64:
        let c as cstr = self.trimmed(t)
        if c == None to cstr:
            return 8 to i64
        if strcmp(c, "i1024" to cstr) == 0 or strcmp(c, "u1024" to cstr) == 0:
            return 16 to i64
        if strcmp(c, "i512" to cstr) == 0 or strcmp(c, "u512" to cstr) == 0:
            return 16 to i64
        if strcmp(c, "i256" to cstr) == 0 or strcmp(c, "u256" to cstr) == 0:
            return 16 to i64
        if strcmp(c, "i128" to cstr) == 0 or strcmp(c, "u128" to cstr) == 0 or strcmp(c, "fp128" to cstr) == 0 or strcmp(c, "f128" to cstr) == 0:
            return 16 to i64
        if strcmp(c, "ptr" to cstr) == 0 or strcmp(c, "i64" to cstr) == 0 or strcmp(c, "u64" to cstr) == 0 or strcmp(c, "f64" to cstr) == 0 or strcmp(c, "double" to cstr) == 0 or strcmp(c, "isize" to cstr) == 0 or strcmp(c, "usize" to cstr) == 0 or strcmp(c, "cstr" to cstr) == 0:
            return 8 to i64
        if strcmp(c, "i32" to cstr) == 0 or strcmp(c, "u32" to cstr) == 0 or strcmp(c, "f32" to cstr) == 0 or strcmp(c, "float" to cstr) == 0:
            return 4 to i64
        if strcmp(c, "i16" to cstr) == 0 or strcmp(c, "u16" to cstr) == 0 or strcmp(c, "f16" to cstr) == 0 or strcmp(c, "half" to cstr) == 0 or strcmp(c, "bf16" to cstr) == 0 or strcmp(c, "bfloat" to cstr) == 0:
            return 2 to i64
        if strcmp(c, "i8" to cstr) == 0 or strcmp(c, "u8" to cstr) == 0 or strcmp(c, "i1" to cstr) == 0 or strcmp(c, "byte" to cstr) == 0:
            return 1 to i64
        return 8 to i64

    public fn llvm_type_byte_size(self as ptr[LLVMCodegen], t as String) as i64:
        let c as cstr = self.trimmed(t)
        if c == None to cstr:
            return 256 to i64
        if strcmp(c, "i1024" to cstr) == 0 or strcmp(c, "u1024" to cstr) == 0:
            return 128 to i64
        if strcmp(c, "i512" to cstr) == 0 or strcmp(c, "u512" to cstr) == 0:
            return 64 to i64
        if strcmp(c, "i256" to cstr) == 0 or strcmp(c, "u256" to cstr) == 0:
            return 32 to i64
        if strcmp(c, "i128" to cstr) == 0 or strcmp(c, "u128" to cstr) == 0 or strcmp(c, "fp128" to cstr) == 0 or strcmp(c, "f128" to cstr) == 0:
            return 16 to i64
        if strcmp(c, "ptr" to cstr) == 0 or strcmp(c, "i64" to cstr) == 0 or strcmp(c, "u64" to cstr) == 0 or strcmp(c, "f64" to cstr) == 0 or strcmp(c, "double" to cstr) == 0 or strcmp(c, "isize" to cstr) == 0 or strcmp(c, "usize" to cstr) == 0 or strcmp(c, "cstr" to cstr) == 0:
            return 8 to i64
        if strcmp(c, "i32" to cstr) == 0 or strcmp(c, "u32" to cstr) == 0 or strcmp(c, "f32" to cstr) == 0 or strcmp(c, "float" to cstr) == 0:
            return 4 to i64
        if strcmp(c, "i16" to cstr) == 0 or strcmp(c, "u16" to cstr) == 0 or strcmp(c, "f16" to cstr) == 0 or strcmp(c, "half" to cstr) == 0 or strcmp(c, "bf16" to cstr) == 0 or strcmp(c, "bfloat" to cstr) == 0:
            return 2 to i64
        if strcmp(c, "i8" to cstr) == 0 or strcmp(c, "u8" to cstr) == 0 or strcmp(c, "i1" to cstr) == 0 or strcmp(c, "byte" to cstr) == 0:
            return 1 to i64
        if strcmp(c, "void" to cstr) == 0:
            return 0 to i64
        if strcmp(c, "float" to cstr) == 0:
            return 4 to i64
        if deref (c to ptr[u8]) == 123 to u8:
            return self.llvm_struct_body_byte_size(String.make(c))
        if deref (c to ptr[u8]) == 37 to u8:
            return self.resolve_struct_size(String.make(c))
        return 256 to i64

    public fn llvm_struct_body_byte_size(self as ptr[LLVMCodegen], t as String) as i64:
        let d as ptr[u8] = t.data
        if d == None to ptr[u8]:
            return 256 to i64
        let len as usize = t.len
        var i as usize = 0 to usize
        while i < len and (deref ((d to usize + i) to ptr[u8])) != 123 to u8:
            i = i + 1 to usize
        i = i + 1 to usize
        var off as i64 = 0 to i64
        var max_al as i64 = 1 to i64
        var depth as usize = 0 to usize
        var field_start as usize = i
        while i <= len:
            var c as u8 = 0 to u8
            if i < len:
                c = deref ((d to usize + i) to ptr[u8])
            var flush as bool = False
            if c == 123 to u8:
                depth = depth + 1 to usize
            elif c == 125 to u8:
                if depth == 0:
                    flush = True
                else:
                    depth = depth - 1 to usize
            elif c == 44 to u8:
                if depth == 0:
                    flush = True
            if flush:
                let fld as String = self.slice(t, field_start, i)
                let fsz as i64 = self.llvm_type_byte_size(fld)
                let fal as i64 = self.llvm_type_align(fld)
                let padded as i64 = ((off + fal - 1 to i64) / fal) * fal
                off = padded + fsz
                if fal > max_al:
                    max_al = fal
                field_start = i + 1 to usize
                if c == 125 to u8 and depth == 0 to usize:
                    break
            i = i + 1 to usize
        if max_al < 1 to i64:
            max_al = 1 to i64
        return ((off + max_al - 1 to i64) / max_al) * max_al

    public fn eval_type_size_node(self as ptr[LLVMCodegen], node as ptr[Node]) as i64:
        if node == None to ptr[Node]:
            return 8 to i64
        if node_kind(node) == NodeType.Identifier:
            var name_str as String = node_name(node)
            if (deref self).type_aliases.has(name_str):
                name_str = (deref self).type_aliases[name_str]
            let name as cstr = name_str.data to cstr
            let n_len as usize = name_str.len
            if (n_len == 2 to usize and (strncmp(name, "i8" to cstr, 2 to usize) == 0 or strncmp(name, "u8" to cstr, 2 to usize) == 0)) or (n_len == 4 to usize and (strncmp(name, "bool" to cstr, 4 to usize) == 0 or strncmp(name, "char" to cstr, 4 to usize) == 0)):
                return 1 to i64
            elif (n_len == 3 to usize and (strncmp(name, "i16" to cstr, 3 to usize) == 0 or strncmp(name, "u16" to cstr, 3 to usize) == 0 or strncmp(name, "f16" to cstr, 3 to usize) == 0)) or (n_len == 4 to usize and strncmp(name, "bf16" to cstr, 4 to usize) == 0):
                return 2 to i64
            elif n_len == 3 to usize and (strncmp(name, "i32" to cstr, 3 to usize) == 0 or strncmp(name, "u32" to cstr, 3 to usize) == 0 or strncmp(name, "f32" to cstr, 3 to usize) == 0):
                return 4 to i64
            elif (n_len == 3 to usize and (strncmp(name, "i64" to cstr, 3 to usize) == 0 or strncmp(name, "u64" to cstr, 3 to usize) == 0 or strncmp(name, "f64" to cstr, 3 to usize) == 0 or strncmp(name, "ptr" to cstr, 3 to usize) == 0)) or (n_len == 4 to usize and strncmp(name, "cstr" to cstr, 4 to usize) == 0) or (n_len == 5 to usize and (strncmp(name, "isize" to cstr, 5 to usize) == 0 or strncmp(name, "usize" to cstr, 5 to usize) == 0)):
                return 8 to i64
            elif (n_len == 4 to usize and (strncmp(name, "i128" to cstr, 4 to usize) == 0 or strncmp(name, "u128" to cstr, 4 to usize) == 0 or strncmp(name, "f128" to cstr, 4 to usize) == 0)):
                return 16 to i64
            elif (n_len == 6 to usize and strncmp(name, "String" to cstr, 6 to usize) == 0) or (n_len == 4 to usize and (strncmp(name, "List" to cstr, 4 to usize) == 0 or strncmp(name, "Dict" to cstr, 4 to usize) == 0)) or (n_len == 3 to usize and strncmp(name, "Set" to cstr, 3 to usize) == 0):
                return 24 to i64
            let s_buf as ptr[u8] = make[u8](name_str.len + 2 to usize) to ptr[u8]
            s_buf[0] = 37 to u8
            extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
            let _m as ptr = memcpy((s_buf to usize + 1 to usize) to ptr, name_str.data to ptr, name_str.len)
            s_buf[name_str.len + 1 to usize] = 0 to u8
            let s_str as String = String.make(s_buf to cstr)
            free(s_buf to ptr)
            let s_sz as i64 = self.resolve_struct_size(s_str)
            if s_sz > 0 to i64:
                return s_sz
        if node_inferred_type(node) != None to ptr[Type]:
            let llvm_t as String = type_to_llvm(node_inferred_type(node))
            return self.llvm_type_byte_size(llvm_t)
        return 8 to i64

    public fn eval_type_align_node(self as ptr[LLVMCodegen], node as ptr[Node]) as i64:
        if node == None to ptr[Node]:
            return 8 to i64
        if node_kind(node) == NodeType.Identifier:
            var name_str as String = node_name(node)
            if (deref self).type_aliases.has(name_str):
                name_str = (deref self).type_aliases[name_str]
            let name as cstr = name_str.data to cstr
            let n_len as usize = name_str.len
            if (n_len == 2 to usize and (strncmp(name, "i8" to cstr, 2 to usize) == 0 or strncmp(name, "u8" to cstr, 2 to usize) == 0)) or (n_len == 4 to usize and (strncmp(name, "bool" to cstr, 4 to usize) == 0 or strncmp(name, "char" to cstr, 4 to usize) == 0)):
                return 1 to i64
            elif (n_len == 3 to usize and (strncmp(name, "i16" to cstr, 3 to usize) == 0 or strncmp(name, "u16" to cstr, 3 to usize) == 0 or strncmp(name, "f16" to cstr, 3 to usize) == 0)) or (n_len == 4 to usize and strncmp(name, "bf16" to cstr, 4 to usize) == 0):
                return 2 to i64
            elif n_len == 3 to usize and (strncmp(name, "i32" to cstr, 3 to usize) == 0 or strncmp(name, "u32" to cstr, 3 to usize) == 0 or strncmp(name, "f32" to cstr, 3 to usize) == 0):
                return 4 to i64
            elif (n_len == 3 to usize and (strncmp(name, "i64" to cstr, 3 to usize) == 0 or strncmp(name, "u64" to cstr, 3 to usize) == 0 or strncmp(name, "f64" to cstr, 3 to usize) == 0 or strncmp(name, "ptr" to cstr, 3 to usize) == 0)) or (n_len == 4 to usize and strncmp(name, "cstr" to cstr, 4 to usize) == 0) or (n_len == 5 to usize and (strncmp(name, "isize" to cstr, 5 to usize) == 0 or strncmp(name, "usize" to cstr, 5 to usize) == 0)):
                return 8 to i64
        if node_inferred_type(node) != None to ptr[Type]:
            let llvm_t as String = type_to_llvm(node_inferred_type(node))
            return self.llvm_type_align(llvm_t)
        return 8 to i64

    public fn slice(self as ptr[LLVMCodegen], t as String, start as usize, end as usize) as String:
        extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
        let n as usize = end - start
        let buf as ptr[u8] = make[u8](n + 1 to usize) to ptr[u8]
        let src_addr as usize = (t.data to usize) + start
        let _m as ptr = memcpy(buf to ptr, src_addr to ptr, n)
        buf[n] = 0 to u8
        return String.make(buf to cstr)

    public fn register_builtin_struct(self as ptr[LLVMCodegen], name as cstr, ty as cstr):
        append_cstr(ref (deref self).type_out, "%" to cstr)
        append_cstr(ref (deref self).type_out, name)
        append_cstr(ref (deref self).type_out, " = type " to cstr)
        append_cstr(ref (deref self).type_out, ty)
        append_cstr(ref (deref self).type_out, "\n\n" to cstr)
        if not (deref self).defined_types.has(String.make(name)):
            set_dict_bool(ref (deref self).defined_types, String.make(name), True)
        if not (deref self).struct_sizes.has(String.make(name)):
            let sz as i64 = self.llvm_type_byte_size(String.make(ty))
            set_dict_i64(ref (deref self).struct_sizes, String.make(name), sz)

    public fn register_field_idx(self as ptr[LLVMCodegen], struct_name as cstr, field_name as cstr, idx as i32):
        let sb as StringBuilder = StringBuilder.make()
        append_cstr(ref sb, struct_name)
        append_cstr(ref sb, "." to cstr)
        append_cstr(ref sb, field_name)
        let s as String = sb.to_string()
        set_dict_i32(ref (deref self).struct_field_indices, s, idx)
        sb.deinit()

    public fn type_llvm_byte_size(self as ptr[LLVMCodegen], t as ptr[Type]) as i64:
        if t == None to ptr[Type]:
            return 256 to i64
        let k as TypeKind = (deref t).kind
        if k == TypeKind.Struct or k == TypeKind.Union:
            let ty as String = type_to_llvm(t)
            return self.llvm_type_byte_size(ty)
        return type_size(t)

    public fn resolve_make_elem_type(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[Type]:
        let annots_ptr as ptr[List[Option[ptr[TypeAnnotation]]]] = node_type_annots(node)
        if annots_ptr != None to ptr[List[Option[ptr[TypeAnnotation]]]]:
            let annots as List[Option[ptr[TypeAnnotation]]] = deref annots_ptr
            if annots.length() > 0 to i64:
                let opt as Option[ptr[TypeAnnotation]] = annots[0 to i64]
                let opt_ref as ptr[OptionLayout] = (ref opt) to ptr[OptionLayout]
                if option_has_value(opt_ref):
                    let pa as ptr[TypeAnnotation] = option_unwrap_ptr(opt_ref) to ptr[TypeAnnotation]
                    if pa != None to ptr[TypeAnnotation] and (deref pa).name.data != None:
                        return (deref self).resolve_type_from_annotation(pa)
        return None to ptr[Type]

    public fn emit_builtin_struct_types(self as ptr[LLVMCodegen]):
        self.register_builtin_struct("Lowerer", "{ { ptr, i64, i64 }, i32, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, i64 }")
        self.register_builtin_struct("Sema", "{ ptr, ptr, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, i32, ptr, ptr, { ptr, i64, i64 } }")
        self.register_builtin_struct("TypeChecker", "{ ptr, { i8, ptr }, ptr, ptr }")
        self.register_builtin_struct("BorrowRecord", "{ { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, i8, %Span, i32, i8 }")
        self.register_builtin_struct("BorrowChecker", "{ { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, ptr, i32, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, i32 }")
        self.register_builtin_struct("LLVMCodegen", "{ { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, i32, i32, i32, i32, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, ptr, { ptr, i64, i64 } }")
        self.register_builtin_struct("Node", "{ i32, %Span, { i8, ptr }, ptr, ptr }")
        self.register_builtin_struct("ProgramData", "{ { ptr, i64, i64 } }")
        self.register_builtin_struct("ImportDeclData", "{ i32, { ptr, i64, i64 }, { ptr, i64, i64 }, { i8, ptr } }")
        self.register_builtin_struct("FunDeclData", "{ { ptr, i64, i64 }, { ptr, i64, i64 }, ptr, i8, i8, i8, ptr, ptr, i8, i8, { ptr, i64, i64 } }")
        self.register_builtin_struct("VarDeclData", "{ { ptr, i64, i64 }, ptr, i8, ptr, { ptr, i64, i64 } }")
        self.register_builtin_struct("IfStmtData", "{ ptr, ptr, { i8, ptr } }")
        self.register_builtin_struct("ClassDeclData", "{ { ptr, i64, i64 }, { ptr, i64, i64 }, { ptr, i64, i64 }, ptr, i8, { ptr, i64, i64 } }")
        self.register_builtin_struct("InterfaceDeclData", "{ { ptr, i64, i64 }, ptr, { ptr, i64, i64 } }")
