        self.register_builtin_struct("IdentifierData", "{ { ptr, i64, i64 } }")
        self.register_builtin_struct("NumberLiteralData", "{ double, i8 }")
        self.register_builtin_struct("StringLiteralData", "{ { ptr, i64, i64 } }")
        self.register_builtin_struct("MacroDeclData", "{ { ptr, i64, i64 }, { ptr, i64, i64 }, ptr }")
        self.register_builtin_struct("MacroInvocationData", "{ { ptr, i64, i64 }, { ptr, i64, i64 } }")
        self.register_builtin_struct("CallExprData", "{ ptr, { ptr, i64, i64 }, ptr }")
        self.register_builtin_struct("ReturnStmtData", "{ ptr, { ptr, i64, i64 } }")
        self.register_builtin_struct("WhileStmtData", "{ ptr, ptr }")
        self.register_builtin_struct("ForStmtData", "{ { ptr, i64, i64 }, ptr, ptr, i8, i8 }")
        self.register_builtin_struct("MemberExprData", "{ ptr, { ptr, i64, i64 } }")
        self.register_builtin_struct("UnaryExprData", "{ { ptr, i64, i64 }, ptr }")
        self.register_builtin_struct("CastExprData", "{ { ptr, i64, i64 }, ptr }")
        self.register_builtin_struct("BlockStmtData", "{ { ptr, i64, i64 }, { ptr, i64, i64 } }")
        self.register_builtin_struct("ParamBlockStmtData", "{ { ptr, i64, i64 }, ptr, { ptr, i64, i64 }, ptr, ptr, { ptr, i64, i64 } }")
