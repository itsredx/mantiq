                    append_cstr(ref (deref self).main_out, mat_alloca to cstr)
                    append_cstr(ref (deref self).main_out, " = alloca %")
                    append_str(ref (deref self).main_out, (deref call_obj_t).name)
                    append_cstr(ref (deref self).main_out, "\n")
                    append_cstr(ref (deref self).main_out, "  store ")
                    append_str(ref (deref self).main_out, obj_type_str)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, obj_ptr to cstr)
                    append_cstr(ref (deref self).main_out, ", ptr ")
                    append_cstr(ref (deref self).main_out, mat_alloca to cstr)
                    append_cstr(ref (deref self).main_out, "\n")
                    ptr_temp = mat_alloca

            let gep_reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, gep_reg to cstr)
            append_cstr(ref (deref self).main_out, " = getelementptr inbounds %")
            append_str(ref (deref self).main_out, struct_name)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, ptr_temp to cstr)
            append_cstr(ref (deref self).main_out, ", i32 0, i32 ")
            append_i32(ref (deref self).main_out, field_idx)
            append_cstr(ref (deref self).main_out, "\n")
            return gep_reg
        elif nt == NodeType.IndexExpr:
            return self.emit_index_addr(node)
        return self.emit_expr(node)

    public fn emit_binary_stmt(self as ptr[LLVMCodegen], node as ptr[Node]):
        let op as String = node_op(node)
        let left as ptr[Node] = node_left(node)
        let right as ptr[Node] = node_right(node)
        if op.data == None:
            return
        if strcmp(op.data to cstr, "=" to cstr) == 0:
            if (node_inferred_type(right) == None to ptr[Type] or (deref (node_inferred_type(right))).kind == TypeKind.Any) and node_inferred_type(left) != None to ptr[Type]:
                set_node_inferred_type(right, node_inferred_type(left))
            let val_reg as ptr[u8] = self.emit_expr(right)
            if node_kind(left) == NodeType.IndexExpr and self.node_index_collection_is_dict(left):
                let d_slot as ptr[u8] = self.emit_dict_index_slot(left, True)
                var d_vt as String = type_to_llvm(node_inferred_type(right))
                if strcmp(d_vt.data to cstr, "ptr" to cstr) == 0 or strcmp(d_vt.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                    d_vt = self.dict_index_value_llvm(left)
                if strcmp(d_vt.data to cstr, "ptr" to cstr) == 0:
                    let coll_sub as ptr[Node] = node_left(left)
                    if coll_sub != None to ptr[Node] and node_kind(coll_sub) == NodeType.MemberExpr:
                        let f_sub_nm as String = node_name(coll_sub)
                        if f_sub_nm.data != None to ptr[u8] and strcmp(f_sub_nm.data to cstr, "macros" to cstr) == 0:
                            d_vt = String.make("%MacroDef" to cstr)
                append_cstr(ref (deref self).main_out, "  store ")
                append_str(ref (deref self).main_out, d_vt)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, ", ptr ")
                append_cstr(ref (deref self).main_out, d_slot to cstr)
                append_cstr(ref (deref self).main_out, "\n")
                return
            var val_type as String = type_to_llvm(node_inferred_type(right))
            if node_kind(left) == NodeType.IndexExpr:
                val_type = self.index_value_llvm(left)
            elif node_kind(right) == NodeType.IndexExpr:
                val_type = self.index_value_llvm(right)
            if node_kind(right) == NodeType.CallExpr:
                let call_callee as ptr[Node] = node_left(right)
                if call_callee != None to ptr[Node]:
                    let call_name_ptr as ptr[String] = node_name_ptr(call_callee)
                    if call_name_ptr != None to ptr[String] and (deref call_name_ptr).data != None:
                        let cn as cstr = (deref call_name_ptr).data to cstr
                        if strcmp(cn, "String" to cstr) == 0 or strcmp(cn, "List" to cstr) == 0 or strcmp(cn, "Dict" to cstr) == 0 or strcmp(cn, "Set" to cstr) == 0:
                            val_type = String.make("{ ptr, i64, i64 }" to cstr)
            if strcmp(val_type.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                if node_kind(left) == NodeType.MemberExpr:
                    let field_name as String = node_name(left)
                    if field_name.data != None:
                        val_type = get_struct_field_type("Node" to cstr, field_name.data to cstr)
            if strcmp(val_type.data to cstr, "void" to cstr) == 0 or strcmp(val_type.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                val_type = String.make("ptr" to cstr)
            if node_kind(right) == NodeType.BooleanLiteral:
                val_type = String.make("i8" to cstr)
            elif strcmp(val_type.data to cstr, "i8" to cstr) == 0:
                var need_zext as bool = False
                if node_kind(right) == NodeType.BinaryExpr:
                    let b_op as String = node_op(right)
                    if b_op.data != None to ptr[u8]:
                        let b_op_c as cstr = b_op.data to cstr
                        if strcmp(b_op_c, "==" to cstr) == 0 or strcmp(b_op_c, "!=" to cstr) == 0 or strcmp(b_op_c, "<" to cstr) == 0 or strcmp(b_op_c, ">" to cstr) == 0 or strcmp(b_op_c, "<=" to cstr) == 0 or strcmp(b_op_c, ">=" to cstr) == 0 or strcmp(b_op_c, "and" to cstr) == 0 or strcmp(b_op_c, "or" to cstr) == 0:
                            need_zext = True
                elif node_kind(right) == NodeType.UnaryExpr:
                    let u_op as String = node_op(right)
                    if u_op.data != None to ptr[u8] and strcmp(u_op.data to cstr, "not" to cstr) == 0:
                        need_zext = True
                if need_zext:
                    let z_temp as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, z_temp to cstr)
                    append_cstr(ref (deref self).main_out, " = zext i1 ")
                    append_cstr(ref (deref self).main_out, val_reg to cstr)
                    append_cstr(ref (deref self).main_out, " to i8\n")
                    val_reg = z_temp
            if node_kind(right) != NodeType.BooleanLiteral and (deref val_reg) >= 48 to u8 and (deref val_reg) <= 57 to u8:
                val_type = String.make("i32" to cstr)

            let target_t as ptr[Type] = node_inferred_type(left)
            var target_type as String = val_type
            if target_t != None to ptr[Type]:
                target_type = type_to_llvm(target_t)
            if strcmp(target_type.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                if node_kind(left) == NodeType.MemberExpr:
                    let field_name as String = node_name(left)
                    if field_name.data != None:
                        target_type = get_struct_field_type("Node" to cstr, field_name.data to cstr)
            if strcmp(target_type.data to cstr, "void" to cstr) == 0 or strcmp(target_type.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                target_type = val_type

            if strcmp(target_type.data to cstr, "i64" to cstr) == 0 and strcmp(val_type.data to cstr, "i32" to cstr) == 0:
                let z_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, z_temp to cstr)
                append_cstr(ref (deref self).main_out, " = zext i32 ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, " to i64\n")
                val_reg = z_temp
                val_type = String.make("i64" to cstr)
            elif strcmp(target_type.data to cstr, "i32" to cstr) == 0 and strcmp(val_type.data to cstr, "i64" to cstr) == 0:
                let tr_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, tr_temp to cstr)
                append_cstr(ref (deref self).main_out, " = trunc i64 ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, " to i32\n")
                val_reg = tr_temp
                val_type = String.make("i32" to cstr)
            elif strcmp(target_type.data to cstr, "ptr" to cstr) == 0 and (strcmp(val_type.data to cstr, "i64" to cstr) == 0 or strcmp(val_type.data to cstr, "i32" to cstr) == 0) and (deref val_reg) != 37 to u8:
                let ptr_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, ptr_temp to cstr)
                append_cstr(ref (deref self).main_out, " = inttoptr ")
                append_str(ref (deref self).main_out, val_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, " to ptr\n")
                val_reg = ptr_temp
                val_type = String.make("ptr" to cstr)
            elif strcmp(target_type.data to cstr, "i64" to cstr) == 0 and strcmp(val_type.data to cstr, "ptr" to cstr) == 0:
                let int_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, int_temp to cstr)
                append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, " to i64\n")
                val_reg = int_temp
                val_type = String.make("i64" to cstr)

            let target_ptr_reg as ptr[u8] = self.emit_lvalue_ptr(left)
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, val_reg to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, target_ptr_reg to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return

        let is_compound as bool = strcmp(op.data to cstr, "+=" to cstr) == 0 or strcmp(op.data to cstr, "-=" to cstr) == 0 or strcmp(op.data to cstr, "*=" to cstr) == 0 or strcmp(op.data to cstr, "/=" to cstr) == 0 or strcmp(op.data to cstr, "%=" to cstr) == 0
        if is_compound:
            if (node_inferred_type(right) == None to ptr[Type] or (deref (node_inferred_type(right))).kind == TypeKind.Any) and node_inferred_type(left) != None to ptr[Type]:
                set_node_inferred_type(right, node_inferred_type(left))
            let left_reg as ptr[u8] = self.emit_expr(left)
            var right_reg as ptr[u8] = self.emit_expr(right)

            var target_t as ptr[Type] = node_inferred_type(left)
            var target_type as String = String.make("i32" to cstr)
            if target_t != None to ptr[Type]:
                target_type = type_to_llvm(target_t)
            elif node_kind(left) == NodeType.IndexExpr:
                target_type = self.index_value_llvm(left)
            elif node_kind(left) == NodeType.Identifier:
                let id_nm as String = node_name(left)
                if (deref self).var_types.has(id_nm):
                    target_type = (deref self).var_types[id_nm]

            var right_type as String = type_to_llvm(node_inferred_type(right))
            if node_kind(right) == NodeType.IndexExpr:
                right_type = self.index_value_llvm(right)

            let is_fop as bool = strcmp(target_type.data to cstr, "double" to cstr) == 0 or strcmp(target_type.data to cstr, "float" to cstr) == 0 or strcmp(target_type.data to cstr, "half" to cstr) == 0 or strcmp(target_type.data to cstr, "bfloat" to cstr) == 0 or strcmp(target_type.data to cstr, "fp128" to cstr) == 0
            if is_fop:
                if node_kind(right) == NodeType.NumberLiteral and (deref right_reg) != 37 to u8:
                    right_reg = self.float_const_reg(right)
                elif strcmp(right_type.data to cstr, target_type.data to cstr) != 0:
                    if strcmp(right_type.data to cstr, "i64" to cstr) == 0 or strcmp(right_type.data to cstr, "i32" to cstr) == 0:
                        let cv_r as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, cv_r to cstr)
                        append_cstr(ref (deref self).main_out, " = sitofp ")
                        append_str(ref (deref self).main_out, right_type)
                        append_cstr(ref (deref self).main_out, " ")
                        append_cstr(ref (deref self).main_out, right_reg to cstr)
                        append_cstr(ref (deref self).main_out, " to ")
                        append_str(ref (deref self).main_out, target_type)
                        append_cstr(ref (deref self).main_out, "\n")
                        right_reg = cv_r
                    elif strcmp(target_type.data to cstr, "double" to cstr) == 0 and strcmp(right_type.data to cstr, "float" to cstr) == 0:
                        let cv_r as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, cv_r to cstr)
                        append_cstr(ref (deref self).main_out, " = fpext float ")
                        append_cstr(ref (deref self).main_out, right_reg to cstr)
                        append_cstr(ref (deref self).main_out, " to double\n")
                        right_reg = cv_r
            else:
                if strcmp(target_type.data to cstr, right_type.data to cstr) != 0:
                    if strcmp(target_type.data to cstr, "i64" to cstr) == 0 and (strcmp(right_type.data to cstr, "i32" to cstr) == 0 or ((deref right_reg) >= 48 to u8 and (deref right_reg) <= 57 to u8)):
                        let z_temp as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, z_temp to cstr)
                        append_cstr(ref (deref self).main_out, " = sext i32 ")
                        append_cstr(ref (deref self).main_out, right_reg to cstr)
                        append_cstr(ref (deref self).main_out, " to i64\n")
                        right_reg = z_temp

            let res_reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, res_reg to cstr)
            if strcmp(op.data to cstr, "+=" to cstr) == 0:
                if is_fop:
                    append_cstr(ref (deref self).main_out, " = fadd ")
                else:
                    append_cstr(ref (deref self).main_out, " = add ")
            elif strcmp(op.data to cstr, "-=" to cstr) == 0:
                if is_fop:
                    append_cstr(ref (deref self).main_out, " = fsub ")
                else:
                    append_cstr(ref (deref self).main_out, " = sub ")
            elif strcmp(op.data to cstr, "*=" to cstr) == 0:
                if is_fop:
                    append_cstr(ref (deref self).main_out, " = fmul ")
                else:
                    append_cstr(ref (deref self).main_out, " = mul ")
            elif strcmp(op.data to cstr, "/=" to cstr) == 0:
                if is_fop:
                    append_cstr(ref (deref self).main_out, " = fdiv ")
                else:
                    append_cstr(ref (deref self).main_out, " = sdiv ")
            elif strcmp(op.data to cstr, "%=" to cstr) == 0:
                append_cstr(ref (deref self).main_out, " = srem ")
            else:
                append_cstr(ref (deref self).main_out, " = add ")

            append_cstr(ref (deref self).main_out, " ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, left_reg to cstr)
            append_cstr(ref (deref self).main_out, ", ")
            append_cstr(ref (deref self).main_out, right_reg to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            let target_ptr_reg as ptr[u8] = self.emit_lvalue_ptr(left)
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, res_reg to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, target_ptr_reg to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return

        let _ as ptr[u8] = self.emit_binary_expr(node)

    public fn float_const_reg(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let f_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
        let f_val as f64 = node_val(node)
        let inf_t as ptr[Type] = node_inferred_type(node)
        var is_f32 as i32 = 1
        if inf_t != None to ptr[Type]:
            let k as TypeKind = (deref inf_t).kind
            if k == TypeKind.F64 or k == TypeKind.F128:
                is_f32 = 0
            elif k == TypeKind.F16 or k == TypeKind.BFloat16 or k == TypeKind.F32:
                is_f32 = 1
        extern fn format_llvm_float(val as f64, is_f32 as i32, out_buf as ptr[u8])
        format_llvm_float(f_val, is_f32, f_buf)
        return f_buf

    public fn emit_binary_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let op as String = node_op(node)
        let left as ptr[Node] = node_left(node)
        let right as ptr[Node] = node_right(node)

        if strcmp(op.data to cstr, "and" to cstr) == 0:
            let left_reg as ptr[u8] = self.emit_expr(left)
            let left_type as String = cond_llvm_type(left)
            let reg as ptr[u8] = self.fresh_temp()
            let and_tmp as ptr[u8] = self.fresh_temp()
            let eval_label as ptr[u8] = self.fresh_label()
            let done_label as ptr[u8] = self.fresh_label()

            var left_bool as ptr[u8] = left_reg
            let left_is_cmp as bool = node_kind(left) == NodeType.BinaryExpr or node_kind(left) == NodeType.BooleanLiteral
            if left_type.data != None to ptr[u8] and strcmp(left_type.data to cstr, "ptr" to cstr) == 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
                append_cstr(ref (deref self).main_out, left_reg to cstr)
                append_cstr(ref (deref self).main_out, ", null\n")
                left_bool = temp
            elif left_type.data != None to ptr[u8] and not left_is_cmp and strcmp(left_type.data to cstr, "i1" to cstr) != 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ")
                append_str(ref (deref self).main_out, left_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, left_reg to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")
                left_bool = temp

            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, and_tmp to cstr)
            append_cstr(ref (deref self).main_out, " = alloca i1\n")

            append_cstr(ref (deref self).main_out, "  store i1 false, ptr ")
            append_cstr(ref (deref self).main_out, and_tmp to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "  br i1 ")
            append_cstr(ref (deref self).main_out, left_bool to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, eval_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, done_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, eval_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")

            let right_reg as ptr[u8] = self.emit_expr(right)
            let right_type as String = cond_llvm_type(right)
            var right_bool as ptr[u8] = right_reg
            let right_is_cmp as bool = node_kind(right) == NodeType.BinaryExpr or node_kind(right) == NodeType.BooleanLiteral
            if right_type.data != None to ptr[u8] and strcmp(right_type.data to cstr, "ptr" to cstr) == 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
                append_cstr(ref (deref self).main_out, right_reg to cstr)
                append_cstr(ref (deref self).main_out, ", null\n")
                right_bool = temp
            elif right_type.data != None to ptr[u8] and not right_is_cmp and strcmp(right_type.data to cstr, "i1" to cstr) != 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ")
                append_str(ref (deref self).main_out, right_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, right_reg to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")
                right_bool = temp

            append_cstr(ref (deref self).main_out, "  store i1 ")
            append_cstr(ref (deref self).main_out, right_bool to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, and_tmp to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, done_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, done_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")

            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = load i1, ptr ")
            append_cstr(ref (deref self).main_out, and_tmp to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            return reg

        elif strcmp(op.data to cstr, "or" to cstr) == 0:
            let left_reg as ptr[u8] = self.emit_expr(left)
            let left_type as String = cond_llvm_type(left)
            let reg as ptr[u8] = self.fresh_temp()
            let or_tmp as ptr[u8] = self.fresh_temp()
            let eval_label as ptr[u8] = self.fresh_label()
            let done_label as ptr[u8] = self.fresh_label()

            var left_bool as ptr[u8] = left_reg
            let left_is_cmp as bool = node_kind(left) == NodeType.BinaryExpr or node_kind(left) == NodeType.BooleanLiteral
            if strcmp(left_type.data to cstr, "ptr" to cstr) == 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
                append_cstr(ref (deref self).main_out, left_reg to cstr)
                append_cstr(ref (deref self).main_out, ", null\n")
                left_bool = temp
            elif not left_is_cmp and strcmp(left_type.data to cstr, "i1" to cstr) != 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ")
                append_str(ref (deref self).main_out, left_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, left_reg to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")
                left_bool = temp

            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, or_tmp to cstr)
            append_cstr(ref (deref self).main_out, " = alloca i1\n")

            append_cstr(ref (deref self).main_out, "  store i1 true, ptr ")
            append_cstr(ref (deref self).main_out, or_tmp to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "  br i1 ")
            append_cstr(ref (deref self).main_out, left_bool to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, done_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, eval_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, eval_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")

            let right_reg as ptr[u8] = self.emit_expr(right)
            let right_type as String = cond_llvm_type(right)
            var right_bool as ptr[u8] = right_reg
            let right_is_cmp as bool = node_kind(right) == NodeType.BinaryExpr or node_kind(right) == NodeType.BooleanLiteral
            if strcmp(right_type.data to cstr, "ptr" to cstr) == 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
                append_cstr(ref (deref self).main_out, right_reg to cstr)
                append_cstr(ref (deref self).main_out, ", null\n")
                right_bool = temp
            elif not right_is_cmp and strcmp(right_type.data to cstr, "i1" to cstr) != 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ")
                append_str(ref (deref self).main_out, right_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, right_reg to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")
                right_bool = temp

            append_cstr(ref (deref self).main_out, "  store i1 ")
            append_cstr(ref (deref self).main_out, right_bool to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, or_tmp to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, done_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, done_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")

