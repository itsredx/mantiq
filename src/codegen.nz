fn type_to_llvm(t as ptr[Type]) as String:
    if t == None to ptr[Type]:
        return String.make("i64" to cstr)
    let k as TypeKind = (deref t).kind
    if k == TypeKind.Void:
        return String.make("void" to cstr)
    if k == TypeKind.I8 or k == TypeKind.U8 or k == TypeKind.Boolean or k == TypeKind.Char:
        return String.make("i8" to cstr)
    if k == TypeKind.I16 or k == TypeKind.U16:
        return String.make("i16" to cstr)
    if k == TypeKind.I32 or k == TypeKind.U32:
        return String.make("i32" to cstr)
    if k == TypeKind.I64 or k == TypeKind.U64 or k == TypeKind.ISize or k == TypeKind.USize:
        return String.make("i64" to cstr)
    if k == TypeKind.I128 or k == TypeKind.U128:
        return String.make("i128" to cstr)
    if k == TypeKind.F16:
        return String.make("half" to cstr)
    if k == TypeKind.BFloat16:
        return String.make("bfloat" to cstr)
    if k == TypeKind.F32:
        return String.make("float" to cstr)
    if k == TypeKind.F64:
        return String.make("double" to cstr)
    if k == TypeKind.F128:
        return String.make("fp128" to cstr)
    if k == TypeKind.String:
        return String.make("{ ptr, i64, i64 }" to cstr)
    if k == TypeKind.CStr:
        return String.make("ptr" to cstr)
    if k == TypeKind.RawPointer:
        return String.make("ptr" to cstr)
    if k == TypeKind.List:
        return String.make("{ ptr, i64, i64 }" to cstr)
    if k == TypeKind.Dict:
        return String.make("{ ptr, i64, i64 }" to cstr)
    if k == TypeKind.Option:
        return String.make("{ i8, ptr, i64, i64 }" to cstr)
    if k == TypeKind.Result:
        return String.make("{ i8, ptr, ptr }" to cstr)
    if k == TypeKind.Any:
        return String.make("{ ptr, ptr }" to cstr)
    if k == TypeKind.Struct:
        let t_name as cstr = (deref t).name.data to cstr
        if t_name != None to cstr and (deref t).name.len > 0 to usize and (deref t_name) == 91 to u8:
            return String.make("ptr" to cstr)
        let sb_struct as StringBuilder = StringBuilder.make()
        append_cstr(ref sb_struct, "%" to cstr)
        if t_name != None to cstr:
            extern fn strchr(s as cstr, c as i32) as cstr
            let brace as cstr = strchr(t_name, '[' to i32)
            if brace != None to cstr:
                let base_len as usize = (brace to usize) - (t_name to usize)
                extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
                extern fn free(p as ptr)
                let buf as ptr[u8] = make[u8](base_len + 1 to usize) to ptr[u8]
                let _m as ptr = memcpy(buf to ptr, t_name to ptr, base_len)
                buf[base_len] = 0 to u8
                append_cstr(ref sb_struct, buf to cstr)
            else:
                append_str(ref sb_struct, (deref t).name)
        else:
            append_str(ref sb_struct, (deref t).name)
        return sb_struct.to_string()
    if k == TypeKind.Enum:
        return String.make("i32" to cstr)
    if k == TypeKind.Union:
        let sb_union as StringBuilder = StringBuilder.make()
        append_cstr(ref sb_union, "%" to cstr)
        append_str(ref sb_union, (deref t).name)
        return sb_union.to_string()
    return String.make("i64" to cstr)

fn type_size(t as ptr[Type]) as i64:
    if t == None to ptr[Type]:
        return 256 to i64
    let k as TypeKind = (deref t).kind
    if k == TypeKind.I8 or k == TypeKind.U8 or k == TypeKind.Boolean or k == TypeKind.Char:
        return 1 to i64
    if k == TypeKind.I16 or k == TypeKind.U16:
        return 2 to i64
    if k == TypeKind.I32 or k == TypeKind.U32 or k == TypeKind.F32:
        return 4 to i64
    if k == TypeKind.I64 or k == TypeKind.U64 or k == TypeKind.ISize or k == TypeKind.USize or k == TypeKind.F64 or k == TypeKind.RawPointer or k == TypeKind.CStr:
        return 8 to i64
    if k == TypeKind.String or k == TypeKind.List or k == TypeKind.Dict:
        return 24 to i64
    if k == TypeKind.Option:
        return 32 to i64
    return 256 to i64

// ── LLVMCodegen ─────────────────────────────────────────────────────────
struct LLVMCodegen:
    public var type_out as StringBuilder
    public var outlined_out as StringBuilder
    public var metadata_out as StringBuilder
    public var main_out as StringBuilder
    public var temp_counter as i32
    public var label_counter as i32
    public var string_counter as i32
    public var closure_counter as i32
    public var defined_types as Dict[String, bool]
    public var external_decls as Dict[String, bool]
    public var auto_drops as Dict[usize, List[String]]
    public var var_slots as Dict[String, String]
    public var var_counts as Dict[String, i32]
    public var defined_functions as Dict[String, bool]
    public var current_return_type as String

    public fn init_cg(self as ptr[LLVMCodegen]):
        (deref self).type_out = StringBuilder.make()
        (deref self).outlined_out = StringBuilder.make()
        (deref self).metadata_out = StringBuilder.make()
        (deref self).main_out = StringBuilder.make()
        (deref self).temp_counter = 1
        (deref self).label_counter = 1
        (deref self).string_counter = 1
        (deref self).closure_counter = 1
        (deref self).defined_types = Dict[String, bool]()
        (deref self).external_decls = Dict[String, bool]()
        (deref self).auto_drops = Dict[usize, List[String]]()
        (deref self).var_slots = Dict[String, String]()
        (deref self).var_counts = Dict[String, i32]()
        (deref self).defined_functions = Dict[String, bool]()
        (deref self).current_return_type = String.make("void" to cstr)

    public fn fresh_temp(self as ptr[LLVMCodegen]) as ptr[u8]:
        let buf as ptr[u8] = make(32 to usize) to ptr[u8]
        let _ as i32 = sprintf(buf, "%%t.%d" to cstr, (deref self).temp_counter)
        (deref self).temp_counter = (deref self).temp_counter + 1 to i32
        return buf

    public fn fresh_label(self as ptr[LLVMCodegen]) as ptr[u8]:
        let buf as ptr[u8] = make(32 to usize) to ptr[u8]
        let _ as i32 = sprintf(buf, "label_%d" to cstr, (deref self).label_counter)
        (deref self).label_counter = (deref self).label_counter + 1 to i32
        return buf

    public fn fresh_closure_name(self as ptr[LLVMCodegen]) as ptr[u8]:
        let buf as ptr[u8] = make(64 to usize) to ptr[u8]
        let _ as i32 = sprintf(buf, "__closure_%d" to cstr, (deref self).closure_counter)
        (deref self).closure_counter = (deref self).closure_counter + 1 to i32
        return buf

    public fn emit_builtin_struct_types(self as ptr[LLVMCodegen]):
        if not (deref self).defined_types.has(String.make("Lowerer" to cstr)):
            append_cstr(ref (deref self).type_out, "%Lowerer = type { { ptr, ptr }, i32, { ptr, ptr }, { ptr, ptr }, { ptr, ptr }, i64 }\n\n" to cstr)
            set_dict_bool(ref (deref self).defined_types, String.make("Lowerer" to cstr), True)
        if not (deref self).defined_types.has(String.make("Sema" to cstr)):
            append_cstr(ref (deref self).type_out, "%Sema = type { ptr, ptr, { ptr, ptr }, { ptr, ptr }, { ptr, ptr }, { ptr, ptr }, i32 }\n\n" to cstr)
            set_dict_bool(ref (deref self).defined_types, String.make("Sema" to cstr), True)
        if not (deref self).defined_types.has(String.make("TypeChecker" to cstr)):
            append_cstr(ref (deref self).type_out, "%TypeChecker = type { ptr, { i32, ptr }, ptr }\n\n" to cstr)
            set_dict_bool(ref (deref self).defined_types, String.make("TypeChecker" to cstr), True)
        if not (deref self).defined_types.has(String.make("BorrowChecker" to cstr)):
            append_cstr(ref (deref self).type_out, "%BorrowChecker = type { ptr, { ptr, ptr }, { ptr, ptr } }\n\n" to cstr)
            set_dict_bool(ref (deref self).defined_types, String.make("BorrowChecker" to cstr), True)
        if not (deref self).defined_types.has(String.make("LLVMCodegen" to cstr)):
            append_cstr(ref (deref self).type_out, "%LLVMCodegen = type { { ptr, ptr }, { ptr, ptr }, { ptr, ptr }, { ptr, ptr }, i32, i32, i32, i32, { ptr, ptr }, { ptr, ptr }, { ptr, ptr } }\n\n" to cstr)
            set_dict_bool(ref (deref self).defined_types, String.make("LLVMCodegen" to cstr), True)
        if not (deref self).defined_types.has(String.make("Node" to cstr)):
            append_cstr(ref (deref self).type_out, "%Node = type { i32, { i64, i64, i64, i64 }, { ptr, ptr }, ptr, ptr, ptr, { ptr, ptr }, { ptr, ptr }, { ptr, ptr }, ptr, ptr, { ptr, ptr }, { ptr, ptr }, { ptr, ptr }, ptr, i8, i8, i8, ptr, i8, ptr, ptr, ptr, { ptr, ptr }, { ptr, ptr }, { ptr, ptr }, { ptr, ptr } }\n\n" to cstr)
            set_dict_bool(ref (deref self).defined_types, String.make("Node" to cstr), True)
        if not (deref self).defined_types.has(String.make("Span" to cstr)):
            append_cstr(ref (deref self).type_out, "%Span = type { i64, i64, i64, i64 }\n\n" to cstr)
            set_dict_bool(ref (deref self).defined_types, String.make("Span" to cstr), True)
        if not (deref self).defined_types.has(String.make("Label" to cstr)):
            append_cstr(ref (deref self).type_out, "%Label = type { %Span, { ptr, i64, i64 }, i32 }\n\n" to cstr)
            set_dict_bool(ref (deref self).defined_types, String.make("Label" to cstr), True)
        if not (deref self).defined_types.has(String.make("Suggestion" to cstr)):
            append_cstr(ref (deref self).type_out, "%Suggestion = type { %Span, { ptr, i64, i64 }, { ptr, i64, i64 } }\n\n" to cstr)
            set_dict_bool(ref (deref self).defined_types, String.make("Suggestion" to cstr), True)
        if not (deref self).defined_types.has(String.make("Diagnostic" to cstr)):
            append_cstr(ref (deref self).type_out, "%Diagnostic = type { i32, ptr, { ptr, i64, i64 }, { ptr, i64, i64 }, %Span, { ptr, ptr }, ptr, { ptr, ptr }, { ptr, ptr }, { ptr, ptr } }\n\n" to cstr)
            set_dict_bool(ref (deref self).defined_types, String.make("Diagnostic" to cstr), True)

    public fn generate(self as ptr[LLVMCodegen], root as ptr[Node]) as String:
        set_dict_bool(ref (deref self).external_decls, String.make("malloc" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("free" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_free" to cstr), True)
        set_dict_bool(ref (deref self).external_decls, String.make("mantiq_malloc" to cstr), True)
        append_cstr(ref (deref self).type_out, "declare ptr @mantiq_malloc(i64)\n")
        self.emit_builtin_struct_types()
        self.emit_node(root)
        let out as StringBuilder = StringBuilder.make()
        append_cstr(ref out, "; ModuleID = 'MantiqModule'\n")
        append_cstr(ref out, "source_filename = \"test\"\n")
        append_cstr(ref out, "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"\n")
        append_cstr(ref out, "target triple = \"x86_64-unknown-linux-gnu\"\n\n")
        append_cstr(ref out, "declare ptr @malloc(i64)\n")
        append_cstr(ref out, "declare void @free(ptr)\n")
        append_cstr(ref out, "declare void @mantiq_free(ptr)\n\n")
        append_str(ref out, (deref self).type_out.to_string())
        append_str(ref out, (deref self).main_out.to_string())
        append_str(ref out, (deref self).outlined_out.to_string())
        append_str(ref out, (deref self).metadata_out.to_string())
        return out.to_string()

    public fn emit_node(self as ptr[LLVMCodegen], node as ptr[Node]):
        if node == None to ptr[Node]:
            return
        let nt as NodeType = node_kind(node)
        if nt == NodeType.Program:
            self.emit_program(node)
        elif nt == NodeType.FunDecl:
            self.emit_fun_decl(node)
        elif nt == NodeType.VarDecl:
            self.emit_var_decl(node)
        elif nt == NodeType.BinaryExpr:
            self.emit_binary_stmt(node)
        elif nt == NodeType.Identifier:
            pass
        elif nt == NodeType.NumberLiteral:
            pass
        elif nt == NodeType.StringLiteral:
            pass
        elif nt == NodeType.CallExpr:
            self.emit_call_stmt(node)
        elif nt == NodeType.ReturnStmt:
            self.emit_return(node)
        elif nt == NodeType.IfStmt:
            self.emit_if(node)
        elif nt == NodeType.WhileStmt:
            self.emit_while(node)
        elif nt == NodeType.ForStmt:
            self.emit_for(node)
        elif nt == NodeType.BlockStmt:
            self.emit_block(node)
        elif nt == NodeType.UnaryExpr: // UnaryExpr as statement
            let _ as ptr[u8] = self.emit_expr(node)
        elif nt == NodeType.CastExpr: // CastExpr as statement
            let _ as ptr[u8] = self.emit_expr(node)
        elif nt == NodeType.ListLiteral: // ListLiteral as statement
            let _ as ptr[u8] = self.emit_expr(node)
        elif nt == NodeType.IndexExpr: // IndexExpr as statement
            let _ as ptr[u8] = self.emit_expr(node)
        elif nt == NodeType.StructDecl: // StructDecl
            self.emit_struct_decl(node)
        elif nt == NodeType.EnumDecl: // EnumDecl
            self.emit_enum_decl(node)
        elif nt == NodeType.UnionDecl: // UnionDecl
            self.emit_union_decl(node)

    public fn emit_program(self as ptr[LLVMCodegen], node as ptr[Node]):
        let decls as List[ptr[Node]] = node_declarations(node)
        let count as i64 = decls.length()
        var i as i64 = 0 to i64
        while i < count:
            self.emit_node(get_node_decl(ref decls, i))
            i = i + 1 to i64

    public fn emit_fun_decl(self as ptr[LLVMCodegen], node as ptr[Node]):
        let name as String = node_name(node)
        if strcmp(name.data to cstr, "__init__" to cstr) == 0:
            return
        if (deref self).defined_functions.has(name):
            return
        set_dict_bool(ref (deref self).defined_functions, name, True)
        let params as List[ptr[Node]] = node_params(node)
        let body as ptr[Node] = node_body(node)
        var ret_type as String = type_to_llvm(node_inferred_type(node))
        if strcmp(name.data to cstr, "memset" to cstr) == 0:
            ret_type = String.make("ptr" to cstr)

        // Handle extern functions: emit declare instead of define
        if node_is_extern(node):
            if (deref self).external_decls.has(name):
                return
            set_dict_bool(ref (deref self).external_decls, name, True)
            let param_buf as StringBuilder = StringBuilder.make()
            let p_count as i64 = params.length()
            var p_idx as i64 = 0 to i64
            while p_idx < p_count:
                let p as ptr[Node] = get_node_decl(ref params, p_idx)
                let p_type as String = type_to_llvm(node_inferred_type(p))
                append_str(ref param_buf, p_type)
                if p_idx < p_count - 1 to i64:
                    append_cstr(ref param_buf, ", ")
                p_idx = p_idx + 1 to i64
            if node_is_variadic(node):
                if p_count > 0 to i64:
                    append_cstr(ref param_buf, ", ")
                append_cstr(ref param_buf, "...")
            append_cstr(ref (deref self).type_out, "declare ")
            append_str(ref (deref self).type_out, ret_type)
            append_cstr(ref (deref self).type_out, " @")
            append_str(ref (deref self).type_out, name)
            append_cstr(ref (deref self).type_out, "(")
            append_str(ref (deref self).type_out, param_buf.to_string())
            append_cstr(ref (deref self).type_out, ")\n")
            return
        let has_return as bool = str_eq(ret_type, String.make("void" to cstr)) == False

        let param_buf as StringBuilder = StringBuilder.make()
        let p_count as i64 = params.length()
        var p_idx as i64 = 0 to i64
        while p_idx < p_count:
            let param as ptr[Node] = get_node_decl(ref params, p_idx)
            let param_type as String = type_to_llvm(node_inferred_type(param))
            append_str(ref param_buf, param_type)
            append_cstr(ref param_buf, " %")
            append_str(ref param_buf, node_name(param))
            append_cstr(ref param_buf, "_param")
            if p_idx < p_count - 1 to i64:
                append_cstr(ref param_buf, ", ")
            p_idx = p_idx + 1 to i64

        append_cstr(ref (deref self).main_out, "define ")
        append_str(ref (deref self).main_out, ret_type)
        append_cstr(ref (deref self).main_out, " @")
        append_str(ref (deref self).main_out, name)
        append_cstr(ref (deref self).main_out, "(")
        append_str(ref (deref self).main_out, param_buf.to_string())
        append_cstr(ref (deref self).main_out, ") {\n")
        append_cstr(ref (deref self).main_out, "entry:\n")

        (deref self).current_return_type = ret_type
        (deref self).var_slots = Dict[String, String]()
        (deref self).var_counts = Dict[String, i32]()

        p_idx = 0 to i64
        while p_idx < p_count:
            let p as ptr[Node] = get_node_decl(ref params, p_idx)
            let p_name as String = node_name(p)
            set_dict_i32(ref (deref self).var_counts, p_name, 1 to i32)
            set_dict_str(ref (deref self).var_slots, p_name, p_name)
            let p_type as String = type_to_llvm(node_inferred_type(p))
            append_cstr(ref (deref self).main_out, "  %")
            append_str(ref (deref self).main_out, p_name)
            append_cstr(ref (deref self).main_out, " = alloca ")
            append_str(ref (deref self).main_out, p_type)
            append_cstr(ref (deref self).main_out, "\n  store ")
            append_str(ref (deref self).main_out, p_type)
            append_cstr(ref (deref self).main_out, " %")
            append_str(ref (deref self).main_out, p_name)
            append_cstr(ref (deref self).main_out, "_param, ptr %")
            append_str(ref (deref self).main_out, p_name)
            append_cstr(ref (deref self).main_out, "\n")
            p_idx = p_idx + 1 to i64

        if body != None to ptr[Node]:
            self.emit_node(body)

        if not has_return:
            append_cstr(ref (deref self).main_out, "  ret void\n")
        append_cstr(ref (deref self).main_out, "}\n\n")

    public fn emit_var_decl(self as ptr[LLVMCodegen], node as ptr[Node]):
        let name_ptr as ptr[String] = node_name_ptr(node)
        let var_type as String = type_to_llvm(node_inferred_type(node))
        let init_node as ptr[Node] = node_left(node)

        var var_name as String = String.make("" to cstr)
        if name_ptr != None to ptr[String]:
            var_name = deref name_ptr
        if var_name.len == 0:
            let anon as ptr[u8] = self.fresh_temp()
            var_name = String.make(anon to cstr)
            if (deref var_name.data) == 37 to u8:
                var_name.data = (var_name.data to usize + 1 to usize) to ptr[u8]
                var_name.len = var_name.len - 1

        var count as i32 = 0 to i32
        if (deref self).var_counts.has(var_name):
            count = (deref self).var_counts[var_name]
        set_dict_i32(ref (deref self).var_counts, var_name, count + 1 to i32)
        var slot_name as String = var_name
        if count > 0 to i32:
            let slot_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
            let _ as i32 = sprintf(slot_buf, "%s_%d" to cstr, var_name.data to cstr, count)
            slot_name = String.make(slot_buf to cstr)
        set_dict_str(ref (deref self).var_slots, var_name, slot_name)

        append_cstr(ref (deref self).main_out, "  %")
        append_str(ref (deref self).main_out, slot_name)
        append_cstr(ref (deref self).main_out, " = alloca ")
        append_str(ref (deref self).main_out, var_type)
        append_cstr(ref (deref self).main_out, "\n")

        if init_node != None to ptr[Node]:
            let val_reg as ptr[u8] = self.emit_expr(init_node)
            var final_reg as ptr[u8] = val_reg
            let val_type as String = type_to_llvm(node_inferred_type(init_node))
            if strcmp(var_type.data to cstr, "ptr" to cstr) == 0 and (strcmp(val_type.data to cstr, "i64" to cstr) == 0 or strcmp(val_type.data to cstr, "i32" to cstr) == 0) and (deref val_reg) != 37 to u8:
                let ptr_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, ptr_temp to cstr)
                append_cstr(ref (deref self).main_out, " = inttoptr ")
                append_str(ref (deref self).main_out, val_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, " to ptr\n")
                final_reg = ptr_temp
            elif strcmp(var_type.data to cstr, "i64" to cstr) == 0 and strcmp(val_type.data to cstr, "ptr" to cstr) == 0:
                let int_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, int_temp to cstr)
                append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, " to i64\n")
                final_reg = int_temp
            elif ((deref var_type.data) == 123 to u8 or (deref var_type.data) == 37 to u8) and strcmp(var_type.data to cstr, val_type.data to cstr) != 0 and strcmp(val_reg to cstr, "zeroinitializer" to cstr) != 0:
                let agg_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, agg_temp to cstr)
                append_cstr(ref (deref self).main_out, " = insertvalue ")
                append_str(ref (deref self).main_out, var_type)
                append_cstr(ref (deref self).main_out, " undef, ")
                var actual_val_type as String = val_type
                if (deref val_reg) == 37 to u8:
                    actual_val_type = String.make("ptr" to cstr)
                append_str(ref (deref self).main_out, actual_val_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")
                final_reg = agg_temp

            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, var_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, final_reg to cstr)
            append_cstr(ref (deref self).main_out, ", ptr %")
            append_str(ref (deref self).main_out, slot_name)
            append_cstr(ref (deref self).main_out, "\n")
        else:
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, var_type)
            append_cstr(ref (deref self).main_out, " zeroinitializer, ptr %")
            append_str(ref (deref self).main_out, slot_name)
            append_cstr(ref (deref self).main_out, "\n")

    public fn emit_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        if node == None to ptr[Node]:
            return "void" to ptr[u8]
        let nt as NodeType = node_kind(node)
        if nt == NodeType.NumberLiteral:
            let val as f64 = node_val(node)
            let inf_t as ptr[Type] = node_inferred_type(node)
            var is_float as bool = False
            if inf_t != None to ptr[Type]:
                let tk as TypeKind = (deref inf_t).kind
                if tk == TypeKind.F32 or tk == TypeKind.F64:
                    is_float = True
            let buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
            if is_float:
                let _ as i32 = sprintf(buf, "%g" to cstr, val)
            else:
                let _ as i32 = sprintf(buf, "%lld" to cstr, val to i64)
            return buf
        elif nt == NodeType.Identifier:
            let id_name_ptr as ptr[String] = node_name_ptr(node)
            if id_name_ptr != None to ptr[String]:
                let name_cstr as cstr = (deref id_name_ptr).data to cstr
                if strcmp(name_cstr, "Empty" to cstr) == 0 or strcmp(name_cstr, "None" to cstr) == 0:
                    return "zeroinitializer" to ptr[u8]
                if strcmp(name_cstr, "True" to cstr) == 0 or strcmp(name_cstr, "true" to cstr) == 0:
                    return "1" to ptr[u8]
                if strcmp(name_cstr, "False" to cstr) == 0 or strcmp(name_cstr, "false" to cstr) == 0:
                    return "0" to ptr[u8]
                if strcmp(name_cstr, "UNSUPPORTED" to cstr) == 0:
                    return "0" to ptr[u8]
            var var_type as String = type_to_llvm(node_inferred_type(node))
            let id_nm_str as String = node_name(node)
            if strcmp(id_nm_str.data to cstr, "self" to cstr) == 0:
                var_type = String.make("ptr" to cstr)
            if strcmp(var_type.data to cstr, "void" to cstr) == 0:
                return "0" to ptr[u8]
            let reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = load ")
            append_str(ref (deref self).main_out, var_type)
            append_cstr(ref (deref self).main_out, ", ptr %")
            if id_name_ptr != None to ptr[String]:
                var id_nm as String = deref id_name_ptr
                if (deref self).var_slots.has(id_nm):
                    id_nm = (deref self).var_slots[id_nm]
                append_str(ref (deref self).main_out, id_nm)
            append_cstr(ref (deref self).main_out, "\n")
            return reg
        elif nt == NodeType.BinaryExpr:
            return self.emit_binary_expr(node)
        elif nt == NodeType.CallExpr:
            return self.emit_call_expr(node)
        elif nt == NodeType.StringLiteral:
            let str_id as i32 = (deref self).string_counter
            (deref self).string_counter = (deref self).string_counter + 1 to i32
            let str_ptr as ptr[String] = node_str_val_ptr(node)
            var str_data as ptr[u8] = (deref str_ptr).data
            var str_len as i64 = (deref str_ptr).len to i64
            if (deref str_data) == 34 to u8 and str_len >= 2:
                str_data = (str_data to usize + 1 to usize) to ptr[u8]
                str_len = str_len - 2

            let escaped_buf as StringBuilder = StringBuilder.make()
            var raw_len as i64 = 0 to i64
            var i as i64 = 0 to i64
            while i < str_len:
                let b as u8 = str_data[i]
                if b == 92 to u8 and i < str_len - 1 to i64:
                    let nb as u8 = str_data[i + 1]
                    if nb == 110 to u8:
                        append_cstr(ref escaped_buf, "\\0A" to cstr)
                        i = i + 1 to i64
                    elif nb == 114 to u8:
                        append_cstr(ref escaped_buf, "\\0D" to cstr)
                        i = i + 1 to i64
                    elif nb == 116 to u8:
                        append_cstr(ref escaped_buf, "\\09" to cstr)
                        i = i + 1 to i64
                    elif nb == 34 to u8:
                        append_cstr(ref escaped_buf, "\\22" to cstr)
                        i = i + 1 to i64
                    elif nb == 92 to u8:
                        append_cstr(ref escaped_buf, "\\5C" to cstr)
                        i = i + 1 to i64
                    elif nb == 48 to u8:
                        append_cstr(ref escaped_buf, "\\00" to cstr)
                        i = i + 1 to i64
                    else:
                        append_cstr(ref escaped_buf, "\\5C" to cstr)
                elif b == 34 to u8:
                    append_cstr(ref escaped_buf, "\\22" to cstr)
                elif b == 92 to u8:
                    append_cstr(ref escaped_buf, "\\5C" to cstr)
                else:
                    var single as ptr[u8] = make(2 to usize) to ptr[u8]
                    single[0] = b
                    single[1] = 0 to u8
                    append_cstr(ref escaped_buf, single to cstr)
                raw_len = raw_len + 1 to i64
                i = i + 1 to i64

            append_cstr(ref (deref self).type_out, "@.str.")
            append_i32(ref (deref self).type_out, str_id)
            append_cstr(ref (deref self).type_out, " = private unnamed_addr constant [")
            append_i64(ref (deref self).type_out, raw_len + 1 to i64)
            append_cstr(ref (deref self).type_out, " x i8] c\"")
            append_str(ref (deref self).type_out, escaped_buf.to_string())
            append_cstr(ref (deref self).type_out, "\\00\"\n" to cstr)
            let reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = getelementptr [")
            append_i64(ref (deref self).main_out, raw_len + 1 to i64)
            append_cstr(ref (deref self).main_out, " x i8], ptr @.str.")
            append_i32(ref (deref self).main_out, str_id)
            append_cstr(ref (deref self).main_out, ", i32 0, i32 0\n")
            return reg
        elif nt == NodeType.UnaryExpr: // UnaryExpr
            return self.emit_unary_expr(node)
        elif nt == NodeType.CastExpr: // CastExpr
            return self.emit_cast_expr(node)
        elif nt == NodeType.ListLiteral: // ListLiteral
            return self.emit_list_literal(node)
        elif nt == NodeType.IndexExpr: // IndexExpr
            return self.emit_index_expr(node)
        elif nt == NodeType.MemberExpr: // MemberExpr
            let obj as ptr[Node] = node_left(node)
            if obj != None to ptr[Node] and node_kind(obj) == NodeType.Identifier and node_name(obj).data != None:
                let id_name as cstr = node_name(obj).data to cstr
                let variant_name as String = node_name(node)
                if variant_name.data != None:
                    let v_cstr as cstr = variant_name.data to cstr
                    if strcmp(id_name, "NodeType" to cstr) == 0 or strcmp(id_name, "TypeKind" to cstr) == 0 or strcmp(id_name, "LanguageMode" to cstr) == 0 or strcmp(id_name, "SymbolKind" to cstr) == 0 or strcmp(id_name, "LabelKind" to cstr) == 0 or strcmp(id_name, "Severity" to cstr) == 0:
                        return get_enum_variant_val(id_name, v_cstr)
            let obj_val as ptr[u8] = self.emit_expr(obj)
            let field_name as String = node_name(node)
            let obj_type as String = type_to_llvm(node_inferred_type(obj))
            if strcmp(obj_type.data to cstr, "{ ptr, i64, i64 }" to cstr) == 0 or strcmp(obj_type.data to cstr, "String" to cstr) == 0:
                if field_name.data != None:
                    if strcmp(field_name.data to cstr, "data" to cstr) == 0:
                        let reg as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, reg to cstr)
                        append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
                        append_cstr(ref (deref self).main_out, obj_val to cstr)
                        append_cstr(ref (deref self).main_out, ", 0\n")
                        set_node_inferred_type(node, make_type(TypeKind.RawPointer))
                        return reg
                    elif strcmp(field_name.data to cstr, "len" to cstr) == 0:
                        let reg as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, reg to cstr)
                        append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
                        append_cstr(ref (deref self).main_out, obj_val to cstr)
                        append_cstr(ref (deref self).main_out, ", 1\n")
                        set_node_inferred_type(node, make_type(TypeKind.I64))
                        return reg
            let field_ptr as ptr[u8] = self.emit_lvalue_ptr(node)
            var res_type as String = type_to_llvm(node_inferred_type(node))
            if field_name.data != None:
                var struct_name as String = String.make("Node" to cstr)
                if obj != None to ptr[Node]:
                    var target_t as ptr[Type] = node_inferred_type(obj)
                    if target_t != None to ptr[Type]:
                        if (deref target_t).kind == TypeKind.Struct:
                            struct_name = (deref target_t).name
                        elif (deref target_t).kind == TypeKind.RawPointer and (deref target_t).payload != None to ptr[Type]:
                            let pl as ptr[Type] = (deref target_t).payload
                            if (deref pl).kind == TypeKind.Struct:
                                struct_name = (deref pl).name
                if struct_name.data != None:
                    res_type = get_struct_field_type(struct_name.data to cstr, field_name.data to cstr)
            if strcmp(res_type.data to cstr, "void" to cstr) == 0:
                return field_ptr
            let reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = load ")
            append_str(ref (deref self).main_out, res_type)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, field_ptr to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return reg
        elif nt == NodeType.ClosureExpr: // ClosureExpr
            return self.emit_closure_expr(node)
        elif nt == NodeType.BooleanLiteral: // BooleanLiteral
            if node_val(node) == 1.0:
                return "1" to ptr[u8]
            else:
                return "0" to ptr[u8]
        return "void" to ptr[u8]

    public fn emit_lvalue_ptr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        if node == None to ptr[Node]:
            return "null" to ptr[u8]
        let nt as NodeType = node_kind(node)
        if nt == NodeType.Identifier:
            let name_ptr as ptr[String] = node_name_ptr(node)
            let ptr_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
            if name_ptr != None to ptr[String]:
                var var_nm as String = deref name_ptr
                if (deref self).var_slots.has(var_nm):
                    var_nm = (deref self).var_slots[var_nm]
                let _ as i32 = sprintf(ptr_buf, "%%%s" to cstr, var_nm.data to cstr)
            else:
                let _ as i32 = sprintf(ptr_buf, "%%tmp" to cstr)
            return ptr_buf
        elif nt == NodeType.UnaryExpr:
            let op as String = node_op(node)
            if strcmp(op.data to cstr, "deref" to cstr) == 0:
                return self.emit_expr(node_left(node))
            return self.emit_lvalue_ptr(node_left(node))
        elif nt == NodeType.CallExpr:
            let callee_node as ptr[Node] = node_left(node)
            if callee_node != None to ptr[Node] and node_kind(callee_node) == NodeType.Identifier and node_name(callee_node).data != None:
                if strcmp(node_name(callee_node).data to cstr, "deref" to cstr) == 0:
                    let args_list as List[ptr[Node]] = node_params(node)
                    if args_list.length() > 0 to i64:
                        return self.emit_lvalue_ptr(get_node_decl(ref args_list, 0 to i64))
        elif nt == NodeType.MemberExpr:
            let obj as ptr[Node] = node_left(node)
            let obj_ptr as ptr[u8] = self.emit_lvalue_ptr(obj)
            let field_name as String = node_name(node)
            var struct_name as String = String.make("" to cstr)
            var target_type as ptr[Type] = node_inferred_type(obj)
            if target_type == None to ptr[Type] and node_kind(obj) == NodeType.UnaryExpr:
                let inner_n as ptr[Node] = node_left(obj)
                if inner_n != None to ptr[Node]:
                    target_type = node_inferred_type(inner_n)
            if target_type != None to ptr[Type]:
                if (deref target_type).kind == TypeKind.Struct:
                    struct_name = (deref target_type).name
                elif (deref target_type).kind == TypeKind.RawPointer and (deref target_type).payload != None to ptr[Type]:
                    let pl as ptr[Type] = (deref target_type).payload
                    if (deref pl).kind == TypeKind.Struct:
                        struct_name = (deref pl).name
            if struct_name.len == 0 to usize and node_kind(obj) == NodeType.UnaryExpr:
                let inner_n as ptr[Node] = node_left(obj)
                if inner_n != None to ptr[Node] and node_kind(inner_n) == NodeType.Identifier and node_name(inner_n).data != None:
                    let id_n as cstr = node_name(inner_n).data to cstr
                    if strcmp(id_n, "lowerer" to cstr) == 0:
                        struct_name = String.make("Lowerer" to cstr)
                    elif strcmp(id_n, "sema" to cstr) == 0:
                        struct_name = String.make("Sema" to cstr)
                    elif strcmp(id_n, "tc" to cstr) == 0:
                        struct_name = String.make("TypeChecker" to cstr)
                    elif strcmp(id_n, "bc" to cstr) == 0:
                        struct_name = String.make("BorrowChecker" to cstr)
                    elif strcmp(id_n, "cg" to cstr) == 0:
                        struct_name = String.make("LLVMCodegen" to cstr)
                    elif strcmp(id_n, "self" to cstr) == 0:
                        struct_name = String.make("DiagnosticEngine" to cstr)
            if struct_name.len == 0 to usize:
                struct_name = String.make("Node" to cstr)
            if struct_name.len > 5 to usize and (deref struct_name.data) == 112 to u8 and (deref (struct_name.data to usize + 1 to usize) to ptr[u8]) == 116 to u8 and (deref (struct_name.data to usize + 2 to usize) to ptr[u8]) == 114 to u8 and (deref (struct_name.data to usize + 3 to usize) to ptr[u8]) == 91 to u8:
                let inner_l as usize = struct_name.len - 5 to usize
                let inner_b as ptr[u8] = make[u8](inner_l + 1 to usize) to ptr[u8]
                var c_i as usize = 0 to usize
                while c_i < inner_l:
                    inner_b[c_i] = deref ((struct_name.data to usize + 4 to usize + c_i) to ptr[u8])
                    c_i = c_i + 1 to usize
                inner_b[inner_l] = 0 to u8
                struct_name = String.make(inner_b to cstr)
            var field_idx as i32 = 0 to i32
            if field_name.data != None:
                let s_cstr as cstr = struct_name.data to cstr
                let f_cstr as cstr = field_name.data to cstr
                if strcmp(s_cstr, "Lowerer" to cstr) == 0:
                    if strcmp(f_cstr, "source_code" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "mode" to cstr) == 0:
                        field_idx = 1 to i32
                    elif strcmp(f_cstr, "file_path" to cstr) == 0:
                        field_idx = 2 to i32
                    elif strcmp(f_cstr, "macros" to cstr) == 0:
                        field_idx = 3 to i32
                    elif strcmp(f_cstr, "macro_args" to cstr) == 0:
                        field_idx = 4 to i32
                    elif strcmp(f_cstr, "next_hygiene_id" to cstr) == 0:
                        field_idx = 5 to i32
                elif strcmp(s_cstr, "Sema" to cstr) == 0:
                    if strcmp(f_cstr, "current_scope" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "global_scope" to cstr) == 0:
                        field_idx = 1 to i32
                    elif strcmp(f_cstr, "loaded_modules" to cstr) == 0:
                        field_idx = 2 to i32
                    elif strcmp(f_cstr, "fn_scopes" to cstr) == 0:
                        field_idx = 3 to i32
                    elif strcmp(f_cstr, "errors" to cstr) == 0:
                        field_idx = 4 to i32
                    elif strcmp(f_cstr, "current_file" to cstr) == 0:
                        field_idx = 5 to i32
                    elif strcmp(f_cstr, "mode" to cstr) == 0:
                        field_idx = 6 to i32
                elif strcmp(s_cstr, "TypeChecker" to cstr) == 0:
                    if strcmp(f_cstr, "sema" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "current_function_return" to cstr) == 0:
                        field_idx = 1 to i32
                    elif strcmp(f_cstr, "inferred_return_type" to cstr) == 0:
                        field_idx = 2 to i32
                elif strcmp(s_cstr, "BorrowChecker" to cstr) == 0:
                    if strcmp(f_cstr, "sema" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "current_file" to cstr) == 0:
                        field_idx = 1 to i32
                    elif strcmp(f_cstr, "symbol_states" to cstr) == 0:
                        field_idx = 2 to i32
                else:
                    if strcmp(f_cstr, "kind" to cstr) == 0:
                        field_idx = 0 to i32
                    elif strcmp(f_cstr, "span" to cstr) == 0:
                        field_idx = 1 to i32
                    elif strcmp(f_cstr, "module_name" to cstr) == 0:
                        field_idx = 2 to i32
                    elif strcmp(f_cstr, "inferred_type" to cstr) == 0:
                        field_idx = 3 to i32
                    elif strcmp(f_cstr, "auto_drops" to cstr) == 0:
                        field_idx = 4 to i32
                    elif strcmp(f_cstr, "target" to cstr) == 0:
                        field_idx = 5 to i32
                    elif strcmp(f_cstr, "data" to cstr) == 0:
                        field_idx = 6 to i32

            let obj_type_str as String = type_to_llvm(node_inferred_type(obj))
            var ptr_temp as ptr[u8] = obj_ptr
            let is_deref as bool = node_kind(obj) == NodeType.UnaryExpr and strcmp(node_op(obj).data to cstr, "deref" to cstr) == 0
            var p_check as ptr[u8] = obj_ptr
            if p_check != None to ptr[u8]:
                while (deref p_check) == 32 to u8 or (deref p_check) == 9 to u8:
                    p_check = (p_check to usize + 1 to usize) to ptr[u8]
            let is_ptr_reg as bool = p_check != None to ptr[u8] and (deref p_check) == 37 to u8
            if strcmp(obj_type_str.data to cstr, "ptr" to cstr) != 0 and not is_deref and not is_ptr_reg:
                if (deref obj_type_str.data) == 123 to u8: // '{'
                    let ext_reg as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, ext_reg to cstr)
                    append_cstr(ref (deref self).main_out, " = extractvalue ")
                    append_str(ref (deref self).main_out, obj_type_str)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, obj_ptr to cstr)
                    append_cstr(ref (deref self).main_out, ", 0\n")
                    ptr_temp = ext_reg
                else:
                    var int_type as String = String.make("i64" to cstr)
                    if strcmp(obj_type_str.data to cstr, "i32" to cstr) == 0:
                        int_type = String.make("i32" to cstr)

                    let t_reg as ptr[u8] = self.fresh_temp()
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, t_reg to cstr)
                    append_cstr(ref (deref self).main_out, " = inttoptr ")
                    append_str(ref (deref self).main_out, int_type)
                    append_cstr(ref (deref self).main_out, " ")
                    append_cstr(ref (deref self).main_out, obj_ptr to cstr)
                    append_cstr(ref (deref self).main_out, " to ptr\n")
                    ptr_temp = t_reg

            let gep_reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, gep_reg to cstr)
            append_cstr(ref (deref self).main_out, " = getelementptr inbounds %")
            append_str(ref (deref self).main_out, struct_name)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, ptr_temp to cstr)
            append_cstr(ref (deref self).main_out, ", i32 0, i32 ")
            append_i32(ref (deref self).main_out, field_idx)
            append_cstr(ref (deref self).main_out, "\n")
            return gep_reg
        elif nt == NodeType.IndexExpr:
            return self.emit_index_expr(node)
        return self.emit_expr(node)

    public fn emit_binary_stmt(self as ptr[LLVMCodegen], node as ptr[Node]):
        let op as String = node_op(node)
        let left as ptr[Node] = node_left(node)
        let right as ptr[Node] = node_right(node)
        if op.data == None:
            return
        if strcmp(op.data to cstr, "=" to cstr) == 0:
            let val_reg as ptr[u8] = self.emit_expr(right)
            var val_type as String = type_to_llvm(node_inferred_type(left))
            if node_kind(left) == NodeType.MemberExpr:
                let field_name as String = node_name(left)
                if field_name.data != None:
                    val_type = get_struct_field_type("Node" to cstr, field_name.data to cstr)
            elif node_kind(right) == NodeType.MemberExpr:
                let field_name as String = node_name(right)
                if field_name.data != None:
                    val_type = get_struct_field_type("Node" to cstr, field_name.data to cstr)
            if strcmp(val_type.data to cstr, "void" to cstr) == 0:
                val_type = String.make("ptr" to cstr)
            if (deref val_reg) >= 48 to u8 and (deref val_reg) <= 57 to u8:
                val_type = String.make("i32" to cstr)
            let target_ptr_reg as ptr[u8] = self.emit_lvalue_ptr(left)
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, val_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, val_reg to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, target_ptr_reg to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return
        let _ as ptr[u8] = self.emit_binary_expr(node)

    public fn emit_binary_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let op as String = node_op(node)
        let left as ptr[Node] = node_left(node)
        let right as ptr[Node] = node_right(node)

        if strcmp(op.data to cstr, "and" to cstr) == 0:
            let left_reg as ptr[u8] = self.emit_expr(left)
            let left_type as String = type_to_llvm(node_inferred_type(left))
            let reg as ptr[u8] = self.fresh_temp()
            let and_tmp as ptr[u8] = self.fresh_temp()
            let eval_label as ptr[u8] = self.fresh_label()
            let done_label as ptr[u8] = self.fresh_label()

            var left_bool as ptr[u8] = left_reg
            let left_is_cmp as bool = node_kind(left) == NodeType.BinaryExpr or node_kind(left) == NodeType.BooleanLiteral
            if strcmp(left_type.data to cstr, "ptr" to cstr) == 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
                append_cstr(ref (deref self).main_out, left_reg to cstr)
                append_cstr(ref (deref self).main_out, ", null\n")
                left_bool = temp
            elif not left_is_cmp and strcmp(left_type.data to cstr, "i1" to cstr) != 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ")
                append_str(ref (deref self).main_out, left_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, left_reg to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")
                left_bool = temp

            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, and_tmp to cstr)
            append_cstr(ref (deref self).main_out, " = alloca i1\n")

            append_cstr(ref (deref self).main_out, "  store i1 false, ptr ")
            append_cstr(ref (deref self).main_out, and_tmp to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "  br i1 ")
            append_cstr(ref (deref self).main_out, left_bool to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, eval_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, done_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, eval_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")

            let right_reg as ptr[u8] = self.emit_expr(right)
            let right_type as String = type_to_llvm(node_inferred_type(right))
            var right_bool as ptr[u8] = right_reg
            let right_is_cmp as bool = node_kind(right) == NodeType.BinaryExpr or node_kind(right) == NodeType.BooleanLiteral
            if strcmp(right_type.data to cstr, "ptr" to cstr) == 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
                append_cstr(ref (deref self).main_out, right_reg to cstr)
                append_cstr(ref (deref self).main_out, ", null\n")
                right_bool = temp
            elif not right_is_cmp and strcmp(right_type.data to cstr, "i1" to cstr) != 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ")
                append_str(ref (deref self).main_out, right_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, right_reg to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")
                right_bool = temp

            append_cstr(ref (deref self).main_out, "  store i1 ")
            append_cstr(ref (deref self).main_out, right_bool to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, and_tmp to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, done_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, done_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")

            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = load i1, ptr ")
            append_cstr(ref (deref self).main_out, and_tmp to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            return reg

        elif strcmp(op.data to cstr, "or" to cstr) == 0:
            let left_reg as ptr[u8] = self.emit_expr(left)
            let left_type as String = type_to_llvm(node_inferred_type(left))
            let reg as ptr[u8] = self.fresh_temp()
            let or_tmp as ptr[u8] = self.fresh_temp()
            let eval_label as ptr[u8] = self.fresh_label()
            let done_label as ptr[u8] = self.fresh_label()

            var left_bool as ptr[u8] = left_reg
            let left_is_cmp as bool = node_kind(left) == NodeType.BinaryExpr or node_kind(left) == NodeType.BooleanLiteral
            if strcmp(left_type.data to cstr, "ptr" to cstr) == 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
                append_cstr(ref (deref self).main_out, left_reg to cstr)
                append_cstr(ref (deref self).main_out, ", null\n")
                left_bool = temp
            elif not left_is_cmp and strcmp(left_type.data to cstr, "i1" to cstr) != 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ")
                append_str(ref (deref self).main_out, left_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, left_reg to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")
                left_bool = temp

            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, or_tmp to cstr)
            append_cstr(ref (deref self).main_out, " = alloca i1\n")

            append_cstr(ref (deref self).main_out, "  store i1 true, ptr ")
            append_cstr(ref (deref self).main_out, or_tmp to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "  br i1 ")
            append_cstr(ref (deref self).main_out, left_bool to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, done_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, eval_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, eval_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")

            let right_reg as ptr[u8] = self.emit_expr(right)
            let right_type as String = type_to_llvm(node_inferred_type(right))
            var right_bool as ptr[u8] = right_reg
            let right_is_cmp as bool = node_kind(right) == NodeType.BinaryExpr or node_kind(right) == NodeType.BooleanLiteral
            if strcmp(right_type.data to cstr, "ptr" to cstr) == 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
                append_cstr(ref (deref self).main_out, right_reg to cstr)
                append_cstr(ref (deref self).main_out, ", null\n")
                right_bool = temp
            elif not right_is_cmp and strcmp(right_type.data to cstr, "i1" to cstr) != 0:
                let temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, temp to cstr)
                append_cstr(ref (deref self).main_out, " = icmp ne ")
                append_str(ref (deref self).main_out, right_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, right_reg to cstr)
                append_cstr(ref (deref self).main_out, ", 0\n")
                right_bool = temp

            append_cstr(ref (deref self).main_out, "  store i1 ")
            append_cstr(ref (deref self).main_out, right_bool to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, or_tmp to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, done_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, done_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")

            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = load i1, ptr ")
            append_cstr(ref (deref self).main_out, or_tmp to cstr)
            append_cstr(ref (deref self).main_out, "\n")

        if strcmp(op.data to cstr, "=" to cstr) == 0:
            return self.emit_expr(right)

        let left_reg as ptr[u8] = self.emit_expr(left)
        let right_reg as ptr[u8] = self.emit_expr(right)
        var left_t_str as String = type_to_llvm(node_inferred_type(left))
        if node_kind(left) == NodeType.MemberExpr:
            let field_name as String = node_name(left)
            if field_name.data != None:
                left_t_str = get_struct_field_type("Node" to cstr, field_name.data to cstr)
        elif node_kind(left) == NodeType.CastExpr:
            let op_str as String = node_op(left)
            if op_str.data != None to ptr[u8]:
                let c_n as cstr = op_str.data to cstr
                if strcmp(c_n, "ptr" to cstr) == 0 or (deref (c_n to ptr[u8])) == 112 to u8 or (deref (c_n to ptr[u8])) == 91 to u8:
                    left_t_str = String.make("ptr" to cstr)
                else:
                    left_t_str = String.make("i64" to cstr)

        var right_t_str as String = type_to_llvm(node_inferred_type(right))
        if node_kind(right) == NodeType.MemberExpr:
            let field_name as String = node_name(right)
            if field_name.data != None:
                right_t_str = get_struct_field_type("Node" to cstr, field_name.data to cstr)
        elif node_kind(right) == NodeType.CastExpr:
            let op_str as String = node_op(right)
            if op_str.data != None to ptr[u8]:
                let c_n as cstr = op_str.data to cstr
                if strcmp(c_n, "ptr" to cstr) == 0 or (deref (c_n to ptr[u8])) == 112 to u8 or (deref (c_n to ptr[u8])) == 91 to u8:
                    right_t_str = String.make("ptr" to cstr)
                else:
                    right_t_str = String.make("i64" to cstr)

        var left_is_ptr as bool = strcmp(left_t_str.data to cstr, "ptr" to cstr) == 0
        var right_is_ptr as bool = strcmp(right_t_str.data to cstr, "ptr" to cstr) == 0

        let is_cmp as bool = strcmp(op.data to cstr, "==" to cstr) == 0 or strcmp(op.data to cstr, "!=" to cstr) == 0 or strcmp(op.data to cstr, "<" to cstr) == 0 or strcmp(op.data to cstr, ">" to cstr) == 0 or strcmp(op.data to cstr, "<=" to cstr) == 0 or strcmp(op.data to cstr, ">=" to cstr) == 0
        var actual_left as ptr[Node] = left
        if node_kind(actual_left) == NodeType.CastExpr:
            let inner as ptr[Node] = node_left(actual_left)
            if inner != None to ptr[Node]:
                actual_left = inner

        var actual_right as ptr[Node] = right
        if node_kind(actual_right) == NodeType.CastExpr:
            let inner as ptr[Node] = node_left(actual_right)
            if inner != None to ptr[Node]:
                actual_right = inner

        let left_op as String = node_op(actual_left)
        let right_op as String = node_op(actual_right)
        let left_is_cmp as bool = node_kind(actual_left) == NodeType.BinaryExpr and left_op.data != None and (strcmp(left_op.data to cstr, "==" to cstr) == 0 or strcmp(left_op.data to cstr, "!=" to cstr) == 0 or strcmp(left_op.data to cstr, "<" to cstr) == 0 or strcmp(left_op.data to cstr, ">" to cstr) == 0 or strcmp(left_op.data to cstr, "<=" to cstr) == 0 or strcmp(left_op.data to cstr, ">=" to cstr) == 0)
        let right_is_cmp as bool = node_kind(actual_right) == NodeType.BinaryExpr and right_op.data != None and (strcmp(right_op.data to cstr, "==" to cstr) == 0 or strcmp(right_op.data to cstr, "!=" to cstr) == 0 or strcmp(right_op.data to cstr, "<" to cstr) == 0 or strcmp(right_op.data to cstr, ">" to cstr) == 0 or strcmp(right_op.data to cstr, "<=" to cstr) == 0 or strcmp(right_op.data to cstr, ">=" to cstr) == 0)
        let is_arith as bool = strcmp(op.data to cstr, "+" to cstr) == 0 or strcmp(op.data to cstr, "-" to cstr) == 0 or strcmp(op.data to cstr, "*" to cstr) == 0 or strcmp(op.data to cstr, "/" to cstr) == 0 or strcmp(op.data to cstr, "or" to cstr) == 0 or strcmp(op.data to cstr, "and" to cstr) == 0
        var operand_type as String = left_t_str
        if is_arith:
            if left_is_ptr:
                operand_type = String.make("i64" to cstr)
            elif left_is_cmp or right_is_cmp or strcmp(left_t_str.data to cstr, "i1" to cstr) == 0 or strcmp(right_t_str.data to cstr, "i1" to cstr) == 0:
                operand_type = String.make("i1" to cstr)
            else:
                operand_type = left_t_str
        elif left_is_ptr or right_is_ptr:
            operand_type = String.make("ptr" to cstr)

        var result_type as String = type_to_llvm(node_inferred_type(node))
        if is_cmp:
            result_type = String.make("i1" to cstr)
        elif is_arith:
            result_type = operand_type

        var real_left as ptr[u8] = left_reg
        var real_right as ptr[u8] = right_reg
        if strcmp(operand_type.data to cstr, "ptr" to cstr) == 0:
            if not left_is_ptr and (deref left_reg) != 37 to u8:
                let p_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, p_temp to cstr)
                append_cstr(ref (deref self).main_out, " = inttoptr i64 ")
                append_cstr(ref (deref self).main_out, left_reg to cstr)
                append_cstr(ref (deref self).main_out, " to ptr\n")
                real_left = p_temp
            if not right_is_ptr and (deref right_reg) != 37 to u8:
                let p_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, p_temp to cstr)
                append_cstr(ref (deref self).main_out, " = inttoptr i64 ")
                append_cstr(ref (deref self).main_out, right_reg to cstr)
                append_cstr(ref (deref self).main_out, " to ptr\n")
                real_right = p_temp
        elif is_arith:
            if left_is_ptr and (deref left_reg) == 37 to u8:
                let i_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, i_temp to cstr)
                append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
                append_cstr(ref (deref self).main_out, left_reg to cstr)
                append_cstr(ref (deref self).main_out, " to i64\n")
                real_left = i_temp
            if right_is_ptr and (deref right_reg) == 37 to u8:
                let i_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, i_temp to cstr)
                append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
                append_cstr(ref (deref self).main_out, right_reg to cstr)
                append_cstr(ref (deref self).main_out, " to i64\n")
                real_right = i_temp

        let reg as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, reg to cstr)

        if op.data == None:
            append_cstr(ref (deref self).main_out, " = add ")
        elif strcmp(op.data to cstr, "+" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = add ")
        elif strcmp(op.data to cstr, "-" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = sub ")
        elif strcmp(op.data to cstr, "*" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = mul ")
        elif strcmp(op.data to cstr, "/" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = sdiv ")
        elif strcmp(op.data to cstr, "%" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = srem ")
        elif strcmp(op.data to cstr, "or" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = or ")
        elif strcmp(op.data to cstr, "and" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = and ")
        elif strcmp(op.data to cstr, "<" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = icmp slt ")
        elif strcmp(op.data to cstr, ">" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = icmp sgt ")
        elif strcmp(op.data to cstr, "<=" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = icmp sle ")
        elif strcmp(op.data to cstr, ">=" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = icmp sge ")
        elif strcmp(op.data to cstr, "==" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = icmp eq ")
        elif strcmp(op.data to cstr, "!=" to cstr) == 0:
            append_cstr(ref (deref self).main_out, " = icmp ne ")
        else:
            append_cstr(ref (deref self).main_out, " = add ")

        append_cstr(ref (deref self).main_out, " ")
        append_str(ref (deref self).main_out, operand_type)
        append_cstr(ref (deref self).main_out, " ")
        append_cstr(ref (deref self).main_out, real_left to cstr)
        append_cstr(ref (deref self).main_out, ", ")
        append_cstr(ref (deref self).main_out, real_right to cstr)
        append_cstr(ref (deref self).main_out, "\n")
        return reg

    public fn emit_call_stmt(self as ptr[LLVMCodegen], node as ptr[Node]):
        let _ as ptr[u8] = self.emit_call_expr(node)

    public fn emit_call_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let callee as ptr[Node] = node_left(node)
        let args as List[ptr[Node]] = node_params(node)
        let callee_name_ptr as ptr[String] = node_name_ptr(callee)
        var ret_type as String = type_to_llvm(node_inferred_type(node))
        if strcmp(ret_type.data to cstr, "{ ptr, ptr }" to cstr) == 0:
            var is_dict_list as bool = False
            if callee_name_ptr != None to ptr[String]:
                let c_n as cstr = (deref callee_name_ptr).data to cstr
                let p as ptr[u8] = c_n to ptr[u8]
                let is_prefix_is as bool = (deref p) == 105 to u8 and p[1 to usize] == 115 to u8 and p[2 to usize] == 95 to u8
                let is_prefix_has as bool = (deref p) == 104 to u8 and p[1 to usize] == 97 to u8 and p[2 to usize] == 115 to u8 and p[3 to usize] == 95 to u8
                if is_prefix_is or is_prefix_has:
                    ret_type = String.make("i8" to cstr)
                elif strcmp(c_n, "node_kind" to cstr) == 0:
                    ret_type = String.make("i32" to cstr)
                elif strcmp(c_n, "Dict" to cstr) == 0 or strcmp(c_n, "List" to cstr) == 0:
                    is_dict_list = True
                elif (deref p) >= 65 to u8 and (deref p) <= 90 to u8:
                    let s_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
                    let _ as i32 = sprintf(s_buf, "%%%s" to cstr, c_n)
                    ret_type = String.make(s_buf to cstr)
                else:
                    ret_type = String.make("ptr" to cstr)
            else:
                ret_type = String.make("ptr" to cstr)

        if callee == None to ptr[Node]:
            return "0" to ptr[u8]

        let reg as ptr[u8] = self.fresh_temp()

        if callee_name_ptr != None to ptr[String]:
            let c_name as String = deref callee_name_ptr
            if strcmp(c_name.data to cstr, "deref" to cstr) == 0:
                if args.length() > 0 to i64:
                    return self.emit_expr(get_node_decl(ref args, 0 to i64))
                return "null" to ptr[u8]
            if strcmp(c_name.data to cstr, "Dict" to cstr) == 0 or strcmp(c_name.data to cstr, "List" to cstr) == 0:
                return "zeroinitializer" to ptr[u8]
            if strcmp(c_name.data to cstr, "make" to cstr) == 0:
                let call_ret_type as ptr[Type] = node_inferred_type(node)
                var elem_s as i64 = 256 to i64
                if call_ret_type != None to ptr[Type]:
                    let payload as ptr[Type] = (deref call_ret_type).payload
                    if payload != None to ptr[Type]:
                        elem_s = type_size(payload)
                var count_val as ptr[u8] = "1" to ptr[u8]
                if args.length() > 0 to i64:
                    let raw_count as ptr[u8] = self.emit_expr(args[0])
                    let count_type as String = type_to_llvm(node_inferred_type(args[0]))
                    if strcmp(count_type.data to cstr, "i64" to cstr) != 0:
                        let ext_reg as ptr[u8] = self.fresh_temp()
                        append_cstr(ref (deref self).main_out, "  ")
                        append_cstr(ref (deref self).main_out, ext_reg to cstr)
                        if strcmp(count_type.data to cstr, "ptr" to cstr) == 0:
                            append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
                            append_cstr(ref (deref self).main_out, raw_count to cstr)
                            append_cstr(ref (deref self).main_out, " to i64\n")
                        else:
                            append_cstr(ref (deref self).main_out, " = zext ")
                            append_str(ref (deref self).main_out, count_type)
                            append_cstr(ref (deref self).main_out, " ")
                            append_cstr(ref (deref self).main_out, raw_count to cstr)
                            append_cstr(ref (deref self).main_out, " to i64\n")
                        count_val = ext_reg
                    else:
                        count_val = raw_count
                let size_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, size_temp to cstr)
                append_cstr(ref (deref self).main_out, " = mul i64 ")
                append_cstr(ref (deref self).main_out, count_val to cstr)
                append_cstr(ref (deref self).main_out, ", ")
                append_i64(ref (deref self).main_out, elem_s)
                append_cstr(ref (deref self).main_out, "\n")
                
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, reg to cstr)
                append_cstr(ref (deref self).main_out, " = call ptr @mantiq_malloc(i64 ")
                append_cstr(ref (deref self).main_out, size_temp to cstr)
                append_cstr(ref (deref self).main_out, ")\n")
                return reg

        let arg_buf as StringBuilder = StringBuilder.make()
        var is_struct_static as bool = False
        if node_kind(callee) == NodeType.MemberExpr:
            let obj_node as ptr[Node] = node_left(callee)
            if obj_node != None to ptr[Node]:
                if node_kind(obj_node) == NodeType.Identifier:
                    let o_name as String = node_name(obj_node)
                    if o_name.data != None:
                        let fc as u8 = deref (o_name.data to ptr[u8])
                        if fc >= 65 to u8 and fc <= 90 to u8:
                            is_struct_static = True
                if not is_struct_static:
                    var obj_val as ptr[u8] = "null" to ptr[u8]
                    var is_deref_obj as bool = False
                    if obj_node != None to ptr[Node]:
                        let op_s as String = node_op(obj_node)
                        let nm_s as String = node_name(obj_node)
                        let l_n as ptr[Node] = node_left(obj_node)
                        var l_nm as String = String.make("" to cstr)
                        if l_n != None to ptr[Node]:
                            l_nm = node_name(l_n)
                        if (op_s.data != None and strcmp(op_s.data to cstr, "deref" to cstr) == 0) or (nm_s.data != None and strcmp(nm_s.data to cstr, "deref" to cstr) == 0) or (l_nm.data != None and strcmp(l_nm.data to cstr, "deref" to cstr) == 0):
                            is_deref_obj = True

                    if is_deref_obj:
                        var inner_rec as ptr[Node] = obj_node
                        while inner_rec != None to ptr[Node]:
                            let op_rec as String = node_op(inner_rec)
                            let nm_rec as String = node_name(inner_rec)
                            let left_rec as ptr[Node] = node_left(inner_rec)
                            var left_rec_nm as String = String.make("" to cstr)
                            if left_rec != None to ptr[Node]:
                                left_rec_nm = node_name(left_rec)
                            if (op_rec.data != None and strcmp(op_rec.data to cstr, "deref" to cstr) == 0) or (nm_rec.data != None and strcmp(nm_rec.data to cstr, "deref" to cstr) == 0) or (left_rec_nm.data != None and strcmp(left_rec_nm.data to cstr, "deref" to cstr) == 0):
                                if left_rec != None to ptr[Node] and node_kind(left_rec) != NodeType.Identifier:
                                    inner_rec = left_rec
                                else:
                                    let args_r as List[ptr[Node]] = node_params(inner_rec)
                                    if args_r.length() > 0 to i64:
                                        inner_rec = get_node_decl(ref args_r, 0 to i64)
                                    elif left_rec != None to ptr[Node]:
                                        inner_rec = left_rec
                                    else:
                                        break
                            else:
                                break
                        if inner_rec == None to ptr[Node]:
                            inner_rec = obj_node
                        obj_val = self.emit_expr(inner_rec)
                    else:
                        obj_val = self.emit_lvalue_ptr(obj_node)
                    append_cstr(ref arg_buf, "ptr ")
                    append_cstr(ref arg_buf, obj_val to cstr)
                    if args.length() > 0 to i64:
                        append_cstr(ref arg_buf, ", ")

        let a_count as i64 = args.length()
        var a_idx as i64 = 0 to i64
        while a_idx < a_count:
            let arg_node as ptr[Node] = get_node_decl(ref args, a_idx)
            let arg_val as ptr[u8] = self.emit_expr(arg_node)
            var arg_type as String = type_to_llvm(node_inferred_type(arg_node))
            if (deref arg_val) >= 48 to u8 and (deref arg_val) <= 57 to u8:
                arg_type = String.make("i32" to cstr)
            elif (deref arg_val) == 37 to u8 and strcmp(arg_type.data to cstr, "{ ptr, ptr }" to cstr) == 0:
                arg_type = String.make("ptr" to cstr)
            append_str(ref arg_buf, arg_type)
            append_cstr(ref arg_buf, " ")
            append_cstr(ref arg_buf, arg_val to cstr)
            if a_idx < a_count - 1 to i64:
                append_cstr(ref arg_buf, ", ")
            a_idx = a_idx + 1 to i64

        var fn_target_name as String = String.make("" to cstr)
        if callee_name_ptr != None to ptr[String]:
            fn_target_name = deref callee_name_ptr

        if node_kind(callee) == NodeType.MemberExpr:
            let method_name as String = node_name(callee)
            let obj_node as ptr[Node] = node_left(callee)
            var s_nm as String = String.make("" to cstr)
            var mod_nm as String = String.make("" to cstr)
            if obj_node != None to ptr[Node]:
                let obj_t as ptr[Type] = node_inferred_type(obj_node)
                if obj_t != None to ptr[Type]:
                    if (deref obj_t).kind == TypeKind.Struct:
                        s_nm = (deref obj_t).name
                    elif (deref obj_t).kind == TypeKind.RawPointer and (deref obj_t).payload != None to ptr[Type]:
                        let pl as ptr[Type] = (deref obj_t).payload
                        if (deref pl).kind == TypeKind.Struct:
                            s_nm = (deref pl).name
                if s_nm.len == 0 to usize:
                    var target_id_node as ptr[Node] = obj_node
                    while target_id_node != None to ptr[Node] and (node_kind(target_id_node) == NodeType.UnaryExpr or node_kind(target_id_node) == NodeType.CallExpr):
                        let next_n as ptr[Node] = node_left(target_id_node)
                        if node_kind(target_id_node) == NodeType.CallExpr:
                            let args_l as List[ptr[Node]] = node_params(target_id_node)
                            if args_l.length() > 0 to i64:
                                target_id_node = get_node_decl(ref args_l, 0 to i64)
                            else:
                                target_id_node = next_n
                        else:
                            target_id_node = next_n
                    if node_kind(target_id_node) == NodeType.Identifier:
                        let o_name as String = node_name(target_id_node)
                        if strcmp(o_name.data to cstr, "sema" to cstr) == 0:
                            s_nm = String.make("Sema" to cstr)
                        elif strcmp(o_name.data to cstr, "tc" to cstr) == 0:
                            s_nm = String.make("TypeChecker" to cstr)
                        elif strcmp(o_name.data to cstr, "bc" to cstr) == 0:
                            s_nm = String.make("BorrowChecker" to cstr)
                        elif strcmp(o_name.data to cstr, "cg" to cstr) == 0:
                            s_nm = String.make("LLVMCodegen" to cstr)
                        elif strcmp(o_name.data to cstr, "lowerer" to cstr) == 0:
                            s_nm = String.make("Lowerer" to cstr)
                        elif strcmp(o_name.data to cstr, "self" to cstr) == 0:
                            s_nm = String.make("DiagnosticEngine" to cstr)
                        elif o_name.data != None:
                            let fc as u8 = deref (o_name.data to ptr[u8])
                            if fc >= 65 to u8 and fc <= 90 to u8:
                                s_nm = o_name

                // Strip generic params from type name for LLVM symbol name compatibility
                if s_nm.len > 0 to usize:
                    extern fn strchr(s as cstr, c as i32) as cstr
                    extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
                    extern fn free(p as ptr)
                    let bp as cstr = strchr(s_nm.data to cstr, '[' to i32)
                    if bp != None to cstr:
                        let base_len as usize = (bp to usize) - (s_nm.data to usize)
                        if base_len > 0 to usize:
                            let buf as ptr[u8] = make[u8](base_len + 1 to usize) to ptr[u8]
                            let _m as ptr = memcpy(buf to ptr, s_nm.data to ptr, base_len)
                            buf[base_len] = 0 to u8
                            s_nm = String.make(buf to cstr)

            if strcmp(s_nm.data to cstr, "Sema" to cstr) == 0:
                mod_nm = String.make("sema" to cstr)
            elif strcmp(s_nm.data to cstr, "TypeChecker" to cstr) == 0:
                mod_nm = String.make("typecheck" to cstr)
            elif strcmp(s_nm.data to cstr, "BorrowChecker" to cstr) == 0:
                mod_nm = String.make("borrowck" to cstr)
            elif strcmp(s_nm.data to cstr, "LLVMCodegen" to cstr) == 0:
                mod_nm = String.make("codegen" to cstr)
            elif strcmp(s_nm.data to cstr, "Lowerer" to cstr) == 0:
                mod_nm = String.make("lower" to cstr)

            if mod_nm.len > 0 to usize and s_nm.len > 0 to usize:
                let fn_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
                let _ as i32 = sprintf(fn_buf, "mantiq_%s_%s_%s" to cstr, mod_nm.data to cstr, s_nm.data to cstr, method_name.data to cstr)
                fn_target_name = String.make(fn_buf to cstr)
            elif s_nm.len > 0 to usize:
                let fn_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
                let _ as i32 = sprintf(fn_buf, "%s_%s" to cstr, s_nm.data to cstr, method_name.data to cstr)
                fn_target_name = String.make(fn_buf to cstr)

        if fn_target_name.len > 0 to usize and not (deref self).external_decls.has(fn_target_name) and not (deref self).defined_functions.has(fn_target_name):
            set_dict_bool(ref (deref self).external_decls, fn_target_name, True)
            append_cstr(ref (deref self).type_out, "declare ")
            append_str(ref (deref self).type_out, ret_type)
            append_cstr(ref (deref self).type_out, " @")
            append_str(ref (deref self).type_out, fn_target_name)
            append_cstr(ref (deref self).type_out, "(...)\n")

        let is_void as bool = str_eq(ret_type, String.make("void" to cstr))
        if not is_void:
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = call ")
        else:
            append_cstr(ref (deref self).main_out, "  call ")
        append_str(ref (deref self).main_out, ret_type)
        append_cstr(ref (deref self).main_out, " @")
        append_str(ref (deref self).main_out, fn_target_name)
        append_cstr(ref (deref self).main_out, "(")
        append_str(ref (deref self).main_out, arg_buf.to_string())
        append_cstr(ref (deref self).main_out, ")\n")
        return reg

    public fn emit_return(self as ptr[LLVMCodegen], node as ptr[Node]):
        let drops as List[String] = node_auto_drops(node)
        if drops.length() > 0 to i64:
            self.emit_auto_drops(drops)

        let val as ptr[Node] = node_body(node)
        if val != None to ptr[Node]:
            var ret_type as String = (deref self).current_return_type
            if strcmp(ret_type.data to cstr, "void" to cstr) == 0:
                ret_type = type_to_llvm(node_inferred_type(val))
            let val_reg as ptr[u8] = self.emit_expr(val)
            if strcmp(ret_type.data to cstr, "void" to cstr) == 0:
                if (deref val_reg) == 37 to u8:
                    ret_type = String.make("ptr" to cstr)
            var real_val as ptr[u8] = val_reg
            if strcmp(ret_type.data to cstr, "i8" to cstr) == 0 and (node_kind(val) == NodeType.BinaryExpr or node_kind(val) == NodeType.BooleanLiteral):
                let b_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, b_temp to cstr)
                append_cstr(ref (deref self).main_out, " = zext i1 ")
                append_cstr(ref (deref self).main_out, val_reg to cstr)
                append_cstr(ref (deref self).main_out, " to i8\n")
                real_val = b_temp
            append_cstr(ref (deref self).main_out, "  ret ")
            append_str(ref (deref self).main_out, ret_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, real_val to cstr)
            append_cstr(ref (deref self).main_out, "\n")
        else:
            append_cstr(ref (deref self).main_out, "  ret void\n")

    public fn emit_if(self as ptr[LLVMCodegen], node as ptr[Node]):
        let cond as ptr[Node] = node_cond(node)
        let then_b as ptr[Node] = node_then_branch(node)
        let else_b_raw as Option[ptr[Node]] = node_else_branch(node)
        let else_b_ref as ptr[OptionLayout] = (ref else_b_raw) to ptr[OptionLayout]

        let then_label as ptr[u8] = self.fresh_label()
        let else_label as ptr[u8] = self.fresh_label()
        let end_label as ptr[u8] = self.fresh_label()

        let cond_reg as ptr[u8] = self.emit_expr(cond)
        let cond_type as String = type_to_llvm(node_inferred_type(cond))
        var cond_bool as ptr[u8] = cond_reg

        let is_cmp as bool = node_kind(cond) == NodeType.BinaryExpr or node_kind(cond) == NodeType.BooleanLiteral
        if strcmp(cond_type.data to cstr, "ptr" to cstr) == 0:
            let temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, temp to cstr)
            append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
            append_cstr(ref (deref self).main_out, cond_reg to cstr)
            append_cstr(ref (deref self).main_out, ", null\n")
            cond_bool = temp
        elif not is_cmp and strcmp(cond_type.data to cstr, "i1" to cstr) != 0:
            let temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, temp to cstr)
            append_cstr(ref (deref self).main_out, " = icmp ne ")
            append_str(ref (deref self).main_out, cond_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, cond_reg to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")
            cond_bool = temp

        if option_has_value(else_b_ref):
            append_cstr(ref (deref self).main_out, "  br i1 ")
            append_cstr(ref (deref self).main_out, cond_bool to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, then_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, else_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")
        else:
            append_cstr(ref (deref self).main_out, "  br i1 ")
            append_cstr(ref (deref self).main_out, cond_bool to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, then_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, end_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

        append_cstr(ref (deref self).main_out, "\n")
        append_cstr(ref (deref self).main_out, then_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")
        self.emit_node(then_b)
        append_cstr(ref (deref self).main_out, "  br label %")
        append_cstr(ref (deref self).main_out, end_label to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        if option_has_value(else_b_ref):
            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, else_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            self.emit_node(option_unwrap_ptr(else_b_ref))
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, end_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

        append_cstr(ref (deref self).main_out, "\n")
        append_cstr(ref (deref self).main_out, end_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")

    public fn emit_while(self as ptr[LLVMCodegen], node as ptr[Node]):
        let cond as ptr[Node] = node_cond(node)
        let body as ptr[Node] = node_then_branch(node)

        let cond_label as ptr[u8] = self.fresh_label()
        let body_label as ptr[u8] = self.fresh_label()
        let end_label as ptr[u8] = self.fresh_label()

        append_cstr(ref (deref self).main_out, "  br label %")
        append_cstr(ref (deref self).main_out, cond_label to cstr)
        append_cstr(ref (deref self).main_out, "\n\n")

        append_cstr(ref (deref self).main_out, cond_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")
        let cond_reg as ptr[u8] = self.emit_expr(cond)
        let cond_type as String = type_to_llvm(node_inferred_type(cond))
        var cond_bool as ptr[u8] = cond_reg

        let is_cmp as bool = node_kind(cond) == NodeType.BinaryExpr or node_kind(cond) == NodeType.BooleanLiteral
        if strcmp(cond_type.data to cstr, "ptr" to cstr) == 0:
            let temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, temp to cstr)
            append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
            append_cstr(ref (deref self).main_out, cond_reg to cstr)
            append_cstr(ref (deref self).main_out, ", null\n")
            cond_bool = temp
        elif not is_cmp and strcmp(cond_type.data to cstr, "i1" to cstr) != 0:
            let temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, temp to cstr)
            append_cstr(ref (deref self).main_out, " = icmp ne ")
            append_str(ref (deref self).main_out, cond_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, cond_reg to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")
            cond_bool = temp

        append_cstr(ref (deref self).main_out, "  br i1 ")
        append_cstr(ref (deref self).main_out, cond_bool to cstr)
        append_cstr(ref (deref self).main_out, ", label %")
        append_cstr(ref (deref self).main_out, body_label to cstr)
        append_cstr(ref (deref self).main_out, ", label %")
        append_cstr(ref (deref self).main_out, end_label to cstr)
        append_cstr(ref (deref self).main_out, "\n\n")

        append_cstr(ref (deref self).main_out, body_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")
        self.emit_node(body)
        append_cstr(ref (deref self).main_out, "  br label %")
        append_cstr(ref (deref self).main_out, cond_label to cstr)
        append_cstr(ref (deref self).main_out, "\n\n")

        append_cstr(ref (deref self).main_out, end_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")

    public fn extract_range_args(self as ptr[LLVMCodegen], iterable as ptr[Node], start_val_ptr as ptr[ptr[u8]], end_val_ptr as ptr[ptr[u8]]) as bool:
        if iterable == None to ptr[Node]:
            return False
        let iter_nt as NodeType = node_kind(iterable)
        if iter_nt == NodeType.CallExpr:
            let callee as ptr[Node] = node_left(iterable)
            if callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier:
                let callee_name_ptr as ptr[String] = node_name_ptr(callee)
                if callee_name_ptr != None to ptr[String] and strcmp((deref callee_name_ptr).data to cstr, "range" to cstr) == 0:
                    let args_raw as List[ptr[Node]] = node_params(iterable)
                    let args as ptr[List[ptr[Node]]] = ref args_raw
                    if (deref args).length() >= 2 to i64:
                        deref start_val_ptr = self.emit_expr(get_node_decl(args, 0))
                        deref end_val_ptr = self.emit_expr(get_node_decl(args, 1))
                        return True
        if iter_nt == NodeType.BinaryExpr:
            if strcmp(node_op(iterable).data to cstr, ".." to cstr) == 0:
                deref start_val_ptr = self.emit_expr(node_left(iterable))
                deref end_val_ptr = self.emit_expr(node_right(iterable))
                return True
        return False

    public fn emit_for(self as ptr[LLVMCodegen], node as ptr[Node]):
        let iter_name_ptr as ptr[String] = node_name_ptr(node)
        let iterable as ptr[Node] = node_left(node)
        let body as ptr[Node] = node_body(node)

        let cond_label as ptr[u8] = self.fresh_label()
        let body_label as ptr[u8] = self.fresh_label()
        let inc_label as ptr[u8] = self.fresh_label()
        let end_label as ptr[u8] = self.fresh_label()

        var start_val as ptr[u8] = "0" to ptr[u8]
        var end_val as ptr[u8] = "0" to ptr[u8]
        let is_range as bool = self.extract_range_args(iterable, ref start_val, ref end_val)

        var final_iter_type as String = type_to_llvm(node_inferred_type(node))
        if strcmp(final_iter_type.data to cstr, "void" to cstr) == 0 and iterable != None to ptr[Node]:
            let alt_type as String = type_to_llvm(node_inferred_type(iterable))
            if strcmp(alt_type.data to cstr, "void" to cstr) != 0:
                final_iter_type = alt_type
            else:
                final_iter_type = String.make("i64" to cstr)

        append_cstr(ref (deref self).main_out, "  %")
        if iter_name_ptr != None to ptr[String]:
            append_str(ref (deref self).main_out, deref iter_name_ptr)
        append_cstr(ref (deref self).main_out, " = alloca ")
        append_str(ref (deref self).main_out, final_iter_type)
        append_cstr(ref (deref self).main_out, "\n")

        if is_range:
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, final_iter_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, start_val to cstr)
            append_cstr(ref (deref self).main_out, ", ptr %")
            if iter_name_ptr != None to ptr[String]:
                append_str(ref (deref self).main_out, deref iter_name_ptr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, cond_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

            append_cstr(ref (deref self).main_out, cond_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            let cond_load as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, cond_load to cstr)
            append_cstr(ref (deref self).main_out, " = load ")
            append_str(ref (deref self).main_out, final_iter_type)
            append_cstr(ref (deref self).main_out, ", ptr %")
            if iter_name_ptr != None to ptr[String]:
                append_str(ref (deref self).main_out, deref iter_name_ptr)
            append_cstr(ref (deref self).main_out, "\n")
            let cmp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, cmp to cstr)
            append_cstr(ref (deref self).main_out, " = icmp slt ")
            append_str(ref (deref self).main_out, final_iter_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, cond_load to cstr)
            append_cstr(ref (deref self).main_out, ", ")
            append_cstr(ref (deref self).main_out, end_val to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, "  br i1 ")
            append_cstr(ref (deref self).main_out, cmp to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, body_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, end_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

            append_cstr(ref (deref self).main_out, body_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            self.emit_node(body)
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, inc_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

            append_cstr(ref (deref self).main_out, inc_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            let inc_load as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, inc_load to cstr)
            append_cstr(ref (deref self).main_out, " = load ")
            append_str(ref (deref self).main_out, final_iter_type)
            append_cstr(ref (deref self).main_out, ", ptr %")
            if iter_name_ptr != None to ptr[String]:
                append_str(ref (deref self).main_out, deref iter_name_ptr)
            append_cstr(ref (deref self).main_out, "\n")
            let inc_val as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, inc_val to cstr)
            append_cstr(ref (deref self).main_out, " = add ")
            append_str(ref (deref self).main_out, final_iter_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, inc_load to cstr)
            append_cstr(ref (deref self).main_out, ", 1\n")
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, final_iter_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, inc_val to cstr)
            append_cstr(ref (deref self).main_out, ", ptr %")
            if iter_name_ptr != None to ptr[String]:
                append_str(ref (deref self).main_out, deref iter_name_ptr)
            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, cond_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")
        else:
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, cond_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

            append_cstr(ref (deref self).main_out, cond_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            append_cstr(ref (deref self).main_out, "  br i1 true, label %")
            append_cstr(ref (deref self).main_out, body_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, end_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

            append_cstr(ref (deref self).main_out, body_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            self.emit_node(body)
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, cond_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

        append_cstr(ref (deref self).main_out, end_label to cstr)
        append_cstr(ref (deref self).main_out, ":\n")

    public fn emit_block(self as ptr[LLVMCodegen], node as ptr[Node]):
        let stmts as List[ptr[Node]] = node_declarations(node)
        let count as i64 = stmts.length()
        var i as i64 = 0 to i64
        while i < count:
            self.emit_node(get_node_decl(ref stmts, i))
            i = i + 1 to i64

        let drops as List[String] = node_auto_drops(node)
        if drops.length() > 0 to i64:
            self.emit_auto_drops(drops)

    public fn emit_unary_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let op as String = node_op(node)
        let operand as ptr[Node] = node_left(node)
        let operand_val as ptr[u8] = self.emit_expr(operand)
        let t as String = type_to_llvm(node_inferred_type(operand))
        let reg as ptr[u8] = self.fresh_temp()

        if strcmp(op.data to cstr, "not" to cstr) == 0:
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = xor i1 ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, ", 1\n")
            return reg
        elif strcmp(op.data to cstr, "-" to cstr) == 0:
            let is_float as bool = strcmp(t.data to cstr, "float" to cstr) == 0 or strcmp(t.data to cstr, "double" to cstr) == 0 or strcmp(t.data to cstr, "half" to cstr) == 0 or strcmp(t.data to cstr, "bfloat" to cstr) == 0
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            if is_float:
                append_cstr(ref (deref self).main_out, " = fneg ")
            else:
                append_cstr(ref (deref self).main_out, " = sub ")
                append_str(ref (deref self).main_out, t)
                append_cstr(ref (deref self).main_out, " 0, ")
                append_cstr(ref (deref self).main_out, operand_val to cstr)
                append_cstr(ref (deref self).main_out, "\n")
                return reg
            append_cstr(ref (deref self).main_out, " ")
            append_str(ref (deref self).main_out, t)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return reg
        elif strcmp(op.data to cstr, "+" to cstr) == 0:
            return operand_val
        elif strcmp(op.data to cstr, "~" to cstr) == 0:
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = xor ")
            append_str(ref (deref self).main_out, t)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, ", -1\n")
            return reg
        elif strcmp(op.data to cstr, "ref" to cstr) == 0 or strcmp(op.data to cstr, "ref mut" to cstr) == 0:
            return self.emit_lvalue_ptr(operand)
        elif strcmp(op.data to cstr, "deref" to cstr) == 0:
            var pointee_t as String = type_to_llvm(node_inferred_type(node))
            if strcmp(pointee_t.data to cstr, "void" to cstr) == 0:
                pointee_t = String.make("i8" to cstr)
            var ptr_reg as ptr[u8] = operand_val
            if node_kind(operand) == NodeType.BinaryExpr:
                let p_temp as ptr[u8] = self.fresh_temp()
                append_cstr(ref (deref self).main_out, "  ")
                append_cstr(ref (deref self).main_out, p_temp to cstr)
                append_cstr(ref (deref self).main_out, " = inttoptr i64 ")
                append_cstr(ref (deref self).main_out, operand_val to cstr)
                append_cstr(ref (deref self).main_out, " to ptr\n")
                ptr_reg = p_temp
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = load ")
            append_str(ref (deref self).main_out, pointee_t)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, ptr_reg to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            return reg
        else:
            return operand_val

    public fn emit_cast_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let operand as ptr[Node] = node_left(node)
        let operand_val as ptr[u8] = self.emit_expr(operand)
        var source_type as String = type_to_llvm(node_inferred_type(operand))
        if node_kind(operand) == NodeType.StringLiteral:
            source_type = String.make("ptr" to cstr)
        var target_type as String = type_to_llvm(node_inferred_type(node))
        let target_op as String = node_op(node)
        if target_op.data != None to ptr[u8]:
            let target_cstr as cstr = target_op.data to cstr
            if strcmp(target_cstr, "usize" to cstr) == 0 or strcmp(target_cstr, "isize" to cstr) == 0 or strcmp(target_cstr, "i64" to cstr) == 0 or strcmp(target_cstr, "u64" to cstr) == 0:
                target_type = String.make("i64" to cstr)
            elif strcmp(target_cstr, "i32" to cstr) == 0 or strcmp(target_cstr, "u32" to cstr) == 0:
                target_type = String.make("i32" to cstr)
            elif strcmp(target_cstr, "i8" to cstr) == 0 or strcmp(target_cstr, "u8" to cstr) == 0:
                target_type = String.make("i8" to cstr)
            elif strcmp(target_cstr, "ptr" to cstr) == 0 or (deref (target_cstr to ptr[u8])) == 112 to u8 or (deref (target_cstr to ptr[u8])) == 91 to u8:
                target_type = String.make("ptr" to cstr)
        if (deref target_type.data) == 37 to u8:
            target_type = String.make("ptr" to cstr)

        if strcmp(source_type.data to cstr, "void" to cstr) == 0 or strcmp(source_type.data to cstr, target_type.data to cstr) == 0:
            return operand_val

        let reg as ptr[u8] = self.fresh_temp()

        let src_is_int as bool = (deref source_type.data) == 105 to u8
        let tgt_is_int as bool = (deref target_type.data) == 105 to u8
        if src_is_int and tgt_is_int:
            var src_bits as i32 = 64 to i32
            if strcmp(source_type.data to cstr, "i32" to cstr) == 0:
                src_bits = 32 to i32
            elif strcmp(source_type.data to cstr, "i16" to cstr) == 0:
                src_bits = 16 to i32
            elif strcmp(source_type.data to cstr, "i8" to cstr) == 0 or strcmp(source_type.data to cstr, "i1" to cstr) == 0:
                src_bits = 8 to i32

            var tgt_bits as i32 = 64 to i32
            if strcmp(target_type.data to cstr, "i32" to cstr) == 0:
                tgt_bits = 32 to i32
            elif strcmp(target_type.data to cstr, "i16" to cstr) == 0:
                tgt_bits = 16 to i32
            elif strcmp(target_type.data to cstr, "i8" to cstr) == 0 or strcmp(target_type.data to cstr, "i1" to cstr) == 0:
                tgt_bits = 8 to i32

            if src_bits == tgt_bits:
                return operand_val

            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            if src_bits < tgt_bits:
                append_cstr(ref (deref self).main_out, " = zext ")
            else:
                append_cstr(ref (deref self).main_out, " = trunc ")
            append_str(ref (deref self).main_out, source_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, " to ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, "\n")
            return reg

        let src_is_float as bool = strcmp(source_type.data to cstr, "float" to cstr) == 0 or strcmp(source_type.data to cstr, "double" to cstr) == 0
        let tgt_is_float as bool = strcmp(target_type.data to cstr, "float" to cstr) == 0 or strcmp(target_type.data to cstr, "double" to cstr) == 0
        if src_is_float and tgt_is_int:
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = fptosi ")
            append_str(ref (deref self).main_out, source_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, " to ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, "\n")
            return reg
        if src_is_int and tgt_is_float:
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = sitofp ")
            append_str(ref (deref self).main_out, source_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, " to ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, "\n")
            return reg

        if src_is_float and tgt_is_float:
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = fpext ")
            append_str(ref (deref self).main_out, source_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, " to ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, "\n")
            return reg

        let src_is_ptr as bool = strcmp(source_type.data to cstr, "ptr" to cstr) == 0
        let tgt_is_ptr as bool = strcmp(target_type.data to cstr, "ptr" to cstr) == 0

        if (deref operand_val) == 37 to u8:
            if tgt_is_ptr:
                return operand_val
            if tgt_is_int:
                if src_is_ptr:
                    append_cstr(ref (deref self).main_out, "  ")
                    append_cstr(ref (deref self).main_out, reg to cstr)
                    append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
                    append_cstr(ref (deref self).main_out, operand_val to cstr)
                    append_cstr(ref (deref self).main_out, " to ")
                    append_str(ref (deref self).main_out, target_type)
                    append_cstr(ref (deref self).main_out, "\n")
                    return reg
                else:
                    return operand_val

        if tgt_is_ptr:
            var int_type as String = String.make("i64" to cstr)
            if strcmp(source_type.data to cstr, "i32" to cstr) == 0:
                int_type = String.make("i32" to cstr)
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = inttoptr ")
            append_str(ref (deref self).main_out, int_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, " to ptr\n")
            return reg

        if tgt_is_ptr and src_is_ptr:
            return operand_val

        if src_is_ptr and tgt_is_int:
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, " to ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, "\n")
            return reg

        if tgt_is_ptr and ((deref source_type.data) == 123 to u8 or (deref source_type.data) == 37 to u8):
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = extractvalue ")
            append_str(ref (deref self).main_out, source_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")
            return reg

        if tgt_is_int and ((deref source_type.data) == 123 to u8 or (deref source_type.data) == 37 to u8):
            let ext_ptr as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, ext_ptr to cstr)
            append_cstr(ref (deref self).main_out, " = extractvalue ")
            append_str(ref (deref self).main_out, source_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, operand_val to cstr)
            append_cstr(ref (deref self).main_out, ", 0\n")
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, reg to cstr)
            append_cstr(ref (deref self).main_out, " = ptrtoint ptr ")
            append_cstr(ref (deref self).main_out, ext_ptr to cstr)
            append_cstr(ref (deref self).main_out, " to ")
            append_str(ref (deref self).main_out, target_type)
            append_cstr(ref (deref self).main_out, "\n")
            return reg

        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, reg to cstr)
        append_cstr(ref (deref self).main_out, " = bitcast ")
        append_str(ref (deref self).main_out, source_type)
        append_cstr(ref (deref self).main_out, " ")
        append_cstr(ref (deref self).main_out, operand_val to cstr)
        append_cstr(ref (deref self).main_out, " to ")
        append_str(ref (deref self).main_out, target_type)
        append_cstr(ref (deref self).main_out, "\n")
        return reg

    public fn emit_list_literal(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let items as List[ptr[Node]] = node_declarations(node)
        let count as i64 = items.length()
        let elem_type as String = type_to_llvm(node_inferred_type(node))

        let buf_temp as ptr[u8] = self.fresh_temp()
        let count_val as i64 = count
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, buf_temp to cstr)
        append_cstr(ref (deref self).main_out, " = call ptr @malloc(i64 ")
        let buf_size as i64 = count_val * 8 to i64
        append_i64(ref (deref self).main_out, buf_size)
        append_cstr(ref (deref self).main_out, ")\n")

        var i as i64 = 0 to i64
        while i < count:
            let elem_val as ptr[u8] = self.emit_expr(get_node_decl(ref items, i))
            let idx_temp as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, idx_temp to cstr)
            append_cstr(ref (deref self).main_out, " = getelementptr i8, ptr ")
            append_cstr(ref (deref self).main_out, buf_temp to cstr)
            append_cstr(ref (deref self).main_out, ", i64 ")
            append_i64(ref (deref self).main_out, i * 8 to i64)
            append_cstr(ref (deref self).main_out, "\n")
            append_cstr(ref (deref self).main_out, "  store ")
            append_str(ref (deref self).main_out, elem_type)
            append_cstr(ref (deref self).main_out, " ")
            append_cstr(ref (deref self).main_out, elem_val to cstr)
            append_cstr(ref (deref self).main_out, ", ptr ")
            append_cstr(ref (deref self).main_out, idx_temp to cstr)
            append_cstr(ref (deref self).main_out, "\n")
            i = i + 1 to i64

        let list_temp as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, list_temp to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } undef, ptr ")
        append_cstr(ref (deref self).main_out, buf_temp to cstr)
        append_cstr(ref (deref self).main_out, ", 0\n")
        let list_temp2 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, list_temp2 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } ")
        append_cstr(ref (deref self).main_out, list_temp to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_i64(ref (deref self).main_out, count_val)
        append_cstr(ref (deref self).main_out, ", 1\n")
        let list_temp3 as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, list_temp3 to cstr)
        append_cstr(ref (deref self).main_out, " = insertvalue { ptr, i64, i64 } ")
        append_cstr(ref (deref self).main_out, list_temp2 to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_i64(ref (deref self).main_out, buf_size)
        append_cstr(ref (deref self).main_out, ", 2\n")
        return list_temp3

    public fn emit_index_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let collection as ptr[Node] = node_left(node)
        let index as ptr[Node] = node_right(node)
        let coll_val as ptr[u8] = self.emit_expr(collection)
        let idx_val as ptr[u8] = self.emit_expr(index)
        let elem_type as String = type_to_llvm(node_inferred_type(node))

        let ptr_temp as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, ptr_temp to cstr)
        append_cstr(ref (deref self).main_out, " = extractvalue { ptr, i64, i64 } ")
        append_cstr(ref (deref self).main_out, coll_val to cstr)
        append_cstr(ref (deref self).main_out, ", 0\n")

        let elem_ptr as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, elem_ptr to cstr)
        append_cstr(ref (deref self).main_out, " = getelementptr i8, ptr ")
        append_cstr(ref (deref self).main_out, ptr_temp to cstr)
        append_cstr(ref (deref self).main_out, ", i64 ")
        append_cstr(ref (deref self).main_out, idx_val to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let reg as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, reg to cstr)
        append_cstr(ref (deref self).main_out, " = load ")
        append_str(ref (deref self).main_out, elem_type)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, elem_ptr to cstr)
        return reg

    public fn emit_closure_expr(self as ptr[LLVMCodegen], node as ptr[Node]) as ptr[u8]:
        let fn_name as ptr[u8] = self.fresh_closure_name()
        let params as List[ptr[Node]] = node_params(node)
        let body as ptr[Node] = node_body(node)

        var ret_type as String = type_to_llvm(node_inferred_type(node))
        if str_eq(ret_type, String.make("void" to cstr)):
            if body != None to ptr[Node] and node_kind(body) != NodeType.BlockStmt:
                let body_t as String = type_to_llvm(node_inferred_type(body))
                if str_eq(body_t, String.make("void" to cstr)) == False:
                    ret_type = body_t
                else:
                    ret_type = String.make("i64" to cstr)
            else:
                ret_type = String.make("i64" to cstr)

        let temp_main as StringBuilder = (deref self).main_out
        (deref self).main_out = (deref self).outlined_out

        append_cstr(ref (deref self).main_out, "define ")
        append_str(ref (deref self).main_out, ret_type)
        append_cstr(ref (deref self).main_out, " @")
        append_cstr(ref (deref self).main_out, fn_name to cstr)
        append_cstr(ref (deref self).main_out, "(ptr %env")

        let p_count as i64 = params.length()
        var p_idx as i64 = 0 to i64
        while p_idx < p_count:
            let p as ptr[Node] = get_node_decl(ref params, p_idx)
            let p_name_ptr as ptr[String] = node_name_ptr(p)
            let p_type as String = type_to_llvm(node_inferred_type(p))
            append_cstr(ref (deref self).main_out, ", ")
            append_str(ref (deref self).main_out, p_type)
            append_cstr(ref (deref self).main_out, " %")
            if p_name_ptr != None to ptr[String]:
                append_str(ref (deref self).main_out, deref p_name_ptr)
            p_idx = p_idx + 1 to i64

        append_cstr(ref (deref self).main_out, ") {\nentry:\n")

        if body != None to ptr[Node]:
            if node_kind(body) != NodeType.BlockStmt:
                let ret_reg as ptr[u8] = self.emit_expr(body)
                append_cstr(ref (deref self).main_out, "  ret ")
                append_str(ref (deref self).main_out, ret_type)
                append_cstr(ref (deref self).main_out, " ")
                append_cstr(ref (deref self).main_out, ret_reg to cstr)
                append_cstr(ref (deref self).main_out, "\n")
            else:
                self.emit_node(body)

        append_cstr(ref (deref self).main_out, "}\n\n")

        (deref self).outlined_out = (deref self).main_out
        (deref self).main_out = temp_main

        let closure_reg as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, closure_reg to cstr)
        append_cstr(ref (deref self).main_out, " = alloca { ptr, ptr }\n")

        let fn_ptr_reg as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, fn_ptr_reg to cstr)
        append_cstr(ref (deref self).main_out, " = getelementptr inbounds { ptr, ptr }, ptr ")
        append_cstr(ref (deref self).main_out, closure_reg to cstr)
        append_cstr(ref (deref self).main_out, ", i32 0, i32 0\n")
        append_cstr(ref (deref self).main_out, "  store ptr @")
        append_cstr(ref (deref self).main_out, fn_name to cstr)
        append_cstr(ref (deref self).main_out, ", ptr ")
        append_cstr(ref (deref self).main_out, fn_ptr_reg to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        let env_ptr_reg as ptr[u8] = self.fresh_temp()
        append_cstr(ref (deref self).main_out, "  ")
        append_cstr(ref (deref self).main_out, env_ptr_reg to cstr)
        append_cstr(ref (deref self).main_out, " = getelementptr inbounds { ptr, ptr }, ptr ")
        append_cstr(ref (deref self).main_out, closure_reg to cstr)
        append_cstr(ref (deref self).main_out, ", i32 0, i32 1\n")
        append_cstr(ref (deref self).main_out, "  store ptr null, ptr ")
        append_cstr(ref (deref self).main_out, env_ptr_reg to cstr)
        append_cstr(ref (deref self).main_out, "\n")

        return closure_reg

    public fn emit_auto_drops(self as ptr[LLVMCodegen], drops as List[String]):
        let count as i64 = drops.length()
        var i as i64 = 0 to i64
        while i < count:
            let var_name as String = get_string_at(ref drops, i)
            let ptr_reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, ptr_reg to cstr)
            append_cstr(ref (deref self).main_out, " = load ptr, ptr %")
            append_str(ref (deref self).main_out, var_name)
            append_cstr(ref (deref self).main_out, "\n")

            let cond_reg as ptr[u8] = self.fresh_temp()
            append_cstr(ref (deref self).main_out, "  ")
            append_cstr(ref (deref self).main_out, cond_reg to cstr)
            append_cstr(ref (deref self).main_out, " = icmp ne ptr ")
            append_cstr(ref (deref self).main_out, ptr_reg to cstr)
            append_cstr(ref (deref self).main_out, ", null\n")

            let exec_label as ptr[u8] = self.fresh_label()
            let skip_label as ptr[u8] = self.fresh_label()

            append_cstr(ref (deref self).main_out, "  br i1 ")
            append_cstr(ref (deref self).main_out, cond_reg to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, exec_label to cstr)
            append_cstr(ref (deref self).main_out, ", label %")
            append_cstr(ref (deref self).main_out, skip_label to cstr)
            append_cstr(ref (deref self).main_out, "\n")

            append_cstr(ref (deref self).main_out, exec_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            append_cstr(ref (deref self).main_out, "  call void @mantiq_free(ptr ")
            append_cstr(ref (deref self).main_out, ptr_reg to cstr)
            append_cstr(ref (deref self).main_out, ")\n")
            append_cstr(ref (deref self).main_out, "  br label %")
            append_cstr(ref (deref self).main_out, skip_label to cstr)
            append_cstr(ref (deref self).main_out, "\n\n")

            append_cstr(ref (deref self).main_out, skip_label to cstr)
            append_cstr(ref (deref self).main_out, ":\n")
            i = i + 1 to i64

    public fn populate_auto_drops_from_borrowck(self as ptr[LLVMCodegen], borroWck_auto_drops as Dict[usize, List[ptr[Symbol]]]):
        pass

    public fn set_auto_drops_for_node(self as ptr[LLVMCodegen], node_addr as usize, drop_names as List[String]):
        set_dict_drops(ref (deref self).auto_drops, node_addr, drop_names)

    public fn emit_struct_methods(self as ptr[LLVMCodegen], node as ptr[Node]):
        extern fn strcmp(s1 as cstr, s2 as cstr) as i32
        let struct_name as String = node_name(node)
        if node_body(node) != None to ptr[Node]:
            let body as ptr[Node] = node_body(node)
            let decls_raw3 as List[ptr[Node]] = node_declarations(body)
            let decls as ptr[List[ptr[Node]]] = ref decls_raw3
            let count as i64 = (deref decls).length()
            var i as i64 = 0 to i64
            while i < count:
                let decl as ptr[Node] = get_node_decl(decls, i)
                let is_fun as bool = node_kind(decl) == NodeType.FunDecl
                if is_fun:
                    let method_name as String = node_name(decl)
                    if strcmp(method_name.data to cstr, "init" to cstr) != 0 and strcmp(method_name.data to cstr, "__init__" to cstr) != 0:
                        let mangled as StringBuilder = StringBuilder.make()
                        append_str(ref mangled, struct_name)
                        append_cstr(ref mangled, "_" to cstr)
                        append_str(ref mangled, method_name)
                        set_node_name(decl, mangled.to_string())
                        self.emit_fun_decl(decl)
                i = i + 1 to i64

    public fn emit_one_struct_field(self as ptr[LLVMCodegen], decl as ptr[Node], fields_str as ptr[StringBuilder], field_idx_ptr as ptr[i64]):
        let is_var as bool = node_kind(decl) == NodeType.VarDecl
        if is_var:
            if deref field_idx_ptr > 0 to i64:
                append_cstr(fields_str, ", " to cstr)
            let resolved_type as ptr[Type] = self.resolve_field_type(decl)
            if resolved_type != None to ptr[Type]:
                append_str(fields_str, type_to_llvm(resolved_type))
            else:
                append_cstr(fields_str, "i64" to cstr)
            deref field_idx_ptr = deref field_idx_ptr + 1 to i64

    public fn emit_struct_fields(self as ptr[LLVMCodegen], node as ptr[Node], name as String):
        let fields_str as StringBuilder = StringBuilder.make()
        var field_idx as i64 = 0 to i64

        if node_body(node) != None to ptr[Node]:
            let body as ptr[Node] = node_body(node)
            let decls_raw as List[ptr[Node]] = node_declarations(body)
            let decls as ptr[List[ptr[Node]]] = ref decls_raw
            let count as i64 = (deref decls).length()
            var i as i64 = 0 to i64
            while i < count:
                let decl as ptr[Node] = get_node_decl(decls, i)
                self.emit_one_struct_field(decl, ref fields_str, ref field_idx)
                i = i + 1 to i64

        if field_idx == 0 to i64:
            append_cstr(ref fields_str, "i8" to cstr)

        append_cstr(ref (deref self).type_out, "%" to cstr)
        append_str(ref (deref self).type_out, name)
        append_cstr(ref (deref self).type_out, " = type { " to cstr)
        append_str(ref (deref self).type_out, fields_str.to_string())
        append_cstr(ref (deref self).type_out, " }\n\n" to cstr)
        let _sep as i32 = 0 to i32

    public fn resolve_field_type(self as ptr[LLVMCodegen], decl as ptr[Node]) as ptr[Type]:
        let annots_ptr as ptr[u8] = node_type_annots(decl) to ptr[u8]
        if annots_ptr != None to ptr[u8]:
            let annots_list as ptr[List[ptr[u8]]] = annots_ptr to ptr[List[ptr[u8]]]
            if (deref annots_list).length() > 0 to i64:
                let lay as ptr[ptr[u8]] = annots_ptr to ptr[ptr[u8]]
                let opt_annot as ptr[u8] = deref lay
                let opt_layout as ptr[OptionLayout] = opt_annot to ptr[OptionLayout]
                if option_has_value(opt_layout):
                    let val_p as ptr[u8] = (deref opt_layout).val_ptr
                    let annot_val as ptr[TypeAnnotation] = val_p to ptr[TypeAnnotation]
                    return (deref self).resolve_type_from_annotation(annot_val)
        return None to ptr[Type]

    public fn emit_struct_decl(self as ptr[LLVMCodegen], node as ptr[Node]):
        let name as String = node_name(node)
        if (deref self).defined_types.has(name):
            return
        set_dict_bool(ref (deref self).defined_types, name, True)

        self.emit_struct_fields(node, name)

        self.emit_struct_methods(node)

    public fn resolve_type_from_annotation(self as ptr[LLVMCodegen], annot as ptr[TypeAnnotation]) as ptr[Type]:
        extern fn strcmp(s1 as cstr, s2 as cstr) as i32
        extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
        let name as cstr = (deref annot).name.data to cstr
        if strcmp(name, "i8" to cstr) == 0 or strcmp(name, "u8" to cstr) == 0 or strcmp(name, "byte" to cstr) == 0:
            return make_type(TypeKind.I8)
        elif strcmp(name, "i16" to cstr) == 0 or strcmp(name, "u16" to cstr) == 0:
            return make_type(TypeKind.I16)
        elif strcmp(name, "i32" to cstr) == 0 or strcmp(name, "u32" to cstr) == 0:
            return make_type(TypeKind.I32)
        elif strcmp(name, "i64" to cstr) == 0 or strcmp(name, "u64" to cstr) == 0 or strcmp(name, "usize" to cstr) == 0 or strcmp(name, "isize" to cstr) == 0:
            return make_type(TypeKind.I64)
        elif strcmp(name, "f32" to cstr) == 0:
            return make_type(TypeKind.F32)
        elif strcmp(name, "f64" to cstr) == 0:
            return make_type(TypeKind.F64)
        elif strcmp(name, "bool" to cstr) == 0:
            return make_type(TypeKind.Boolean)
        elif strcmp(name, "String" to cstr) == 0:
            return make_type(TypeKind.String)
        elif strcmp(name, "char" to cstr) == 0:
            return make_type(TypeKind.Char)
        elif strcmp(name, "ptr" to cstr) == 0:
            return make_ptr_type(make_type(TypeKind.Void))
        elif strcmp(name, "List" to cstr) == 0:
            return make_type(TypeKind.List)
        elif strcmp(name, "Dict" to cstr) == 0:
            return make_type(TypeKind.Dict)
        elif strncmp(name, "Option[" to cstr, 7 to usize) == 0:
            return make_type(TypeKind.Option)
        elif strncmp(name, "List[" to cstr, 5 to usize) == 0:
            return make_type(TypeKind.List)
        elif strncmp(name, "Dict[" to cstr, 5 to usize) == 0:
            return make_type(TypeKind.Dict)
        return make_struct_type(String.make(name))

    public fn emit_enum_decl(self as ptr[LLVMCodegen], node as ptr[Node]):
        let name as String = node_name(node)
        if (deref self).defined_types.has(name):
            return
        set_dict_bool(ref (deref self).defined_types, name, True)

        append_cstr(ref (deref self).type_out, "%" to cstr)
        append_str(ref (deref self).type_out, name)
        append_cstr(ref (deref self).type_out, " = type { i32, [4 x i64] }\n\n" to cstr)

    public fn emit_union_decl(self as ptr[LLVMCodegen], node as ptr[Node]):
        let name as String = node_name(node)
        if (deref self).defined_types.has(name):
            return
        set_dict_bool(ref (deref self).defined_types, name, True)

        append_cstr(ref (deref self).type_out, "%" to cstr)
        append_str(ref (deref self).type_out, name)
        append_cstr(ref (deref self).type_out, " = type { i32, [32 x i8] }\n\n" to cstr)

        if node_body(node) != None to ptr[Node]:
            let body as ptr[Node] = node_body(node)
            let decls_raw4 as List[ptr[Node]] = node_declarations(body)
            let decls as ptr[List[ptr[Node]]] = ref decls_raw4
            let count as i64 = (deref decls).length()
            var i as i64 = 0 to i64
            while i < count:
                let decl as ptr[Node] = get_node_decl(decls, i)
                if node_kind(decl) == NodeType.FunDecl:
                    self.emit_fun_decl(decl)
                i = i + 1 to i64
