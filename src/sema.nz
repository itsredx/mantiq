// ── Imports ─────────────────────────────────────────────────────────────
import std.collections
from std.string import String, StringBuilder
from std.collections import List
from std.collections import Dict
from std.option import Option
import symbols
from symbols import Node, TypeAnnotation, Span, Symbol, Scope, SymbolKind, LanguageMode, NodeType, node_kind, node_name, node_left, node_right, node_body, node_declarations, set_node_declarations, node_params, node_op, node_cond, node_then_branch, node_else_branch, node_val, node_str_val, node_is_async, node_is_extern, node_is_variadic, node_return_type_annot, node_is_mut, node_type_annots, node_auto_drops, node_target, node_imported_symbols, node_alias, node_span, node_inferred_type, set_node_inferred_type, set_node_name, set_node_left, set_node_body, set_node_auto_drops, set_node_module_name
import lower
from lower import Lowerer, make_lowerer_mantiq_from_cstr

struct OptionLayout:
    public var has_val as u8
    public var val_ptr as ptr[u8]

fn option_has_value(opt as ptr[u8]) as bool:
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).has_val == 1 to u8

fn option_value(opt as ptr[u8]) as ptr[u8]:
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).val_ptr

// ── Scope & Symbol Creators ─────────────────────────────────────────────
fn make_scope(parent as ptr[Scope], closure_node as ptr[Node]) as ptr[Scope]:
    let s as ptr[Scope] = make[Scope](1 to usize) to ptr[Scope]
    (deref s).parent = parent
    (deref s).symbols = Dict[String, ptr[Symbol]]()
    (deref s).closure_node = closure_node
    return s

fn make_symbol(name as String, kind as SymbolKind, decl_node as ptr[Node]) as ptr[Symbol]:
    let sym as ptr[Symbol] = make[u8](256 to usize) to ptr[Symbol]
    (deref sym).name = name
    (deref sym).kind = kind
    (deref sym).decl_node = decl_node
    (deref sym).sym_type = Empty
    (deref sym).is_context_manager = False
    (deref sym).resolved_type = None to ptr[Type]
    return sym

fn read_file_to_str(path as cstr) as String:
    extern fn fopen(path as cstr, mode as cstr) as ptr
    extern fn fseek(stream as ptr, offset as i64, whence as i32) as i32
    extern fn ftell(stream as ptr) as i64
    extern fn rewind(stream as ptr)
    extern fn fread(ptr as ptr, size as usize, nmemb as usize, stream as ptr) as usize
    extern fn fclose(stream as ptr) as i32
    
    let f as ptr = fopen(path, "rb" to cstr)
    if f == None to ptr:
        return String.make("" to cstr)
        
    let SEEK_END as i32 = 2
    let dummy1 as i32 = fseek(f, 0 to i64, SEEK_END)
    let file_size as i64 = ftell(f)
    rewind(f)
    
    let cap as usize = file_size to usize + 1 to usize
    let buf as ptr[u8] = make(cap) to ptr[u8]
    let read_bytes as usize = fread(buf to ptr, 1 to usize, file_size to usize, f)
    buf[read_bytes] = 0 to u8
    
    let dummy2 as i32 = fclose(f)
    return String(data = buf, len = read_bytes, capacity = cap)

extern fn strcmp(s1 as cstr, s2 as cstr) as i32
extern fn printf(format as cstr, ...) as i32
extern fn strdup(s as cstr) as cstr

// ── Sema ───────────────────────────────────────────────────────────────
struct Sema:
    public var current_scope as ptr[Scope]
    public var global_scope as ptr[Scope]
    public var loaded_modules as Dict[String, ptr[Scope]]
    public var module_asts as Dict[String, ptr[Node]]
    public var fn_scopes as Dict[usize, ptr[Scope]]
    public var errors as List[String]
    public var current_file as String
    public var mode as LanguageMode
    public var root_ast as ptr[Node]

    public fn init_sema(self as ptr[Sema], file_path as cstr):
        (deref self).mode = LanguageMode.Nizam
        (deref self).current_file = String.make(file_path)
        (deref self).errors = List[String]()
        (deref self).loaded_modules = Dict[String, ptr[Scope]]()
        (deref self).module_asts = Dict[String, ptr[Node]]()
        (deref self).fn_scopes = Dict[usize, ptr[Scope]]()
        (deref self).root_ast = None to ptr[Node]
        
        let gs as ptr[Scope] = make_scope(None to ptr[Scope], None to ptr[Node])
        (deref self).global_scope = gs
        (deref self).current_scope = gs
        
        (deref gs).symbols[String.make("printf")] = make_symbol(String.make("printf"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("String")] = make_symbol(String.make("String"), SymbolKind.Struct, None to ptr[Node])
        (deref gs).symbols[String.make("List")] = make_symbol(String.make("List"), SymbolKind.Struct, None to ptr[Node])
        (deref gs).symbols[String.make("None")] = make_symbol(String.make("None"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("Some")] = make_symbol(String.make("Some"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("Empty")] = make_symbol(String.make("Empty"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("Ok")] = make_symbol(String.make("Ok"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("Err")] = make_symbol(String.make("Err"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("make")] = make_symbol(String.make("make"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("drop")] = make_symbol(String.make("drop"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("range")] = make_symbol(String.make("range"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("print")] = make_symbol(String.make("print"), SymbolKind.Function, None to ptr[Node])

    public fn report_error(self as ptr[Sema], msg as String, span as Span):
        let cap as usize = msg.len + (deref self).current_file.len + 64 to usize
        let buf as ptr[u8] = make(cap) to ptr[u8]
        extern fn snprintf(str as ptr[u8], size as usize, format as cstr, file as cstr, row as u32, col as u32, err as cstr) as i32
        let len as i32 = snprintf(buf, cap, "%s:%d:%d: error: %s" to cstr, (deref self).current_file.data to cstr, span.start_row + 1 to u32, span.start_col + 1 to u32, msg.data to cstr)
        (deref self).errors.append(String(data = buf, len = len to usize, capacity = cap))
        
        let r as i32 = printf("%s\n" to cstr, buf to cstr)

    public fn lookup_symbol(self as ptr[Sema], name as String) as ptr[Symbol]:
        var curr as ptr[Scope] = (deref self).current_scope
        while curr != None to ptr[Scope]:
            if (deref curr).symbols.has(name):
                return (deref curr).symbols[name]
            curr = (deref curr).parent
        
        if (deref (deref self).global_scope).symbols.has(name):
            return (deref (deref self).global_scope).symbols[name]
            
        return None to ptr[Symbol]

    public fn check_closure_capture(self as ptr[Sema], name as String, sym as ptr[Symbol]):
        let decl_node as ptr[Node] = (deref sym).decl_node
        if decl_node == None to ptr[Node]:
            return
            
        var curr as ptr[Scope] = (deref self).current_scope
        var crossed_function as bool = False
        
        while curr != None to ptr[Scope]:
            if (deref curr).symbols.has(name):
                break
                
            if (deref curr).closure_node != None to ptr[Node]:
                crossed_function = True
                
            curr = (deref curr).parent

    public fn load_imported_module(self as ptr[Sema], node as ptr[Node]):
        let target as String = node_target(node)
        // Skip non-import nodes (e.g. `link` directives) that have empty targets
        if target.len == 0 to usize:
            return
            
        if strcmp(target.data to cstr, "std.mem" to cstr) == 0:
            let mod_sym as ptr[Symbol] = make_symbol(target, SymbolKind.Module, node)
            (deref (deref self).current_scope).symbols[target] = mod_sym
            
            let count as i64 = node_imported_symbols(node).length()
            var s_idx as i64 = 0 to i64
            while s_idx < count:
                let s_name as String = node_imported_symbols(node)[s_idx]
                let builtin_sym as ptr[Symbol] = make_symbol(s_name, SymbolKind.Function, node)
                (deref (deref self).current_scope).symbols[s_name] = builtin_sym
                s_idx = s_idx + 1 to i64
            return
        
        if strcmp(target.data to cstr, "std.option" to cstr) == 0:
            let mod_sym as ptr[Symbol] = make_symbol(target, SymbolKind.Module, node)
            (deref (deref self).current_scope).symbols[target] = mod_sym
            
            let count as i64 = node_imported_symbols(node).length()
            var s_idx as i64 = 0 to i64
            while s_idx < count:
                let s_name as String = node_imported_symbols(node)[s_idx]
                let builtin_sym as ptr[Symbol] = make_symbol(s_name, SymbolKind.Function, node)
                (deref (deref self).current_scope).symbols[s_name] = builtin_sym
                s_idx = s_idx + 1 to i64
            return
        
        if strcmp(target.data to cstr, "std.result" to cstr) == 0:
            let mod_sym as ptr[Symbol] = make_symbol(target, SymbolKind.Module, node)
            (deref (deref self).current_scope).symbols[target] = mod_sym
            
            let count as i64 = node_imported_symbols(node).length()
            var s_idx as i64 = 0 to i64
            while s_idx < count:
                let s_name as String = node_imported_symbols(node)[s_idx]
                let builtin_sym as ptr[Symbol] = make_symbol(s_name, SymbolKind.Function, node)
                (deref (deref self).current_scope).symbols[s_name] = builtin_sym
                s_idx = s_idx + 1 to i64
            return
        
        let module_key as String = target
        if (deref self).loaded_modules.has(module_key):
            let mod_scope as ptr[Scope] = (deref self).loaded_modules[module_key]
            let mod_sym as ptr[Symbol] = make_symbol(target, SymbolKind.Module, node)
            (deref (deref self).current_scope).symbols[target] = mod_sym
            
            let count as i64 = node_imported_symbols(node).length()
            var s_idx as i64 = 0 to i64
            while s_idx < count:
                let s_name as String = node_imported_symbols(node)[s_idx]
                if (deref mod_scope).symbols.has(s_name):
                    let orig_sym as ptr[Symbol] = (deref mod_scope).symbols[s_name]
                    (deref (deref self).current_scope).symbols[s_name] = orig_sym
                else:
                    self.report_error(String.make("symbol not found in module" to cstr), node_span(node))
                s_idx = s_idx + 1 to i64
            return
        
        let path_buf as ptr[u8] = strdup(target.data to cstr) to ptr[u8]
        var idx as i64 = 0 to i64
        while path_buf[idx] != 0 to u8:
            if path_buf[idx] == 46 to u8: // '.' is ASCII 46
                let byte_ptr as ptr[u8] = path_buf
                // Use subscript assignment to set the byte
                byte_ptr[idx] = 47 to u8 // '/' is ASCII 47
            idx = idx + 1 to i64
            
        var content as String = String.make("" to cstr)
        var resolved_path as String = String.make("" to cstr)
        
        let sb1 as StringBuilder = StringBuilder.make()
        sb1.append("./" to cstr)
        sb1.append(path_buf to cstr)
        sb1.append(".nz" to cstr)
        let path1 as String = sb1.to_string()
        
        let sb2 as StringBuilder = StringBuilder.make()
        sb2.append("std/" to cstr)
        sb2.append(path_buf to cstr)
        sb2.append(".nz" to cstr)
        let path2 as String = sb2.to_string()
        
        // Resolve relative to the current file's directory
        let file_path as String = (deref self).current_file
        // Find last '/' to get directory length
        var last_slash as i64 = -1 to i64
        var f_idx as i64 = 0 to i64
        while f_idx < file_path.len to i64:
            if file_path.data[f_idx to usize] == 47 to u8: // '/'
                last_slash = f_idx
            f_idx = f_idx + 1 to i64
        
        // Build directory prefix as a cstr
        var dir_prefix as cstr = "" to cstr
        if last_slash >= 0 to i64:
            let dir_len as usize = (last_slash + 1 to i64) to usize
            let dir_buf as ptr[u8] = make(dir_len + 1 to usize) to ptr[u8]
            var d_i as usize = 0 to usize
            while d_i < dir_len:
                dir_buf[d_i] = file_path.data[d_i]
                d_i = d_i + 1 to usize
            dir_buf[dir_len] = 0 to u8
            dir_prefix = dir_buf to cstr
        
        let sb3 as StringBuilder = StringBuilder.make()
        sb3.append(dir_prefix)
        sb3.append(path_buf to cstr)
        sb3.append(".nz" to cstr)
        let path3 as String = sb3.to_string()
        
        let sb4 as StringBuilder = StringBuilder.make()
        sb4.append(dir_prefix)
        sb4.append("std/" to cstr)
        sb4.append(path_buf to cstr)
        sb4.append(".nz" to cstr)
        let path4 as String = sb4.to_string()
        
        let sb5 as StringBuilder = StringBuilder.make()
        sb5.append("../" to cstr)
        sb5.append(path_buf to cstr)
        sb5.append(".nz" to cstr)
        let path5 as String = sb5.to_string()
        
        content = read_file_to_str(path1.data to cstr)
        if content.len > 0 to usize:
            resolved_path = path1
        else:
            content = read_file_to_str(path2.data to cstr)
            if content.len > 0 to usize:
                resolved_path = path2
            else:
                content = read_file_to_str(path3.data to cstr)
                if content.len > 0 to usize:
                    resolved_path = path3
                else:
                    content = read_file_to_str(path4.data to cstr)
                    if content.len > 0 to usize:
                        resolved_path = path4
                    else:
                        content = read_file_to_str(path5.data to cstr)
                        if content.len > 0 to usize:
                            resolved_path = path5

                // If still not found, walk up from the source file looking for a project root
                if content.len == 0 to usize:
                    extern fn free(p as ptr)
                    // Walk up from file's parent directory trying <dir>/<path>.nz
                    var search_dir_end as i64 = last_slash
                    while search_dir_end > 0 to i64 and content.len == 0 to usize:
                        // Find the previous '/' to go up one level
                        search_dir_end = search_dir_end - 1 to i64
                        while search_dir_end > 0 to i64 and file_path.data[search_dir_end to usize] != 47 to u8:
                            search_dir_end = search_dir_end - 1 to i64
                        if search_dir_end > 0 to i64:
                            let dir_len as usize = (search_dir_end + 1 to i64) to usize
                            let probe_buf as ptr[u8] = make(1024 to usize) to ptr[u8]
                            var pi as usize = 0 to usize
                            while pi < dir_len:
                                probe_buf[pi] = file_path.data[pi]
                                pi = pi + 1 to usize
                            var pj as i64 = 0 to i64
                            while path_buf[pj] != 0 to u8:
                                probe_buf[pi] = path_buf[pj to usize]
                                pi = pi + 1 to usize
                                pj = pj + 1 to i64
                            probe_buf[pi] = 46 to u8
                            pi = pi + 1 to usize
                            probe_buf[pi] = 110 to u8
                            pi = pi + 1 to usize
                            probe_buf[pi] = 122 to u8
                            pi = pi + 1 to usize
                            probe_buf[pi] = 0 to u8

                            content = read_file_to_str(probe_buf to cstr)
                            if content.len > 0 to usize:
                                let path_len as usize = pi
                                let path_buf_new as ptr[u8] = make(path_len + 1 to usize) to ptr[u8]
                                pi = 0 to usize
                                while pi < path_len:
                                    path_buf_new[pi] = probe_buf[pi]
                                    pi = pi + 1 to usize
                                path_buf_new[path_len] = 0 to u8
                                resolved_path = String(data = path_buf_new, len = path_len, capacity = path_len + 1 to usize)
                            else:
                                // Also try <dir>/src/<path>.nz
                                pi = dir_len
                                probe_buf[pi] = 115 to u8
                                pi = pi + 1 to usize
                                probe_buf[pi] = 114 to u8
                                pi = pi + 1 to usize
                                probe_buf[pi] = 99 to u8
                                pi = pi + 1 to usize
                                probe_buf[pi] = 47 to u8
                                pi = pi + 1 to usize
                                pj = 0 to i64
                                while path_buf[pj] != 0 to u8:
                                    probe_buf[pi] = path_buf[pj to usize]
                                    pi = pi + 1 to usize
                                    pj = pj + 1 to i64
                                probe_buf[pi] = 46 to u8
                                pi = pi + 1 to usize
                                probe_buf[pi] = 110 to u8
                                pi = pi + 1 to usize
                                probe_buf[pi] = 122 to u8
                                pi = pi + 1 to usize
                                probe_buf[pi] = 0 to u8

                                content = read_file_to_str(probe_buf to cstr)
                                if content.len > 0 to usize:
                                    let path_len as usize = pi
                                    let path_buf_new as ptr[u8] = make(path_len + 1 to usize) to ptr[u8]
                                    pi = 0 to usize
                                    while pi < path_len:
                                        path_buf_new[pi] = probe_buf[pi]
                                        pi = pi + 1 to usize
                                    path_buf_new[path_len] = 0 to u8
                                    resolved_path = String(data = path_buf_new, len = path_len, capacity = path_len + 1 to usize)
                            free(probe_buf to ptr)
                        
        extern fn free(p as ptr)
        free(path_buf to ptr)
        // Only deinit paths that are NOT the resolved_path (avoid use-after-free)
        if resolved_path.data != path1.data:
            path1.deinit()
        if resolved_path.data != path2.data:
            path2.deinit()
        if resolved_path.data != path3.data:
            path3.deinit()
        if resolved_path.data != path4.data:
            path4.deinit()
        if resolved_path.data != path5.data:
            path5.deinit()
        // path6/path7 are already deinit'd inside the block if not resolved
                        
        if content.len == 0 to usize:
            self.report_error(String.make("cannot find module" to cstr), node_span(node))
            return
            
        let lowerer as ptr[Lowerer] = make_lowerer_mantiq_from_cstr(content.data to cstr, resolved_path.data to cstr)
        let root_ast as ptr[Node] = lowerer.lower_source()
        if root_ast == None to ptr[Node]:
            self.report_error(String.make("compilation error in module" to cstr), node_span(node))
            content.deinit()
            return
            
        let saved_scope as ptr[Scope] = (deref self).current_scope
        let saved_file as String = (deref self).current_file
        
        let mod_scope as ptr[Scope] = make_scope(None to ptr[Scope], root_ast to ptr[Node])
        (deref self).current_scope = mod_scope
        (deref self).current_file = resolved_path
        
        if strcmp(target.data to cstr, "std.collections" to cstr) == 0:
            (deref mod_scope).symbols[String.make("List")] = make_symbol(String.make("List"), SymbolKind.Struct, node)
            (deref mod_scope).symbols[String.make("Dict")] = make_symbol(String.make("Dict"), SymbolKind.Struct, node)
        
        self.declare_pass(root_ast to ptr[Node])
        (deref self).loaded_modules[module_key] = mod_scope
        (deref self).module_asts[module_key] = root_ast
        
        // Merge module declarations into root AST
        let root_prog as ptr[Node] = (deref self).root_ast
        if root_prog != None to ptr[Node] and node_kind(root_prog) == NodeType.Program:
            if node_kind(root_ast) == NodeType.Program:
                let root_decls as List[ptr[Node]] = node_declarations(root_prog)
                let mod_decls as List[ptr[Node]] = node_declarations(root_ast)
                let dc as i64 = mod_decls.length()
                var di as i64 = 0 to i64
                while di < dc:
                    root_decls.append(mod_decls[di])
                    di = di + 1 to i64
                set_node_declarations(root_prog, root_decls)
        
        (deref self).current_scope = saved_scope
        (deref self).current_file = saved_file
        let mod_sym as ptr[Symbol] = make_symbol(target, SymbolKind.Module, node)
        (deref (deref self).current_scope).symbols[target] = mod_sym
        
        let count as i64 = node_imported_symbols(node).length()
        var s_idx as i64 = 0 to i64
        while s_idx < count:
            let s_name as String = node_imported_symbols(node)[s_idx]
            if (deref mod_scope).symbols.has(s_name):
                let orig_sym as ptr[Symbol] = (deref mod_scope).symbols[s_name]
                (deref (deref self).current_scope).symbols[s_name] = orig_sym
            else:
                self.report_error(String.make("symbol not found in module" to cstr), node_span(node))
            s_idx = s_idx + 1 to i64
            
        content.deinit()

    public fn declare_pass(self as ptr[Sema], node as ptr[Node]):
        if node == None to ptr[Node]:
            return
            
        let nt as NodeType = node_kind(node)
        if nt == NodeType.Program:
            let count as i64 = node_declarations(node).length()
            var i as i64 = 0 to i64
            while i < count:
                let cur as List[ptr[Node]] = node_declarations(node)
                self.declare_pass(cur[i])
                i = i + 1 to i64
        elif nt == NodeType.BlockStmt:
            let decls as List[ptr[Node]] = node_declarations(node)
            let count as i64 = decls.length()
            var i as i64 = 0 to i64
            while i < count:
                self.declare_pass(decls[i])
                i = i + 1 to i64
        elif nt == NodeType.VarDecl:
            let name as cstr = node_name(node).data to cstr
            if (deref (deref self).current_scope).parent == None to ptr[Scope] and (deref (deref self).current_scope).symbols.has(String.make(name)):
                self.report_error(String.make("duplicate variable declaration" to cstr), node_span(node))
            else:
                let sym as ptr[Symbol] = make_symbol(String.make(name), SymbolKind.Variable, node)
                (deref (deref self).current_scope).symbols[String.make(name)] = sym
            
            if node_left(node) != None to ptr[Node]:
                self.declare_pass(node_left(node))
        elif nt == NodeType.FunDecl:
            let name as cstr = node_name(node).data to cstr
            if node_is_extern(node):
                // Extern functions don't report duplicates — they re-declare external symbols
                if not (deref (deref self).current_scope).symbols.has(String.make(name)):
                    let sym as ptr[Symbol] = make_symbol(String.make(name), SymbolKind.Function, node)
                    (deref (deref self).current_scope).symbols[String.make(name)] = sym
            else:
                if (deref (deref self).current_scope).symbols.has(String.make(name)):
                    self.report_error(String.make("duplicate function declaration" to cstr), node_span(node))
                else:
                    let sym as ptr[Symbol] = make_symbol(String.make(name), SymbolKind.Function, node)
                    (deref (deref self).current_scope).symbols[String.make(name)] = sym
            
            // Only create child scope and register params if there's a body (non-extern)
            if not node_is_extern(node):
                let parent_scope as ptr[Scope] = (deref self).current_scope
                let child_scope as ptr[Scope] = make_scope(parent_scope, node)
                (deref self).current_scope = child_scope
                (deref self).fn_scopes[node to usize] = child_scope
                
                let param_list as List[ptr[Node]] = node_params(node)
                let param_count as i64 = param_list.length()
                var p_idx as i64 = 0 to i64
                while p_idx < param_count:
                    let p_node as ptr[Node] = param_list[p_idx]
                    let p_name as cstr = node_name(p_node).data to cstr
                    if (deref child_scope).symbols.has(String.make(p_name)):
                        self.report_error(String.make("duplicate parameter name" to cstr), node_span(p_node))
                    else:
                        let p_sym as ptr[Symbol] = make_symbol(String.make(p_name), SymbolKind.Variable, p_node)
                        (deref child_scope).symbols[String.make(p_name)] = p_sym
                    p_idx = p_idx + 1 to i64
                
                if node_body(node) != None to ptr[Node]:
                    self.declare_pass(node_body(node))
                let self_ref_1 as ptr[Sema] = self
                (deref self_ref_1).current_scope = parent_scope
        elif nt == NodeType.ClassDecl:
            let name as String = node_name(node)
            if (deref (deref self).current_scope).symbols.has(name):
                self.report_error(String.make("duplicate class declaration" to cstr), node_span(node))
            else:
                let sym as ptr[Symbol] = make_symbol(name, SymbolKind.Struct, node)
                (deref (deref self).current_scope).symbols[name] = sym
        elif nt == NodeType.StructDecl:
            let name as String = node_name(node)
            if (deref (deref self).current_scope).symbols.has(name):
                self.report_error(String.make("duplicate struct declaration" to cstr), node_span(node))
            else:
                let sym as ptr[Symbol] = make_symbol(name, SymbolKind.Struct, node)
                (deref (deref self).current_scope).symbols[name] = sym
            // Create child scope for fields/methods
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = make_scope(parent_scope, node)
            (deref self).current_scope = child_scope
            (deref self).fn_scopes[node to usize] = child_scope
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
            let self_ref_sd as ptr[Sema] = self
            (deref self_ref_sd).current_scope = parent_scope
        elif nt == NodeType.EnumDecl:
            let name as String = node_name(node)
            if (deref (deref self).current_scope).symbols.has(name):
                self.report_error(String.make("duplicate enum declaration" to cstr), node_span(node))
            else:
                let sym as ptr[Symbol] = make_symbol(name, SymbolKind.Enum, node)
                (deref (deref self).current_scope).symbols[name] = sym
            // Create child scope and register each variant as a Variable
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = make_scope(parent_scope, node)
            (deref self).current_scope = child_scope
            (deref self).fn_scopes[node to usize] = child_scope
            let v_list as List[ptr[Node]] = node_declarations(node)
            let v_count as i64 = v_list.length()
            var v_i as i64 = 0 to i64
            while v_i < v_count:
                let v_node as ptr[Node] = v_list[v_i]
                let v_name as String = node_name(v_node)
                let v_sym as ptr[Symbol] = make_symbol(v_name, SymbolKind.Variable, v_node)
                (deref child_scope).symbols[v_name] = v_sym
                v_i = v_i + 1 to i64
            let self_ref_en as ptr[Sema] = self
            (deref self_ref_en).current_scope = parent_scope
        elif nt == NodeType.UnionDecl:
            let name as String = node_name(node)
            if (deref (deref self).current_scope).symbols.has(name):
                self.report_error(String.make("duplicate union declaration" to cstr), node_span(node))
            else:
                let sym as ptr[Symbol] = make_symbol(name, SymbolKind.Union, node)
                (deref (deref self).current_scope).symbols[name] = sym
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = make_scope(parent_scope, node)
            (deref self).current_scope = child_scope
            (deref self).fn_scopes[node to usize] = child_scope
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
            let self_ref_ud as ptr[Sema] = self
            (deref self_ref_ud).current_scope = parent_scope
        elif nt == NodeType.WhileStmt:
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
        elif nt == NodeType.ForStmt:
            if node_left(node) != None to ptr[Node]:
                self.declare_pass(node_left(node))
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
        elif nt == NodeType.WithStmt:
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = make_scope(parent_scope, node)
            (deref self).current_scope = child_scope
            (deref self).fn_scopes[node to usize] = child_scope
            
            // Define the context variable in this scope with is_context_manager = True
            var var_name as String = node_name(node)
            if var_name.len == 0 to usize:
                // Generate a temporary name like "_with_temp_{start_byte}"
                let cap as usize = 32 to usize
                let buf as ptr[u8] = make(cap) to ptr[u8]
                extern fn snprintf(str as ptr[u8], size as usize, format as cstr, val as u32) as i32
                let snprintf_len as i32 = snprintf(buf, cap, "_with_temp_%d" to cstr, node_span(node).start_byte)
                var_name = String(data = buf, len = snprintf_len to usize, capacity = cap)
                set_node_name(node, var_name)
                
            let sym as ptr[Symbol] = make_symbol(var_name, SymbolKind.Variable, node)
            (deref sym).is_context_manager = True
            (deref child_scope).symbols[var_name] = sym
            
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
            let self_ref_w1 as ptr[Sema] = self
            (deref self_ref_w1).current_scope = parent_scope
        elif nt == NodeType.IfStmt:
            if node_then_branch(node) != None to ptr[Node]:
                self.declare_pass(node_then_branch(node))
            let else_opt_raw as Option[ptr[Node]] = node_else_branch(node)
            let else_opt as ptr[u8] = (ref else_opt_raw) to ptr[u8]
            if option_has_value(else_opt):
                let else_node as ptr[Node] = option_value(else_opt) to ptr[Node]
                self.declare_pass(else_node)
        elif nt == NodeType.WhileStmt:
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
        elif nt == NodeType.ForStmt:
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
        elif nt == NodeType.ImportDecl:
            self.load_imported_module(node)

    public fn resolve_pass(self as ptr[Sema], node as ptr[Node]):
        if node == None to ptr[Node]:
            return
            
        let nt as NodeType = node_kind(node)
        if nt == NodeType.Program:
            let decls as List[ptr[Node]] = node_declarations(node)
            let count as i64 = decls.length()
            var i as i64 = 0 to i64
            while i < count:
                self.resolve_pass(decls[i])
                i = i + 1 to i64
        elif nt == NodeType.BlockStmt:
            let decls as List[ptr[Node]] = node_declarations(node)
            let count as i64 = decls.length()
            var i as i64 = 0 to i64
            while i < count:
                self.resolve_pass(decls[i])
                i = i + 1 to i64
        elif nt == NodeType.VarDecl:
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
        elif nt == NodeType.FunDecl:
            // Extern functions have no body or child scope — skip resolve
            if node_is_extern(node):
                return
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
            (deref self).current_scope = child_scope
                
            if node_body(node) != None to ptr[Node]:
                self.resolve_pass(node_body(node))
            let self_ref_2 as ptr[Sema] = self
            (deref self_ref_2).current_scope = parent_scope
        elif nt == NodeType.Identifier:
            let name as cstr = node_name(node).data to cstr
            if strcmp(name, "break" to cstr) == 0 or strcmp(name, "continue" to cstr) == 0 or strcmp(name, "None" to cstr) == 0 or strcmp(name, "True" to cstr) == 0 or strcmp(name, "False" to cstr) == 0 or strcmp(name, "Empty" to cstr) == 0:
                return
            let resolved as ptr[Symbol] = self.lookup_symbol(String.make(name))
            if resolved == None to ptr[Symbol]:
                self.report_error(String.make("undeclared variable" to cstr), node_span(node))
            else:
                self.check_closure_capture(String.make(name), resolved)
        elif nt == NodeType.BinaryExpr:
            let op as cstr = node_op(node).data to cstr
            if strcmp(op, "." to cstr) == 0:
                let left as ptr[Node] = node_left(node)
                let right as ptr[Node] = node_right(node)
                if node_kind(left) == NodeType.Identifier and node_kind(right) == NodeType.Identifier:
                    let mod_name as cstr = node_name(left).data to cstr
                    let sym_name as cstr = node_name(right).data to cstr
                    
                    let mod_sym as ptr[Symbol] = self.lookup_symbol(String.make(mod_name))
                    if mod_sym != None to ptr[Symbol]:
                        if (deref mod_sym).kind == SymbolKind.Module:
                            let mod_scope as ptr[Scope] = (deref self).loaded_modules[String.make(mod_name)]
                            if (deref mod_scope).symbols.has(String.make(sym_name)):
                                let target_sym as ptr[Symbol] = (deref mod_scope).symbols[String.make(sym_name)]
                            else:
                                self.report_error(String.make("symbol not found in module" to cstr), node_span(node))
                        else:
                            self.report_error(String.make("module not found" to cstr), node_span(node))
                    else:
                        self.report_error(String.make("module not found" to cstr), node_span(node))
            elif strcmp(op, "=" to cstr) == 0:
                // Skip resolving LHS of assignment (struct field name in named args / struct literals)
                self.resolve_pass(node_right(node))
            else:
                self.resolve_pass(node_left(node))
                self.resolve_pass(node_right(node))
        elif nt == NodeType.CallExpr:
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
            let args as List[ptr[Node]] = node_params(node)
            let arg_count as i64 = args.length()
            var a_idx as i64 = 0 to i64
            while a_idx < arg_count:
                self.resolve_pass(args[a_idx])
                a_idx = a_idx + 1 to i64
        elif nt == NodeType.ReturnStmt:
            if node_body(node) != None to ptr[Node]:
                self.resolve_pass(node_body(node))
        elif nt == NodeType.WhileStmt:
            if node_cond(node) != None to ptr[Node]:
                self.resolve_pass(node_cond(node))
            if node_body(node) != None to ptr[Node]:
                self.resolve_pass(node_body(node))
        elif nt == NodeType.IfStmt:
            if node_cond(node) != None to ptr[Node]:
                self.resolve_pass(node_cond(node))
            if node_then_branch(node) != None to ptr[Node]:
                self.resolve_pass(node_then_branch(node))
            let else_opt_raw as Option[ptr[Node]] = node_else_branch(node)
            let else_opt as ptr[u8] = (ref else_opt_raw) to ptr[u8]
            if option_has_value(else_opt):
                let else_node as ptr[Node] = option_value(else_opt) to ptr[Node]
                self.resolve_pass(else_node)
        elif nt == NodeType.CastExpr or nt == NodeType.UnaryExpr:
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
        elif nt == NodeType.ForStmt:
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
            if node_body(node) != None to ptr[Node]:
                self.resolve_pass(node_body(node))
        elif nt == NodeType.MemberExpr:
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
        elif nt == NodeType.WithStmt:
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
            (deref self).current_scope = child_scope
            if node_body(node) != None to ptr[Node]:
                self.resolve_pass(node_body(node))
            let self_ref_w2 as ptr[Sema] = self
            (deref self_ref_w2).current_scope = parent_scope
        elif nt == NodeType.StructDecl:
            let parent_scope as ptr[Scope] = (deref self).current_scope
            if (deref self).fn_scopes.has(node to usize):
                let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
                (deref self).current_scope = child_scope
                if node_body(node) != None to ptr[Node]:
                    self.resolve_pass(node_body(node))
                let self_ref_sd2 as ptr[Sema] = self
                (deref self_ref_sd2).current_scope = parent_scope
        elif nt == NodeType.EnumDecl:
            let parent_scope as ptr[Scope] = (deref self).current_scope
            if (deref self).fn_scopes.has(node to usize):
                let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
                (deref self).current_scope = child_scope
                let e_decls as List[ptr[Node]] = node_declarations(node)
                let count as i64 = e_decls.length()
                var e_i as i64 = 0 to i64
                while e_i < count:
                    self.resolve_pass(e_decls[e_i])
                    e_i = e_i + 1 to i64
                let self_ref_en2 as ptr[Sema] = self
                (deref self_ref_en2).current_scope = parent_scope
        elif nt == NodeType.UnionDecl:
            let parent_scope as ptr[Scope] = (deref self).current_scope
            if (deref self).fn_scopes.has(node to usize):
                let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
                (deref self).current_scope = child_scope
                if node_body(node) != None to ptr[Node]:
                    self.resolve_pass(node_body(node))
                let self_ref_ud2 as ptr[Sema] = self
                (deref self_ref_ud2).current_scope = parent_scope
