extern fn sprintf(str as ptr[u8], format as cstr, ...) as i32
extern fn free(p as ptr)

struct OptionLayout:
    public var has_val as u8
    public var val_ptr as ptr[u8]

fn option_has_value(opt as ptr[u8]) as bool:
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).has_val == 1 to u8

fn option_value(opt as ptr[u8]) as ptr[u8]:
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).val_ptr

// ── Scope & Symbol Creators ─────────────────────────────────────────────
fn make_scope(parent as ptr[Scope], closure_node as ptr[Node]) as ptr[Scope]:
    let s as ptr[Scope] = make[Scope](1 to usize) to ptr[Scope]
    (deref s).parent = parent
    (deref s).symbols = Dict[String, ptr[Symbol]]()
    (deref s).closure_node = closure_node
    return s

fn make_symbol(name as String, kind as SymbolKind, decl_node as ptr[Node]) as ptr[Symbol]:
    let sym as ptr[Symbol] = make[u8](256 to usize) to ptr[Symbol]
    (deref sym).name = name
    (deref sym).kind = kind
    (deref sym).decl_node = decl_node
    (deref sym).sym_type = Empty
    (deref sym).is_context_manager = False
    (deref sym).resolved_type = None to ptr[Type]
    return sym

fn read_file_to_str(path as cstr) as String:
    extern fn fopen(path as cstr, mode as cstr) as ptr
    extern fn fseek(stream as ptr, offset as i64, whence as i32) as i32
    extern fn ftell(stream as ptr) as i64
    extern fn rewind(stream as ptr)
    extern fn fread(ptr as ptr, size as usize, nmemb as usize, stream as ptr) as usize
    extern fn fclose(stream as ptr) as i32
    
    let f as ptr = fopen(path, "rb" to cstr)
    if f == None to ptr:
        return String.make("" to cstr)
        
    let SEEK_END as i32 = 2
    let dummy1 as i32 = fseek(f, 0 to i64, SEEK_END)
    let file_size as i64 = ftell(f)
    rewind(f)
    
    let cap as usize = file_size to usize + 1 to usize
    let buf as ptr[u8] = make(cap) to ptr[u8]
    let read_bytes as usize = fread(buf to ptr, 1 to usize, file_size to usize, f)
    buf[read_bytes] = 0 to u8
    
    let dummy2 as i32 = fclose(f)
    return String(data = buf, len = read_bytes, capacity = cap)

extern fn strcmp(s1 as cstr, s2 as cstr) as i32
extern fn strncmp(s1 as cstr, s2 as cstr, n as usize) as i32
extern fn printf(format as cstr, ...) as i32
extern fn strdup(s as cstr) as cstr

// ── Sema ───────────────────────────────────────────────────────────────
struct Sema:
    public var current_scope as ptr[Scope]
    public var global_scope as ptr[Scope]
    public var loaded_modules as Dict[String, ptr[Scope]]
    public var module_asts as Dict[String, ptr[Node]]
    public var fn_scopes as Dict[usize, ptr[Scope]]
    public var errors as List[String]
    public var current_file as String
    public var mode as LanguageMode
    public var root_ast as ptr[Node]
    public var engine as ptr[DiagnosticEngine]
    public var link_targets as List[String]

    public fn init_sema(self as ptr[Sema], file_path as cstr):
        (deref self).mode = LanguageMode.Nizam
        (deref self).current_file = String.make(file_path)
        (deref self).errors = List[String]()
        (deref self).loaded_modules = Dict[String, ptr[Scope]]()
        (deref self).module_asts = Dict[String, ptr[Node]]()
        (deref self).fn_scopes = Dict[usize, ptr[Scope]]()
        (deref self).root_ast = None to ptr[Node]
        (deref self).engine = None to ptr[DiagnosticEngine]
        (deref self).link_targets = List[String]()
        
        let gs as ptr[Scope] = make_scope(None to ptr[Scope], None to ptr[Node])
        (deref self).global_scope = gs
        (deref self).current_scope = gs
        
        (deref gs).symbols[String.make("printf")] = make_symbol(String.make("printf"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("String")] = make_symbol(String.make("String"), SymbolKind.Struct, None to ptr[Node])
        (deref gs).symbols[String.make("List")] = make_symbol(String.make("List"), SymbolKind.Struct, None to ptr[Node])
        (deref gs).symbols[String.make("None")] = make_symbol(String.make("None"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("Some")] = make_symbol(String.make("Some"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("Empty")] = make_symbol(String.make("Empty"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("Ok")] = make_symbol(String.make("Ok"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("Err")] = make_symbol(String.make("Err"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("make")] = make_symbol(String.make("make"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("drop")] = make_symbol(String.make("drop"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("range")] = make_symbol(String.make("range"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("print")] = make_symbol(String.make("print"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("qbit")] = make_symbol(String.make("qbit"), SymbolKind.Struct, None to ptr[Node])
        (deref gs).symbols[String.make("qreg")] = make_symbol(String.make("qreg"), SymbolKind.Struct, None to ptr[Node])
        (deref gs).symbols[String.make("H")] = make_symbol(String.make("H"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("measure")] = make_symbol(String.make("measure"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("CNOT")] = make_symbol(String.make("CNOT"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("X")] = make_symbol(String.make("X"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("Y")] = make_symbol(String.make("Y"), SymbolKind.Function, None to ptr[Node])
        (deref gs).symbols[String.make("Z")] = make_symbol(String.make("Z"), SymbolKind.Function, None to ptr[Node])

    public fn report_error(self as ptr[Sema], msg as String, span as Span):
        self.report_error_with_code("E0101" to cstr, msg, (deref self).current_file, span)

    public fn report_error_with_code(self as ptr[Sema], code as cstr, msg as String, file_path as String, span as Span) as ptr[Diagnostic]:
        let cap as usize = msg.len + file_path.len + 64 to usize
        let buf as ptr[u8] = make(cap) to ptr[u8]
        extern fn snprintf(str as ptr[u8], size as usize, format as cstr, ...) as i32
        let len as i32 = snprintf(buf, cap, "%s:%d:%d: error: %s" to cstr, file_path.data to cstr, span.start_row + 1 to u32, span.start_col + 1 to u32, msg.data to cstr)
        (deref self).errors.append(String(data = buf, len = len to usize, capacity = cap))
        
        if (deref self).engine != None to ptr[DiagnosticEngine]:
            return (deref (deref self).engine).report_error(code, msg, file_path, span)
        else:
            let r as i32 = printf("%s\n" to cstr, buf to cstr)
        return None to ptr[Diagnostic]

    public fn report_error_node(self as ptr[Sema], code as cstr, msg as String, node as ptr[Node]) as ptr[Diagnostic]:
        let file_path as String = node_file_path(node, (deref self).current_file)
        return self.report_error_with_code(code, msg, file_path, node_span(node))

    public fn lookup_symbol(self as ptr[Sema], name as String) as ptr[Symbol]:
        var curr as ptr[Scope] = (deref self).current_scope
        while curr != None to ptr[Scope]:
            if (deref curr).symbols.has(name):
                return (deref curr).symbols[name]
            curr = (deref curr).parent
        
        if (deref (deref self).global_scope).symbols.has(name):
            return (deref (deref self).global_scope).symbols[name]
            
        return None to ptr[Symbol]

    public fn check_closure_capture(self as ptr[Sema], name as String, sym as ptr[Symbol]):
        let decl_node as ptr[Node] = (deref sym).decl_node
        if decl_node == None to ptr[Node]:
            return
            
        var curr as ptr[Scope] = (deref self).current_scope
        var crossed_function as bool = False
        
        while curr != None to ptr[Scope]:
            if (deref curr).symbols.has(name):
                break
                
            if (deref curr).closure_node != None to ptr[Node]:
                crossed_function = True
                
            curr = (deref curr).parent

    public fn load_imported_module(self as ptr[Sema], node as ptr[Node]):
        let target as String = node_target(node)
        // Skip non-import nodes (e.g. `link` directives) that have empty targets
        if target.len == 0 to usize:
            return
            
        if strcmp(target.data to cstr, "std.mem" to cstr) == 0:
            let mod_sym as ptr[Symbol] = make_symbol(target, SymbolKind.Module, node)
            (deref (deref self).current_scope).symbols[target] = mod_sym
            
            let count as i64 = node_imported_symbols(node).length()
            var s_idx as i64 = 0 to i64
            while s_idx < count:
                let s_name as String = node_imported_symbols(node)[s_idx]
                let builtin_sym as ptr[Symbol] = make_symbol(s_name, SymbolKind.Function, node)
                (deref (deref self).current_scope).symbols[s_name] = builtin_sym
                s_idx = s_idx + 1 to i64
            return
        
        if strcmp(target.data to cstr, "std.option" to cstr) == 0:
            let mod_sym as ptr[Symbol] = make_symbol(target, SymbolKind.Module, node)
            (deref (deref self).current_scope).symbols[target] = mod_sym
            
            let count as i64 = node_imported_symbols(node).length()
            var s_idx as i64 = 0 to i64
            while s_idx < count:
                let s_name as String = node_imported_symbols(node)[s_idx]
                let builtin_sym as ptr[Symbol] = make_symbol(s_name, SymbolKind.Function, node)
                (deref (deref self).current_scope).symbols[s_name] = builtin_sym
                s_idx = s_idx + 1 to i64
            return
        
        if strcmp(target.data to cstr, "std.result" to cstr) == 0:
            let mod_sym as ptr[Symbol] = make_symbol(target, SymbolKind.Module, node)
            (deref (deref self).current_scope).symbols[target] = mod_sym
            
            let count as i64 = node_imported_symbols(node).length()
            var s_idx as i64 = 0 to i64
            while s_idx < count:
                let s_name as String = node_imported_symbols(node)[s_idx]
                let builtin_sym as ptr[Symbol] = make_symbol(s_name, SymbolKind.Function, node)
                (deref (deref self).current_scope).symbols[s_name] = builtin_sym
                s_idx = s_idx + 1 to i64
            return
        
        if strcmp(target.data to cstr, "std.quantum" to cstr) == 0:
            let mod_sym as ptr[Symbol] = make_symbol(target, SymbolKind.Module, node)
            (deref (deref self).current_scope).symbols[target] = mod_sym
            
            let count as i64 = node_imported_symbols(node).length()
            var s_idx as i64 = 0 to i64
            while s_idx < count:
                let s_name as String = node_imported_symbols(node)[s_idx]
                let builtin_sym as ptr[Symbol] = make_symbol(s_name, SymbolKind.Function, node)
                (deref (deref self).current_scope).symbols[s_name] = builtin_sym
                s_idx = s_idx + 1 to i64
            return
        
        let module_key as String = target
        if (deref self).loaded_modules.has(module_key):
            let mod_scope as ptr[Scope] = (deref self).loaded_modules[module_key]
            let mod_sym as ptr[Symbol] = make_symbol(target, SymbolKind.Module, node)
            (deref (deref self).current_scope).symbols[target] = mod_sym
            
            let count as i64 = node_imported_symbols(node).length()
            var s_idx as i64 = 0 to i64
            while s_idx < count:
                let s_name as String = node_imported_symbols(node)[s_idx]
                if (deref mod_scope).symbols.has(s_name):
                    let orig_sym as ptr[Symbol] = (deref mod_scope).symbols[s_name]
                    (deref (deref self).current_scope).symbols[s_name] = orig_sym
                else:
                    self.report_error_node("E0104" to cstr, String.make("symbol not found in module" to cstr), node)
                s_idx = s_idx + 1 to i64
            return
        
        let import_k as ImportKind = node_import_kind(node)
        if import_k == ImportKind.C or import_k == ImportKind.Pkg:
            let t_cstr as cstr = target.data to cstr
            let t_len as usize = target.len
            let is_header as bool = False
            if t_len >= 2 to usize:
                let last_two as ptr[u8] = (target.data to usize + t_len - 2 to usize) to ptr[u8]
                if last_two[0] == 46 to u8 and last_two[1] == 104 to u8: // .h
                    is_header = True
            if not is_header and t_len > 0 to usize:
                var already_present as bool = False
                let l_cnt as i64 = (deref self).link_targets.length()
                var li as i64 = 0 to i64
                while li < l_cnt:
                    if strcmp((deref self).link_targets[li].data to cstr, t_cstr) == 0:
                        already_present = True
                        break
                    li = li + 1 to i64
                if not already_present:
                    (deref self).link_targets.append(String.make(t_cstr))
            return
        
        // Resolve relative to the current file's directory
        let file_path as String = (deref self).current_file
        var last_slash as i64 = -1 to i64
        var f_idx as i64 = 0 to i64
        while f_idx < file_path.len to i64:
            if file_path.data[f_idx to usize] == 47 to u8: // '/'
                last_slash = f_idx
            f_idx = f_idx + 1 to i64
        
        var dir_prefix as cstr = "" to cstr
        if last_slash >= 0 to i64:
            let dir_len as usize = (last_slash + 1 to i64) to usize
            let dir_buf as ptr[u8] = make(dir_len + 1 to usize) to ptr[u8]
            var d_i as usize = 0 to usize
            while d_i < dir_len:
                dir_buf[d_i] = file_path.data[d_i]
                d_i = d_i + 1 to usize
            dir_buf[dir_len] = 0 to u8
            dir_prefix = dir_buf to cstr

        let path_buf as ptr[u8] = strdup(target.data to cstr) to ptr[u8]
        var idx as i64 = 0 to i64
        while path_buf[idx] != 0 to u8:
            if path_buf[idx] == 46 to u8: // '.' is ASCII 46
                let byte_ptr as ptr[u8] = path_buf
                byte_ptr[idx] = 47 to u8 // '/' is ASCII 47
            idx = idx + 1 to i64
            
        var content as String = String.make("" to cstr)
        var resolved_path as String = String.make("" to cstr)

        if import_k == ImportKind.Path:
            var path_content as String = read_file_to_str(target.data to cstr)
            if path_content.len > 0 to usize:
                content = path_content
                resolved_path = String.make(target.data to cstr)
            else:
                let sbp as StringBuilder = StringBuilder.make()
                sbp.append(target.data to cstr)
                sbp.append(".nz" to cstr)
                let target_nz as String = sbp.to_string()
                path_content = read_file_to_str(target_nz.data to cstr)
                if path_content.len > 0 to usize:
                    content = path_content
                    resolved_path = target_nz
                else:
                    if dir_prefix != None to cstr:
                        let sbp_dir as StringBuilder = StringBuilder.make()
                        sbp_dir.append(dir_prefix)
                        sbp_dir.append(target.data to cstr)
                        let pdir as String = sbp_dir.to_string()
                        path_content = read_file_to_str(pdir.data to cstr)
                        if path_content.len > 0 to usize:
                            content = path_content
                            resolved_path = pdir
                        else:
                            let sbp_dir_nz as StringBuilder = StringBuilder.make()
                            sbp_dir_nz.append(pdir.data to cstr)
                            sbp_dir_nz.append(".nz" to cstr)
                            let pdir_nz as String = sbp_dir_nz.to_string()
                            path_content = read_file_to_str(pdir_nz.data to cstr)
                            if path_content.len > 0 to usize:
                                content = path_content
                                resolved_path = pdir_nz
                            else:
                                pdir_nz.deinit()
                            pdir.deinit()
                    target_nz.deinit()

        if import_k == ImportKind.Vendor and content.len == 0 to usize:
            let sbv as StringBuilder = StringBuilder.make()
            sbv.append("vendor/" to cstr)
            sbv.append(path_buf to cstr)
            sbv.append(".nz" to cstr)
            let v_path as String = sbv.to_string()
            let v_content as String = read_file_to_str(v_path.data to cstr)
            if v_content.len > 0 to usize:
                content = v_content
                resolved_path = v_path
            else:
                let sbv_m as StringBuilder = StringBuilder.make()
                sbv_m.append("vendor/" to cstr)
                sbv_m.append(path_buf to cstr)
                sbv_m.append("/main.nz" to cstr)
                let vm_path as String = sbv_m.to_string()
                let vm_content as String = read_file_to_str(vm_path.data to cstr)
                if vm_content.len > 0 to usize:
                    content = vm_content
                    resolved_path = vm_path
                else:
                    if dir_prefix != None to cstr:
                        let sbv_d as StringBuilder = StringBuilder.make()
                        sbv_d.append(dir_prefix)
                        sbv_d.append("vendor/" to cstr)
                        sbv_d.append(path_buf to cstr)
                        sbv_d.append(".nz" to cstr)
                        let vd_path as String = sbv_d.to_string()
                        let vd_content as String = read_file_to_str(vd_path.data to cstr)
                        if vd_content.len > 0 to usize:
                            content = vd_content
                            resolved_path = vd_path
                        else:
                            vd_path.deinit()
                    vm_path.deinit()
                v_path.deinit()
        
        let sb1 as StringBuilder = StringBuilder.make()
        sb1.append("./" to cstr)
        sb1.append(path_buf to cstr)
        sb1.append(".nz" to cstr)
        let path1 as String = sb1.to_string()
        
        let sb2 as StringBuilder = StringBuilder.make()
        sb2.append("std/" to cstr)
        sb2.append(path_buf to cstr)
        sb2.append(".nz" to cstr)
        let path2 as String = sb2.to_string()
        let sb3 as StringBuilder = StringBuilder.make()
        sb3.append(dir_prefix)
        sb3.append(path_buf to cstr)
        sb3.append(".nz" to cstr)
        let path3 as String = sb3.to_string()
        
        let sb4 as StringBuilder = StringBuilder.make()
        sb4.append(dir_prefix)
        sb4.append("std/" to cstr)
        sb4.append(path_buf to cstr)
        sb4.append(".nz" to cstr)
        let path4 as String = sb4.to_string()
        
        let sb5 as StringBuilder = StringBuilder.make()
        sb5.append("../" to cstr)
        sb5.append(path_buf to cstr)
        sb5.append(".nz" to cstr)
        let path5 as String = sb5.to_string()
        
        if content.len == 0 to usize:
            content = read_file_to_str(path1.data to cstr)
            if content.len > 0 to usize:
                resolved_path = path1
            else:
                content = read_file_to_str(path2.data to cstr)
                if content.len > 0 to usize:
                    resolved_path = path2
                else:
                    content = read_file_to_str(path3.data to cstr)
                    if content.len > 0 to usize:
                        resolved_path = path3
                    else:
                        content = read_file_to_str(path4.data to cstr)
                        if content.len > 0 to usize:
                            resolved_path = path4
                        else:
                            content = read_file_to_str(path5.data to cstr)
                            if content.len > 0 to usize:
                                resolved_path = path5

                // If still not found, walk up from the source file looking for a project root
                if content.len == 0 to usize:
                    extern fn free(p as ptr)
                    // Walk up from file's parent directory trying <dir>/<path>.nz
                    var search_dir_end as i64 = last_slash
                    while search_dir_end > 0 to i64 and content.len == 0 to usize:
                        // Find the previous '/' to go up one level
                        search_dir_end = search_dir_end - 1 to i64
                        while search_dir_end > 0 to i64 and file_path.data[search_dir_end to usize] != 47 to u8:
                            search_dir_end = search_dir_end - 1 to i64
                        if search_dir_end > 0 to i64:
                            let dir_len as usize = (search_dir_end + 1 to i64) to usize
                            let probe_buf as ptr[u8] = make(1024 to usize) to ptr[u8]
                            var pi as usize = 0 to usize
                            while pi < dir_len:
                                probe_buf[pi] = file_path.data[pi]
                                pi = pi + 1 to usize
                            var pj as i64 = 0 to i64
                            while path_buf[pj] != 0 to u8:
                                probe_buf[pi] = path_buf[pj to usize]
                                pi = pi + 1 to usize
                                pj = pj + 1 to i64
                            probe_buf[pi] = 46 to u8
                            pi = pi + 1 to usize
                            probe_buf[pi] = 110 to u8
                            pi = pi + 1 to usize
                            probe_buf[pi] = 122 to u8
                            pi = pi + 1 to usize
                            probe_buf[pi] = 0 to u8

                            content = read_file_to_str(probe_buf to cstr)
                            if content.len > 0 to usize:
                                let path_len as usize = pi
                                let path_buf_new as ptr[u8] = make(path_len + 1 to usize) to ptr[u8]
                                pi = 0 to usize
                                while pi < path_len:
                                    path_buf_new[pi] = probe_buf[pi]
                                    pi = pi + 1 to usize
                                path_buf_new[path_len] = 0 to u8
                                resolved_path = String(data = path_buf_new, len = path_len, capacity = path_len + 1 to usize)
                            else:
                                // Also try <dir>/src/<path>.nz
                                pi = dir_len
                                probe_buf[pi] = 115 to u8
                                pi = pi + 1 to usize
                                probe_buf[pi] = 114 to u8
                                pi = pi + 1 to usize
                                probe_buf[pi] = 99 to u8
                                pi = pi + 1 to usize
                                probe_buf[pi] = 47 to u8
                                pi = pi + 1 to usize
                                pj = 0 to i64
                                while path_buf[pj] != 0 to u8:
                                    probe_buf[pi] = path_buf[pj to usize]
                                    pi = pi + 1 to usize
                                    pj = pj + 1 to i64
                                probe_buf[pi] = 46 to u8
                                pi = pi + 1 to usize
                                probe_buf[pi] = 110 to u8
                                pi = pi + 1 to usize
                                probe_buf[pi] = 122 to u8
                                pi = pi + 1 to usize
                                probe_buf[pi] = 0 to u8

                                content = read_file_to_str(probe_buf to cstr)
                                if content.len > 0 to usize:
                                    let path_len as usize = pi
                                    let path_buf_new as ptr[u8] = make(path_len + 1 to usize) to ptr[u8]
                                    pi = 0 to usize
                                    while pi < path_len:
                                        path_buf_new[pi] = probe_buf[pi]
                                        pi = pi + 1 to usize
                                    path_buf_new[path_len] = 0 to u8
                                    resolved_path = String(data = path_buf_new, len = path_len, capacity = path_len + 1 to usize)
                            free(probe_buf to ptr)
                        
        extern fn free(p as ptr)
        free(path_buf to ptr)
        // Only deinit paths that are NOT the resolved_path (avoid use-after-free)
        if resolved_path.data != path1.data:
            path1.deinit()
        if resolved_path.data != path2.data:
            path2.deinit()
        if resolved_path.data != path3.data:
            path3.deinit()
        if resolved_path.data != path4.data:
            path4.deinit()
        if resolved_path.data != path5.data:
            path5.deinit()
        // path6/path7 are already deinit'd inside the block if not resolved
                        
        if content.len == 0 to usize:
            self.report_error_with_code("E0103" to cstr, String.make("cannot find module" to cstr), node_file_path(node, (deref self).current_file), node_span(node))
            return
            
        if (deref self).engine != None to ptr[DiagnosticEngine]:
            (deref (deref self).engine).register_source(resolved_path, content)

        extern fn strstr(haystack as cstr, needle as cstr) as cstr
        var lowerer as ptr[Lowerer] = None to ptr[Lowerer]
        if strstr(resolved_path.data to cstr, ".nz" to cstr) != None to cstr:
            lowerer = make_lowerer_from_cstr(content.data to cstr, resolved_path.data to cstr)
        else:
            lowerer = make_lowerer_mantiq_from_cstr(content.data to cstr, resolved_path.data to cstr)
        if (deref self).engine != None to ptr[DiagnosticEngine]:
            (deref (deref self).engine).register_source(resolved_path, content)
        let root_ast as ptr[Node] = lowerer.lower_source()
        if root_ast == None to ptr[Node]:
            self.report_error_with_code("E0001" to cstr, String.make("compilation error in module" to cstr), resolved_path, node_span(node))
            content.deinit()
            return
            
        let saved_scope as ptr[Scope] = (deref self).current_scope
        let saved_file as String = (deref self).current_file
        
        let mod_scope as ptr[Scope] = make_scope(None to ptr[Scope], root_ast to ptr[Node])
        (deref self).current_scope = mod_scope
        (deref self).current_file = resolved_path
        
        if strcmp(target.data to cstr, "std.collections" to cstr) == 0:
            (deref mod_scope).symbols[String.make("List")] = make_symbol(String.make("List"), SymbolKind.Struct, node)
            (deref mod_scope).symbols[String.make("Dict")] = make_symbol(String.make("Dict"), SymbolKind.Struct, node)
        
        self.declare_pass(root_ast to ptr[Node])
        (deref self).loaded_modules[module_key] = mod_scope
        (deref self).module_asts[module_key] = root_ast
        
        // Merge module declarations into root AST
        let root_prog as ptr[Node] = (deref self).root_ast
        if root_prog != None to ptr[Node] and node_kind(root_prog) == NodeType.Program:
            if node_kind(root_ast) == NodeType.Program:
                let root_decls as List[ptr[Node]] = node_declarations(root_prog)
                let mod_decls as List[ptr[Node]] = node_declarations(root_ast)
                let dc as i64 = mod_decls.length()
                var di as i64 = 0 to i64
                while di < dc:
                    root_decls.append(mod_decls[di])
                    di = di + 1 to i64
                set_node_declarations(root_prog, root_decls)
        
        (deref self).current_scope = saved_scope
        (deref self).current_file = saved_file
        let mod_sym as ptr[Symbol] = make_symbol(target, SymbolKind.Module, node)
        (deref (deref self).current_scope).symbols[target] = mod_sym
        
        let count as i64 = node_imported_symbols(node).length()
        if count == 0 to i64 and (import_k == ImportKind.Path or import_k == ImportKind.Vendor):
            let mod_keys as List[String] = (deref mod_scope).symbols.keys()
            let mk_cnt as i64 = mod_keys.length()
            var mki as i64 = 0 to i64
            while mki < mk_cnt:
                let sym_k as String = mod_keys[mki]
                let sym_v as ptr[Symbol] = (deref mod_scope).symbols[sym_k]
                (deref (deref self).current_scope).symbols[sym_k] = sym_v
                mki = mki + 1 to i64
        else:
            var s_idx as i64 = 0 to i64
            while s_idx < count:
                let s_name as String = node_imported_symbols(node)[s_idx]
                if (deref mod_scope).symbols.has(s_name):
                    let orig_sym as ptr[Symbol] = (deref mod_scope).symbols[s_name]
                    (deref (deref self).current_scope).symbols[s_name] = orig_sym
                else:
                    self.report_error_node("E0104" to cstr, String.make("symbol not found in module" to cstr), node)
                s_idx = s_idx + 1 to i64
            
        content.deinit()

    public fn declare_pass(self as ptr[Sema], node as ptr[Node]):
        if node == None to ptr[Node]:
            return
            
        let nt as NodeType = node_kind(node)
        if nt == NodeType.Program:
            let count as i64 = node_declarations(node).length()
            var i as i64 = 0 to i64
            while i < count:
                let cur as List[ptr[Node]] = node_declarations(node)
                self.declare_pass(cur[i])
                i = i + 1 to i64
        elif nt == NodeType.BlockStmt:
            let decls as List[ptr[Node]] = node_declarations(node)
            let count as i64 = decls.length()
            var i as i64 = 0 to i64
            while i < count:
                self.declare_pass(decls[i])
                i = i + 1 to i64
        elif nt == NodeType.ParamBlockStmt:
            let ret_names as List[String] = node_return_names(node)
            let ret_count as i64 = ret_names.length()
            var r_i as i64 = 0 to i64
            while r_i < ret_count:
                let r_name_str as String = ret_names[r_i]
                if r_name_str.data != None to ptr[u8] and r_name_str.len > 0 to usize:
                    let r_cstr as cstr = r_name_str.data to cstr
                    let r_sym as ptr[Symbol] = make_symbol(String.make(r_cstr), SymbolKind.Variable, node)
                    (deref (deref self).current_scope).symbols[String.make(r_cstr)] = r_sym
                r_i = r_i + 1 to i64

            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = make_scope(parent_scope, node)
            (deref child_scope).closure_node = node
            (deref self).current_scope = child_scope
            (deref self).fn_scopes[node to usize] = child_scope

            let param_list as List[ptr[Node]] = node_params(node)
            let param_count as i64 = param_list.length()
            var p_idx as i64 = 0 to i64
            while p_idx < param_count:
                let p_node as ptr[Node] = param_list[p_idx]
                let p_cstr as cstr = node_name(p_node).data to cstr
                let p_sym as ptr[Symbol] = make_symbol(String.make(p_cstr), SymbolKind.Variable, p_node)
                (deref child_scope).symbols[String.make(p_cstr)] = p_sym
                p_idx = p_idx + 1 to i64

            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))

            let self_ref_pb as ptr[Sema] = self
            (deref self_ref_pb).current_scope = parent_scope
        elif nt == NodeType.VarDecl:
            let name as String = node_name(node)
            if (deref (deref self).current_scope).parent == None to ptr[Scope] and (deref (deref self).current_scope).symbols.has(name):
                self.report_error_node("E0102" to cstr, String.make("duplicate variable declaration" to cstr), node)
            else:
                let sym as ptr[Symbol] = make_symbol(name, SymbolKind.Variable, node)
                (deref (deref self).current_scope).symbols[name] = sym
            
            if node_left(node) != None to ptr[Node]:
                self.declare_pass(node_left(node))
        elif nt == NodeType.FunDecl:
            let name as String = node_name(node)
            if node_is_extern(node):
                // Extern functions don't report duplicates — they re-declare external symbols
                if not (deref (deref self).current_scope).symbols.has(name):
                    let sym as ptr[Symbol] = make_symbol(name, SymbolKind.Function, node)
                    (deref (deref self).current_scope).symbols[name] = sym
            else:
                if (deref (deref self).current_scope).symbols.has(name):
                    self.report_error_node("E0102" to cstr, String.make("duplicate function declaration" to cstr), node)
                else:
                    let sym as ptr[Symbol] = make_symbol(name, SymbolKind.Function, node)
                    (deref (deref self).current_scope).symbols[name] = sym
            
            // Only create child scope and register params if there's a body (non-extern)
            if not node_is_extern(node):
                let parent_scope as ptr[Scope] = (deref self).current_scope
                let child_scope as ptr[Scope] = make_scope(parent_scope, node)
                (deref self).current_scope = child_scope
                (deref self).fn_scopes[node to usize] = child_scope
                
                let param_list as List[ptr[Node]] = node_params(node)
                let param_count as i64 = param_list.length()
                var p_idx as i64 = 0 to i64
                while p_idx < param_count:
                    let p_node as ptr[Node] = param_list[p_idx]
                    let p_name as cstr = node_name(p_node).data to cstr
                    if (deref child_scope).symbols.has(String.make(p_name)):
                        self.report_error_node("E0102" to cstr, String.make("duplicate parameter name" to cstr), p_node)
                    else:
                        let p_sym as ptr[Symbol] = make_symbol(String.make(p_name), SymbolKind.Variable, p_node)
                        (deref child_scope).symbols[String.make(p_name)] = p_sym
                    p_idx = p_idx + 1 to i64
                
                if node_body(node) != None to ptr[Node]:
                    self.declare_pass(node_body(node))
                let self_ref_1 as ptr[Sema] = self
                (deref self_ref_1).current_scope = parent_scope
        elif nt == NodeType.ClassDecl:
            let name as String = node_name(node)
            if (deref (deref self).current_scope).symbols.has(name):
                self.report_error_node("E0102" to cstr, String.make("duplicate class declaration" to cstr), node)
            else:
                let sym as ptr[Symbol] = make_symbol(name, SymbolKind.Class, node)
                (deref (deref self).current_scope).symbols[name] = sym
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = make_scope(parent_scope, node)
            (deref self).current_scope = child_scope
            (deref self).fn_scopes[node to usize] = child_scope
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
            let self_ref_cd as ptr[Sema] = self
            (deref self_ref_cd).current_scope = parent_scope
        elif nt == NodeType.InterfaceDecl:
            let name as String = node_name(node)
            if (deref (deref self).current_scope).symbols.has(name):
                self.report_error_node("E0102" to cstr, String.make("duplicate interface declaration" to cstr), node)
            else:
                let sym as ptr[Symbol] = make_symbol(name, SymbolKind.Interface, node)
                (deref (deref self).current_scope).symbols[name] = sym
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = make_scope(parent_scope, node)
            (deref self).current_scope = child_scope
            (deref self).fn_scopes[node to usize] = child_scope
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
            let self_ref_id as ptr[Sema] = self
            (deref self_ref_id).current_scope = parent_scope
        elif nt == NodeType.StructDecl:
            let name as String = node_name(node)
            if (deref (deref self).current_scope).symbols.has(name):
                self.report_error_node("E0102" to cstr, String.make("duplicate struct declaration" to cstr), node)
            else:
                let sym as ptr[Symbol] = make_symbol(name, SymbolKind.Struct, node)
                (deref (deref self).current_scope).symbols[name] = sym
            // Create child scope for fields/methods
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = make_scope(parent_scope, node)
            (deref self).current_scope = child_scope
            (deref self).fn_scopes[node to usize] = child_scope
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
            let self_ref_sd as ptr[Sema] = self
            (deref self_ref_sd).current_scope = parent_scope
        elif nt == NodeType.EnumDecl:
            let name as String = node_name(node)
            if (deref (deref self).current_scope).symbols.has(name):
                self.report_error_node("E0102" to cstr, String.make("duplicate enum declaration" to cstr), node)
            else:
                let sym as ptr[Symbol] = make_symbol(name, SymbolKind.Enum, node)
                (deref (deref self).current_scope).symbols[name] = sym
            // Create child scope
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = make_scope(parent_scope, node)
            (deref self).current_scope = child_scope
            (deref self).fn_scopes[node to usize] = child_scope
            let v_list as List[ptr[Node]] = node_declarations(node)
            let v_count as i64 = v_list.length()
            var v_i as i64 = 0 to i64
            while v_i < v_count:
                let v_node as ptr[Node] = v_list[v_i]
                let v_name as String = node_name(v_node)
                let v_kind as NodeType = node_kind(v_node)
                if v_kind == NodeType.FunDecl:
                    if node_body(v_node) != None to ptr[Node]:
                        let m_sym as ptr[Symbol] = make_symbol(v_name, SymbolKind.Function, v_node)
                        (deref child_scope).symbols[v_name] = m_sym
                        let m_buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]
                        let _ as i32 = sprintf(m_buf, "%s_%s" to cstr, name.data to cstr, v_name.data to cstr)
                        let mangled_m as String = String.make(m_buf to cstr)
                        let m_sym_p as ptr[Symbol] = make_symbol(mangled_m, SymbolKind.Function, v_node)
                        (deref parent_scope).symbols[mangled_m] = m_sym_p
                        free(m_buf to ptr)

                        let m_parent as ptr[Scope] = (deref self).current_scope
                        let m_child as ptr[Scope] = make_scope(m_parent, v_node)
                        (deref self).current_scope = m_child
                        (deref self).fn_scopes[v_node to usize] = m_child
                        let p_list as List[ptr[Node]] = node_params(v_node)
                        let p_count as i64 = p_list.length()
                        var pi as i64 = 0 to i64
                        while pi < p_count:
                            let p_node as ptr[Node] = p_list[pi]
                            let p_name as String = node_name(p_node)
                            if not (deref m_child).symbols.has(p_name):
                                let p_sym as ptr[Symbol] = make_symbol(p_name, SymbolKind.Variable, p_node)
                                (deref m_child).symbols[p_name] = p_sym
                            pi = pi + 1 to i64
                        if node_body(v_node) != None to ptr[Node]:
                            self.declare_pass(node_body(v_node))
                        let self_ref_m as ptr[Sema] = self
                        (deref self_ref_m).current_scope = m_parent
                    else:
                        let v_sym as ptr[Symbol] = make_symbol(v_name, SymbolKind.Function, v_node)
                        (deref child_scope).symbols[v_name] = v_sym
                        (deref parent_scope).symbols[v_name] = v_sym
                        let m_buf2 as ptr[u8] = make[u8](128 to usize) to ptr[u8]
                        let _ as i32 = sprintf(m_buf2, "%s_%s" to cstr, name.data to cstr, v_name.data to cstr)
                        let mangled_m2 as String = String.make(m_buf2 to cstr)
                        let v_sym_m2 as ptr[Symbol] = make_symbol(mangled_m2, SymbolKind.Function, v_node)
                        (deref parent_scope).symbols[mangled_m2] = v_sym_m2
                        free(m_buf2 to ptr)
                else:
                    let v_sym as ptr[Symbol] = make_symbol(v_name, SymbolKind.Variable, v_node)
                    (deref child_scope).symbols[v_name] = v_sym
                    (deref parent_scope).symbols[v_name] = v_sym
                    let m_buf3 as ptr[u8] = make[u8](128 to usize) to ptr[u8]
                    let _ as i32 = sprintf(m_buf3, "%s_%s" to cstr, name.data to cstr, v_name.data to cstr)
                    let mangled_m3 as String = String.make(m_buf3 to cstr)
                    let v_sym_m3 as ptr[Symbol] = make_symbol(mangled_m3, SymbolKind.Variable, v_node)
                    (deref parent_scope).symbols[mangled_m3] = v_sym_m3
                    free(m_buf3 to ptr)
                v_i = v_i + 1 to i64
            let self_ref_en as ptr[Sema] = self
            (deref self_ref_en).current_scope = parent_scope
        elif nt == NodeType.UnionDecl:
            let name as String = node_name(node)
            if (deref (deref self).current_scope).symbols.has(name):
                self.report_error_node("E0102" to cstr, String.make("duplicate union declaration" to cstr), node)
            else:
                let sym as ptr[Symbol] = make_symbol(name, SymbolKind.Union, node)
                (deref (deref self).current_scope).symbols[name] = sym
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = make_scope(parent_scope, node)
            (deref self).current_scope = child_scope
            (deref self).fn_scopes[node to usize] = child_scope
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
            let self_ref_ud as ptr[Sema] = self
            (deref self_ref_ud).current_scope = parent_scope
        elif nt == NodeType.FieldDecl:
            let name as String = node_name(node)
            if name.len > 0 to usize:
                if not (deref (deref self).current_scope).symbols.has(name):
                    let sym as ptr[Symbol] = make_symbol(name, SymbolKind.TypeAlias, node)
                    (deref (deref self).current_scope).symbols[name] = sym
        elif nt == NodeType.WhileStmt:
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
        elif nt == NodeType.ForStmt:
            if node_left(node) != None to ptr[Node]:
                self.declare_pass(node_left(node))
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = make_scope(parent_scope, node)
            (deref self).current_scope = child_scope
            (deref self).fn_scopes[node to usize] = child_scope

            let var_name as String = node_name(node)
            if var_name.len > 0 to usize:
                let sym as ptr[Symbol] = make_symbol(var_name, SymbolKind.Variable, node)
                (deref child_scope).symbols[var_name] = sym

            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))

            let self_ref_f as ptr[Sema] = self
            (deref self_ref_f).current_scope = parent_scope
        elif nt == NodeType.WithStmt:
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = make_scope(parent_scope, node)
            (deref self).current_scope = child_scope
            (deref self).fn_scopes[node to usize] = child_scope
            
            // Define the context variable in this scope with is_context_manager = True
            var var_name as String = node_name(node)
            if var_name.len == 0 to usize:
                // Generate a temporary name like "_with_temp_{start_byte}"
                let cap as usize = 32 to usize
                let buf as ptr[u8] = make(cap) to ptr[u8]
                extern fn snprintf(str as ptr[u8], size as usize, format as cstr, ...) as i32
                let snprintf_len as i32 = snprintf(buf, cap, "_with_temp_%d" to cstr, node_span(node).start_byte)
                var_name = String(data = buf, len = snprintf_len to usize, capacity = cap)
                set_node_name(node, var_name)
                
            let sym as ptr[Symbol] = make_symbol(var_name, SymbolKind.Variable, node)
            (deref sym).is_context_manager = True
            (deref child_scope).symbols[var_name] = sym
            
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
            let self_ref_w1 as ptr[Sema] = self
            (deref self_ref_w1).current_scope = parent_scope
        elif nt == NodeType.TryStmt:
            if node_left(node) != None to ptr[Node]:
                self.declare_pass(node_left(node))
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = make_scope(parent_scope, node)
            (deref self).current_scope = child_scope
            (deref self).fn_scopes[node to usize] = child_scope
            
            let var_name as String = node_name(node)
            if var_name.len > 0 to usize and strcmp(var_name.data to cstr, "_" to cstr) != 0:
                let sym as ptr[Symbol] = make_symbol(var_name, SymbolKind.Variable, node)
                (deref child_scope).symbols[var_name] = sym
            
            if node_body(node) != None to ptr[Node]:
                self.declare_pass(node_body(node))
            let self_ref_t1 as ptr[Sema] = self
            (deref self_ref_t1).current_scope = parent_scope
        elif nt == NodeType.ThrowStmt:
            if node_left(node) != None to ptr[Node]:
                self.declare_pass(node_left(node))
        elif nt == NodeType.IfStmt:
            if node_then_branch(node) != None to ptr[Node]:
                self.declare_pass(node_then_branch(node))
            let else_opt_raw as Option[ptr[Node]] = node_else_branch(node)
            let else_opt as ptr[u8] = (ref else_opt_raw) to ptr[u8]
            if option_has_value(else_opt):
                let else_node as ptr[Node] = option_value(else_opt) to ptr[Node]
                self.declare_pass(else_node)
        elif nt == NodeType.MatchStmt:
            if node_left(node) != None to ptr[Node]:
                self.declare_pass(node_left(node))
            let cases as List[ptr[Node]] = node_declarations(node)
            let case_cnt as i64 = cases.length()
            var ci as i64 = 0 to i64
            while ci < case_cnt:
                let case_node as ptr[Node] = cases[ci]
                let parent_scope as ptr[Scope] = (deref self).current_scope
                let child_scope as ptr[Scope] = make_scope(parent_scope, case_node)
                (deref self).current_scope = child_scope
                (deref self).fn_scopes[case_node to usize] = child_scope

                var pat_node as ptr[Node] = node_left(case_node)
                if pat_node != None to ptr[Node]:
                    if node_kind(pat_node) == NodeType.BinaryExpr and strcmp(node_op(pat_node).data to cstr, "if" to cstr) == 0:
                        pat_node = node_left(pat_node)

                    if node_kind(pat_node) == NodeType.Identifier:
                        let pat_name as String = node_name(pat_node)
                        if strcmp(pat_name.data to cstr, "_" to cstr) != 0:
                            let sym as ptr[Symbol] = make_symbol(pat_name, SymbolKind.Variable, pat_node)
                            (deref child_scope).symbols[pat_name] = sym
                    elif node_kind(pat_node) == NodeType.BinaryExpr and strcmp(node_op(pat_node).data to cstr, "is" to cstr) == 0:
                        let is_var as ptr[Node] = node_left(pat_node)
                        if is_var != None to ptr[Node] and node_kind(is_var) == NodeType.Identifier:
                            let var_name as String = node_name(is_var)
                            if strcmp(var_name.data to cstr, "_" to cstr) != 0:
                                let sym as ptr[Symbol] = make_symbol(var_name, SymbolKind.Variable, is_var)
                                (deref child_scope).symbols[var_name] = sym
                    elif node_kind(pat_node) == NodeType.CallExpr:
                        let pat_args as List[ptr[Node]] = node_params(pat_node)
                        let pa_count as i64 = pat_args.length()
                        var pa_i as i64 = 0 to i64
                        while pa_i < pa_count:
                            let pa_n as ptr[Node] = pat_args[pa_i]
                            if node_kind(pa_n) == NodeType.Identifier:
                                let pa_name as String = node_name(pa_n)
                                if strcmp(pa_name.data to cstr, "_" to cstr) != 0:
                                    let sym as ptr[Symbol] = make_symbol(pa_name, SymbolKind.Variable, pa_n)
                                    (deref child_scope).symbols[pa_name] = sym
                            pa_i = pa_i + 1 to i64

                if node_right(case_node) != None to ptr[Node]:
                    self.declare_pass(node_right(case_node))

                let self_ref_mc as ptr[Sema] = self
                (deref self_ref_mc).current_scope = parent_scope
                ci = ci + 1 to i64
        elif nt == NodeType.ImportDecl:
            self.load_imported_module(node)

    public fn resolve_pass(self as ptr[Sema], node as ptr[Node]):
        if node == None to ptr[Node]:
            return
            
        let nt as NodeType = node_kind(node)
        if nt == NodeType.Program:
            let decls as List[ptr[Node]] = node_declarations(node)
            let count as i64 = decls.length()
            var i as i64 = 0 to i64
            while i < count:
                self.resolve_pass(decls[i])
                i = i + 1 to i64
        elif nt == NodeType.BlockStmt:
            let decls as List[ptr[Node]] = node_declarations(node)
            let count as i64 = decls.length()
            var i as i64 = 0 to i64
            while i < count:
                self.resolve_pass(decls[i])
                i = i + 1 to i64
        elif nt == NodeType.ParamBlockStmt:
            if (deref self).fn_scopes.has(node to usize):
                let parent_scope as ptr[Scope] = (deref self).current_scope
                let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
                (deref self).current_scope = child_scope

                if node_body(node) != None to ptr[Node]:
                    self.resolve_pass(node_body(node))

                let self_ref_pb2 as ptr[Sema] = self
                (deref self_ref_pb2).current_scope = parent_scope
        elif nt == NodeType.VarDecl:
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
        elif nt == NodeType.FunDecl:
            // Extern functions have no body or child scope — skip resolve
            if node_is_extern(node):
                return
            if not (deref self).fn_scopes.has(node to usize):
                return
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
            (deref self).current_scope = child_scope
                
            if node_body(node) != None to ptr[Node]:
                self.resolve_pass(node_body(node))
            let self_ref_2 as ptr[Sema] = self
            (deref self_ref_2).current_scope = parent_scope
        elif nt == NodeType.Identifier:
            let name as String = node_name(node)
            if name.len == 0 to usize:
                return
            let n_cstr as cstr = name.data to cstr
            let n_len as usize = name.len
            if (n_len == 5 to usize and strncmp(n_cstr, "super" to cstr, 5 to usize) == 0) or (n_len == 5 to usize and strncmp(n_cstr, "break" to cstr, 5 to usize) == 0) or (n_len == 8 to usize and strncmp(n_cstr, "continue" to cstr, 8 to usize) == 0) or (n_len == 4 to usize and strncmp(n_cstr, "None" to cstr, 4 to usize) == 0) or (n_len == 4 to usize and strncmp(n_cstr, "True" to cstr, 4 to usize) == 0) or (n_len == 5 to usize and strncmp(n_cstr, "False" to cstr, 5 to usize) == 0) or (n_len == 5 to usize and strncmp(n_cstr, "Empty" to cstr, 5 to usize) == 0):
                return
            // Allow primitive types used in type intrinsics/casts
            if (n_len == 3 to usize and (strncmp(n_cstr, "i32" to cstr, 3 to usize) == 0 or strncmp(n_cstr, "i64" to cstr, 3 to usize) == 0 or strncmp(n_cstr, "u32" to cstr, 3 to usize) == 0 or strncmp(n_cstr, "u64" to cstr, 3 to usize) == 0 or strncmp(n_cstr, "f32" to cstr, 3 to usize) == 0 or strncmp(n_cstr, "f64" to cstr, 3 to usize) == 0 or strncmp(n_cstr, "ptr" to cstr, 3 to usize) == 0 or strncmp(n_cstr, "i16" to cstr, 3 to usize) == 0 or strncmp(n_cstr, "u16" to cstr, 3 to usize) == 0 or strncmp(n_cstr, "Any" to cstr, 3 to usize) == 0 or strncmp(n_cstr, "i128" to cstr, 4 to usize) == 0)) or (n_len == 2 to usize and (strncmp(n_cstr, "i8" to cstr, 2 to usize) == 0 or strncmp(n_cstr, "u8" to cstr, 2 to usize) == 0)) or (n_len == 4 to usize and (strncmp(n_cstr, "bool" to cstr, 4 to usize) == 0 or strncmp(n_cstr, "cstr" to cstr, 4 to usize) == 0 or strncmp(n_cstr, "void" to cstr, 4 to usize) == 0)) or (n_len == 5 to usize and (strncmp(n_cstr, "usize" to cstr, 5 to usize) == 0 or strncmp(n_cstr, "isize" to cstr, 5 to usize) == 0)):
                return
            let resolved as ptr[Symbol] = self.lookup_symbol(name)
            if resolved == None to ptr[Symbol]:
                self.report_error_node("E0101" to cstr, String.make("undeclared variable" to cstr), node)
            else:
                self.check_closure_capture(name, resolved)
        elif nt == NodeType.BinaryExpr:
            let op as cstr = node_op(node).data to cstr
            if strcmp(op, "." to cstr) == 0:
                let left as ptr[Node] = node_left(node)
                let right as ptr[Node] = node_right(node)
                if node_kind(left) == NodeType.Identifier and node_kind(right) == NodeType.Identifier:
                    let mod_name as cstr = node_name(left).data to cstr
                    let sym_name as cstr = node_name(right).data to cstr
                    
                    let mod_sym as ptr[Symbol] = self.lookup_symbol(String.make(mod_name))
                    if mod_sym != None to ptr[Symbol]:
                        if (deref mod_sym).kind == SymbolKind.Module:
                            let mod_scope as ptr[Scope] = (deref self).loaded_modules[String.make(mod_name)]
                            if not (deref mod_scope).symbols.has(String.make(sym_name)):
                                self.report_error_node("E0104" to cstr, String.make("symbol not found in module" to cstr), node)
                        elif (deref mod_sym).kind == SymbolKind.Enum:
                            // Enum variant access (e.g. PassMode.Coerce) - valid
                            let _enum_ok as bool = True
                        elif (deref mod_sym).kind == SymbolKind.Variable or (deref mod_sym).kind == SymbolKind.Struct:
                            // Field or static method access - valid
                            let _var_ok as bool = True
                    else:
                        // Left is not in scope yet or is a field expression
                        let _other_ok as bool = True
            elif strcmp(op, "=" to cstr) == 0:
                // Skip resolving LHS of assignment (struct field name in named args / struct literals)
                self.resolve_pass(node_right(node))
            elif strcmp(op, "is" to cstr) == 0:
                // RHS of 'is' is a type, not a variable
                self.resolve_pass(node_left(node))
            else:
                self.resolve_pass(node_left(node))
                self.resolve_pass(node_right(node))
        elif nt == NodeType.CallExpr:
            let callee as ptr[Node] = node_left(node)
            var is_type_intrinsic as bool = False
            if callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier:
                let c_name as String = node_name(callee)
                let c_data as cstr = c_name.data to cstr
                let c_len as usize = c_name.len
                if (c_len == 4 to usize and strncmp(c_data, "size" to cstr, 4 to usize) == 0) or (c_len == 7 to usize and strncmp(c_data, "size_of" to cstr, 7 to usize) == 0) or (c_len == 6 to usize and strncmp(c_data, "sizeof" to cstr, 6 to usize) == 0) or (c_len == 7 to usize and strncmp(c_data, "alignof" to cstr, 7 to usize) == 0) or (c_len == 8 to usize and strncmp(c_data, "align_of" to cstr, 8 to usize) == 0):
                    is_type_intrinsic = True
            if not is_type_intrinsic:
                if callee != None to ptr[Node]:
                    self.resolve_pass(callee)
                let args as List[ptr[Node]] = node_params(node)
                let arg_count as i64 = args.length()
                var a_idx as i64 = 0 to i64
                while a_idx < arg_count:
                    self.resolve_pass(args[a_idx])
                    a_idx = a_idx + 1 to i64
        elif nt == NodeType.ReturnStmt:
            if node_body(node) != None to ptr[Node]:
                self.resolve_pass(node_body(node))
        elif nt == NodeType.WhileStmt:
            if node_cond(node) != None to ptr[Node]:
                self.resolve_pass(node_cond(node))
            if node_body(node) != None to ptr[Node]:
                self.resolve_pass(node_body(node))
        elif nt == NodeType.IfStmt:
            if node_cond(node) != None to ptr[Node]:
                self.resolve_pass(node_cond(node))
            if node_then_branch(node) != None to ptr[Node]:
                self.resolve_pass(node_then_branch(node))
            let else_opt_raw as Option[ptr[Node]] = node_else_branch(node)
            let else_opt as ptr[u8] = (ref else_opt_raw) to ptr[u8]
            if option_has_value(else_opt):
                let else_node as ptr[Node] = option_value(else_opt) to ptr[Node]
                self.resolve_pass(else_node)
        elif nt == NodeType.CastExpr or nt == NodeType.UnaryExpr:
            let op as String = node_op(node)
            if nt == NodeType.UnaryExpr and op.data != None to ptr[u8] and strcmp(op.data to cstr, "size" to cstr) == 0:
                return
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
        elif nt == NodeType.ForStmt:
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
            let parent_scope as ptr[Scope] = (deref self).current_scope
            if (deref self).fn_scopes.has(node to usize):
                let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
                (deref self).current_scope = child_scope
                if node_body(node) != None to ptr[Node]:
                    self.resolve_pass(node_body(node))
                let self_ref_f2 as ptr[Sema] = self
                (deref self_ref_f2).current_scope = parent_scope
        elif nt == NodeType.MemberExpr:
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
        elif nt == NodeType.WithStmt:
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
            let parent_scope as ptr[Scope] = (deref self).current_scope
            let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
            (deref self).current_scope = child_scope
            if node_body(node) != None to ptr[Node]:
                self.resolve_pass(node_body(node))
            let self_ref_w2 as ptr[Sema] = self
            (deref self_ref_w2).current_scope = parent_scope
        elif nt == NodeType.TryStmt:
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
            let parent_scope as ptr[Scope] = (deref self).current_scope
            if (deref self).fn_scopes.has(node to usize):
                let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
                (deref self).current_scope = child_scope
                if node_body(node) != None to ptr[Node]:
                    self.resolve_pass(node_body(node))
                let self_ref_t2 as ptr[Sema] = self
                (deref self_ref_t2).current_scope = parent_scope
            elif node_body(node) != None to ptr[Node]:
                self.resolve_pass(node_body(node))
        elif nt == NodeType.ThrowStmt:
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
        elif nt == NodeType.ClassDecl:
            let parent_scope as ptr[Scope] = (deref self).current_scope
            if (deref self).fn_scopes.has(node to usize):
                let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
                (deref self).current_scope = child_scope
                if node_body(node) != None to ptr[Node]:
                    self.resolve_pass(node_body(node))
                let self_ref_cd2 as ptr[Sema] = self
                (deref self_ref_cd2).current_scope = parent_scope
        elif nt == NodeType.InterfaceDecl:
            let parent_scope as ptr[Scope] = (deref self).current_scope
            if (deref self).fn_scopes.has(node to usize):
                let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
                (deref self).current_scope = child_scope
                if node_body(node) != None to ptr[Node]:
                    self.resolve_pass(node_body(node))
                let self_ref_id2 as ptr[Sema] = self
                (deref self_ref_id2).current_scope = parent_scope
        elif nt == NodeType.StructDecl:
            let parent_scope as ptr[Scope] = (deref self).current_scope
            if (deref self).fn_scopes.has(node to usize):
                let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
                (deref self).current_scope = child_scope
                if node_body(node) != None to ptr[Node]:
                    self.resolve_pass(node_body(node))
                let self_ref_sd2 as ptr[Sema] = self
                (deref self_ref_sd2).current_scope = parent_scope
        elif nt == NodeType.EnumDecl:
            let parent_scope as ptr[Scope] = (deref self).current_scope
            if (deref self).fn_scopes.has(node to usize):
                let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
                (deref self).current_scope = child_scope
                let e_decls as List[ptr[Node]] = node_declarations(node)
                let count as i64 = e_decls.length()
                var e_i as i64 = 0 to i64
                while e_i < count:
                    self.resolve_pass(e_decls[e_i])
                    e_i = e_i + 1 to i64
                let self_ref_en2 as ptr[Sema] = self
                (deref self_ref_en2).current_scope = parent_scope
        elif nt == NodeType.UnionDecl:
            let parent_scope as ptr[Scope] = (deref self).current_scope
            if (deref self).fn_scopes.has(node to usize):
                let child_scope as ptr[Scope] = (deref self).fn_scopes[node to usize]
                (deref self).current_scope = child_scope
                if node_body(node) != None to ptr[Node]:
                    self.resolve_pass(node_body(node))
                let self_ref_ud2 as ptr[Sema] = self
                (deref self_ref_ud2).current_scope = parent_scope
        elif nt == NodeType.MatchStmt:
            if node_left(node) != None to ptr[Node]:
                self.resolve_pass(node_left(node))
            let cases as List[ptr[Node]] = node_declarations(node)
            let case_cnt as i64 = cases.length()
            var ci as i64 = 0 to i64
            while ci < case_cnt:
                let case_node as ptr[Node] = cases[ci]
                let parent_scope as ptr[Scope] = (deref self).current_scope
                if (deref self).fn_scopes.has(case_node to usize):
                    let child_scope as ptr[Scope] = (deref self).fn_scopes[case_node to usize]
                    (deref self).current_scope = child_scope

                    let pat_wrapper as ptr[Node] = node_left(case_node)
                    if pat_wrapper != None to ptr[Node]:
                        if node_kind(pat_wrapper) == NodeType.BinaryExpr and strcmp(node_op(pat_wrapper).data to cstr, "if" to cstr) == 0:
                            let inner_pat as ptr[Node] = node_left(pat_wrapper)
                            if node_kind(inner_pat) == NodeType.BinaryExpr and strcmp(node_op(inner_pat).data to cstr, "is" to cstr) == 0:
                                // Is pattern: do not resolve left identifier (it's declared variable)
                            elif node_kind(inner_pat) != NodeType.Identifier:
                                self.resolve_pass(inner_pat)
                            self.resolve_pass(node_right(pat_wrapper))
                        elif node_kind(pat_wrapper) == NodeType.BinaryExpr and strcmp(node_op(pat_wrapper).data to cstr, "is" to cstr) == 0:
                            // Is pattern: do not resolve left identifier (it's declared variable)
                        elif node_kind(pat_wrapper) != NodeType.Identifier:
                            self.resolve_pass(pat_wrapper)

                    if node_right(case_node) != None to ptr[Node]:
                        self.resolve_pass(node_right(case_node))

                    let self_ref_m2 as ptr[Sema] = self
                    (deref self_ref_m2).current_scope = parent_scope
                ci = ci + 1 to i64
