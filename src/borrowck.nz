// ── Imports ─────────────────────────────────────────────────────────────
import std.collections
from std.string import String
from std.collections import List, Dict
from std.option import Option, Empty
from std.mem import make
import symbols
from symbols import Node, Symbol, Scope, SymbolKind, Span, NodeType, node_kind, node_name, node_left, node_right, node_body, node_declarations, node_params, node_op, node_cond, node_then_branch, node_else_branch, node_span, node_inferred_type, set_node_inferred_type, set_node_auto_drops
import types
from types import Type, TypeKind, is_copy_type
import sema
from sema import Sema, make_symbol

extern fn strcmp(s1 as cstr, s2 as cstr) as i32
extern fn printf(format as cstr, ...) as i32
extern fn malloc(size as usize) as ptr


struct OptionLayout:
    public var has_val as u8
    public var val_ptr as ptr[u8]

fn option_has_value(opt as ptr[u8]) as bool:
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).has_val == 1 to u8

fn option_value(opt as ptr[u8]) as ptr[u8]:
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).val_ptr

// ── ObjectState ────────────────────────────────────────────────────────
enum ObjectState:
    Owned
    Moved
    Dropped

// ── VariableInfo ───────────────────────────────────────────────────────
struct VarInfo:
    public var state as ObjectState
    public var var_type as ptr[Type]

// ── BorrowChecker ──────────────────────────────────────────────────────
struct BorrowChecker:
    public var errors as List[String]
    public var current_file as String
    public var symbol_states as Dict[String, VarInfo]
    public var auto_drops as Dict[usize, List[ptr[Symbol]]]
    public var scopes as List[ptr[List[ptr[Symbol]]]]
    public var sema as ptr[Sema]
    public var scope_depth as i32

    public fn init_bc(self as ptr[BorrowChecker]):
        (deref self).errors = List[String]()
        (deref self).current_file = String.make("" to cstr)
        (deref self).symbol_states = Dict[String, VarInfo]()
        (deref self).auto_drops = Dict[usize, List[ptr[Symbol]]]()
        (deref self).scopes = List[ptr[List[ptr[Symbol]]]]()
        (deref self).sema = None to ptr[Sema]
        (deref self).scope_depth = 0 to i32

    public fn report_error(self as ptr[BorrowChecker], msg as String, span as Span):
        extern fn snprintf(str as ptr[u8], size as usize, format as cstr, file as cstr, row as u32, col as u32, err as cstr) as i32
        extern fn memset(s as ptr, c as i32, n as usize) as ptr
        let cap as usize = msg.len + 128 to usize
        let buf as ptr[u8] = malloc(cap) to ptr[u8]
        let dummy_memset as ptr = memset(buf to ptr, 0 to i32, cap to i32)
        let len as i32 = snprintf(buf, cap, "%s:%d:%d: borrow error: %s" to cstr, (deref self).current_file.data to cstr, span.start_row + 1 to u32, span.start_col + 1 to u32, msg.data to cstr)
        (deref self).errors.append(String(data = buf, len = len to usize, capacity = cap))
        let r as i32 = printf("%s\n" to cstr, buf to cstr)

    public fn mark_moved(self as ptr[BorrowChecker], name as String):
        if (deref self).symbol_states.has(name):
            let info as VarInfo = (deref self).symbol_states[name]
            (deref self).symbol_states[name] = VarInfo(state = ObjectState.Moved, var_type = info.var_type)
        else:
            (deref self).symbol_states[name] = VarInfo(state = ObjectState.Moved, var_type = None to ptr[Type])

    public fn mark_dropped(self as ptr[BorrowChecker], name as String):
        if (deref self).symbol_states.has(name):
            let info as VarInfo = (deref self).symbol_states[name]
            (deref self).symbol_states[name] = VarInfo(state = ObjectState.Dropped, var_type = info.var_type)
        else:
            (deref self).symbol_states[name] = VarInfo(state = ObjectState.Dropped, var_type = None to ptr[Type])

    public fn mark_owned(self as ptr[BorrowChecker], name as String, var_type as ptr[Type]):
        (deref self).symbol_states[name] = VarInfo(state = ObjectState.Owned, var_type = var_type)

    public fn push_scope(self as ptr[BorrowChecker]):
        extern fn memset(s as ptr, c as i32, n as usize) as ptr
        let depth as i64 = (deref self).scope_depth to i64
        let scopes_ref as ptr[List[ptr[List[ptr[Symbol]]]]] = ref (deref self).scopes
        let len as i64 = (deref scopes_ref).length()
        if depth >= len:
            let new_list as ptr[List[ptr[Symbol]]] = malloc(24 to usize) to ptr[List[ptr[Symbol]]]
            let dummy_memset as ptr = memset(new_list to ptr, 0 to i32, 24 to usize)
            (deref scopes_ref).append(new_list)
        else:
            let s_ptr as ptr[List[ptr[Symbol]]] = (deref scopes_ref)[depth]
            (deref s_ptr).clear()
        let dummy_sep1 as i32 = 0
        (deref self).scope_depth = (deref self).scope_depth + 1 to i32

    public fn add_symbol_to_current_scope(self as ptr[BorrowChecker], sym as ptr[Symbol]):
        let depth as i64 = (deref self).scope_depth to i64
        if depth > 0 to i64:
            let scopes_ref as ptr[List[ptr[List[ptr[Symbol]]]]] = ref (deref self).scopes
            let s_ptr as ptr[List[ptr[Symbol]]] = (deref scopes_ref)[depth - 1]
            (deref s_ptr).append(sym)

    public fn pop_scope(self as ptr[BorrowChecker], node as ptr[Node]):
        let depth as i64 = (deref self).scope_depth to i64
        if depth <= 0 to i64:
            return
            
        let scopes_ref as ptr[List[ptr[List[ptr[Symbol]]]]] = ref (deref self).scopes
        let current_scope as ptr[List[ptr[Symbol]]] = (deref scopes_ref)[depth - 1]
        let sym_count as i64 = (deref current_scope).length()
        
        let drops as List[ptr[Symbol]] = List[ptr[Symbol]]()
        var i as i64 = 0 to i64
        while i < sym_count:
            let sym as ptr[Symbol] = (deref current_scope)[i]
            let name as String = (deref sym).name
            if (deref self).symbol_states.has(name):
                let info as VarInfo = (deref self).symbol_states[name]
                if info.state == ObjectState.Owned:
                    let t as ptr[Type] = info.var_type
                    if t != None to ptr[Type]:
                        if is_copy_type(t) == False or (deref sym).is_context_manager:
                            drops.append(sym)
                            (deref self).symbol_states[name] = VarInfo(state = ObjectState.Dropped, var_type = t)
            i = i + 1 to i64
            
        if drops.length() > 0 to i64:
            (deref self).auto_drops[node to usize] = drops
            // Also write drop names to the node itself for codegen consumption
            let drop_names as List[String] = List[String]()
            var d_idx as i64 = 0 to i64
            while d_idx < drops.length():
                let drop_sym as ptr[Symbol] = drops[d_idx]
                drop_names.append((deref drop_sym).name)
                d_idx = d_idx + 1 to i64
            set_node_auto_drops(node, drop_names)
            
        let dummy_sep2 as i32 = 0
        (deref self).scope_depth = (deref self).scope_depth - 1 to i32

    // Check identifier for use-after-move, then mark as moved only if it's a move type
    public fn is_local(self as ptr[BorrowChecker], name as String) as bool:
        let scopes_ref as ptr[List[ptr[List[ptr[Symbol]]]]] = ref (deref self).scopes
        let depth as i64 = (deref self).scope_depth to i64
        var s_idx as i64 = depth - 1
        while s_idx >= 0 to i64:
            let scope as ptr[List[ptr[Symbol]]] = (deref scopes_ref)[s_idx]
            let sym_count as i64 = (deref scope).length()
            var i as i64 = 0 to i64
            while i < sym_count:
                let sym as ptr[Symbol] = (deref scope)[i]
                if strcmp((deref sym).name.data to cstr, name.data to cstr) == 0:
                    return True
                i = i + 1 to i64
            s_idx = s_idx - 1 to i64
        return False

    public fn move_identifier(self as ptr[BorrowChecker], node as ptr[Node]):
        if node == None to ptr[Node]:
            return
        if node_kind(node) != NodeType.Identifier: // not Identifier
            return
        let name as String = node_name(node)
        // First check for use-after-move regardless of type
        self.check_identifier_use(node)
        // Only mark as moved if it's a local variable (not a module/global constant)
        if not self.is_local(name):
            return
        // Only mark as moved if it's a move type (not Copy)
        // Look up the type from symbol_states (stored at declaration time)
        if (deref self).symbol_states.has(name):
            let info as VarInfo = (deref self).symbol_states[name]
            var t as ptr[Type] = info.var_type
            if t == None to ptr[Type] and (deref self).sema != None to ptr[Sema]:
                let sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(name)
                if sym != None to ptr[Symbol]:
                    t = ref (deref sym).sym_type
            if t != None to ptr[Type]:
                if is_copy_type(t):
                    return
        self.mark_moved(name)

    public fn check_identifier_use(self as ptr[BorrowChecker], node as ptr[Node]):
        if node == None to ptr[Node]:
            return
        if node_kind(node) != NodeType.Identifier: // not Identifier
            return
        let name as String = node_name(node)
        if (deref self).symbol_states.has(name):
            let info as VarInfo = (deref self).symbol_states[name]
            if info.state == ObjectState.Moved:
                if self.is_local(name):
                    self.report_error(String.make("use of moved variable" to cstr), node_span(node))
            elif info.state == ObjectState.Dropped:
                if self.is_local(name):
                    self.report_error(String.make("use of dropped variable" to cstr), node_span(node))

    public fn walk_ast(self as ptr[BorrowChecker], node as ptr[Node]):
        if node == None to ptr[Node]:
            return
        
        let nt as NodeType = node_kind(node)
        
        if nt == NodeType.Program: // Program
            let decls_raw as List[ptr[Node]] = node_declarations(node)
            let decls as ptr[List[ptr[Node]]] = ref decls_raw
            let count as i64 = (deref decls).length()
            var i as i64 = 0 to i64
            while i < count:
                self.walk_ast((deref decls)[i])
                i = i + 1 to i64
                
        elif nt == NodeType.BlockStmt: // BlockStmt
            self.push_scope()
            let decls_raw as List[ptr[Node]] = node_declarations(node)
            let decls as ptr[List[ptr[Node]]] = ref decls_raw
            let count as i64 = (deref decls).length()
            var i as i64 = 0 to i64
            while i < count:
                self.walk_ast((deref decls)[i])
                i = i + 1 to i64
            self.pop_scope(node)
                
        elif nt == NodeType.FunDecl: // FunDecl
            let sema_ptr as ptr[Sema] = (deref self).sema
            var parent_scope as ptr[Scope] = None to ptr[Scope]
            if sema_ptr != None to ptr[Sema]:
                parent_scope = (deref sema_ptr).current_scope
                if (deref sema_ptr).fn_scopes.has(node to usize):
                    let child_scope as ptr[Scope] = (deref sema_ptr).fn_scopes[node to usize]
                    (deref sema_ptr).current_scope = child_scope
            
            self.push_scope()
            
            // Register parameters in current scope stack
            let params_raw as List[ptr[Node]] = node_params(node)
            let params as ptr[List[ptr[Node]]] = ref params_raw
            let param_count as i64 = (deref params).length()
            var p_idx as i64 = 0 to i64
            while p_idx < param_count:
                let param as ptr[Node] = (deref params)[p_idx]
                let param_name as String = node_name(param)
                var sym as ptr[Symbol] = None to ptr[Symbol]
                if sema_ptr != None to ptr[Sema]:
                    sym = (deref sema_ptr).lookup_symbol(param_name)
                if sym == None to ptr[Symbol]:
                    sym = make_symbol(param_name, SymbolKind.Variable, param)
                self.mark_owned(param_name, (deref sym).resolved_type)
                self.add_symbol_to_current_scope(sym)
                p_idx = p_idx + 1 to i64
                
            self.walk_ast(node_body(node))
            
            self.pop_scope(node)
            if sema_ptr != None to ptr[Sema] and parent_scope != None to ptr[Scope]:
                (deref sema_ptr).current_scope = parent_scope
                
        elif nt == NodeType.VarDecl: // VarDecl
            var var_type as ptr[Type] = node_inferred_type(node)
            // If VarDecl inferred_type is Void, try the init node's type
            if var_type != None to ptr[Type]:
                let k as TypeKind = (deref var_type).kind
                if k == TypeKind.Void:
                    let init_check as ptr[Node] = node_left(node)
                    if init_check != None to ptr[Node]:
                        if node_inferred_type(init_check) != None to ptr[Type]:
                            var_type = node_inferred_type(init_check)
            let name as String = node_name(node)
            self.mark_owned(name, var_type)
            
            let sema_ptr as ptr[Sema] = (deref self).sema
            var sym as ptr[Symbol] = None to ptr[Symbol]
            if sema_ptr != None to ptr[Sema]:
                sym = (deref sema_ptr).lookup_symbol(name)
            if sym == None to ptr[Symbol]:
                sym = make_symbol(name, SymbolKind.Variable, node)
            self.add_symbol_to_current_scope(sym)
                    
            let init as ptr[Node] = node_left(node)
            if init != None to ptr[Node]:
                if node_kind(init) == NodeType.Identifier:
                    self.move_identifier(init)
                else:
                    self.walk_ast(init)
                    
        elif nt == NodeType.CallExpr: // CallExpr
            self.walk_ast(node_left(node))
            let args_raw as List[ptr[Node]] = node_params(node)
            let args as ptr[List[ptr[Node]]] = ref args_raw
            let arg_count as i64 = (deref args).length()
            var a_idx as i64 = 0 to i64
            while a_idx < arg_count:
                let arg as ptr[Node] = (deref args)[a_idx]
                if node_kind(arg) == NodeType.Identifier:
                    self.move_identifier(arg)
                else:
                    self.walk_ast(arg)
                a_idx = a_idx + 1 to i64
                
        elif nt == NodeType.ReturnStmt: // ReturnStmt
            let return_val as ptr[Node] = node_body(node)
            if return_val != None to ptr[Node]:
                if node_kind(return_val) == NodeType.Identifier:
                    self.move_identifier(return_val)
                else:
                    self.walk_ast(return_val)
                    
            // Collect drops from all active scopes on the stack
            let drops as List[ptr[Symbol]] = List[ptr[Symbol]]()
            let scopes_ref as ptr[List[ptr[List[ptr[Symbol]]]]] = ref (deref self).scopes
            var s_idx as i64 = (deref self).scope_depth to i64
            while s_idx > 0 to i64:
                let scope as ptr[List[ptr[Symbol]]] = (deref scopes_ref)[s_idx - 1]
                let sym_count as i64 = (deref scope).length()
                var i as i64 = 0 to i64
                while i < sym_count:
                    let sym as ptr[Symbol] = (deref scope)[i]
                    let name as String = (deref sym).name
                    if (deref self).symbol_states.has(name):
                        let info as VarInfo = (deref self).symbol_states[name]
                        if info.state == ObjectState.Owned:
                            let t as ptr[Type] = info.var_type
                            if t != None to ptr[Type]:
                                if is_copy_type(t) == False or (deref sym).is_context_manager:
                                    var is_returned as bool = False
                                    if return_val != None to ptr[Node]:
                                        if node_kind(return_val) == NodeType.Identifier:
                                            if strcmp(node_name(return_val).data to cstr, name.data to cstr) == 0:
                                                is_returned = True
                                    if not is_returned:
                                        drops.append(sym)
                                        (deref self).symbol_states[name] = VarInfo(state = ObjectState.Dropped, var_type = t)
                    i = i + 1 to i64
                s_idx = s_idx - 1 to i64
                
            if drops.length() > 0 to i64:
                (deref self).auto_drops[node to usize] = drops
                // Also write drop names to the node for codegen
                let drop_names as List[String] = List[String]()
                var d_idx as i64 = 0 to i64
                while d_idx < drops.length():
                    let drop_sym as ptr[Symbol] = drops[d_idx]
                    drop_names.append((deref drop_sym).name)
                    d_idx = d_idx + 1 to i64
                set_node_auto_drops(node, drop_names) // Write drop names to the ReturnStmt node for codegen
                    
        elif nt == NodeType.BinaryExpr: // BinaryExpr
            let op as String = node_op(node)
            let is_assign as bool = strcmp(op.data to cstr, "=" to cstr) == 0 or strcmp(op.data to cstr, "+=" to cstr) == 0 or strcmp(op.data to cstr, "-=" to cstr) == 0 or strcmp(op.data to cstr, "*=" to cstr) == 0 or strcmp(op.data to cstr, "/=" to cstr) == 0
            if is_assign:
                let right as ptr[Node] = node_right(node)
                let left as ptr[Node] = node_left(node)
                if node_kind(right) == NodeType.Identifier:
                    self.move_identifier(right)
                else:
                    self.walk_ast(right)
                if node_kind(left) == NodeType.Identifier:
                    self.mark_owned(node_name(left), node_inferred_type(left))
            else:
                self.walk_ast(node_left(node))
                self.walk_ast(node_right(node))
                
        elif nt == NodeType.WhileStmt: // WhileStmt
            self.walk_ast(node_cond(node))
            self.walk_ast(node_body(node))
            
        elif nt == NodeType.ForStmt: // ForStmt
            let iter_name as String = node_name(node)
            if iter_name.len > 0 to usize:
                self.mark_owned(iter_name, None to ptr[Type])
            self.walk_ast(node_left(node))
            self.walk_ast(node_body(node))
            
        elif nt == NodeType.MemberExpr: // MemberExpr
            self.walk_ast(node_left(node))
            
        elif nt == NodeType.WithStmt: // WithStmt
            let expr as ptr[Node] = node_left(node)
            if expr != None to ptr[Node]:
                self.walk_ast(expr)
                if node_kind(expr) == NodeType.Identifier:
                    self.move_identifier(expr)
            
            let sema_ptr as ptr[Sema] = (deref self).sema
            var parent_scope as ptr[Scope] = None to ptr[Scope]
            if sema_ptr != None to ptr[Sema]:
                parent_scope = (deref sema_ptr).current_scope
                if (deref sema_ptr).fn_scopes.has(node to usize):
                    let child_scope as ptr[Scope] = (deref sema_ptr).fn_scopes[node to usize]
                    (deref sema_ptr).current_scope = child_scope
                    
            self.push_scope()
            
            let name as String = node_name(node)
            if name.len > 0 to usize:
                var var_type as ptr[Type] = None to ptr[Type]
                if expr != None to ptr[Node]:
                    var_type = node_inferred_type(expr)
                self.mark_owned(name, var_type)
                
                if sema_ptr != None to ptr[Sema]:
                    let sym as ptr[Symbol] = (deref sema_ptr).lookup_symbol(name)
                    if sym != None to ptr[Symbol]:
                        self.add_symbol_to_current_scope(sym)
            
            let body as ptr[Node] = node_body(node)
            if body != None to ptr[Node]:
                self.walk_ast(body)
                
            self.pop_scope(node)
            if sema_ptr != None to ptr[Sema] and parent_scope != None to ptr[Scope]:
                (deref sema_ptr).current_scope = parent_scope
            
        elif nt == NodeType.IfStmt: // IfStmt
            self.walk_ast(node_cond(node))
            self.walk_ast(node_then_branch(node))
            let else_opt_raw as Option[ptr[Node]] = node_else_branch(node)
            let else_opt as ptr[u8] = (ref else_opt_raw) to ptr[u8]
            if option_has_value(else_opt):
                let else_node as ptr[Node] = option_value(else_opt) to ptr[Node]
                self.walk_ast(else_node)
        elif nt == NodeType.CastExpr or nt == NodeType.UnaryExpr:
            self.walk_ast(node_left(node))
