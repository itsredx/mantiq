// ── Imports ─────────────────────────────────────────────────────────────
import std.collections
from std.string import String
from std.collections import List, Dict
from std.option import Option, Empty
from std.mem import make
import symbols
from symbols import Node, Symbol, Scope, SymbolKind, Span, NodeType, node_kind, node_name, node_left, node_right, node_body, node_declarations, node_params, node_op, node_cond, node_then_branch, node_else_branch, node_span, node_inferred_type, set_node_inferred_type, set_node_auto_drops, node_file_path
import types
from types import Type, TypeKind, is_copy_type
import sema
from sema import Sema, make_symbol
import error
from error import DiagnosticEngine, Diagnostic

extern fn strcmp(s1 as cstr, s2 as cstr) as i32
extern fn printf(format as cstr, ...) as i32
extern fn malloc(size as usize) as ptr


struct OptionLayout:
    public var has_val as u8
    public var val_ptr as ptr[u8]

fn option_has_value(opt as ptr[u8]) as bool:
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).has_val == 1 to u8

fn option_value(opt as ptr[u8]) as ptr[u8]:
    let lay as ptr[OptionLayout] = opt to ptr[OptionLayout]
    return (deref lay).val_ptr

// ── ObjectState ────────────────────────────────────────────────────────
enum ObjectState:
    Owned
    Moved
    Dropped
    Borrowed

// ── BorrowRecord ───────────────────────────────────────────────────────
struct BorrowRecord:
    public var borrower_name as String
    public var source_name as String
    public var lifetime as String
    public var is_mut as u8
    public var borrow_span as Span
    public var last_use_row as u32
    public var is_active as u8

// ── VariableInfo ───────────────────────────────────────────────────────
struct VarInfo:
    public var state as ObjectState
    public var var_type as ptr[Type]

// ── BorrowChecker ──────────────────────────────────────────────────────
struct BorrowChecker:
    public var errors as List[String]
    public var current_file as String
    public var symbol_states as Dict[String, VarInfo]
    public var auto_drops as Dict[usize, List[ptr[Symbol]]]
    public var scopes as List[ptr[List[ptr[Symbol]]]]
    public var sema as ptr[Sema]
    public var scope_depth as i32
    public var active_borrows as List[BorrowRecord]
    public var var_decl_depth as Dict[String, i32]
    public var var_source_map as Dict[String, String]
    public var var_last_use as Dict[String, u32]
    public var current_row as u32

    public fn init_bc(self as ptr[BorrowChecker]):
        (deref self).errors = List[String]()
        (deref self).current_file = String.make("" to cstr)
        (deref self).symbol_states = Dict[String, VarInfo]()
        (deref self).auto_drops = Dict[usize, List[ptr[Symbol]]]()
        (deref self).scopes = List[ptr[List[ptr[Symbol]]]]()
        (deref self).sema = None to ptr[Sema]
        (deref self).scope_depth = 0 to i32
        (deref self).active_borrows = List[BorrowRecord]()
        (deref self).var_decl_depth = Dict[String, i32]()
        (deref self).var_source_map = Dict[String, String]()
        (deref self).var_last_use = Dict[String, u32]()
        (deref self).current_row = 0 to u32

    public fn report_error(self as ptr[BorrowChecker], msg as String, span as Span):
        self.report_error_with_code("E0401" to cstr, msg, (deref self).current_file, span)

    public fn report_error_with_code(self as ptr[BorrowChecker], code as cstr, msg as String, file_path as String, span as Span) as ptr[Diagnostic]:
        extern fn snprintf(str as ptr[u8], size as usize, format as cstr, ...) as i32
        extern fn memset(s as ptr, c as i32, n as usize) as ptr
        let cap as usize = msg.len + file_path.len + 128 to usize
        let buf as ptr[u8] = malloc(cap) to ptr[u8]
        let dummy_memset as ptr = memset(buf to ptr, 0 to i32, cap to i32)
        let len as i32 = snprintf(buf, cap, "%s:%d:%d: borrow error: %s" to cstr, file_path.data to cstr, span.start_row + 1 to u32, span.start_col + 1 to u32, msg.data to cstr)
        (deref self).errors.append(String(data = buf, len = len to usize, capacity = cap))
        
        if (deref self).sema != None to ptr[Sema]:
            let s_ptr as ptr[Sema] = (deref self).sema
            if (deref s_ptr).engine != None to ptr[DiagnosticEngine]:
                return (deref (deref s_ptr).engine).report_error(code, msg, file_path, span)
        else:
            let r as i32 = printf("%s\n" to cstr, buf to cstr)
        return None to ptr[Diagnostic]

    public fn report_error_node(self as ptr[BorrowChecker], code as cstr, msg as String, node as ptr[Node]) as ptr[Diagnostic]:
        let file_path as String = node_file_path(node, (deref self).current_file)
        return self.report_error_with_code(code, msg, file_path, node_span(node))

    public fn mark_moved(self as ptr[BorrowChecker], name as String):
        if (deref self).symbol_states.has(name):
            let info as VarInfo = (deref self).symbol_states[name]
            (deref self).symbol_states[name] = VarInfo(state = ObjectState.Moved, var_type = info.var_type)
        else:
            (deref self).symbol_states[name] = VarInfo(state = ObjectState.Moved, var_type = None to ptr[Type])

    public fn mark_dropped(self as ptr[BorrowChecker], name as String):
        if (deref self).symbol_states.has(name):
            let info as VarInfo = (deref self).symbol_states[name]
            (deref self).symbol_states[name] = VarInfo(state = ObjectState.Dropped, var_type = info.var_type)
        else:
            (deref self).symbol_states[name] = VarInfo(state = ObjectState.Dropped, var_type = None to ptr[Type])

    public fn mark_owned(self as ptr[BorrowChecker], name as String, var_type as ptr[Type]):
        (deref self).symbol_states[name] = VarInfo(state = ObjectState.Owned, var_type = var_type)

    public fn push_scope(self as ptr[BorrowChecker]):
        extern fn memset(s as ptr, c as i32, n as usize) as ptr
        let depth as i64 = (deref self).scope_depth to i64
        let scopes_ref as ptr[List[ptr[List[ptr[Symbol]]]]] = ref (deref self).scopes
        let len as i64 = (deref scopes_ref).length()
        if depth >= len:
            let new_list as ptr[List[ptr[Symbol]]] = malloc(24 to usize) to ptr[List[ptr[Symbol]]]
            let dummy_memset as ptr = memset(new_list to ptr, 0 to i32, 24 to usize)
            (deref scopes_ref).append(new_list)
        else:
            let s_ptr as ptr[List[ptr[Symbol]]] = (deref scopes_ref)[depth]
            (deref s_ptr).clear()
        let dummy_sep1 as i32 = 0
        (deref self).scope_depth = (deref self).scope_depth + 1 to i32

    public fn add_symbol_to_current_scope(self as ptr[BorrowChecker], sym as ptr[Symbol]):
        let depth as i64 = (deref self).scope_depth to i64
        if depth > 0 to i64:
            let scopes_ref as ptr[List[ptr[List[ptr[Symbol]]]]] = ref (deref self).scopes
            let s_ptr as ptr[List[ptr[Symbol]]] = (deref scopes_ref)[depth - 1]
            (deref s_ptr).append(sym)

    public fn pop_scope(self as ptr[BorrowChecker], node as ptr[Node]):
        let depth as i64 = (deref self).scope_depth to i64
        if depth <= 0 to i64:
            return
            
        let scopes_ref as ptr[List[ptr[List[ptr[Symbol]]]]] = ref (deref self).scopes
        let current_scope as ptr[List[ptr[Symbol]]] = (deref scopes_ref)[depth - 1]
        let sym_count as i64 = (deref current_scope).length()
        
        let drops as List[ptr[Symbol]] = List[ptr[Symbol]]()
        var i as i64 = 0 to i64
        while i < sym_count:
            let sym as ptr[Symbol] = (deref current_scope)[i]
            let name as String = (deref sym).name
            if (deref self).symbol_states.has(name):
                let info as VarInfo = (deref self).symbol_states[name]
                if info.state == ObjectState.Owned:
                    let t as ptr[Type] = info.var_type
                    if t != None to ptr[Type]:
                        if is_copy_type(t) == False or (deref sym).is_context_manager:
                            drops.append(sym)
                            (deref self).symbol_states[name] = VarInfo(state = ObjectState.Dropped, var_type = t)
            i = i + 1 to i64
            
        if drops.length() > 0 to i64:
            (deref self).auto_drops[node to usize] = drops
            // Also write drop names to the node itself for codegen consumption
            let drop_names as List[String] = List[String]()
            var d_idx as i64 = 0 to i64
            while d_idx < drops.length():
                let drop_sym as ptr[Symbol] = drops[d_idx]
                drop_names.append((deref drop_sym).name)
                d_idx = d_idx + 1 to i64
            set_node_auto_drops(node, drop_names)
            
        let dummy_sep2 as i32 = 0
        (deref self).scope_depth = (deref self).scope_depth - 1 to i32

    // Check identifier for use-after-move, then mark as moved only if it's a move type
    public fn is_local(self as ptr[BorrowChecker], name as String) as bool:
        let scopes_ref as ptr[List[ptr[List[ptr[Symbol]]]]] = ref (deref self).scopes
        let depth as i64 = (deref self).scope_depth to i64
        var s_idx as i64 = depth - 1
        while s_idx >= 0 to i64:
            let scope as ptr[List[ptr[Symbol]]] = (deref scopes_ref)[s_idx]
            let sym_count as i64 = (deref scope).length()
            var i as i64 = 0 to i64
            while i < sym_count:
                let sym as ptr[Symbol] = (deref scope)[i]
                if strcmp((deref sym).name.data to cstr, name.data to cstr) == 0:
                    return True
                i = i + 1 to i64
            s_idx = s_idx - 1 to i64
        return False

    public fn scan_last_uses(self as ptr[BorrowChecker], node as ptr[Node]):
        if node == None to ptr[Node]:
            return
        let nt as NodeType = node_kind(node)
        let span_val as Span = node_span(node)
        let row as u32 = span_val.start_row + 1 to u32
        
        if nt == NodeType.Identifier:
            let id_name as String = node_name(node)
            if id_name.len > 0 to usize:
                let lu_ref as ptr[Dict[String, u32]] = ref (deref self).var_last_use
                (deref lu_ref)[id_name] = row
        
        let decls_raw as List[ptr[Node]] = node_declarations(node)
        let decls as ptr[List[ptr[Node]]] = ref decls_raw
        let count as i64 = (deref decls).length()
        var i as i64 = 0 to i64
        while i < count:
            self.scan_last_uses((deref decls)[i])
            i = i + 1 to i64
            
        let params_raw as List[ptr[Node]] = node_params(node)
        let params as ptr[List[ptr[Node]]] = ref params_raw
        let p_count as i64 = (deref params).length()
        var p_i as i64 = 0 to i64
        while p_i < p_count:
            self.scan_last_uses((deref params)[p_i])
            p_i = p_i + 1 to i64
            
        self.scan_last_uses(node_left(node))
        self.scan_last_uses(node_right(node))
        self.scan_last_uses(node_body(node))
        self.scan_last_uses(node_cond(node))
        self.scan_last_uses(node_then_branch(node))
        let else_opt_raw as Option[ptr[Node]] = node_else_branch(node)
        let else_opt as ptr[u8] = (ref else_opt_raw) to ptr[u8]
        if option_has_value(else_opt):
            self.scan_last_uses(option_value(else_opt) to ptr[Node])

    public fn update_borrows_liveness(self as ptr[BorrowChecker], row as u32):
        if row == 0 to u32:
            return
        (deref self).current_row = row
        let ab_ref as ptr[List[BorrowRecord]] = ref (deref self).active_borrows
        let lu_ref as ptr[Dict[String, u32]] = ref (deref self).var_last_use
        let count as i64 = (deref ab_ref).length()
        let updated_list as List[BorrowRecord] = List[BorrowRecord]()
        var idx as i64 = 0 to i64
        while idx < count:
            let b as BorrowRecord = (deref ab_ref)[idx]
            var active as u8 = b.is_active
            if active != 0 to u8:
                var last_use as u32 = b.last_use_row
                if (deref lu_ref).has(b.borrower_name):
                    last_use = (deref lu_ref)[b.borrower_name]
                if row > last_use and last_use > 0 to u32:
                    active = 0 to u8
            let rec as BorrowRecord = BorrowRecord(borrower_name = b.borrower_name, source_name = b.source_name, lifetime = b.lifetime, is_mut = b.is_mut, borrow_span = b.borrow_span, last_use_row = b.last_use_row, is_active = active)
            updated_list.append(rec)
            idx = idx + 1 to i64
        (deref self).active_borrows = updated_list

    public fn check_borrow_creation(self as ptr[BorrowChecker], borrower_name as String, source_name as String, is_mut as u8, span as Span):
        let row as u32 = span.start_row + 1 to u32
        self.update_borrows_liveness(row)
        
        let ab_ref as ptr[List[BorrowRecord]] = ref (deref self).active_borrows
        let lu_ref as ptr[Dict[String, u32]] = ref (deref self).var_last_use
        let sm_ref as ptr[Dict[String, String]] = ref (deref self).var_source_map
        let count as i64 = (deref ab_ref).length()
        var idx as i64 = 0 to i64
        while idx < count:
            let b as BorrowRecord = (deref ab_ref)[idx]
            if b.is_active != 0 to u8 and strcmp(b.source_name.data to cstr, source_name.data to cstr) == 0:
                if is_mut != 0 to u8:
                    if b.is_mut != 0 to u8:
                        let d as ptr[Diagnostic] = self.report_error_with_code("E0405" to cstr, String.make("cannot borrow variable as mutable more than once at a time" to cstr), (deref self).current_file, span)
                        if d != None to ptr[Diagnostic]:
                            d.set_explanation(String.make("Nizam enforces aliasing XOR mutability: only one mutable reference may exist at a time." to cstr))
                    else:
                        let d as ptr[Diagnostic] = self.report_error_with_code("E0405" to cstr, String.make("cannot borrow variable as mutable while borrowed as immutable" to cstr), (deref self).current_file, span)
                        if d != None to ptr[Diagnostic]:
                            d.set_explanation(String.make("A variable cannot be borrowed as mutable while active immutable references exist." to cstr))
                else:
                    if b.is_mut != 0 to u8:
                        let d as ptr[Diagnostic] = self.report_error_with_code("E0406" to cstr, String.make("cannot borrow variable as immutable because it is also borrowed as mutable" to cstr), (deref self).current_file, span)
                        if d != None to ptr[Diagnostic]:
                            d.set_explanation(String.make("A variable cannot be borrowed as immutable while an active mutable reference exists." to cstr))
            idx = idx + 1 to i64
            
        var last_use as u32 = row
        if (deref lu_ref).has(borrower_name):
            last_use = (deref lu_ref)[borrower_name]
            
        let new_rec as BorrowRecord = BorrowRecord(borrower_name = borrower_name, source_name = source_name, lifetime = String.make("" to cstr), is_mut = is_mut, borrow_span = span, last_use_row = last_use, is_active = 1 to u8)
        (deref ab_ref).append(new_rec)
        (deref sm_ref)[borrower_name] = source_name

    public fn check_mutation_target(self as ptr[BorrowChecker], left as ptr[Node]):
        if left == None to ptr[Node]:
            return
        if node_kind(left) != NodeType.Identifier:
            return
        let name as String = node_name(left)
        let row as u32 = node_span(left).start_row + 1 to u32
        self.update_borrows_liveness(row)
        
        let ab_ref as ptr[List[BorrowRecord]] = ref (deref self).active_borrows
        let count as i64 = (deref ab_ref).length()
        var idx as i64 = 0 to i64
        while idx < count:
            let b as BorrowRecord = (deref ab_ref)[idx]
            if b.is_active != 0 to u8 and strcmp(b.source_name.data to cstr, name.data to cstr) == 0:
                if b.is_mut == 0 to u8:
                    let d as ptr[Diagnostic] = self.report_error_node("E0404" to cstr, String.make("cannot assign to variable while borrowed as immutable" to cstr), left)
                    if d != None to ptr[Diagnostic]:
                        d.set_explanation(String.make("Cannot mutate a variable while shared references to it exist under Non-Lexical Lifetimes." to cstr))
            idx = idx + 1 to i64

    public fn check_return_reference(self as ptr[BorrowChecker], return_val as ptr[Node], ret_node as ptr[Node]):
        if return_val == None to ptr[Node]:
            return
        let nt as NodeType = node_kind(return_val)
        let dd_ref as ptr[Dict[String, i32]] = ref (deref self).var_decl_depth
        let sm_ref as ptr[Dict[String, String]] = ref (deref self).var_source_map
        if nt == NodeType.UnaryExpr:
            let op as String = node_op(return_val)
            if op.data != None to ptr[u8] and (strcmp(op.data to cstr, "ref" to cstr) == 0 or strcmp(op.data to cstr, "ref mut" to cstr) == 0):
                let inner as ptr[Node] = node_left(return_val)
                if inner != None to ptr[Node] and node_kind(inner) == NodeType.Identifier:
                    let src as String = node_name(inner)
                    if (deref dd_ref).has(src):
                        if (deref dd_ref)[src] > 1 to i32:
                            let d as ptr[Diagnostic] = self.report_error_node("E0407" to cstr, String.make("cannot return reference to local stack variable (dangling reference)" to cstr), ret_node)
                            if d != None to ptr[Diagnostic]:
                                d.set_explanation(String.make("Local variables allocated on the function stack are deallocated upon return. References to them cannot outlive the function." to cstr))
        elif nt == NodeType.Identifier:
            let r_name as String = node_name(return_val)
            if (deref sm_ref).has(r_name):
                let src as String = (deref sm_ref)[r_name]
                if (deref dd_ref).has(src):
                    if (deref dd_ref)[src] > 1 to i32:
                        let d as ptr[Diagnostic] = self.report_error_node("E0407" to cstr, String.make("cannot return reference borrowing from local stack variable (dangling reference)" to cstr), ret_node)
                        if d != None to ptr[Diagnostic]:
                            d.set_explanation(String.make("References borrowing from local stack variables cannot outlive the enclosing function scope." to cstr))

    public fn move_identifier(self as ptr[BorrowChecker], node as ptr[Node]):
        if node == None to ptr[Node]:
            return
        if node_kind(node) != NodeType.Identifier: // not Identifier
            return
        let name as String = node_name(node)
        let row as u32 = node_span(node).start_row + 1 to u32
        self.update_borrows_liveness(row)
        
        // Check if variable is currently borrowed by an active reference
        let ab_ref as ptr[List[BorrowRecord]] = ref (deref self).active_borrows
        let count as i64 = (deref ab_ref).length()
        var idx as i64 = 0 to i64
        while idx < count:
            let b as BorrowRecord = (deref ab_ref)[idx]
            if b.is_active != 0 to u8 and strcmp(b.source_name.data to cstr, name.data to cstr) == 0:
                let d as ptr[Diagnostic] = self.report_error_node("E0403" to cstr, String.make("cannot move variable while borrowed" to cstr), node)
                if d != None to ptr[Diagnostic]:
                    d.set_explanation(String.make("Values cannot be moved or transferred while references to them are still active." to cstr))
                    d.add_help(String.make("Wait until the reference's non-lexical lifetime has ended before moving." to cstr))
            idx = idx + 1 to i64

        // First check for use-after-move regardless of type
        self.check_identifier_use(node)
        // Only mark as moved if it's a local variable (not a module/global constant)
        if not self.is_local(name):
            return
        // Only mark as moved if it's a move type (not Copy)
        // Look up the type from symbol_states (stored at declaration time)
        let ss_ref as ptr[Dict[String, VarInfo]] = ref (deref self).symbol_states
        if (deref ss_ref).has(name):
            let info as VarInfo = (deref ss_ref)[name]
            if info.state == ObjectState.Borrowed:
                return
            var t as ptr[Type] = info.var_type
            if t == None to ptr[Type] and (deref self).sema != None to ptr[Sema]:
                let sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(name)
                if sym != None to ptr[Symbol]:
                    t = (deref sym).resolved_type
            if t != None to ptr[Type]:
                if is_copy_type(t):
                    return
        else:
            if (deref self).sema != None to ptr[Sema]:
                let sym as ptr[Symbol] = (deref (deref self).sema).lookup_symbol(name)
                if sym != None to ptr[Symbol]:
                    let t as ptr[Type] = (deref sym).resolved_type
                    if t != None to ptr[Type]:
                        if is_copy_type(t):
                            return
        self.mark_moved(name)

    public fn check_identifier_use(self as ptr[BorrowChecker], node as ptr[Node]):
        if node == None to ptr[Node]:
            return
        if node_kind(node) != NodeType.Identifier: // not Identifier
            return
        let name as String = node_name(node)
        let ss_ref as ptr[Dict[String, VarInfo]] = ref (deref self).symbol_states
        if (deref ss_ref).has(name):
            let info as VarInfo = (deref ss_ref)[name]
            if info.state == ObjectState.Moved:
                if self.is_local(name):
                    let d as ptr[Diagnostic] = self.report_error_node("E0401" to cstr, String.make("use of moved variable" to cstr), node)
                    if d != None to ptr[Diagnostic]:
                        d.set_explanation(String.make("Nizam uses affine move semantics. Values that do not implement Copy are moved upon assignment or passing to a function." to cstr))
                        d.add_help(String.make("Consider cloning the variable before moving, or borrowing via a reference." to cstr))
            elif info.state == ObjectState.Dropped:
                if self.is_local(name):
                    let d as ptr[Diagnostic] = self.report_error_node("E0402" to cstr, String.make("use of dropped variable" to cstr), node)
                    if d != None to ptr[Diagnostic]:
                        d.set_explanation(String.make("The variable was explicitly dropped and cannot be referenced or accessed afterward." to cstr))
                        d.add_help(String.make("Remove the earlier `drop(...)` call or re-initialize the variable." to cstr))

    public fn walk_ast(self as ptr[BorrowChecker], node as ptr[Node]):
        if node == None to ptr[Node]:
            return
        
        let nt as NodeType = node_kind(node)
        let row as u32 = node_span(node).start_row + 1 to u32
        if row > 0 to u32:
            self.update_borrows_liveness(row)
        
        if nt == NodeType.Program: // Program
            self.scan_last_uses(node)
            let decls_raw as List[ptr[Node]] = node_declarations(node)
            let decls as ptr[List[ptr[Node]]] = ref decls_raw
            let count as i64 = (deref decls).length()
            var i as i64 = 0 to i64
            while i < count:
                let decl as ptr[Node] = (deref decls)[i]
                self.walk_ast(decl)
                i = i + 1 to i64
                
        elif nt == NodeType.BlockStmt: // BlockStmt
            self.push_scope()
            let decls_raw as List[ptr[Node]] = node_declarations(node)
            let decls as ptr[List[ptr[Node]]] = ref decls_raw
            let count as i64 = (deref decls).length()
            var i as i64 = 0 to i64
            while i < count:
                self.walk_ast((deref decls)[i])
                i = i + 1 to i64
            self.pop_scope(node)

        elif nt == NodeType.ParamBlockStmt: // ParamBlockStmt
            let lu_ref as ptr[Dict[String, u32]] = ref (deref self).var_last_use
            if (deref lu_ref).length() == 0 to i64:
                self.scan_last_uses(node)
            let sema_ptr as ptr[Sema] = (deref self).sema
            var parent_scope as ptr[Scope] = None to ptr[Scope]
            if sema_ptr != None to ptr[Sema]:
                parent_scope = (deref sema_ptr).current_scope
                if (deref sema_ptr).fn_scopes.has(node to usize):
                    let child_scope as ptr[Scope] = (deref sema_ptr).fn_scopes[node to usize]
                    (deref sema_ptr).current_scope = child_scope

            self.push_scope()

            let params_raw as List[ptr[Node]] = node_params(node)
            let params as ptr[List[ptr[Node]]] = ref params_raw
            let param_count as i64 = (deref params).length()
            let ss_ref as ptr[Dict[String, VarInfo]] = ref (deref self).symbol_states
            let dd_ref as ptr[Dict[String, i32]] = ref (deref self).var_decl_depth
            var p_idx as i64 = 0 to i64
            while p_idx < param_count:
                let param as ptr[Node] = (deref params)[p_idx]
                let param_name as String = String.make(node_name(param).data to cstr)
                var p_type as ptr[Type] = node_inferred_type(param)
                var sym as ptr[Symbol] = None to ptr[Symbol]
                if sema_ptr != None to ptr[Sema]:
                    sym = (deref sema_ptr).lookup_symbol(param_name)
                    if p_type == None to ptr[Type] and sym != None to ptr[Symbol]:
                        p_type = (deref sym).resolved_type
                if sym == None to ptr[Symbol]:
                    sym = make_symbol(param_name, SymbolKind.Variable, param)
                    (deref sym).resolved_type = p_type
                (deref ss_ref)[param_name] = VarInfo(state = ObjectState.Borrowed, var_type = p_type)
                (deref dd_ref)[param_name] = (deref self).scope_depth
                self.add_symbol_to_current_scope(sym)
                p_idx = p_idx + 1 to i64

            self.walk_ast(node_body(node))

            self.pop_scope(node)
            if sema_ptr != None to ptr[Sema] and parent_scope != None to ptr[Scope]:
                (deref sema_ptr).current_scope = parent_scope
                
        elif nt == NodeType.FunDecl: // FunDecl
            let lu_ref as ptr[Dict[String, u32]] = ref (deref self).var_last_use
            if (deref lu_ref).length() == 0 to i64:
                self.scan_last_uses(node)
            let sema_ptr as ptr[Sema] = (deref self).sema
            var parent_scope as ptr[Scope] = None to ptr[Scope]
            if sema_ptr != None to ptr[Sema]:
                parent_scope = (deref sema_ptr).current_scope
                if (deref sema_ptr).fn_scopes.has(node to usize):
                    let child_scope as ptr[Scope] = (deref sema_ptr).fn_scopes[node to usize]
                    (deref sema_ptr).current_scope = child_scope
            
            self.push_scope()
            
            let params_raw as List[ptr[Node]] = node_params(node)
            let params as ptr[List[ptr[Node]]] = ref params_raw
            let param_count as i64 = (deref params).length()
            let ss_ref as ptr[Dict[String, VarInfo]] = ref (deref self).symbol_states
            let dd_ref as ptr[Dict[String, i32]] = ref (deref self).var_decl_depth
            var p_idx as i64 = 0 to i64
            while p_idx < param_count:
                let param as ptr[Node] = (deref params)[p_idx]
                let param_name as String = node_name(param)
                var p_type as ptr[Type] = node_inferred_type(param)
                var sym as ptr[Symbol] = None to ptr[Symbol]
                if sema_ptr != None to ptr[Sema]:
                    sym = (deref sema_ptr).lookup_symbol(param_name)
                    if p_type == None to ptr[Type] and sym != None to ptr[Symbol]:
                        p_type = (deref sym).resolved_type
                if sym == None to ptr[Symbol]:
                    sym = make_symbol(param_name, SymbolKind.Variable, param)
                    (deref sym).resolved_type = p_type
                (deref ss_ref)[param_name] = VarInfo(state = ObjectState.Borrowed, var_type = p_type)
                (deref dd_ref)[param_name] = (deref self).scope_depth
                self.add_symbol_to_current_scope(sym)
                p_idx = p_idx + 1 to i64
                
            self.walk_ast(node_body(node))
            
            self.pop_scope(node)
            if sema_ptr != None to ptr[Sema] and parent_scope != None to ptr[Scope]:
                (deref sema_ptr).current_scope = parent_scope
                
        elif nt == NodeType.VarDecl: // VarDecl
            let name as String = node_name(node)
            let dd_ref as ptr[Dict[String, i32]] = ref (deref self).var_decl_depth
            (deref dd_ref)[name] = (deref self).scope_depth
            
            var var_type as ptr[Type] = node_inferred_type(node)
            // If VarDecl inferred_type is Void, try the init node's type
            if var_type != None to ptr[Type]:
                let k as TypeKind = (deref var_type).kind
                if k == TypeKind.Void:
                    let init_check as ptr[Node] = node_left(node)
                    if init_check != None to ptr[Node]:
                        if node_inferred_type(init_check) != None to ptr[Type]:
                            var_type = node_inferred_type(init_check)
            self.mark_owned(name, var_type)
            
            let sema_ptr as ptr[Sema] = (deref self).sema
            var sym as ptr[Symbol] = None to ptr[Symbol]
            if sema_ptr != None to ptr[Sema]:
                sym = (deref sema_ptr).lookup_symbol(name)
            if sym == None to ptr[Symbol]:
                sym = make_symbol(name, SymbolKind.Variable, node)
            self.add_symbol_to_current_scope(sym)
                    
            let init as ptr[Node] = node_left(node)
            if init != None to ptr[Node]:
                if node_kind(init) == NodeType.UnaryExpr:
                    let uop as String = node_op(init)
                    if uop.data != None to ptr[u8] and (strcmp(uop.data to cstr, "ref" to cstr) == 0 or strcmp(uop.data to cstr, "ref mut" to cstr) == 0):
                        let is_mut as u8 = if strcmp(uop.data to cstr, "ref mut" to cstr) == 0: 1 to u8 else: 0 to u8
                        let ref_target as ptr[Node] = node_left(init)
                        if ref_target != None to ptr[Node] and node_kind(ref_target) == NodeType.Identifier:
                            let target_name as String = node_name(ref_target)
                            self.check_borrow_creation(name, target_name, is_mut, node_span(node))
                elif node_kind(init) == NodeType.Identifier:
                    self.move_identifier(init)
                else:
                    self.walk_ast(init)
                    
        elif nt == NodeType.CallExpr: // CallExpr
            let callee as ptr[Node] = node_left(node)
            self.walk_ast(callee)
            if callee != None to ptr[Node] and node_kind(callee) == NodeType.Identifier:
                let cname as String = node_name(callee)
                if strcmp(cname.data to cstr, "drop" to cstr) == 0:
                    let args_raw as List[ptr[Node]] = node_params(node)
                    let args as ptr[List[ptr[Node]]] = ref args_raw
                    if (deref args).length() > 0 to i64:
                        let d_arg as ptr[Node] = (deref args)[0]
                        if node_kind(d_arg) == NodeType.Identifier:
                            let d_name as String = node_name(d_arg)
                            self.update_borrows_liveness(node_span(node).start_row + 1 to u32)
                            let count as i64 = (deref self).active_borrows.length()
                            var idx as i64 = 0 to i64
                            while idx < count:
                                let b as BorrowRecord = (deref self).active_borrows[idx]
                                if b.is_active != 0 to u8 and strcmp(b.source_name.data to cstr, d_name.data to cstr) == 0:
                                    let d as ptr[Diagnostic] = self.report_error_node("E0408" to cstr, String.make("cannot drop variable while borrowed" to cstr), node)
                                    if d != None to ptr[Diagnostic]:
                                        d.set_explanation(String.make("Cannot explicitly drop a variable while active references borrow from it." to cstr))
                                idx = idx + 1 to i64
            let args_raw as List[ptr[Node]] = node_params(node)
            let args as ptr[List[ptr[Node]]] = ref args_raw
            let arg_count as i64 = (deref args).length()
            var a_idx as i64 = 0 to i64
            while a_idx < arg_count:
                let arg as ptr[Node] = (deref args)[a_idx]
                if node_kind(arg) == NodeType.Identifier:
                    self.check_identifier_use(arg)
                elif node_kind(arg) == NodeType.UnaryExpr:
                    let uop as String = node_op(arg)
                    if uop.data != None to ptr[u8] and (strcmp(uop.data to cstr, "ref" to cstr) == 0 or strcmp(uop.data to cstr, "ref mut" to cstr) == 0):
                        let ref_target as ptr[Node] = node_left(arg)
                        if ref_target != None to ptr[Node]:
                            if node_kind(ref_target) == NodeType.Identifier:
                                self.check_identifier_use(ref_target)
                            else:
                                self.walk_ast(ref_target)
                    else:
                        self.walk_ast(arg)
                else:
                    self.walk_ast(arg)
                a_idx = a_idx + 1 to i64
                
        elif nt == NodeType.ReturnStmt: // ReturnStmt
            let return_val as ptr[Node] = node_left(node)
            if return_val != None to ptr[Node]:
                self.check_return_reference(return_val, node)
                if node_kind(return_val) == NodeType.Identifier:
                    self.move_identifier(return_val)
                else:
                    self.walk_ast(return_val)
                    
            // Collect drops from all active scopes on the stack
            let drops as List[ptr[Symbol]] = List[ptr[Symbol]]()
            let scopes_ref as ptr[List[ptr[List[ptr[Symbol]]]]] = ref (deref self).scopes
            var s_idx as i64 = (deref self).scope_depth to i64
            while s_idx > 0 to i64:
                let scope as ptr[List[ptr[Symbol]]] = (deref scopes_ref)[s_idx - 1]
                let sym_count as i64 = (deref scope).length()
                var i as i64 = 0 to i64
                while i < sym_count:
                    let sym as ptr[Symbol] = (deref scope)[i]
                    let name as String = (deref sym).name
                    if (deref self).symbol_states.has(name):
                        let info as VarInfo = (deref self).symbol_states[name]
                        if info.state == ObjectState.Owned:
                            let t as ptr[Type] = info.var_type
                            if t != None to ptr[Type]:
                                if is_copy_type(t) == False or (deref sym).is_context_manager:
                                    var is_returned as bool = False
                                    if return_val != None to ptr[Node]:
                                        if node_kind(return_val) == NodeType.Identifier:
                                            if strcmp(node_name(return_val).data to cstr, name.data to cstr) == 0:
                                                is_returned = True
                                    if not is_returned:
                                        drops.append(sym)
                    i = i + 1 to i64
                s_idx = s_idx - 1 to i64
                
            if drops.length() > 0 to i64:
                (deref self).auto_drops[node to usize] = drops
                // Also write drop names to the node for codegen
                let drop_names as List[String] = List[String]()
                var d_idx as i64 = 0 to i64
                while d_idx < drops.length():
                    let drop_sym as ptr[Symbol] = drops[d_idx]
                    drop_names.append((deref drop_sym).name)
                    d_idx = d_idx + 1 to i64
                set_node_auto_drops(node, drop_names) // Write drop names to the ReturnStmt node for codegen
                    
        elif nt == NodeType.BinaryExpr: // BinaryExpr
            let op as String = node_op(node)
            let is_assign as bool = strcmp(op.data to cstr, "=" to cstr) == 0 or strcmp(op.data to cstr, "+=" to cstr) == 0 or strcmp(op.data to cstr, "-=" to cstr) == 0 or strcmp(op.data to cstr, "*=" to cstr) == 0 or strcmp(op.data to cstr, "/=" to cstr) == 0
            if is_assign:
                let right as ptr[Node] = node_right(node)
                let left as ptr[Node] = node_left(node)
                if right != None to ptr[Node] and node_kind(right) == NodeType.UnaryExpr:
                    let uop as String = node_op(right)
                    if uop.data != None to ptr[u8] and (strcmp(uop.data to cstr, "ref" to cstr) == 0 or strcmp(uop.data to cstr, "ref mut" to cstr) == 0):
                        let is_mut as u8 = if strcmp(uop.data to cstr, "ref mut" to cstr) == 0: 1 to u8 else: 0 to u8
                        let ref_target as ptr[Node] = node_left(right)
                        if ref_target != None to ptr[Node] and node_kind(ref_target) == NodeType.Identifier:
                            let target_name as String = node_name(ref_target)
                            if left != None to ptr[Node] and node_kind(left) == NodeType.Identifier:
                                self.check_borrow_creation(node_name(left), target_name, is_mut, node_span(node))
                elif right != None to ptr[Node] and node_kind(right) == NodeType.Identifier:
                    self.move_identifier(right)
                else:
                    self.walk_ast(right)
                if left != None to ptr[Node] and node_kind(left) == NodeType.Identifier:
                    self.check_mutation_target(left)
                    self.mark_owned(node_name(left), node_inferred_type(left))
            else:
                self.walk_ast(node_left(node))
                self.walk_ast(node_right(node))
                
        elif nt == NodeType.WhileStmt: // WhileStmt
            self.walk_ast(node_cond(node))
            self.walk_ast(node_body(node))
            
        elif nt == NodeType.ForStmt: // ForStmt
            let iter_name as String = node_name(node)
            if iter_name.len > 0 to usize:
                self.mark_owned(iter_name, None to ptr[Type])
            self.walk_ast(node_left(node))
            self.walk_ast(node_body(node))
            
        elif nt == NodeType.MemberExpr: // MemberExpr
            self.walk_ast(node_left(node))
            
        elif nt == NodeType.WithStmt: // WithStmt
            let expr as ptr[Node] = node_left(node)
            if expr != None to ptr[Node]:
                self.walk_ast(expr)
                if node_kind(expr) == NodeType.Identifier:
                    self.move_identifier(expr)
            
            let sema_ptr as ptr[Sema] = (deref self).sema
            var parent_scope as ptr[Scope] = None to ptr[Scope]
            if sema_ptr != None to ptr[Sema]:
                parent_scope = (deref sema_ptr).current_scope
                if (deref sema_ptr).fn_scopes.has(node to usize):
                    let child_scope as ptr[Scope] = (deref sema_ptr).fn_scopes[node to usize]
                    (deref sema_ptr).current_scope = child_scope
                    
            self.push_scope()
            
            let name as String = node_name(node)
            if name.len > 0 to usize:
                var var_type as ptr[Type] = None to ptr[Type]
                if expr != None to ptr[Node]:
                    var_type = node_inferred_type(expr)
                self.mark_owned(name, var_type)
                
                if sema_ptr != None to ptr[Sema]:
                    let sym as ptr[Symbol] = (deref sema_ptr).lookup_symbol(name)
                    if sym != None to ptr[Symbol]:
                        self.add_symbol_to_current_scope(sym)
            
            let body as ptr[Node] = node_body(node)
            if body != None to ptr[Node]:
                self.walk_ast(body)
                
            self.pop_scope(node)
            if sema_ptr != None to ptr[Sema] and parent_scope != None to ptr[Scope]:
                (deref sema_ptr).current_scope = parent_scope
            
        elif nt == NodeType.IfStmt: // IfStmt
            self.walk_ast(node_cond(node))
            self.walk_ast(node_then_branch(node))
            let else_opt_raw as Option[ptr[Node]] = node_else_branch(node)
            let else_opt as ptr[u8] = (ref else_opt_raw) to ptr[u8]
            if option_has_value(else_opt):
                let else_node as ptr[Node] = option_value(else_opt) to ptr[Node]
                self.walk_ast(else_node)
        elif nt == NodeType.CastExpr:
            self.walk_ast(node_left(node))
        elif nt == NodeType.UnaryExpr:
            let uop as String = node_op(node)
            if uop.data != None to ptr[u8] and (strcmp(uop.data to cstr, "ref" to cstr) == 0 or strcmp(uop.data to cstr, "ref mut" to cstr) == 0):
                let inner as ptr[Node] = node_left(node)
                if inner != None to ptr[Node]:
                    if node_kind(inner) == NodeType.Identifier:
                        self.check_identifier_use(inner)
                    else:
                        self.walk_ast(inner)
            else:
                self.walk_ast(node_left(node))
