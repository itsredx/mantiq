                else:
                    _sp = sprintf(cmd_buf, "zig cc %s \"%s\" -L\"%s\" -ltree-sitter-mantiq \"%s/tree_sitter_helper.c\" \"%s/runtime.c\" -Wl,-rpath,\"%s\" -o \"%s\" -lm%s 2>&1 || gcc %s \"%s\" -L\"%s\" -ltree-sitter-mantiq \"%s/tree_sitter_helper.c\" \"%s/runtime.c\" -Wl,-rpath,\"%s\" -o \"%s\" -lm%s 2>&1 || clang %s \"%s\" -L\"%s\" -ltree-sitter-mantiq \"%s/tree_sitter_helper.c\" \"%s/runtime.c\" -Wl,-rpath,\"%s\" -o \"%s\" -lm%s 2>&1" to cstr, opt_flag, ll_path, lib_dir, lib_dir, lib_dir, lib_dir, out_file, extra_flags_c, opt_flag, ll_path, lib_dir, lib_dir, lib_dir, lib_dir, out_file, extra_flags_c, opt_flag, ll_path, lib_dir, lib_dir, lib_dir, lib_dir, out_file, extra_flags_c)
        res = -1
        if not target.is_wasm() and not target.is_python_ext():
            let d_argv as ptr[cstr] = malloc(128 to usize * 8 to usize) to ptr[cstr]
            var di as usize = 0 to usize
            d_argv[di] = "zig" to cstr
            di = di + 1 to usize
            d_argv[di] = "cc" to cstr
            di = di + 1 to usize
            if is_debug:
                d_argv[di] = "-O0" to cstr
                di = di + 1 to usize
                d_argv[di] = "-g" to cstr
                di = di + 1 to usize
            else:
                d_argv[di] = "-O2" to cstr
                di = di + 1 to usize
                d_argv[di] = "-fno-strict-aliasing" to cstr
                di = di + 1 to usize
            d_argv[di] = ll_path
            di = di + 1 to usize
            var l_str as String = String.make("" to cstr)
            if lib_dir != None to cstr:
                let l_sb as StringBuilder = StringBuilder.make()
                l_sb.append("-L" to cstr)
                l_sb.append(lib_dir)
                l_str = l_sb.to_string()
                d_argv[di] = l_str.data to cstr
                di = di + 1 to usize
            else:
                d_argv[di] = "-L." to cstr
                di = di + 1 to usize
            d_argv[di] = "-ltree-sitter-mantiq" to cstr
            di = di + 1 to usize
            var ts_str as String = String.make("" to cstr)
            var rt_str as String = String.make("" to cstr)
            var rp_str as String = String.make("" to cstr)
            if lib_dir != None to cstr:
                if has_rt_obj:
                    let ts_sb as StringBuilder = StringBuilder.make()
                    ts_sb.append(lib_dir)
                    ts_sb.append("/tree_sitter_helper.o" to cstr)
                    ts_str = ts_sb.to_string()
                    d_argv[di] = ts_str.data to cstr
                    di = di + 1 to usize
                    let rt_sb as StringBuilder = StringBuilder.make()
                    rt_sb.append(lib_dir)
                    rt_sb.append("/runtime.o" to cstr)
                    rt_str = rt_sb.to_string()
                    d_argv[di] = rt_str.data to cstr
                    di = di + 1 to usize
                else:
                    let ts_sb as StringBuilder = StringBuilder.make()
                    ts_sb.append(lib_dir)
                    ts_sb.append("/tree_sitter_helper.c" to cstr)
                    ts_str = ts_sb.to_string()
                    d_argv[di] = ts_str.data to cstr
                    di = di + 1 to usize
                    let rt_sb as StringBuilder = StringBuilder.make()
                    rt_sb.append(lib_dir)
                    rt_sb.append("/runtime.c" to cstr)
                    rt_str = rt_sb.to_string()
                    d_argv[di] = rt_str.data to cstr
                    di = di + 1 to usize
                let rp_sb as StringBuilder = StringBuilder.make()
                rp_sb.append("-Wl,-rpath," to cstr)
                rp_sb.append(lib_dir)
                rp_str = rp_sb.to_string()
                d_argv[di] = rp_str.data to cstr
                di = di + 1 to usize
            else:
                if access("tree_sitter_helper.o" to cstr, 0 to i32) == 0 to i32 and access("runtime.o" to cstr, 0 to i32) == 0 to i32:
                    d_argv[di] = "tree_sitter_helper.o" to cstr
                    di = di + 1 to usize
                    d_argv[di] = "runtime.o" to cstr
                    di = di + 1 to usize
                elif access("stage3/tree_sitter_helper.o" to cstr, 0 to i32) == 0 to i32 and access("stage3/runtime.o" to cstr, 0 to i32) == 0 to i32:
                    d_argv[di] = "stage3/tree_sitter_helper.o" to cstr
                    di = di + 1 to usize
                    d_argv[di] = "stage3/runtime.o" to cstr
                    di = di + 1 to usize
                else:
                    d_argv[di] = "tree_sitter_helper.c" to cstr
                    di = di + 1 to usize
                    d_argv[di] = "../mantiqz/mantiq-compiler/src/runtime.c" to cstr
                    di = di + 1 to usize
                d_argv[di] = "-Wl,-rpath,'$ORIGIN'" to cstr
                di = di + 1 to usize
            d_argv[di] = "-o" to cstr
            di = di + 1 to usize
            d_argv[di] = out_file
            di = di + 1 to usize
            d_argv[di] = "-lm" to cstr
            di = di + 1 to usize
            var lti2 as i64 = 0 to i64
            while lti2 < lt_count:
                let lt_name2 as String = (deref sema).link_targets[lti2]
                if strcmp(lt_name2.data to cstr, "m" to cstr) != 0:
                    let l_sb2 as StringBuilder = StringBuilder.make()
                    l_sb2.append("-l" to cstr)
                    l_sb2.append(lt_name2.data to cstr)
                    let l_str2 as String = l_sb2.to_string()
                    d_argv[di] = l_str2.data to cstr
                    di = di + 1 to usize
                lti2 = lti2 + 1 to i64
            if (deref cg).has_python_embed and not has_py_flag:
                d_argv[di] = "-lpython3.12" to cstr
                di = di + 1 to usize
                d_argv[di] = "-ldl" to cstr
                di = di + 1 to usize
            d_argv[di] = None to cstr
            res = mantiq_run_command_direct(d_argv)
            if res != 0:
                // Fallback: Try gcc directly
                var si as usize = 1 to usize
                while si < di:
                    d_argv[si] = d_argv[si + 1 to usize]
                    si = si + 1 to usize
                d_argv[0] = "gcc" to cstr
                d_argv[di - 1 to usize] = None to cstr
                res = mantiq_run_command_direct(d_argv)
                if res != 0:
                    // Fallback: Try clang directly
                    d_argv[0] = "clang" to cstr
                    res = mantiq_run_command_direct(d_argv)
            free(d_argv to ptr)
        if res != 0:
            res = system(cmd_buf to cstr)
        free(cmd_buf to ptr)
        perf_end(perf, "link", t6)

    if res == 0 and use_cache:
        if not link_cache_hit:
            let _cb_ok as i32 = mantiq_copy_file(out_file, cached_bin_path.data to cstr)
        let dep_sb as StringBuilder = StringBuilder.make()
        dep_sb.append(bin_name.data to cstr)
        dep_sb.append("\n" to cstr)
        let cur_root_sha as String = get_file_sha256(path_cstr)
        dep_sb.append(cur_root_sha.data to cstr)
        dep_sb.append("\n" to cstr)
        dep_sb.append(flags_sig.data to cstr)
        dep_sb.append("\n" to cstr)
        let dep_count as i64 = (deref sema).loaded_module_paths.length()
        let count_buf as ptr[u8] = malloc(32 to usize) to ptr[u8]
        let _cb as i32 = sprintf(count_buf, "%ld\n" to cstr, dep_count)
        dep_sb.append(count_buf to cstr)
        free(count_buf to ptr)
        var mpi as i64 = 0 to i64
        while mpi < dep_count:
            let mp as String = (deref sema).loaded_module_paths[mpi]
            let mp_sha as String = get_file_sha256(mp.data to cstr)
            dep_sb.append(mp.data to cstr)
            dep_sb.append("\n" to cstr)
            dep_sb.append(mp_sha.data to cstr)
            dep_sb.append("\n" to cstr)
            mpi = mpi + 1 to i64
        let dep_content as String = dep_sb.to_string()
        dep_sb.deinit()
        let f_dep as ptr = fopen(dep_file_path.data to cstr, "wb" to cstr)
        if f_dep != None to ptr:
            let _w_dep as usize = fwrite(dep_content.data to ptr, 1 to usize, dep_content.len, f_dep)
            fclose(f_dep)

    if target.is_python_ext() and res == 0:
        // ── Phase 7.5: Generate and write PEP 484 type stub (.pyi) ──
        let pyi_content as String = (deref cg).generate_pyi_stub()
        let pyi_buf as ptr[u8] = malloc(2048 to usize) to ptr[u8]
        let out_len as usize = strlen(out_file)
        var base_len as usize = out_len
        if out_len > 8 to usize and strcmp(((out_file to usize) + (out_len - 8 to usize)) to cstr, ".abi3.so" to cstr) == 0:
            base_len = out_len - 8 to usize
        elif out_len > 3 to usize and strcmp(((out_file to usize) + (out_len - 3 to usize)) to cstr, ".so" to cstr) == 0:
            base_len = out_len - 3 to usize
        memcpy(pyi_buf to ptr, out_file to ptr, base_len)
        let pyi_suffix as cstr = ".pyi" to cstr
        memcpy(((pyi_buf to usize) + base_len) to ptr, pyi_suffix to ptr, 5 to usize)
        let pyi_path as cstr = pyi_buf to cstr
        let f_pyi as ptr = fopen(pyi_path, "wb" to cstr)
        if f_pyi != None to ptr:
            let _w_pyi as usize = fwrite(pyi_content.data to ptr, 1 to usize, pyi_content.len, f_pyi)
            fclose(f_pyi)
        free(pyi_buf to ptr)

    mantiq_ast_arena_reset()
    mantiq_intern_reset()
    return res == 0


// ── Check Pipeline (Syntax, Semantic, Types, Borrowck) ───────────────────
fn check_source(source_cstr as cstr, path_cstr as cstr, mode as i32, perf as ptr[PerfState]) as bool:
    let engine as ptr[DiagnosticEngine] = make[DiagnosticEngine](1 to usize) to ptr[DiagnosticEngine]
    engine.init()
    engine.register_source(String.make(path_cstr), String.make(source_cstr))

    // ── Phase 1: Parse / Lower ──
    let t0 as i64 = perf_begin(perf, "parse" to cstr)
    var lowerer as ptr[Lowerer] = None to ptr[Lowerer]
    if mode == LanguageMode.Nizam to i32:
        lowerer = make_lowerer_from_cstr(source_cstr, path_cstr)
    else:
        lowerer = make_lowerer_mantiq_from_cstr(source_cstr, path_cstr)
    let root as ptr[Node] = (deref lowerer).lower_source()
    perf_end(perf, "parse" to cstr, t0)
    if root == None to ptr:
        let _p1 as i32 = printf("Error: Failed to lower program AST\n" to cstr, "" to cstr)
        mantiq_ast_arena_reset()
        mantiq_intern_reset()
        return False


    // ── Phase 2: Semantic Analysis ──
    let t1 as i64 = perf_begin(perf, "sema" to cstr)
    let sema as ptr[Sema] = make[Sema](1 to usize) to ptr[Sema]
    (deref sema).init_sema(path_cstr)
    if mode == LanguageMode.Nizam to i32:
        (deref sema).mode = LanguageMode.Nizam
    else:
        (deref sema).mode = LanguageMode.Mantiq
    (deref sema).engine = engine
    (deref sema).root_ast = root
    sema.declare_pass(root)
    sema.resolve_pass(root)
    sema.analyze_gil_safety(root)
    perf_end(perf, "sema" to cstr, t1)

    // ── Phase 3: Type Checking ──
    let t2 as i64 = perf_begin(perf, "typecheck" to cstr)
    let tc as ptr[TypeChecker] = make[TypeChecker](1 to usize) to ptr[TypeChecker]
    (deref tc).init_tc(sema)
    let _tc_t as ptr[Type] = (deref tc).typecheck_node(root)
    perf_end(perf, "typecheck" to cstr, t2)

    // ── Phase 4: Borrow Checking ──
    let t3 as i64 = perf_begin(perf, "borrowck" to cstr)
    let bc as ptr[BorrowChecker] = make[BorrowChecker](1 to usize) to ptr[BorrowChecker]
    (deref bc).init_bc()
    (deref bc).sema = sema
    (deref bc).current_file = (deref sema).current_file
    (deref bc).walk_ast(root)
    perf_end(perf, "borrowck" to cstr, t3)

    if engine.has_errors():
        engine.emit_all_cached()
        mantiq_ast_arena_reset()
        mantiq_intern_reset()
        return False

    mantiq_ast_arena_reset()
    mantiq_intern_reset()
    return True


// ── CLI Driver ──────────────────────────────────────────────────────────
fn get_arg(argv as ptr[cstr], idx as i32) as cstr:
    return argv[idx]

fn main(argc as i32, argv as ptr[cstr]) as i32:
    var default_mode as i32 = LanguageMode.Mantiq to i32
    var bin_name as cstr = "mantiq" to cstr
    if argc >= 1 and str_contains(get_arg(argv, 0 to i32), "nizam" to cstr):
        default_mode = LanguageMode.Nizam to i32
        bin_name = "nizam" to cstr
    let self_name as cstr = compiler_name(default_mode)

    // scan for --profile flag
    var prof_flag as bool = False
    var ai as i32 = 1 to i32
    while ai < argc:
        if strcmp(get_arg(argv, ai), "--profile" to cstr) == 0:
            prof_flag = True
        ai = ai + 1 to i32
    if prof_flag:
        mantiq_set_profile_active(1 to i32)

    if argc < 2:
        let _p3 as i32 = printf("%s Self-Hosting Compiler v0.1.0\nUsage: %s <command> [options]\n  build <file.nz> [-o <out>] [--target <triple>] [--release|--debug] [--profile]\n  run <file.nz> [--target <triple>] [--release|--debug] [--profile]\n  check <file.nz> [--profile]\n  version\n" to cstr, self_name, bin_name)
        let _f1 as i32 = fflush(None to ptr)
        return 0 to i32

    let cmd as cstr = get_arg(argv, 1 to i32)
    if strcmp(cmd, "version" to cstr) == 0 or strcmp(cmd, "--version" to cstr) == 0:
        let _p4 as i32 = printf("%s Self-Hosting Compiler v0.1.0\n" to cstr, self_name)
        let _f2 as i32 = fflush(None to ptr)
        return 0 to i32

    if strcmp(cmd, "check" to cstr) == 0:
        if argc < 3:
            let _p_chk_err as i32 = printf("Error: 'check' requires an input file path\nUsage: %s check <file.nz|file.mq> [--profile]\n" to cstr, bin_name)
