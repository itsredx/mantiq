// ── Performance Monitor ─────────────────────────────────────────────────
extern fn mantiq_perf_now_ns() as i64
extern fn mantiq_perf_rss_bytes() as i64
extern fn mantiq_alloc_count() as i64
extern fn mantiq_alloc_bytes() as i64
extern fn mantiq_free_count() as i64

fn perf_now_ns() as i64:
    return mantiq_perf_now_ns()

fn perf_rss_bytes() as i64:
    return mantiq_perf_rss_bytes()

struct PerfPhase:
    public var name as cstr
    public var time_ns as i64
    public var rss_start as i64
    public var rss_end as i64
    public var alloc_delta as i64
    public var bytes_delta as i64

struct PerfState:
    public var phase_buf as ptr[PerfPhase]
    public var phase_count as i64
    public var wall_start as i64
    public var rss_start as i64
    public var enabled as bool
    public var allocs_start as i64
    public var bytes_start as i64
    public var frees_start as i64
    public var allocs_last as i64
    public var bytes_last as i64

fn perf_init() as PerfState:
    let a_start as i64 = mantiq_alloc_count()
    let b_start as i64 = mantiq_alloc_bytes()
    return PerfState(phase_buf = make[PerfPhase](16 to usize) to ptr[PerfPhase], phase_count = 0 to i64, wall_start = perf_now_ns(), rss_start = perf_rss_bytes(), enabled = False, allocs_start = a_start, bytes_start = b_start, frees_start = mantiq_free_count(), allocs_last = a_start, bytes_last = b_start)

fn perf_begin(p as ptr[PerfState], name as cstr) as i64:
    if (deref p).enabled:
        let _pb as i32 = printf(">>> Phase: %s\n" to cstr, name)
        let _pbf as i32 = fflush(None to ptr)
        (deref p).allocs_last = mantiq_alloc_count()
        (deref p).bytes_last = mantiq_alloc_bytes()
    return perf_now_ns()

fn perf_end(p as ptr[PerfState], name as cstr, t0 as i64):
    if not (deref p).enabled:
        return
    let _pe as i32 = printf("<<< Phase done: %s\n" to cstr, name)
    let _pef as i32 = fflush(None to ptr)
    let t1 as i64 = perf_now_ns()
    let rss_now as i64 = perf_rss_bytes()
    let a_now as i64 = mantiq_alloc_count()
    let b_now as i64 = mantiq_alloc_bytes()
    let a_delta as i64 = a_now - (deref p).allocs_last
    let b_delta as i64 = b_now - (deref p).bytes_last
    let idx as i64 = (deref p).phase_count
    if idx < 16 to i64:
        let base as usize = (deref p).phase_buf to usize
        let offset as usize = idx to usize * 48 to usize
        let p_ptr as ptr[PerfPhase] = (base + offset) to ptr[PerfPhase]
        deref p_ptr = PerfPhase(name = name, time_ns = t1 - t0, rss_start = (deref p).rss_start, rss_end = rss_now, alloc_delta = a_delta, bytes_delta = b_delta)
        (deref p).phase_count = idx + 1 to i64

fn perf_print(p as ptr[PerfState]):
    if not (deref p).enabled:
        return
    let wall_end as i64 = perf_now_ns()
    let total_ns as i64 = wall_end - (deref p).wall_start
    let buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]

    let _f0 as i32 = printf("\n" to cstr)
    let _f1 as i32 = printf("┌─ Performance Report ──────────────────────────────────────────────┐\n" to cstr)

    // total time
    if total_ns < 1000000 to i64:
        let _ as i32 = sprintf(buf, "%ld.%ld ms", total_ns / 1000000 to i64, (total_ns % 1000000 to i64) / 100000 to i64)
    elif total_ns < 1000000000 to i64:
        let _ as i32 = sprintf(buf, "%ld.%ld ms", total_ns / 1000000 to i64, (total_ns % 1000000 to i64) / 100000 to i64)
    else:
        let _ as i32 = sprintf(buf, "%ld.%ld s", total_ns / 1000000000 to i64, (total_ns % 1000000000 to i64) / 100000000 to i64)
    let _f2 as i32 = printf("│  Total time:   %-51s │\n" to cstr, buf)

    // peak RSS
    let peak_rss as i64 = (deref p).rss_start
    let _ as i32 = sprintf(buf, "%ld KB", peak_rss / 1024 to i64)
    let _f3 as i32 = printf("│  Peak RSS:     %-51s │\n" to cstr, buf)

    let _f4 as i32 = printf("├───────────────────────────────────────────────────────────────────┤\n" to cstr)
    let _f5 as i32 = printf("│  %-20s %10s %9s %10s %11s  │\n" to cstr, "Phase" to cstr, "Time" to cstr, "RSS Δ" to cstr, "Allocs" to cstr, "Bytes" to cstr)
    let _f6 as i32 = printf("├───────────────────────────────────────────────────────────────────┤\n" to cstr)

    var i as i64 = 0 to i64
    let cnt as i64 = (deref p).phase_count
    while i < cnt:
        let base as usize = (deref p).phase_buf to usize
        let offset as usize = i to usize * 48 to usize
        let ph_ptr as ptr[PerfPhase] = (base + offset) to ptr[PerfPhase]
        let ph as PerfPhase = deref ph_ptr
        let t_ns as i64 = ph.time_ns
        if t_ns < 1000000 to i64:
            let _ as i32 = sprintf(buf, "%ld.%ld ms", t_ns / 1000000 to i64, (t_ns % 1000000 to i64) / 100000 to i64)
        elif t_ns < 1000000000 to i64:
            let _ as i32 = sprintf(buf, "%ld.%ld ms", t_ns / 1000000 to i64, (t_ns % 1000000 to i64) / 100000 to i64)
        else:
            let _ as i32 = sprintf(buf, "%ld.%ld s", t_ns / 1000000000 to i64, (t_ns % 1000000000 to i64) / 100000000 to i64)

        let rss_delta as i64 = ph.rss_end - ph.rss_start
        let rss_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
        if rss_delta >= 0 to i64:
            let _ as i32 = sprintf(rss_buf, "+%ld KB", rss_delta / 1024 to i64)
        else:
            let _ as i32 = sprintf(rss_buf, "%ld KB", rss_delta / 1024 to i64)
        let bytes_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
        let _ as i32 = sprintf(bytes_buf, "%ld KB", ph.bytes_delta / 1024 to i64)
        let _fp as i32 = printf("│  %-20s %10s %9s %10ld %11s  │\n" to cstr, ph.name, buf, rss_buf, ph.alloc_delta, bytes_buf)
        i = i + 1 to i64

    let _f7 as i32 = printf("├───────────────────────────────────────────────────────────────────┤\n" to cstr)
    let alloc_now as i64 = mantiq_alloc_count()
    let bytes_now as i64 = mantiq_alloc_bytes()
    let free_now as i64 = mantiq_free_count()
    let allocs as i64 = alloc_now - (deref p).allocs_start
    let bytes as i64 = bytes_now - (deref p).bytes_start
    let frees as i64 = free_now - (deref p).frees_start
    var _sa as i32 = sprintf(buf, "%ld", allocs)
    let _f7a as i32 = printf("│  Allocations:   %-51s │\n" to cstr, buf)
    _sa = sprintf(buf, "%ld KB", bytes / 1024 to i64)
    let _f7b as i32 = printf("│  Alloc bytes:   %-51s │\n" to cstr, buf)
    _sa = sprintf(buf, "%ld", frees)
    let _f7c as i32 = printf("│  Frees:         %-51s │\n" to cstr, buf)
    let _f7d as i32 = printf("└───────────────────────────────────────────────────────────────────┘\n" to cstr)
    let _f8 as i32 = fflush(None to ptr)

// ── File I/O Helper ──────────────────────────────────────────────────────
fn read_file_to_cstr(path as cstr) as cstr:
    let f as ptr = fopen(path, "rb" to cstr)
    if f == None to ptr:
        return None to cstr
    let _s1 as i32 = fseek(f, 0 to isize, 2 to i32)
    let len as isize = ftell(f)
    let _s2 as i32 = fseek(f, 0 to isize, 0 to i32)
    let buf as ptr = malloc(len to usize + 1 to usize)
    if buf == None to ptr:
        fclose(f)
        return None to cstr
    let read_count as usize = fread(buf, 1 to usize, len to usize, f)
    fclose(f)
    let end_ptr as ptr = (buf to usize + read_count) to ptr
    deref (end_ptr to ptr[u8]) = 0 to u8
    return buf to cstr

// ── Mode Detection Helpers ─────────────────────────────────────────────
fn str_ends_with(haystack as cstr, suffix as cstr) as bool:
    if haystack == None to cstr or suffix == None to cstr:
        return False
    let hl as usize = strlen(haystack)
    let sl as usize = strlen(suffix)
    if sl > hl:
        return False
    return strcmp((haystack to usize + (hl - sl)) to cstr, suffix) == 0

fn str_contains(haystack as cstr, needle as cstr) as bool:
    if haystack == None to cstr or needle == None to cstr:
        return False
    return strstr(haystack, needle) != None to cstr

fn detect_mode(input_path as cstr, default_mode as i32) as i32:
    if input_path != None to cstr:
        if str_ends_with(input_path, ".nz" to cstr):
            return LanguageMode.Nizam to i32
        elif str_ends_with(input_path, ".mq" to cstr):
            return LanguageMode.Mantiq to i32
    return default_mode

fn compiler_name(mode as i32) as cstr:
    if mode == LanguageMode.Nizam to i32:
        return "Nizam" to cstr
    return "Mantiq" to cstr

fn get_module_name_from_path(path as cstr) as String:
    if path == None to cstr:
        return String.make("nizam_ext" to cstr)
    let p_len as usize = strlen(path)
    if p_len == 0 to usize:
        return String.make("nizam_ext" to cstr)
    var start as usize = 0 to usize
    var i as usize = p_len
    let path_u8 as ptr[u8] = path to ptr[u8]
    while i > 0 to usize:
        let ch as u8 = path_u8[i - 1 to usize]
        if ch == 47 to u8:
            start = i
            break
        i = i - 1 to usize
    let base_ptr as cstr = ((path to usize) + start) to cstr
    let base_len as usize = strlen(base_ptr)
    var end as usize = base_len
    if strstr(base_ptr, ".abi3.so" to cstr) != None to cstr:
        end = base_len - 8 to usize
    elif strstr(base_ptr, ".so" to cstr) != None to cstr:
        end = base_len - 3 to usize
    elif strstr(base_ptr, ".nz" to cstr) != None to cstr:
        end = base_len - 3 to usize
    elif strstr(base_ptr, ".mq" to cstr) != None to cstr:
        end = base_len - 3 to usize
    let buf as ptr[u8] = malloc(end + 1 to usize) to ptr[u8]
    let base_u8 as ptr[u8] = base_ptr to ptr[u8]
    var bi as usize = 0 to usize
    while bi < end:
        var bch as u8 = base_u8[bi]
        if bch == 45 to u8 or bch == 46 to u8:
            bch = 95 to u8
        buf[bi] = bch
        bi = bi + 1 to usize
    buf[end] = 0 to u8
    let res as String = String.make(buf to cstr)
    free(buf to ptr)
    return res

// ── Cache & SHA-256 Helpers ─────────────────────────────────────────────
fn get_file_sha256(path as cstr) as String:
    let buf as ptr[u8] = malloc(65 to usize) to ptr[u8]
    let ok as i32 = mantiq_sha256_file_hex(path, buf)
    if ok == 0 to i32:
        free(buf to ptr)
        return String.make("" to cstr)
    buf[64] = 0 to u8
    let s as String = String.make(buf to cstr)
    free(buf to ptr)
    return s

fn get_str_sha256(data as cstr, len as usize) as String:
    let buf as ptr[u8] = malloc(65 to usize) to ptr[u8]
    mantiq_sha256_hex(data, len, buf)
    buf[64] = 0 to u8
    let s as String = String.make(buf to cstr)
    free(buf to ptr)
    return s

fn split_lines(content as String) as List[String]:
    let lines as List[String] = List[String]()
    var start as usize = 0 to usize
    var i as usize = 0 to usize
    while i < content.len:
        if content.data[i] == 10 to u8: // '\n'
            let line_len as usize = i - start
            let buf as ptr[u8] = malloc(line_len + 1 to usize) to ptr[u8]
            memcpy(buf to ptr, (content.data to usize + start) to ptr, line_len)
            buf[line_len] = 0 to u8
            lines.append(String.make(buf to cstr))
            free(buf to ptr)
            start = i + 1 to usize
        i = i + 1 to usize
    if start < content.len:
        let line_len as usize = content.len - start
        let buf as ptr[u8] = malloc(line_len + 1 to usize) to ptr[u8]
        memcpy(buf to ptr, (content.data to usize + start) to ptr, line_len)
        buf[line_len] = 0 to u8
        lines.append(String.make(buf to cstr))
        free(buf to ptr)
    return lines

// ── Compiler Pipeline ───────────────────────────────────────────────────
fn compile_source(source_cstr as cstr, path_cstr as cstr, out_file as cstr, mode as i32, target_str as cstr, perf as ptr[PerfState], is_debug as bool, use_cache as bool, cache_dir as cstr) as bool:
    let exe_sha as String = get_file_sha256("/proc/self/exe" to cstr)
    let flags_buf as ptr[u8] = malloc(512 to usize) to ptr[u8]
    let _fb as i32 = sprintf(flags_buf, "%d_%s_%d_%s" to cstr, mode, target_str, if is_debug: 1 to i32 else: 0 to i32, exe_sha.data to cstr)
    let flags_sig as String = String.make(flags_buf to cstr)
    free(flags_buf to ptr)

    let bin_dir_sb as StringBuilder = StringBuilder.make()
    bin_dir_sb.append(cache_dir)
    bin_dir_sb.append("/bin" to cstr)
    let bin_dir as String = bin_dir_sb.to_string()
    bin_dir_sb.deinit()

    let meta_dir_sb as StringBuilder = StringBuilder.make()
    meta_dir_sb.append(cache_dir)
    meta_dir_sb.append("/meta" to cstr)
    let meta_dir as String = meta_dir_sb.to_string()
    meta_dir_sb.deinit()

    if use_cache:
        mantiq_mkdir_p(cache_dir)
        mantiq_mkdir_p(bin_dir.data to cstr)
        mantiq_mkdir_p(meta_dir.data to cstr)

    let path_len as usize = strlen(path_cstr)
    let path_hash as String = get_str_sha256(path_cstr, path_len)
    let dep_path_sb as StringBuilder = StringBuilder.make()
    dep_path_sb.append(meta_dir.data to cstr)
    dep_path_sb.append("/" to cstr)
    dep_path_sb.append(path_hash.data to cstr)
    dep_path_sb.append(".dep" to cstr)
    let dep_file_path as String = dep_path_sb.to_string()
    dep_path_sb.deinit()

    // ── Tier 1 Cache Check (Dependency Graph Short-Circuit) ──
    if use_cache and access(dep_file_path.data to cstr, 0 to i32) == 0 to i32:
        let dep_raw as cstr = read_file_to_cstr(dep_file_path.data to cstr)
        if dep_raw != None to cstr:
            let dep_str as String = String.make(dep_raw)
            free(dep_raw to ptr)
            let d_lines as List[String] = split_lines(dep_str)
            if d_lines.length() >= 4 to i64:
                let cached_bin_name as String = d_lines[0]
                let exp_root_sha as String = d_lines[1]
                let exp_flags as String = d_lines[2]
                if strcmp(exp_flags.data to cstr, flags_sig.data to cstr) == 0:
                    let cur_root_sha as String = get_file_sha256(path_cstr)
                    if strcmp(cur_root_sha.data to cstr, exp_root_sha.data to cstr) == 0:
                        let bin_full_sb as StringBuilder = StringBuilder.make()
                        bin_full_sb.append(bin_dir.data to cstr)
                        bin_full_sb.append("/" to cstr)
                        bin_full_sb.append(cached_bin_name.data to cstr)
                        let bin_full_path as String = bin_full_sb.to_string()
                        bin_full_sb.deinit()
                        if access(bin_full_path.data to cstr, 0 to i32) == 0 to i32:
                            var deps_ok as bool = True
                            var d_i as i64 = 4 to i64
                            while d_i + 1 to i64 < d_lines.length():
                                let d_path as String = d_lines[d_i]
                                let d_sha as String = d_lines[d_i + 1 to i64]
                                let cur_d_sha as String = get_file_sha256(d_path.data to cstr)
                                if strcmp(cur_d_sha.data to cstr, d_sha.data to cstr) != 0:
                                    deps_ok = False
                                    break
                                d_i = d_i + 2 to i64
                            if deps_ok:
                                let copy_ok as i32 = mantiq_copy_file(bin_full_path.data to cstr, out_file)
                                if copy_ok != 0:
                                    mantiq_ast_arena_reset()
                                    mantiq_intern_reset()
                                    return True


    let engine as ptr[DiagnosticEngine] = make[DiagnosticEngine](1 to usize) to ptr[DiagnosticEngine]
    engine.init()
    engine.register_source(String.make(path_cstr), String.make(source_cstr))

    let target as Target = Target.from_triple(target_str)

    // ── Phase 1: Parse / Lower ──
    let t0 as i64 = perf_begin(perf, "parse")
    var lowerer as ptr[Lowerer] = None to ptr[Lowerer]
    if mode == LanguageMode.Nizam to i32:
        lowerer = make_lowerer_from_cstr(source_cstr, path_cstr)
    else:
        lowerer = make_lowerer_mantiq_from_cstr(source_cstr, path_cstr)
    let root as ptr[Node] = (deref lowerer).lower_source()
    perf_end(perf, "parse", t0)
    if root == None to ptr:
        let _p1 as i32 = printf("Error: Failed to lower program AST\n" to cstr, "" to cstr)
        mantiq_ast_arena_reset()
        mantiq_intern_reset()
        return False


    // ── Phase 2: Semantic Analysis ──
    let t1 as i64 = perf_begin(perf, "sema")
    let sema as ptr[Sema] = make[Sema](1 to usize) to ptr[Sema]
    (deref sema).init_sema(path_cstr)
    if mode == LanguageMode.Nizam to i32:
        (deref sema).mode = LanguageMode.Nizam
    else:
        (deref sema).mode = LanguageMode.Mantiq
    (deref sema).engine = engine
    (deref sema).root_ast = root
    sema.declare_pass(root)
    sema.resolve_pass(root)
    sema.analyze_gil_safety(root)
    perf_end(perf, "sema", t1)

    // ── Phase 3: Type Checking ──
    let t2 as i64 = perf_begin(perf, "typecheck")
    let tc as ptr[TypeChecker] = make[TypeChecker](1 to usize) to ptr[TypeChecker]
    (deref tc).init_tc(sema)
    let _tc_t as ptr[Type] = (deref tc).typecheck_node(root)
    perf_end(perf, "typecheck", t2)

    // ── Phase 4: Borrow Checking ──
    let t3 as i64 = perf_begin(perf, "borrowck")
    let bc as ptr[BorrowChecker] = make[BorrowChecker](1 to usize) to ptr[BorrowChecker]
    (deref bc).init_bc()
    (deref bc).sema = sema
    (deref bc).current_file = (deref sema).current_file
    (deref bc).walk_ast(root)
    perf_end(perf, "borrowck", t3)

    // ── Phase 4.2: CFG Analysis & Drop Elaboration ──
    let t_cfg as i64 = perf_begin(perf, "cfg")
    let cfg_an as ptr[CFGAnalyzer] = make[CFGAnalyzer](1 to usize) to ptr[CFGAnalyzer]
    (deref cfg_an).init_cfg(engine, (deref sema).current_file)
    let _cfg_ok as bool = (deref cfg_an).analyze_program(root)
    perf_end(perf, "cfg", t_cfg)

    if engine.has_errors():
        engine.emit_all_cached()
        mantiq_ast_arena_reset()
        mantiq_intern_reset()
        return False


    // ── Phase 4.5: Dead Code Elimination ──
    let t_dce as i64 = perf_begin(perf, "dce")
    let dce_opt as ptr[DeadCodeEliminator] = make[DeadCodeEliminator](1 to usize) to ptr[DeadCodeEliminator]
    (deref dce_opt).init_dce()
    dce_opt.optimize_program(root)
    perf_end(perf, "dce", t_dce)

    // ── Phase 5: Code Generation ──
    let t4 as i64 = perf_begin(perf, "codegen")
    let cg as ptr[LLVMCodegen] = make[LLVMCodegen](1 to usize) to ptr[LLVMCodegen]
    (deref cg).init_cg()
    (deref cg).target = target
    if target.is_python_ext():
        (deref cg).python_ext_module_name = get_module_name_from_path(out_file)
    (deref cg).populate_auto_drops_from_borrowck((deref bc).auto_drops)
    (deref cg).populate_divergent_vars((deref cfg_an).divergent_vars)
    let ir_str as String = (deref cg).generate(root)
    perf_end(perf, "codegen", t4)

    // ── Tier 2 Cache Check (IR Link Short-Circuit) ──
    let ir_sha as String = get_str_sha256(ir_str.data to cstr, ir_str.len)
    let bin_name_sb as StringBuilder = StringBuilder.make()
    bin_name_sb.append(ir_sha.data to cstr)
    bin_name_sb.append("_" to cstr)
    bin_name_sb.append(flags_sig.data to cstr)
    let bin_name as String = bin_name_sb.to_string()
    bin_name_sb.deinit()

    let cached_bin_sb as StringBuilder = StringBuilder.make()
    cached_bin_sb.append(bin_dir.data to cstr)
    cached_bin_sb.append("/" to cstr)
    cached_bin_sb.append(bin_name.data to cstr)
    let cached_bin_path as String = cached_bin_sb.to_string()
    cached_bin_sb.deinit()

    var link_cache_hit as bool = False
    if use_cache and access(cached_bin_path.data to cstr, 0 to i32) == 0 to i32:
        let copy_ok as i32 = mantiq_copy_file(cached_bin_path.data to cstr, out_file)
        if copy_ok != 0:
            link_cache_hit = True

    var res as i32 = 0
    if not link_cache_hit:
        // ── Phase 6: Write IR ──
        let t5 as i64 = perf_begin(perf, "write_ir")
        let ll_buf as ptr[u8] = malloc(2048 to usize) to ptr[u8]
        let _ll0 as i32 = sprintf(ll_buf, "%s.ll" to cstr, out_file)
        let ll_path as cstr = ll_buf to cstr
        let f_ll as ptr = fopen(ll_path, "wb" to cstr)
        if f_ll == None to ptr:
            let _p2 as i32 = printf("Error: Failed to open LLVM IR file %s\n" to cstr, ll_path)
            mantiq_ast_arena_reset()
            mantiq_intern_reset()
            return False

        let _w1 as usize = fwrite(ir_str.data to ptr, 1 to usize, ir_str.len, f_ll)
        fclose(f_ll)
        perf_end(perf, "write_ir", t5)

        // ── Phase 7: Link ──
        let t6 as i64 = perf_begin(perf, "link")
        let lib_dir as cstr = compiler_lib_dir()
        let cmd_buf as ptr[u8] = malloc(8192 to usize) to ptr[u8]
        
        let extra_flags as StringBuilder = StringBuilder.make()
        let lt_count as i64 = (deref sema).link_targets.length()
        var lti as i64 = 0 to i64
        var has_py_flag as bool = False
        while lti < lt_count:
