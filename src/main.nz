// ── Milestone D: native ports of the last runtime.c functions ────────────────
// Everything here was previously resolved from runtime.c at link time.
// These are TU-local definitions: the compiler binary carries its own
// copies, so runtime.c is no longer linked into native builds.
//
// ── Direct Process Execution (no /bin/sh overhead) ───────────────────────────
fn mantiq_run_command_direct(argv as ptr[cstr]) as i32:
    extern fn fork() as i32
    extern fn execvp(file as cstr, argv as ptr[cstr]) as i32
    extern fn _exit(code as i32)
    extern fn waitpid(pid as i32, status as ptr, opts as i32) as i32
    if argv == None to ptr[cstr]:
        return -1 to i32
    if argv[0] == None to cstr:
        return -1 to i32
    let pid as i32 = fork()
    if pid < 0 to i32:
        return -1 to i32
    if pid == 0 to i32:
        let _r as i32 = execvp(argv[0], argv)
        _exit(127 to i32)
        return -1 to i32
    var status as i32 = 0 to i32
    let w as i32 = waitpid(pid, (ref status) to ptr, 0 to i32)
    if w < 0 to i32:
        return -1 to i32
    let sig as i32 = status & 127
    if sig == 0 to i32:
        let code as i32 = status / 256
        return code & 255
    return sig


// Guard: reject filesystem paths containing control bytes. Such paths can
// only originate from uninitialized or freed memory passed as a cstr (see
// docs/runtime-elimination-notes.md, aliasing-drop instances #1-#5);
// previously they created junk files/dirs named after raw memory bytes.
fn mantiq_path_sane(p as cstr) as i32:
    if p == None to cstr:
        return 0 to i32
    let pu as ptr[u8] = p to ptr[u8]
    var i as usize = 0 to usize
    while pu [i] != 0 to u8:
        let c as i32 = pu [i] to i32
        if c < 32 to i32 or c == 127 to i32:
            return 0 to i32
        i = i + 1 to usize
    return 1 to i32


fn mantiq_mkdir_p(dir_path as cstr) as i32:
    extern fn mkdir(path as cstr, mode as i32) as i32
    extern fn strlen(s as cstr) as usize
    extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
    if dir_path == None to cstr:
        return 0 to i32
    if mantiq_path_sane(dir_path) == 0 to i32:
        return 0 to i32
    let len as usize = strlen(dir_path)
    if len == 0 to usize or len >= 4096 to usize:
        return 0 to i32
    // Leak-mode: the 4KB scratch buffer is intentionally not freed.
    let tmp as ptr[u8] = malloc(4096 to usize) to ptr[u8]
    let _m as ptr = memcpy(tmp to ptr, dir_path to ptr, len + 1 to usize)
    var i as usize = 1 to usize
    while i < len:
        if tmp[i] == 47 to u8: // '/'
            tmp[i] = 0 to u8
            if mkdir(tmp to cstr, 493 to i32) != 0 to i32 and access(tmp to cstr, 0 to i32) != 0 to i32:
                return 0 to i32
            tmp[i] = 47 to u8
        i = i + 1 to usize
    if mkdir(tmp to cstr, 493 to i32) != 0 to i32 and access(tmp to cstr, 0 to i32) != 0 to i32:
        return 0 to i32
    return 1 to i32


fn mantiq_copy_file(src_path as cstr, dst_path as cstr) as i32:
    extern fn open(path as cstr, flags as i32, mode as i32) as i32
    extern fn close(fd as i32) as i32
    extern fn read(fd as i32, buf as ptr, count as usize) as i64
    extern fn write(fd as i32, buf as ptr, count as usize) as i64
    extern fn strlen(s as cstr) as usize
    extern fn memcpy(dest as ptr, src as ptr, n as usize) as ptr
    if src_path == None to cstr or dst_path == None to cstr:
        return 0 to i32
    if mantiq_path_sane(src_path) == 0 to i32 or mantiq_path_sane(dst_path) == 0 to i32:
        return 0 to i32
    let src_fd as i32 = open(src_path, 0 to i32, 0 to i32)
    if src_fd < 0 to i32:
        return 0 to i32
    // Ensure the destination's parent directory exists (mirrors runtime.c).
    let dlen as usize = strlen(dst_path)
    if dlen < 4096 to usize:
        let ddir as ptr[u8] = malloc(dlen + 1 to usize) to ptr[u8]
        let _m2 as ptr = memcpy(ddir to ptr, dst_path to ptr, dlen + 1 to usize)
        var li as usize = dlen
        while li > 0 to usize:
            li = li -1 to usize
            if ddir[li] == 47 to u8: // '/'
                ddir[li] = 0 to u8
                let _mk as i32 = mantiq_mkdir_p(ddir to cstr)
                break
    let dst_fd as i32 = open(dst_path, 577 to i32, 493 to i32) // O_WRONLY|O_CREAT|O_TRUNC, 0755
    if dst_fd < 0 to i32:
        let _c1 as i32 = close(src_fd)
        return 0 to i32
    // Leak-mode: 64KB copy buffer intentionally not freed.
    let buf as ptr[u8] = malloc(65536 to usize) to ptr[u8]
    var ok as i32 = 1 to i32
    var n as i64 = read(src_fd, buf to ptr, 65536 to usize)
    while n > 0 to i64:
        var written as i64 = 0 to i64
        while written < n:
            let w as i64 = write(dst_fd, (buf to usize + written to usize) to ptr, (n - written) to usize)
            if w <= 0 to i64:
                ok = 0 to i32
            written = written + w
        if ok == 0 to i32:
            n = 0 to i64
        else:
            n = read(src_fd, buf to ptr, 65536 to usize)
    let _c2 as i32 = close(src_fd)
    let _c3 as i32 = close(dst_fd)
    if ok == 0 to i32:
        return 0 to i32
    return 1 to i32


// ── Performance Monitor ──────────────────────────────────────────────────────
fn mantiq_perf_now_ns() as i64:
    // Phase 3 (spec 0031): std.sys clock — CLOCK_MONOTONIC without the
    // per-call leaked malloc the raw clock_gettime pattern had.
    return now_monotonic_ns() to i64


fn mantiq_perf_rss_bytes() as i64:
    extern fn getrusage(who as i32, usage as ptr) as i32
    // struct rusage on x86-64: two 16-byte timevals, then ru_maxrss (i64)
    // at offset 32, reported in KB.
    let ru as ptr[u8] = malloc(144 to usize) to ptr[u8]
    let _r as i32 = getrusage(0 to i32, ru to ptr) // RUSAGE_SELF
    let p as ptr[i64] = (ru to usize + 32 to usize) to ptr[i64]
    let kb as i64 = p[0]
    return kb * 1024


// The C-side tallies (_alloc_count/_alloc_bytes/_free_count) only counted
// allocations made by runtime.c's own C-internal helpers; the Nizam-side
// mantiq_malloc (calloc-backed) never fed them. Ported as inert zeros to
// preserve observed behavior exactly.
fn mantiq_alloc_count() as i64:
    return 0 to i64


fn mantiq_alloc_bytes() as i64:
    return 0 to i64


fn mantiq_free_count() as i64:
    return 0 to i64


fn mantiq_set_profile_active(active as i32):
    return


// Leak-mode: the C bump-arena reset/destroy is a no-op (stale pointers stay
// valid; mantiq_ast_alloc now calloc's fresh zeroed blocks).
fn mantiq_ast_arena_reset():
    return


fn mantiq_intern_reset():
    return


// ── Allocator / interning surface (last runtime.c link-time deps) ────────────
// Leak-mode semantics: allocations are never released, so the C arena, slab
// and page machinery reduce to fresh zeroed allocations. The needle text in
// emit_rt_glue_bodies (codegen.nz) matches these compiled defines, so the
// TU-side templates skip themselves in self-hosted builds.
//   - mantiq_ast_alloc:    calloc's a fresh zeroed block (min size 1).
//   - mantiq_alloc_box32:  32-byte zeroed box (was a 64KB bump slab; under
//     leak-mode both are semantically a permanent 32-byte grant).
//   - mantiq_intern_string: fresh zero-terminated copy, no deduplication
//     (all consumers strcmp anyway).
//   - mantiq_page_alloc/free: mmap/munmap rounded to 4KB pages; NULL on
//     failure (callers only test NULL; Linux mmap never returns NULL).
fn mantiq_ast_alloc(sz as usize) as ptr:
    extern fn calloc(nmemb as usize, cnt as usize) as ptr
    if sz == 0 to usize:
        return calloc(1 to usize, 1 to usize)
    return calloc(1 to usize, sz)


fn mantiq_alloc_box32() as ptr:
    extern fn calloc(nmemb as usize, sz as usize) as ptr
    return calloc(1 to usize, 32 to usize)


fn mantiq_intern_string(s as cstr, len as usize) as ptr[u8]:
    extern fn calloc(nmemb as usize, sz as usize) as ptr
    if s == None to cstr or len == 0 to usize:
        return calloc(1 to usize, 1 to usize) to ptr[u8]
    let buf as ptr[u8] = calloc(1 to usize, len + 1 to usize) to ptr[u8]
    let _m as ptr = memcpy(buf to ptr, s to ptr, len)
    return buf


fn mantiq_page_alloc(req_size as usize) as ptr[u8]:
    extern fn mmap(
        addr as ptr,
        length as usize,
        prot as i32,
        flags as i32,
        fd as i32,
        offset as i64,
    ) as ptr
    if req_size == 0 to usize:
        return None to ptr[u8]
    let aligned as usize = ((req_size + 4095 to usize) / 4096 to usize) * 4096 to usize
    let res as ptr = mmap(None to ptr, aligned, 3 to i32, 34 to i32, -1 to i32, 0 to i64)
    // MAP_FAILED == (void*)-1; Nizam has no inttoptr literal, so build the
    // sentinel from an all-ones usize.
    let map_failed as ptr = (0 - 1 to usize) to ptr
    if res == None to ptr or res == map_failed:
        return None to ptr[u8]
    return res to ptr[u8]


fn mantiq_page_free(ptr_val as ptr[u8], req_size as usize):
    extern fn munmap(addr as ptr, length as usize) as i32
    if ptr_val == None to ptr[u8] or req_size == 0 to usize:
        return
    let aligned as usize = ((req_size + 4095 to usize) / 4096 to usize) * 4096 to usize
    let _r as i32 = munmap(ptr_val to ptr, aligned)
    return


fn perf_now_ns() as i64:
    return mantiq_perf_now_ns()


fn perf_rss_bytes() as i64:
    return mantiq_perf_rss_bytes()


struct PerfPhase:
    public var name as cstr
    public var time_ns as i64
    public var rss_start as i64
    public var rss_end as i64
    public var alloc_delta as i64
    public var bytes_delta as i64


struct PerfState:
    public var phase_buf as ptr[PerfPhase]
    public var phase_count as i64
    public var wall_start as i64
    public var rss_start as i64
    public var enabled as bool
    public var allocs_start as i64
    public var bytes_start as i64
    public var frees_start as i64
    public var allocs_last as i64
    public var bytes_last as i64


fn perf_init() as PerfState:
    let a_start as i64 = mantiq_alloc_count()
    let b_start as i64 = mantiq_alloc_bytes()
    return PerfState(phase_buf = make[PerfPhase](16 to usize) to ptr[PerfPhase], phase_count = 0 to i64, wall_start = perf_now_ns(), rss_start = perf_rss_bytes(), enabled = False, allocs_start = a_start, bytes_start = b_start, frees_start = mantiq_free_count(), allocs_last = a_start, bytes_last = b_start)


fn perf_begin(p as ptr[PerfState], name as cstr) as i64:
    if (deref p).enabled:
        let _pb as i32 = printf(">>> Phase: %s\n" to cstr, name)
        let _pbf as i32 = fflush(None to ptr)
        (deref p).allocs_last = mantiq_alloc_count()
        (deref p).bytes_last = mantiq_alloc_bytes()
    return perf_now_ns()


fn perf_end(p as ptr[PerfState], name as cstr, t0 as i64):
    if not (deref p).enabled:
        return
    let _pe as i32 = printf("<<< Phase done: %s\n" to cstr, name)
    let _pef as i32 = fflush(None to ptr)
    let t1 as i64 = perf_now_ns()
    let rss_now as i64 = perf_rss_bytes()
    let a_now as i64 = mantiq_alloc_count()
    let b_now as i64 = mantiq_alloc_bytes()
    let a_delta as i64 = a_now - (deref p).allocs_last
    let b_delta as i64 = b_now - (deref p).bytes_last
    let idx as i64 = (deref p).phase_count
    if idx < 16 to i64:
        let base as usize = (deref p).phase_buf to usize
        let offset as usize = idx to usize * 48 to usize
        let p_ptr as ptr[PerfPhase] = (base + offset) to ptr[PerfPhase]
        deref p_ptr = PerfPhase(name = name, time_ns = t1 - t0, rss_start = (deref p).rss_start, rss_end = rss_now, alloc_delta = a_delta, bytes_delta = b_delta)
        (deref p).phase_count = idx + 1 to i64


fn perf_print(p as ptr[PerfState]):
    if not (deref p).enabled:
        return
    let wall_end as i64 = perf_now_ns()
    let total_ns as i64 = wall_end - (deref p).wall_start
    let buf as ptr[u8] = make[u8](128 to usize) to ptr[u8]

    let _f0 as i32 = printf("\n" to cstr)
    let _f1 as i32 = printf("┌─ Performance Report ──────────────────────────────────────────────┐\n" to cstr)

    // total time
    if total_ns < 1000000 to i64:
        let _ as i32 = sprintf(buf, "%ld.%ld ms", total_ns / 1000000 to i64, (total_ns % 1000000 to i64) / 100000 to i64)
    elif total_ns < 1000000000 to i64:
        let _ as i32 = sprintf(buf, "%ld.%ld ms", total_ns / 1000000 to i64, (total_ns % 1000000 to i64) / 100000 to i64)
    else:
        let _ as i32 = sprintf(buf, "%ld.%ld s", total_ns / 1000000000 to i64, (total_ns % 1000000000 to i64) / 100000000 to i64)
    let _f2 as i32 = printf("│  Total time:   %-51s │\n" to cstr, buf)

    // peak RSS
    let peak_rss as i64 = (deref p).rss_start
    let _ as i32 = sprintf(buf, "%ld KB", peak_rss / 1024 to i64)
    let _f3 as i32 = printf("│  Peak RSS:     %-51s │\n" to cstr, buf)

    let _f4 as i32 = printf("├───────────────────────────────────────────────────────────────────┤\n" to cstr)
    let _f5 as i32 = printf("│  %-20s %10s %9s %10s %11s  │\n" to cstr, "Phase" to cstr, "Time" to cstr, "RSS Δ" to cstr, "Allocs" to cstr, "Bytes" to cstr)
    let _f6 as i32 = printf("├───────────────────────────────────────────────────────────────────┤\n" to cstr)

    var i as i64 = 0 to i64
    let cnt as i64 = (deref p).phase_count
    while i < cnt:
        let base as usize = (deref p).phase_buf to usize
        let offset as usize = i to usize * 48 to usize
        let ph_ptr as ptr[PerfPhase] = (base + offset) to ptr[PerfPhase]
        let ph as PerfPhase = deref ph_ptr
        let t_ns as i64 = ph.time_ns
        if t_ns < 1000000 to i64:
            let _ as i32 = sprintf(buf, "%ld.%ld ms", t_ns / 1000000 to i64, (t_ns % 1000000 to i64) / 100000 to i64)
        elif t_ns < 1000000000 to i64:
            let _ as i32 = sprintf(buf, "%ld.%ld ms", t_ns / 1000000 to i64, (t_ns % 1000000 to i64) / 100000 to i64)
        else:
            let _ as i32 = sprintf(buf, "%ld.%ld s", t_ns / 1000000000 to i64, (t_ns % 1000000000 to i64) / 100000000 to i64)
        let rss_delta as i64 = ph.rss_end - ph.rss_start
        let rss_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
        if rss_delta >= 0 to i64:
            let _ as i32 = sprintf(rss_buf, "+%ld KB", rss_delta / 1024 to i64)
        else:
            let _ as i32 = sprintf(rss_buf, "%ld KB", rss_delta / 1024 to i64)
        let bytes_buf as ptr[u8] = make[u8](64 to usize) to ptr[u8]
        let _ as i32 = sprintf(bytes_buf, "%ld KB", ph.bytes_delta / 1024 to i64)
        let _fp as i32 = printf("│  %-20s %10s %9s %10ld %11s  │\n" to cstr, ph.name, buf, rss_buf, ph.alloc_delta, bytes_buf)
        i = i + 1 to i64
    let _f7 as i32 = printf("├───────────────────────────────────────────────────────────────────┤\n" to cstr)
    let alloc_now as i64 = mantiq_alloc_count()
    let bytes_now as i64 = mantiq_alloc_bytes()
    let free_now as i64 = mantiq_free_count()
    let allocs as i64 = alloc_now - (deref p).allocs_start
    let bytes as i64 = bytes_now - (deref p).bytes_start
    let frees as i64 = free_now - (deref p).frees_start
    var _sa as i32 = sprintf(buf, "%ld", allocs)
    let _f7a as i32 = printf("│  Allocations:   %-51s │\n" to cstr, buf)
    _sa = sprintf(buf, "%ld KB", bytes / 1024 to i64)
    let _f7b as i32 = printf("│  Alloc bytes:   %-51s │\n" to cstr, buf)
    _sa = sprintf(buf, "%ld", frees)
    let _f7c as i32 = printf("│  Frees:         %-51s │\n" to cstr, buf)
    let _f7d as i32 = printf("└───────────────────────────────────────────────────────────────────┘\n" to cstr)
    let _f8 as i32 = fflush(None to ptr)


// ── File I/O Helper ──────────────────────────────────────────────────────────
fn read_file_to_cstr(path as cstr) as cstr:
    let f as ptr = fopen(path, "rb" to cstr)
    if f == None to ptr:
        return None to cstr
    let _s1 as i32 = fseek(f, 0 to isize, 2 to i32)
    let len as isize = ftell(f)
    let _s2 as i32 = fseek(f, 0 to isize, 0 to i32)
    let buf as ptr = malloc(len to usize + 1 to usize)
    if buf == None to ptr:
        fclose(f)
        return None to cstr
    let read_count as usize = fread(buf, 1 to usize, len to usize, f)
    fclose(f)
    let end_ptr as ptr = (buf to usize + read_count) to ptr
    deref (end_ptr to ptr[u8]) = 0 to u8
    return buf to cstr


// ── Mode Detection Helpers ───────────────────────────────────────────────────
fn str_ends_with(haystack as cstr, suffix as cstr) as bool:
    if haystack == None to cstr or suffix == None to cstr:
        return False
    let hl as usize = strlen(haystack)
    let sl as usize = strlen(suffix)
    if sl > hl:
        return False
    return strcmp((haystack to usize + (hl - sl)) to cstr, suffix) == 0


fn str_contains(haystack as cstr, needle as cstr) as bool:
    if haystack == None to cstr or needle == None to cstr:
        return False
    return strstr(haystack, needle) != None to cstr


fn detect_mode(input_path as cstr, default_mode as i32) as i32:
    if input_path != None to cstr:
        if str_ends_with(input_path, ".nz" to cstr):
            return LanguageMode.Nizam to i32
        elif str_ends_with(input_path, ".mq" to cstr):
            return LanguageMode.Mantiq to i32
    return default_mode


fn compiler_name(mode as i32) as cstr:
    if mode == LanguageMode.Nizam to i32:
        return"Nizam" to cstr
    return"Mantiq" to cstr


fn get_module_name_from_path(path as cstr) as String:
    if path == None to cstr:
        return String.make("nizam_ext" to cstr)
    let p_len as usize = strlen(path)
    if p_len == 0 to usize:
        return String.make("nizam_ext" to cstr)
    var start as usize = 0 to usize
    var i as usize = p_len
    let path_u8 as ptr[u8] = path to ptr[u8]
    while i > 0 to usize:
        let ch as u8 = path_u8[i - 1 to usize]
        if ch == 47 to u8:
            start = i
            break
        i = i - 1 to usize
    let base_ptr as cstr = ((path to usize) +start) to cstr
    let base_len as usize = strlen(base_ptr)
    var end as usize = base_len
    if strstr(base_ptr, ".abi3.so" to cstr) != None to cstr:
        end = base_len - 8 to usize
    elif strstr(base_ptr, ".so" to cstr) != None to cstr:
        end = base_len - 3 to usize
    elif strstr(base_ptr, ".nz" to cstr) != None to cstr:
        end = base_len - 3 to usize
    elif strstr(base_ptr, ".mq" to cstr) != None to cstr:
        end = base_len - 3 to usize
    let buf as ptr[u8] = malloc(end + 1 to usize) to ptr[u8]
    let base_u8 as ptr[u8] = base_ptr to ptr[u8]
    var bi as usize = 0 to usize
    while bi < end:
        var bch as u8 = base_u8[bi]
        if bch == 45 to u8 or bch == 46 to u8:
            bch = 95 to u8
        buf[bi] = bch
        bi = bi + 1 to usize
    buf[end] = 0 to u8
    let res as String = String.make(buf to cstr)
    free(buf to ptr)
    return res


// ── Cache Content Keys ───────────────────────────────────────────────────────
// Milestone D: the C sha256 engine is gone with runtime.c. Cache keys now
// use a dual-seed FNV-1a (two independent 32-bit streams combined into a
// 64-bit key, no shared state with the 32-bit FNV used for dict hashing).
// Collision odds at compiler-cache scale (<10k entries) are ~2^-48; the
// only consumers are opaque strcmp-compared dep-file keys and binary names,
// so the format change self-heals via one cold-cache pass.
fn fnv1a32_stream(data as ptr[u8], len as usize, seed as i64) as i64:
    var hash as i64 = seed
    let m32 as i64 = 4294967295
    var i as usize = 0 to usize
    while i < len:
        hash = (hash ^ (data[i] to i64)) & m32
        hash = (hash * 16777619) & m32
        i = i + 1 to usize
    return hash


fn get_file_sha256(path as cstr) as String:
    let buf as ptr[u8] = malloc(17 to usize) to ptr[u8]
    let f as ptr = fopen(path, "rb" to cstr)
    if f == None to ptr:
        free(buf to ptr)
        return String.make("" to cstr)
    // Leak-mode: 64KB read chunk intentionally not freed.
    let chunk as ptr[u8] = malloc(65536 to usize) to ptr[u8]
    var h1 as i64 = 2166136261
    var h2 as i64 = 3141592653
    var n as usize = fread(chunk to ptr, 1 to usize, 65536 to usize, f)
    while n > 0 to usize:
        h1 = fnv1a32_stream(chunk, n, h1)
        h2 = fnv1a32_stream(chunk, n, h2)
        n = fread(chunk to ptr, 1 to usize, 65536 to usize, f)
    fclose(f)
    let _sp as i32 = sprintf(buf, "%08lx%08lx" to cstr, h1, h2)
    let s as String = String.make(buf to cstr)
    free(buf to ptr)
    return s


fn get_str_sha256(data as cstr, len as usize) as String:
    let buf as ptr[u8] = malloc(17 to usize) to ptr[u8]
    let h1 as i64 = fnv1a32_stream(data to ptr[u8], len, 2166136261)
    let h2 as i64 = fnv1a32_stream(data to ptr[u8], len, 3141592653)
    let _sp as i32 = sprintf(buf, "%08lx%08lx" to cstr, h1, h2)
    let s as String = String.make(buf to cstr)
    free(buf to ptr)
    return s


fn split_lines(content as String) as List[String]:
    let lines as List[String] = List[String]()
    var start as usize = 0 to usize
    var i as usize = 0 to usize
    while i < content.len:
        if content.data[i] == 10 to u8: // '\n'
            let line_len as usize = i - start
            let buf as ptr[u8] = malloc(line_len + 1 to usize) to ptr[u8]
            memcpy(buf to ptr, (content.data to usize + start) to ptr, line_len)
            buf[line_len] = 0 to u8
            lines.append(String.make(buf to cstr))
            free(buf to ptr)
            start = i + 1 to usize
        i = i + 1 to usize
    if start < content.len:
        let line_len as usize = content.len - start
        let buf as ptr[u8] = malloc(line_len + 1 to usize) to ptr[u8]
        memcpy(buf to ptr, (content.data to usize + start) to ptr, line_len)
        buf[line_len] = 0 to u8
        lines.append(String.make(buf to cstr))
        free(buf to ptr)
    return lines


// ── Compiler Pipeline ────────────────────────────────────────────────────────
fn compile_source(
    source_cstr as cstr,
    path_cstr as cstr,
    out_file as cstr,
    mode as i32,
    target_str as cstr,
    perf as ptr[PerfState],
    is_debug as bool,
    use_cache as bool,
    cache_dir as cstr,
    no_libc as bool,
) as bool:
    let exe_sha as String = get_file_sha256("/proc/self/exe" to cstr)
    let flags_buf as ptr[u8] = malloc(512 to usize) to ptr[u8]
    let _fb as i32 = sprintf(flags_buf, "%d_%s_%d_%d_%s" to cstr, mode, target_str, if is_debug: 1 to i32 else: 0 to i32, if no_libc: 1 to i32 else: 0 to i32, exe_sha.data to cstr)
    let flags_sig as String = String.make(flags_buf to cstr)
    free(flags_buf to ptr)

    let bin_dir_sb as StringBuilder = StringBuilder.make()
    bin_dir_sb.append(cache_dir)
    bin_dir_sb.append("/bin" to cstr)
    let bin_dir as String = bin_dir_sb.to_string()
    bin_dir_sb.deinit()

    let meta_dir_sb as StringBuilder = StringBuilder.make()
    meta_dir_sb.append(cache_dir)
    meta_dir_sb.append("/meta" to cstr)
    let meta_dir as String = meta_dir_sb.to_string()
    meta_dir_sb.deinit()

    if use_cache:
        mantiq_mkdir_p(cache_dir)
        mantiq_mkdir_p(bin_dir.data to cstr)
        mantiq_mkdir_p(meta_dir.data to cstr)
    let path_len as usize = strlen(path_cstr)
    let path_hash as String = get_str_sha256(path_cstr, path_len)
    let dep_path_sb as StringBuilder = StringBuilder.make()
    dep_path_sb.append(meta_dir.data to cstr)
    dep_path_sb.append("/" to cstr)
    dep_path_sb.append(path_hash.data to cstr)
    dep_path_sb.append(".dep" to cstr)
    let dep_file_path as String = dep_path_sb.to_string()
    dep_path_sb.deinit()

    // ── Tier 1 Cache Check (Dependency Graph Short-Circuit) ──────────────────────
    if use_cache and access(dep_file_path.data to cstr, 0 to i32) == 0 to i32:
        let dep_raw as cstr = read_file_to_cstr(dep_file_path.data to cstr)
        if dep_raw != None to cstr:
            let dep_str as String = String.make(dep_raw)
            free(dep_raw to ptr)
            let d_lines as List[String] = split_lines(dep_str)
            if d_lines.length() >= 4 to i64:
                // byval list-extraction caveat: `d_lines[i]` aliases the
                // element's buffer (struct copy, no data clone); take our own
                // copy so local drops and the list teardown never double-free.
                let cached_bin_name as String = String.make(d_lines[0].data to cstr)
                let exp_root_sha as String = String.make(d_lines[1].data to cstr)
                let exp_flags as String = String.make(d_lines[2].data to cstr)
                if strcmp(exp_flags.data to cstr, flags_sig.data to cstr) == 0:
                    let cur_root_sha as String = get_file_sha256(path_cstr)
                    if strcmp(cur_root_sha.data to cstr, exp_root_sha.data to cstr) == 0:
                        let bin_full_sb as StringBuilder = StringBuilder.make()
                        bin_full_sb.append(bin_dir.data to cstr)
                        bin_full_sb.append("/" to cstr)
                        bin_full_sb.append(cached_bin_name.data to cstr)
                        let bin_full_path as String = bin_full_sb.to_string()
                        bin_full_sb.deinit()
                        if access(bin_full_path.data to cstr, 0 to i32) == 0 to i32:
                            var deps_ok as bool = True
                            var d_i as i64 = 4 to i64
                            while d_i + 1 to i64 < d_lines.length():
                                let d_path as String = String.make(d_lines[d_i].data to cstr)
                                let d_sha as String = String.make(d_lines[d_i + 1 to i64].data to cstr)
                                let cur_d_sha as String = get_file_sha256(d_path.data to cstr)
                                if strcmp(cur_d_sha.data to cstr, d_sha.data to cstr) != 0:
                                    deps_ok = False
                                    break
                                d_i = d_i + 2 to i64
                            if deps_ok:
                                let copy_ok as i32 = mantiq_copy_file(bin_full_path.data to cstr, out_file)
                                if copy_ok != 0:
                                    mantiq_ast_arena_reset()
                                    mantiq_intern_reset()
                                    return True
    let engine as ptr[DiagnosticEngine] = make[DiagnosticEngine](1 to usize) to ptr[DiagnosticEngine]
    engine.init()
    engine.register_source(String.make(path_cstr), String.make(source_cstr))

    let target as Target = Target.from_triple(target_str)

    // ── Phase 1: Parse / Lower ───────────────────────────────────────────────────
    let t0 as i64 = perf_begin(perf, "parse")
    var lowerer as ptr[Lowerer] = None to ptr[Lowerer]
    if mode == LanguageMode.Nizam to i32:
        lowerer = make_lowerer_from_cstr(source_cstr, path_cstr)
    else:
        lowerer = make_lowerer_mantiq_from_cstr(source_cstr, path_cstr)
    let root as ptr[Node] = (deref lowerer).lower_source()
    if mode == LanguageMode.Nizam to i32 and root != None to ptr:
        monomorphize_program(lowerer, root)
    perf_end(perf, "parse", t0)
    if root == None to ptr:
        let _p1 as i32 = printf("Error: Failed to lower program AST\n" to cstr, "" to cstr)
        mantiq_ast_arena_reset()
        mantiq_intern_reset()
        return False
    // ── Phase 2: Semantic Analysis ───────────────────────────────────────────────
    let t1 as i64 = perf_begin(perf, "sema")
    let sema as ptr[Sema] = make[Sema](1 to usize) to ptr[Sema]
    (deref sema).init_sema(path_cstr)
    if mode == LanguageMode.Nizam to i32:
        (deref sema).mode = LanguageMode.Nizam
    else:
        (deref sema).mode = LanguageMode.Mantiq
    (deref sema).engine = engine
    (deref sema).root_ast = root
    sema.declare_pass(root)
    // Milestone M: module generic templates loaded (and merged into root)
    // during the declare pass; re-run monomorphisation now so module
    // generics (Set[i32] etc.) get real specialized defs and the program's
    // annotations/calls are rewritten to the mangled names. Declare the
    // generated defs so resolve/typecheck see them.
    let gen_mods as List[ptr[Node]] = monomorphize_with_sources(lowerer, (deref sema).mod_struct_generics, (deref sema).mod_fun_generics, (deref sema).mod_generic_source, (deref sema).mod_generic_path, root)
    var gm_i as i64 = 0 to i64
    while gm_i < gen_mods.length():
        sema.declare_pass(gen_mods[gm_i])
        gm_i = gm_i + 1 to i64
    // Generated instantiation bodies are snippets of the module's own source,
    // so their free identifiers refer to the module's siblings (Set's body
    // uses Dict). Those names are only in scope via explicit imports; expose
    // each loaded module's scope symbols that the main file did not import,
    // but only when instantiations actually exist (no semantic change for
    // programs without module generics).
    if gen_mods.length() > 0 to i64:
        let gscope as ptr[Scope] = (deref sema).global_scope
        let lm_keys as List[String] = (deref sema).loaded_modules.keys()
        var lm_i as i64 = 0 to i64
        while lm_i < lm_keys.length():
            let msc as ptr[Scope] = (deref sema).loaded_modules[lm_keys[lm_i]]
            let msym_keys as List[String] = (deref msc).symbols.keys()
            var mk_i as i64 = 0 to i64
            while mk_i < msym_keys.length():
                let ms_k as String = msym_keys[mk_i]
                if not (deref gscope).symbols.has(ms_k):
                    (deref gscope).symbols[ms_k] = (deref msc).symbols[ms_k]
                mk_i = mk_i + 1 to i64
            lm_i = lm_i + 1 to i64
    sema.resolve_pass(root)
    sema.analyze_gil_safety(root)
    perf_end(perf, "sema", t1)

    // ── Phase 3: Type Checking ───────────────────────────────────────────────────
    let t2 as i64 = perf_begin(perf, "typecheck")
    let tc as ptr[TypeChecker] = make[TypeChecker](1 to usize) to ptr[TypeChecker]
    (deref tc).init_tc(sema)
    let _tc_t as ptr[Type] = (deref tc).typecheck_node(root)
    perf_end(perf, "typecheck", t2)

    // ── Phase 4: CFG Analysis & Drop Elaboration ─────────────────────────────────
    let t_cfg as i64 = perf_begin(perf, "cfg")
    let cfg_an as ptr[CFGAnalyzer] = make[CFGAnalyzer](1 to usize) to ptr[CFGAnalyzer]
    (deref cfg_an).init_cfg(engine, (deref sema).current_file)
    let _cfg_ok as bool = (deref cfg_an).analyze_program(root)
    perf_end(perf, "cfg", t_cfg)

    // ── Phase 4.1: Borrow Checking ───────────────────────────────────────────────
    let t3 as i64 = perf_begin(perf, "borrowck")
    let bc as ptr[BorrowChecker] = make[BorrowChecker](1 to usize) to ptr[BorrowChecker]
    (deref bc).init_bc()
    (deref bc).sema = sema
    (deref bc).cfg_analyzer = cfg_an
    (deref bc).current_file = (deref sema).current_file
    (deref bc).walk_ast(root)
    perf_end(perf, "borrowck", t3)

    if engine.has_errors():
        engine.emit_all_cached()
        mantiq_ast_arena_reset()
        mantiq_intern_reset()
        return False
    // ── Phase 4.5: Dead Code Elimination ─────────────────────────────────────────
    let t_dce as i64 = perf_begin(perf, "dce")
    let dce_opt as ptr[DeadCodeEliminator] = make[DeadCodeEliminator](1 to usize) to ptr[DeadCodeEliminator]
    (deref dce_opt).init_dce()
    dce_opt.optimize_program(root)
    perf_end(perf, "dce", t_dce)

    // ── Phase 5: Code Generation ─────────────────────────────────────────────────
    let t4 as i64 = perf_begin(perf, "codegen")
    let cg as ptr[LLVMCodegen] = make[LLVMCodegen](1 to usize) to ptr[LLVMCodegen]
    (deref cg).init_cg()
    // Milestone D: bridge sema's needs-drop registry into codegen (replaces
    // runtime.c's C-side type registry; shared Dict handles, one store).
    (deref cg).needs_drop_types = (deref sema).needs_drop_types
    (deref cg).needs_drop_registry_active = True
    (deref cg).target = target
    (deref cg).no_libc = no_libc
    if target.is_python_ext():
        (deref cg).python_ext_module_name = get_module_name_from_path(out_file)
    (deref cg).populate_auto_drops_from_borrowck((deref bc).auto_drops)
    (deref cg).populate_divergent_vars((deref cfg_an).divergent_vars)
    let ir_str as String = (deref cg).generate(root)
    perf_end(perf, "codegen", t4)

    // ── Tier 2 Cache Check (IR Link Short-Circuit) ───────────────────────────────
    let ir_sha as String = get_str_sha256(ir_str.data to cstr, ir_str.len)
    let bin_name_sb as StringBuilder = StringBuilder.make()
    bin_name_sb.append(ir_sha.data to cstr)
    bin_name_sb.append("_" to cstr)
    bin_name_sb.append(flags_sig.data to cstr)
    let bin_name as String = bin_name_sb.to_string()
    bin_name_sb.deinit()

    let cached_bin_sb as StringBuilder = StringBuilder.make()
    cached_bin_sb.append(bin_dir.data to cstr)
    cached_bin_sb.append("/" to cstr)
    cached_bin_sb.append(bin_name.data to cstr)
    let cached_bin_path as String = cached_bin_sb.to_string()
    cached_bin_sb.deinit()

    var link_cache_hit as bool = False
    if use_cache and access(cached_bin_path.data to cstr, 0 to i32) == 0 to i32:
        let copy_ok as i32 = mantiq_copy_file(cached_bin_path.data to cstr, out_file)
        if copy_ok != 0:
            link_cache_hit = True
    var res as i32 = 0
    if not link_cache_hit:
        // ── Phase 6: Write IR ────────────────────────────────────────────────────────
        let t5 as i64 = perf_begin(perf, "write_ir")
        let ll_buf as ptr[u8] = malloc(2048 to usize) to ptr[u8]
        let _ll0 as i32 = sprintf(ll_buf, "%s.ll" to cstr, out_file)
        let ll_path as cstr = ll_buf to cstr
        let f_ll as ptr = fopen(ll_path, "wb" to cstr)
        if f_ll == None to ptr:
            let _p2 as i32 = printf("Error: Failed to open LLVM IR file %s\n" to cstr, ll_path)
            mantiq_ast_arena_reset()
            mantiq_intern_reset()
            return False
        let _w1 as usize = fwrite(ir_str.data to ptr, 1 to usize, ir_str.len, f_ll)
        fclose(f_ll)
        perf_end(perf, "write_ir", t5)

        // ── Phase 7: Link ────────────────────────────────────────────────────────────
        let t6 as i64 = perf_begin(perf, "link")
        let lib_dir as cstr = compiler_lib_dir()
        let cmd_buf as ptr[u8] = malloc(8192 to usize) to ptr[u8]

        let extra_flags as StringBuilder = StringBuilder.make()
        let lt_count as i64 = (deref sema).link_targets.length()
        var lti as i64 = 0 to i64
        var has_py_flag as bool = False
        while lti < lt_count:
            // Fresh copy, never the byval list element: the frozen-era
            // borrowck auto-drops this local at scope exit, which would free
            // the buffer the List still owns (next-iteration strcmp UAF).
            let lt_name as String = String.make(((deref sema).link_targets[lti]).data to cstr)
            if strcmp(lt_name.data to cstr, "m" to cstr) != 0:
                extra_flags.append(" -l" to cstr)
                extra_flags.append(lt_name.data to cstr)
                if strcmp(lt_name.data to cstr, "python3.12" to cstr) == 0:
                    has_py_flag = True
            lti = lti + 1 to i64
        if (deref cg).has_python_embed and not has_py_flag:
            extra_flags.append(" -lpython3.12 -ldl" to cstr)
        let extra_flags_str as String = extra_flags.to_string()
        let extra_flags_c as cstr = extra_flags_str.data to cstr

        let opt_flag as cstr = if is_debug: "-O0 -g" to cstr else: "-O2 -fno-strict-aliasing" to cstr
        let wasm_opt as cstr = if is_debug: "-O0 -g" to cstr else: "-Oz" to cstr
        let py_opt as cstr = if is_debug: "-O0 -g" to cstr else: "-O2 -fno-strict-aliasing" to cstr

        var has_rt_obj as bool = False
        if lib_dir != None to cstr:
            let rt_o_sb as StringBuilder = StringBuilder.make()
            rt_o_sb.append(lib_dir)
            rt_o_sb.append("/runtime.o" to cstr)
            let rt_o_str as String = rt_o_sb.to_string()
            has_rt_obj = access(rt_o_str.data to cstr, 0 to i32) == 0 to i32
            rt_o_sb.deinit()
        var has_wasm_rt_obj as bool = False
        var wasm_rt_obj_path as String = String.make("" to cstr)
        if lib_dir != None to cstr:
            let w_sb as StringBuilder = StringBuilder.make()
            w_sb.append(lib_dir)
            w_sb.append("/runtime_wasm.o" to cstr)
            wasm_rt_obj_path = w_sb.to_string()
            has_wasm_rt_obj = access(wasm_rt_obj_path.data to cstr, 0 to i32) == 0 to i32
            w_sb.deinit()
        if not has_wasm_rt_obj:
            if access("stage3/runtime_wasm.o" to cstr, 0 to i32) == 0 to i32:
                wasm_rt_obj_path = String.make("stage3/runtime_wasm.o" to cstr)
                has_wasm_rt_obj = True
            elif access("runtime_wasm.o" to cstr, 0 to i32) == 0 to i32:
                wasm_rt_obj_path = String.make("runtime_wasm.o" to cstr)
                has_wasm_rt_obj = True
        var _sp as i32 = 0
        if target.is_wasm():
            var wasm_rt_src as String = String.make("" to cstr)
            if not has_wasm_rt_obj:
                if lib_dir != None to cstr:
                    let wrt_sb as StringBuilder = StringBuilder.make()
                    wrt_sb.append(lib_dir)
                    wrt_sb.append("/runtime.c" to cstr)
                    wasm_rt_src = wrt_sb.to_string()
                    wrt_sb.deinit()
                else:
                    wasm_rt_src = String.make("../mantiqz/mantiq-compiler/src/runtime.c" to cstr)
            let wasm_rt_arg as cstr = if has_wasm_rt_obj: wasm_rt_obj_path.data to cstr else: wasm_rt_src.data to cstr

            if lib_dir == None to cstr:
                _sp = sprintf(cmd_buf, "zig cc %s -target wasm32-wasi -Wl,-z,stack-size=16777216 \"%s\" -L. \"%s\" -o \"%s\" %s 2>&1" to cstr, wasm_opt, ll_path, wasm_rt_arg, out_file, extra_flags_c)
            else:
                let ts_a_path as StringBuilder = StringBuilder.make()
                ts_a_path.append(lib_dir)
                ts_a_path.append("/libtree-sitter-mantiq.a" to cstr)
                let ts_a_str as String = ts_a_path.to_string()
                let has_ts_a as bool = access(ts_a_str.data to cstr, 0 to i32) == 0 to i32
                ts_a_path.deinit()
                if has_ts_a:
                    _sp = sprintf(cmd_buf, "zig cc %s -target wasm32-wasi -Wl,-z,stack-size=16777216 \"%s\" -L. -L\"%s\" \"%s\" \"%s/libtree-sitter-mantiq.a\" -o \"%s\" %s 2>&1" to cstr, wasm_opt, ll_path, lib_dir, wasm_rt_arg, lib_dir, out_file, extra_flags_c)
                else:
                    _sp = sprintf(cmd_buf, "zig cc %s -target wasm32-wasi -Wl,-z,stack-size=16777216 \"%s\" -L. -L\"%s\" \"%s\" -o \"%s\" %s 2>&1" to cstr, wasm_opt, ll_path, lib_dir, wasm_rt_arg, out_file, extra_flags_c)
        elif target.is_python_ext():
            if lib_dir == None to cstr:
                _sp = sprintf(cmd_buf, "clang %s -shared -fPIC \"%s\" ../mantiqz/mantiq-compiler/src/runtime.c -o \"%s\" -lm %s 2>&1 || zig cc %s -shared -fPIC \"%s\" ../mantiqz/mantiq-compiler/src/runtime.c -o \"%s\" -lm %s 2>&1" to cstr, py_opt, ll_path, out_file, extra_flags_c, py_opt, ll_path, out_file, extra_flags_c)
            else:
                _sp = sprintf(cmd_buf, "clang %s -shared -fPIC \"%s\" \"%s/runtime.c\" -o \"%s\" -lm %s 2>&1 || zig cc %s -shared -fPIC \"%s\" \"%s/runtime.c\" -o \"%s\" -lm %s 2>&1" to cstr, py_opt, ll_path, lib_dir, out_file, extra_flags_c, py_opt, ll_path, lib_dir, out_file, extra_flags_c)
        else:
            if lib_dir == None to cstr:
                _sp = sprintf(cmd_buf, "zig cc %s \"%s\" -L. -ltree-sitter-mantiq tree_sitter_helper.c -Wl,-rpath,'$ORIGIN' -o \"%s\" -lm%s 2>&1 || gcc %s \"%s\" -L. -ltree-sitter-mantiq tree_sitter_helper.c -Wl,-rpath,'$ORIGIN' -o \"%s\" -lm%s 2>&1 || clang %s \"%s\" -L. -ltree-sitter-mantiq tree_sitter_helper.c -Wl,-rpath,'$ORIGIN' -o \"%s\" -lm%s 2>&1" to cstr, opt_flag, ll_path, out_file, extra_flags_c, opt_flag, ll_path, out_file, extra_flags_c, opt_flag, ll_path, out_file, extra_flags_c)
            else:
                if has_rt_obj:
                    _sp = sprintf(cmd_buf, "zig cc %s \"%s\" -L\"%s\" -ltree-sitter-mantiq \"%s/tree_sitter_helper.o\" -Wl,-rpath,\"%s\" -o \"%s\" -lm%s 2>&1 || gcc %s \"%s\" -L\"%s\" -ltree-sitter-mantiq \"%s/tree_sitter_helper.o\" -Wl,-rpath,\"%s\" -o \"%s\" -lm%s 2>&1 || clang %s \"%s\" -L\"%s\" -ltree-sitter-mantiq \"%s/tree_sitter_helper.o\" -Wl,-rpath,\"%s\" -o \"%s\" -lm%s 2>&1" to cstr, opt_flag, ll_path, lib_dir, lib_dir, lib_dir, lib_dir, out_file, extra_flags_c, opt_flag, ll_path, lib_dir, lib_dir, lib_dir, lib_dir, out_file, extra_flags_c, opt_flag, ll_path, lib_dir, lib_dir, lib_dir, lib_dir, out_file, extra_flags_c)
                else:
                    _sp = sprintf(cmd_buf, "zig cc %s \"%s\" -L\"%s\" -ltree-sitter-mantiq \"%s/tree_sitter_helper.c\" -Wl,-rpath,\"%s\" -o \"%s\" -lm%s 2>&1 || gcc %s \"%s\" -L\"%s\" -ltree-sitter-mantiq \"%s/tree_sitter_helper.c\" -Wl,-rpath,\"%s\" -o \"%s\" -lm%s 2>&1 || clang %s \"%s\" -L\"%s\" -ltree-sitter-mantiq \"%s/tree_sitter_helper.c\" -Wl,-rpath,\"%s\" -o \"%s\" -lm%s 2>&1" to cstr, opt_flag, ll_path, lib_dir, lib_dir, lib_dir, lib_dir, out_file, extra_flags_c, opt_flag, ll_path, lib_dir, lib_dir, lib_dir, lib_dir, out_file, extra_flags_c, opt_flag, ll_path, lib_dir, lib_dir, lib_dir, lib_dir, out_file, extra_flags_c)
        res = -1
        if no_libc and not target.is_wasm() and not target.is_python_ext():
            // Phase 5 freestanding link (spec 0031): no crt, no libc, no
            // tree-sitter, no -lm. -ffunction-sections + --gc-sections drop
            // the dead glue bodies (33 dead libc refs on minimal programs);
            // _start + nz_sys_write/nz_sys_getpid glue comes from codegen
            // (emit_rt_glue_bodies, pinned via @llvm.used, compiler fact 14).
            let d_argv as ptr[cstr] = malloc(64 to usize * 8 to usize) to ptr[cstr]
            var di as usize = 0 to usize
            d_argv[di] = "zig" to cstr
            di = di + 1 to usize
            d_argv[di] = "cc" to cstr
            di = di + 1 to usize
            if is_debug:
                d_argv[di] = "-O0" to cstr
                di = di + 1 to usize
                d_argv[di] = "-g" to cstr
                di = di + 1 to usize
            else:
                d_argv[di] = "-O2" to cstr
                di = di + 1 to usize
                d_argv[di] = "-fno-strict-aliasing" to cstr
                di = di + 1 to usize
            d_argv[di] = "-ffunction-sections" to cstr
            di = di + 1 to usize
            d_argv[di] = ll_path
            di = di + 1 to usize
            d_argv[di] = "-nostdlib" to cstr
            di = di + 1 to usize
            d_argv[di] = "-static" to cstr
            di = di + 1 to usize
            d_argv[di] = "-Wl,--gc-sections" to cstr
            di = di + 1 to usize
            d_argv[di] = "-Wl,-e,_start" to cstr
            di = di + 1 to usize
            d_argv[di] = "-o" to cstr
            di = di + 1 to usize
            d_argv[di] = out_file
            di = di + 1 to usize
            d_argv[di] = None to cstr
            res = mantiq_run_command_direct(d_argv)
            if res != 0:
                // Fallback: gcc directly
                var si as usize = 1 to usize
                while si < di:
                    d_argv[si] = d_argv[si + 1 to usize]
                    si = si + 1 to usize
                d_argv[0] = "gcc" to cstr
                d_argv[di - 1 to usize] = None to cstr
                res = mantiq_run_command_direct(d_argv)
                if res != 0:
                    // Fallback: clang directly
                    d_argv[0] = "clang" to cstr
                    res = mantiq_run_command_direct(d_argv)
            free(d_argv to ptr)
        elif not target.is_wasm() and not target.is_python_ext():
            let d_argv as ptr[cstr] = malloc(128 to usize * 8 to usize) to ptr[cstr]
            var di as usize = 0 to usize
            d_argv[di] = "zig" to cstr
            di = di + 1 to usize
            d_argv[di] = "cc" to cstr
            di = di + 1 to usize
            if is_debug:
                d_argv[di] = "-O0" to cstr
                di = di + 1 to usize
                d_argv[di] = "-g" to cstr
                di = di + 1 to usize
            else:
                d_argv[di] = "-O2" to cstr
                di = di + 1 to usize
                d_argv[di] = "-fno-strict-aliasing" to cstr
                di = di + 1 to usize
            d_argv[di] = ll_path
            di = di + 1 to usize
            var l_str as String = String.make("" to cstr)
            if lib_dir != None to cstr:
                let l_sb as StringBuilder = StringBuilder.make()
                l_sb.append("-L" to cstr)
                l_sb.append(lib_dir)
                l_str = l_sb.to_string()
                d_argv[di] = l_str.data to cstr
                di = di + 1 to usize
            else:
                d_argv[di] = "-L." to cstr
                di = di + 1 to usize
            d_argv[di] = "-ltree-sitter-mantiq" to cstr
            di = di + 1 to usize
            var ts_str as String = String.make("" to cstr)
            var rp_str as String = String.make("" to cstr)
            if lib_dir != None to cstr:
                if has_rt_obj:
                    let ts_sb as StringBuilder = StringBuilder.make()
                    ts_sb.append(lib_dir)
                    ts_sb.append("/tree_sitter_helper.o" to cstr)
                    ts_str = ts_sb.to_string()
                    d_argv[di] = ts_str.data to cstr
                    di = di + 1 to usize
                else:
                    let ts_sb as StringBuilder = StringBuilder.make()
                    ts_sb.append(lib_dir)
                    ts_sb.append("/tree_sitter_helper.c" to cstr)
                    ts_str = ts_sb.to_string()
                    d_argv[di] = ts_str.data to cstr
                    di = di + 1 to usize
                let rp_sb as StringBuilder = StringBuilder.make()
                rp_sb.append("-Wl,-rpath," to cstr)
                rp_sb.append(lib_dir)
                rp_str = rp_sb.to_string()
                d_argv[di] = rp_str.data to cstr
                di = di + 1 to usize
            else:
                // Milestone D: no runtime object/source is linked anymore —
                // the entire rt surface resolves from program-local IR
                // (std definitions + emit_rt_glue_bodies templates) and the
                // TU-local Milestone D ports.
                if access("tree_sitter_helper.o" to cstr, 0 to i32) == 0 to i32:
                    d_argv[di] = "tree_sitter_helper.o" to cstr
                    di = di + 1 to usize
                elif access("stage3/tree_sitter_helper.o" to cstr, 0 to i32) == 0 to i32:
                    d_argv[di] = "stage3/tree_sitter_helper.o" to cstr
                    di = di + 1 to usize
                else:
                    d_argv[di] = "tree_sitter_helper.c" to cstr
                    di = di + 1 to usize
                d_argv[di] = "-Wl,-rpath,'$ORIGIN'" to cstr
                di = di + 1 to usize
            d_argv[di] = "-o" to cstr
            di = di + 1 to usize
            d_argv[di] = out_file
            di = di + 1 to usize
            d_argv[di] = "-lm" to cstr
            di = di + 1 to usize
            var lti2 as i64 = 0 to i64
            while lti2 < lt_count:
                let lt_name2 as String = (deref sema).link_targets[lti2]
                if strcmp(lt_name2.data to cstr, "m" to cstr) != 0:
                    let l_sb2 as StringBuilder = StringBuilder.make()
                    l_sb2.append("-l" to cstr)
                    l_sb2.append(lt_name2.data to cstr)
                    let l_str2 as String = l_sb2.to_string()
                    d_argv[di] = l_str2.data to cstr
                    di = di + 1 to usize
                lti2 = lti2 + 1 to i64
            if (deref cg).has_python_embed and not has_py_flag:
                d_argv[di] = "-lpython3.12" to cstr
                di = di + 1 to usize
                d_argv[di] = "-ldl" to cstr
                di = di + 1 to usize
            d_argv[di] = None to cstr
            res = mantiq_run_command_direct(d_argv)
            if res != 0:
                // Fallback: Try gcc directly
                var si as usize = 1 to usize
                while si < di:
                    d_argv[si] = d_argv[si + 1 to usize]
                    si = si + 1 to usize
                d_argv[0] = "gcc" to cstr
                d_argv[di - 1 to usize] = None to cstr
                res = mantiq_run_command_direct(d_argv)
                if res != 0:
                    // Fallback: Try clang directly
                    d_argv[0] = "clang" to cstr
                    res = mantiq_run_command_direct(d_argv)
            free(d_argv to ptr)
        if res != 0:
            let link_cmd as String = String.make(cmd_buf to cstr)
            res = system_ref(ref link_cmd)
        free(cmd_buf to ptr)
        perf_end(perf, "link", t6)
    if res == 0 and use_cache:
        if not link_cache_hit:
            let _cb_ok as i32 = mantiq_copy_file(out_file, cached_bin_path.data to cstr)
        let dep_sb as StringBuilder = StringBuilder.make()
        dep_sb.append(bin_name.data to cstr)
        dep_sb.append("\n" to cstr)
        let cur_root_sha as String = get_file_sha256(path_cstr)
        dep_sb.append(cur_root_sha.data to cstr)
        dep_sb.append("\n" to cstr)
        dep_sb.append(flags_sig.data to cstr)
        dep_sb.append("\n" to cstr)
        let dep_count as i64 = (deref sema).loaded_module_paths.length()
        let count_buf as ptr[u8] = malloc(32 to usize) to ptr[u8]
        let _cb as i32 = sprintf(count_buf, "%ld\n" to cstr, dep_count)
        dep_sb.append(count_buf to cstr)
        free(count_buf to ptr)
        var mpi as i64 = 0 to i64
        while mpi < dep_count:
            let mp as String = (deref sema).loaded_module_paths[mpi]
            let mp_sha as String = get_file_sha256(mp.data to cstr)
            dep_sb.append(mp.data to cstr)
            dep_sb.append("\n" to cstr)
            dep_sb.append(mp_sha.data to cstr)
            dep_sb.append("\n" to cstr)
            mpi = mpi + 1 to i64
        let dep_content as String = dep_sb.to_string()
        dep_sb.deinit()
        let f_dep as ptr = fopen(dep_file_path.data to cstr, "wb" to cstr)
        if f_dep != None to ptr:
            let _w_dep as usize = fwrite(dep_content.data to ptr, 1 to usize, dep_content.len, f_dep)
            fclose(f_dep)
    if target.is_python_ext() and res == 0:
        // ── Phase 7.5: Generate and write PEP 484 type stub (.pyi) ───────────────────
        let pyi_content as String = (deref cg).generate_pyi_stub()
        let pyi_buf as ptr[u8] = malloc(2048 to usize) to ptr[u8]
        let out_len as usize = strlen(out_file)
        var base_len as usize = out_len
        if out_len > 8 to usize and strcmp(((out_file to usize) +(out_len - 8 to usize)) to cstr, ".abi3.so" to cstr) == 0:
            base_len = out_len - 8 to usize
        elif out_len > 3 to usize and strcmp(((out_file to usize) +(out_len - 3 to usize)) to cstr, ".so" to cstr) == 0:
            base_len = out_len - 3 to usize
        memcpy(pyi_buf to ptr, out_file to ptr, base_len)
        let pyi_suffix as cstr = ".pyi" to cstr
        memcpy(((pyi_buf to usize) +base_len) to ptr, pyi_suffix to ptr, 5 to usize)
        let pyi_path as cstr = pyi_buf to cstr
        let f_pyi as ptr = fopen(pyi_path, "wb" to cstr)
        if f_pyi != None to ptr:
            let _w_pyi as usize = fwrite(pyi_content.data to ptr, 1 to usize, pyi_content.len, f_pyi)
            fclose(f_pyi)
        free(pyi_buf to ptr)
    mantiq_ast_arena_reset()
    mantiq_intern_reset()
    return res == 0


// ── Check Pipeline (Syntax, Semantic, Types, Borrowck) ───────────────────────
fn check_source(
    source_cstr as cstr,
    path_cstr as cstr,
    mode as i32,
    perf as ptr[PerfState],
) as bool:
    let engine as ptr[DiagnosticEngine] = make[DiagnosticEngine](1 to usize) to ptr[DiagnosticEngine]
    engine.init()
    engine.register_source(String.make(path_cstr), String.make(source_cstr))

    // ── Phase 1: Parse / Lower ───────────────────────────────────────────────────
    let t0 as i64 = perf_begin(perf, "parse" to cstr)
    var lowerer as ptr[Lowerer] = None to ptr[Lowerer]
    if mode == LanguageMode.Nizam to i32:
        lowerer = make_lowerer_from_cstr(source_cstr, path_cstr)
    else:
        lowerer = make_lowerer_mantiq_from_cstr(source_cstr, path_cstr)
    let root as ptr[Node] = (deref lowerer).lower_source()
    perf_end(perf, "parse" to cstr, t0)
    if root == None to ptr:
        let _p1 as i32 = printf("Error: Failed to lower program AST\n" to cstr, "" to cstr)
        mantiq_ast_arena_reset()
        mantiq_intern_reset()
        return False
    // ── Phase 2: Semantic Analysis ───────────────────────────────────────────────
    let t1 as i64 = perf_begin(perf, "sema" to cstr)
    let sema as ptr[Sema] = make[Sema](1 to usize) to ptr[Sema]
    (deref sema).init_sema(path_cstr)
    if mode == LanguageMode.Nizam to i32:
        (deref sema).mode = LanguageMode.Nizam
    else:
        (deref sema).mode = LanguageMode.Mantiq
    (deref sema).engine = engine
    (deref sema).root_ast = root
    sema.declare_pass(root)
    sema.resolve_pass(root)
    sema.analyze_gil_safety(root)
    perf_end(perf, "sema" to cstr, t1)

    // ── Phase 3: Type Checking ───────────────────────────────────────────────────
    let t2 as i64 = perf_begin(perf, "typecheck" to cstr)
    let tc as ptr[TypeChecker] = make[TypeChecker](1 to usize) to ptr[TypeChecker]
    (deref tc).init_tc(sema)
    let _tc_t as ptr[Type] = (deref tc).typecheck_node(root)
    perf_end(perf, "typecheck" to cstr, t2)

    // ── Phase 4: Borrow Checking ─────────────────────────────────────────────────
    let t3 as i64 = perf_begin(perf, "borrowck" to cstr)
    let bc as ptr[BorrowChecker] = make[BorrowChecker](1 to usize) to ptr[BorrowChecker]
    (deref bc).init_bc()
    (deref bc).sema = sema
    (deref bc).current_file = (deref sema).current_file
    (deref bc).walk_ast(root)
    perf_end(perf, "borrowck" to cstr, t3)

    if engine.has_errors():
        engine.emit_all_cached()
        mantiq_ast_arena_reset()
        mantiq_intern_reset()
        return False
    mantiq_ast_arena_reset()
    mantiq_intern_reset()
    return True


// ── CLI Driver ───────────────────────────────────────────────────────────────
fn get_arg(argv as ptr[cstr], idx as i32) as cstr:
    return argv[idx]


// ── fmt CLI helpers (spec §8) ────────────────────────────────────────────────
// does p end in .nz or .mq?
fn __fmt_path_is_src(p as cstr) as bool:
    let pl as usize = strlen(p)
    if pl < 3 to usize:
        return False
    if strcmp((p to usize + (pl - 3 to usize)) to cstr, ".nz" to cstr) == 0:
        return True
    if strcmp((p to usize + (pl - 3 to usize)) to cstr, ".mq" to cstr) == 0:
        return True
    return False


// collect every .nz/.mq file under path into out (a malloc'd ptr[cstr]
// array); directories are probed with opendir, recursion filters by
// extension, and explicitly given non-directory paths pass through
// untouched (count grows; caller owns the cap)
fn __fmt_collect_src(path as cstr, out as ptr[cstr], count as ptr[i64], cap as i64):
    extern fn opendir(path as cstr) as ptr
    extern fn readdir(d as ptr) as ptr
    extern fn closedir(d as ptr) as i32
    extern fn malloc(sz as i64) as ptr
    extern fn memcpy(dst as ptr, src_p as ptr, n as usize) as ptr
    let d as ptr = opendir(path)
    if d != None to ptr:
        var ent as ptr = readdir(d)
        while ent != None to ptr:
            // glibc x86-64 dirent: d_name sits at offset 19
            let name as cstr = (ent to usize + 19 to usize) to cstr
            let nb as u8 = deref (name to ptr[u8])
            if nb != 46 to u8:
                let pl as usize = strlen(path)
                let nl as usize = strlen(name)
                let cp as ptr[u8] = malloc((pl + nl + 2 to usize) to i64) to ptr[u8]
                memcpy(cp to ptr, path to ptr, pl)
                deref ((cp to usize + pl) to ptr[u8]) = 47 to u8
                memcpy((cp to usize + pl + 1 to usize) to ptr, name to ptr, nl)
                deref ((cp to usize + pl + 1 to usize + nl) to ptr[u8]) = 0 to u8
                let child as cstr = cp to cstr
                let dd as ptr = opendir(child)
                if dd != None to ptr:
                    closedir(dd)
                    if (deref count) < cap:
                        __fmt_collect_src(child, out, count, cap)
                elif __fmt_path_is_src(child):
                    if (deref count) < cap:
                        deref ((out to usize + ((deref count) to usize * 8 to usize)) to ptr[cstr]) = child
                        deref count = (deref count) +1 to i64
            ent = readdir(d)
        closedir(d)
    else:
        if (deref count) < cap:
            deref ((out to usize + ((deref count) to usize * 8 to usize)) to ptr[cstr]) = path
            deref count = (deref count) +1 to i64


// insertion sort by strcmp (deterministic processing order)
fn __fmt_sort_paths(arr as ptr[cstr], count as i64):
    var i as i64 = 1 to i64
    while i < count:
        let key as cstr = deref ((arr to usize + (i to usize * 8 to usize)) to ptr[cstr])
        var j as i64 = i - 1 to i64
        while j >= 0 to i64:
            let cur as cstr = deref ((arr to usize + (j to usize * 8 to usize)) to ptr[cstr])
            if strcmp(cur, key) > 0:
                deref ((arr to usize + ((j + 1 to i64) to usize * 8 to usize)) to ptr[cstr]) = cur
                j = j - 1 to i64
            else:
                break
        deref ((arr to usize + ((j + 1 to i64) to usize * 8 to usize)) to ptr[cstr]) = key
        i = i + 1 to i64


// read all of stdin (16 MB cap — codegen.nz-sized inputs must fit)
fn __fmt_read_stdin() as cstr:
    extern fn read(fd as i32, buf as ptr, count as usize) as i64
    extern fn malloc(sz as i64) as ptr
    let cap as i64 = 16777216 to i64
    let buf as ptr[u8] = malloc(cap) to ptr[u8]
    var off as i64 = 0 to i64
    var done as bool = False
    while not done:
        let r as i64 = read(0, (buf to usize + (off to usize)) to ptr, (cap - off) to usize)
        if r <= 0 to i64:
            done = True
        else:
            off = off + r
            if off >= cap:
                done = True
    deref ((buf to usize + (off to usize)) to ptr[u8]) = 0 to u8
    return buf to cstr


fn main(argc as i32, argv as ptr[cstr]) as i32:
    var default_mode as i32 = LanguageMode.Mantiq to i32
    var bin_name as cstr = "mantiq" to cstr
    if argc >= 1 and str_contains(get_arg(argv, 0 to i32), "nizam" to cstr):
        default_mode = LanguageMode.Nizam to i32
        bin_name = "nizam" to cstr
    let self_name as cstr = compiler_name(default_mode)

    // scan for --profile flag
    var prof_flag as bool = False
    var ai as i32 = 1 to i32
    while ai < argc:
        if strcmp(get_arg(argv, ai), "--profile" to cstr) == 0:
            prof_flag = True
        ai = ai + 1 to i32
    if prof_flag:
        mantiq_set_profile_active(1 to i32)
    if argc < 2:
        let _p3 as i32 = printf("%s Self-Hosting Compiler v0.1.0\nUsage: %s <command> [options]\n  build <file.nz> [-o <out>] [--target <triple>] [--release|--debug] [--profile]\n  run <file.nz> [--target <triple>] [--release|--debug] [--profile]\n  check <file.nz> [--profile]\n  version\n" to cstr, self_name, bin_name)
        let _f1 as i32 = fflush(None to ptr)
        return 0 to i32
    let cmd as cstr = get_arg(argv, 1 to i32)
    if strcmp(cmd, "version" to cstr) == 0 or strcmp(cmd, "--version" to cstr) == 0:
        let _p4 as i32 = printf("%s Self-Hosting Compiler v0.1.0\n" to cstr, self_name)
        let _f2 as i32 = fflush(None to ptr)
        return 0 to i32
    if strcmp(cmd, "check" to cstr) == 0:
        if argc < 3:
            let _p_chk_err as i32 = printf("Error: 'check' requires an input file path\nUsage: %s check <file.nz|file.mq> [--profile]\n" to cstr, bin_name)
            return 1 to i32
        let input_path as cstr = get_arg(argv, 2 to i32)
        var chk_arg_i as i32 = 3 to i32
        while chk_arg_i < argc:
            if strcmp(get_arg(argv, chk_arg_i), "--lib-dir" to cstr) == 0 and chk_arg_i + 1 to i32 < argc:
                extern fn set_compiler_lib_dir(dir as cstr)
                set_compiler_lib_dir(get_arg(argv, chk_arg_i + 1 to i32))
                chk_arg_i = chk_arg_i + 1 to i32
            chk_arg_i = chk_arg_i + 1 to i32
        let mode as i32 = detect_mode(input_path, default_mode)
        let source_cstr as cstr = read_file_to_cstr(input_path)
        if source_cstr == None to cstr:
            let _p_chk_read as i32 = printf("Error: Could not read file '%s'\n" to cstr, input_path)
            return 1 to i32
        var perf as PerfState = perf_init()
        perf.enabled = prof_flag
        let ok as bool = check_source(source_cstr, input_path, mode, ref perf)
        perf_print(ref perf)
        if ok:
            let _p_chk_ok as i32 = printf("✔ [check] Syntax & types valid: %s\n" to cstr, input_path)
            let _ff_chk as i32 = fflush(None to ptr)
            return 0 to i32
        else:
            let _p_chk_fail as i32 = printf("Check failed for %s\n" to cstr, input_path)
            let _ff_chk2 as i32 = fflush(None to ptr)
            return 1 to i32
    // ── Milestone F: fmt — deterministic line canonicalizer ─────────────
    // Usage: nizam fmt [paths...] [-w|--write] [-c|--check] [-d|--diff]
    //              [--line-length <N>] [--stdin-filepath <path>]
    //   default: print formatted text to stdout
    //   -w: overwrite in place; -c: exit 1 if any file needs formatting
    //   -d: display unified diffs without modifying files
    //   --line-length: wrapping limit (default 100)
    //   --stdin-filepath: format stdin, reporting as the given path
    //   directory paths expand recursively to their .nz/.mq files
    if strcmp(cmd, "fmt" to cstr) == 0:
        if argc < 3:
            let _p_fmt_err as i32 = printf("Error: 'fmt' requires file paths\nUsage: %s fmt <file.nz|file.mq|dir>... [-w|--write] [-c|--check] [-d|--diff] [--line-length <N>] [--stdin-filepath <path>]\n" to cstr, bin_name)
            return 1 to i32
        var write_mode as bool = False
