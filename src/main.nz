// ── C FFI Declarations ───────────────────────────────────────────────────
extern fn printf(format as cstr, ...) as i32
extern fn sprintf(buf as ptr[u8], format as cstr, ...) as i32
extern fn strcmp(s1 as cstr, s2 as cstr) as i32
extern fn system(command as cstr) as i32
extern fn fopen(filename as cstr, mode as cstr) as ptr
extern fn fclose(stream as ptr) as i32
