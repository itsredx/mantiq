// Probe 2: List[byval struct with ONLY String fields] — append, read,
// in-place element store, re-read, repeated passes. Mirrors
// BorrowChecker.active_borrows usage (update_borrows_liveness /
// check_borrow_creation) without the small-int field IR bug (probe 1).
from std.string import String

extern fn printf(format as cstr, ...) as i32

struct RecX:
    var a as String
    var b as String
    var c as String

fn check(lst as ptr[List[RecX]], pass as i64):
    let cnt as i64 = (deref lst).length()
    var i as i64 = 0 to i64
    while i < cnt:
        // Same shape as `let b as BorrowRecord = (deref ab_ref)[idx]`
        let r as RecX = (deref lst)[i]
        let _d as i32 = printf("pass=%lld i=%lld a=%s len_a=%lld ptr=0x%llx\n" to cstr, pass, i, r.a.data to cstr, r.a.len to i64, r.a.data to i64)
        i = i + 1 to i64

fn main():
    let lst as List[RecX] = List[RecX]()
    (ref lst).append(RecX(a = String.make("aaa" to cstr), b = String.make("b1" to cstr), c = String.make("c1" to cstr)))
    (ref lst).append(RecX(a = String.make("bbb" to cstr), b = String.make("b2" to cstr), c = String.make("c2" to cstr)))
    (ref lst).append(RecX(a = String.make("ccc" to cstr), b = String.make("b3" to cstr), c = String.make("c3" to cstr)))

    check(ref lst, 0 to i64)

    // In-place element store like `(deref ab_ref)[idx] = rec`
    let fresh as RecX = RecX(a = String.make("zzz" to cstr), b = String.make("bz" to cstr), c = String.make("cz" to cstr))
    (ref lst)[1] = fresh
    check(ref lst, 1 to i64)

    // More appends after in-place store, then re-read everything twice.
    (ref lst).append(RecX(a = String.make("ddd" to cstr), b = String.make("b4" to cstr), c = String.make("c4" to cstr)))
    (ref lst).append(RecX(a = String.make("eee" to cstr), b = String.make("b5" to cstr), c = String.make("c5" to cstr)))
    check(ref lst, 2 to i64)
    check(ref lst, 3 to i64)
    let _d as i32 = printf("PROBE_DONE\n" to cstr)
