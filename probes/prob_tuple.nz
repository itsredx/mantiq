// Probe: Tuple[T] get() lowering — (deref self)._items[idx] inside a
// method (the failing test_tuple_methods shape). The undefined extern
// forces a link error so the .ll persists for inspection.
from std.collections import List, Tuple
from std.string import String


extern fn printf(format as cstr, ...) as i32


struct Box64:
    var items as List[i64]


fn get_it(b as ptr[Box64], idx as i64) as i64:
    return (deref b).items[idx]


fn main():
    var t as Tuple[i64] = Tuple[i64]()
    (deref (ref t)).init()
    var l as List[i64] = List[i64]()
    (ref l).append(10 to i64)
    (ref l).append(20 to i64)
    (ref l).append(40 to i64)
    (deref (ref t)).from_list(l)
    let g0 as i64 = (deref (ref t)).get(0 to i64)
    let g1 as i64 = (deref (ref t)).get(1 to i64)
    let g2 as i64 = (deref (ref t)).get(2 to i64)
    let _p as i32 = printf("get0=%lld get1=%lld get2=%lld\n" to cstr, g0, g1, g2)
    let bx as Box64 = Box64(items = List[i64]())
    let _b0 as i64 = get_it(ref bx, 0 to i64)
    let _p2 as i32 = printf("box0=%lld\n" to cstr, _b0)
