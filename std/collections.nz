    while root >= 0 to i64:
        var cur as i64 = root
        var again as i32 = 1 to i32
        while again == 1 to i32:
            again = 0 to i32
            let lc as i64 = cur * 2 + 1
            if lc < count:
                let rc as i64 = lc + 1
                var big as i64 = lc
                if rc < count:
                    let p1 as usize = (a to usize) +((rc * es) to usize)
                    let p2 as usize = (a to usize) +((lc * es) to usize)
