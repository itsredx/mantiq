            return r
        if (deref aa).slen < (deref bb).slen:
            return -1 to i32
        if (deref aa).slen > (deref bb).slen:
            return 1 to i32
        return 0 to i32
    let ab as ptr[u8] = pa to ptr[u8]
    let bbb as ptr[u8] = pb to ptr[u8]
    if es == 4 to i64 or es == 8 to i64:
        let lastoff as i64 = es - 1
        let sa as u8 = ab [lastoff] & 128 to u8
        let sb as u8 = bbb[lastoff] & 128 to u8
        if sa != sb:
