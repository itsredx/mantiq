            if lc < end2:
                let rc as i64 = lc + 1
                var big as i64 = lc
                if rc < end2:
                    let p1 as usize = (a to usize) +((rc * es) to usize)
                    let p2 as usize = (a to usize) +((lc * es) to usize)
                    if __mantiq_nz_sort_cmp(p1 to ptr, p2 to ptr, es, is_str) > 0 to i32:
